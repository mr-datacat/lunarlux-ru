    text[100001] = "はい";
    text[100002] = "いいえ";
    text[69] = "[X] をおすと メニューに いどうします";
    text[2544] = "[丸] をおすと メニューに いどうします";
    text[2545] = "[B] をおすと メニューに いどうします";
    text[70] = "テトラの ところによって [C] をおすと テトラと おはなしできるよ";
    text[2546] = "テトラの ところによって [四角] をおすと テトラと おはなしできるよ";
    text[2547] = "テトラの ところによって [Y] をおすと テトラと おはなしできるよ";
    text[120001] = "     をおすと ジェットスーツから おりるよ！";
    text[120002] = "     をおすと ジェットスーツを きどうします！";
    text[120003] = "ジェットパッド にんしょうエラー";
    text[2560] = "ジェットパッドは 故障してるようね  今は 使えないわ...";
    text[4820] = "このジェットパッドは 壊れている";
    text[4821] = "どうやら 長い間 放置されていたようだ";
    text[7560] = "オーバーフェイズが アンロックされました！";
    text[7561] = "バトル中 ニックルは 自分の 限界を超えて オーバーフェイズ できるように なりました！";
    text[7562] = "この強力な フォームは 2ターン持続し ターンごとに HPの50％を 失う代わりに";
    text[7563] = "ニックルの すべての アクティブスキルに 対して 4倍のパワーブーストを 与えます";
    text[7564] = "このフォームでは SPコストが なくなるため ダメージを 最大化することに 集中できます！";
    text[5331] = "ルナーの住民と話すと 絆ポイントが たまります";
    text[5332] = "それによって 自分の評判と コロニーの 絆レベルが 上がります！";
    text[5333] = "絆レベルが 上がると サイドクエストが アンロックされたり";
    text[5334] = "アストロテック商人が 値引きしてくれたり します";
    text[5335] = "絆レベルは リファレンスの 記録メニューで 確認できます！";
    text[7120] = "ミニポッドを どうするんだ？";

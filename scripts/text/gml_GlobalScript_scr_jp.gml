    text[148] = "急がなくちゃ！  追いかけるわよ！";
    text[149] = "目標: 暴れている マークを特定し 捕まえましょう！";
    text[150] = "いたわ！  何とかして 鎮めないと！";
    text[151] = "テトラ！  サポートを 頼むわ！";
    text[152] = "オッケ～イ 任せなさい！";
    text[153] = "逃げられたわ！";
    text[154] = "ハァ... ハァ... 大丈夫よ@P.@P.@P.";
    text[155] = "今は それでいいわ";
    text[156] = "しばらくは 戻ってこないだろうし";
    text[157] = "それより テトラ 今の 酸素レベルは？";
    text[158] = "@P.@P.@P.@P96％よ！";
    text[159] = "おかしいわね\n酸素は まだ十分あるわ";
    text[160] = "なのにどうして そんなに 苦しそうなの？";
    text[161] = "ベラ ちょっと スキャンさせてね";
    text[162] = "ベラ！";
    text[163] = "ごめんなさい...";
    text[164] = "痛めつけて...";
    text[165] = "苦しめて...";
    text[166] = "違うやり方が あれば...";
    text[167] = "いや あるはずなのに";
    text[168] = "今まで...";
    text[169] = "たくさんの マークを 殺してしまった";
    text[170] = "本当に ごめんなさい...";
    text[171] = "でもね あなたたちと 人間の どちらかしか 救えないなら...";
    text[172] = "ワタシは 人間を 選ばなくちゃいけない...";
    text[173] = "...ルナーの人々を 守るのが ワタシの 使命なのだから";
    text[174] = "あなたたちは モンスターで";
    text[175] = "ワタシたちは 人間";
    text[176] = "でもね だからといって お互いを 殺し合う 必要なんか ないと思うわ";
    text[177] = ".@P .@P .@P .@P .@Pそうでしょう？";
    text[178] = "ママ@P.@P.@P.";
    text[179] = "マークについて 何か 知ってるかしら？";
    text[180] = "あなたが まだ この世に いてくれたら...";
    text[181] = "ベラーーーーーーッ！！";
    text[182] = "やっと 起きたわね！\n死んじゃったかと 思ったわ...";
    text[183] = "テトラ...";
    text[184] = "ベラの ウソつき...";
    text[185] = "あなたが 気絶したのは 酸素レベルの せいじゃないわ...";
    text[186] = "大ケガ してたこと ずっと 隠してたでしょ";
    text[187] = "エヘヘ... まあね...";
    text[188] = "グリムロックと 戦った時よ";
    text[189] = "どうして 黙ってたのよ！？";
    text[190] = "テトラ 心配したのよ...";
    text[191] = "ごめん...";
    text[192] = "ホバークラフトを 直さなくちゃ いけなかったし...";
    text[193] = "ガマンすれば 大丈夫だと思って...";
    text[194] = "どうして テトラに 言わないの？  ポンコツだから？";
    text[195] = "そ そんなことないわ！  悪いのは ワタシよ";
    text[196] = "軽く手当てくらいは しておくべきだったわ";
    text[197] = "大丈夫 あなたは 最高の アシスタント・ロボよ！";
    text[198] = "そう... 次 ケガしたら ちゃんと言うのよ";
    text[199] = "まあ トーマス博士が ここにいたら\n「それこそ 我が娘だ！」";
    text[200] = "「いつも 勇敢で」";
    text[201] = "「その心は ゼッタイに 折れない」";
    text[202] = "「まさにベラは ルナーの救世主だ！」\nとか 言いそうだけどねえ...";
    text[203] = "ああもう 知ってるでしょ\nパパは 親バカなのよ...";
    text[204] = "で どれくらい 気を 失ってたの？";
    text[205] = "48分37秒よ";
    text[206] = "酸素レベルは？";
    text[207] = "79％！";
    text[208] = "まずい！  時間がないわね！";
    text[209] = "すぐにミッションを 終わらせるわよ！";
    text[210] = "オッケ～イ！";
    text[211] = "気分も ずっと良くなったわ  ありがとう テトラ";
    text[212] = "エヘヘ";
    text[213] = "ミッション: ホバークラフトの エンジンを起動し アストロバリアを 修理しましょう";
    text[214] = "まずは ルナーパネルを 扱える人を 探しましょう！";
    text[415] = "ああ ベラ！\nお仕事は 順調かしら？";
    text[416] = "ナイラさん！\n今日はどうして こんなところに？";
    text[417] = "上の人に言われて ルナーパネルを 調査しているのよ";
    text[418] = "あなたの お父さんと ワタシで 最近 新しい ルナーパネルを 開発してね";
    text[419] = "ただ 実用化の前に エネルギー効率を テストしなくちゃ いけないの";
    text[420] = "それで今 パネルが届くのを 待ってるんだけど@P.@P.@P.";
    text[421] = "おかしなことに 配達の ホバークラフトが 遅れてる みたいでね@P.@P.@P.";
    text[422] = "それはともかく たまにこうして 宇宙ステーションの外で 仕事すると とても楽しいわ";
    text[423] = "人類のテクノロジーは 目覚ましい発展を 遂げたけど";
    text[424] = "この宇宙には 未知なるものが まだまだ たくさんあるのよ";
    text[425] = "まあ 私の助けが いる時は 遠慮なく 言ってね";
    text[426] = "うん わかった\nありがとう ナイラさん！";
    text[427] = "ああ ベラ！\n何か ご用かしら？";
    text[428] = "ナイラさん ちょっと 手伝って ほしいことが あるんだけど...";
    text[429] = "あなたって ルナーパネルの 専門家よね？";
    text[430] = "ええ そうよ";
    text[431] = "ちょっと いろいろ あってね...";
    text[432] = "なるほど  そういうことなら ワタシが どうにかするしか ないわね！";
    text[433] = "それで ルナーパネルで ホバークラフトの エンジンは 起動できるかしら？";
    text[434] = "ええ...";
    text[435] = "できるには できるわ";
    text[436] = "ただし 10枚の ルナーパネルと 1つの サーモエレキ・ジェレネーターが あればね！";
    text[437] = "なるほどねえ... でも ジェネレーターなんて どこに あるのかしら？";
    text[438] = "ベラ ここは レゴリシアよ！";
    text[439] = "ルナーの 科学都市 ティコからは そう遠くないわ";
    text[440] = "だからね アストロテック業者が わんさか 集まってくるのよ";
    text[441] = "他では 手に入らない 貴重なアイテムが 売られてたり するくらい なんだから！";
    text[442] = "まずは バリア施設の 辺りにいる アストロテック商人に 会ってみなさい！";
    text[443] = "ルナーパネルについては 倉庫にいくらか 予備があるはず";
    text[444] = "倉庫は ここから ちょうど 南にあるわ";
    text[445] = "これを 持っていきなさい";
    text[500] = "これがあれば 3番倉庫に 入ることが できます";
    text[501] = "ねえ ベラ\n今 ナイラさんが 話したこと メモリバンクに 保存したわ";
    text[502] = "もし 忘れちゃった時は ワタシに 話しかけてね！";
    text[503] = "今 言ったものを 集めれば 100％うまくいくはずよ";
    text[504] = "というより@P.@P.@P.";
    text[505] = "100億％と 言ってもいいわね！";
    text[506] = "わかったわ  いろいろ 助けてくれて 本当にありがとう ナイラさん！";
    text[507] = "どういたしまして";
    text[508] = "パネルと ジェネレーターを 集めたら また ここに来なさい";
    text[509] = "なんなら パネルの 扱い方について 教えてあげても いいわよ！";
    text[510] = "ええっと... そういうのは あまり 得意じゃないから 全部 あなたに 任せるわ";

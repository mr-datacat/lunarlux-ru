    text[10169] = "一部の敵は 毒パネルを 生成します";
    text[10176] = "毒パネルの 上に立つと 少しずつHPが 失われます！";
    text[10179] = "溶岩パネルは 高温で爆発します！";
    text[10180] = "上に立つと 50ダメージを 受けます";
    text[10181] = "ダメージを受けると 溶岩パネルは 消滅します";
    text[10182] = "水パネルの上に立つと ラックスメーターが 少しずつ下がります！";
    text[10183] = "絆レベルが上がると ショップでの買い物が 安くなります";

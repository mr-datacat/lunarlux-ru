    text[1372] = "ここに 留まっては いけないわ";
    text[1379] = "大丈夫よ テトラ";
    text[1009] = "ママは昔 仲間と一緒に ファントムスペースを 行き来してたのよ";
    text[1010] = "詳しく聞いたことは ないけど 抜け出す方法が あるのは 間違いないわ";
    text[1011] = "テトラ ここの座標は？";
    text[1012] = "特定できないわ...";
    text[1013] = "なら ルナーじゃないことは 確かね...";
    text[1014] = "ハァ...";
    text[1015] = "なんだか わからないこと だらけだわ...";
    text[1016] = "でも ここで 何もせず じっとしてるわけには いかない";
    text[1017] = "ただでさえ キケンな 場所なのに...";
    text[1018] = "何とか 手がかりを 探しましょう";
    text[1019] = "助けがいる時は 言ってね！";
    text[1020] = "スーパー探検アシスタント・ロボ テトラの 本気を 見せてあげるんだから！";
    text[1381] = "(まただわ... 何かしら この奇妙な感じ？)";
    text[1382] = "(まるで 誰かに 遠くから 呼ばれているような...)";
    text[1383] = "(声...？)";
    text[1384] = "(...)";
    text[1385] = "ベラ ここは 敵だらけよ\nすぐ近くにも 複数のマークを 検出してるわ";
    text[1386] = "そこの 紫色の光も そうよ";
    text[1387] = "わかった  じゃあ 気をつけないとね";
    text[1388] = "...";
    text[1389] = "なんだか この場所に 見覚えがあるような 気がするのは ワタシだけかしら...？";
    text[1390] = "どういうこと？";
    text[1391] = "なんというか まだ レゴリシアに いるような...";
    text[1392] = "まさか！  ありえないわ！";
    text[1393] = "そのカンが 正しければ 近くに 石板が あるはずよ";
    text[1394] = "まあ ちょっと 辺りを 調べてみましょう";
    text[1395] = "やっぱり！\nここにも 石板があるわ！";
    text[1396] = "でも... どうして！？";
    text[1397] = "....！";
    text[1398] = "ワアアア！\n今の 速かったわね！";
    text[1402] = "あいつが ワタシたちを ここに 連れてきたんだわ！";
    text[1403] = "(...)";
    text[1404] = "(あのマークの 叫びは まるで 泣いている みたいだった...)";
    text[1405] = "(ワタシの 本能は ここから逃げろと 言ってる  でも 心は...)";
    text[1406] = "(魂は...)";
    text[1407] = "(...違うと 言ってるわ)";
    text[1399] = "テトラ... このまま 先に 進みましょう";
    text[1400] = "それに ルナーに 戻るための いい考えが 浮かんだわ";
    text[1401] = "さあ 行くわよ！";
    text[1408] = "ついに 会ったわね";
    text[1409] = "このマークは 手強そうだわ";
    text[1410] = "ベラ このマークは データベースに ないわ！";
    text[1411] = "つまり 新種よ！  コードネーム命名: クロノス！";
    text[1420] = "こんなに 強力な マークは 見たことがないわ！";
    text[1421] = "それは まずいわね...";
    text[1422] = "戦わずに 話をすることは できないの？";
    text[1423] = "ええ！？";
    text[1424] = "マーク！  どうして ワタシたちを ここに 連れてきたの？";
    text[1425] = "ワタシの 言ってること わかる？";
    text[1426] = "お願い 答えて...！";
    text[1427] = "ベラ ムダよ";
    text[1428] = "マークに 言葉なんて 通じないわ...";
    text[1429] = "それは わかってるけど...";
    text[1461] = "ん ちょっと待った  マークは 何してるの？  何だか こっちを じっと 見つめてるけど...";
    text[1462] = "うう 緊張するわ...";
    text[1463] = "きっと 観察してるのよ  こっちの出方を うかがってるのかも しれないわね";
    text[1464] = "ここに 連れてきたのも きっと何か 理由があるはず...";
    text[1465] = "それが 何なのかは わからないけど";
    text[1466] = "ひょっとしたら ワタシたちを 試してるのかもね...";
    text[1467] = "ベラ バカなこと 言わないで";
    text[1468] = "きっと 今から ワタシたちを 丸のみにする つもりよ！";
    text[1469] = "ウーン そうは思わないわ\nもしそうなら もう食べてるでしょ";
    text[1470] = "このマークは@P.@P.@P.@P. 何かが違うのよ";
    text[1438] = "ベラ マークが そわそわしだしたわ！";
    text[1439] = "襲ってくるわよ！";
    text[1440] = "このマークが いくら強くたって 知恵を使えば 負けることはないわ";
    text[1441] = "テトラ ワタシの考えは シンプルよ\nまず相手を 疲れさせるの";
    text[1442] = "そうしたら ワームホールに入って 逃げようとするはず";
    text[1443] = "その時に 一緒に 脱出すれば いいってわけ！";
    text[1444] = "でも ワームホールが ルナーに つながってなかったら？";
    text[1445] = "その時は その時よ  ルナーの戦士は 決してあきらめない  そうでしょ テトラ？";
    text[1446] = "そうね！  何があっても 帰れるまで あきらめないわ！  フッフッフ！";
    text[1447] = "ただ このマークが 荒れ狂った 状態で ルナーに戻ったら 大問題になるわ";
    text[1448] = "少なくとも ここでなら 市民に 被害がおよぶ 心配なく 戦える";
    text[1449] = "覚悟はいいかしら テトラ？";
    text[1450] = "もちろんよ  マークハンター アシスタント・ロボ テトラの力 見せてあげるわ！";
    text[1451] = "ようし...";
    text[1452] = "じゃあ 全力で行くわよ！";
    text[1453] = "よく 聞きなさい マーク！";
    text[1454] = "ルナーの人々に 危害を加えたり";
    text[1455] = "町を 破壊することは このワタシが 許さない";
    text[1456] = "あなたが 何を 企んでいるのか 知らないけど...";
    text[1457] = "ワタシの目が 黒いうちは みんなに 指一本 触れさせは しない！";
    text[1458] = "さあ ルナーの戦士の力 受けてみなさい！";
    text[1459] = "どうやら 落ち着いたみたいね";
    text[1460] = "...？";
    text[1473] = "(まただわ この感覚...！)";
    text[1474] = "@P. @P. マ@P. @P. モ@P. @P.";
    text[1475] = "@P. マ@P. モ@P. @P. ッ@P. テ@P. @P. @P. @P. @P.";
    text[1476] = "(マモッテ...？)";
    text[1477] = "(この声...！)";
    text[1478] = "(さっきのと 同じだわ！)";
    text[1479] = "(あなた... 言葉が わかるの？)";
    text[1480] = "ベラ 見て！  別のマークが！";
    text[1481] = "しまった 囲まれたわ...！";
    text[1482] = "今の戦いに 引き寄せられたんだわ";
    text[1483] = "しかも なんだか エネルギーが 増大してるわよ！";
    text[1484] = "...！";
    text[1485] = "ホロシールド発動！";
    text[1486] = "ベラ！  大丈夫？";
    text[1487] = "へ 平気よ...";
    text[1488] = "でも ホロシールドが 尽きちゃったわ...";
    text[1489] = "ハァ... ハァ...";
    text[1490] = "うう... ギリギリだったわね...";
    text[1491] = ".@P.@P.@P.@Pでも もう動けない...";
    text[1492] = "ええい 下がりなさい！\nよくも ワタシの ベラに ひどいこと してくれたわね！";
    text[1493] = "テトラ... 刺激しちゃダメ！";
    text[1494] = "そばに いなさい";
    text[1495] = "ハァ... ハァ...";
    text[1496] = "こんなところで... あきらめないんだから！";
    text[1497] = "アア～～～～～～～！！";
    text[1498] = "ルナーに 戻ったわ！";
    text[1499] = "怖かった...";
    text[1500] = "死ぬかと 思ったわ...";
    text[1501] = "まさに 危機一髪だったわね...";
    text[1502] = "ベラ あそこ見て！\n赤い反物質コアよ！";
    text[1503] = "クロノスの 反物質コアね...";
    text[1504] = "クロノスは 自分を 犠牲にして ワタシたちを 助けたんだわ...";
    text[1505] = "そうね...";
    text[1506] = "ワタシたちは クロノスを 誤解していた";
    text[1507] = "きっと何か 助けを 求めていたのよ";
    text[1508] = "どうしてわかるの？";
    text[1509] = "うまく 説明できないけど...";
    text[1510] = "クロノスの 痛みを感じたの";
    text[1511] = "魂に響く 痛みを";
    text[1512] = "おそらくこれが さっきから ずっと感じてた 感覚の 正体なんだわ";
    text[1513] = "ベラーーー！！  どうして そういうことを もっと早く 言わなかったの！？";
    text[1514] = "わ... わかってるわよ...";
    text[1515] = "ファントムスペースが 人体におよぼす 影響なんて 誰にも わからないわ";
    text[1516] = "なんだって 反物質だらけ なんだから！";
    text[1517] = "すぐに トーマス博士の ところに 行かなきゃ！  テトラ 心配で いても立っても いられないわ！";
    text[1518] = "ダメ！";
    text[1519] = "ええ どうして？";
    text[1520] = "たとえ わざとでなくても ファントムスペースに 行くことは 重大な 規則違反よ";
    text[1521] = "これ以上 トラブルに 巻き込まれたくないわ...";
    text[1522] = "ステーションに戻ったら 治療室で しっかりと 体を休めるわ！";
    text[1523] = "だからね テトラ このことは 人に言っちゃダメ";
    text[1524] = "約束よ いい？";
    text[1525] = "...";
    text[1526] = "わかった 約束するわ";
    text[1527] = "...でも 何か 変な反応が 体に出たら トーマス博士に 報告するわよ";
    text[1528] = "ええ";
    text[1529] = "反物質コアは 本当は 本部に 送らなくちゃ いけないんでしょうけど...";
    text[1530] = "これについては 自分たちで 持っておいた方が 良さそうね";
    text[1531] = "オッケ～イ！  なら 今 2つの 反物質コアを 持ってるって わけね";
    text[1532] = "クロノス...";
    text[1533] = "ありがとう...";
    text[1534] = "そうね クロノスは ワタシたちを 守ってくれた！";
    text[1535] = "@P.@P.@P.@P.@P.@P.";
    text[1536] = "「守って」@P.@P.@P.";
    text[1537] = "それで思い出した\nクロノスが 言ったこと 聞いた？";
    text[1538] = "ええ！？  何を言ったって？  ワタシは 何も 聞かなかったけど";
    text[1539] = "ウーン... なら あれは テレパシーか 何か だったのかしら？";
    text[1540] = "すべてのマークに そういう能力が あるとか？";
    text[1541] = "奇妙ね...";
    text[1542] = "クロノスの声は 聞いたことが ないような ものだったけど";
    text[1543] = "でも どこか 懐かしい感じがしたの";
    text[1544] = "...";
    text[1545] = "いつか マークと コミュニケーションが 取れるようになったら";
    text[1546] = "彼らとの 平和を 実現できるかも しれないわね";
    text[1547] = "どうやら 今日は マークに関して 貴重なことを 学んだようね！";
    text[1548] = "わからないことは まだ たくさん あるけどね";
    text[1549] = "先は... まだまだ 長いわ";
    text[1550] = "(ママ どうか ワタシたちのこと 見守っていてね)";
    text[1551] = "(これからも ルナーを 一生懸命 守るから！)";
    text[1552] = "さて テトラ\nそろそろ 休むとしましょう";
    text[1553] = "お家に 戻るわよ";
    text[1554] = "そうね！  ワタシたちの 船は 南東ホバーポートに 停めてあるわ！";
    text[1555] = "そうと決まれば 行くわよ！\nレッツ ゴー ゴー ゴー！";
    text[1579] = "目標: 南東ホバーポートに 停めてある ホバークラフトに乗り";
    text[1580] = "ルナー宇宙ステーションに 向かいましょう！";
    text[8472] = "また ファントムスペースに 戻ってきたわね...";
    text[8473] = "ベラ ここは あんまり いい所じゃないわ";
    text[8474] = "すごく キケンだってこと 覚えてる？";
    text[8475] = "もちろん 長くいるつもりは ないわよ";
    text[8476] = "ところで...";
    text[8477] = "ルナーフォースは この入り口について 知っているのかしら？";
    text[8478] = "さっきの 奇妙な文字は 他の場所でも 見たことがあるけど...";
    text[8479] = "ということは ファントムスペースには まだ知られてない 出入口が あるってことよね...";
    text[8480] = "いつの日か この場所について もっと深く 知ってみたいわ...";
    text[8481] = "ママだって ファントムスペースには しょっちゅう 来ていたんだから";
    text[8482] = "未知のものを 怖がるのは 簡単だけど";
    text[8487] = "知れば知るほど より安全に 探索できるはずよ！";
    text[8483] = "そう思わない テトラ？";
    text[8484] = "まあ... そうかもね...";
    text[8485] = "でも くれぐれも 気をつけるのよ いい？";
    text[8486] = "もちろんよ！";
    text[1583] = "これは... クロノス？";
    text[1584] = "いいえ その幻影... 「ファントム」よ";
    text[1585] = "ボス・マークは 戦うと その場に 反物質を 大量に 放出するため";
    text[1586] = "それが ファントムに なるの";
    text[1593] = "つまり ボス・マークの 形状をとる キケンな エネルギーの塊 になるってわけ";
    text[1587] = "ちなみに ファントムは 周囲から 大量の 反物質を 集めてるせいで";
    text[1588] = "オリジナルよりも 強くなってるわ";
    text[1589] = "ねえ テトラ... 一体どこで そんな情報 調べたわけ！？";
    text[1590] = "トーマス博士の ヒミツの アーカイブからの 引用よ";
    text[1591] = "まあ そういうのは たまに コッソリと ダウンロードしてるの... エヘヘ";
    text[1592] = "それは ともかく このファントムを 何とか しないとね！";
    text[1594] = "このスーパーアシスタント・ロボの テトラが どんな形の 敵も やっつけて やるわ！";
    text[1706] = "おはようございます トーマス博士！";
    text[1712] = "ウェッヘッヘ... 週次レポートです";
    text[1713] = "...";
    text[1714] = "博士？";
    text[1715] = "美しいと 思わんかね？";
    text[1716] = "ルナーは いつだって 我々に 宇宙の驚異を 見せてくれる！";
    text[1717] = "ウェッヘッヘ... そうですねえ！\n宇宙の驚異 ウェッヘッヘ...";
    text[1718] = "人類の文明は ここまで 進歩したのだ...";
    text[1719] = "...だが それでも この世界には 謎が 山ほど 隠されている";
    text[1720] = "ゆえに 人類が持つ 可能性は...";
    text[1721] = "無限大なのだ！";
    text[1722] = "ウェッヘッヘ... 本当にそうですねえ 無限大だ！";
    text[1723] = "リーブス レポートの 内容は？";
    text[1724] = "まず マーク関連の 事案が 7件 幸運にも 人的被害は 出ていませんが...";
    text[1725] = "また ケプラー牧場の 食糧生産が 減っているとのこと";
    text[1726] = "予測不能な マークの 襲撃により インフラが 破壊されたためです";
    text[1727] = "生産量の 回復には 今しばらく 時間が かかるかもしれません";
    text[1728] = "こういうことが 続くと この先の 何十年を 持ちこたえるのは 難しくなりそうです";
    text[1729] = "悲観するな リーブス\n人々は 我らの導きを 信じているのだ";
    text[1730] = "科学の力で 人類は ここまで 生きながらえてきた";
    text[1731] = "これからも マークの 調査を続け テクノロジーを 進歩させるのだ！";
    text[1732] = "未来の世代に 繁栄を もたらすのが 我々の 使命なのだから！";
    text[1733] = "コード・レッド - 正体不明の 天体を検出！";
    text[1735] = "ナイラ 一体 何があったのだ！？";
    text[1736] = "センサーが 巨大な彗星を 特定しました！";
    text[1737] = "その座標からすると@P.@P.@P.@P";
    text[1738] = "およそ 377日後に ルナーに 接近...";
    text[1739] = "いや というよりも 正面衝突を 起こします！";
    text[1740] = "バカな！  そんな キケンな 天体が 今まで 発見されて なかっただと！？";
    text[1741] = "センサーに 異常がないとすれば...";
    text[1742] = ".@P.@P.@P.@P.@P.@P.まさか...！";
    text[1743] = "リーブス 分子スキャンを！";
    text[1744] = "...！";
    text[1745] = "博士 陽電子の 大量放出が 検出されました...";
    text[1746] = "陽電子！？  ということは...";
    text[1747] = "その天体は 反物質で できている...！";
    text[1748] = "なんということだ！";
    text[1749] = "当初の予想では あと数千年は 戻ってこないと されていたはず...";
    text[1750] = "大きさは？";
    text[1751] = "ウェッヘッヘ...！\n直径 約2000キロメートルです";
    text[1752] = "だとしたら... ルナーの半分も あるじゃないか！";
    text[1753] = "どうやら 思っていたより ずっと早く 不規則軌道から 外れたようだな";
    text[1754] = "トーマス博士 これは もしかして...？";
    text[1755] = "残念だが そのようだな";
    text[1756] = "この彗星は 千年前に テラを通過した";
    text[1757] = "それによって 人類は 滅亡寸前まで 追い込まれたのだ";
    text[1758] = "かの「コーダ彗星」が 戻ってきたのだよ";
    text[1759] = "...そして 今回 危機を 回避するための 時間は たったの 1年しか 残されていない...";
    text[1760] = "そこで ワタシに 考えがある";
    text[1761] = "リーブス";
    text[1762] = "ナイラ";
    text[1763] = "研究室で 緊急会議だ";
    text[1764] = "あと サロス将軍にも レポートを送り 出席するように 伝えてくれ";
    text[1765] = "それと...";
    text[1766] = "ベラにもな";
    text[1767] = "(セクター16の 事故から 数時間経った... あの子が 無事なら いいのだが)";
    text[1768] = "それ以外の者は コーダ彗星に 関するデータを できるだけ多く 集めてくれ！";
    text[1769] = "わかりました トーマス博士！";
    text[1770] = "(冷静さを保ち 皆を 励まさなくては)";
    text[1771] = "(人類滅亡...)";
    text[1772] = "(そんなことは あってはならない)";
    text[1773] = "(だが ルナーの未来は 今 我々の手に かかっている...！)";
    text[1774] = "ああ～ 愛する 我が家に 帰ってきたわ！";
    text[1775] = "そうね！";
    text[1776] = "あれ？  ナイラさんから 呼び出しだわ！";
    text[1557] = "ベラ あれから しばらくだけど... 大丈夫だったかしら？";
    text[1558] = "ホバークラフトを 直した後 何かトラブルが あったらしいけど...";
    text[1559] = "ああ それなら 心配ないわ\n何もかも 順調よ ナイラさん";
    text[1560] = "ただ@P.@P.@P.@P ちょっと 疲れちゃっただけで";
    text[1561] = "なるほど それなら いいんだけどね";
    text[1562] = "実は ちょっと 緊急で 伝えなくちゃいけない ことがあって...";
    text[1563] = "これから 3階の 研究室に 来てくれるかしら？";
    text[1564] = "あなたの お父さんが これから会議を 開くのだけど あなたにも 来てほしいと 言っているのよ";
    text[1565] = "だから 準備が できたら すぐに 来てちょうだい";
    text[1566] = "わかったわ！";
    text[1707] = "緊急ですって！？  ベラ 急がないと！";
    text[1567] = "きっと マークの件でしょうね";
    text[1568] = "間違いないわね  チーズケーキバー2本 賭けてもいいわ！";
    text[1569] = "テトラ あなた チーズケーキバーなんか 食べれないでしょ...";
    text[1710] = "ヘヘヘ...";
    text[1711] = "目標: 3階の 西側通路にある 研究室に 向かいましょう";
    text[2223] = "こんにちは みんな！";
    text[2224] = "おお！  ベラに テトラ！";
    text[2225] = "よく 戻ってきたな！\n無事で 何よりだ！";
    text[2226] = "セクター16の アストロバリアに 異常が 出た時は 本当に 心配したよ...";
    text[2227] = "それで 2人とも 大丈夫かな？\nどことなく 疲れてるようにも 見えるが...";
    text[2228] = "何ともないわ  ただ マークに ちょっと 手こずったくらいでね";
    text[2229] = "疲れてるって 言うなら... そっちこそ 何日も 寝てないんじゃなくって？";
    text[2230] = "んん？  いやあ それは 心配ご無用さ！  なんだって これが...";
    text[2231] = "あああああああ！";
    text[2232] = "ない！";
    text[2233] = "ゴッドエキスが！";
    text[2234] = "ゴッドエキス？";
    text[2235] = "この間は 「ソウルジュース」って 言ってたわ";
    text[2236] = "ああ... コーヒーの ことですね！";
    text[2237] = "おお ナイラよ  コーヒーの 何たるかを 解するのは 真の カフェイン通だけだ";
    text[2238] = "だからこそ ワタシは それを ゴッドエキスと 呼ぶのだよ！";
    text[2239] = "まあいい ここに 自作の コーヒーマシンがある";
    text[2324] = "ミニサイズだが クオリティは 最高級の マシンと 同レベルだ！";
    text[2240] = "ベラ お前は 何にする？";
    text[2241] = "アイス・バニラ・ラテを お願い！";
    text[2242] = "テトラも！";
    text[2243] = "あなたは 飲めないでしょ テトラ";
    text[2244] = "ああ もう うるさいわね...";
    text[2245] = "はい どうぞ！";
    text[2246] = "リーブス キミは？  いつもの ダブルショットかい？";
    text[2247] = "いいえ それじゃ 刺激が 足りませんね";
    text[2248] = "トリプルショット・エスプレッソで";
    text[2249] = "おお グッドチョイスだ！";
    text[2250] = "キミも じきに ゴッドエキスの 真髄に 到達するだろう！";
    text[2251] = "ウェッヘッヘ";
    text[2252] = "ナイラは？";
    text[2253] = "結構です... あまり 食欲がないので";
    text[2254] = "博士！  今 我々の 目の前には 深刻な問題が あるんですよ！";
    text[2255] = "まあ 落ち着きたまえ";
    text[2256] = "うーむ 淹れたての この香り！\nこの1杯が 我が精神を 自由に してくれる...";
    text[2257] = "ワタシの ラックスは今 銀河レベルと 言ったところかな アハハハ！";
    text[2258] = "博士 カフェインも ほどほどに しないと  今日はもう これで 4杯目ですよ！";
    text[2259] = "ウェッヘッヘ... でも コーヒーは 博士の 一部みたいなもんです";
    text[2260] = "これが 博士の 天才的 ひらめきの ヒケツだって 言われるくらいでさ！  ウェヘヘ！";
    text[2261] = "...ようし！  では 本題に入ろう";
    text[2262] = "ベラ 我々は 今 緊急事態に 直面している";
    text[2263] = "だから これから 話すことは... くれぐれも 他言しないでおくれ";
    text[2264] = "世間に これが 知れ渡ったら パニックに なりかねんからな";
    text[2265] = "何ですって！？";
    text[2266] = "そんなの！  ありえないわ！！";
    text[2267] = "その彗星を 今すぐ 何とかしないと！";
    text[2268] = "どうしたらいいの！？";
    text[2269] = "ワタシが 力になれることは ある？";
    text[2270] = "テトラも 力になりたいわ！";
    text[2271] = "まあまあ 落ち着いて";
    text[2272] = "この問題に ついては いきなり すべてを 解決はできん";
    text[2273] = "コーダ彗星は 未知の タイプの 反物質で 構成されている";
    text[2274] = "とても 不安定で エネルギー密度が 高いのだ";
    text[2275] = "その昔 テラの人々は わずかな 望みにかけ コーダ彗星の 破壊を試みた...";
    text[2276] = "が...";
    text[2277] = "...結局 失敗に 終わった";
    text[2278] = "彗星は 軌道上に あるもの すべてを 破壊した";
    text[2279] = "あら... テトラの プラズマブラスターで 彗星を 消せるかもと 思ったのに...";
    text[6012] = "アストロバリア防衛システムでは どうにか なりませんかね？";
    text[6013] = "アストロバリアは 小さな隕石や スペースデブリには 対処できるが";
    text[6014] = "それ以上の サイズとなると...";
    text[6015] = "...防ぐことは できんのだよ";
    text[2280] = "つまり 我々の 現在の テクノロジーでは コーダ彗星を 止めることは できない";
    text[2281] = "だが それでも... まだ 希望はある！";
    text[2282] = "それは... テレポートだ";
    text[2283] = "ウェヘー？";
    text[2284] = "...！";
    text[2285] = "我々は 人間を 限られた 距離ではあるが テレポートさせる 技術を 持っている";
    text[2286] = "それを応用し 規模を拡大し 調整を施し..";
    text[2287] = "...何だか どこかで 聞いたことのある 話だわ  トーマス博士...";
    text[2288] = "あれは ムリです！";
    text[2289] = "いいや できる";
    text[2290] = "かの 「セレスティア」を 完成させれば コーダ彗星を 防げるのだ！";
    text[2291] = "あまりにも リスキーだわ... だから シアも あのプロジェクトを 中止したんでしょう！？";
    text[2292] = "ナイラよ... もう他に 方法が ないのだよ！";
    text[2293] = "ウェヘー？";
    text[2294] = "リーブス... 何の話を してるのか わかる？";
    text[2295] = "いいや まったく...";
    text[2296] = "多分 ボクが ここに 入る前に あった プロジェクトの ことじゃないかな...？";
    text[2297] = "ナイラ... 今こそ あれを 完成させる時が 来たのだよ";
    text[2298] = "大きなキケンは 伴うだろうが 成功の確率も これが 一番 高いはずだ";
    text[2299] = "ねえ パパ 一体 何の話を してるの？";
    text[2300] = "フフッ すぐに わかるさ";
    text[2301] = "ナイラ このことは もう サロスにも 話してある";
    text[2302] = "それで 彼は 何と？";
    text[2303] = "賛成したよ\nそして もう ミッションの 準備に 取りかかっている";
    text[2304] = "...そうですか";
    text[2305] = "ああ トーマス... あの 狂った計画を 進めようだなんて ";
    text[2306] = "だから ボクたちは マッドサイエンティストと 呼ばれてるんでしょ ウェッヘッヘ！";
    text[2307] = "リーブス そんな呼び方を してるのは あなただけよ！";
    text[2308] = "ウェヘー！";
    text[2309] = "もし あのプロジェクトを 復活させるなら";
    text[2310] = "今度こそ ミスは 許されないわ...";
    text[2311] = "皆で 力を 合わせれば 必ずや 成功を収め... 人類は 救われるだろう！";
    text[2312] = "それでは キミたち ワタシに ついてきてくれたまえ";
    text[2313] = "何だか 実感が わかないわ... あまりにも 突然で...";
    text[2314] = "大丈夫よ ベラ\nやれることを やったら きっと うまくいくわ！";
    text[2315] = "スーパーアシスタント・ロボの テトラが コーダ彗星なんか ブッ飛ばして やるんだから！";
    text[2316] = "そうね テトラ\nルナーの みんなは ワタシたちを 信じている";
    text[2317] = "その信頼を 裏切ることは できないわ！  さあ パパのところに 行きましょう";
    text[2326] = "この部屋に 入ったの 初めてだわ！";
    text[2327] = "ウェッヘッヘ ボクもだよ";
    text[2328] = "ここに 入れるのは ごく限られた者のみだ";
    text[2329] = "さて 「ネクサス・ラボ」へ ようこそ！\nここでは トップシークレットの 研究が 行われている";
    text[2330] = "ウェー！  何だ このマシンは！？";
    text[2331] = "これこそが まさに キミたちに 見せたかったものだよ！";
    text[2332] = "その名も「セレスティア」\n人類史上初の ワームホールマシンさ！";
    text[2333] = "ウェヘヘヘヘヘ！";
    text[2334] = "すんごいなあ！\n何て 発明なんだ！";
    text[2335] = "それで 計画というのは ワームホールで コーダ彗星を 止めるって ことですかい？";
    text[2336] = "まさしく！";
    text[2337] = "このセレスティアは 偉大なる 科学力の 結晶と 言えよう！";
    text[2338] = "でも セレスティアに そんな でっかい ワームホールを 作れるんで？";
    text[2339] = "理論上は 可能よ\nでも 今はムリね";
    text[2340] = "このセレスティアは まだ試作品で";
    text[2341] = "完成までの 道のりは まだまだ 遠いわ";
    text[2342] = "しかも この件には タイムリミットが ある...";
    text[2343] = "完成には どれくらい かかるんで？";
    text[2344] = "最短で 6か月か... いや うまくいけば もっと早く いけるかもしれん";
    text[2345] = "また この計画を 成功させるには 別の人材も 必要だ";
    text[2346] = "ベラを 呼び出したのは そのため なのですね？";
    text[2347] = "それで ワタシは 何をすれば いいわけ？";
    text[2348] = "できることなら 何だってするわよ！";
    text[2349] = "セレスティアは 巨大な ワームホールを 維持するため";
    text[2350] = "特殊な エネルギーによって 動いている";
    text[2351] = "それは ズバリ 宇宙最強の エネルギー 「反物質」だ！";
    text[2352] = "そして コーダ彗星に 対処できる ワームホールを 作るには";
    text[2353] = "大量の 反物質が いるのだよ！";
    text[2354] = "そして 現在 反物質を 得るための 唯一の 手段は...";
    text[2355] = "...マークですね？";
    text[2356] = "その通り";
    text[2357] = "ええ！？  なら 何千もの マークを 殺せって 言うわけ！？";
    text[2358] = "そんなの@P.@P.@P.@P.";
    text[2359] = "イヤ@P.@P.@P.@P.";
    text[2360] = "ベラ... その気持ちは よくわかるが";
    text[2361] = "人類の 未来のためには そうするしか ないのだよ！";
    text[2362] = "...";
    text[2363] = "ママが ここにいたら きっと 違うやり方を 提案していた はずよ！";
    text[2364] = "だから パパの 考えには...";
    text[2365] = "おお ヴィヴィア司令官！";
    text[2366] = "ごきげんよう トーマス博士";
    text[2481] = "君が 来たということは...";
    text[2367] = "ええ サロス将軍も 到着したわ";
    text[2368] = "もう ここに 来ているって？";
    text[2369] = "おお 伝説の 英雄に ついに 会えるだなんて！ ウェヒヒヒヒー！";
    text[2370] = "彼が 動いてくれると なれば 反物質コアも あっという間に 集められるはずだ！";
    text[2371] = "皆さん どうも！";
    text[2372] = "待たせてしまったなら すまない";
    text[2373] = "一応 急いで 来たつもりでは あるんだが";
    text[2374] = "それは ともかく あなたたちに 会えて とても光栄だ！";
    text[2375] = "トーマス もう ここにいる人たちに 計画の説明は してあるのだろう？";
    text[2376] = "ああ ほぼ全員が 納得してくれたよ";
    text[2377] = "「ほぼ」？";
    text[2378] = "それが...";
    text[2379] = "ああ...";
    text[2380] = "ならば 反対したのは きっと ベラだろう？";
    text[2381] = "サロス将軍 大量の マークを 殺すことが 正しいとは 思えません";
    text[2382] = "なら 一つ お尋ねしても よろしいかな？";
    text[2383] = "キミは 人類を 救いたいと 思わないかね？";
    text[2384] = "もちろんです";
    text[2385] = "となれば 反物質コアを 集めることが 必須になる";
    text[2386] = "マークは 人間とは まるで 相容れぬ 心を持たぬ 怪物だ";
    text[2387] = "決して 我々の世界に 属するものでは ないのだよ";
    text[2388] = "ただ一つ マークの存在に 価値が あるとすれば... それは 反物質コアだ";
    text[2389] = "......";
    text[2390] = "セレスティアの 開発は 十年前に 始まった";
    text[2391] = "キミの お父さん ナイラ その他 何人かの 科学者が プロジェクトに 携わっていた";
    text[2392] = "その当時 進展は ごくわずかだった";
    text[2393] = "ワームホールの 実験は 最初の 7回は うまくいったが...";
    text[2394] = "残念なことに 8回目が 最後となってしまった";
    text[2395] = "セレスティアが 突然 暴走し 不安定な ワームホールを こしらえたのだ";
    text[2396] = "そこに 吸い込まれた者は 全員 分子レベルにまで 分解されてしまった...";
    text[2397] = "その日 我々は 4人の 偉大な 仲間を 失った...";
    text[2398] = "これによって プロジェクトは 前任の将軍... つまり キミの 母上が 終了させてしまった";
    text[2399] = "彼女は 仲間の死を 悼み これ以上の 犠牲を 出すことに 耐えられなかったのだ";
    text[2400] = "ええ... ママなら きっと そうするでしょうね...";
    text[2401] = "そうした 悲しい できごとは あったが 今回は これを 完成させなくてはならない";
    text[2402] = "あのときの 仲間の死を ムダにしないためにもな";
    text[2403] = "そして 人間に 危害を加える マークにも 正義の裁きを 下さねばならん！";
    text[2404] = "かつては 反物質について わからないこと だらけだった";
    text[2405] = "しかし その時から 広範囲にわたる 研究を重ねた";
    text[2406] = "そうした 知見の 蓄積により ワームホールの リスクは 以前より 小さくなったと 見ていい";
    text[2407] = "今回は きっと うまくやれるはずだ";
    text[2408] = "そして その技術が 完成した 暁には マークと コーダ彗星の 脅威は 克服されるだろう！";
    text[2409] = "いやあ まさしく その通りでさ！  ウェッヘッヘ";
    text[2410] = "サロス将軍の 言うことは もっともだわ";
    text[2411] = "ベラ ワタシも 父として 娘を キケンに晒すのは 辛いのだ...";
    text[2412] = "...それでも お前の力を 頼りにしている";
    text[2413] = "そうとも キミは ルナーでも 最高クラスの 戦士なのだから";
    text[2414] = ".@P.@P.@P.@P.";
    text[2415] = "ハッハッハ！";
    text[2416] = "その目が すべてを 物語っているね";
    text[2417] = "いいだろう";
    text[2418] = "では... この結論は 勝負で出すと しようじゃないか！";
    text[2419] = "な 何ですって？";
    text[2420] = "勝負？";
    text[2421] = "そうだ 己の 信念の強さを 力として 証明するのだ";
    text[2422] = "ワタシに 最強の 戦闘テクニックである ラックスコンボを 当ててみたまえ";
    text[2423] = "遠慮はいらん  全力で来るのだ！";
    text[2424] = "ワタシが 勝てば ミッションに 参加し 従ってもらおう";
    text[2425] = "ワタシが 勝ったら...？";
    text[2426] = "その時は...";
    text[2427] = "まあ わかるさ";
    text[2428] = "ベラ 気をつけて！\nサロス将軍は ルナー最強の 戦士よ！";
    text[2429] = "わかりました サロス将軍\n...あなたの提案 受け入れます！";
    text[2430] = "いい返事だ！\nならば いざ 尋常に 勝負！";
    text[2431] = "うむ これくらいで 十分だろう！";
    text[2432] = "ベラ 大丈夫か？  ケガは？";
    text[2433] = "イタタ... 今の ワタシじゃ 到底 勝ち目なんて ないわね...";
    text[2434] = "キミは 今 負けこそしたが... その覚悟は 大いに 示してくれた";
    text[2435] = "これほどまでに 楽しい戦いは 久しぶりだったぞ！  ハッハッハ！";
    text[2436] = "やはり あの母上に 鍛えられた だけはあるな";
    text[2437] = "ぐう...";
    text[2438] = "それでも 不必要な 殺しは イヤなんです... この気持ちって わがままですか？";
    text[2439] = "本当に 他に道は ないんですか...？";
    text[2448] = "ベラよ そこまで 思い悩むなら 少し 時間をとって 考えてみるのは どうかな？";
    text[2449] = "それじゃあ... ミッションは 強制ではないと？";
    text[2450] = "うむ 今 言ったように キミは 先ほど その覚悟を 見せてくれた";
    text[2451] = "そうした信念を 強く持っているならば それは世界を 変える力にも なるはずだ";
    text[2452] = "選択は キミ自身の 手に ゆだねよう";
    text[2453] = "我々と 共に歩むか 己の道を こしらえるかだ";
    text[2454] = "その間 ワタシは 将軍として ルナーのために 最善を尽くす";
    text[2457] = "ヴィヴィア トレーニング計画を 強化し 兵士の数を さらに増やすのだ";
    text[2458] = "了解";
    text[2459] = "それと 最高クラスの 部隊のみに コーダ彗星の件を 伝えるように";
    text[2460] = "研究所が ワームホールの 問題に 取り組む間";
    text[2461] = "ルナーフォースは 反物質コアの 回収を 優先し 兵力を 増強し";
    text[2462] = "対マーク用の バトルロボットの 生産を 強化するのだ！";
    text[2463] = "はっ！";
    text[2464] = "トーマス セレスティアの 件は キミに 一任しよう  くれぐれも ワタシを 失望させないでくれよ";
    text[2465] = "わかっているとも サロス\nそちらこそ 必要な 反物質コアを キチンと 集めておくれ！";
    text[2466] = "アッハッハ！  もちろんだとも！";
    text[2467] = "...フゥ";
    text[2468] = "どうして 人類には こういう危機が 何度も 来るのだろうな？";
    text[2469] = "ひょっとしたら 宇宙は このような形で 我々を 試しているのかもしれん...";
    text[2470] = "...種としての進化を 見極めるために";
    text[2471] = "だからこそ 乗り越えなくては！  では みんな 今日から 全力で 前に進んでいこう！";
    text[2472] = "ラックスの輝きよ 永遠なれ！";
    text[2473] = "ヴィヴィア 行こう";
    text[2474] = "ベラ！  大丈夫？";
    text[2475] = "...";
    text[2476] = "なんだか いろんなことが 頭に浮かんで...";
    text[2477] = "ちょっと オシアナスにでも 行くわ";
    text[2478] = "一緒に来る？";
    text[2479] = "もちろん！  でも どうして オシアナスに？";
    text[2480] = "それは 行っての お楽しみよ";
    text[2483] = "わかったわ！\nじゃあ さっそく レッツ ゴー！";
    text[2491] = "わあ！  きれいなビーチね！";
    text[2492] = "ちょっと 泳ぐ？";
    text[2493] = "いい気分転換に なるわよ！";
    text[2494] = "大丈夫 ワタシは 防水仕様なんだから";
    text[2495] = "そういうので ここに 来たわけじゃ ないのよ テトラ";
    text[2496] = "あら...";
    text[2497] = "テンション 低くて ごめんなさい...";
    text[2510] = "いいのよ ベラ！  テトラは ただ ベラを 元気にしたいだけなの！  エヘヘ！";
    text[2499] = "オシアナス...";
    text[2500] = "ルナーで 一番 キレイな 場所だわ";
    text[2501] = "ママと パパと ワタシで よく ピクニックに 来たっけ";
    text[2502] = "パパは 仕事の 疲れを癒し";
    text[2503] = "ママと ワタシは トレーニングを する... あの頃は 良かったわ";
    text[2504] = "久しぶりに 来ただけで 心が 軽くなる 感じよ！";
    text[2505] = "それで ベラ どうして ここに 来たわけ？";
    text[2506] = "ルナーフォースに 入ってから すごく 忙しかったでしょ？";
    text[2507] = "それに 今は 彗星の件も あるし";
    text[2508] = "次 ここに 来れるのは いつに なるのか それすら わからないわ...";
    text[2509] = "そして コーダ彗星を 止めなきゃと 考えるだけで 気持ちが 休まらなくなる";
    text[2511] = "でも サロス将軍は ワタシに 考える時間を くれた...";
    text[2512] = "何か いいアイデアが 出れば あの人の意見を 変えられるかも しれないわね！";
    text[2513] = "そうねえ...";
    text[2514] = "問題は セレスティアが 反物質エネルギーを 必要とする ことだけど...";
    text[2515] = "ええ だから サロス将軍は 反物質コアを 集めると 言っているわ";
    text[2516] = "でも...";
    text[2517] = "他に 反物質を 手に入れる方法が あるとしたら？";
    text[2518] = "例えば？";
    text[2519] = "ほら 反物質で 溢れかえった場所が あるでしょう！";
    text[2520] = "反物質で 溢れかえった 場所...？";
    text[2524] = "ああ ファントムスペースの こと！？";
    text[2521] = "そうよ！";
    text[2522] = "あなたも 見たでしょ テトラ！";
    text[2523] = "だから ファントムスペースを 探索して 反物質を ゲットするの！";
    text[2525] = "もちろん ワタシたちだけで 行くのは キケンだから そのための チームが いるけどね";
    text[2526] = "ただ そのためには パパに ファントムスペースに 行ったことを 明かさなくちゃ いけないわ...";
    text[2527] = "でも ワタシたちが 無事だったわけだから 探索にも 同意してくれる かもしれない";
    text[2528] = "でも 本気なの ベラ？";
    text[2529] = "ええ たとえ険しい道でも 進む価値は あるわ";
    text[2530] = "少なくとも マークは 殺さなくて すむんだから";
    text[2531] = "そうね なら 早速 トーマス博士の ところに 行きましょ！";
    text[2532] = "待って その前に やることが あるわ";
    text[2533] = "ルナーフォースが クロノスの 反物質コアを 手に入れたら";
    text[2534] = "エネルギーとして 使われてしまうはず";
    text[2540] = "クロノスを そんな目に 遭わせたくないわ";
    text[2535] = "マークは 怪物かもしれない\nでも ワタシたちと 同じように 魂を 持っているのよ";
    text[2536] = "クロノスは 勇敢に ワタシたちを 守ってくれた";
    text[2537] = "だから これは ワタシなりの 感謝の 示し方よ";
    text[2538] = "さて テトラ  宇宙ステーションに 戻って パパと 話をつけましょ！";
    text[2539] = "そうね レッツ ゴー！";
    text[2561] = "おお ベラ！  気分は どうだい？";
    text[2562] = "ミッションに ついて 考えは 変わったかな？";
    text[2563] = "気分は 良くなったけど 考えは 変わってないわ";
    text[2564] = "ワタシは もう 自分の道を 行くことに 決めたの";
    text[2565] = "ちょっと アイデアが あってね... パパにも 聞いてほしいんだけど";
    text[2566] = "ただ...";
    text[2567] = "頼むから 怒らないで\n最後まで 説明させてね";
    text[2568] = "怒ったりなど しないさ\nただ お前が 心配なだけで...";
    text[2608] = "心配することなんかないわ\nワタシは 全然 平気よ";
    text[2569] = "ベラ... お前が ファントムスペースに 行ってたことは 知っているぞ";
    text[2570] = "ええ！？  ど どうして？";
    text[2571] = "それについては サロス将軍が 説明 してくれる";
    text[2572] = "やあ！  突然 すまないね";
    text[2573] = "ベラ 戻ってきてくれて うれしいぞ";
    text[2574] = "ワタシの 計画に 参加するかは 別として キミは 今 ここにいる";
    text[2575] = "それは つまり 己の決意を しっかりと 貫いていると いうことだ";
    text[2576] = "先日 戦った時 キミの バトルギアに スターダストが ついていることに 気づいたのだ";
    text[2577] = "(信じられないわ！？  戦闘の 最中に 気づいたですって)";
    text[2578] = "また センサーも 同様に 反物質を 検出していた";
    text[2579] = "これについて 規則があることは キミも 知っているはずだ  何があったのか 説明してもらおう";
    text[2580] = "ファントムスペースに 行くことが 禁じられているのは わかってますが 仕方が なかったのです";
    text[2581] = "セクター16に 侵入した マークが 突然 こっちに 襲いかかってきて！";
    text[2582] = "それで ワームホールに 入れられ ファントムスペースに 飛ばされてしまったんです";
    text[2583] = "ほほう...！";
    text[2584] = "マークは 一般に 心を持たず 破壊の 本能のみで 動くと 言われているが";
    text[2585] = "このような事例は 初めてだ...";
    text[2586] = "実に興味深い...！";
    text[2587] = "それで マークは？";
    text[2588] = "倒しました";
    text[2589] = "...その反物質コアは？";
    text[2590] = "そ それは...";
    text[2591] = "なくしました";
    text[2592] = "ルナーに戻る 脱出ルートを 探すのに 必死で...";
    text[2593] = "なるほど";
    text[2594] = "それは 運が 良かったな";
    text[2595] = "人間は ファントムスペースでは 72時間しか 生存できないのよ";
    text[2596] = "48時間が 経過すると 身体に 異変が 現れ始めるわ";
    text[2597] = "そして 72時間を 過ぎると 反物質で 体の分子が バラバラに なってしまうの ";
    text[2598] = "我々は それを 手痛い 教訓として 学んだのだ";
    text[2599] = "ええ！？";
    text[2600] = "ベラ この後 すぐに 生体スキャンを 受けなさい！";
    text[2682] = "ワタシは そうしろって 言ったのに ベラは 聞かないのよ...";
    text[2601] = "大丈夫よ パパ\nいたのは せいぜい 数時間だから";
    text[2625] = "今回は 無事で 済んだが 次回も そうだという 保証はない";
    text[2626] = "思うに お前の 考えというのは ファントムスペースの 探索だろう？";
    text[2627] = "ええ... そこでなら 十分な 反物質を 集められるかもと 思って";
    text[2602] = "ファントムスペースには 反物質の 密度が 非常に高い 場所がある";
    text[2609] = "そこに入ると 人体は一瞬で バラバラに なってしまう";
    text[2610] = "ファントムスペースに いる マークを 狩るという 提案は 過去にもあった";
    text[2603] = "だが そのやり方は リスクが 大きすぎる";
    text[2611] = "そこには まだ 未知の要素が たくさんあるのだ";
    text[2612] = "一つ わかっているのは 反物質は 不安定だと いうことだ";
    text[2613] = "セレスティアに 必要なのは 安定した 反物質であり";
    text[2614] = "だからこそ 反物質コアが ベストオプションになる";
    text[2615] = "ファントムスペースは... 物質で できたものは 存在できない 世界なのだよ";
    text[2616] = "我々の肉体が 進化して 限界を 超えられたら 良いのだが...";
    text[2617] = "その時 人類は 銀河すら 超えることが できるだろう...";
    text[2618] = "それで ワタシは 降格ですか...？";
    text[2619] = "いいや キミは とても 優秀な 戦士だ";
    text[2620] = "今回の 規律違反については やむを得ぬ 事情があった";
    text[2621] = "...ただし 今後は ゼッタイに ファントムスペースには 行かないように";
    text[2622] = "...あ ありがとうございます...";
    text[2604] = "(ああ でも...)";
    text[2623] = "(これでもう アイデアは ダメに なっちゃったわ...)";
    text[2624] = "ベラ セレスティアに どれくらいの 反物質コアが いるのか 計算したんだ...";
    text[2628] = "その数は ルナーに出現する マークだけでは 到底足りない...";
    text[2629] = "つまり ここらに 現れる マークを すべて 倒しても";
    text[2630] = "セレスティアを 動かすことは できないのさ...";
    text[2631] = "そんな...";
    text[2632] = "なら どうするわけ？";
    text[2633] = "希望は まだある！";
    text[2634] = "良いリーダーとは 常に 不測の事態に 備えておくものだ";
    text[2635] = "そう 我々には 3つ目の オプションがある";
    text[2636] = "何ですって！？";
    text[2637] = "ウェヘー！";
    text[2638] = "その方法なら 大量の マークを 殺さなくても いいかもしれない";
    text[2639] = "実は これはワタシと ヴィヴィアが 慎重に 練っていた 新しい ミッションだ";
    text[2640] = "彼女の ホロテクノロジーの 技術が 成功の カギになる";
    text[2641] = "ただ そのターゲットは 我々にとって 長い間 悩みのタネだった";
    text[2642] = "それで 作戦を 手短に言うと 必要な数の 反物質コアを 得るために...";
    text[2643] = "マークスレイヤーを 捕らえるのだ";
    text[2676] = "1時間後...";
    text[2644] = "...以上だ";
    text[2645] = "...よろしいかな？";
    text[2646] = "了解！";
    text[2677] = "なるほど これなら うまくいくかもですね ウェッヘッヘ！";
    text[2678] = "ええ 今のところ 考えうるかぎり 最高の オプションだわ";
    text[2679] = "確かに マークスレイヤーを 野放しにしては いけない...";
    text[2647] = "ベラ この作戦の 成否は キミの強さと 決意に かかっている";
    text[2648] = "全力で がんばります サロス将軍！";
    text[2649] = "希望を 与えてくれたことに... 感謝します";
    text[2650] = "これが うまくいけば もうマークを 殺さなくてすむ...";
    text[2651] = "それでは これにて 解散だ  今後に備え しっかりと 体を 休めておくように";
    text[2652] = "ワタシと ヴィヴィアは これより 最後の 準備にあたる  それから...";
    text[2653] = "チャンスが 来るのを 待とう";
    text[2654] = "管制センター 一体どうした？";
    text[2655] = "『将軍 コペルニクスに マークが 大量発生しました！』";
    text[2656] = "何体だ？";
    text[2657] = "『数百です...』";
    text[2681] = "なんということだ... そんな数の マークが 現れるなど 前代未聞だぞ...";
    text[2680] = "管制センター セクター7に 緊急事態宣言を 発令せよ";
    text[2658] = "最高クラスの 部隊を 派遣し 市民を 速やかに 避難させるのだ！";
    text[2660] = "さらに バトルロボットを 出動させよ！";
    text[2659] = "『了解！』";
    text[2661] = "サロス将軍 どうやら早速 チャンスが 巡ってきた ようですね！";
    text[2662] = "マークが 現れるところ マークスレイヤーも きっと 現れます";
    text[2671] = "いいや まだだ\nもう少し 時間がいる";
    text[2672] = "ことは慎重に 計画に沿って 進めないと 成功は 危うくなる";
    text[2673] = "マークスレイヤーが 現れたら ワタシが 時間を 稼ぎます";
    text[2663] = "ひょっとしたら 話が できるかもしれない... お願いです！";
    text[2664] = "現れなければ また次回に 賭ければいい！";
    text[2665] = "その場合は 市民を 守ることに 全力を 注ぎます！";
    text[2674] = "....";
    text[2666] = "いいだろう  ならば 幸運を 祈るぞ ベラ";
    text[2667] = "気をつけるのだぞ ベラ！";
    text[2668] = "もちろんよ パパ\nでも 今回は ワタシに 任せて！";
    text[2669] = "緊急ミッション:  マーク大量発生";
    text[2670] = "セクター7 - コペルニクスに 向かい マークの 襲撃を 食い止めましょう！";
    text[2683] = "どこもかしこも マークだらけよ！";
    text[2684] = "大量発生という表現も あながち 大げさじゃ なかったわね！";
    text[2685] = "ベラ どうするの？  もう 辺りは メチャクチャよ！";
    text[2686] = "まずは 市民を 全員 避難させるのよ！";
    text[2687] = "ちょっと待った！";
    text[2688] = "ウェヘー！\nベラ 実は 今 マークよりも 緊急の 問題が あるんだ！";
    text[2689] = "リーブス！\nどうしたってわけ？";
    text[2692] = "キミと テトラには 真っ先に 水道ネットワークを どうにか してほしいんだ！";
    text[2690] = "市民の 避難については 他の部隊が 何とか してくれるから 心配しなくていい！";
    text[2693] = "それで 水道ネットワークが どうしたって？";
    text[2694] = "ウェヘー！\n町の水が 紫色に なっちゃったって 話さ！";
    text[2695] = "ええー！？  何ですって！？";
    text[2696] = "でも 辺りは マークだらけよ  まずは そっちを どうにか すべきじゃなくって？";
    text[2697] = "それは 他の部隊の 仕事だと 言ったでしょ！";
    text[2698] = "紫の水は 高濃度の マンガン酸カリウムの せいだ";
    text[2699] = "それは本来 有害な 細菌の 消毒に 使われる";
    text[2700] = "ただし 量が 多すぎると かえって 毒になり";
    text[2701] = "人々を 呼吸困難に 陥れてしまう！";
    text[2702] = "コペルニクスは 重要な 貯水池の上に 作られた町だ";
    text[2703] = "ルナーの民の 生存に 水は 欠かせないものだ  だから 何としても 守らないといけないのさ！";
    text[2704] = "この町には 4台の フィルタマシンがある";
    text[2705] = "その4台 すべてを 特定し テトラに ネットワークを 修復させてくれ！";
    text[2706] = "了解！";
    text[2707] = "ようし テトラ 水道ネットワークの 修復 これから やっていくわよ！";
    text[2708] = "スーパーアシスタント・ロボ テトラの 腕の 見せどころね！  それじゃあ レッツ ゴー！";
    text[2710] = "誰か 助けてー！！";
    text[2711] = "さあ 今が 逃げる チャンスよ！  ここは ワタシに 任せて！";
    text[2712] = "今すぐ 安全な 場所に 避難を！";
    text[2713] = "わ わかりました！  どうも ありがとう！  どうか ご無事で！";
    text[2714] = "ふぅ... あの親子が 助かって 良かったわ... ギリギリ だったわね";
    text[2715] = "ベラ 気を 緩めちゃ ダメよ！  何か 奇妙な 信号が 検出されているわ...！";
    text[2716] = "マークスレイヤー！\n不意打ちなんて 卑怯な！";
    text[2717] = "痛いじゃないの！  うう...";
    text[2718] = "また お前か...";
    text[2719] = "フェイズパンチを 食らっても 立っているとは 驚いたな...";
    text[2720] = "どうやら 思ったよりは やるようだな";
    text[2721] = "うぐう... ハァ... ハァ...";
    text[2722] = "あなたに... 話が あるわ...";
    text[2723] = "何？  オレたちは 敵だ\n話すことなど 何もない";
    text[2724] = "だが これを機に お前と ルナーフォースへ 警告だけは しておこう";
    text[2725] = "「死にたくなければ オレの ジャマを するな」";
    text[2726] = "ルナーフォースは この世で 最も 反物質コアを 持つべきでない 連中だからな";
    text[2727] = "ぐうっ... 行ったわね";
    text[2728] = "ベラ！  大丈夫？";
    text[2729] = "ええ だいぶ マシになったわ\n少し休めば 大丈夫よ";
    text[2730] = "あいつ 今は どこかに 行ったけど この街を すぐに去るとは 思えない";
    text[2731] = "おそらく 反物質コアを 集めに 来たはず...  なら 話をする チャンスも あるはずよ";
    text[2732] = "テトラ 水道ネットワークを 直しに行く 間も あいつが いないか 注意してね！";
    text[2733] = "了解！";
    text[2734] = "...と思ったけど ヤバいわ！";
    text[2735] = "どうしたって 言うの？";
    text[2736] = "もっと マークが！";
    text[2737] = "まずいわね... これじゃあ らちが明かない";
    text[2738] = "水道ネットワークの 所に 向かうことすら できないわ...";
    text[2739] = "そうなると マークスレイヤーに 会うことも できない...";
    text[2740] = "あらら さすがの 天才ちゃんも ピンチみたいね！";
    text[2741] = "！？";
    text[2742] = "バレットパーンチ！！";
    text[2743] = "レイン！？";
    text[2744] = "こんなところで 何を？  あなた 別の任務に 割り当てられてたんじゃ？";
    text[2745] = "管制センターから 救援を 頼まれたのよ  かなりヤバイ 状況だからって...";
    text[2754] = "それで 助けたんだから まずは一言 お礼を言うのが スジなんじゃなくって？";
    text[2746] = "ああ もう そんな場合じゃ ないでしょ！ 敵が 来るわよ！";
    text[2747] = "あと 前に 「天才ちゃん」って 呼び方は やめてって 言ったでしょ！";
    text[2748] = "わかったわよ！  後で スパーリングに 付き合ったら やめてあげる！";
    text[2749] = "リマッチから 逃げるのは 許さないわよ！";
    text[2750] = "わかってるわよ！";
    text[2751] = "でも まずは 目の前の マークを 片づけるのが 先なんじゃなくって！？";
    text[2752] = "もちろん！  それに 援護に来たのは ワタシだけじゃ ないわ！";
    text[2753] = "さあ あなたたち！  マークどもに レイン隊の 力を 見せてやるわよ！";
    text[2755] = "レビストーンピアサー！";
    text[2756] = "プラズマケージ！";
    text[2757] = "メロディーに ザラ！";
    text[2758] = "お久しぶりね テトラちゃん！  相変わらず とっても かわいいわ！";
    text[2759] = "エヘヘヘ あなたもね メロディー！";
    text[2760] = "こんにちは ベラ！";
    text[2761] = "あなた ボコボコにされた 姿も とても かわいらしいわよ！";
    text[2762] = "ええっと... そりゃ どうも？";
    text[2763] = "それで ザラ 今のは 新しい コンボ攻撃な わけ？";
    text[2764] = "そうよ";
    text[2765] = "マークを 追い払うための 効果的かつ エレガントな 新コンボを 開発したの";
    text[2766] = "今回は できるだけ マークを 殺さないようにと 言われてるし";
    text[2767] = "なら この中に バレットパンチを 自粛すべき人が 約1名 いるんじゃなくって？";
    text[2768] = "うるさいわね！";
    text[2769] = "戦いとは 常に 全力で するものよ！";
    text[2770] = "たとえ スパーリングでもね！  これが 緊急ミッションでなければ...";
    text[2771] = "今すぐ アンタを ボコしてやる ところだわ！  ガーッハッハ！";
    text[2772] = "落ち着いて レイン\n今は 目の前の 戦いに 集中しましょう";
    text[2773] = "ああ もう わかってるわよ";
    text[2774] = "ベラ さっき リーブスから ミッションレポートを 受けたわ";
    text[2775] = "あなたと テトラは 今すぐ 水道ネットワークを 直すべきだって！";
    text[2776] = "だから ここは ウチらに 任せろってこと！";
    text[2777] = "これから マークどもに ルナーの民を 代表し 怒りの鉄槌を 下してみせるわ！";
    text[2778] = "レイン マークを 殺すのは ダメよ";
    text[2779] = "なら ちょっぴり 手加減は してあげる";
    text[2780] = "ちょっぴりだけね！";
    text[2781] = "さて それじゃあ エレガントに 任務を 済ませるとしましょう";
    text[2782] = "ところで 今回は サロス将軍から ヒミツの ミッションも 命じられたわ";
    text[2783] = "マークスレイヤーを 見つけたら 捕まえろって！";
    text[2784] = "レイン隊が この大手柄を 上げたら 一発昇進は 間違いないわね！  ガーッハッハ！";
    text[2785] = "フッ... まあ ワタシに 先を 越されなければね！";
    text[2786] = "あと 一言 アドバイスしておくけど あいつの フェイズパンチには 気をつけなさいよ";
    text[2787] = "フェイズパンチ！？  何ですって！？";
    text[2788] = "(つまり ベラは もう 彼と 戦ったのね？  ウーン...)";
    text[2789] = "(フェイズパンチ... いいネーミングだわ...)";
    text[2790] = "この世で 最も パンチを 極めし者は このワタシよ！  そんな技は 許されないわ！！";
    text[2791] = "そういうことで またね ベラ！  助けがいる時は いつでも 援護するわ！";
    text[2792] = "うん ありがと！";
    text[2793] = "ああ ベラ  あそこ見て！  フィルタマシンよ！";
    text[2794] = "そうね 今すぐにでも 向かいましょう！";
    text[2555] = "ベラ まずは 水道ネットワークを 修復しないと いけないわ！";
    text[2556] = "セキュリティ・ファイアウォールを 突破するには";
    text[2557] = "計4つの フィルタマシンに 入る必要があるわ！";
    text[2558] = "水道ネットワークに 入る？";
    text[2808] = "なるほど お前 よほど 人の話を 聞かない タチらしいな";
    text[2809] = "そのセリフ そっくり そのまま お返しするわよ！";
    text[2810] = "さっき 警告は したはずだ...";
    text[2811] = "待って！";
    text[2812] = "お願いだから やめて！";
    text[2813] = "どうした？  時間を 稼いで 仲間を 呼ぶつもりか？";
    text[2814] = "...そうして かのマークスレイヤーを 捕まえてやろうと？";
    text[2815] = "愚かな";
    text[2816] = "違うわ...";
    text[2817] = "捕まえようだなんて 思ってない  ただ 話が したいだけ";
    text[2818] = "ウソをつくな  お前らは どこまでも ウソの塊だ";
    text[2819] = "ウソじゃないわ！";
    text[2820] = "ワタシは...";
    text[2821] = "...あなたが 思ってるより あなたを よく知ってるのよ...";
    text[2822] = "...？";
    text[2823] = "何であれ お前は すべての 真実を 知らない";
    text[2824] = "正義の 裁きは じきに下る";
    text[2825] = "待ちなさい！";
    text[2826] = "ああ もう！  お前は 口を 閉じることが できないのか！？";
    text[2827] = "ここで 力を 使うのは ダメよ！  ゼッタイにね！";
    text[2828] = "あなたの 後ろにある 機械は この町の 水道を 管理しているの";
    text[2829] = "それが 壊れたら ルナーは おしまいよ...";
    text[2830] = "まず 水から出る 毒ガスで ここにいる 全員が 死ぬわ";
    text[2831] = "そして その水は 他の セクターにも 広がって...";
    text[2832] = "......";
    text[2833] = "だから ここで 暴れるのは やめて";
    text[2834] = "お願い...";
    text[2835] = "(それは 本当か...？  もっともらしい ウソを ついているんじゃ...)";
    text[2836] = "(信じても いいもの だろうか...？)";
    text[2837] = "(でも...)";
    text[2838] = "(それが 事実なら...)";
    text[2839] = "お願い...";
    text[2840] = "......";
    text[2841] = "さっき 話をしたいと 言ったな";
    text[2842] = "その毒の 問題を 何とかしたら 水道局の 屋上に 来い";
    text[2843] = "ただし 1人でだ\n他の人間の 気配を 感じたら そこで 話は 終わりだ";
    text[2844] = "ありがとう";
    text[2845] = "ウーン なんだか 怖いけど クールって 感じねえ...";
    text[2846] = "もう テトラ  そういうのは 後にしてよ！";
    text[2847] = "あれ？  サロス将軍から 通信だわ";
    text[2848] = "ベラ そっちの 状況は どうだ？";
    text[2849] = "今 全力で 水道ネットワークを 復旧させているところです";
    text[2850] = "よろしい  あまり時間を 取るわけにも いかないから 手短に言おう";
    text[2851] = "こちらの 準備は整った";
    text[2852] = "それで マークスレイヤーは 見たか？";
    text[2853] = "それが...";
    text[2854] = "その... 見ましたが...";
    text[2855] = "逃げられました";
    text[2856] = "ベラよ キミは ウソをつくのが あまり 得意では ないようだな...";
    text[2857] = "しかし 人の信頼を 勝ち取るのは 得意なようだ";
    text[2858] = "やつとは どこで 会うつもりだ？";
    text[2859] = "...水道局の 屋上です";
    text[2860] = "彼は 対話の チャンスを くれましたが... いわく 1人で 来いと";
    text[2861] = "どうやら ルナーフォースに 対して 強い疑いを 持っているようです";
    text[2862] = "それは そうだろう\nやつと 我々には 複雑な 因縁がある";
    text[2863] = "しかし やつが キケンな 存在であり 有益な情報を 持っていることに 変わりはない";
    text[2868] = "あの男は 捕らえなくては ならんのだ";
    text[2864] = "我々が 到着するまでは 水道局の 屋上には 向かうな";
    text[2865] = "......";
    text[2866] = "はい 将軍";
    text[2867] = "......";
    text[2886] = "ええ！？  マークスレイヤーは かつて 反物質の 研究に 関わってた ですって？";
    text[2887] = "そうだ";
    text[2888] = "やつは 反物質研究で 触媒の役目を 果たした";
    text[2889] = "何年も前の ある日 緊急医療センターに 1人の 患者が 送られてきた";
    text[2890] = "それは 小さな少年で 正体不明の 症状で 死にかかっていた";
    text[2891] = "その体からは 信じられない量の 奇妙な エネルギーが 放出されていた";
    text[2892] = "それから 何度も 実験を 重ねた結果 我々は 少年の 体から";
    text[2893] = "溢れ出す エネルギーを 取り出すことに 成功し 彼は 一命を 取り留めた";
    text[2894] = "数日後 少年の 生命反応は 正常に戻り 体も 回復したかに 見えたわ";
    text[2895] = "しかし 体に 強いストレスが かかったせいで 昏睡状態に なってしまったの";
    text[2896] = "で 奇妙な エネルギー というのは つまり...";
    text[2897] = "うむ 反物質だ";
    text[2898] = "少年から 出ていた エネルギーは 純粋かつ 安定した 反物質だった";
    text[2899] = "彼の おかげで 反物質の 研究は 大きな進展を 見せた";
    text[2900] = "そこで得た知見は 後に ワームホールの 開発に 応用され";
    text[2901] = "ファントムスペースの 発見";
    text[2902] = "さらには マークに 対抗するための バトルロボットや 兵器の 開発にも つながった";
    text[2903] = "それから 数か月後 少年は 目を覚ましたが";
    text[2904] = "体から とてつもない量の 反物質が 放出され 激しい痛みに うめいていた";
    text[2905] = "どうにか 彼を 助けようとしたが 近寄ることさえ できなかった";
    text[2906] = "彼は 施設から 逃走し それ以来 ついぞ 身柄を 確保できていない... というわけだ";
    text[2907] = "その少年が マークスレイヤー なんですね...";
    text[2908] = "その通り";
    text[2909] = "彼の力は... 生まれつきの ものなんでしょうか？";
    text[2910] = "ウェヘー！  なんだか 魅力的だけど 怖い話だなあ...";
    text[2911] = "...反物質を 操る力を持つ 人間かあ";
    text[2912] = "それ以外に わかっていることは？";
    text[2913] = "何もない\nまともに 話すら できなかったからな";
    text[2914] = "過去を 調べても そんな人物の 記録すらないのだ...";
    text[2915] = "名前も 出身地も わからない";
    text[2916] = "わかっているのは 彼が 未知の力を 体に 宿していること... それだけだ";
    text[2917] = "また おそらくは マークと なんらかの コネクションが あることが 考えられる";
    text[2918] = "...！？";
    text[2919] = "実は マークが ルナーに 現れるように なったのは 少年が 逃げた 後のことだ";
    text[2920] = "つまり 彼の 体から出た 大量の 反物質が マーク出現の 引き金になった 可能性がある";
    text[2921] = "証拠は あるんですか？";
    text[2922] = "...いいや ただの仮説だ";
    text[2923] = "マークは 他の 反物質に対して とても高い 反応性を 持つ";
    text[2924] = "だが 一連の できごとの 流れを 考えると そこに つながりが あっても 不思議ではない";
    text[2925] = "あなたたちは マークスレイヤーを ある種の 怪物のように 扱っているわ";
    text[2926] = "まあ 怪物的な力の 持ち主であるのは 間違いない  それに 犯罪者でもある";
    text[2927] = "彼はただ 自分の力を コントロールする 術を知らない 被害者です！";
    text[2928] = "彼の 反物質の 爆発は 軍事施設を 破壊し 多くの 死傷者を出した";
    text[2929] = "それも 一度ではない...";
    text[2930] = "やつが次に いつ暴走するかなど 誰にもわからない";
    text[2931] = "マークスレイヤーは キケンな 男なのだ";
    text[2932] = "...でも 悪い人とは 限らないわ";
    text[2933] = "彼が マークを 狩る理由が 何であれ";
    text[2934] = "ルナーの 市民を 守る行為とも 言えるわ";
    text[2935] = "それに 彼は 実験台として 拘束されることを 望んでないのでは？";
    text[2936] = "ただ 怖がっている だけだとしたら...";
    text[2937] = "研究所で モルモットみたいにされて いい人間など いません  彼だって ワタシたちと 同じ人間でしょう！";
    text[2938] = "もちろんだとも  しかし やつが もたらした被害を 見逃すわけには いかんのだ";
    text[2939] = "それが 意図的な ものであろうと なかろうとな";
    text[2940] = "あの男は 人類の敵に なりかねん";
    text[2941] = "それにしても マークを かばい... マークスレイヤーを 擁護する...";
    text[2942] = "どうやら キミは 自分の立場を 決めかねているのでは ないのかな ベラ？";
    text[2943] = "サ サロスよ... 妙な憶測で ものを言うのは よせ...";
    text[2944] = "ベラは ただ...";
    text[2945] = "優しい子 なのだ";
    text[2946] = "ワタシは ただ 正しいと 思う側に 立つだけです";
    text[2947] = "ハァ...";
    text[2948] = "すまない";
    text[2975] = "マークスレイヤーは ワタシにとっても 辛い記憶でな...";
    text[2949] = "...しかし ここで どうして 彼のことを 言及したのか そこに 立ち返ろうじゃないか";
    text[2950] = "今の 最優先課題は コーダ彗星だ";
    text[2951] = "リーブスが 前に述べたように";
    text[2952] = "その数は ルナーに 出現する マークだけでは 到底足りない...";
    text[2953] = "つまり ここらに現れる マークを すべて倒しても";
    text[2954] = "セレスティアを 動かすことはできない...";
    text[2955] = "そこで... マークスレイヤーが 集めた 反物質コアを 使おうという ことなのだよ";
    text[2956] = "マークスレイヤーは おそらく 何千もの 反物質コアを 隠し持っているはず";
    text[2957] = "それを セレスティアの 動力源として 使えば";
    text[2958] = "もうマークを 狩ることもなく コーダ彗星を 止めることができる";
    text[2959] = "....";
    text[2960] = "このミッション 1つ条件を 付けていただけるなら 協力します";
    text[2961] = "彼と 話をさせてください";
    text[2962] = "必要な情報を 何とかして 聞き出します";
    text[2963] = "コーダ彗星の 脅威を知ったら 彼も こちらに 加わってくれるかも しれません";
    text[2964] = "....";
    text[2965] = "あの男は こちらを 信用していない  キミが 心変わり させられるとでも？";
    text[2966] = "...それは わかりません\nでも 最善を 尽くします";
    text[2967] = "...うむ ならば いいだろう";
    text[2968] = "しかし もし やつが 逃走を 図ったならば";
    text[2969] = "ヴィヴィアの ホロテクノロジーで 捕らえる他あるまい";
    text[2972] = "ベラよ... これが マークを 殺さずにすむ 唯一の 選択肢であることを 忘れるな";
    text[2973] = "それで このミッションを 受け入れるのかな？";
    text[2974] = "はい サロス将軍！";
    text[2875] = "マークスレイヤーは ルナーフォースを 信じていない";
    text[2876] = "行動の 動機も ナゾに 包まれたまま...";
    text[2877] = "理解できないわ";
    text[2878] = "あの技...";
    text[2879] = "あの力...";
    text[2880] = "...どうして ルナーの みんなのために 使わないのかしら？";
    text[2881] = "ワタシが 知っているのは こちら側の 事情だけ";
    text[2882] = "でも 彼の信頼を 得ることが できれば...";
    text[2883] = "こっちに 理解を 示してくれるかも しれない";
    text[2884] = "でも 真実を 知るには 彼の話にも 耳を傾けないと...";
    text[2885] = "...";
    text[2869] = "やったわね！  これもすべて あなたの おかげよ テトラ！";
    text[2870] = "エヘヘ スーパーアシスタント・ロボ テトラは 世のため 人のため なんだって するんだから！";
    text[2976] = "どうやら マークたちも どこかに行った みたいね";
    text[2977] = "逃げたのかしら？\nそれとも マークスレイヤーが 全部 倒したとか？";
    text[2871] = "今なら ジェットパッドが 使えるはずよ";
    text[2872] = "水道局の 屋上で マークスレイヤーに 会いに 行きましょう！";
    text[2873] = "その建物は 町の北西よ！\nさあ レッツ ゴー ゴー ゴー！";
    text[3000] = "オレは かつて ルナーフォースが 人類を 守るために あるものと 信じていた";
    text[3001] = "それどころか オレ自身が ルナーフォースに 入りたいと 夢見たことさえ あった";
    text[3002] = "あの当時 もっと 強ければ...";
    text[3003] = "あの当時 自分の 力を コントロール できていれば...";
    text[3004] = "...こんなことには ならなかった だろうに";
    text[3005] = "オレは この力を 望んで得た わけじゃない";
    text[3006] = "なのに あいつらは オレに 痛みと 苦しみを もたらした";
    text[3007] = "この力を ほんの少し 制御するにも 何年もの 時間を 要した";
    text[3008] = "そして その間 様々な被害を 起こしてしまった...";
    text[3009] = "...今でも 自分を赦せない";
    text[3010] = "今のオレは 正しい方法を 探している...";
    text[3011] = "正しい方法って 何の？";
    text[3012] = "世に正義を もたらす方法だ";
    text[3013] = "......";
    text[3014] = "とにかく いつまでも しゃべってる ヒマはない  一体何を 話しに 来たんだ？";
    text[3015] = "ええっと まずは 1つ 質問させて";
    text[3016] = "どうして 反物質コアを 集めているの？";
    text[3017] = "ハァ... また それかよ";
    text[3018] = "ルナーフォースだって それなりに 反物質コアを 持ってるだろう？";
    text[3019] = "どうして わざわざ オレに聞く？";
    text[3020] = "どのみち 協力なんてしないぜ";
    text[3021] = "反物質コアが 欲しけりゃ 自分で手に入れな";
    text[3022] = "それじゃ 足りないのよ...";
    text[3023] = "反物質コアを 燃料として 使うにはね...";
    text[3024] = "...でも その理由は あなたが 考えているものと おそらく違うわ";
    text[3025] = "マークスレイヤー... 今 あなたの助けが 本当に 必要なのよ！";
    text[3026] = "コーダ彗星が もうすぐ 戻ってくるの！";
    text[3027] = "...まとめると 反物質の 彗星が こっちに 向かってて";
    text[3028] = "ワームホールマシンを 動かすのに 大量の 反物質コアが いるってことか？";
    text[3029] = "どうやって それを 信じろって 言うんだ？";
    text[3030] = "本当よ！  ウソをつく 理由なんて どこにもないもの...";
    text[3031] = "...反物質の 彗星...";
    text[3032] = "最近 感じる 妙な反物質の 高まりは それだったって わけか...";
    text[3033] = "お前が 言ったことが 本当なら マークの 大量発生の原因も それだろう";
    text[3034] = "セレスティアへの 燃料が 足りないと 人類は 滅んでしまうのよ...";
    text[3035] = "...そうだとしても 反物質コアは やれないな";
    text[3036] = "コーダ彗星とやらを 止めるなら 他の手段を 探すがいい";
    text[3037] = "それがムリだから 言ってるのよ！  あなたが 最後の希望なの！";
    text[3038] = "ダメだ";
    text[3039] = "どうして！？  自分が コアを 持ちたいから ルナーの みんなを キケンに 晒すって 言うの？";
    text[3040] = "ワタシだって マークを 殺すのは イヤだから あなたに 頼んでるのよ！";
    text[3041] = "......";
    text[3042] = "ねえ... もし イヤなら その訳くらいは 聞かせてよ";
    text[3043] = "ワタシは 人類と マークの 両方を 守りたいの";
    text[3044] = "ワタシたちと あなたが 力を 合わせれば きっと それは 実現できるわ！";
    text[3045] = "............";
    text[3046] = "前に会った時 あなたは 「マークの痛みを 感じるのか」と 聞いたわね...";
    text[3047] = "答えは 「イエス」よ...  自分でも どうしてなのかは わからないけど";
    text[3048] = "ただ... 魂で 感じるの";
    text[3049] = "最近 あるマークに 会ったわ... それは ワタシに 語りかけてきたの";
    text[3050] = "...ほう 何て 言ったんだ？";
    text[3051] = "「守って」";
    text[3052] = "そいつは... 興味深いな";
    text[3053] = "マークが 人と コミュニケーションを 取るだなんて 聞いたことがない";
    text[3054] = "(マークと 通じ合う...)";
    text[3055] = "(ひょっとして...？)";
    text[3056] = "お前...";
    text[3057] = "名前は？";
    text[3058] = "ベラ・グレイよ";
    text[3059] = "グレイ...";
    text[3060] = "ということは シアの娘か！？";
    text[3061] = "(なら 信用できるかもしれない...)";
    text[3062] = "(...)";
    text[3063] = "え？  ママを 知ってるの？";
    text[3064] = "...ああ";
    text[3065] = "あの人は 良きリーダーだった\n今のやつとは 違ってな";
    text[3066] = "え？  サロス将軍も 素晴らしい リーダーよ！  どうして そんなことを 言うの？";
    text[3075] = "ベラ このネズミ野郎は 包囲したわ！";
    text[3067] = "キサマ... 1人で来いと 言っただろう！";
    text[3068] = "やっぱり ワナだったんだな！";
    text[3069] = "ち 違うわ！  ワタシは 何も 仕組んでなんか...";
    text[3070] = "レイン！  メロディー！  ザラ！";
    text[3071] = "お願いだから 攻撃を やめて！";
    text[3072] = "ワタシは その人と 話がしたいの！";
    text[3073] = "それは ムリね ベラ\nサロス将軍から あなたが ここに来ると 伝えられたわ";
    text[3074] = "悪いけど ワタシたちは 命令に 従わなくちゃいけないの";
    text[3076] = "ベラ これは マークスレイヤーを 捕らえる 大チャンスなのよ！";
    text[3077] = "チッ 一旦 離れるとするか";
    text[3078] = "ダメよ！  どうしても あなたの力が いるんだから！";
    text[3079] = "話は 終わりだ\nお前ら 全員 この場で ブッ倒す！";
    text[6004] = "グアアァァァァァ！";
    text[7566] = "どうしたの？  一体何が...？";
    text[6005] = "ダメだ...";
    text[6006] = "下がれ...";
    text[6007] = "こいつに... また... 呑み込まれる... わけには...";
    text[6008] = "わあ...";
    text[6009] = "今のは何？";
    text[3080] = "ハァ... ハァ...";
    text[6010] = "フェイズフォームだ...";
    text[6011] = "反物質に 取り込まれると なっちまうのさ...";
    text[3081] = "だから これ以上... オレに 力を 使わせるな...";
    text[3082] = "また コントロール できなくなったら...";
    text[3083] = "こっちだって 戦うつもりはないわ\nあなたは 敵じゃないんだから";
    text[3084] = "お願い こっちに 協力して！";
    text[3085] = "ホロフィールド起動！";
    text[3086] = "どうやら 間に合ったようだな";
    text[3087] = "....";
    text[3088] = "ごきげんよう マークスレイヤー";
    text[3089] = "己の命が 惜しいなら その場を 動かぬことだな";
    text[3090] = "このホロフィールドは 運動エネルギーを 吸収するの";
    text[3091] = "それが 一定のしきい値に 達すると";
    text[3092] = "溜まった エネルギーを 使って ホロフィールドを 爆発させることが できる...";
    text[3098] = "...つまり 不用意に 力を使うと 死ぬということだ";
    text[3093] = "ウソだな";
    text[3094] = "前に ホロテクノロジーを 使ってきた時は オレを 止められなかった じゃないか！";
    text[3095] = "ハッハッハ... いやあ あの時以来 大幅な改良を 施したのだよ";
    text[3096] = "ウソだと思うなら 試してみるがいい";
    text[3097] = "死のリスクを 承知の上で やれるならな";
    text[3099] = "....チッ";
    text[3100] = "よくやったな ベラ\nキミなら うまくやってくれるものと 信じていたよ";
    text[3101] = "...はい...";
    text[3102] = "この男は 基地に 移送しろ";
    text[3103] = "これから いろいろと 話すことがある  そうだろう マークスレイヤー？";
    text[3104] = "....";
    text[3105] = "その無謀な 行為...";
    text[3106] = "...犠牲となった 人々...";
    text[3107] = "セクター3の 破壊...";
    text[3108] = "...集めた 反物質コア...";
    text[3109] = "お前が犯した すべての罪に 裁きが 下るだろう";
    text[3110] = "そして お前が 反物質コアを 隠している場所も 白状することになる";
    text[3111] = "マークスレイヤーよ 人類を救いたいとは 思わないかね？";
    text[3112] = "人類を救う？";
    text[3113] = "何からだ？  マークか？";
    text[3114] = "それとも お前からか？";
    text[3115] = "うーむ また 訳のわからない 妄想話か？";
    text[3116] = "ワタシは 人類の守り手だ  そして ルナーフォースは 人々を 守るために 存在する";
    text[3117] = "ルナーの市民を キケンに 晒してきたのは お前だろう";
    text[3118] = "オレは オレのやり方で 人類を救う  お前に 協力する つもりなどない";
    text[3119] = "ハァ... ハァ...";
    text[3120] = "どうやら体力が 限界のようだな\nまあ 話は 後から たっぷりと しようじゃないか";
    text[3121] = "みんな この度は 本当に よくやってくれた この勝利は 後で 大いに 祝おう";
    text[3124] = "今日という日は 人類史に 永遠に 記録されることだろう";
    text[3122] = "マークスレイヤーを 捕らえたのみならず";
    text[3123] = "史上最大の マークの 襲撃を 防いだのだからな！";
    text[3125] = "はい 将軍！";
    text[3145] = "数時間後...";
    text[3146] = "セクター7の 市民の諸君！";
    text[3147] = "ワタシは 今 この場を 借りて この町と 人々を 守るため";
    text[3148] = "懸命に 戦ってくれた ルナーの 戦士たちを 讃えたい";
    text[3149] = "彼らは 己の身を キケンに 晒しながらも 皆の安全を 確保した";
    text[3150] = "そして これほどの 災害にも かかわらず 市民に 犠牲者が 出なかったことが 何よりの 喜びだ";
    text[3151] = "今日は 人類が 勝利した 日であると 言っても 過言ではない！";
    text[3152] = "ワーワー！！  ヒューヒュー！！";
    text[3153] = "これからも マークを 封じ込める 任務に 全力であたり";
    text[3154] = "...かの脅威から 市民を 守りぬくことを 誓おう！";
    text[3155] = "たとえ どんなことが あろうと 常に 希望はある！  ルナーにも 明日は 必ず訪れる！";
    text[3161] = "ラックスの輝きよ 永遠なれ！";
    text[3162] = "イエーイ！  お手柄よおぉぉぉぉぉ！\nみんな 今日は 最高の仕事を したわね！";
    text[3163] = "ええ！  間違いなく 今までで 一番厳しい ミッション だったわ！";
    text[3164] = "そうね  あなたも いい仕事したわよ テトラ";
    text[3165] = "市民を 救う ヒーロー アシスタント・ロボ テトラって ところかしらね エヘヘヘ";
    text[3166] = "ええっと ベラ 大丈夫？";
    text[3167] = "チーズケーキバーを 5本 一気食いだなんて...";
    text[3168] = "一体 どうしちゃったわけ？";
    text[3169] = "...";
    text[3170] = "真実に... 近づけていたのに...";
    text[3171] = "あのさあ さっきは ああいう ことになって すまなかったわ";
    text[3172] = "でも ワタシたちは 命令に 従う 立場なのよ...";
    text[3205] = "ベラ こういう風に 考えるのは どうかしら？ ";
    text[3173] = "「マークスレイヤーを 捕らえた";
    text[3174] = "なら どんな情報だって 聞き出すことが できる！」";
    text[3175] = "...！";
    text[3176] = "それは そうだけど...";
    text[3177] = "あのね 今日 活躍したおかげで こうして カフェで 食べ放題なのよ！  ガッハッハッハ！";
    text[3178] = "もう しみったれた 顔しないで 楽しみなさいよ！  ワタシたち ヒーローなのよ！";
    text[3179] = "ウフフ みんな 励ましてくれて ありがとう";
    text[3180] = "そうよね みんなが がんばった おかげで ミッションは 成功した！";
    text[3181] = "すみませ～ん！  チーズケーキバー 追加で 5本 お願いしま～す！  ヘッヘッヘ！";
    text[3182] = "そうよぉ！  そうやって 盛大に 祝うのよおぉぉぉぉぉ！！";
    text[3183] = "うーん... このラーメン おいしいわ";
    text[3184] = "具材の 生み出す ハーモニーが スープに エレガントに 溶け込んでる...";
    text[3185] = "すみませ～ん  ストロベリー ミルクセーキを もう1つ！  これ すっごく おいしいわ～！";
    text[3186] = "ワタシは チーズケーキバー 6本よ！  ガッハッハッハ！";
    text[3187] = "アンタよりも 多く！  速く！  食べるんだからね！";
    text[3188] = "これは 競争じゃないのよ レイン！";
    text[3189] = "ワタシが 勝ったら スパーリングを 受けなさい！  今度こそ ボッコボコに してあげるんだから！";
    text[3190] = "...";
    text[3191] = "スパーリングか 大食い競争か... どちらにせよ 勝つのは ワタシよ";
    text[3192] = "面白い やってみようじゃないの！！ (ムシャムシャムシャムシャ)";
    text[3193] = "ハイ！\nアタシの 勝ちぃぃぃぃ！！";
    text[3194] = "うう～... もう おなかいっぱい...";
    text[3195] = "ハ～イ！  じゃあ これで スパーリング確定ね！";
    text[3196] = "今すぐ！！  ここでよ！！";
    text[3197] = "レイン アンタが 大声 上げるから みんな こっちを 見てるわよ";
    text[3198] = "ううっ 悪かったわね！\nじゃあ それは 今度ってことで カンベンしてあげる";
    text[3199] = "それじゃあ 今日は この辺で お開きにしましょう";
    text[3200] = "ワタシたちは もう少し ここにいるわ\nまだ ラーメンが 残ってるし...";
    text[3201] = "トーマス博士に よろしくって 言っておいてね！";
    text[3202] = "わかった  それじゃあ みんな またね！";
    text[3203] = "さあ テトラ 宇宙ステーションに 戻りましょ  なんだか ちょっと 眠たいしね";
    text[3204] = "オッケ～イ！\nそれじゃあ レッツ ゴー！";
    text[7985] = "ベラ これ なあに？";
    text[7986] = "行方不明者の リストよ... 今日 更新されたみたい";
    text[7987] = "どうやら あの襲撃の後 数人が 行方不明に なったようね";
    text[7988] = "サロス将軍は これに 気づいていたのかしら？";
    text[7989] = "あの 勝利の スピーチで どうして これを 言わなかったのかしら？";
    text[7990] = "そりゃあ 市民にとって あの襲撃は とても 怖いこと だったもの...";
    text[7999] = "多分 みんなを 勇気づけたかったんじゃない？";
    text[7991] = "確かに 幸い死者は 出なかったけど";
    text[7992] = "多くの 市民と 兵士が ケガしたわ";
    text[7993] = "...その上 行方不明者が 出てるとくれば...";
    text[8001] = "マークスレイヤーと キチンと 話す チャンスも なかったし...";
    text[8000] = "正直 ワタシにとっては 勝利とは 言えないわね...";
    text[8002] = "ベラ なんだか あなたらしく ないわよ...";
    text[8003] = "もっと 明るく 考えましょうよ！  あれよりも ひどいことに なってた 可能性だって 十分に あったのよ！";
    text[7994] = "行方不明者は ルナーフォースの 捜索隊が きっと 何とか してくれるわ";
    text[7995] = "だから すべてが 良くなると 信じましょう！";
    text[7996] = "あなたは 少し 休んだらいいのよ！  今日は とても がんばったんだから！";
    text[7997] = "そうね... あなたの 言う通りだわ\n一旦 お家に 帰りましょう！";
    text[7567] = "ねえ ベラ";
    text[7568] = "どうしたの テトラ？";
    text[7569] = "この紫の ジェットスーツ...";
    text[7570] = "結構 長い間 部屋に 飾ってるわよね？";
    text[7571] = "前に 一回 分析してみたんだけど...";
    text[7572] = "これ 今 着てるのより ずっと 耐久性が あるみたいよ...";
    text[7573] = "それに 普通のより 多くの 機能が ついてる みたいだわ！";
    text[7574] = "それで 思ったんだけど...";
    text[7575] = "どうして これを 着ないわけ？";
    text[7576] = "今の ジェットスーツを 置きかえられるし";
    text[7577] = "この頃の 事件で 思い知らされたように";
    text[7578] = "これからは マークと 戦うのに もっと いい装備が 必要になるのよ！";
    text[7579] = "そうね でも...";
    text[7580] = "このスーツは お母さんが 着てたものなのよ";
    text[7581] = "いつか 着てみようと 思ってたけど";
    text[7582] = "まだ 気持ちの 準備が できなくて...";
    text[7583] = "これを 着るのに ふさわしいだけの 資格が ないというか...";
    text[7584] = "もちろん 性能が 高いのは その通り なんだけど...";
    text[7585] = "...それに デザインも カッコイイしね";
    text[7586] = "紫は ママの お気に入りの 色だったわ";
    text[7587] = "でもね...";
    text[7588] = "今は まだ 着たいと 思わないのよ";
    text[7589] = "...少なくとも ママが 誇りに 思ってくれるような 立派な 隊員に なるまではね";
    text[7590] = "...ワタシはね 人間を 守るだけでなく";
    text[7591] = "ルナーにいる すべての 生き物を 守りたいの";
    text[7592] = "マークを 含めた すべての 生き物をね";
    text[7593] = "@P.@P.@P.@P.@P.@P.";
    text[7594] = "ねえ テトラ...";
    text[7595] = "そのスーツを 着るときが 来たら";
    text[7596] = "きっと あなたに 最初に 伝えるわ いい？";
    text[7597] = "わあ 今から 楽しみだわ！  エヘヘ...";
    text[7598] = "さてと それじゃあ そろそろ 休みましょ";
    text[7599] = "今日は 本当に 長い一日 だったもの";
    text[7600] = "オッケ～イ！\nワタシも 今夜は タップリ 充電しなくっちゃね！";
    text[3501] = "ああ 長い 一日だったわね\n今日は もう 寝る？";
    text[6016] = "サロス...";
    text[6017] = "まったく...";
    text[6018] = "強情な ところは 相変わらずだな マークスレイヤー";
    text[6019] = "おとなしく 協力さえすれば";
    text[6020] = "こんな 手荒な マネなど せずにすむものを...";
    text[6021] = "クズめ...";
    text[6022] = "久しぶりに ゆっくりと 話せるというのに それが あいさつの 言葉か？";
    text[6023] = "お前に あいさつなど する義理はない";
    text[6024] = "いいか よく聞け マークスレイヤー... 話というのは こうだ";
    text[6025] = "コーダ彗星が 戻ってきた\nそして この星を 滅ぼそうとしている...";
    text[6026] = "人類を 救うために 我々は 進歩せねばならん";
    text[6027] = "今ある 危機を 乗り越えなくては ならんのだ";
    text[6028] = "そして そのためには 大量の 反物質コアがいる";
    text[6029] = "さて...";
    text[6030] = "言ってもらおう\n反物質コアは どこに 隠してある？";
    text[6031] = "それが ルナーフォースの 手に渡れば";
    text[6032] = "ルナーの 民のために 使われるのだぞ";
    text[6033] = "人類を 救いたいと 思わんのかね？";
    text[6034] = "お前に 口を 割るくらいなら 死んだ方が マシだ";
    text[6035] = "何があっても 言うもんか";
    text[6036] = "ならば 仕方あるまい...";
    text[6037] = "やれ ヴィヴィア\n反物質抽出だ";
    text[6038] = "うわあああああぁぁぁ！！！\nああ... あああああぁぁぁ！";
    text[6039] = "ぐおああああああぁぁぁっ！！";
    text[6040] = "そうやって いつまでも 黙り続けるなら...";
    text[6041] = "...お前の体から 反物質を 一滴残らず 抜き取ってやる";
    text[6042] = "さあて... 見せてもらおうか...";
    text[6043] = "お前の中に 潜む 野獣...\nフェイズフォームを！！";
    text[6044] = "やめろおおぉぉぉぉ！！\nぬわあああぁぁぁぁ！！";
    text[6045] = "お前なんかに...！  ゼッタイに...！";
    text[6046] = "このような 手段しか 取れないのは 実に 残念だよ...";
    text[6047] = "よいか 反物質こそが 世界を救う カギなのだ";
    text[6048] = "ゆえに この計画 有無を言わさず 協力してもらうぞ...";
    text[6049] = "わかったかな？\nマークスレイヤーよ...";
    text[3502] = "...声...";
    text[3503] = "...";
    text[3504] = "百？  いや 千かしら...？";
    text[3505] = "守って...";
    text[3506] = "ワタシは 何を 守るために 戦っているの？";
    text[3507] = "漂う 感覚...";
    text[3508] = "誰かが ワタシの そばに いる感じ...";
    text[3509] = "クロノス...？";
    text[3510] = "すべてが 薄れていく...";
    text[3511] = "知らなくっちゃ...";
    text[3512] = "...真実を";
    text[3837] = "ベラ！  大丈夫？";
    text[3838] = "あなたね 寝てる間 ずーっと バタバタ 寝返り 打ってたわよ！";
    text[3839] = "...そう";
    text[3840] = "ねえ テトラ これから パパに 最近 感じている 奇妙な 感覚について 打ち明けてみるわ";
    text[3841] = "人に 心配かけるようなことは したくないけど...";
    text[3842] = "いろいろ 気がかりな ことがあって...";
    text[3843] = "まるで マークに 呼ばれているような 感じがするのよ...";
    text[3844] = "また クロノスの 声を 聞いたの？";
    text[3845] = "ええ それに いくつかの 違う声も";
    text[3846] = "ママは 昔 ワタシは 他の人にない 特殊な 才能を 持ってるって 言ってたけど";
    text[3847] = "...具体的なことは 何も 聞かされてないわ";
    text[3848] = "ワタシ自身は 戦闘の才能 じゃないかと 思ってたけど...";
    text[3849] = "...ひょっとしたら 何か 別のこと だったのかも しれないわ";
    text[3850] = "だから... パパに 聞いてみようと 思って";
    text[3851] = "なるほどね！";
    text[3862] = "ちょっと 聞いてもいい？  パパは 研究室に いるかしら？";
    text[3863] = "いいえ ベラ隊員\nあなたの お父さんは 今 セレスティアの 改良について";
    text[3864] = "会議で 話し合っている ところです";
    text[3865] = "それで ワタシの 仕事は 入り口の 見張りと いうわけですよ アハハハ...";
    text[3866] = "ああ なるほどね 教えてくれて ありがとう！";
    text[3867] = "ウーン...";
    text[3868] = "なら 普通に 博士を 呼び出したら？\nちょっとくらい 大丈夫よ";
    text[3869] = "いいえ 今は 忙しいだろうし 会議が 終わってからにするわ";
    text[3870] = "まあ あまり 眠れてないけど 体は だいぶ 元気に なったし！";
    text[3871] = "今 こなせる ミッションが あるか チェックしてみましょう！";
    text[3872] = "オッケ～イ！  ミッションの 書かれた 掲示板は 1階の ロビーに あるわよ";
    text[3873] = "でも その前に まずは ステラと 話をしてね！";
    text[3874] = "新しい ミッションを 割り当てるのは あの人の 仕事だから エヘヘ";
    text[3877] = "ああ ベラ！  なんだか やる気マンマンって 顔ね！";
    text[3878] = "まあね！  それで 何か 新しい ミッションは ある？";
    text[3879] = "ええ ちょうど 3つの ミッションが 来たところよ！ ";
    text[3880] = "まあ よかった！";
    text[3881] = "くわしくは あなたの 後ろにある ミッション掲示板を 見てね";
    text[3882] = "説明を 読み終えたら ミッションは 自動で 割り当てられるわ";
    text[3883] = "ミッションは 好きな 順番で クリアして オーケーよ！";
    text[3884] = "これからは 新しい ミッションが あるかどうか";
    text[3885] = "ミッション掲示板で すぐに 確認することが できるわ！";
    text[3886] = "それじゃ がんばってね！";
    text[3887] = "うん！  ありがとう ステラ！";
    text[3891] = "つい先日 略奪品を 輸送中の 宇宙マフィアの 船が 特定されたの";
    text[3892] = "そのマフィアは より大きな 犯罪組織の 一部と 見られているわ";
    text[3893] = "あなたの ミッションは やつらを 逮捕し 盗品を 回収することよ";
    text[3894] = "とある軍用船が マークの 襲撃で 破損したとの 報告が 入ったわ";
    text[3895] = "パイロットは 無事で 船は 荒野ゾーン1に 着陸したとの ことよ";
    text[3896] = "あなたの ミッションは パイロットの 話を聞き 落としてしまった 貨物を 回収することよ";
    text[3897] = "ケプラー牧場は かつてないほどの 食糧不足に みまわれているわ";
    text[3898] = "なんでも 作物が 荒らされ なくなってしまったという 事件が いくつも 報告されているの";
    text[3899] = "あなたの ミッションは 事件の 真相を 調査し 失われた 作物の 行方を 突き止めることよ";
    text[3633] = "手を 上げなさい！";
    text[3634] = "ルナーフォースの 権限の下 窃盗の 容疑により";
    text[3635] = "あなたたちを 逮捕する！";
    text[3636] = "おやおや 招いてもいない うす汚い ネズミが 入り込んできたぜ";
    text[3637] = "残念だが もう遅いな\nオレたちは 常に ポリ公どもの 2歩先を 行くんだ";
    text[3638] = "どういうこと？";
    text[3639] = "もう ほとんどの ブツは 別の場所に 移したってことさ";
    text[3640] = "しかも この船の 自爆装置も 起動した";
    text[3641] = "つまり お前を ここで ブッ倒したら 船が ドカンといく前に ずらかるってこった！";
    text[3642] = "何ですって...";
    text[3643] = "テトラ 残された 時間は？";
    text[3644] = "こいつらを 10ターン以内に 倒して 船から 出ないと 爆発に 巻き込まれちゃうわ！";
    text[3645] = "ウチのボスは ネズミが 大キライでな";
    text[3646] = "オレ自身 今まで 何人も ルナーフォースの やつらを 葬ってきた...";
    text[3647] = "...そして 次は お前だ！";
    text[3648] = "えーいっ！  自爆装置を 無効化したわ！";
    text[3649] = "よくやったわね ベラ！\nマフィアどもを やっつけたわよ！";
    text[3650] = "もうすぐ 援軍が来て 盗品を 回収してくれるはずよ";
    text[3651] = "それじゃあ 準備が できたら ここから出るわよ！  エヘヘ";
    text[3900] = "こんにちは  紛失した貨物の 捜索を 要請したのは ワタシよ";
    text[3901] = "応えてくれて どうも ありがとう！";
    text[3902] = "どういたしまして！  それじゃあ 状況について 詳しく 教えてくれる？";
    text[3903] = "わかったわ... 問題は 貨物 そのものじゃないの...";
    text[3904] = "それを 探している時に マークに 攻撃される 恐れがあることよ";
    text[3905] = "実は 貨物には 追跡装置が 付けられていてね...";
    text[3906] = "なくなった貨物は 3つよ";
    text[3907] = "それらは ルナーの 3か所 別々の アドベンチャーエリアに あるわ";
    text[3908] = "アドベンチャーエリアって？";
    text[3909] = "アドベンチャーエリアは いわゆる トレジャーハンターたちが";
    text[3910] = "ひそかに お宝を 探しに 行くような エリアよ";
    text[3911] = "そこには 思いがけない アイテムが 見つかったりするけど";
    text[3912] = "そのほとんどが 人が 足を 踏み入れないような 離れにあるわ";
    text[3913] = "お宝 ダンジョン マーク... とにかく 何でも 見つかるの！";
    text[3914] = "でも ワタシは マークと 戦ったりは できないから...";
    text[3915] = "そういうことなら こっちに 任せて！  でしょ テトラ？";
    text[3916] = "ええ！  大丈夫よ きっと ワタシたちが 貨物を 探してきてあげる！";
    text[3917] = "ありがとう！  各アドベンチャーエリアの 位置は ワールドマップを 見ればわかるわ";
    text[3918] = "それじゃ よろしく 頼むわね！";
    text[3919] = "1つ目の 貨物を 見つけた！  残りは 2つだ！";
    text[3920] = "2つ目の 貨物を 見つけた！  残りは 1つだ！";
    text[3921] = "3つ目の 貨物を 見つけた！";
    text[8491] = "ナイラさんに リーブス！  こんな所で 何を してるんですか？";
    text[8492] = "ウェヘー！\nただ 休日を 楽しんでるだけさ！";
    text[8493] = "まあ 最近の 考古学チームの 発見に 関して ちょっと力に なってあげたくてね";
    text[8494] = "ええ？  何を 発見したの？";
    text[8531] = "それは 見ての通り...";
    text[8495] = "この 光り輝く 石板だよ！";
    text[8496] = "これは 人類が ルナーに 移住するよりも はるか昔に 存在した";
    text[8497] = "古代文明の 遺物よ...";
    text[8498] = "その先住民は 何と呼ぶの？";
    text[8499] = "あなたの お母さんは 何年も前に 古代文明について 研究していたわ...";
    text[8500] = "でも その当時は ただ 「古代人」とだけ 呼んでいたわね";
    text[8501] = "それは...";
    text[8502] = "...なかなかの ネーミングセンスね";
    text[8503] = "まあ ママは 昔から ネーミングセンスは なかったから...";
    text[8504] = "子供のころ　ママが 一度 古代人について 何か言ったのを 覚えているわ";
    text[8505] = "古代人は ラックスと 反物質に 精通していたとか...";
    text[8506] = "ああ それはその通りさ ウェヘー！";
    text[8507] = "古代人に 関しては ごく限られたことしか わかっていないわ...";
    text[8508] = "考古学チームの ミッションは ルナーの 古代史を 明らかにすることだった...";
    text[8509] = "...ただ 最近は 資金不足で 探索も 滞っているのよ...";
    text[8510] = "ええ！？  まさか サロス将軍が 予算を 削減したとか？";
    text[8511] = "そうさ  彼いわく...";
    text[8512] = "「投資は 過去よりも 未来に するもんだ」って";
    text[8513] = "...なるほどね";
    text[8514] = "ワタシが 将軍なら 考古学チームに 倍の資金を 回すんだけどねえ";
    text[8515] = "この星の ルーツを 知ることって とても大事だし...";
    text[8516] = "ワタシたちの前に 先住民が いたなら なおさらね";
    text[8517] = "それにしても どうして 古代人は 消えたのかしら...";
    text[8518] = "さあねえ... それが わかれば 苦労しないよ！  ウェヘー！";
    text[8519] = "それで あなたは どうして ここに来たの？";
    text[8520] = "いや ちょっと ルナーフォースの ミッションを 進めているだけよ";
    text[8521] = "ああ なるほど\nなら あんまり 引き止めちゃ 悪いな！";
    text[8522] = "お仕事 がんばってね ベラ！";
    text[3922] = "荒野ゾーン1に 戻って パイロットに 報告しましょう！";
    text[3927] = "待って！  貨物を 取らずに ここを 離れちゃ ダメでしょ！";
    text[3923] = "まあ！  貨物を すべて 見つけてくれたのね！";
    text[3924] = "いろいろ 大変じゃなかった？";
    text[3925] = "まあ マークが いたりしたからね...";
    text[3926] = "...でも ワタシたちの 手に負えない 相手なんて いないわ";
    text[3928] = "それで 中身は 何だったわけ？";
    text[3929] = "最新の 軍用船の パーツよ！";
    text[3930] = "本部から あなたに 特別報酬として 新しい 船の部品を 与えてもいいと 許可が出たわ！";
    text[3931] = "ファルコンシップセットを 手に入れた！ このセットの 中身は...";
    text[3932] = "ファルコンフレーム ファルコンウイング ファルコンスラスターだ！";
    text[3933] = "改めて お礼を言うわ\n本当に ありがとう！";
    text[3934] = "やあ！  ボクの 名前は カール";
    text[3935] = "ケプラー牧場の 管理人さ";
    text[3936] = "はじめまして カール！  それじゃあ 状況を 教えてくれる？";
    text[3937] = "ボクたちは 今 2つの 穀物畑を";
    text[3938] = "メチャクチャにした 犯人を 探しているんだ";
    text[3939] = "ルナー中の セクターが ボクたちの 食糧を 当てにしている";
    text[3940] = "だから これ以上の 被害を 防ぐことは ものすごく 重要なんだ";
    text[3941] = "大丈夫よ カール  ワタシたちに 任せて！";
    text[3942] = "できるだけ 早く 解決できるように がんばるわ";
    text[3943] = "それで この牧場の 近くに 動物は いるの？";
    text[3944] = "ここに 動物は いないよ\n別の牧場に いるからね";
    text[3945] = "なるほど... 犯人が 動物じゃないとすれば...";
    text[3946] = "どうしたの ベラ？";
    text[3947] = "ひょっとしたら バカげた 考えかも しれないけど...";
    text[3948] = "テトラ 人間以外の ものを 食べる マークは いないか";
    text[3949] = "データベースを 調べてみてくれない？";
    text[3950] = "オッケ～イ！  2ミリ秒だけ 待ってね...";
    text[3951] = "調べたわ！";
    text[3952] = "ええっとね...";
    text[3953] = "マークは 反物質を 補充するために";
    text[3954] = "高密度の 反物質 または 高濃度の ラックスから成る";
    text[3955] = "有機生命体を 摂取する...";
    text[3956] = "なるほど... 植物や 穀物だって 一種の 有機生命体よね";
    text[3957] = "それじゃあ キミの 推測だと 犯人は マークだと いうことかい？";
    text[3958] = "ありえると思うわ\n最近 マークが 目撃されたり したことは なかった？";
    text[3959] = "ウーン... そういう話は 聞いてないなあ";
    text[3960] = "そもそも 人口の少ない この場所に マークは めったに 現れないから";
    text[3961] = "なるほどね...";
    text[3962] = "安全のためにも あなたは ここで 待っていて ちょうだいね";
    text[3963] = "テトラ 早速 手がかりを 探しましょう";
    text[3964] = "わかったわ！  難事件の 解決は 名探偵アシスタント・ロボの テトラに お任せよ！";
    text[3965] = "これ以上 作物に 被害を 出すわけには いかない...";
    text[3966] = "調査が 終わったら わかったことを 報告しておくれ";
    text[3967] = "この畑には ミントハーブが 生えていたみたいね";
    text[3968] = "なら 犯人は ミントが 好きってこと？";
    text[3969] = "ミントが 好物の マーク... ねえ";
    text[3970] = "ああっ！  足跡が あるわ！  見たところ イノシシの ひづめに 似てるような...";
    text[3971] = "テトラ これ ちょっと スキャンしてみて";
    text[3972] = "ウーン... こういう足跡の マークは 何種類か いるようね";
    text[3973] = "でも 特定するには 別の 手がかりがいるわ";
    text[3974] = "このマークが 何なのかを 突き止めたら";
    text[3975] = "敵の正体が わかるわね...";
    text[3977] = "この辺りは 土が ボロボロで くぼみも たくさんあるわ";
    text[3978] = "犯人は ワームホールを 通って 作物を食べ それから 逃げたんじゃないかしら";
    text[3979] = "とにかく しっかりと 警戒しておかないとね";
    text[3980] = "鋼鉄の ドラム缶に 歯形が ついてるわ！";
    text[3981] = "ドラム缶の ラベルには 何て 書いてあるの？";
    text[3982] = "バトルミントの 原料...";
    text[3983] = "ウーン...";
    text[3984] = "この歯形を 作った 生き物について シミュレートしてみたわ";
    text[3985] = "結論としては ワニの それに そっくりね...";
    text[3986] = "でも ワニなはずないわ... とうの昔に 絶滅してるんだから！";
    text[3987] = "イヤ～ッ！  これ何？";
    text[3988] = "何かの... ヌルヌルな 皮膚かしら？";
    text[3989] = "ちょっと 分析してみた方が 良さそうね";
    text[3990] = "皮膚には 反物質の 痕跡が あるみたいね";
    text[3991] = "オエ～ッ！  じゃあ あなたが 持ってて！";
    text[3992] = "ふう これで おそらく すべての 手がかりが 揃ったわね...";
    text[3993] = "それで どうする？";
    text[3994] = "まとめると... ワニの頭...";
    text[3995] = "イノシシの ひづめ...";
    text[3996] = "どういうわけか ミントが 大好き...";
    text[3997] = "そして 爬虫類みたいな 皮膚！";
    text[3998] = "ああ！";
    text[3999] = "当てはまるものが あったわ！";
    text[4000] = "ルナーフォースの マークの データベースにね！";
    text[4001] = "コードネームは カプノサウルス！";
    text[4002] = "へぇ！  そりゃ お手柄よ テトラ！";
    text[4003] = "エヘヘ...";
    text[4004] = "そうとわかれば 考えがあるわ...";
    text[4005] = "バトルミントで カプノサウルスを おびき出すってのは どう？";
    text[4006] = "本当に うまくいくかしらね？";
    text[4007] = "やってみなくちゃ わかんないでしょ！";
    text[4008] = "バトルミントを 取ってきてから ここに 戻りましょう";
    text[4009] = "うまくいくとは 思えないけどねえ...";
    text[4010] = "いくわよ！  他に アイデアも ないし！";
    text[4011] = "ああ！！";
    text[4012] = "どうしたの？";
    text[4013] = "マークを 検出したわ！";
    text[4014] = "犯人の お出ましね！";
    text[4015] = "わあ... ベラ この カプノサウルス かなり 興奮してるわよ...";
    text[4016] = "ワタシたちの せいで びっくりしちゃったのかも！";
    text[4017] = "気をつけて！\nいつ襲いかかっても おかしくないわ！";
    text[4018] = "大丈夫 準備は できてるわ！";
    text[4019] = "カプノサウルスが 逃げたわ！";
    text[4020] = "今は これで 大丈夫よ";
    text[4021] = "マークが 犯人だと わかったし";
    text[4022] = "これからは 管制センターが ケプラー牧場に パトロールを 派遣するはずよ";
    text[4023] = "ええ きっと そうね！";
    text[4024] = "それじゃあ カールの ところに 戻りましょ！";
    text[4025] = "ええっ マークが 犯人だったのかい！？";
    text[4026] = "そうよ  でも もう大丈夫  追い払ったからね";
    text[4027] = "それに ルナーフォースに カプロサウルス対策の パトロールを";
    text[4028] = "配置するように 要請を 出しておいたわ";
    text[4029] = "そうか 今回は 牧場を 救ってくれて 本当に ありがとう！";
    text[4030] = "これは ほんの お礼の 気持ちだよ";
    text[4032] = "ミント好きの マークか... 世には 変わったものも あるもんだなあ！";
    text[4103] = "あら？  トーマス博士から 呼び出しよ！";
    text[4104] = "ベラ！  ワタシを 探していると 聞いたのだか 本当かな？";
    text[4105] = "なかなか 時間が できなくて すまなかった... 少しばかり 重要な 問題が あってな";
    text[4106] = "パパ ちょっと 話したいことが あるんだけど 忙しいかしら？";
    text[4107] = "うむ コーヒーを 飲んでいる 他は 大丈夫だ！  時間は あるぞ";
    text[4108] = "それで 何があったんだい？";
    text[4109] = "ええっと... これから 会いに 行くから その時に 直接 話すわ";
    text[4110] = "テトラ 研究室に 行って パパに 会いましょう";
    text[4111] = "オッケ～イ！";
    text[4112] = "ベラは トーマス博士に 最近 感じている 奇妙な 感覚や";
    text[4198] = "ファントムスペースでの クロノスの件の 真実について 語った...";
    text[4113] = "ベラ... なぜ それを もっと早く 言わなかったのだ？";
    text[4114] = "そうだけど... 声が 聞こえるまでは そこまで 気にかけて なかったから...";
    text[4115] = "パパ ワタシ 不安なの... 何か おかしくなったり してないかしら？";
    text[4116] = "平気だよ  何も おかしな ことなんてない";
    text[4199] = "「守って」...";
    text[4148] = "それは 多くの マークが 抱いている 感情なのかも しれない";
    text[4153] = "マークが 人間を 恐れているなど 考えたことも なかったな";
    text[4149] = "確かに 我々は 自分たちのために マークを ゆっくりと 滅ぼしているわけだ";
    text[4150] = "だから ベラに 守ってほしいのかしら？";
    text[4151] = "...でも どうして ワタシなの？";
    text[4152] = "もしかしたら マークと コミュニケーションを 取れるのが お前だけだから かもしれないな";
    text[4117] = "それが 遺伝する力だとは 思わなかったが... どうやら シアの 考えは 正しかったようだ";
    text[4118] = "どういうこと？  パパと ママは ずっと ワタシに 何かを 隠してきたわけ？";
    text[4119] = "うむ すまない... もっと早く 言うべきだったな";
    text[4120] = "お前には どうやら ラックスを 操る能力が あるようなのだ";
    text[4121] = "...そして お前の母も その力を 持っていた";
    text[4122] = "ラックスの 操作...！？  でも ママの 研究だと ただの 仮説だって...";
    text[4123] = "そうだ... だが あいつは それを 自分自身で 証明したのだ";
    text[4124] = "お前の母は 将軍になる前は 科学者だった";
    text[4125] = "ワタシの 研究は 反物質だったが シアの それは ラックスだった";
    text[4126] = "魂の存在は 科学で 認められている";
    text[4127] = "現在の テクノロジーでは それを 測定し... 数値化することも できる";
    text[4128] = "ラックスは 言わば 意志の力の 現れであり 魂の エネルギーなのだ";
    text[4129] = "それは 人の精神的 および 肉体的な 状態に 応じて 成長し 変化することもある";
    text[4130] = "お前の母は ラックスを コントロールする 術を学べば";
    text[4131] = "マークと コミュニケーションを 取れるのではないかと 考えたのだ...";
    text[4132] = "だが シアは死んだ... ゆえに その仮説は もはや 検証できなくなった...";
    text[4133] = "でも ワタシの ラックスの力が 再び 現れるまで 待ってる ヒマはないわ！";
    text[4134] = "どうしたら ラックスを コントロール できるの？  ママは 何か言ってた？";
    text[4135] = "それが わかればな...";
    text[4136] = "何せ ワタシにも 言わなかったのだから...";
    text[4137] = "なら どうして 隠したのかしら...";
    text[4138] = "あいつの ことだから... 我々を 守るために そうしたのだろう";
    text[4139] = "守るって 何から？";
    text[4140] = "それは わからん... うむ もう1杯 飲まなくては... 頭が 爆発しそうだ";
    text[4141] = "(ママが 発見した ヒミツを 何とかして 突き止めなくっちゃ...)";
    text[4142] = "(ゼッタイに あきらめないわ)";
    text[4143] = "ひょっとしたら そうしたことを 知っている者が どこかに いるかもしれんが...";
    text[4144] = "........！";
    text[4145] = "マークスレイヤー！";
    text[4146] = "コペルニクスで 彼に会った時 ママのことを 知ってるみたい だったわ";
    text[4147] = "もう一度 話を しなくっちゃ！";
    text[4155] = "ベラ お前は ここにいなさい...";
    text[4156] = "どうして？  ここで じっとしてたって 何も起きないわ！";
    text[4157] = "お前の力は 誰にも 知られるわけには いかん...";
    text[4158] = "お前の母が ヒミツにしたのも 何か 訳があるはず  なら 我々も 今は そうすべきだ";
    text[4159] = "お前は ここまで よく がんばった  だが これからの ことは ルナーフォースに 任せなさい";
    text[4160] = "反物質コアを マークスレイヤーから 回収し セレスティアが 完成したら";
    text[4161] = "コーダ彗星だって 止められる\nそうすれば ルナーの人々は 救われるのだ";
    text[4162] = "...どうして そんな目で ワタシを 見るのだ？";
    text[4163] = "パパ... 何か 隠してるわね";
    text[4164] = "まさか... さて もう1杯...";
    text[4165] = "マークスレイヤーの ことを 口にしたら 急に 態度が 変わったわ";
    text[4166] = "ねえ パパ 本当のことを 教えてくれない？";
    text[4167] = "ママみたいに ワタシを 守ろうと 子供扱いしないで";
    text[4168] = "もう 自分の身は 自分で 守れるんだから！";
    text[4169] = "...前の 会議の後 基地に 立ち寄り サロスに 会った";
    text[4170] = "そして マークスレイヤーを どうするつもりか 聞いた...";
    text[4171] = "マークスレイヤーが 反物質コアを 渡さない つもりなら どうするのかと...";
    text[4172] = "どうやら サロスは マークスレイヤーの 体から 直接 反物質を 抜き取る つもりの ようだ";
    text[4173] = "おそらくは 彼が 死に 至るまで";
    text[4174] = "そんな！  ダメよ！  そんなこと させちゃ！";
    text[4175] = "ひどすぎるし ありえない！";
    text[4176] = "もちろん ワタシも 反対だが... 他に どんな方法が ある？";
    text[4177] = "父として ワタシは 家族を 守らなくてはならん...";
    text[4178] = "ルナーフォースの 決定に 逆らえば 立場が 危なくなるのだ";
    text[4179] = "なら サロスを 説得すればいい！";
    text[4180] = "もちろん したとも...";
    text[4181] = "サロスは 人類を 守るためなら 何でも するつもりだ";
    text[4182] = "たとえ それで マークスレイヤーが 死のうとも...";
    text[4183] = "ダメよ... ワタシ もう一度 マークスレイヤーに 会って 話をするわ";
    text[4184] = "それで 何とかして 反物質コアの 場所を 聞き出すの！";
    text[4200] = "パパ お願い...";
    text[4185] = "........";
    text[4186] = "ハァ... ダメだと 言っても 聞かないだろうしな...";
    text[4187] = "これを 持っていきなさい";
    text[4189] = "このカードキーがあれば 基地と 収容所に 入ることができる";
    text[4190] = "くれぐれも 気をつけるんだぞ... ワタシも 影ながら 成功を 祈っているからな";
    text[4191] = "ありがとう パパ";
    text[4192] = "本当に いつだって 頼りに なるんだから！";
    text[4193] = "ワタシも 後で サロスと 話をするよ";
    text[4194] = "マークスレイヤーの 信頼を 得られる者が いるならば それは お前だけだろう";
    text[4195] = "だが ベラよ くれぐれも キケンな マネは するんじゃないぞ...";
    text[4196] = "大丈夫よ パパ！  心配しないで！";
    text[4197] = "さて テトラ 荒野ゾーンの 軍事基地に 行きましょう！";
    text[4205] = "オッケ～イ！  新しい ミッションが ある所 テトラありよ！";
    text[4207] = "さて テトラ  今回は 普通の ミッションとは 違うわ";
    text[4208] = "違うの？";
    text[4209] = "ええ これは 「ステルスミッション」よ";
    text[4210] = "つまり ここに いることを サロスに 知られては いけないということ...";
    text[4211] = "パパは サロスは 目的のためなら 何でもすると 言っていたわ";
    text[4212] = "だから 彼に ワタシを 止める 口実を 与えてはいけない...";
    text[4213] = "...それに あの人と 戦えるだけの 強さも ないわ";
    text[4214] = "だから できるかぎり 目立たないように 行動するのよ";
    text[4215] = "それで 本気なの ベラ？";
    text[4216] = "もし バレたら...";
    text[4217] = "バレないわよ  だって ワタシには スーパー・アシスタント・ロボが ついてるんだから！";
    text[4218] = "そうね エヘヘ スーパー・ステルス アシスタント・ロボの 本気を 見せてあげるわ！";
    text[4219] = "それで テトラ データベースに 基地に 関する ファイルは ある？";
    text[4220] = "あると言ったら まずいかしらね？";
    text[4221] = "大丈夫よ おバカさん";
    text[4222] = "なら いいんだけど！";
    text[4223] = "だって いつもは そういうのを 持ってたら 説教してくるじゃない";
    text[4224] = "今回は 特別よ  むしろ あなたの データが なくちゃ 困るのよ！";
    text[4225] = "わかったわ じゃあ 2ミリ秒だけ 待ってね...";
    text[4226] = "はい！  何が 知りたいの？";
    text[4227] = "収容所に ついてだけど 正面の 入り口以外に 出入りできる ところはある？";
    text[4228] = "軍事基地の 見取り図によると どうやら 下水道エリアの";
    text[4229] = "古いハッチが 収容所に つながっている みたいだわ！";
    text[4230] = "ええっ！？  ひょっとして 今... 下水道って 言った？";
    text[4231] = "ええ！";
    text[4232] = "べ 別の 出入口は...？";
    text[4233] = "ないわ！";
    text[4234] = "ああ... じゃあ 後で ジェットスーツを クリーニングに 出さないとね";
    text[4235] = "まあ いいわ  そうと決まれば 下水道エリアに 行きましょう！  (イヤだけど！)";
    text[4052] = "このマシンの 中にある コンピュータが レーザードアを コントロールしてる みたいね！";
    text[4053] = "下水道ネットワークに 入る？";
    text[4241] = "ようし 入れたわ！";
    text[4242] = "マークスレイヤーは ここにある 独房の いずれかに いるはずよ";
    text[4243] = "変ね...";
    text[4244] = "どうしたの？";
    text[4245] = "囚人が いないわ";
    text[4246] = "...それに なんだか 妙に 静かすぎると 思わない？";
    text[4247] = "ここから先は 慎重に 進むわよ";
    text[4249] = "マークスレイヤーは きっと ここに 囚われているんだわ";
    text[4250] = "どうして わかるの？";
    text[4251] = "だって 一番 脱出しにくい 部屋でしょ";
    text[4252] = "テトラ この電子ロックは 解除できる？";
    text[4253] = "ウーン...";
    text[4254] = "このドアは ちょっと 開けられないわね";
    text[4255] = "これと つながっている 制御パネルを いじれば どうにかできると 思うけど";
    text[4256] = "なるほどね なら その制御パネルを 探しましょう！";
    text[4257] = "ミカクニンノ ジェットスーツヲ ケンシュツ";
    text[4258] = "ヨウケンヲ ノベヨ";
    text[4259] = "わあっ セキュリティ・ロボだわ！  どうしよう...";
    text[4260] = "逃げ道なんて ないわよ！";
    text[4261] = "警備兵が 来る前に 倒さないと！";
    text[4262] = "キョウイ ハッケン";
    text[4263] = "バトルモード オン";
    text[4264] = "こっちだ！  こっちから 信号が 来てるぞ！";
    text[4265] = "ヤバイわ！  2人の 警備兵が この場所に 向かってる！";
    text[4266] = "隠れるわよ！";
    text[4267] = "*バキッ！* *ボコッ！*";
    text[4268] = "ごめんなさい...";
    text[4269] = "テトラ 2人の 生命反応は？";
    text[4270] = "大丈夫よ";
    text[4271] = "ちょっと おねんね してるだけね";
    text[4272] = "ただ 顔を 見られちゃったわ...";
    text[4273] = "これで もう 後には 引けないわね...";
    text[4274] = "先に 進みましょう";
    text[4275] = "ちょっと 待った！  いいアイデアが あるわ";
    text[4276] = "テトラ あなたって 天才ね！";
    text[4277] = "エヘヘッ このアシスタント・ロボ テトラに 解決できない 問題なんて ないわ！";
    text[4305] = "ジェットスーツは 防水で ピチピチよ  だから 膨らませて";
    text[4306] = "ロボットの ボディを 拡張すれば カンペキな変装が できちゃうってわけ！";
    text[4278] = "ジェットスーツさえ 着ていれば セキュリティ・ロボからも 怪しまれないわ";
    text[4279] = "フフッ そうね それじゃあ 行きましょう  制御パネルは この先よ";
    text[4301] = "これで 独房の ドアの ロックが 解除されたはずよ！";
    text[4308] = "おい！";
    text[4309] = "そっちで 何か 変なことは なかったか？";
    text[4310] = "セキュリティ・ロボから 緊急信号が 送られてきたんだが...";
    text[4311] = "ええっと... どうやら ネズミのせいで セキュリティ・ロボの アラームが 誤作動した みたいよ";
    text[4312] = "念のため 設定を 調整しておいたわ";
    text[4313] = "二度と こんなことに ならないようにね！";
    text[4314] = "ほう お前ら ロボットも 直せるのか";
    text[4315] = "どうやるのか 今度 教えて ほしいなあ";
    text[4316] = "とにかく ここの仕事は ヒマだからさ";
    text[4317] = "ええっと ちょっと 聞いてもいい？";
    text[4318] = "おお もちろん！";
    text[4319] = "ええっと... ワタシは 休み明けで 状況が よくわからないんだけど";
    text[4320] = "どうして 囚人たちが 見当たらないわけ？";
    text[4321] = "ああ それなら 全員 違う施設に 移されたからさ";
    text[4322] = "理由は？";
    text[4323] = "さあね  サロス将軍が そう決めたって ことしか 知らないよ";
    text[4324] = "なるほどね ありがとう！";
    text[4325] = "ええっと...";
    text[4326] = "ワタシたちは 引き続き... ネズミを 探すわ";
    text[4327] = "そうか がんばれよ";
    text[4328] = "フウ... 正直 ダメかと 思ったわ";
    text[4280] = "マークスレイヤーが いないわ！";
    text[4281] = "ひょっとして ここじゃ なかったんじゃない？";
    text[4282] = "いいえ ここの はずよ...";
    text[4283] = "この部屋には ヴィヴィアの ホロテックが 組み込まれているもの... 彼の脱走を 防ぐためにね";
    text[4284] = "可能性としては 彼が 逃げ出したか あるいは...";
    text[4285] = "...しまった！";
    text[4286] = "急いだ方が いいわ！";
    text[4287] = "おそらく 反物質を 引き出すための 部屋に 移送したんだわ！";
    text[4288] = "彼を 助けるために 軍事基地に 行かないと！";
    text[4289] = "今は 変装してるから 疑われずに 辺りを 歩き回ることが できるわ";
    text[4290] = "確か 軍事基地に つながっている エレベーターが あったはず... まずは そこに 行きましょ！";
    text[4302] = "待って 上に向かう エレベーターは 軍事基地に つながっているわ！";
    text[4303] = "今は そっちに 行っちゃ ダメよ";
    text[4304] = "気を 失っているようだ...";
    text[4330] = "軍事基地の 見取り図によると どうやら このフロアは";
    text[4331] = "囚人の脱走を 防ぐための セキュリティが 施されているようね！";
    text[4332] = "レーザーに 当たって 死ぬなんて ゴメンだわ...";
    text[4333] = "まあ ワタシたちに 越えられない 壁なんて ないけどね";
    text[4372] = "ここで ヴィヴィアは ホロテクノロジーを 作り出しているのね";
    text[4373] = "ウーン...";
    text[4374] = "テトラ このコンピュータを スキャンすることは できる？";
    text[4375] = "彼女の ホロテクノロジーの 仕組みについての 情報は 見つからないかしら？";
    text[4376] = "ええ！  ちょっと時間は かかるだろうけど...";
    text[4377] = "でも どうして それを 知る必要が あるわけ？";
    text[4378] = "ちょっとした 考えが あってね";
    text[4379] = "当初の 計画だと マークスレイヤーと 話を するんじゃ なかったっけ？";
    text[4380] = "それは もちろん そうだけど...";
    text[4381] = "...その前に 彼の 信用を得る 必要があるでしょ？";
    text[4382] = "そのためには...";
    text[4383] = "...彼の脱出を 手助けするしかないわ";
    text[4384] = "ええ！？  それ 本気なの ベラ？";
    text[4385] = "そんなの ルナーフォースに 対する 反逆よ！";
    text[4399] = "明日から お尋ね者扱い されてしまうわ...";
    text[4386] = "そういうのは 後から どうにかすればいい";
    text[4387] = "人の命を 助けることが 先決よ";
    text[4388] = "それに 一度 助けたら きっと 心を 開いてくれるはず...";
    text[4389] = "わかったわ... それで 行くなら そうしましょう";
    text[4390] = "ワタシは いつだって あなたの 味方なんだから";
    text[4391] = "だって それが アシスタント・ロボって もんでしょ エヘヘ";
    text[4392] = "さて スキャンが 終わったわ！";
    text[4393] = "このコンピュータから 隠しファイルを 解読したわよ";
    text[4394] = "ヴィヴィアの ホロテクノロジーは カスタムプログラムで 制御されているわ";
    text[4395] = "でも ファイアウォールを すり抜けて ホロテクノロジーを 無効化する パスワードを 見つけたわよ";
    text[4396] = "やったわね！  そのパスワードが あれば...";
    text[4397] = "ねえ テトラ\nいつも ワタシを 助けてくれて... 本当に ありがとう";
    text[4398] = "エヘヘ... これからは 反乱アシスタント・ロボ テトラって 呼んでね";
    text[4412] = "彼に 一体 何を したのかしら...";
    text[4413] = "意識がないわね... 生命反応は 正常だけど...";
    text[4416] = "(あら こんな顔 だったのね...)";
    text[4417] = "(意外と...)";
    text[4418] = "(...かわいいかも)";
    text[4294] = "(ああ 誰か 来たわ... って ヴィヴィアよ！)";
    text[4295] = "(どうするの？)";
    text[4296] = "(大丈夫 口でごまかすわ...)";
    text[4297] = "(いや あなたは ダメでしょ！  声で バレるわよ！  ワタシが やるわ！)";
    text[4298] = "(ええっ！？)";
    text[4414] = "あなたたち ここで 何をしているの？  許可のない 立ち入りは 禁じられているはずよ";
    text[4299] = "申し訳ありません ヴィヴィア司令官  実は あなたの ことを 探していて...";
    text[4300] = "(ああ～ さすが テトラ  声を 変えたわけね！) ";
    text[4400] = "サロス将軍から あなたを 呼んできてほしいと";
    text[4401] = "なんでも... 緊急だそうです";
    text[4402] = "また マークスレイヤーが 目を覚ました 場合に備えて 見張りを するようにとも 言われました";
    text[4403] = "なるほどね";
    text[4404] = "伝えてくれて どうも ありがとう";
    text[4415] = "それじゃ ワタシは この辺で...";
    text[4405] = "フゥ... 危なかった...";
    text[4406] = "サロス将軍 じゃなくて まだ 良かったわ";
    text[4407] = "あの人なら この変装すら 見破ったかもしれない";
    text[4408] = "サロス将軍といえば まだ姿すら 見かけないわね";
    text[4409] = "確かに変ね... 一体 どこで 何を しているのかしら...";
    text[4410] = "まあ それは ともかく... ホロテクノロジーを 無効化できる？";
    text[4419] = "ええ 任せて！  まずは プロトコルを シャットダウンして パスワードを入力して...";
    text[4420] = "できた！";
    text[4421] = "ねえ！  起きて！";
    text[4422] = "マークスレイヤー 起きるのよ！";
    text[4423] = "うう...";
    text[4424] = "その声...";
    text[4425] = "...ベラ？";
    text[4426] = "ええ そうよ  あなたを 助けるために ここに来たの";
    text[4427] = "マジか？  どうしてだ？";
    text[4428] = "...あなたが ガンコだからよ！";
    text[4429] = "サロスに 拷問されて 死んだって 反物質コアの ありかを 言わないんでしょ？";
    text[4430] = "...";
    text[4431] = "あのね あなた 悪い人じゃないと 思うわ  だから 死んじゃ ダメよ";
    text[4432] = "ハッ... お前は 何も わかっていない  オレが 何を してきたのかも...";
    text[4433] = "そうだとしても あなたを 助けたいのよ...";
    text[4434] = "...人として 正しいことを したいの";
    text[4435] = "ねえ マークスレイヤー 今すぐ ここを 脱出しましょう！";
    text[4436] = "オレの 名前は マークスレイヤー じゃない";
    text[4437] = "...ニックルだ";
    text[4438] = "ニックル ちゃんと 歩ける？";
    text[4439] = "ああ 大丈夫だ  ちょっと ふらふらするが 戦うことだって できる";
    text[4440] = "だが お前が 先に行け\nオレは 後ろから ついていく";
    text[4441] = "ワタシを 信用してないわけ？";
    text[4442] = "誰も 信用なんかしないね";
    text[4443] = "アンタこそ 後ろから こっちを 攻撃して 逃げるつもり なんじゃなくって？";
    text[4444] = "そんなことは しない";
    text[4445] = "なら アンタを 信用しろって ことよね？";
    text[4446] = "...後で 聞きたいことがある\nとても 重要なことだ";
    text[4447] = "認めるのは シャクだが...";
    text[4448] = "お前の 助けが いるんだ...";
    text[4449] = "へぇーっ！  じゃあ 取引成立ね！";
    text[4450] = "まず 脱出するなら お互い しっかり 協力しないと いけないわ";
    text[4451] = "ベラ テトラ ニックル - 悪党三人組ね！";
    text[4452] = "あるいは 「ダークヒーロー ルナー三銃士」 かしら？";
    text[4453] = "このロボットは いつも こんなに うざいのか？";
    text[4454] = "あら～ ホロテクノロジーから 助けてあげたのは どこの 誰だっけ～？";
    text[4455] = "まずは 先に 言うことが あるでしょうに フンッ！";
    text[4456] = "...まあ 何は ともあれ さっさと 行くぞ";
    text[4511] = "ニックルが パーティに 加わった！";
    text[4457] = "警報 - ロックダウン作動";
    text[4458] = "マークスレイヤーが 脱出を 図ったもよう  ただちに 捕縛せよ！";
    text[4459] = "ううっ... どこもかしこも 見張りだらけよ！";
    text[4460] = "逃げ道が ないわ！";
    text[4461] = "...いや あるぞ";
    text[4462] = "えっ？";
    text[4463] = "跳べっ！";
    text[4513] = "アイタタ... アンタ 頭おかしいでしょ？";
    text[4464] = "ここは 何階だ？";
    text[4465] = "1階よ\n出口も すぐそこだわ";
    text[4466] = "ターゲット ハッケン\nバトルモード キドウ...";
    text[4467] = "チッ また うざい ロボットかよ";
    text[4468] = "このロボットは 中に人が 入ってるわ！";
    text[4514] = "パイロットを ケガさせないように 気をつけて！";
    text[4515] = "あなたたち しばらく 時間を 稼いでちょうだい！  その間に レーザードアを 無効化するわ！";
    text[4469] = "オレたちに 手を出すと どうなるか タップリ 教えてやらないとな";
    text[4516] = "....";
    text[4470] = "おい お前は そこで 突っ立ってるのか？  戦わないのか？";
    text[4471] = "ベラ... オレを 脱出させると 決めた時に 覚悟も 決めたんじゃ ないのか？";
    text[4472] = "今は たとえ 世界を 敵に回そうが... 戦わなくちゃ いけないんだよ";
    text[4473] = "...戦わなければ 今まで やったことが すべて ムダになるぞ";
    text[4474] = "ここで 心のカラを 破らなければ 世界を 変えることも";
    text[4475] = "探す答えを 得ることも できないんだ";
    text[4476] = "...わかったわ";
    text[4477] = "ワタシ 戦う！";
    text[4478] = "そう 来なくっちゃよ！  さあ 行くぜ！";
    text[4479] = "レーザードアを 無効化したわ！  さあ 出口は こっちよ！";
    text[4480] = "うう 船がないわ... どうやって 脱出すればいいの？";
    text[4481] = "大丈夫 歩けばいいわ";
    text[4482] = "シリカという コロニーに オレの アジトがある";
    text[4483] = "シリカって ここから かなり 北の方よね...";
    text[4484] = "でも この近くに ルナーフォースに バレずに 隠れられる 場所が あるってのか？";
    text[4485] = "...いいえ";
    text[4486] = "なら シリカに 行くしか ないだろう";
    text[4487] = "まずは 西に 向かうんだ";
    text[4488] = "この先の道は 永遠の闇 クレーターに つながっているはずだ";
    text[4489] = "人目に つかないように クレーターの 一番 暗い所を 進まなくちゃ ならないがな";
    text[4490] = "ようし そうと 決まれば 行くわよ！";
    text[4492] = "ヴィヴィア司令官！";
    text[4493] = "あなたには 失望したわよ ベラ";
    text[4494] = "......";
    text[4498] = "どうやら あなたが 裏切ったという サロス将軍の 見立ては 正しかったようね";
    text[4520] = "初めて 聞いた時は 信じられなかったけど...";
    text[4499] = "あなたの ルナーフォースへの 忠誠心は 決して 揺らがないものと 思っていたわ...";
    text[4521] = "ごめんなさい... ただ...";
    text[4522] = "ワタシは 決めたんです\nこれが 自分の 進む道なんだって";
    text[4523] = "ところで さっきは... ワタシたちに 気づいていたんでしょう？";
    text[4495] = "ええ その小さなロボットさんが 下水の ネットワークを";
    text[4496] = "シャットダウンした時に 気づいたわ";
    text[4497] = "あらら... ヴィヴィア司令官も なかなかに 抜け目のない 人だったのね";
    text[4500] = "あなたが マークスレイヤーから 必要な情報を 引き出してくれることを 望んでいたけれど";
    text[4501] = "その期待を 見事に 裏切ってくれたわね";
    text[4524] = "ヴィヴィア司令官...";
    text[4526] = "そして マークスレイヤー... どうして さっきから ずっと 黙っているの？";
    text[4530] = "...チィッ";
    text[4527] = "ワタシが いるだけで トラウマが 蘇るから...？";
    text[4531] = "...それとも 単に 怖いとか？  ウフフ！";
    text[4528] = "あなたが 泣き叫ぶ 様子を 眺めるの なかなか 楽しかったわよ";
    text[4529] = "...でもね あれも 任務の 一環なの  だから どうか 恨まないで ちょうだいね";
    text[4532] = "...お前の 顔を 見るだけで ヘドが 出る";
    text[4502] = "へぇ その言葉 聞き捨て ならないわね！";
    text[4503] = "バトルロボットは しくじったけど 今度は このワタシが 直々に 相手になって あげるわ";
    text[4525] = "ホロスーツ起動！";
    text[4504] = "やめてください ヴィヴィア司令官\n戦う以外の 道は ないんですか？";
    text[4505] = "反逆を 見逃せって 言うの？  バカねえ...";
    text[4539] = "ルナーフォースの 司令官を 甘く見ないで ほしいものだわ";
    text[4540] = "何ですって！  そこまで 言うなら 上等よ！  ";
    text[4541] = "...今の あなたは 以前とは どこか違うわ";
    text[4542] = "何年も あなたのことを 見てきたけど...";
    text[4543] = "ママが 生きていた頃は こんな冷たく 突き放すような 人じゃなかった...";
    text[4544] = "今は まるで 別人よ";
    text[4545] = "おだまり！";
    text[4546] = "ワタシはただ サロス将軍の 人類の救済を 手助けするだけよ";
    text[4547] = "そして マークスレイヤーが そのカギを 握っているの";
    text[4548] = "さて おしゃべりは ここまでよ\nこれから お楽しみの 時間を 始めると しようじゃないの！";
    text[7601] = "まだよ！\nあなたたちを 逃がしはしない！";
    text[7602] = "ホロフィールド起動！";
    text[7613] = "どうやら ワタシの 勝ちみたいね\nさて 援護を 呼ぶまで おとなしく しているのよ";
    text[7603] = "クソッ...\nコペルニクスで 使ってきたやつと 同じか...";
    text[7604] = "閉じ込められちまったな...";
    text[7605] = "テトラ どうにか ならないの！？";
    text[7615] = "スキャンしてみるわ！";
    text[7606] = "...ウーン どうやら サロスが 前に 言ってたことは ハッタリじゃ なかったみたいね";
    text[7616] = "ホロフィールドの 中の エネルギーが 一定量に 達したら";
    text[7617] = "圧縮されて 中にいるものは 死んでしまうわ...";
    text[7607] = "...ただし";
    text[7608] = "ホロフィールドを 壊せるだけの 超巨大エネルギーを 作れたら...";
    text[7609] = "なら ニックル\nあの姿に...";
    text[7610] = "ムリだ！";
    text[7611] = "フェイズフォームは キケンすぎる";
    text[7612] = "お前は わかっていない...";
    text[7618] = "オレ自身が 反物質に 取り込まれたら...";
    text[7619] = "...自我を 失うかもしれないんだ";
    text[7620] = "だから どうしてもの時以外は ゼッタイ 使うわけには いかないんだよ";
    text[7621] = "なら 今こそ まさに その 「どうしてもの時」 なんじゃ なくって！？";
    text[7622] = "ねえ お願いよ ニックル...";
    text[7623] = "急がないと ヴィヴィアが 戻ってくるわ！";
    text[7624] = "チッ@P.@P.@P.@P.@P.@P.@P.@P.@P.";
    text[7625] = "わかった いいだろう\nそこまで 言うなら やってやる";
    text[7626] = "...ただし それで お前らが ケガしても...";
    text[7627] = "ああ もう！\nいいから さっさと やりなさい！";
    text[7628] = "うおおおおおおおお！";
    text[4507] = "ヴィヴィアは ひるんでいる！";
    text[4508] = "今が チャンスだ！  行くぞ！";
    text[7630] = "ニックル さっきの フェイズフォーム... すごかったわよ！";
    text[7631] = "制御できない みたいに 言ってたけど 本当なの？";
    text[7632] = "どのみち 使うのは イヤなんだよ...";
    text[7633] = "今回は まだ 良かったが うまくいかない 時もある";
    text[7634] = "そんなに 単純な話じゃ ねえんだ";
    text[7635] = "...さてと グズグズしている ヒマはないぞ";
    text[7636] = "そうね...";
    text[7637] = "追手に 見つかる前に さっさと この場を 離れよう";
    text[7638] = "フェイズモードが アンロックされました！";
    text[7639] = "このフォームは 3ターン持続し ニックルの アクティブスキルの 威力が 2倍に なります";
    text[7640] = "このフォームで いる間 50ポイント以下の 被ダメージが ゼロになります！";
    text[4567] = "こんな船 見たことないわ...";
    text[4568] = "データベースによると これは いわゆる 「ポッドシップ」ね！";
    text[4569] = "ルナーフォースで 数年前まで 作られていた モデルよ";
    text[4570] = "どうやら このエリアで 大量に 捨てられた みたいね";
    text[4571] = "ねえ テトラ この船を 起動することは できる？";
    text[4572] = "まあ やってみるわ...";
    text[4573] = "バッテリーが 上がってなければ いいんだけど...";
    text[4574] = "やったあ！  動いたわ！";
    text[4575] = "よし じゃあ 北に 向かうぞ";
    text[4579] = "おい いたぞ！  逃がすな！";
    text[4580] = "まずいわ  追手が こっちに 来てる！";
    text[4581] = "急いで 船に 乗るんだ！";
    text[4585] = "うう 狭いわね...";
    text[4586] = "ああ 言い忘れてたけど...";
    text[4587] = "ポッドシップは 基本的に 1人用なのよ... エヘヘ";
    text[4582] = "フォトン砲が 来るわ！";
    text[4553] = "外したわよ！  何を グズグズしているの！？  どんどん 打ちなさい！";
    text[4554] = "しかし司令... サロス将軍は 生け捕りに するようにと...";
    text[4555] = "大丈夫 こいつらは そんな簡単に 死ぬタマじゃないわ";
    text[4556] = "やつらの船を 破損させ... 消耗させ...";
    text[4557] = "すべての 気力を...\nそして 希望を 奪ってやるのよ！！";
    text[4558] = "わ わかりました！  フォトンブラスター 全開！";
    text[4589] = "船を動かし すべての弾を かわそう！";
    text[4590] = "うまく まいたわね ベラ！";
    text[4591] = "ヘヘッ ワタシに かかれば こんなもんよ";
    text[4592] = "油断するのは まだ早いぞ";
    text[4593] = "船の バッテリーが 落ちかけてる";
    text[4594] = "船を 降ろせ\nシリカ峡谷は すぐそこだ！";
    text[4595] = "「降ろしてください」 でしょ？";
    text[4600] = "つべこべ 言わずに 「降ろせ」";
    text[4601] = "フンッ イヤなやつ...";
    text[4602] = "ようし じゃあ 降りるわよ！\n揺れるから しっかりと 捕まっててね！";
    text[4598] = "船が ダメージを 受けすぎたわ！";
    text[4599] = "爆発する前に 緊急着陸するわよ！";
    text[4603] = "テトラ ここの 座標は？";
    text[4604] = "セクター2 - シリカ峡谷よ！";
    text[4605] = "クソッ... 隠れ家までは まだ相当 距離があるな...";
    text[4606] = "ハァ... ハァ...";
    text[4607] = "ニックル 大丈夫？";
    text[4608] = "大丈夫だ... ただ...";
    text[4609] = "ケガしてるわ！  どこかで 休ませないと！";
    text[4610] = "テトラ あなたは ポッドシップを 運んで  ここに 置いていったら 居場所が バレてしまうわ";
    text[4611] = "さっき 小さな洞窟が 見えたから 今夜は そこで 休みましょう";
    text[4614] = "-同時刻 ルナー宇宙ステーション-";
    text[4615] = "ふう... 今日の トレーニングは こんなところ かしらね...";
    text[4616] = "もう 腕が 上がらないわ！";
    text[4617] = "そうね かなりの量を こなしたことだし...";
    text[4618] = "あなたの 新技 すごく イケてるわよ ザラ";
    text[4670] = "ええっと... 「スティック・ストーン・バーガー」 だっけ？";
    text[4619] = "「スタティック・スタン・ビーム」 ね  ";
    text[4633] = "あなたの 新技開発への 情熱には いつも 感心させられるわ";
    text[4620] = "きっと いつの日にか 最高の ニューロンリンク・マスターに なれるはずよ";
    text[4621] = "ありがとう... だと いいけどね";
    text[4622] = "それで...";
    text[4623] = "レインも そろそろ 上がる頃だと 思うんだけど...";
    text[4624] = "...ああっ！\nウワサを すれば！";
    text[4625] = "ああー！  アンタたちにも 最後に 決めた 豪快な パンチ 見せてあげたかったわ！";
    text[4635] = "バトルボットには かわいそうなこと したけどね！  あ～スッキリした！";
    text[4628] = "レイン隊員 今 爆発音が 聞こえましたが 大丈夫ですか？";
    text[4629] = "ええっと...";
    text[4630] = "エンジニアを 呼んでくれる？ バトルボットが... その... 壊れちゃって...";
    text[4631] = "...直したばっかだけど";
    text[4632] = "わかりました\nじゃあ 呼んできます...";
    text[4636] = "それで これから どうするの？";
    text[4637] = "じゃあ ベラに 連絡しましょう！";
    text[4638] = "あの人 今 何してるのかしらね";
    text[4639] = "いいわねえ... ちょうど バトルボットが 壊れちゃったとこだし";
    text[4640] = "ベラを 練習台にでも するわ！  ガッハッハッハー！！";
    text[4641] = "天才って 言われて チョーシこいてる あいつの尻を 蹴とばして やるんだから！";
    text[4642] = "頼むから 落ちついて レイン";
    text[4643] = "あら？  どうやら 新しい ミッションが 来たみたいよ！";
    text[4644] = "...";
    text[4645] = "...何ですって？";
    text[4646] = "本当に？  何かの 間違いじゃないの...？";
    text[4647] = "パープルコードの ミッションって 上位の隊員に 向けた 特別な ものよね...";
    text[4648] = "マークスレイヤーが 脱走した！？";
    text[4649] = "...みたいね  そして ミッションは マークスレイヤーと...";
    text[4650] = "その共犯者の...";
    text[4651] = "ベラ・グレイを 捕らえること";
    text[4652] = "そんな バカなこと...";
    text[4653] = "ベラが あいつと 組んでたっていうの？";
    text[4654] = "そうは 思えないけどね...";
    text[4655] = "ベラが ルナーフォースを そんな風に 裏切るだなんて 思えないし...";
    text[4656] = "...ただ...";
    text[4671] = "ふざけるな！！！";
    text[4657] = "今のは トーマス博士！？  すごい勢いで 走っていったわ！";
    text[4659] = "ええっと... あなたたちは ミッションレポートを 読んだ？";
    text[4660] = "ええ...";
    text[4661] = "博士は ベラの名前を 見るや いなや いきなり部屋を 飛び出してね...";
    text[4662] = "おそらくは 基地に行って サロス将軍と 直接 話す つもりなんでしょうね";
    text[4663] = "ああ かわいそうな ベラ...";
    text[4664] = "今や 反逆者か ウェヘー...\nこっちまで 暗い気分に なるよ...";
    text[4665] = "(あの人が そういうことを したなら... ゼッタイに 何か 理由があるはず...)";
    text[4666] = "今すぐ ベラを 探さないと まずいわ！";
    text[4667] = "そうね 他の ルナーフォースの 人たちでは どのみち あの子を 止められない";
    text[4668] = "まさに レイン隊に うってつけの 仕事だわ";
    text[4669] = "それじゃあ 早速 行くわよ！";
    text[4672] = "...";
    text[4673] = "どうしたの ベラ？";
    text[4674] = "別に ただ...";
    text[4675] = "...不安に なっているのかしらね";
    text[4676] = "長い間 ルナーフォースの ために がんばって...";
    text[4677] = "ママのような すごい戦士に なるために 厳しい トレーニングを 積んで...";
    text[4678] = "...ルナーを 守ることを 誓ったのに";
    text[4679] = "今はまるで 世界が ひっくり返って しまったような 感じよ";
    text[4680] = "大丈夫よ ベラ\n一緒に 力を合わせれば きっと どうにかなるわ！";
    text[4681] = "今は 苦しいけど ここが ふんばりどころよ！";
    text[4682] = "そうね...";
    text[4683] = "...お前ら 静かに してくれないか？  ただでさえ 頭が 痛いのに...";
    text[4684] = "あら どうやら 誰かさんが 目を覚ましたようね";
    text[4685] = "うう... どれくらい 寝ていたんだ？";
    text[4686] = "4時間よ";
    text[4687] = "4時間 でっかい いびきを かいてたわよ！  フンッ！";
    text[4690] = "それに お腹も グーグー 言ってたわね";
    text[4691] = "...";
    text[4692] = "もう少し 体を 休めたら 何か 食べましょうかね";
    text[4693] = "ワタシ いつも 非常用の チーズケーキバーを 持ち歩いてるから...";
    text[4694] = "いらねえよ";
    text[4695] = "チーズケーキバーを 食べないなんて あなた 正気なの？";
    text[4696] = "それとも 食べたことないわけ？";
    text[4697] = "ない...";
    text[4698] = "なら ゼッタイ 食べてみるべきよ！  すんごく おいしいんだから！";
    text[4699] = "...そうか なら 半分くれ";
    text[4700] = "(モグモグモグ...)";
    text[4701] = "それで...";
    text[4702] = "どう思う？";
    text[4703] = "おいしい？";
    text[4704] = "...まあまあ じゃないか (こんな うまいものが この世に あったのか！！)";
    text[4705] = "フーン... なんか 顔に 書いてあるけど まあ いいわ";
    text[4706] = "気に入ったなら 良かった！";
    text[4707] = "...おう";
    text[4708] = "まあ ここなら しばらくは 安全だろうし...";
    text[4709] = "ちょっと お話をしましょう\nお互いを よく知るためにね";
    text[4710] = "何を話すんだ？";
    text[4711] = "アンタね もう少し コミュニケーションってもんを 学んだ方が いいんじゃなくって？";
    text[4712] = "あのなあ 脱出を 助けてくれたと いうだけで";
    text[4713] = "ダチに なっただなんて 思わないでくれ";
    text[4714] = "でも アンタに 必要なものは";
    text[4715] = "苦しいことを 分かち合える 友達...";
    text[4716] = "心温まる時を 分かち合える 友達 なんじゃなくって...？";
    text[4717] = "あまり オレに 深く 関わらない方が いいぜ";
    text[4718] = "オレだって 自分みたいな ヤツとは 友達に なりたくないからな";
    text[4719] = "...前は 親友と 呼べる ヤツもいたが...";
    text[4720] = "...みんな いなくなっちまった";
    text[4721] = "どこに行っても 辛い 思い出ばかりが つのる";
    text[4722] = "どこに行っても オレの せいで ひどいことになる";
    text[4723] = "あなたは 何を 恐れているの？";
    text[4724] = "大切な友達を 失うこと？";
    text[4725] = "...お前には 本当に イライラさせられるよ";
    text[4726] = "他にも 気になることが あるんだけど...";
    text[4727] = "どうして ワタシは いいの？";
    text[4728] = "それは どういう意味だ？";
    text[4729] = "助けたのが ワタシじゃなければ もう この場を 去ってたでしょ？";
    text[4730] = "あなたは 人に 心を 開かないばかりか 話そうともしないわ";
    text[4731] = "...でも どうして ワタシなら いいわけ？";
    text[4732] = "...";
    text[4733] = "ワタシの ママを 知ってるから？";
    text[4734] = "ちょっと 聞いてもいい...？";
    text[4735] = "どうやって ママを 知ってるの？";
    text[4736] = "ずっと 昔のことだ... 当時の オレは まだ 自分の力を ほとんど コントロールできなかった...";
    text[4737] = "それで 力が暴走し...";
    text[4738] = "ルナーフォースが やって来て... お前の母は オレを 引き入れる プロジェクトを 指揮していた";
    text[4739] = "オレは 何とかして 正気を 保とうと 必死に がんばった...";
    text[4740] = "苦しみながらも あの人の 言葉を聞いた";
    text[4741] = "その時... あの人の 心の暖かさを 感じたんだ...";
    text[4742] = "それから 気が付くと オレは 隠れ家に 戻っていた";
    text[4743] = "もう 痛みは なかった\n力の暴走も 収まっていた";
    text[4744] = "あの人は オレを 引き渡すことも できたが そうしなかった";
    text[4745] = "そうではなく 時々 会いに行くような 形を選んだ";
    text[4746] = "軍事基地に 連れていったら どうなるか わかっていたんだろう";
    text[4747] = "当時 サロスは 軍事科学部門の 責任者だった";
    text[4748] = "やつは オレを 監禁し 徹底的に 研究すべきだと 主張した";
    text[4749] = "とんでもない 力を持つ 少年は 貴重な 実験台なのだと";
    text[4750] = "だが シアは サロスの 意見を はねつけ オレを 守ってくれた";
    text[4751] = "一つ 妙なのは... オレは 常に あの人から フシギな力が 出ているのを 感じていたんだ";
    text[4752] = "オレの 反物質が 反応した フシギな力を...";
    text[4753] = "そして 同じものを お前からも 感じた";
    text[4754] = "ラックスを 操る力をな";
    text[4755] = "...！";
    text[4756] = "ママは その力について 何か言ってた？";
    text[4757] = "...さて そろそろ 行くぞ";
    text[4758] = "ああ もう ムシしないでよ！  お願い 知りたいの...";
    text[4759] = "....オレも 少し 聞きたいんだが...";
    text[4760] = "その力は 自分で コントロール できるのか？";
    text[4761] = "いいえ... 突然 現れたりするだけよ";
    text[4762] = "コントロールできれば マークと 心を 通わせられる かもしれない...";
    text[4763] = "平和を 実現できるかも しれないのよ！";
    text[4764] = "なるほどな... ただ まだ お前が 真実と 向き合えるとは 思えないが";
    text[4765] = "それに 完全に 信用も していない...";
    text[4766] = "まあ いい  隠れ家に 着いたら いろいろ 教えてやるよ";
    text[4767] = "...わかったわ";
    text[4768] = "じゃあ ここで はっきりさせましょう...";
    text[4769] = "あなたは ワタシの 助けがいる...";
    text[4770] = "...そして ワタシも あなたの 助けがいる";
    text[4771] = "ラックスの力の 正体を 知らなきゃいけない...";
    text[4772] = "以前は あなたの 反物質コアが どこにあるのかを 追求していたけど...";
    text[4773] = "今は... 気が変わったわ  あなたが それを とても大事に していることが わかったから";
    text[4774] = "何であれ もう あなたの 反物質コアを 取ったりはしない";
    text[4775] = "ただ 真実を 知りたいの";
    text[4776] = "真実を 知らないと みんなを 守ることも...";
    text[4777] = "大切な人を 守ることも...";
    text[4778] = "できなくなるのだから";
    text[4779] = "コーダ彗星を 止める 別の方法を 知りたいの！  だから ゼッタイに あきらめないわ！";
    text[4780] = "......";
    text[4781] = "... オレも ルナーの みんなを 守りたい";
    text[4782] = "あら やっと 1つ 意見が 一致したようで うれしいわ";
    text[4783] = "ルナーフォースが 来る前に ここから出よう";
    text[5000] = "待て 動くな  軍用船だ";
    text[5001] = "探索用の ドローンを 放ってるみたいね！";
    text[5002] = "それは つまり ルナーの 北部を 調べられるだけの 人員は いないと いうことね";
    text[5003] = "ああ ドローンに 見つからない 限り キケンは ないだろう";
    text[5004] = "さて 今 このタイミングなら 良さそうだな... さあ 行くぞ";
    text[4968] = "...！";
    text[4969] = "声が 聞こえたわ！\nすごく 小さかったけど...";
    text[4970] = "心を乱すな 集中しろ";
    text[4971] = "自分の ラックスに つながるんだ...";
    text[4972] = "でも... どうやって？";
    text[4973] = "前にも その気持ちを 感じたことが あるだろう？  その時のことを 思い出すんだ";
    text[4974] = "つながりたい その気持ちだ...";
    text[4975] = "心と魂を 通じて コミュニケーションを とる感覚...";
    text[4976] = "それを 持ち続けるんだ";
    text[4977] = "たす...け...";
    text[4978] = "...い...た...い...";
    text[4979] = "お...ねが...い";
    text[4980] = "また 声が 聞こえたわ！  今回は かなり はっきりと";
    text[4981] = "きっと... 助けを 求めているんだわ  痛みに 苦しんでてね";
    text[4982] = "近くに マークの 気配を 感じる\nその声は 間違いなく マークからの ものだろう";
    text[4960] = "何とかして 探り当てて...";
    text[4983] = "...反物質コアを 手に入れないとな";
    text[4961] = "あのね 今 ワタシたちは 逃げてるところなのよ？";
    text[4962] = "そうよ ドローンに 見つかるかもしれないわ！";
    text[4963] = "関係ない\nドローンなんて どうってことないさ";
    text[4964] = "マークが いるなら 戦わなくちゃいけない";
    text[4984] = "まあ 万全な体調とは ほど遠いが...";
    text[4985] = "一緒に... 戦ってくれないか？";
    text[4986] = "でも... マークを 殺すのは イヤよ...";
    text[4987] = "それは オレだって 同じだ でも...";
    text[4988] = "反物質コアが 世に正義を もたらすための カギなんだ";
    text[4989] = "正義？  マークが あなたに 一体 何をしたって 言うの？";
    text[4990] = "マークが 何かを したとかじゃない";
    text[4991] = "オレが やつらに対して 何をすべきかと いうことだ...";
    text[4992] = "ああ もう あなたって 本当に ガンコなのね  本当に ワタシの 助けが いるなら";
    text[4993] = "いろいろ 正直に 答えてちょうだい";
    text[4994] = "ハァ...";
    text[4995] = "すべてを 語ったら お前も わかることだろう";
    text[4996] = "確かに 真実は 時として 重荷になるわ...";
    text[4997] = "でも その重荷を 1人で 背負う 必要はないでしょ？";
    text[4998] = "...わかってるさ";
    text[4999] = "さあ マークを 探しに 行こう";
    text[4846] = "...ああ 何かあるぞ！";
    text[4847] = "本当に！？  何も 見えないけど";
    text[4848] = "テトラ センサーを 起動して";
    text[4849] = "ああ...！  反物質粒子の クラスターを 検出したわ！";
    text[4850] = "オレは時々 他の人間とは 別のものが 見えてることを 忘れてしまうよ";
    text[4851] = "どういう意味？";
    text[4852] = "電磁波には 人間の目で 見える範囲を";
    text[4853] = "超えた波長がある";
    text[4854] = "オレは... 他の人間には 見えない 反物質の光を";
    text[4855] = "見ることが できるんだ";
    text[4856] = "へぇ...";
    text[4857] = "そりゃあ すごいわね！";
    text[4858] = "ハッ... そう思ったことは ないがな";
    text[4859] = "いつだって 負担以外の 何者でもなかった... 感覚が 過敏に なりすぎてな";
    text[4860] = "慣れるだけでも ずいぶん 時間が かかったもんだ";
    text[4861] = "ウーン... それが マスクを してた 理由なわけ？";
    text[4862] = "あなたの マスクは ルナーフォースの 宇宙ヘルメットを 改造したものよね？";
    text[4863] = "あれは 有害な 宇宙線を 遮断して";
    text[4864] = "目を 守ってくれるのよ";
    text[4865] = "ああ そうだな";
    text[4866] = "それで マスクを 怖い顔に したのは どうしてなの？";
    text[4867] = "...どうしてかって？  別に 理由なんて ないけどな";
    text[4868] = "本当に？  フーン";
    text[4869] = "ただ...";
    text[4870] = "カッコイイんじゃないかって... ええっと 少し 怖い方がさ...";
    text[4871] = "まあいい おしゃべりは こんなところにして...";
    text[4872] = "反物質クラスターの 正体が 何であれ 手に入れて さっさと 先に進もう";
    text[5100] = "ああっ！";
    text[5101] = "ベラ 大丈夫？  次は もうちょっと 気をつけるのよ！";
    text[5102] = "爆発により 1000バイトを 失った...";
    text[5045] = "おい まずは 近くの マークを 探さなくちゃ いけねえよ";
    text[5046] = "ベラ 反物質コアを 取り忘れてるわよ！";
    text[3528] = "ベラ あそこを 見て！  あれは何？";
    text[3529] = "マグネリアという 古い町ね...";
    text[3530] = "...というよりは 町の跡地と 言うべきかしら";
    text[3531] = "公式の記録によると マグネリアの 突然の破壊は";
    text[5107] = "ものすごく強力な マークによって 引き起こされた ものだそうよ";
    text[3540] = "...";
    text[3532] = "その当時は まだ 小さかったから あんまり 覚えてないけどね";
    text[3533] = "その日に 一体 何があったのか 今となっては 知ることさえ 難しいわ";
    text[3534] = "どうして？";
    text[3535] = "ほとんどの人が 死んだからよ...";
    text[3536] = "当時の ルナーフォースには マークへの 備えが なかった...";
    text[3537] = "...なら この間の コペルニクスも 一歩間違えたら";
    text[3538] = "そうなってたってこと？";
    text[3539] = "ええ...";
    text[3540] = "...";
    text[3541] = "...ベラ？";
    text[3542] = "ああ ごめん\n亡くなった 人たちのために 少し お祈りしていただけ";
    text[3543] = "これからも がんばって 1人でも 多くの命を 救いましょう！";
    text[3544] = "...テトラ？";
    text[3545] = "ワタシも お祈りしたわ！  エヘヘ！";
    text[5108] = "えっと... ニックル 大丈夫？";
    text[5109] = "なんか 震えてるけど...";
    text[5110] = "...";
    text[5111] = "わ 悪い...";
    text[5112] = "もう 大丈夫だ... さあ 行こう";
    text[5113] = "シリカの コロニーは すぐそこだ";
    text[5114] = "(...一体 どうしたのかしら？)";
    text[5115] = "（まるで お化けでも 見たような 顔だったけど）";
    text[5116] = "(わからないけど... 今は そっとしておいて あげましょう)";
    text[5117] = "ああ このコロニーは 暖かくていいわね";
    text[5118] = "シリカに 来たのは これが はじめてか？";
    text[5119] = "ええ！  でも 一目見て 気に入ったわ！";
    text[5120] = "ああ 見て！  カフェも あるじゃない！";
    text[5121] = "もう 髪も ボサボサだわ";
    text[5122] = "ここにいる間に 身だしなみを 整えて 食料も 買いだめ しないとね！";
    text[5123] = "約1名 クサい人が いるから シャワーも 浴びて ちょうだいね";
    text[5124] = "ええ... お前 ニオイも わかるのか？";
    text[5125] = "ロボットに そんな機能 いらないんじゃないのか？";
    text[5126] = "いらないのは アンタよ！ フンッ！";
    text[5155] = "ああ もう 2人とも ケンカは やめなさい  少し 休むわよ";
    text[5156] = "30分後...";
    text[5127] = "ああ～ お腹いっぱい！  すんごく おいしかったわ！";
    text[5128] = "ニックル あなたも まさか ワタシの チーズケーキバーの 大食い記録を 破るだなんてねえ";
    text[5129] = "いやあ なんか やけに クセになる 味でな...";
    text[5130] = "あと 何本か 取っておかなくっちゃね";
    text[5131] = "1本は今 もう1本は後...";
    text[5132] = "...最後の1本は もっと後で！  エヘヘ";
    text[5133] = "それで ニックル マークを 狩る以外 あなたは 何をしてるの？";
    text[5134] = "意外に 思えるかもしれないが オレは トレジャーハンターなんだ";
    text[5135] = "珍しい アイテムを 見つけて 売って 生計を 立ててるのさ";
    text[5136] = "へぇ すごいじゃない！";
    text[5137] = "そうか？  キツい商売 だけどな  まあ 面白いのは 確かだよ";
    text[5138] = "子供の頃から 探検したりするのが 好きだったんでな";
    text[5139] = "ルナーの 地面には いろんなものが 埋まってるんだ";
    text[5140] = "いつの日か ルナーの 隅々まで 堀り出して みたいもんだ";
    text[5141] = "...それで 何か レアな お宝を 見つけるんだ";
    text[5142] = "でも 今は...";
    text[5143] = "先に やらなくちゃ いけない ことがある  だから しばらくは お預けだ";
    text[5144] = "...コーダ彗星を 止めて この危機を 乗り越えないと...";
    text[5145] = "...でも それが 終わったら...";
    text[5146] = "一緒に... トレジャーハントするなんて どうだ？";
    text[5147] = "もちろん お前もな テトラ！";
    text[5148] = "わあ 楽しそう！  もちろんよ！";
    text[5149] = "ゼッタイ行くわ！  ワタシよりも トレジャーハントに 役立つ アシスタント・ロボは いないんだから！";
    text[5150] = "まあ アンタ 思ったほど イジワル じゃないみたいね";
    text[5151] = "いやあ これからも ほどほどに イジワル してやるよ ハハハ！";
    text[5152] = "ええ？  やれるもんなら やってみなさいよ！";
    text[5154] = "こっちも タップリ 仕返し してやるんだからね！";
    text[5017] = "ええっと 2人の 友情イベントを 遮って 悪いんだけど あなたの 言ってた 隠れ家って この辺にあるの？";
    text[5153] = "いい質問だな...";
    text[5005] = "ええっと...";
    text[5006] = "実は 今まで ウソを ついてたんだ...";
    text[5007] = "ええ？  ウソって？";
    text[5008] = "オレの 隠れ家は シリカじゃないんだ";
    text[5009] = "ええ！？  なら どうして ここに！？";
    text[5010] = "ひどい 時間の ムダじゃない！";
    text[5011] = "すまない... お前たちを 信用できて なかったもんでな";
    text[5012] = "それじゃあ 本当は どこなわけ？";
    text[5013] = "オシアナスだ";
    text[5014] = "ありえない  また ウソついてるんでしょ！";
    text[5015] = "今度は ウソじゃない！  本当だよ！";
    text[5016] = "(こいつ なんで 怒ると こんなに 怖いんだ！？)";
    text[5021] = "ワタシはね オシアナスに 何度も 行ってるのよ！";
    text[5022] = "あの砂浜に ひそめる 場所なんて ほとんどないわ";
    text[5023] = "いや オレの 隠れ家は... ちょっと 変わった所に あるんだ  行けばわかるさ";
    text[5024] = "とにかく ここだって 目的もなく 来たわけじゃない";
    text[5025] = "シリカには いろいろと ものを 買うために よく来るんだ";
    text[5026] = "ルナーフォースの やつらは 北の方には";
    text[5027] = "あまり 来ないから 何かと 動きやすいんだ";
    text[5028] = "あと ここには サイファーっていう ダチもいる  そいつが 新しい 宇宙船を 手配してくれるはずだ";
    text[5029] = "サイファーって アストロテック商人の？\n確か レゴリシアで 会ったわ";
    text[5030] = "ええっ アンタ 友達いたの？";
    text[5031] = "それは ちょっと ひどいわよ テトラ";
    text[5032] = "ええ？  少し いじっただけでしょ？\nテトラ 1点 - ニックル 0点よ！ ";
    text[5033] = "そのうち あなたも カレシこうほリストから 外すことに なるんじゃなくって？";
    text[5034] = "ええ... そんなリストを 作ってるのか？";
    text[5035] = "ち 違うわよ！  ワタシは そんなもの 作れだなんて 言ってない！";
    text[5036] = "とにかく こいつが まだ ワタシたちから 逃げてないことが 驚きだわ";
    text[5037] = "ひょっとして ベラのことが 好きになったのかしら？";
    text[5038] = "...それとも ワタシを ベラの アシスタント・ロボの 座から 引き下ろす気 なのかしらね？";
    text[5039] = "アシスタント・ロボ！？\n誰が そんなものに なりたいんだ？";
    text[5040] = "ちょっと 口に 気をつけなさい";
    text[5041] = "ああ もう... その辺に しておきなさい！  ワタシは サイファーを 探しにいくわ";
    text[5042] = "フンッ！";
    text[5043] = "フンッ！";
    text[8792] = "待ってくれ！  オレは ジェットスーツを 持ってないぞ！  どうやって 飛べっていうんだ？";
    text[8793] = "じゃあ 1つ 買ったら？";
    text[8794] = "イヤだね  使い方すら 知らないのに";
    text[8795] = "じゃあ いいわ...";
    text[8796] = "ワタシが 運んであげる";
    text[8797] = "待て それも イヤだ";
    text[8798] = "お前に 命を 預けるなんて もってのほかだ";
    text[8799] = "テトラは 人を 落としたりなんて しないわ";
    text[8800] = "見た目よりも ずっと パワフル なんだから";
    text[8801] = "どちらにしろ 5秒以内に 決断してね";
    text[8802] = "5...";
    text[8803] = "お おい 待て！";
    text[8804] = "3...";
    text[8805] = "...";
    text[8806] = "2...";
    text[8807] = "1...";
    text[8808] = "ああ もう わかったよ！  言う通りにすりゃ いいんだろ？";
    text[8809] = "ただし もし 落としたら...";
    text[8810] = "大丈夫よ ワタシを 信じて";
    text[5056] = "よお サイファー";
    text[5057] = "ええっ！？  お前 捕まったじゃ なかったのかよ！";
    text[5058] = "ああ そうだぜ  でも そこの 2人に 助けられたんだ";
    text[5059] = "また 会えて うれしいわ サイファー！";
    text[5060] = "ああ そういえば レゴリシアで 会ったな";
    text[5061] = "それで 一体 何の用だ？";
    text[5062] = "船を 借りても いいか？";
    text[5063] = "もちろんだ！";
    text[5064] = "いい船が あるかどうか 見てみるぜ";
    text[5065] = "ありがとよ サイファー";
    text[5066] = "サイファーは あなたが マークスレイヤーなのを 知ってるのね？";
    text[5067] = "ああ 知ってるのは ほんの 数人だけだ  やつとは 昔からの 知り合いさ";
    text[5068] = "マークに 襲われてる ところを 助けたのが きっかけだ";
    text[5069] = "うう ちょっと 残念だが もう いい船は 全部 売っちまっててな...";
    text[5070] = "あるのは 小さな ミニポッドだけだ";
    text[5071] = "それは 充電されているの？";
    text[5072] = "おうよ！";
    text[5073] = "なら 使わせてくれ";
    text[5074] = "ぶっちゃけ 持っていっても いいぜ\n命を 助けてもらった 借りも あるわけだしな";
    text[5075] = "ありがとう サイファー";
    text[5077] = "くれぐれも 気をつけな";
    text[5078] = "さっき ルナーフォースの ドローンや 船が たくさん 飛んでるのを 見たからよ";
    text[5079] = "忠告ありがとよ！\nそれなら 今すぐ 出発した方が 良さそうだな";
    text[5080] = "ええ 最寄りの ホバーポートに 行って オシアナスに 出発ね！";
    text[5081] = "ああっ！  2隻の ルナーフォースの 船が 追いかけてきてるわ";
    text[5082] = "ベラ 相手は フォトンブラスターを 搭載してるわよ！";
    text[5083] = "マークスレイヤー！  ベラ・グレイ！";
    text[5084] = "降伏せよ！  さもなくば 撃墜する！";
    text[5085] = "チッ... スピードを 上げて　逃げきろう";
    text[5086] = "ああ ベラ... なんだか 違う方角に 向かってるわよ";
    text[5087] = "わかってるわ  でも あからさまに オシアナスに 向かうことは できない";
    text[5088] = "まずは 追手を 完全に まかないと！";
    text[5089] = "さあ しっかりと 捕まって！  今回は 超スピードで 行くわよ！";
    text[5090] = "どうやら うまく 逃げきれたようね！  よくやったわ ベラ！";
    text[5091] = "エヘヘ どうも";
    text[5093] = "ようし それじゃあ オシアナスに 向かうわよ！";
    text[5095] = "ボコボコに やられはしたが... どうやら 逃げきれたみたいだな";
    text[5096] = "まあ 結果オーライと 言ったところか";
    text[5092] = "ああ もう... うるさいわね！";
    text[5097] = "さてと オシアナスに 着いたけど...";
    text[5098] = "例の 隠れ家は どこなわけ？";
    text[5103] = "ハーモニアリーフだ";
    text[5104] = "ここから東さ";
    text[5105] = "なるほどね それじゃあ 行きましょう！";
    text[5106] = ".@P.@P.";
    text[5157] = "(何か 妙な 感じがするな...)";
    text[5158] = ".@P.@P.";
    text[5159] = ".@P.@P.";
    text[5160] = "(うーむ...)";
    text[5161] = "(少し 慎重に 進んだ方が 良さそうだ)";
    text[5162] = "(すべてが うまくいけば...)";
    text[5163] = "(...まだ希望は あるのだから)";
    text[5164] = "(そうすれば 助けられる かもしれない...)";
    text[5165] = "ねえ ニックル そこで 何してるの？";
    text[5166] = "ああ 悪い";
    text[5167] = "誰も つけてきてないか 辺りを 見回してたのさ";
    text[5168] = "今 行くよ";
    text[5180] = "ここだ";
    text[5181] = "ええ？  どこにも 入り口なんて ないけど...";
    text[5182] = "前にも言ったが オレの隠れ家は ちょっと 変わった 所なのさ";
    text[5183] = "ここの 底には 洞窟がある";
    text[5184] = "つまり 行くには 水に 潜らなくちゃ いけないって ことだ";
    text[5185] = "本気なの！？  そんなことしたら 溺れちゃうじゃない！";
    text[5186] = "ベラ... ワタシ 水に潜っても 大丈夫なのかしら？";
    text[5187] = "ええ！  だって あなたは 防水仕様 なんだから";
    text[5188] = "も もちろん わかってるけどね エヘヘ...";
    text[5189] = "まあ これは 本当に スマートな 隠れ家を 見つけたものね";
    text[5190] = "なるほど 今まで ルナーフォースに 見つからなかった わけだわ";
    text[5191] = "この洞窟には...";
    text[5192] = "...真実がある";
    text[5193] = "だから 知らなくちゃいけない...";
    text[5194] = "お前たちを 信じるぞ";
    text[5195] = "もちろんよ！  ワタシたちだって あなたを 信じてるんだから";
    text[5196] = "あなたは 友達よ\nだから 一緒に 進んでいくの！";
    text[5197] = "そうそう ワタシたちは チームなんだから！";
    text[5198] = "そうだな... よし 行こう";
    text[5199] = "残念だけど そうは させないわよ";
    text[5200] = "ホロフィールド 起動！";
    text[5201] = "つけられていたのか...！？";
    text[5202] = "構えて！";
    text[5203] = "レイン！  メロディー！  ザラ！";
    text[5204] = "どうやら 我らが 天才ちゃんは 本当に 裏切り者 だったようね！";
    text[5205] = "あなたが 裏切っていたなんて 信じられないわ ベラ...";
    text[5206] = "待って... 違うのよ！";
    text[5207] = "そう思われても ムリは ないけど...";
    text[5208] = "...これには 訳があるの！";
    text[5209] = "ベラ 申し訳ないけど あなたは 今 お尋ね者なのよ";
    text[5210] = "おとなしく ついてくる気が ないなら 強制的に そうせざるを 得ないわ";
    text[5211] = "みんな...";
    text[5212] = "ミッションレポートを 受信してから あなたを 必死で 探したわ";
    text[5213] = "もし あなたを 捕まえられるとしたら...";
    text[5214] = "このレイン隊 だけだからね！！";
    text[5215] = "さあ 覚悟しなさい！";
    text[5216] = "ねえ レイン 少し話を...";
    text[5217] = "ダメよ";
    text[5218] = "戦うの";
    text[5219] = "まだ リマッチの約束を 果たして ないんだからね！";
    text[5220] = "...そして マークスレイヤーも ブッ倒すのよ！";
    text[5221] = "まあ どうやら 今回は あの ダッサいマスクは つけて ないようね";
    text[5222] = "チィッ... うるせえ 女どもだな";
    text[5223] = "バックアップを 頼むぜ ベラ";
    text[5224] = "でも... 戦いたくないわ！  この人たちは 友達なのよ！";
    text[5225] = "これからは敵だ\nお前は もう どっちにつくか 選んだんだ";
    text[5226] = "さあ おしゃべりは ここまでよ！  覚悟しなさい！";
    text[5227] = "...";
    text[5228] = "上等だわ  そこまで 言うなら やってやるんだから";
    text[5229] = "ワタシに 勝てると 思ってるなら 甘く見ない方が いいわよ";
    text[5230] = "今回も ボコボコに してあげるんだからね！";
    text[5231] = "へぇーっ！  ついに 裏切り者が 開き直ったわね！";
    text[5232] = "面白い やってやろう じゃないの";
    text[5233] = "ええっと ワタシ... 後ろで 見ててもいい？";
    text[5234] = "この人たちと 戦うのは イヤなの...";
    text[5235] = "じゃあ 座って 見てなさい！  戦う資格が あるのは 真の ヒーローだけよ！";
    text[5236] = "ビビりの アシスタント・ロボは すっこんでるがいいわ";
    text[5237] = ".@P.@P.";
    text[5238] = "なんですって！  ワタシを ブジョクしたわね！  もう怒ったわ！";
    text[5239] = "ベラ！  こいつら ボッコボコに してやりましょ！";
    text[5240] = "ワタシたちは ルナーフォースで 最強の部隊よ";
    text[5241] = "これから その力 とくと 思い知らせて あげるわ！";
    text[5242] = "では レイン隊 いざ出撃！";
    text[5243] = "ううっ... そんな！  負けるだなんて！";
    text[5244] = "いたた...";
    text[5245] = "ぐっ...";
    text[5246] = "まだ やるつもり？";
    text[5247] = "もう これ以上 演技しなくても いいんじゃないの？";
    text[5248] = "な 何ですって？  ふざけてるの？  演技なんかじゃないわよ！";
    text[5249] = "メロディー あなたは あからさまに 攻撃を ためらっていたわ";
    text[5250] = "ザラ あなたも 明らかに 集中していなかった";
    text[5251] = "まるで 思い悩んでいるかの ようだった";
    text[5252] = "...そして レイン... あなたの パンチにも どこか 力が 入っていなかった";
    text[5253] = "それは アンタも 同じでしょ！";
    text[5254] = "ええ？  そうだったのか？  オレは 全力だったんだけどな";
    text[5255] = "ワタシもよ！  だって レインは イジワル なんだもの！";
    text[5256] = "ああ もう どうせ ワタシは イヤなやつよ！";
    text[5257] = "ハァ... アンタの 言うとおり これは 演技よ...";
    text[5258] = "そうなのか？";
    text[5259] = "(やっぱりねぇ...)";
    text[5260] = "もちろん レインは 戦いたかったかも しれないけど...";
    text[5261] = "...あなたは どうかしらね メロディー？";
    text[5262] = "レインが 計画を 立てたのよ\n敵になった フリをしようって...";
    text[5263] = "...あなたは どうなの ザラ？";
    text[5264] = "...ワタシは 新しい技を 試したかったのも あるかも...";
    text[5265] = "おかげで いろいろな アイデアが 湧いたわ";
    text[5266] = "マークスレイヤー... あなたの 動き 見事だったわよ";
    text[5267] = "おう... そりゃ どうも";
    text[5268] = "ん ちょっと 待てよ";
    text[5269] = "お前ら 捕まえに 来たんじゃ なかったのか？";
    text[5270] = "いいえ ライバル関係は おいといて アンタのことが 心配だったのよ ベラ";
    text[5271] = "こういうことを するのには 何か よほどの 訳が あるんだろうって...";
    text[5272] = "それが 何であれ 力に なれるなら そうするわ 友達って 助け合うものでしょ";
    text[5273] = "ああ みんな...";
    text[5281] = "いろいろと イジワルな ことを言って 悪かったわね テトラ...";
    text[5282] = "ただ少し バトルを 盛り上げたかった だけなのよ ガハハハハッ！";
    text[5283] = "フンッ！  まあ 今回だけは 赦してあげるわ！";
    text[5274] = "それで マークスレイヤー...";
    text[5301] = "アンタは 何者なの？";
    text[5302] = "いいやつなの？  ひょっとして ベラに 妙なことを 吹き込んでる わけじゃ ないでしょうね？";
    text[5303] = "アンタの ことだけは しっかりと 見張ってて やるんだからね！";
    text[5278] = "レイン もう少し 言い方ってものが あるでしょ！";
    text[5279] = "ワタシは メロディー！  あなたが ベラの お友達なら ワタシも お友達よ！";
    text[5280] = "ワタシは ザラ よろしく";
    text[5284] = "...ワタシは レイン よく 覚えておくようにね";
    text[5275] = ".@P.@P. .@P.@P. .@P.@P.";
    text[5276] = "大丈夫 この人たちは 信用できるわ  こっちの 味方よ";
    text[5277] = "今まで あなたが 苦しい人生を 過ごしてきたことは わかるわ...";
    text[5304] = "...でもね あなたは 独りじゃないのよ";
    text[5305] = "だから もう一度 人を 信じてみたら どうかしら...？";
    text[5285] = ".@P.@P. .@P.@P. .@P.@P.";
    text[5286] = "ハァ...";
    text[5287] = "オレの名は ニックル";
    text[5288] = "オレが 今 ここに いるのは ベラと テトラの おかげだ";
    text[5306] = "ベラは 自分の身を キケンに 晒してまで オレを 助けてくれた";
    text[5307] = "...真実を 追求するために";
    text[5308] = "正直 イカレてると 思ったぜ\nお互い 知り合いですら ないのに";
    text[5309] = "それで 近づいてきても 何度も 跳ねつけてしまった";
    text[5310] = "それでも なお... オレを 助けてくれた";
    text[5311] = "...オレが 何者であるかを 知っても 受け入れてくれた";
    text[5312] = "そのことは... 本当に 尊敬するぜ";
    text[5313] = "...！";
    text[5314] = "実は どうして 反物質コアを 集めているのか まだ その理由も 説明してねえんだ...";
    text[5315] = "...それに オレが ルナーフォースを 憎んでる 訳もな";
    text[5316] = "...じゃあ それだけの ことしか 明かされて ないのに こいつを 信じて 一緒に いたわけ？";
    text[5317] = "ベラ 彼が 逃げたり 騙したり しないって どうして 確信できたわけ？";
    text[5318] = "......";
    text[5319] = "信頼よ";
    text[5320] = "誰でも 少しは 後ろめたい 過去は 持っているものよ... あまり 誇れないようなね";
    text[5321] = "...でも ワタシは 人は 本質的に 善良な 生き物だって 信じてるの";
    text[5322] = "だから まずは 彼の話を 聞いてみるべきだと 思ったのよ";
    text[5323] = "もし ワタシたちが ルナーの人々を コーダ彗星から 救えるなら...";
    text[5324] = "...いえ 人だけじゃなく マークも...";
    text[5325] = "何とかして 一番いい方法を 探すべきだって";
    text[5326] = "まあ 説得に ずいぶんと 時間は かかったけどね... 何せ この人は ガンコだから";
    text[5327] = "まあな...";
    text[5328] = "隠れ家に 着いたら 全部 説明するよ";
    text[5329] = "ここじゃ まだ 誰かに 見つかるかも しれないしな";
    text[5330] = "そうね それじゃあ 行きましょう！";
    text[5354] = "何をじっと 考えているのですか？";
    text[5355] = "ただ... 未来の ことをな";
    text[5356] = "残された 時間は 少ない";
    text[5357] = "ところで 最新の テストの 結果は どうだった？";
    text[5358] = "失敗でした...";
    text[5359] = "...少なくとも 前回よりは 良かった ですけどね";
    text[5360] = "シンクロ率は？";
    text[5361] = "90％です";
    text[5362] = "...それで いけるだろうか？\nワタシは...";
    text[5363] = "リスクが 高すぎます";
    text[5364] = "100％に してから でないと 安全性が...";
    text[5365] = "引き続き テストを 継続します\nそうでないと あなたは...";
    text[5366] = "サロス！！";
    text[5367] = "おお トーマス そのうち来ると 思っていたぞ";
    text[5368] = "ベラは どこだ？  どこに いるか 言え！";
    text[5369] = "落ち着け トーマス";
    text[5370] = "事前に 同意したじゃないか！\nベラに 危害は 加えないと！";
    text[5371] = "こんな話は 聞いてないぞ！  数百もの 隊員を 出動させて あの子を 狙うだなんて！";
    text[5372] = "落ち着きたまえ トーマス\nすべては 計画通りに 進んでいる";
    text[5373] = "ベラは強い 送り込んだ 兵士たちでは 彼女を 制することは できないだろう";
    text[5374] = "特に マークスレイヤーと 一緒なら 強力な 組み合わせに なるはずだ ";
    text[5375] = "これは 必要な 演出なのだよ\nこれから 起こることに...";
    text[5376] = "説得力を　持たせ...";
    text[5377] = "安心してもらう ためにもな...";
    text[5378] = "そして 我々は 必要なものを 手にする ことだろう";
    text[5379] = "お前の 娘を 守りたい 気持ちは よくわかるぞ トーマス";
    text[5380] = "頼むから ベラに 手荒な マネは しないでおくれ...";
    text[5381] = "大丈夫だ  このミッションが 完了したら ベラを 罪に 問うことは しない";
    text[5382] = "彼女の 安全は このワタシが 保証しよう";
    text[5383] = "ところで ちょうど よかった\nここに 来たならば お前に 見せたいものがある";
    text[5384] = "今 ワタシが 何に 取り組んでいるのか 是非 知ってもらいたくてね";
    text[5385] = "わあ この場所は 何？";
    text[5386] = "何もかも 青いわ！";
    text[5387] = "すっごく キレイ じゃない！";
    text[5388] = "数年前 1人で この辺りを 探検してた時に この遺跡を 見つけたんだ";
    text[5389] = "探検！？  こいつ トレジャーハンターか 何かなわけ？";
    text[5390] = "ええ！  ワタシも 最初は そう言われて 驚いたわ！";
    text[5391] = "まだ 見つかってない ルナーの 古代遺跡が あったなんてね！";
    text[5392] = "多分 ここ以外にも 未発見の 遺跡は あるもんだと 思うぜ";
    text[5393] = "ここの遺跡は 俗に 「古代人」と 称される";
    text[5394] = "文明の民によって 築かれたんだ";
    text[5395] = "彼らは ラックスと 反物質の 両方を 操り";
    text[5396] = "人類が ルナーに やってくる 前の時代に 繁栄した";
    text[5397] = "今から 数千年前の 話だ";
    text[5398] = "そんなに 進んだ 文明なら 今は どうしてるわけ？";
    text[5399] = "その答えは 今まさに 考古学者たちが 探している ところさ";
    text[5400] = "まあいい 歴史の話は この辺にして 先に 進もう";
    text[5401] = "ルミナイト オン  コダイジン セイタイ ソウルデータ ケンシュツ";
    text[5402] = "ラックス ソクテイチ イジョウアリ ガーディアノ ツウシン マチ";
    text[5403] = "ニックル！  これ一体 何なのよ！？";
    text[5404] = "クソッ...";
    text[5405] = "どうやら セキュリティシステムが 作動したらしいな";
    text[5406] = "ガーディア ツウシン ジュシン カンリョウ  タマシイノ シレン カイシ";
    text[5407] = "「魂の試練」？  ワタシたちを 試すつもりなの？";
    text[5408] = "ここは ひょっとしたら 昔の兵士たちの トレーニング場 だったのかも しれないな";
    text[5409] = "まだ 作動するとは 思わなかったが";
    text[5410] = "今まで オレが ここに来て セキュリティが 動いたことなんて なかったからな";
    text[5411] = "まあいい どちらにせよ ブッ倒すぜ！";
    text[5413] = "ああ 手強かったわね...";
    text[5414] = "それにしても どうして セキュリティシステムが 作動したのかしら？";
    text[5415] = "と言うよりも... 「誰が」 作動させたか だな";
    text[5416] = "オレが思うに そこの 「天才さん」 とやらは 古代人と 何らかの つながりが あるようだ";
    text[5417] = "ああ もう アンタまで！  その呼び方は やめてって 言ってるでしょ！";
    text[5418] = "ガッハッハッハ！\nアンタ ちょっと 見直したわよ！";
    text[5419] = "ん 待って... ということは ベラは...";
    text[5420] = "...古代人の 血を 引いてるってこと？";
    text[5421] = "かもな...";
    text[5422] = "なるほど... それなら ワタシの ラックスを 操る能力にも 説明がつくわね...";
    text[5423] = "...そして 時々感じる あの 変な感覚も...";
    text[5489] = "古代人の 血が 流れてるなら...";
    text[5490] = "そうなると ママも その流れを くんでるって ことに なるわね";
    text[5491] = "でも どうして こういうことを あの人は 黙っていたのかしら...？";
    text[5424] = "もう少し 古代人について いろいろと 知る必要が ありそうね";
    text[5425] = "なら ここにある 像や 古代文字を 思う存分 調べてみたらいい";
    text[5426] = "オレも 残された 遺物から 古代人の ことを いろいろと 学んだんだ";
    text[5427] = "おいおい... でっかい ゲートに 塞がれてるぜ";
    text[5428] = "何か模様が 彫られているわね！";
    text[5429] = "「4つの宝石が ソウルセンサーの 道を 開くべし」";
    text[5430] = "つまり このゲートを 開けるには 4つの 特別な宝石を 見つけろってことね";
    text[5431] = "どうやら 「魂の試練」 ってやつは どうしても 避けて通れない みたいだな";
    text[5492] = "それで 思い出した... 例のロボットは 何か名前を 言ってたわよね...";
    text[5493] = "確か... 「ガーディア」 だっけ？";
    text[5494] = "この遺跡の中に そのリーダーが いるなら";
    text[5495] = "一度 話を してみたいものね";
    text[5496] = "そうしたら ラックスの 使い方について もう少し 学べるかも...";
    text[5497] = "そうだな じゃあ 行こう";
    text[5498] = "ああ すまない... 話を 遮る 気は ないんだが 早く 進みたくてな...";
    text[5499] = "...な なんだ その目は？";
    text[5500] = "別に～... さて それじゃあ 4つの宝石を 探しに 行きましょう！";
    text[5530] = "この遺跡は さらに下にも フロアがある";
    text[5531] = "カギになる 宝石は そこに あるかもしれない";
    text[5532] = "ただし 行くなら それなりに 覚悟を 決めることだな";
    text[5533] = "...一旦 入ったら しばらくは 戻れない だろうから";
    text[5510] = "我らの 文字を 読む 旅人へ...";
    text[5511] = "我らの 英知を 伝えんとす...";
    text[5512] = "我らの 未来は 未だ 定まらず...";
    text[5513] = "我ら しくじるも そなたが やり遂げることを 願わんとす...";
    text[5514] = "待てよ... こんなの 読んだ 覚えはないぞ";
    text[5515] = "石板が 変化したって いうのか？\nそんな バカな...";
    text[5516] = "ひょっとしたら 古代人の 血を引く人が 訪れたら";
    text[5517] = "特定の文字が 現れるように なってるとか？";
    text[5518] = "だとしたら すごいな！";
    text[5519] = "それはつまり...";
    text[5520] = "人類が集め 保存してきた すべての 古文書には";
    text[5521] = "思っていたよりも 多くのヒミツが 綴られているって ことだ";
    text[5522] = "だとしたら 世紀の 大発見だな！";
    text[5523] = "他の 石板も 調べてみよう";
    text[5524] = "ウフフッ あなた 根っからの 冒険好きなのねえ...";
    text[5525] = "こいつが こんなに はしゃいでるの 見たことないわ";
    text[5526] = "なんだか タフガイを 気取ってるけど 中身は 案外 オタクなのかしらね？";
    text[5527] = "おい お前ら！\n何を ヒソヒソ言ってんだ？";
    text[5528] = "何でもないわよ～！";
    text[5529] = "ええ 何でもないわよ～！";
    text[5592] = "古代の 冒険者の 像だ";
    text[5593] = "その胸には 宝石が 埋め込まれている";
    text[5594] = "宝石に そっと ふれると... うっすらと 消えた！";
    text[5595] = "そして 辺りに 声が 響き渡る...";
    text[5596] = "残りの 宝石は 3つ";
    text[5597] = "残りの 宝石は 2つ";
    text[5598] = "残りの 宝石は 1つ";
    text[5599] = "よくぞやった ソウルセンサーよ";
    text[5600] = "上の階に 戻るがよい\n待っているぞ";
    text[5442] = "ヨクゾヤッタ ソウルセンサーヨ";
    text[5443] = "うわっ 何コイツ デカッ！！";
    text[5444] = "あなたは 何者なの？";
    text[5445] = "ワガナハ ガーディア";
    text[5446] = "コノ イセキヲ エイキュウニ マモリシ モノナリ";
    text[5447] = "ガーディア ここに 昔 住んでいた 古代人について いろいろと 教えてくれないかしら？";
    text[5448] = "彼らは その後 どうなったわけ？";
    text[5449] = "カイトウ フカ ソノヨウナ ジョウホウハ ワガ データベースニ アラズ";
    text[5601] = "...ベラ・グレイヨ";
    text[5602] = "ええっ！？  どうして ワタシの 名前を？";
    text[5603] = "ワレノ ノウリョクハ ニンゲンノ ラックスカラ ジョウホウヲ ヒキダスコト";
    text[5604] = "ソシテ アクセスシタ ケッカ ナンジハ キョウイデハ ナイト ハンメイシタ";
    text[5605] = "ああ なら良かった 危うく 戦うハメに なるかと 思ったもの";
    text[5606] = "シカシ！";
    text[5627] = "ヒィィィィ！";
    text[5607] = "ナンジノ ラックス レベルハ... イジョウナリ";
    text[5608] = "異常！？  どういうことよ？";
    text[5609] = "ワガ データベースヲ シラベテモ コノヨウナ レベルハ キロクニ アラズ";
    text[5610] = "サラニ ソレハ トクテイノ ジョウタイニ アリ";
    text[5611] = "ナンジノ ラックスヲ アヤツル ノウリョクハ ゲンザイ セイゲン サレテ イル";
    text[5612] = "ナンジノ タマシイハ カンゼンニハ キノウ シテイナイ";
    text[5613] = "なら ガーディア！  能力を 完全に 使えるようにするには どうしたらいいの？";
    text[5614] = "...ソウルセンスについて 教えて！";
    text[5628] = "ワレハ スウヒャクネン ネムリノ ナカニ アッタ";
    text[5629] = "ワガ エネルギーハ コカツ シツツ アル...";
    text[5630] = "モハヤ ナンジヲ キタエル コトハ デキヌ... シカシ...";
    text[5616] = "ナンジノ タマシイヲ カクセイ サセル キッカケハ アタエラレル";
    text[5617] = "ソレヲ モノニ スルカハ... ナンジ シダイ ナリ";
    text[5618] = "ラックスノ チカラハ... タマシイノ アラワレ ナリ...";
    text[5619] = "ソレガ カクセイ スルトキ セイギョ スルノハ モハヤ ヨウイ デハナイ";
    text[5620] = "できるわ！\nゼッタイに ものに してみせる！";
    text[5621] = "ルナーを 守るためなら 何だって するんから！";
    text[5622] = "ワタシは 強くなりたい... ルナーを 守れる 存在に なりたいの...";
    text[5623] = "みんなを 励まして... 希望を 与えられるように...";
    text[5624] = "ナンジハ ツヨキ タマシイナリ";
    text[5625] = "シカシ ソレト トモニ セイシント ニクタイモ ツヨク ナケレバ ナラヌ";
    text[5626] = "ユエニ ソナタノ ツヨサヲ タメス ヒツヨウアリ";
    text[5631] = "コレガ タマシイノ シレンノ サイシュウ シケン ナリ";
    text[5632] = "ガーディア バトルモード オン！";
    text[5461] = "ナンジ タマシイノ シレンヲ ノリコエタリ";
    text[5462] = "コレヨリ ナンジノ タマシイノ カセヲ トリサリタリ";
    text[5463] = "ワガ エネルギーハ ツキカケテイル... デハ サラバダ カクセイセシ モノヨ...";
    text[5464] = "ラックスノ カガヤキヨ...";
    text[5465] = "エイエン... ナレ";
    text[5466] = "ベラ 大丈夫？  うまくいった？";
    text[5467] = "何だか... 力が 溢れてくるのを 感じるわ";
    text[5468] = "すごく いい感じよ！";
    text[5480] = "ベラの ラックスが 覚醒した！";
    text[5481] = "ラックスコンボ 「オーバードライブ」が 使えるようになった！";
    text[5634] = "今日は 本当に いろいろと 信じられない ものを 見たわ";
    text[5652] = "ええ 古代文明 ソウルセンサー ラックス... 頭が 痛くなりそうよ！";
    text[5635] = "ソウルセンサーの 力って そんなに バトルで 役に立つの かしら...";
    text[5636] = "ちょっと スパーリングで 見せてほしいものね！  ガーハッハッハ！";
    text[5637] = "それで ソウルセンサーの 力で 何をする つもりなの？";
    text[5638] = "マークとの 平和を 実現するために 彼らと コミュニケーションが 取れたらと 思っているわ";
    text[5639] = "ええ それ マジ！？";
    text[5640] = "あなたは 本当に マークと 戦うのが イヤなのね";
    text[5642] = "もう あなたたちも それは 知ってるでしょ...";
    text[5643] = "まあ そうだけど...";
    text[5644] = "マークたちが 罪なき 一般市民に";
    text[5645] = "危害を 加えているのは 事実でしょ？";
    text[5646] = "それは もちろん そうだけど...";
    text[5647] = "ベラは 間違ってないぜ";
    text[5648] = "マークは ただの 化け物じゃない";
    text[5649] = "というより みんなが 思っているような ものじゃないんだ...";
    text[5650] = "さあ 奥の部屋に 行こう";
    text[5651] = "自分の目で 見れば 真実が わかるはずだ...";
    text[5673] = "これが...";
    text[5674] = "...今まで オレが 集めた 反物質コアだ";
    text[5675] = "本当に いっぱいね！";
    text[5676] = "一体 何年かけて いくつ 集めたわけ？";
    text[5677] = "自分でも わからないな\n数百... いや 数千か";
    text[5678] = "ベラから コーダ彗星の 件について 聞いた？";
    text[5679] = "ああ ルナーフォースが こいつを 使って セレスティアとかいう";
    text[5680] = "ワームホールマシンを 動かしたいのは 知っているよ";
    text[5681] = "...で 人類が 滅亡の 危機に あるのを 知ってるのに";
    text[5682] = "反物質コアを 使うことは 許さないって？";
    text[5683] = "ちょうど 同じことを ワタシも コペルニクスで 考えたわ...";
    text[5747] = "あなたは 自分の 目的が 正義のためと 言ったけど...";
    text[5794] = "未だに その意味が わからないの";
    text[5795] = "ニックル...";
    text[5796] = "あなたは いろいろと 一人で 抱え込みすぎているわ...";
    text[5746] = "...そして それが あなたに 大きな 負担に なっている";
    text[5748] = "あなたを 助けたいの... 友達として";
    text[5749] = "ワタシたちもよ！  でしょ みんな？";
    text[5797] = "ええ！";
    text[5798] = "もちろんよ！";
    text[5750] = "あったり前でしょ！";
    text[5686] = "ニックル そろそろ 本当のことを 話す時が 来たんじゃなくって？";
    text[5745] = "一体 ここで 何が 起きているの？";
    text[5687] = "...では まず 質問させてくれ\nそもそも 反物質コアとは 何だ？";
    text[5688] = "ええっと... 反物質コアは 反物質の 安定した 供給源... とかじゃないの？";
    text[5689] = "その説明じゃ 半分だけだな";
    text[5690] = "反物質コアは 反物質と ラックスから 成っており その核は...";
    text[5691] = "...魂だ";
    text[5692] = "ああ そう言われて ピンときたわ！";
    text[5695] = "反物質コアが 光ってる！";
    text[5696] = "ベラ！  な... 何をしたわけ？";
    text[5697] = "ソウルセンサー... だんだんと その意味が わかってきたわ";
    text[5698] = "魂の 中身が 見える様子を イメージするのよ";
    text[5699] = "そして 語りかけるの";
    text[5700] = "何か 聞こえるのか？";
    text[5701] = "いいえ ここにある 反物質コアは 何も 言ってくれないわ";
    text[5702] = "でもね 妙なことに...";
    text[5703] = "魂の中にある 感情は 感じることが できるの...";
    text[5704] = "痛み... 苦しみ... 怒り... 裏切り... 悲しみ... 嘆き...";
    text[5705] = "反物質コアに 閉じ込められた マークの魂...";
    text[5799] = "うまくいくか わからないけど... ちょっと やらせて...";
    text[5706] = "そんな...";
    text[5708] = "こんなの... ありえない...";
    text[5710] = "魂の中に あるのは...";
    text[5709] = "まさか...";
    text[5712] = "そう それが 真実だ";
    text[5713] = "マークの 正体は 人間さ";
    text[5715] = "...！";
    text[5711] = "ど... どういうこと？";
    text[5716] = "そんな...";
    text[5717] = "じゃあ 今まで ワタシたちが 戦ってきたのも 人間だったって ことなのね...";
    text[5718] = "マークは 人体実験の 結果 生まれたんだ";
    text[5719] = "実験？  誰が そんなことを？";
    text[5720] = "お前たちが ルナーの 英雄と 呼んでいる サロスだよ";
    text[5721] = "そんな... ありえないわ！";
    text[5722] = "罪なき 人たちの 命を 奪ったって 言うの？";
    text[5723] = "どうして そんな ひどいことを？";
    text[5724] = "サロスは 反物質こそが 人類を救う カギだと 信じている";
    text[5725] = "人々は あの男を 伝説の英雄と みなしているが";
    text[5726] = "その仮面の 下にある 本当の 素顔は...";
    text[5728] = "反物質の 力を 求めて 狂気に 走った 科学者なのさ...";
    text[5800] = "あいつは オレの力を 認めるや否や";
    text[5801] = "マーク血清の 開発に 使おうとした";
    text[5802] = "その血清を 人間に 与えると 分子の組成を 変化させるんだ";
    text[5803] = "そして 物質の体が 反物質へと 変わる";
    text[5805] = "何年も前に オレから 抽出した 反物質は";
    text[5806] = "完全な マーク血清を 作るための 実験を するのに 十分だった";
    text[5807] = "ただ 実験が 失敗するたびに... マークが 生まれた";
    text[5808] = "人としての 存在を失い... 反物質に 取り込まれた 末にな";
    text[5814] = "オレに サロスを 倒すだけの 力はなかった...";
    text[5809] = "だから あいつの 手持ちの 反物質が なくなることを 望んでいた  でも... ";
    text[5813] = "あいつも また 巧妙な システムを 作った";
    text[5815] = "生まれた マークを その場で 殺し 反物質コアを 抽出し";
    text[5816] = "次のテストに 再利用したのさ";
    text[5817] = "ただ それでも 多くの マークは 誕生した 直後に ワームホールに 逃げてしまう";
    text[5818] = "だから 逃げたマークを 狩り 反物質コアを 手に入れるために やつは 軍を 訓練した";
    text[5755] = "どこまでも 腐った野郎だ";
    text[5821] = "どうして そんな ひどいことが できるの...？";
    text[5822] = "あの人は... 人の命を 何だと 思っているの？";
    text[5823] = "今まで ワタシたちを 鍛え... 導いてくれたのに...";
    text[5824] = "リーダーとして 尊敬し... 師匠のように 慕ってきたのに...";
    text[5825] = "...すべては ウソだったわけ？";
    text[5826] = "そういえば カフェの 張り紙に 名前が 書かれてた 人たち... ";
    text[5827] = "あれも サロスの 仕業なのかしら？";
    text[5828] = "おそらくな";
    text[5735] = "サロスは 何年にも渡り 影で いろいろな 人間を 捕まえていた";
    text[5736] = "まずは... 軍事基地にいる 囚人たちを 実験台にし";
    text[5737] = "それを 使い切ると 別の 手段に 手を 出した";
    text[5739] = "市民の 行方不明件数 死亡件数の 増加とともに";
    text[5829] = "ルナーで マークの 出現が 急増したのは 偶然じゃない";
    text[5752] = "おそらくは 少数の兵士が サロスに 影で命令され やむを得ず 誘拐を 行ったんだろう...";
    text[5753] = "さもなくば 自分が 実験台に されてしまう だろうからな";
    text[5754] = "ただ すべてが 完成した 暁には どのみち そいつらも 同じ 運命を 辿るんだろうが...";
    text[5830] = "ひどすぎて 人間の 所業とは 思えないわね...";
    text[5831] = "それが 己のヒミツを 守る 唯一の 方法なのさ";
    text[5841] = "でも どうして あの人が そんなことを するのか 未だに わからないわ... 何か 訳があるんじゃ...";
    text[5842] = "それが 何であれ 許される ことじゃないわ";
    text[5832] = "で 今 言ったようなこと 誰かに 話したわけ？";
    text[5834] = "ああ お前らが 初めて じゃないさ...";
    text[5835] = "今までも 何人かの 仲間たちと 力を合わせ 戦ってきた...";
    text[5836] = "逃げたマークが サロスの手に 渡らないように 狩ったりもした";
    text[5837] = "でも いつも 負けた...";
    text[5838] = "そして すべての 仲間を 失い... 全員 マークに されてしまった...";
    text[5839] = "サロスが オレを 殺さなかった 唯一の理由は 反物質の 研究対象に するためだ";
    text[5844] = "だから オレは... 一人で 戦うことにしたんだ";
    text[5845] = "オレの 近くにいれば... 命が キケンに 晒されるなんて わかりきってる からな...";
    text[5846] = "それで 人と 距離を 置くように なった...";
    text[5847] = "...大切な人を 失う 苦しみを 二度と 味わわずに すむように";
    text[5848] = "もっとも 今でも 時々 感じることは あるが...";
    text[5849] = "...少しでも 強くあろうと 努力しているよ";
    text[5850] = "だから 今までの 振る舞いについては どうか 赦してほしい";
    text[5851] = "すまなかった...";
    text[5852] = "ニックル...";
    text[5853] = "もう やめてよ！\n泣かせるようなこと 言わないで...";
    text[5854] = "アンタ いろんなことが あったのねえ...";
    text[5855] = "謝らなくちゃ いけないのは こっちの方よ";
    text[5856] = "あなたのことを 誤解していたわ...";
    text[5857] = "...みんな ありがとう";
    text[5858] = "ここから先は 一人では 戦えない";
    text[5864] = "逃げるのは ここまでに しなくては...";
    text[5865] = "そして サロスと 正面から 対決し... 決着を つけるんだ";
    text[5859] = "それは ビッグな 決断ね  何が アンタの 中で そんなに 変化したってわけ？";
    text[5860] = "希望さ";
    text[5866] = "お前たちが 希望を くれた";
    text[5867] = "そりゃあ あったり前でしょ！";
    text[5869] = "ええ みんなで 力を 合わせて 戦うのよ！";
    text[5870] = "それで... ここから どうするの？";
    text[5871] = "具体的なことは まだ 何も 考えてねえな...";
    text[5872] = "ええ？  アンタ ここまで いろいろ ぶっちゃけて おいて";
    text[5873] = "「考えとか ないけど とりあえず かんばろうぜ」って！？";
    text[5874] = "まあ 少しは 大目に 見てくれよ";
    text[5875] = "オレは 何年もの間 サロスに 反物質コアを 渡さないように がんばってきたんだ";
    text[5876] = "ただ... コアを ここに 置いている 理由は それだけじゃない";
    text[5763] = "この人たちは 不幸にも こんな ひどい目に 遭わされたんだ";
    text[5761] = "だから いつの日か 元に戻す 方法を 見つけてあげたい...";
    text[5762] = "ええ？  そんなこと できるわけ？";
    text[5877] = "ウーン...";
    text[5878] = "ひょっとしたら パパが どうにか してくれるかもね！";
    text[5879] = "サロスの マーク血清さえ 手に入れたら...";
    text[5880] = "パパが その仕組みを 解き明かしてくれるかも！";
    text[5881] = "反物質コアに ついては どうなの？\n血清は 反物質コアには 何か 作用するわけ？";
    text[5882] = "それは やってみなくちゃ わからないわ！";
    text[5883] = "でも コーダ彗星は どうするの？";
    text[5884] = "アレが こっちに 向かってくるまでは まだ 1年あるわ";
    text[5885] = "今 一番に 考えるべきは サロスの 暴走を 止めることよ！";
    text[5886] = "時が 経つほど 実験の 犠牲に なる人も 増えるわ...";
    text[5887] = "どうしたらいいか 考えないと...";
    text[5891] = "一旦 ルナー宇宙ステーションに 戻って 話し合いましょう";
    text[5892] = "でも... 行っても 大丈夫なのか？";
    text[5893] = "ルナーフォースは オレたちを 探してるんじゃ...";
    text[5894] = "大丈夫よ\nどうにもなったり しないわ";
    text[5895] = "宇宙ステーションの みんなは 家族みたいなものよ  ワタシは そこで 生まれ育ったんだから！";
    text[5896] = "それに サロスを 倒すには 多くの人の 協力がいるわ";
    text[5888] = "これ以上 他人を 巻き込むことが いい考えだとは 思えないんだがな...";
    text[5898] = "ニックル ワタシを 信じて\nゼッタイに うまくいくわ";
    text[5899] = "......";
    text[5778] = "わかった 信じるよ";
    text[5779] = "それじゃあ 次の 目的地は ルナー宇宙ステーションね！";
    text[6003] = "サロスを 止めるための 作戦を 考えないと！";
    text[6075] = "そんな...！";
    text[6076] = "ワタシの 船だわ！";
    text[6077] = "びっくりしたでしょ～？";
    text[6078] = "あなたを 探していた時 放置されていた この船を 見つけたのよ";
    text[6079] = "回収して あなたに 返してあげるのが 一番だという 話になってね";
    text[6080] = "みんな... 本当に ありがとう！";
    text[6081] = "ウェヘヘー！  ベラだぁ！";
    text[6082] = "ベラ！  無事で 良かったわ...\n本当に 心配したのよ！";
    text[6083] = "しかも... お客さんまで 連れてくるとはね！";
    text[6084] = "どうも ニックルだ";
    text[6085] = "いやあ 会えて うれしいよ ニックル！  ウェヘー！";
    text[6722] = "アンタらは... オレたちを 引き渡すつもりは ないんだな？";
    text[6723] = "どうして そんなこと するって いうんだい ウェヘー？";
    text[6724] = "そんなこと するわけないわ\nワタシたちは 皆 家族なんだから";
    text[6086] = "家族と 言えば... ナイラさん パパは？";
    text[6087] = "トーマス博士なら 軍事基地に 行ったんじゃないかと 思うけど...";
    text[6088] = "ああ しまった... すっかり 忘れてたわ！";
    text[6089] = "ベラ... アンタの お父さんは...";
    text[6090] = "あなたを 捕まえるように ミッションが 発令された時";
    text[6091] = "叫びながら 研究所を 飛び出して サロスの所に 向かったのよ";
    text[6092] = "ええっ！？  なら... パパの身が 危ないわ！";
    text[6093] = "ちょっと 連絡してみる！";
    text[7125] = "@P.@P.@P.@P.@P.@P.";
    text[6094] = "...応答が ないわ...";
    text[6095] = "ちょっと待った... キミたちは 一体 何を 話しているんだ？  ウェヘー？";
    text[6096] = "トーマス博士が 危ないって？";
    text[6097] = "ニックル...";
    text[6098] = "...言いな\n今こそ 真実を 言うべき 時だぜ";
    text[6099] = "そんな... ひどすぎるわ...";
    text[6100] = "サロスは何年も ワタシたちを 欺いてきたのね...";
    text[6101] = "今  言ったのが 本当なら... 許されることじゃないな！  ウェヘー！";
    text[6102] = "...だからこそ 今すぐ パパを 助けに 行かないと！";
    text[6103] = "もしサロスが...";
    text[6104] = "ベラ 待ちなさい";
    text[6105] = "まずは 冷静に 状況を 判断するのよ";
    text[6106] = "サロスが あなたの お父さんに 危害を 加える つもりかは わからないわ";
    text[6107] = "アンタが 知ってる サロスは 全部 まがい物だよ";
    text[6108] = "やつは キケンな男だ...";
    text[6109] = "でも セレスティア計画の 責任者が トーマス博士 なんだけど？";
    text[6110] = "そんな 貴重な人材に 危害を 加えたりは しないんじゃ...";
    text[6111] = "別に 彼を 心配してない わけじゃないわ";
    text[6112] = "でも 一番大切なのは しっかりとした 計画を 立てることよ";
    text[6113] = "あなたの お父さんを 安全に 救出し";
    text[6114] = "サロスの 犯罪を 明らかにして 逮捕するためのね";
    text[6116] = "このミッションの リーダーは ワタシに やらせて";
    text[6117] = "これを 成功させるには 仲間が 必要よ";
    text[6118] = "宇宙ステーションにいる すべての 兵士と 科学者に 招集を かけて";
    text[6119] = "わかったわ！";
    text[6125] = "...話は これで 全部よ";
    text[6126] = "マークの 真実...";
    text[6127] = "...そして サロスが 影で ひそかに 推し進めてきたこと...";
    text[6128] = "...あの人が マークスレイヤーと ワタシを 捕らえようとした 理由...";
    text[6120] = "ここにいる お友達と 隊員の みんな...";
    text[6121] = "今日 ここに 呼んだのは...";
    text[6122] = "...同じ 大義の下で 戦うためよ";
    text[6129] = "すべての 真実が 明らかに なったからには...";
    text[6130] = "...今 起きている 過ちを 正さなくちゃ いけないの！";
    text[6131] = "多くの仲間が マークによって 殺された...";
    text[6132] = "多くの市民が 大切な家族を 失った...";
    text[6133] = "そして 最近 ルナーで起こる 数々の 失踪事件...";
    text[6134] = "こうしたことの 裏に... サロス将軍が いたと？";
    text[6135] = "あまりにも ショッキングで 理解が 追いつかないのは わかるわ";
    text[6136] = "ルナーの人々は まだ コーダ彗星の 存在すら 知らない";
    text[6137] = "ここにいる みんなは ルナーに 明るい未来を 残すために";
    text[6138] = "本当に がんばっていると 思う";
    text[6139] = "その上に マークの 問題まで あるんだから...";
    text[6140] = "でもね... マークだって 元は 人間だったのよ";
    text[6141] = "ただ 変えられてしまったの";
    text[6142] = "もし 人々が マークと コーダ彗星の 真実に 気づいたら";
    text[6143] = "ルナーフォースの 信頼は 地に落ちるわ...";
    text[6144] = "そして きっと 希望まで なくしてしまうでしょう...";
    text[6145] = "でも そうは させない！";
    text[6146] = "サロスの 暴走を ここで 止めてみせるのよ！";
    text[6147] = "だから...";
    text[6148] = "あなたたちも 一緒に戦って！";
    text[6149] = "グレイ将軍！";
    text[6150] = "我々は あなたに ついて行きます！";
    text[6151] = "しょ... 将軍！？  ワタシが？";
    text[6152] = "すべてが 明かされた 今...";
    text[6153] = "サロスは もう 我々の 将軍ではない";
    text[6154] = "人命を... ルナーの 人々を 軽んじる男に";
    text[6155] = "従ったりは しません！";
    text[6156] = "他の部隊の 者たちも きっと 同じことを 言うでしょう";
    text[6157] = "グレイ将軍 我々は あなたを信じます";
    text[6158] = "トーマス博士 前任の シア将軍 そして グレイ将軍...";
    text[6159] = "あなたの家族は いつでも 皆を 勇気づけてくれた...";
    text[6160] = "人類の未来に 希望が 持てるように！";
    text[6161] = "トーマス博士を 救い サロスを 止める\n今 すべきことは 明らかです";
    text[6162] = "みんな...";
    text[6163] = "ありがとう...";
    text[6164] = "さあ～て... そうと 決まったら サロスを ブッ倒してやるわよ！  ガッハッハ！";
    text[6165] = "うおおおおお！";
    text[6166] = "戦える人は バトルギアを 準備して";
    text[6167] = "明日 軍事基地へ 出発よ！";
    text[6168] = "科学者と エンジニアの 皆さん";
    text[6169] = "ワタシたちの 戦いも ここからよ...";
    text[6170] = "サロスの マーク血清を 手に入れたら";
    text[6171] = "リバースエンジニアリングで";
    text[6172] = "...被害者を 元に戻す 方法を 研究するの";
    text[6173] = "任せてください！";
    text[6174] = "科学の 名の下に 我々は 勝利します！";
    text[6175] = "少しも 心配は いりませんよ ナイラさん！";
    text[6176] = "人類の未来は 明日の ワタシたちに かかっているわ！";
    text[6177] = "ワタシは ルナーの みんなを 守る！";
    text[6178] = "...そして サロスの手で マークに 変えられた 人たちを 助けるの！";
    text[6179] = "...そして サロスを 倒し 被害者の 無念を 晴らし...";
    text[6180] = "...すべてを 解決したら...";
    text[6181] = "コーダ彗星を 止める方法を 探すのよ...";
    text[6182] = "...ルナーフォースの みんなで 力を 合わせてね！";
    text[6183] = "ラックスの輝きよ 永遠なれ！";
    text[6184] = "うおおおおお！";
    text[6185] = "いやあ すごかったぜ！";
    text[6186] = "その場にいた 人の心を 見事に まとめ上げたな！";
    text[6187] = "ああ...";
    text[6188] = "緊張したわ！  無事に 終わって よかった...";
    text[6189] = "あんなに 大勢の前で スピーチしたことなんか なかったから...";
    text[6190] = "ママは すごく 簡単そうに やってたのに...！";
    text[6191] = "あれだけ やれたら 十分よ！";
    text[6192] = "ウェヘー！  ボクも すんごく 驚いたよ！";
    text[6193] = "で グレイ将軍ねえ...";
    text[6194] = "なかなか いい響きじゃない";
    text[6195] = "天才ちゃんには ぴったりの称号よ";
    text[6196] = "ああ もう！  何回...";
    text[6197] = "さて 明日に 備えて 休むとしよう";
    text[6198] = "ものすごく長い 一日だったからな...";
    text[6199] = "そうねえ...";
    text[6200] = "じゃあ みんな 今夜は ぐっすりと 眠るとしましょう！  ガッハッハ！";
    text[6201] = "どうして レインは いつも あんなに 元気なんだ？";
    text[6202] = "さあねえ...";
    text[6203] = "それが 彼女なりの ストレスへの 対処法 なんじゃないかしら";
    text[6204] = "心の底では 結構 緊張してるのかも しれないわ...";
    text[6205] = "...ワタシは そうだし";
    text[6206] = "...ワタシもよ";
    text[6207] = "(パパは 無事かしら...)";
    text[6208] = "さて それじゃあ みんな！  明日 また 集まるわよ";
    text[6229] = "目標: 自分の 部屋で 休みましょう";
    text[6050] = "...オカシイ";
    text[6051] = "コレハ ソウルセンサーガ ワタシヲ メザメサセテカラ";
    text[6052] = "ケンシュツシタ 2バンメノ セイメイタイダ";
    text[6053] = "...？";
    text[6054] = "たす... けて....";
    text[6055] = "...おねが... たす....";
    text[6056] = "...あの人たち...";
    text[6057] = "...ワタシが...";
    text[6058] = "...いるの";
    text[6059] = "コレハ キョウミブカイ...！";
    text[6060] = "コノ タマシイハ...";
    text[6061] = "...！";
    text[6062] = "ナルホド...";
    text[6063] = "ドウスレバ イイカ ワカッタ";
    text[6064] = "モウ ワタシニ ノコサレタ ジカンハ スクナイ...";
    text[6065] = "ナンジニ キョウリョク シヨウ";
    text[6066] = "コノミニ ノコサレタ チカラヲ フリシボリ...";
    text[6067] = "ワガ ウツワヲ アタエヨウ";
    text[6068] = "イクガ ヨイ...";
    text[6069] = "...クロノスヨ";
    text[6230] = "何が あったの？  あなたは 今の爆発 聞いた？";
    text[6231] = "ベラ 大変よ！  マークが 宇宙ステーションを 攻撃しているわ！";
    text[6232] = "そんな... これも まさか サロスの 仕業なの...？";
    text[6233] = "ああ もう 今回の マークどもは ヤバイわ！";
    text[6234] = "今までのより ずっと 狂暴よ！";
    text[6235] = "まずは ステーションの 人たちを 守らないと！";
    text[6236] = "今 そうしてるところよ！";
    text[6237] = "ベラ 1階と 2階は こっちに 任せて";
    text[6238] = "そっちは 3階を 頼むわ！";
    text[6239] = "わかったわ！";
    text[6240] = "目標: 3階にいる マークを 見つけ出して 倒しましょう！";
    text[6241] = "このマークは ワタシたちに 任せて！";
    text[6242] = "ありがとうございます グレイ将軍！";
    text[6243] = "気をつけて くださいね！";
    text[6246] = "大丈夫よ 任せて！";
    text[7138] = "バックアップの 到着よ！  科学者たちを 安全な場所に 避難させて！";
    text[7139] = "了解！";
    text[6268] = "よくやったわね！  どうやら すべての マークを 倒したみたいよ";
    text[6269] = "みんな 怖がっていたけど 怪我人は いなかった みたいで 何よりだわ";
    text[6270] = "それは 良かった...";
    text[6271] = "それでは 第2ラウンドと いくのは いかがかな？";
    text[6272] = "サロス！？";
    text[6273] = "ワームホールを 開いただと！？";
    text[6274] = "驚いたかね？  作り方を 学ぶのに ずいぶんと 時間が かかったが... ハッハッハ";
    text[6275] = "何年もかけて 行った 数々の 実験...";
    text[6276] = "...これまでに 使用した すべての 被検体...";
    text[6277] = "...このワタシとて 例外ではない";
    text[6278] = "見ての通り 自分自身までも 実験に 使ったのだからな";
    text[6279] = "この力... 反物質の力は 本当に 素晴らしいものだ";
    text[6280] = "ただ この技は まだ 試してなくてね... どれ 1つ 実験してみよう";
    text[6281] = "あああああっ！  何これ！？  動けないわ！";
    text[6282] = "サロス！  やめなさい！  何てことするの！";
    text[6283] = "お前が 真実を 暴こうと していた時...";
    text[6284] = "...いずれ こうなるのは わかっていた";
    text[6285] = "マーク・スレイヤーが 関わるとなれば なおさらな...";
    text[6286] = "だが... 真実を 知ることは 半分でしかない";
    text[6287] = "それを 解するか どうかは... また 別のことだ";
    text[6288] = "サロス どうして こんなことを？";
    text[6289] = "人の命なんて あなたには どうでも いいわけ？";
    text[6290] = "すべては... 人類の 進化のためだ";
    text[6291] = "その目的は...";
    text[6292] = "これからの 数世紀を 人類が 生き延びられるように するためだ";
    text[6293] = "この偽善者が！";
    text[6294] = "お前は たくさんの 罪なき人を 殺した！";
    text[6295] = "...お前が守ると 言っている まさに その人々をな！";
    text[6296] = "進歩を 得るために 小さな 犠牲は 避けられんのだよ";
    text[6297] = "別に 自分の考えを 理解してもらおうとは 思わん ";
    text[6298] = "それに 正直なところ いちいち 説明している 時間も ないしな";
    text[6299] = "なら どうして ここに 来たわけ？";
    text[6300] = "お前の 卑小な 反乱を 潰すためだ";
    text[6301] = "未来を... お前のような 愚か者の 理想論に 委ねるわけには いかんからだ";
    text[6302] = "間違っているのは あなたよ！  どのみち 戦わずして あなたに 屈したりはしないわ";
    text[6303] = "いいや お前は ここに 留まるのだ";
    text[6304] = "それとも 父親の身に 何かあっても いいのか？";
    text[6305] = "パパの 身に！？  パパは どこなの？";
    text[6306] = "あの人に 何したわけ！？";
    text[6307] = "何も";
    text[6308] = "まあ... 反物質コアの ありかを 言わないならば 話は 別だがな";
    text[6309] = "そんな...";
    text[6310] = "なら...";
    text[6312] = "早くしてもらえないか？\n今は 時間が 惜しいのでね";
    text[6313] = "ニックル...";
    text[6314] = "言えば トーマスの 身の安全は 保障しよう";
    text[6315] = "必要なものを 手に入れたら 彼を 解放する";
    text[6317] = "わかった";
    text[6318] = "ありかを 言おう";
    text[6319] = "ハ...";
    text[6320] = "ハ... ハ...";
    text[6321] = "ハッハッハッハッハ！";
    text[6322] = "よくぞ言った！";
    text[6323] = "お前たちは 思ったよりも ものわかりが いいようだな";
    text[6324] = "話が早くて 助かると いうものだ！";
    text[6325] = "いや ちょっと待てよ...\n当ててみせようじゃないか";
    text[6326] = "オシアナス... ではないのかな？  それも 海の底の 隠し洞窟とか？";
    text[6327] = "...なっ！  どうして それを！？";
    text[6328] = "なかなか うまい場所に 隠したものだ";
    text[6329] = "我々の センサーでも 検出できなかったからな！";
    text[6330] = "だが どうやら お前は こちらを 甘く 見ていたようだ";
    text[6331] = "ワタシは いつも お前の 浅知恵の 一歩先を 行くのだよ";
    text[6332] = "おかげさまで 反物質コアは ありがたくいただいたよ！  アーッハッハッハ！";
    text[6333] = "このクソ野郎が！";
    text[6334] = "でも どうして...？";
    text[6335] = "信頼は 人の警戒心を 緩ませるのだ マークスレイヤー";
    text[6336] = "ドローンが オシアナスで お前の姿を 発見した...";
    text[6337] = "...そして 隠れ家に 向かうまで... すべての 動きを 監視していたのだよ";
    text[6338] = "そんな バカな... どうして そんな 初歩的な ミスを！？";
    text[6339] = "全部 オレの せいだ...";
    text[6340] = "ハッハッハッハッハ！";
    text[6341] = "そうだ お前の 絶望は...";
    text[6342] = "ワタシに 力を与える";
    text[6343] = "トーマス博士と 反物質コアの間で 倫理の 選択を 迫ったとでも 思ったかね...？";
    text[6344] = "実際は 最初から 選択肢など なかったのだよ";
    text[6345] = "もう お前たちから 欲しいものなど 何もないのだ";
    text[6346] = "お前が 集めた 反物質コアが あれば 血清を 作るのに 十分だ！";
    text[6347] = "サロスウウウウゥゥゥゥッ！！";
    text[6348] = "きさまああああぁぁぁぁっ！！";
    text[6349] = "ニックル！";
    text[6350] = "この... 畜生が...";
    text[6351] = "身の程を 知れ 青二才が";
    text[6352] = "二度と このワタシに 盾突こうと 思うな";
    text[6353] = "それでは この辺で 失礼するよ";
    text[6354] = "まだ 完成させなければ ならない 実験が あるのでね";
    text[6355] = "でも... パパは！";
    text[6356] = "サロス お願いだから\nパパには 手を出さないで！\nパパを... 返して...";
    text[6357] = "お前の 父親は...";
    text[6358] = "ワタシが 最も 尊敬し...";
    text[6359] = "...そして 軽蔑した 男だ";
    text[6360] = "まあ しばらくは 手元に 置いておくつもりだ...";
    text[6361] = "あの男に 人類の 新しい 夜明けを 目の前で 披露して あげたいのでね！";
    text[6362] = "それでは ごきげんよう";
    text[6363] = "サロス！！  逃げるな この臆病者が！！";
    text[6364] = "今の何？  まるで 宇宙ステーションが 動いてるみたいよ！";
    text[6365] = "ああ まずいわ... みんな 今すぐ 管制センターに 向かって！";
    text[6366] = "サロスに ルナー宇宙ステーションの システムが 乗っ取られたわ！";
    text[6367] = "元に戻せない！  すべて ロックされてて...";
    text[6368] = "このままだと 宇宙ステーションは ルナーの 周回軌道から 外れてしまう...";
    text[6369] = "墜落してしまうよ！";
    text[6370] = "何ですって！？  時間は どれくらい 残ってるの？";
    text[6371] = "この速度だと 衝突まで 7分と いったところよ...";
    text[6372] = "...でも それよりも まずいことが あるわ";
    text[6373] = "ああ どうやら サロスは アストロバリア防衛システムも 起動したみたいだ";
    text[6374] = "ええ それじゃ...";
    text[6375] = "アストロバリア防衛システムは 通常なら 小隕石やスペースデブリが ルナーの大気に 入るのを";
    text[6376] = "防ぐためにあるわ  だから バリアに ぶつかったものは バターみたいに 溶けちゃうのよ...";
    text[6377] = "そんな... 一体 どうしたら...";
    text[6378] = "考えろ... 考えるんだ...";
    text[6379] = "サロスは イカれてるわ！  宇宙ステーションを 破壊したら セレスティアも 失うのよ！";
    text[6380] = "そうしたら コーダ彗星を 止めることだって できなくなるじゃない！";
    text[6381] = "セレスティア... それだ！";
    text[6382] = "ナイラさん あれを 起動することは できるかい？";
    text[6383] = "ええ... でも 何のために？";
    text[6384] = "オレに 考えがある...";
    text[6385] = "宇宙ステーションは ルナーに 落ちようと している...";
    text[6386] = "なら それと同じか それ以上の力で 反発すればいい";
    text[6387] = "ウェヘー！  簡単に 言うねえ！";
    text[6388] = "どうやって？  今 言ったことと セレスティアに 何の関係が あるの？";
    text[6389] = "話は ここからさ";
    text[6390] = "セレスティアは 反物質で 動いている  だから オレ自身が その燃料に なれる";
    text[6391] = "ステーションの下に ワームホールを 作ってくれ...";
    text[6392] = "オレが そこに行き ステーションを 押し返す...";
    text[6434] = "そして 止めてみせる！";
    text[6393] = "待って ニックル... 宇宙に 行くって... そんなの 自殺行為だわ！";
    text[6394] = "うまくいくか どうかも わからないのに！";
    text[6395] = "それは 確かに そうだ でも...";
    text[6396] = "...やってみる 価値はある";
    text[6397] = "この作戦では オレは フェイズフォームになる";
    text[6398] = "その状態だと オレの体は 純粋な 反物質になる";
    text[6399] = "つまり 酸素が いらないってことだ";
    text[6400] = "それでも... 危なすぎるわ！";
    text[6401] = "あなたが 死んだら...";
    text[6402] = "それはもう 覚悟しているよ...";
    text[6403] = "本当は フェイズフォームは...";
    text[6404] = "...コントロールが 効かないから 使いたくは ないんだ";
    text[6405] = "...もちろん 訓練して 少しは マシになったが";
    text[6406] = "それ以上に...";
    text[6407] = "このフォームは...";
    text[6408] = "オレという存在の 失敗の 象徴であり";
    text[6409] = "弱点の 象徴でもある...";
    text[6410] = "...人を守れない オレの弱さのな...";
    text[6411] = "この力は... いつも周囲に 被害を もたらしてきた...";
    text[6412] = "...特に 制御できない時にな";
    text[6413] = "そして この力は... サロスの狂気に 利用された...";
    text[6414] = "...それにより さらに多くの 罪なき市民の 命が奪われた...";
    text[6415] = "そのことが 今も オレの心を 苛み続けるんだ";
    text[6416] = "ニックル...";
    text[6417] = "己の過去... 過ち... いつまで 経っても オレの背中を 追いかけてくる";
    text[6418] = "今回も...";
    text[6419] = "サロスに 出し抜かれて 集めた 反物質コアを すべて 奪われて...";
    text[6420] = "...失敗に 失敗を 重ねて...";
    text[6421] = "...だからこそ 一回でいいから みんなのために 良いことを したいんだ";
    text[6422] = "何か... 誇りに 思えるようなことを";
    text[6423] = "ベラ...";
    text[6424] = "...オレを 信じてくれて...\nそして 優しくしてくれて ありがとう";
    text[6425] = "ニックル... お願いだから...";
    text[6426] = "ワタシ...";
    text[6427] = "...！";
    text[6428] = "悪い...";
    text[6429] = "今のは ちょっと 自己中だったな";
    text[6430] = "あら！";
    text[6431] = "へぇ～...";
    text[6432] = "アンタね もう生きて 帰れないみたいに 言わないでよ...";
    text[6433] = "...バカ";
    text[6435] = "ベラ...";
    text[6436] = "ゼッタイに 戻ってくるって 約束しなさい！";
    text[6437] = "みんな あなたが 必要なんだからね！";
    text[6438] = "あなたが 必要なんだから...";
    text[6439] = "まあ 幸運を 祈ってくれ";
    text[6440] = "それじゃあ 行くぞ... フェイズモード！";
    text[7140] = "うおおおおおお！";
    text[7141] = "ニックル！  いけるわよ！";
    text[7142] = "だんだん 遅くなってるわ！";
    text[7143] = "でも まだまだだ... これじゃ 止まらない！";
    text[7144] = "がんばって！  あきらめちゃ ダメよ！";
    text[7145] = "アストロバリアまで あと どれくらいだ？";
    text[7146] = "ウェヘー！  このペースだと 2分だよ！";
    text[7168] = "燃料は？";
    text[7169] = "残り75％よ...";
    text[7147] = "くそおおおおっ！  全然 止まらねえぞ！";
    text[7148] = "もう... 限界だ...";
    text[7162] = "ニックル 大丈夫よ！";
    text[7163] = "何とか 持ちこたえて！  あなたは 強いわ！";
    text[7164] = "でも... あんまり 出力を 上げると...";
    text[7165] = "また 力が 暴走するかもしれない...";
    text[7166] = "そうしたら 宇宙ステーションを 壊してしまうかもしれない...";
    text[7167] = "...そうしたら みんなは...";
    text[7149] = "ニックル がんばれ！  あと少しだ！！";
    text[7150] = "その声は...？";
    text[7151] = "ステーションの人たちよ！\n兵士も 科学者も... みんなよ！";
    text[7152] = "みんなが あなたを 応援しているわ！";
    text[7153] = "ニックル！  みんな 信じてるわよ！";
    text[7154] = "さあ がんばって！！";
    text[7155] = "(みんな...)";
    text[7156] = "(ありがとう...)";
    text[7157] = "(そうだ... あきらめちゃ いけない...！)";
    text[7158] = "ここで みんなを 救えなければ...";
    text[7159] = "...ルナーは サロスの手に 落ちる";
    text[7160] = "やってやるぜ... 全力だ！！";
    text[7161] = "うおおおおおおおお！！！";
    text[6442] = "(ドサッ！)";
    text[6443] = "イテッ！  ああっ 目が覚めたぜ！  それで 一体 何が どうなったんだ？";
    text[6444] = "バカ...";
    text[6445] = "もう 死んだかと 思ったわよ...";
    text[6446] = "宇宙ステーションが 軌道に戻った後 あなたは 気を失ったの";
    text[7172] = "幸運なことに まだフェイズフォーム だったから";
    text[7173] = "ベラが すぐに あなたを 探しに出て...";
    text[6449] = "無事で 本当に 良かったわ～...";
    text[6450] = "みんなを 助けてくれて ありがとう";
    text[6451] = "この恩は 忘れないよ";
    text[6452] = "本当に ありがとう...！";
    text[6453] = "あなたの力は 本当にすごい... 感動しましたよ！";
    text[6454] = "キミは もう ヒーローだよ！  ウェヘー！";
    text[6455] = "自分の身を 危険に 晒して 良く がんばったわ";
    text[7177] = "あなたの 覚悟と 優しさに みんなが 心を 動かされたのよ";
    text[6456] = "ありがとう... うまくいったのは みんなが 励ましてくれたおかげさ ";
    text[7178] = "うう...";
    text[6458] = "ニックル まずは 治療室で 休んだ方が いいわ！";
    text[7136] = "いや 大丈夫さ\nちょっと 腕が ジンジンする だけだ";
    text[7137] = "チーズケーキバーでも 食べたら すぐに 動けるようになるさ";
    text[7171] = "でも 無理しちゃ ダメよ";
    text[7176] = "わかってるさ";
    text[7175] = "それじゃあ みんな...";
    text[6465] = "あなたたちは 今日 サロスが どれほどの 力を 手にしたのかを 目撃したわ";
    text[6466] = "あの男の 好きなように させるわけには いかない！";
    text[6467] = "ワタシたちの 未来を... この手で 取り戻すのよ！";
    text[6468] = "もちろんです！  戦う 覚悟は できています！";
    text[6469] = "あれ ちょっと待って... アストロバリア防衛システムは まだ 動いてるんでしょ？";
    text[6470] = "なら 軍事基地に 船を 降ろすことは できないんじゃないの...？";
    text[6471] = "その必要はないわ... だって ワームホールマシンが あるじゃない！";
    text[6472] = "...しかも 反物質の 燃料は 目の前に いるでしょ？";
    text[6473] = "誰が 燃料だって！？";
    text[6474] = "冗談よ！";
    text[6475] = "わかってるっての！\nまあ その辺は オレに 任せな";
    text[6476] = "それじゃあ これから ネクサスラボに 移動するわよ！";
    text[7181] = "出発は 5分後！";
    text[7182] = "了解！";
    text[6248] = "テトラ あれを 使う時が 来たわ";
    text[6249] = "ええっ！？";
    text[6251] = "ああ アレね";
    text[7183] = "キミたち どこに 行くんだい？";
    text[7184] = "すぐに 戻るわ";
    text[7185] = "ちょっと 大事なものを 部屋に 忘れてきちゃってね";
    text[7186] = "大丈夫よ！  ワタシたちは ネクサスラボで 待ってるからね！";
    text[7187] = "軍事基地まで ワープする 準備が できたら 話しかけてくれ ウェヘー！";
    text[7195] = "やっぱり！  シアの ジェットスーツを 持っていきたかったのね！";
    text[6252] = "あと これを 着るには 信頼できる アシスタント・ロボが いるのよね";
    text[6253] = "その辺に ついては どうかしら？";
    text[6254] = "任せておきなさい！";
    text[6255] = "ママはこれを ネビュラスーツと 呼んでいたわ";
    text[6256] = "ネビュラ... つまり 星雲の 一部は 死んだ星の 爆発...";
    text[6257] = "...「スーパーノヴァ」 によって 生まれるわ";
    text[6258] = "でもね... 星雲は 新しい星が 誕生する 場所でも あるのよ";
    text[6259] = "つまり ネビュラスーツとは 1つの 時代の 終わりと 始まりを 象徴しているのよ";
    text[6260] = "ワタシが これを 着るのに ふさわしいかは わからないけどね...";
    text[6261] = "大丈夫よ ベラ... シアは きっと あなたのことを 誇りに思って いるわ";
    text[6262] = "あの人が ここにいたら あなたの 立派になった 姿を見て きっと 驚くでしょうよ";
    text[6263] = "テトラ... あなたは 最高の アシスタント・ロボよ";
    text[6264] = "ええ これからは スーパーノヴァ アシスタント・ロボ テトラと 呼びなさい エヘヘ";
    text[7193] = "ようし それじゃあ ネクサス・ラボに 向かいましょう！";
    text[7194] = "セレスティアを 使って 軍事基地に ワープするのよ！";
    text[6477] = "さて 入ったわ！";
    text[6478] = "サロスの 部屋は まっすぐ 進んだ先よ";
    text[6479] = "止まれ！  動いたら 即座に 攻撃する！";
    text[6480] = "聞いて！  あなたたちは 戦う相手を 間違えているわ！";
    text[6481] = "お願い ここを 通して！";
    text[6482] = "時が 経てば 経つほど サロスの 犠牲者が 増えていくわ！";
    text[6483] = "バレットパンチ！";
    text[6484] = "レイン 助かったわ！";
    text[6485] = "ここは ワタシたちに 任せて！";
    text[6486] = "あなたたちは サロスの所に 行くのよ！";
    text[6487] = "なるほど ここが サロスが 実験を していた 場所ね...";
    text[6488] = "カプセルに 入った マーク... 狂気の 犠牲者...";
    text[6489] = "耐えられないわ... 気分が 悪くなる...";
    text[6490] = "...";
    text[7290] = "マークよ！  ここでも 出てくるわけ！？";
    text[7291] = "驚きは しないな";
    text[7292] = "このラボには 大量の 反物質がある  マークを 引き付ける 磁石みたいな もんだ";
    text[7293] = "それで どうするの？";
    text[7294] = "戦うんだ... そして マークの 苦しみに 終止符を打つ";
    text[7295] = "その反物質コアが 無事なら 助けることだって できるはず...";
    text[7296] = "...それに 放っておくのは キケンすぎるだろう";
    text[7297] = "カプセルの中の マークが 目覚めたら 数で 圧倒されるぞ";
    text[7298] = "そうなったら 先に進むのも 難しくなる...";
    text[7299] = "...";
    text[7300] = "そうね... じゃあ やりましょう";
    text[7302] = "マークと 戦うことに ついて お前が 何も 言わないのに ちょっと 驚いてるよ";
    text[7312] = "まあ 心の底では... 今も イヤよ";
    text[7313] = "でも... 真実を 知った 今";
    text[7314] = "それよりも 差し迫ったことが あるわけだから...";
    text[7304] = "...ただ 一般市民を 守るため だけじゃない";
    text[7305] = "マークの 中には... 苦しんでいる 魂がいる";
    text[7306] = "少なくとも 反物質コアの 状態であれば 人に 危害を 加えることは ないからね...";
    text[7323] = "...そして いつか 彼らを 元に戻す 方法を 探すのよ";
    text[7307] = "この人たちだって 自らの 意志で 怪物に なったわけでは ないのだから...";
    text[7315] = "でも マークの 中には 反物質コアを 落とさないのも たくさんいるわ...";
    text[7324] = "その場合は もう 魂が 壊れてるって ことなんでしょ？";
    text[7316] = "そうだ 人が マークに 変化する時";
    text[7317] = "血清の 副作用で 魂が 破壊されることがある";
    text[7325] = "...じゃあ そういう人たちは 救えないってこと？";
    text[7326] = "残念ながら... そういうことだな...";
    text[7318] = "人の魂は 反物質コアの 中にある";
    text[7327] = "それが なければ 元には 戻せない";
    text[7328] = "なら そういう人たちは 安らかに 眠ってもらうしか なさそうね";
    text[7308] = "でも たとえ 全員は 救えないとしても...";
    text[7309] = "できる限り 多くの命を 助けるんだから！";
    text[7311] = "その意気だぜ ベラ！";
    text[6491] = "ヴィヴィア！";
    text[6492] = "あの人に... 見捨てられたわ...";
    text[6493] = "今まで ずっと 彼のために がんばってきたのに...";
    text[6494] = "ヴィヴィア サロスは どこなの？";
    text[6495] = "今すぐ 止めなくちゃ いけないのよ！";
    text[6496] = "サロスは... ワタシの すべてよ...";
    text[6497] = "あの人の 夢を... 叶えるの";
    text[6498] = "もし...";
    text[6499] = "あなたたちを ここで 倒したら...";
    text[6500] = "きっと また 認めて もらえるわ！";
    text[6501] = "この女... サロスと 同じくらい 狂ってるぞ";
    text[6502] = "いくら 話を したところで 時間の ムダだろう";
    text[6503] = "ここまで 来たからには 逃がさないわよ";
    text[6504] = "あなたたちは 見すぎた";
    text[6505] = "そして 知りすぎたの";
    text[6506] = "どうして サロスの 味方を するの？  彼の やったことが 正しいとでも 思っているわけ？";
    text[6507] = "あの人は... 道を 踏み外したのよ！";
    text[6508] = "サロスは... 死にゆく 運命だったの";
    text[6509] = "...！？";
    text[6510] = "彼は 十年前 不治の病だと 診断された...";
    text[6511] = "彼は 死を前にして 何とかして 治す方法を 見つけようとした";
    text[6512] = "反物質が... 血清が... 彼を救ったのよ";
    text[6513] = "彼は 病気の進行を 遅らせる方法を 見つけたの...";
    text[6514] = "当初 彼の目的は 自分の命を 救うことだった... でもね その時 気が付いたの...";
    text[6515] = "完全な 反物質の 血清は 自分だけでなく";
    text[6516] = "他の人たちも 救えるんだって";
    text[6517] = "彼の していることは...\nより大きな 正義の ためなのよ";
    text[6518] = "私は 彼を 何年も そばで 見てきた...";
    text[6519] = "この任務を 推し進めるのには 葛藤も あったわ";
    text[6520] = "ワタシの 両手は 今や 血で 真っ赤に 汚れている...";
    text[6521] = "...でもね だからこそ その犠牲を ムダには できないのよ！";
    text[6522] = "ベラ... あなただって 人類を 救いたいんじゃないの？";
    text[6523] = "そうよ！  でも あなたたちの やり方は 間違っているわ！";
    text[6524] = "命は... 魂は... 神聖なものよ";
    text[6525] = "ワタシたちは 数百万人を 救うために 数千人を 犠牲にした  これは 必要悪と いうものよ";
    text[6526] = "コーダ彗星を 止める方法は ないわ\nあの計画が なければ... 人類は 終わりなのよ";
    text[6527] = "おそらく サロスは まだ あなたたちに 言ってない でしょうけどね...";
    text[6528] = "何だって？";
    text[6529] = "でも それを 聞くことは かなわないわよ";
    text[6530] = "知りたいなら 本人に 直接 聞きなさい";
    text[6531] = "ただし... ワタシを 倒してからね\nまあ ありえないけど";
    text[6532] = "あなたたちを 取り逃がした後 ホロテクノロジーを アップグレードしたのよ";
    text[6533] = "今度こそ ぬかったりは しないわ\nさあ 覚悟しなさい！！";
    text[6534] = "終わりよ ヴィヴィア...";
    text[6535] = "さあ サロスの 居場所を 教えて";
    text[6536] = "彼は... あなたの お父さんを 「聖域」に 連れて行ったわ";
    text[6537] = "サロスが 人類の 新しい 故郷に しようと している場所...";
    text[6538] = "...ファントムスペースよ";
    text[6539] = "...大丈夫よ  極度の疲労で 倒れただけだわ";
    text[6540] = "ファントムスペース...";
    text[6541] = "人間は ファントムスペースに 72時間以上は いられないはず...";
    text[6542] = "...その辺について サロスは ウソを ついてたのかしら？";
    text[6543] = "さあな... どちらにしろ まだ 72時間は 経ってないぜ";
    text[6544] = "ニックル あなたは ファントムスペースに 行ったことはある？";
    text[6545] = "かなり 昔に 一度だけな...";
    text[6546] = "...まあ 話すと 長くなるんだが";
    text[6585] = "ワタシは いつも ファントムスペースには 近づくなと 言われてきたわ...";
    text[6586] = "でも 今思えば サロスに そう思わされてきた だけだったの かもしれない";
    text[6547] = "やつが ファントムスペースで 何か しているなら";
    text[6548] = "立ち入らせないように 仕向けるのが 自然だろうな...";
    text[6549] = "本当に 信じられないわ...";
    text[6550] = "新しい 事実を 知るたびに...";
    text[6551] = "ワタシは...";
    text[6552] = "怒りを 感じる か？";
    text[6553] = "ええ...";
    text[6554] = "耐えられないわ";
    text[6555] = "これ以上 ひどいものを 見るのは...";
    text[6556] = "それに 悪事が 起こっていたのに 知らずに いたなんて なおさら ひどく 思えるわ";
    text[6557] = "ルナーは 変わらなくちゃ いけない";
    text[6558] = "正せる人間が いるとすれば...";
    text[6559] = "それは お前だよ";
    text[6560] = "今は 狂った男が 権力の 中枢にいる";
    text[6561] = "まずは そいつを 何とかしないとな";
    text[6562] = "そうね";
    text[6563] = "それで どうやって サロスの 居場所を 突き止めるの？  ファントムスペースは 広いわよ";
    text[6564] = "それに キケンでも あるわ...";
    text[6565] = "...かの 72時間規則の 真偽は 別としてもね";
    text[6566] = "ちょっと 待って... あれって もしかして...";
    text[6567] = "何だか ワームホールマシンに 似てると 思わない？  ちょっと 見てみましょう";
    text[6568] = "テトラ ハードウェアスキャンを してもらえるかしら？";
    text[6569] = "何か 情報を 得られるか 試してみるのよ";
    text[6570] = "これは... アルファ版の セレスティアね";
    text[6571] = "パパは サロスは 数年前に 反物質の プロジェクトに 参加したと 言ってたわ";
    text[6572] = "おそらくは 破棄された 設計図から 自分用の マシンを　作ったんでしょうね";
    text[6573] = "待って！  すごいもの 見つけたわ！";
    text[6574] = "何？";
    text[6575] = "座標よ！";
    text[6576] = "おおっ でかしたぞ！  それを 打ち込んだら やつの 近くに 行けるはずだ！";
    text[6577] = "じゃあ 次の目的地は ファントムスペースね！";
    text[7388] = "ワームホールマシンを 使って ファントムスペースに 入りますか？";
    text[7402] = "古代の文字が 刻まれているわね";
    text[7403] = "何々...";
    text[7398] = "「我ら 宇宙の 同胞よ この聖域が 汝の...";
    text[7399] = "...ささやかな 避難所で ありますように」";
    text[7404] = "おお なるほど！";
    text[7405] = "じゃあ この場所は おそらく 古代人が ファントムスペースを";
    text[7406] = "旅する時の 休憩所 だったんだな";
    text[7407] = "ここは 奇妙なくらい 美しいわ";
    text[7408] = "まるで 砂漠の ど真ん中にある オアシスのような...";
    text[7412] = "ああーっ！  こんなん見たら 急に トレジャーハントに 行きたく なってきたぜ！";
    text[7413] = "これ以上 気を散らすと いけないから さっさと 先に進もう";
    text[7414] = "あのね... これが 終わったら...";
    text[7415] = "ファントムスペースの もっと深い所を 見て回って";
    text[7416] = "ルナー初の 探索調査を するなんて どう？";
    text[7417] = "悪くないと 思わない トレジャーハンターさん？";
    text[7418] = "そりゃあいい ゼッタイ 行くぜ ヘッヘッヘ！";
    text[7419] = "このパネルは ある種の エネルギーフィールドを 作り出す みたいね";
    text[7420] = "どうやったら 通れるのか 考えないと";
    text[7421] = "ウーン...";
    text[7422] = "おっ どうやら お前も 同じことを 考えてそうだな テトラ";
    text[7423] = "かもね！";
    text[7424] = "わあっ！  今の どうやったわけ？";
    text[7425] = "ここの キューブは セキュリティシステムの 一部なのよ";
    text[7426] = "グレーの キューブを ハッキングして 無効化したってわけ";
    text[7427] = "赤の キューブは もうちょっと キケンだ";
    text[7428] = "高密度の 反物質が 脆いカラの 中に 入っている";
    text[7429] = "お前らが 触ったら 爆発するはずだ";
    text[7430] = "それで どうやって 消したわけ？";
    text[7431] = "吸収しただけさ ヘッヘ";
    text[7432] = "テトラ ちょっと そこの 黄色い サークルの上に 立ってみてくれ";
    text[7433] = "オレは 緑の所に 行く";
    text[7434] = "わあ パネルの色が 消えたわ！";
    text[7435] = "これで やり方が わかったな";
    text[7436] = "それじゃあ うまく協力して 進んでいこう";
    text[7437] = "そうね！ 　チームワークで 勝利を 掴みましょ！";
    text[6594] = "我が 聖域へ ようこそ トーマス";
    text[6595] = "ファントムスペースは 美しい所だと 思わんかね？";
    text[6596] = "サロス ここは もはや 我々には 何の 意味もない 場所だ";
    text[6597] = "何年も 前に 反物質 プロジェクトを 中止したのには 訳が あっただろう...";
    text[6598] = "それは 我々が こちらの 世界を 何一つ 理解して いなかったからに 過ぎぬ";
    text[6599] = "この美しき 別世界をな...";
    text[6600] = "ここは... 人類の 新しい 故郷と なるのだ";
    text[6601] = "トーマス... 人類は ルナーの上で あとどれくらい 生き延びられると 思う？";
    text[6602] = "うむ...";
    text[6603] = "お前が マークを 野に放った せいで... あと 数十年と いったところかな...";
    text[6604] = "たとえ それが なかったとしても...";
    text[6605] = "そのうち 資源は 尽きることだろう...";
    text[6606] = "ルナーに 住んでいる限り 資源の 枯渇は 常に 死活問題で あり続ける";
    text[6607] = "そう 資源には 限りがある... だが 反物質には...";
    text[6608] = "...無限の 可能性が あるのだ！";
    text[6609] = "「知識は力なり」だよ トーマス";
    text[6610] = "過去の取り決めに 逆らい ワタシは 何度も ファントムスペースを 訪れていた";
    text[6611] = "...おかげさまで とても 多くのことを 学べたよ";
    text[6612] = "この空間では 人は 老いないのだ  そして 飢えることもない";
    text[6613] = "どういうわけか 人体は 新陳代謝を 維持できるのだ...";
    text[6614] = "...";
    text[6615] = "素晴らしいことだと 思わないか？";
    text[6616] = "科学者として 胸が 高鳴らないかね？";
    text[6617] = "ファントムスペースが 人体に 不思議な 作用を もたらすのは その通りだ...";
    text[6618] = "だが... それは 同時に 破滅への 罠でもある";
    text[6619] = "最初は うまくいっても そのうち 人体が 崩壊し始めるのだ";
    text[6620] = "その通り... それは 確かに ボトルネックと 言えるだろう";
    text[6621] = "この肉体では ファントムスペースの 恩恵を 十分に あずかることは できない";
    text[6622] = "ワタシは 数年前 考えた...";
    text[6623] = "この肉体さえ なければ...";
    text[6624] = "死を 案ずることもなく... 寿命の制限を 受けることもない";
    text[6625] = "そうした限界が 我々を 人間たらしめているのだよ サロス";
    text[6626] = "お前が 言うことは 幻想だ\n人間は ここでは 生きられんのだ";
    text[6627] = "いいや 違うな";
    text[6628] = "なぜなら 技術を 開発したからだ...";
    text[6629] = "血清は... あと少しで 完成する";
    text[6630] = "そうなった 暁には 人体を 変化させ";
    text[6631] = "完全なる 反物質の 生命体に なることが できるのだ";
    text[6632] = "ファントムスペースで 生きられる 存在にな";
    text[6656] = "血清が... 種の進化の カギと なるのだ！";
    text[6633] = "これは... 反物質が 持つ力の ほんの 一部に すぎない";
    text[6634] = "そのすべてを 操れば... 宇宙の ヒミツを...";
    text[6635] = "物理法則を 超越する力を...";
    text[6636] = "人間の理解を 超える知識を...\n手にすることが できるのだよ";
    text[6637] = "トーマス... お前は かつて 友だった...";
    text[6638] = "そして この研究の 重要性を 気づかせてくれた...";
    text[6639] = "若い 科学者だった 私の 知への 探求を 支えてくれた...";
    text[6640] = "お前の おかげで たくさんの ことが 学べたよ";
    text[6641] = "だが 我々の 間には... 埋められない 溝がある";
    text[6642] = "それは お前が 知識を 間違った方法で 手に入れた からだろう！";
    text[6643] = "間違った方法？";
    text[6644] = "まったく グレイ家の 連中は... どいつも こいつも 同じことを 言う...";
    text[6645] = "そんなことはない";
    text[6646] = "お前は 本当に ルナーの民が 新しい体を 欲しているとでも 思っているのか？";
    text[6647] = "...よく 知りもしない 世界で 幸せな 生活を 送れるとでも？";
    text[6682] = "まったく そうは 思えんがな";
    text[6667] = "ルナーこそ 我らの 家であり... 守るべき 故郷なのだ";
    text[6668] = "かつては テラが 人類の 故郷だった はずだ...";
    text[6669] = "...だが 今は どうだ？";
    text[6670] = "そこに 生命はなく 無残に 荒れ果てて いるではないか！";
    text[6648] = "我らの 先祖は... ルナーに 逃れ... 新しい 世界を 築いた";
    text[6657] = "ルナーとて 最初は 住めない 土地だったのだ！";
    text[6671] = "それは やむを 得なかったからだ！\n当時の 人類は 滅亡の 危機にあった";
    text[6672] = "だが 我々には まだ 時間がある";
    text[6673] = "その執念...";
    text[6674] = "その妄想...";
    text[6675] = "...サロス どうやら お前は 真の希望を 失ったらしいな";
    text[6676] = "そして お前は ルナーの ことなど これっぽっちも 気にかけていない";
    text[6677] = "この卑怯者が！";
    text[6678] = "...";
    text[6659] = "コーダ彗星は どんどん ルナーに 迫っている...";
    text[6660] = "...なのに ワタシが 問題なのだと？";
    text[6661] = "むしろ 立ち向かう チャンスを 与えようと しているのに！";
    text[6854] = "トーマスよ コーダ彗星を 止められる ワームホールを 作るには 反物質が 足りないのだ";
    text[6855] = "マークスレイヤーが 集めたものを すべて 足してもな";
    text[6856] = "...だが ワタシの 計画なら 実現できる";
    text[6857] = "人間を 反物質の 存在に 変えることが できるのだよ";
    text[6858] = "...そして ファントムスペースで 新しい生を 歩むのだ";
    text[6662] = "そうすれば 人類は 生き延びられる\nこれの どこが 邪道なのだ！？";
    text[6688] = "ワタシは ただ 自分が得た 知識を 人類のために 使っているだけだ！";
    text[6679] = "サロスよ 物事には 越えてはならない 一線がある";
    text[6680] = "ワタシなら 宇宙の ヒミツを 知るために...";
    text[6681] = "宇宙の力を 得るために...\n人の命を 弄んだりは しない";
    text[6683] = "偉大なる 計画の 前では 人の命など 取るに 足らないものだ";
    text[6684] = "お前...";
    text[6685] = "よくも そんなことを...";
    text[6686] = "同僚の 科学者 友人 市民...";
    text[6687] = "そして シアの命は... 取るに 足らない ものではない";
    text[6663] = "実に 残念だ...";
    text[6664] = "お前は ルナーが 誇る 偉大な 賢人だと いうのに";
    text[6665] = "この遠大な ビジョンを ぜひとも 理解して ほしかったが...";
    text[6689] = "どうやら お前は こちら側には 来てくれない ようだな";
    text[6666] = "ならば 我が 英知の 王国に お前の 居場所はない！";
    text[6692] = "さらばだ トーマス！";
    text[6697] = "ベラ！";
    text[6694] = "うう... 何だ！？";
    text[6695] = "お前たち... どうして ここに！？";
    text[6696] = "死んだはずでは... ぐぅ...";
    text[6698] = "ベラ 妙なことに お前を 巻き込んで すまなかった...";
    text[6699] = "サロスに 取引を 強要されたのだ...";
    text[6700] = "お前に 危害を 加えない 代わりに...";
    text[6701] = "言う通りに しろと...";
    text[6702] = "パパ...";
    text[6703] = "ただ お前を 守りたかったのだ...";
    text[6704] = "...赦しておくれ";
    text[6705] = "パパ 大丈夫よ 怒ってなんか ないわ  こうして 再会も できたし";
    text[6706] = "ただ サロスを 放っておく わけには いかないわ！";
    text[6707] = "うむ... どうやら お前たちの ことを 甘く 見すぎていた ようだ";
    text[6708] = "まず ワタシの 居場所を 突き止めたことは 褒めてやろう";
    text[6709] = "前にも 言ったように 戦わずして あなたに 屈したりは しないわ";
    text[7439] = "そして あなたは ニックルから 盗んだ 反物質コアを ここに 運んできた...";
    text[7441] = "ここで はっきり させましょう...";
    text[7442] = "反物質コアは あなたの 実験材料 なんかじゃない...";
    text[7443] = "...あなたが 持っている コアは 1つ残らず 返してもらうわ！";
    text[7444] = "あなたは ルナーの民を 裏切った\nその罪は 決して 赦されない！";
    text[7440] = ".......";
    text[6710] = "なぜだ...？  なぜ グレイ一家の 者は いつも ワタシの ジャマをする？";
    text[6711] = "お前の 母親も そうだった...";
    text[6712] = "口に 気をつけなさい サロス";
    text[6713] = "ママを 侮辱したら ただじゃおかないわよ";
    text[6714] = "シアと 言えば... 言っておくべき ことがある...";
    text[6715] = "彼女の... 死の 真相だ...";
    text[6716] = "あれは ワタシの せいなのだ";
    text[6717] = "な 何ですって...！？";
    text[6718] = "キサマ...！";
    text[6719] = "一体 何を したのだ！？";
    text[6720] = "世間に 出回っている シアの死に まつわる 情報は まったくの デタラメだ";
    text[6721] = "やつが ワタシの 反物質実験を 発見した時...";
    text[6725] = "...そして マークの 真相を 知った時...";
    text[6726] = "やつは そのプロジェクトを 終了させた... そして かの血清をも 破壊しようとした...";
    text[6727] = "...それまでの ワタシの 努力の結晶 すべてをだ";
    text[6728] = "ワタシは 抵抗したが 追い詰められた";
    text[6729] = "絶体絶命の 状況だったが...";
    text[6730] = "...そこで とっさに ひらめいた";
    text[6731] = "一瞬の スキを ついて...";
    text[6732] = "ワームホールマシンを 起動し...";
    text[6733] = "...やつを 脱出不可能な ファントムスペースへと 閉じ込めたのだ";
    text[6734] = "やつは ワタシの ジャマをした... だから 排除した... 大義の ためにな";
    text[6735] = "サロス！  この悪魔め！";
    text[6736] = "アッハッハ... そうだ 怒れ！  恨め！";
    text[6737] = "お前の 絶望が ワタシに 力を与える！  ハッハッハ！";
    text[6738] = "シアを ファントムスペースに 送った後...";
    text[6739] = "...次の ステップは 将軍に なることだった";
    text[6740] = "人々を 説得するのは 思ったよりも 簡単だったよ";
    text[6741] = "何度か マークの 襲撃を 演出し...";
    text[6742] = "それを 倒す...";
    text[6743] = "英雄を 演じる";
    text[6744] = "誰も 疑ったりなどしない";
    text[6745] = "残りは マークスレイヤー だけだった";
    text[6746] = "ありがたいことに それも ついに うまくいったが...";
    text[6747] = "あなたの やったことは ゼッタイに 赦せないわ...";
    text[6748] = "ワタシから... みんなから ママを 奪って... ";
    text[6749] = "でもね サロス それも ここまでよ！";
    text[6750] = "ここで 自分が 犯した罪の 対価を 払ってもらうわ！";
    text[6751] = "ハッハッハ！";
    text[6752] = "お前たちは なんと愚かで！";
    text[6753] = "騙されやすく！";
    text[6754] = "...弱いのだろうな！";
    text[6755] = "人類は ワタシなしでは 生きていけんのだ！  この世界は... 真の科学者を 必要としている...";
    text[6756] = "...他の誰にも なしえぬことを 実行できる 者がな";
    text[6757] = "ワタシは 世に 進歩を もたらすために いろいろなものを 犠牲にする 覚悟がある！";
    text[6758] = "違うわ！";
    text[6759] = "何とでも言え！\nどうせ ワタシを 止めることなど できないの だからな！";
    text[6760] = "そして お前も 理解することだろう";
    text[6761] = "生命とは 実験台に すぎないのだと！";
    text[7445] = "...そして この宇宙は 巨大な 実験室に すぎないのだと！";
    text[6822] = "どうやら お前の 決意は 思ったよりも ずっと 強いようだ...";
    text[6762] = "だが どうして？";
    text[6763] = "どうして ここまで 強いのだ？";
    text[6764] = "それは 自分たちの ためだけに 戦ってるわけじゃ ないからさ";
    text[6765] = "ワタシたちは ルナーの みんなのために 戦ってるのよ！";
    text[6766] = "そして 人類の 未来の ためにね！";
    text[6767] = "ベラ お前は これから 起こることを わかっていない...";
    text[6768] = "第9番遺跡... それを 最初に 発見したのは 他ならぬ お前の 母なのだぞ...";
    text[6769] = "三日月形の 奇妙な 古代遺物...";
    text[6770] = "そこには やつだけが 解読できる ヒミツの 文字があった";
    text[6771] = "それは... 古代人が 我々に 残した 警告 だったのだ";
    text[6772] = "コーダ彗星の 真の性質とは 何なのかに ついてのな";
    text[6773] = "...？";
    text[6774] = "今さら 何を 言ったところで 信じるかよ！";
    text[6775] = "ここから 逃げられると 思うな サロス";
    text[6776] = "お前の ウソには うんざりだ";
    text[6777] = "ウソではない\n最高機密レベルの 情報だ";
    text[6778] = "古代人が 滅亡したのも... それの せいだった";
    text[6779] = "「それ」って... 何のこと？";
    text[6780] = "我々の 真の敵だ...";
    text[6782] = "コーダ彗星を 作ったのは";
    text[6783] = "...「ネメシス」の名で 知られる 異文明の 者たちだ";
    text[6784] = "古代人が 滅んだ 直接の 原因は 彼らなのだ...";
    text[6785] = "そして やつらは 千年前に テラの民をも 滅ぼした... ";
    text[6786] = "...";
    text[6787] = "でも...";
    text[6788] = "どうして そんなことを？";
    text[6789] = "それは わからん...";
    text[6790] = "わかっているのは...";
    text[6791] = "古代人の 文明は 我々の それよりも はるかに 進んでいたと いうこと...";
    text[6792] = "...にもかかわらず ネメシスを 止められなかったことだ";
    text[6793] = "だからこそ 最善の策は 生物として 進化し... 反物質の 存在に なることなのだ";
    text[6794] = "...そうすれば まだ 抗う術はある";
    text[6795] = "その考えには 1つ 間違っている ところが あるわ";
    text[6796] = "...ほう 言ってみたまえ";
    text[6797] = "ワタシたちは 日々 進化しているってこと";
    text[6798] = "そして 人類が 前に進むために 何よりも 必要なのは...";
    text[6799] = "犠牲ではなく...";
    text[6800] = "恐怖でもなく...";
    text[6801] = "...支え合うことよ";
    text[6802] = "人は 失敗を しては 立ち上がる 生き物なの";
    text[6803] = "失敗から 学ぶ 生き物なの";
    text[6804] = "つまづいても... お互いを 支え 起き上がって また 挑めば いいのよ";
    text[6805] = "悲惨な 歴史を 繰り返したく ないなら";
    text[6806] = "これから その方法を 探せば いいのよ";
    text[6859] = "必ず 見つけ出すって 約束するわ ";
    text[6861] = "ゼッタイに ネメシスなんかに 負けないって";
    text[6860] = "いつだって 希望はある";
    text[6807] = "ただ マーク血清は... その答えじゃないのよ";
    text[6808] = "...";
    text[6809] = "ぐうう...";
    text[6810] = "ど どうしたの？";
    text[6811] = "やつの体... 力に 耐えられないんだ！";
    text[6840] = "反物質に 取り込まれようと している！";
    text[6812] = "ベラ... ものすごい エネルギーの 高まりが 検出されてるわ！";
    text[6814] = "コントロール... できない...";
    text[6815] = "血清は... 完全ではなかった...";
    text[6816] = "シンクロ率99％が 限界だったのだ...";
    text[6817] = "それでも 自分に使った";
    text[6818] = "ベラ...";
    text[6841] = "お前は 自分の道を 選んだ";
    text[6842] = "ワタシも 同じだ";
    text[6843] = "...そして これが その結末だ";
    text[6844] = "だが 後悔はない";
    text[6845] = "ワタシは 人類を 守れなかった...";
    text[6846] = "ここから 先は お前たち次第だ";
    text[6847] = "だが ワタシの 夢は 決して 死なない";
    text[6850] = "ワタシは...";
    text[6851] = "...進化するのだ！！";
    text[6828] = "グアアアアァァァァッ！";
    text[6829] = "...アンタたち 大丈夫？";
    text[6830] = "...それで この でっかい 化け物は 何なわけ？";
    text[6833] = "マッドサイエンティストの 末路だよ\nサロスという 名のな";
    text[6834] = "ええ マジなの！？";
    text[6835] = "自分で 作った 血清の 副作用に やられたのさ...";
    text[6823] = "そして 自分自身が マークに なり果てた";
    text[6821] = "来るわよ！";
    text[7450] = "ウェヘー！  ここに いるのは ちょっと キケンすぎるなあ";
    text[7451] = "パパ... もう 72時間 経ったわ...";
    text[7452] = "今すぐ ルナーに 戻って！";
    text[7453] = "でも お前たちは？";
    text[7454] = "ここに 残って 任務を 終わらせるわ！";
    text[6838] = "この怪物が ワームホールから 逃げたら とんでもない ことになる！";
    text[6839] = "ここで やつを 倒さなければ ルナーは 終わりだ！";
    text[6852] = "そんなこと ゼッタイに 許さないわよ！";
    text[7456] = "ならば...";
    text[7457] = "...ルナーフォースの 真の力を 見せてやれ！";
    text[7458] = "きっと お前たちの 帰りを 待っているぞ";
    text[7459] = "ありがとう パパ！";
    text[7461] = "あのね レイン...";
    text[7462] = "ああ 言わなくても わかるわ\nそれは任せて 天才ちゃん";
    text[7463] = "この人たちは ルナーに しっかりと 連れ帰るわ";
    text[7464] = "...それが済んだら すぐ ここに 戻るからね！";
    text[7465] = "ただし ワタシと 後で リマッチしなさい！  こんなやつに 負けたら 承知しないわよ！";
    text[7466] = "ニックルと テトラが いれば 勝てない 相手なんて いないわ！";
    text[7467] = "でしょ？";
    text[7468] = "もちろん！";
    text[6853] = "さあ！";
    text[6862] = "これが 最後の ミッションよ！";
    text[6863] = "準備は いい ニックル？";
    text[6864] = "いつでも オーケーさ！";
    text[6865] = "テトラ？";
    text[6866] = "究極完全体アシスタント・ロボ テトラは 準備万端よ！！";
    text[6867] = "ようし それじゃあ 構えて！";
    text[6868] = "ハァ... ハァ...";
    text[6869] = "勝った...の？";
    text[6870] = "グアアアァァァ...";
    text[6871] = "そんな...";
    text[6872] = "まだ 力が 残っているだと...";
    text[6873] = "あと... 少しなのに...";
    text[6874] = "ハァ... ハァ...";
    text[6875] = "体が もう... 限界よ...";
    text[6876] = "テトラ... あと どれくらい エネルギーが 残ってるの？";
    text[6877] = "飛ぶことは できる？";
    text[6878] = "少しならね... もう エネルギーは ほとんど ないわ...";
    text[6879] = "なら ニックルを 連れて ここから出て！";
    text[6880] = "何言ってるの！？  イヤよ！";
    text[6881] = "あなたを 置いてなんか いかないわ";
    text[6882] = "そうさ 最後まで 一緒にいるんだ";
    text[6883] = "テトラ... ニックル...";
    text[6884] = "危ない！  エネルギーシールドを！";
    text[6885] = "ホロシールド！";
    text[6886] = "ハァ... ハァ...";
    text[6887] = "うう... シールドが... 破られる！";
    text[6888] = "フォトンバリア！";
    text[6889] = "レイン隊だわ！";
    text[6890] = "待たせたわね ベラ！";
    text[6891] = "さあ アンタたち！  シールドを 出して！";
    text[6893] = "了解！  ミネラルシールド！";
    text[6894] = "プラズマリング！";
    text[6895] = "ああ もう このマーク ちょっと ヤバすぎ なんじゃないの！";
    text[6896] = "アンタたち こいつを 怒らせすぎたんじゃ なくって！？";
    text[6897] = "集中して レイン！\nできるだけ 長く シールドを 保つのよ！";
    text[6898] = "破られたら... みんな 丸焦げに なっちゃうわ！  なんとかして 耐えないと！";
    text[7471] = "ハアアアアァァァーーーッ！！";
    text[6902] = "...ベラ！";
    text[6903] = "起きて ベラ！";
    text[6901] = "みんな...";
    text[6899] = "ルナーに 戻ってる... 一体 何があったの？";
    text[6900] = "わからない... 突然 ワームホールに 落ちたと 思ったら ここに 飛ばされたんだ";
    text[6824] = "リーブス？  ナイラさん？  セレスティアを 使ったの？";
    text[6825] = "いいや 違うよ！\nボクらも ワームホールに 落ちたんだから...";
    text[6826] = "...！？";
    text[6904] = "サロスだわ！  みんな 構えて！";
    text[6907] = "どうやら 間に合ったようね";
    text[6909] = "...クロノス！？";
    text[6910] = "(このマークは... もしや！？)";
    text[6911] = "ええ... このマークは 味方なの？\nしかも しゃべれるわけ！？";
    text[6912] = "何は ともあれ ありがたいわね！";
    text[6913] = "クロノス... 助けてくれて ありがとう\nでも どうやって...？";
    text[6914] = "話は後よ";
    text[6915] = "今は 目の前の 任務に 集中するの";
    text[6916] = "ベラ...";
    text[7486] = "もう ほとんど 限界なのは わかるわ...";
    text[7487] = "今の あなたは もう 力を 使い果たして...";
    text[7488] = "...立っているのが やっとでしょう";
    text[7495] = "まあね...";
    text[7496] = "多分 他の みんなも 同じよ...";
    text[7489] = "ただ それでも 今は... 立ち向かうのよ！";
    text[7490] = "どうやら サロスは 他の マークよりも 反物質を 早く 生成できる みたいね...";
    text[7491] = "なら 倒す方法は 1つだけよ...";
    text[7492] = "みんなで 力を合わせて 強力な一撃を おみまいするの！";
    text[6918] = "...彼の 反物質コアに 直接ダメージを 与えられる だけのね";
    text[7494] = "あなたたち そのジェットスーツに プラズマレセプターは 備わっている かしら？";
    text[7503] = "ええ！";
    text[7499] = "そのレセプターを 用いれば ルナーフォースの 兵器で 生成された";
    text[7504] = "プラズマ発射体の 威力を 増すことが できるわ";
    text[7500] = "どうやら あなたは 我々の テクノロジーを とても よく 知っている らしいな";
    text[7501] = "マークに される前は ルナーフォースに いたのか？";
    text[7502] = "......";
    text[7505] = "まあ そんなところよ";
    text[7506] = "それじゃあ みんな！";
    text[7507] = "ありったけの 力を込めて いくわよ！";
    text[7508] = "フォトンキャノン！";
    text[7493] = "ダメ...";
    text[7509] = "これ以上は...";
    text[7510] = "強すぎて...";
    text[7511] = "ハァ... ハァ...";
    text[6924] = "ベラーーーーーッ！";
    text[6925] = "キミなら できるよ ベラーーーーーッ！";
    text[7476] = "その声... 聞き覚えが あるわ！";
    text[7477] = "メット！？";
    text[7483] = "ウェヘー！  それだけじゃないよ！\n兵士や 他の人たちも みんな おそろいさ！";
    text[7484] = "でも そんな所で 何を？";
    text[7472] = "さっき 一部の 兵士が ルナー中で";
    text[7473] = "仲間を 集めているという 報告を 受けたわ！";
    text[7474] = "今まで サロスに 従っていた 兵士たちが こっちに 加わって くれたんだ！";
    text[7475] = "それどころか 一般市民まで 協力してくれてるよ";
    text[7485] = "ベラ！";
    text[7479] = "これだけの人が 集まったのは みんな 正義のために 戦う覚悟が あるからさ！";
    text[6927] = "そして キミは ボクに 恐怖に 立ち向かう 勇気を くれた！";
    text[7478] = "...そして みんなに 未来を 信じる 希望を くれたんだ！";
    text[6926] = "だから あきらめちゃ ダメですよ ベラ隊員！";
    text[7480] = "気を 強く持って！";
    text[7481] = "さあ ここで サロスと 決着を つけるんです！";
    text[6929] = "...！";
    text[6930] = "この力は 一体...！？";
    text[6931] = "あなたの ラックスの 力よ！";
    text[6932] = "ルナーの 人々は... あなたを 信じている";
    text[6933] = "彼らの 希望... 決心... ラックス...";
    text[6934] = "...それが あなたに 力を 与えているのよ";
    text[6935] = "さあ それを 使いなさい";
    text[6936] = "その力で 愛する ルナーの 地を... 人々を 守るのよ";
    text[6937] = "それが あなたに 与えられた 使命";
    text[6938] = "民の心を 1つにして 希望を もたらすの！";
    text[6922] = "人の 魂の力は 無限大よ！";
    text[6940] = "さあ みんな やるわよ！";
    text[6941] = "任せなさい ベラ！";
    text[6942] = "でいやあああぁぁぁーーーっ！";
    text[7512] = "いけるわ！";
    text[7513] = "少しずつ 押し返してるぞ！";
    text[6943] = "(すごい... みんなの ラックスが 合わさって 巨大な エネルギーに なってる！)";
    text[6944] = "(これで 終わりよ... サロス)";
    text[6945] = "受けてみなさい！\nラックスの 真の力を！";
    text[6946] = "終わった...";
    text[6947] = "ついに やったわね！  ガッハッハッハ！";
    text[6948] = "サロスの 反物質コア...";
    text[6949] = "壊した方が いいかしら？";
    text[6950] = "いいえ... まだ 魂が 中に 入ってるわ";
    text[6951] = "今は... そのままに しておきましょう";
    text[6952] = "もう ルナーを 脅かす力は ないでしょうしね";
    text[6953] = "皆さん... 少しだけ お話をしても いいかしら？";
    text[6954] = "この形ではなく ね...";
    text[6955] = "ちょっとばかり 待ってちょうだい...";
    text[6956] = "この姿に 戻る練習は しばらく してなかったから...";
    text[6957] = "...！？";
    text[6960] = "ママ！？";
    text[6961] = "グレイ将軍！";
    text[6962] = "シアーーーッ！";
    text[6963] = "こんにちは 皆さん";
    text[6964] = "ママ 会いたかったわ...";
    text[6965] = "ワタシもよ ベラ...";
    text[7532] = "シア... 本当に お前なのか...";
    text[6966] = "トーマス... また 会えて うれしいわ";
    text[6967] = "ママ...";
    text[6968] = "...今まで どうやって ファントムスペースで 生きていたの？";
    text[6969] = "もう 死んでしまったものと...";
    text[6970] = "あの日... ワタシは サロスの 実験を 知った";
    text[6971] = "彼の 研究室を 見つけたら すぐに 止めてやる つもりだったわ";
    text[6972] = "でも 戦いの中で 一瞬のスキを 突かれ...";
    text[6973] = "...ワームホールマシンで ファントムスペースに 飛ばされて しまったの";
    text[6974] = "その当時 ファントムスペースにいる マークの数は ずっと 少なかった";
    text[6975] = "...だから ワームホールから 脱出することは 不可能だった...";
    text[6976] = "そうなると 残された手は 1つだけだった";
    text[6977] = "ワームホールに 飛ばされる 直前...";
    text[6978] = "開発中の マーク血清を 1つ 何とかして 取っていたの";
    text[6979] = "自分の体が 崩壊するまで たった 72時間しか なかった";
    text[6980] = "だから...";
    text[6981] = "...血清を 摂取したのよ";
    text[6982] = "...そして あなたたちが クロノスと呼ぶ マークになったの";
    text[6983] = "それが 生き残るための 唯一の 方法だった...";
    text[6984] = "それで どんな感じ だったんだい？";
    text[6985] = "マークの 体の中で 意識は あったのかい？";
    text[6986] = "マークになった ばかりの 時は... 体を うまく コントロール できなかったわ";
    text[6987] = "でも 心は... 魂は しっかりと 意識を 保っていたのよ";
    text[6989] = "ママ あなたは 本当に 強い人よ";
    text[6990] = "そんな目に 遭っても 耐えられるのは... あなた以外に いないわ";
    text[6994] = "ワタシに ラックスの力が 現れ始めた時";
    text[7516] = "自分に 何が 起きているのか わからなかった...";
    text[6992] = "...マークに 遭遇するたびに 魂の奥に 響く 何かを 感じていたの";
    text[7517] = "ワタシの ラックスは すべての マークに 反応していた";
    text[6993] = "彼らの声が 聞こえたの 助けを呼ぶ 声が...";
    text[6991] = "ママも 何とかして 私と コミュニケーションを 取ろうと してくれてたのね...";
    text[6995] = "あなたが ソウルセンスを 覚醒させたのには ワタシも 驚いたわ";
    text[7017] = "ワタシが 古代人の 血筋について あなたに 何も 言わなかったのは...";
    text[7018] = "...いろいろ 研究した結果 その力が 覚醒したら";
    text[7019] = "キケンだと 気づいたからよ";
    text[7518] = "そして 自分の娘を キケンな目に 遭わせたく なかったの";
    text[7020] = "グレイ将軍... あなたの 話し方 まるで ベラみたいですね...";
    text[7021] = "ベラは 他の人に 重荷を 背負わせたりは しない...";
    text[7022] = "いつだって みんなを 守ろうと するんです";
    text[7023] = "一体 どっちからの 遺伝なんでしょうね？";
    text[7024] = "トーマス博士も そんな感じよ！";
    text[7025] = "おいおい やめたまえ！";
    text[7026] = "ウフフ... ひょっとしたら 両方かも しれないわね";
    text[6996] = "ママ コーダ彗星の件は 知ってる？";
    text[6997] = "ええ";
    text[6998] = "あなたが ワタシの 反物質コアを 運んでいた時 話を 聞かせて もらったわよ";
    text[6999] = "いつも耳を そば立てて いたんだからね";
    text[7003] = "ちょっと待ってください\nあなたは 反物質コア だったんでしょう？";
    text[7004] = "じゃあ どうやって また マークに 戻ったんですか！？";
    text[7005] = "ガーディアという 古代の 守護者が 力を 貸してくれたの";
    text[7056] = "今 ここに いるのは ある意味で 奇跡よ...";
    text[7007] = "そして ベラ あなたの おかげで また こうして みんなに 会うことが できたわ";
    text[7008] = "あなたの 優しさと 平和に 対する 決意...";
    text[7009] = "そして 正義を貫く 意志の おかげでね";
    text[7010] = "あなたみたいな 娘を持って 本当に 誇らしいわ ウフフ";
    text[7032] = "皆さん...";
    text[7027] = "...ネメシスによって 人類が 滅亡することが あっては なりません";
    text[7028] = "大丈夫です！";
    text[7029] = "そんなことは ゼッタイに させないわ！";
    text[7030] = "ええ このレインが ありったけの 力で パンチを ブチ込んで やるんだから！";
    text[7031] = "ガッハッハッハ！";
    text[7033] = "人類は 負けない！\nでしょ ニックル？";
    text[7034] = "もちろんさ！";
    text[7035] = "シアさん... その昔 助けて いただいて 本当に ありがとう ございました";
    text[7036] = "ここまでの 道のりは 本当に 辛かった...";
    text[7520] = "ずっと 心を 閉ざしていて...";
    text[7521] = "あなたや ベラに 出会わなければ...";
    text[7522] = "人を 信じることも できなかった...";
    text[7523] = "そうしたら すべてが サロスの 思惑通りに なっていた かもしれない";
    text[7524] = "何もかも 違う世界に なっていた かもしれない...";
    text[7525] = "でも みんなが オレを 受け入れてくれた";
    text[7526] = "ああいう過去が あるにも かかわらず...";
    text[7527] = "ニックル... あなたは まず 自分自身を 赦すべきよ";
    text[7528] = "マークの 存在は あなたの せいじゃない";
    text[7529] = "むしろ あなたは よくやったわ\n自分が 成し遂げたことを 誇りに 思うべきよ";
    text[7530] = "そう言って もらえると 救われるよ シアさん";
    text[7037] = "...これから ベラが 厄介ごとに 巻き込まれないよう しっかりと 見守ってあげてね";
    text[7038] = "も もちろんさ！";
    text[7039] = "それで...";
    text[7040] = "...このかわいらしい 戦士さんは 誰かしら？";
    text[7041] = "テトラよ！";
    text[7042] = "ベラから あなたの ことは いっぱい 聞いてたわ！";
    text[7043] = "ワタシと ベラは いつだって 最強の コンビ なんだからね！";
    text[7044] = "テトラは ワタシと ベラで 一緒に 作ったのだ";
    text[7045] = "お前が いなくなってから... 本当に 辛かった";
    text[7046] = "そんな 暗い心を テトラは 明るく 照らしてくれた...";
    text[7047] = "この子が いたおかげで あの苦しい 日々に 一家の絆は より強く なったのだ";
    text[7048] = "エッヘッヘ";
    text[7049] = "なるほど... なら あなたは 昇進に 値するわね テトラ";
    text[7050] = "昇進！？  ワタシを！？";
    text[7051] = "あなたは ただの アシスタント・ロボじゃないわ";
    text[7052] = "本物の ヒーローよ";
    text[7053] = "本物の ヒーロー...";
    text[7054] = "じゃあ これからは リアルヒーロー アシスタント・ロボ テトラと 名乗ってもいいのね！";
    text[7055] = "アハハハ...！";
    text[7011] = "ど どうしたんだ？";
    text[7012] = "この体は... かりそめの ものよ";
    text[7013] = "だから もうすぐ 反物質コアに 戻ってしまうわ...";
    text[7014] = "ダメよ ママ... みんなを 置いていかないで...";
    text[7015] = "ベラ...";
    text[7016] = "...忘れないで いつだって 希望はあるわ";
    text[7000] = "あなたは 本当に 強くなった";
    text[7001] = "サロスが いなくなった 今 ルナーには 次の将軍が いるわ";
    text[7058] = "なら ママは？";
    text[7059] = "ワタシは もう 過去の 人間よ\nこれからは あなたが ルナーを 導くの";
    text[7060] = "大丈夫 あなたなら できるわ";
    text[7061] = "それだけの 力を しっかりと 持っているもの";
    text[7062] = "皆を 団結させる力... 勇気を 与える力...";
    text[7063] = "...そして 明るい 未来に 導く 力をね";
    text[7064] = "あなたは ワタシの 誇りよ ベラ";
    text[7065] = "ママ...";
    text[7066] = "大丈夫 ママの 期待には しっかりと 応えるわ！";
    text[7067] = "シア...";
    text[7068] = "トーマス... 今も あなたを 愛しているわ... ベラを よろしく 頼むわね";
    text[7069] = "ワタシは しばらく 休むから...";
    text[7070] = "ああ... 約束するとも...";
    text[7071] = "そして いつの日か お前を 元に 戻してみせる";
    text[7073] = "それじゃあ 皆さん\nいつの日か また 会いましょう！";
    text[7074] = "さようなら...";
    text[7075] = "大丈夫 ベラ？";
    text[7076] = "ええ";
    text[7078] = "何年ぶりに ママの 姿を 見れて うれしかったわ";
    text[7534] = "ママは 永遠に ワタシの ヒーローよ";
    text[7535] = "だから 悲しくなんかないわ...";
    text[7536] = "むしろ 今は 心の中が 希望で いっぱいよ";
    text[7537] = "みんな 今日は 本当に よく やってくれたわ！";
    text[7538] = "ここにいる 全員の おかげで ワタシたちは 勝利したのよ";
    text[7539] = "じゃあ ここらで ちょっと 新しい 将軍の 初の功績を たたえて あげないとね";
    text[7540] = "そうね！  ベラなしでは きっと ここまで 来れなかったんだから！";
    text[7542] = "そうと 決まれば パーティよ！\nガッハッハッハ！";
    text[7543] = "ああ～ チーズケーキバー 食いたい... 腹が減って 死にそうだよ！";
    text[7544] = "...ワタシは 眠りたいわ！  もう 足が ガクガクよ...";
    text[7545] = "まあ まずは 良く休んだ方が いいんじゃないかしら";
    text[7546] = "それから...";
    text[7550] = "みんなで お祝いしましょ！";
    text[7089] = "ワタシたちの 今日の 勝利は...";
    text[7090] = "...新しい 時代の 象徴よ";
    text[7092] = "そして これからも 旅は続くの...";
    text[7093] = "...まだ やるべき 仕事が 残って いるからね";
    text[7094] = "コーダ彗星は 今も 近づいているわ...";
    text[7095] = "そして 今度は... それに 備えなくちゃいけない";
    text[7096] = "この先の 道のりは 険しいし...";
    text[7097] = "まだまだ 学ぶべきことは たくさんあるわ...";
    text[7098] = "古代人...";
    text[7099] = "ネメシス...";
    text[7100] = "でもね 1つ 確かなことは...";
    text[7101] = "ルナーは ワタシたちの 故郷だと いうことよ";
    text[7102] = "だから 何が何でも ここを 守るの！";
    text[7103] = "生き抜く道を 探すのよ";
    text[7104] = "...みんなで 力を合わせ\nお互いを 支え合ってね";
    text[7105] = "ラックスの輝きよ 永遠なれ！";
    text[7106] = "8か月後...";
    text[7107] = "グレイ将軍 準備が 整いました";
    text[7108] = "報告どうも！\nじゃあ いよいよね";
    text[7109] = "ニックル司令官 反物質エンジン 準備オーケーです";
    text[7110] = "それで 本当に 大丈夫なわけ ニックル？";
    text[7111] = "おうよ  まあ 今までで 一番でかい ワームホールに なるだろうがな";
    text[7112] = "でも 大丈夫だ";
    text[7113] = "オレを 信じてくれ";
    text[7114] = "わかったわ\nそれじゃあ いくわよ！";
    text[7115] = "セレスティア 起動！";
    text[7116] = "了解！";
    text[7117] = "さあ ベルトを締めて コーダ彗星に 座標を合わせて...";
    text[7118] = "覚悟しなさい ネメシス...";
    text[7119] = "...人類は こんなところで 負けないんだからね！";
    text[110000] = "さあ 行くわよ！";
    text[110001] = "船は 南東の ホバーポートに 停めてあるわ！";
    text[110003] = "わあ どれも おいしそう！";
    text[110004] = "ふう ハイパービー 手強かったわね！";
    text[110007] = "カフェで チーズケーキバーでも 買っていきましょ！";
    text[110008] = "まだ 食べ終わってないわ！  もう少し ゆっくりしていきましょ";
    text[110009] = "わかったわ";
    text[110010] = "ここの人たちは みんな フレンドリーだし おしゃべりしてみるのも いいかもね";
    text[110012] = "さあ 船のところに 行きましょ！";
    text[110013] = "西に向かって バリア施設の 辺りを 調べましょ！";
    text[110014] = "パイロットが 無事だと いいんだけど... 怖そうな マークだったわ！";
    text[110015] = "ベラ　最近 あなた なんだか変よ";
    text[110016] = "心配しなくていいわ... 大丈夫よ";
    text[110017] = "今の 酸素レベルは 97％よ！";
    text[110018] = "一体 何があったのか 調べてみましょ！";
    text[110019] = "2体の マークが 通り過ぎたわ！  探しに行きましょ！";
    text[110020] = "マークは 仲間が 殺されて とても 怒っていたわ...";
    text[110021] = "まだ この辺にいるはずよ...";
    text[110022] = "何とかして 探しましょう！";
    text[110023] = "この辺りに ルナーパネルについて 知っている人が いるはずよ";
    text[110024] = "まあ 全員 しらみつぶしに 話しかけたら きっと誰か 知ってるでしょうね";
    text[110025] = "いや ちょっと待って";
    text[110026] = "一人一人に 話しかけてる ヒマなんて ないでしょ";
    text[110027] = "それは そうだけど...";
    text[110028] = "ああ いいこと 思いついた！\nちょっと ミッションガイドシステムを オンにするわね！";
    text[110029] = "ええ そんなもの インストールしたかしらね？";
    text[110030] = "きっと パパが プログラムして 組み込んだのね";
    text[110031] = "そのシステムはね イベントの 目印なんかを 出してくれるのよ";
    text[110032] = "おかげで 特定の人や 物の上に 「！」マークサインが 表示されるわ";
    text[110033] = "本当に 便利な 機能なんだから！";
    text[110034] = "「！」マークサインの 中には ワタシたちの 助けがいる人を 示してくれる ものもあるわ";
    text[110035] = "ゲームの世界で よく 「サイドクエスト」と 呼ばれるやつね";
    text[110036] = "...へぇ なるほどねえ";
    text[110037] = "その機能は さっきの モラキュロイドも 特定してくれてたわけ？";
    text[110038] = "ええ そうよ！\nゲーム中は いつでも オンになってる 機能だからね エヘヘ";
    text[110039] = "ワタシたちが 探している人の 上には 黄色の サインが 出ているはずよ！";
    text[110068] = "やったあ！  これで ルナーパネルが 10枚揃ったわ！";
    text[110069] = "あとは サーモエレキ・ジェレネーターね...";
    text[110070] = "ナイラさんいわく アストロテック商人が 持ってるらしいわ！";
    text[110071] = "だから 今から バリア施設に 行きましょう！";
    text[110066] = "ついに 10枚の ルナーパネルと  サーモエレキ・ジェネレーターを 手に入れたわ！";
    text[110067] = "ナイラさんの所に 行きましょう！";
    text[110040] = "ルナーパネルさん ルナーパネルさん どこいるの～？";
    text[110041] = "倉庫から ルナーパネルを 10枚 手に入れて";
    text[110042] = "アストロテック商人から サーモエレキ・ジェレネーターを 1つ 買いましょ！";
    text[110043] = "アストロテックは バイトよりも レアな通貨よ";
    text[110044] = "いろんな所を 注意深く 調べたら";
    text[110045] = "見つけられるかもね！";
    text[110046] = "拾えるものには 常に 目を光らせておくのよ！";
    text[110047] = "ホバークラフトの 所で みんなに 会いましょ！";
    text[110048] = "ベラ 準備ができたら 船に戻りましょ！";
    text[110049] = "テトラは 今 ここには いない";
    text[1021] = "ここでは 正確なデータを 受信できないわ...";
    text[1022] = "そして この場所の 空気と 土の 化学組成は 不明よ";
    text[1023] = "正直 どうして 息ができるのかも わからないわ...";
    text[1380] = "ベラ 急いで 脱出する道を 探しましょう！";
    text[110050] = "ルナー宇宙ステーションは とっても 広いから 迷子に ならないようにね！";
    text[110051] = "研究室は 3階よ！";
    text[110052] = "エレベーターに 乗ったら そこから 西の通路に 向かってね！  さあ 行きましょ！";
    text[2482] = "ねえ オシアナスで 何する つもりなの？";
    text[2543] = "トーマス博士に 考えを 説明しましょ！  すぐに 宇宙ステーションに 戻るわよ！";
    text[110053] = "コペルニクスで マークが 大発生してるわ！";
    text[110054] = "緊急事態よ 助けなくっちゃ！";
    text[110055] = "できるだけ 多くの人を 助けられるように がんばるわよ！";
    text[2709] = "4つの フィルタマシンを 修復して 水道ネットワークを 元に 戻すわよ！";
    text[2978] = "さあ 水道局の 屋上に 行って";
    text[2979] = "マークスレイヤーと 話をするわよ！";
    text[3206] = "ベラ... あなた 少し疲れてない？\n今日は もう 休んだ方が いいんじゃないの？";
    text[3207] = "お部屋に 戻って もう寝ましょ！";
    text[3854] = "トーマス博士が 研究室で 何をしているか 見に行きましょ！";
    text[3855] = "新しい ミッションが あるか チェックしましょ！";
    text[3856] = "1階の ロビーに行って ステラと 話をしましょ！";
    text[3857] = "どうやら いくつか 公開されてる ミッションが あるみたいよ！";
    text[3858] = "ミッションの 内容を 詳しく 知りたい場合は";
    text[3859] = "ステラと 話してから ミッション掲示板を チェックすると いいわ";
    text[3860] = "あと ミッションに 関係する 人や 場所には 赤いサインが 表示されるからね！";
    text[4201] = "トーマス博士の 会議が 終わったみたいよ！";
    text[4202] = "研究室に 行って 話をしましょ！";
    text[4203] = "基地の カードキーを 手に入れたわ！\nさあ 軍事基地に 入りましょう！";
    text[4204] = "軍事基地は 荒野ゾーンよ！\nそれじゃあ レッツゴー！";
    text[4236] = "下水道エリア... おえ～っ！";
    text[4237] = "ワタシだって イヤだけど 他に道はないわ...";
    text[4248] = "囚われている マークスレイヤーを 見つけましょ！";
    text[4293] = "まずは 緑のドアに つながっている 制御パネルを 探さないとね";
    text[4307] = "マークスレイヤーが 緑のドアの 部屋にいるか 確かめましょ！";
    text[4291] = "マークスレイヤーは 軍事基地の どこかの部屋に いるはずよ";
    text[4292] = "あらゆる場所を トコトン 調べましょ！";
    text[4512] = "急いで 軍事基地から 逃げるわよ！\nまずは 1階を 目指しましょ！";
    text[4518] = "ここから西にある 「永遠の闇」 クレーターに 向かうのよ！";
    text[110056] = "ヴィヴィアが 動けないうちに この場を 脱出するのよ！";
    text[110057] = "シリカ峡谷に 着いたなら 向かうべきは 東のコロニーだ";
    text[110058] = "ああ！\nワタシの アシスタント・ロボの 仕事 奪わないでよ！";
    text[110059] = "サイファーに 会って 宇宙船の 件を 聞いてみましょ！";
    text[110060] = "ああ 前の船が 恋しいわ...";
    text[110061] = "でも 軍事基地の前に 置いてきて しまったものね...";
    text[110062] = "後で 回収すればいいさ";
    text[110063] = "そうよ！\nそれに 今は フル充電された ミニポッドが あるでしょ！";
    text[110064] = "そうね...";
    text[110065] = "...まあ とにかく ニックルの 隠れ家は オシアナスよ！\n準備ができたら すぐに行きましょ！";
    text[110072] = "どうやら これから 泳ぐことになる みたいね...";
    text[110073] = "ニックルの 隠れ家は 水の下に あるんだもの！";
    text[5486] = "わあ 辺り一面 光る岩石で いっぱいね！";
    text[5487] = "これだけ 明るいと 照明すら いらないわね 助かるわ！";
    text[5501] = "この遺跡にある 4つの 宝石を 探しましょ！";
    text[5502] = "それが 全部そろったら テトラは きっと";
    text[5503] = "ソウルセンサーの アシスタント・ロボとして 歴史に 名前が 残るわ！";
    text[5504] = "ところで ベラ...";
    text[5505] = "え？";
    text[5506] = "ソウルセンサーって 何？";
    text[5507] = "つまり 「魂を 感じる者」...？  正直なところ ワタシも よく わからないわ...";
    text[5508] = "...まあ まずは 「魂の試練」とやらを クリアしましょ！";
    text[5509] = "そうね エヘヘ...";
    text[6001] = "ついに 魂の試練を クリアしたわね！";
    text[6002] = "これで 道を 塞いでいた あのゲートを 通れるわ！";
    text[6209] = "それで オレは どこで 寝るんだ？";
    text[6210] = "ええっと... ワタシの 部屋じゃないの？";
    text[6211] = "ええ！？\nでも それって...";
    text[6212] = "...なあに ワタシの 部屋じゃ イヤなの？";
    text[6213] = "なら 治療室の 睡眠ポッドを 使ってもいいのよ";
    text[6214] = "いや その...";
    text[6215] = "ええっと この宇宙ステーションの 道は よくわからねえからな...";
    text[6216] = "迷子になると いけねえし... その点は 一緒にいた方が いいだろう...";
    text[6217] = "ハァ... なら つべこべ 言わずに 来なさい";
    text[6218] = "...でも 本当に いいのかい？";
    text[6219] = "お前は どこで 寝るんだ？";
    text[6220] = "床で いいわよ\nフカフカの カーペットだし";
    text[6221] = "ああ もう 変な 心配は しないで ニックル！";
    text[6222] = "あなたは お客さんなんだから！\nベッドは あなたが 使うの！";
    text[6223] = "あと... テトラも ベッドで 寝るから...";
    text[6224] = "ああ なら いいや\nやっぱ 床で寝る";
    text[6225] = "ええ！？\nなんで いきなり 心変わりしたわけ？";
    text[6226] = "オレの手は 睡眠中に 熱くなることが あるんだ";
    text[6227] = "近くに 金属があったら 溶かしちまうかもしれない";
    text[6228] = "っていうか そもそも... ロボットって 寝るのか？";
    text[7126] = "ルナー宇宙ステーションが 攻撃されているわ！";
    text[7127] = "辺りにいる マークを 見つけ出して 倒しましょ！";
    text[7192] = "部屋に 何か 忘れ物してるんじゃ なくって？";
    text[7245] = "サロスの オフィスは 奇妙なほど 静かだわ";
    text[7246] = "警戒しながら 進もう\n何か 罠の 臭いがするぜ";
    text[7389] = "サロスの ワームホールマシンは セレスティアに とても 似ているわ";
    text[7390] = "もっと 近くに 寄って 見てみましょ！";
    text[7391] = "サロスは トーマス博士を ファントムスペースで 人質に しているわ！";
    text[7392] = "それに オレが集めた 反物質コアも そこに あるはずだ...";
    text[7393] = "やつを 探し出して 決着を つけるぞ！";
    text[7438] = "...";
    text[7552] = "今日は 絶好の 冒険日和ね！";
    text[7553] = "ルナーフォースの ミッション掲示板を チェックして ミッションを こなすのは どうかしら？";
    text[7554] = "...それか 強いマークを 探してみるのも いいかもな！";
    text[7555] = "ちょうどいい トレーニングに なりそうだ";
    text[7556] = "あんまり ブランクが 続くと 体が なまっちまうからよ！";
    text[7557] = "なら 両方ってのは どう？";
    text[7558] = "それから カフェで まったりして チーズケーキバーを 食べるのよ！";
    text[7559] = "ああ～ん たまんな～い！";
    text[257] = "ベラ ガラスの壁の 向こうに スキルブースターが あるわ！";
    text[258] = "あら ホント！  これはうれしいわね！";
    text[259] = "でも どうやったら あそこに 行けるかしら？  別の入り口が あるとか？";
    text[260] = "光学ズームを 使ってみるわね！";
    text[261] = "25％... 50％...";
    text[262] = "75％...！";
    text[263] = "ウーン...";
    text[264] = "ああ！";
    text[265] = "カプセルエレベーターの スイッチに 小さなラベルが 見えるわ";
    text[266] = "それで 何て？";
    text[267] = "バリア施設 - 貨物置き場";
    text[268] = "なるほど\nでかしたわよ テトラ！";
    text[269] = "裏口は バリア施設に あるんだわ！";
    text[245] = "待って マークが 行ったのは 別の方角よね...";
    text[246] = "他のポータルを 使いましょ！";
    text[247] = "マークは まだ この辺にいるはず";
    text[248] = "何とかして 探しましょう！";
    text[1337] = "捨てられた ハーツ・キューブだ";
    text[1338] = "通常 お金や 貴重品を 安全に 保管するために 使われる";
    text[1335] = "このハーツ・キューブは ロックされている ようだ";
    text[1336] = "ウーン... レーザーを 当てたら 開いたりする かしらね？";
    text[568] = "わあ ステキ！  このライトは 熱ルミネッセンスの 原理を 応用してるみたいね";
    text[569] = "え！？  ね 熱ルミ...？";
    text[570] = "この世にはね 熱を加えると 光る石が あるのよ！";
    text[571] = "へえ なんだか すごいわね！";
    text[575] = "あら どうやら おいしい食べ物が 届いてるみたいね！";
    text[576] = "ああ～ そう言われたら 急に お腹が すいてきたわ！";
    text[577] = "ええ？ でも あなた 人間の ごはんなんて 食べられないんじゃ なくって？";
    text[578] = "まあね... でも 他に 欲しいものが あるのよ";
    text[579] = "例えば？";
    text[580] = "それはナイショ！  エヘヘ...";
    text[581] = "淹れたての コーヒーだ";
    text[582] = "まだ パパを カフェ・レゴリシアに 連れてきたことは なかったわね";
    text[583] = "ここの コーヒー とっても おいしいって 評判なのよ！";
    text[584] = "あのねぇ これ以上 あの人に コーヒー飲ませちゃ ダメでしょ！ 今でも コーヒー中毒なのに！";
    text[592] = "コンテナには 小さなメモが 貼られている";
    text[593] = "入力その1 - 左";
    text[594] = "ええっと ベラ\nそれ どういう意味なの？";
    text[595] = "さあ...でも 覚えておいて 損はないかもね";
    text[596] = "同じような メモがないか 注意してみましょ！";
    text[597] = "そういうことなら この名探偵 アシスタント・ロボの テトラに 任せて！";
    text[784] = "ベラ...？";
    text[785] = "え？";
    text[786] = "何でそんなに ゴミ箱ばっかり 調べるの？";
    text[787] = "エヘヘ...";
    text[788] = "ただ... ちょっと 気になるだけ...";
    text[789] = "そういうのを ゴミ漁りって 言うんじゃないの？";
    text[790] = "...テトラ";
    text[791] = "な～に？";
    text[792] = "このこと ゼッタイに 人には 言わないでよね";
    text[793] = "ええ もちろんよ～！";
    text[1058] = "この自販機の 人気スナックは 売り切れのようだ";
    text[1059] = "ああ～ん チーズケーキバー 食べたかったのに～";
    text[1060] = "サクサクバーなら まだあるわよ！";
    text[1061] = "イヤ";
    text[1062] = "それじゃダメなの";
    text[1327] = "ベラ！  今 流れ星が 見えたわ！";
    text[1328] = "キレイだったわねえ！\nあんなものが 見れて すごくラッキーだわ！";
    text[1329] = "ラッキーイベント: 次に ゲットする アイテム または お金の量が 2倍になります！";
    text[1330] = "そのため よく考えて アイテムを 手に入れましょう！";
    text[1331] = "発動可能な ラッキーイベントは チャプターごとに 1つだけです！";
    text[1034] = "手持ちの 反物質コアが 何かに 反応しているようだ";
    text[1332] = "ウーン この壁の 模様 何だか ヘンねえ... また後で 調べてみましょう";
    text[1581] = "ベラの 反物質コアが 壁の模様に 反応しているようだ";
    text[1582] = "...！？";
    text[1819] = "あら！  新しい フードマシンが 設置されてるわね";
    text[1820] = "「F.O.O.D. v3.」ねえ...";
    text[1821] = "ええ～！！  ゼッタイ前の 「YUMMY 5000」って 名前の方が 良かったのに";
    text[1822] = "まったくだわ！";
    text[1823] = "それで 「F.O.O.D.」って 何の 頭文字から きてるわけ？";
    text[1824] = "さあ...";
    text[1825] = "でも 少なくとも 千種類の 新メニューが 追加されたみたいよ！";
    text[1826] = "わあああっ それなら スパイシーな カレーでも 頼んでみようかしら！";
    text[1882] = "あれ？  ゴミ箱の中に 紙が入っているわ！";
    text[1883] = "143143";
    text[1884] = "なんだ ただの数字か...";
    text[1885] = "何かの パスワードかもね！  メモしておいた方が いいんじゃないかしら？";
    text[2004] = "ここで 作られた 様々な製品が 表示されている";
    text[2005] = "ええ！？  トーマス博士設計の 「究極のコーヒーマシン」 ですって？";
    text[2006] = "「指一本動かさず 極上のコーヒーを あなたのために お淹れします」";
    text[2007] = "「ただ 『コーヒーちょうだい』 とだけ言えば おいしいコーヒーが 目の前に！」";
    text[2008] = "「最高レベルの エスプレッソを あなたのご家庭で！」";
    text[2009] = "この宣伝記事 先週に 書かれたものね...";
    text[2010] = "ちょっと パパと 話をしなくっちゃ";
    text[2011] = "たくさんの 空っぽの コーヒーカップが 部屋の あちこちに 置かれている";
    text[2012] = "ところで コーヒーって どんな味 なのかしらね？";
    text[2013] = "苦いわ  パパは ブラックコーヒーが 好きなの";
    text[2014] = "苦いって どんな感じ？";
    text[2015] = "ああ そうか\nあなたには 味覚が ないものね";
    text[2016] = "そうよ！  だから 味覚オンチの アシスタント・ロボ テトラって 呼んでね！  フンッ！";
    text[2017] = "でもね テトラ... 食べる必要が ないなら 味覚なんて いらないと 思わない？";
    text[2018] = "そうねえ...";
    text[2019] = "あなたは その点 人間よりも はるかに たくましいのよ！";
    text[2020] = "ま... そういうこと なのかしらね";
    text[2034] = "ここは ワタシの 部屋よ！";
    text[1901] = "ご不便を おかけして すみませんが ルナー掲示板は 現在 利用できません ";
    text[1902] = "どうやら 科学者たちは 調査に追われて サーバーに 負荷を かけすぎたようね";
    text[1903] = "本当に？  どうして わかるの？";
    text[1904] = "だって ログに そう書いてあるもの";
    text[1905] = "なるほど じゃあ また後で 来ましょう";
    text[1906] = "制限区域 - アクセスが 拒否されました";
    text[1907] = "この先には 一体 何があるんでしょうね...";
    text[1908] = "ここで 生まれ育った ワタシにすら さっぱり わからないわ";
    text[1909] = "パパもママも ここには ゼッタイに 入れてくれなかったから";
    text[1910] = "まあ 多分 すごい科学研究でも してるんでしょうね";
    text[1912] = "この自販機は 故障しているようだ";
    text[1913] = "この 自販機は 缶入りの バナナを 売っている...";
    text[1914] = "ええ なんで...";
    text[1993] = "この ディスプレイには いろいろな プロジェクトの 目標や 締め切りが 表示されている";
    text[1994] = "どうやら チームの 作業は 遅れているようだ...";
    text[1995] = "締め切りが きついと ストレスが たまるわよね...";
    text[2098] = "トーマス博士が 書いた本が 何冊か 入っている";
    text[2099] = "その中かた 「ラックスの力」 という 本を 手に取って 読んでみた";
    text[2100] = "科学は 「ラックス」の名で 知られる 魂の存在を 認めた";
    text[2101] = "つまるところ ラックスとは 魂のエネルギーだ";
    text[2102] = "ラックスは 比較的 新しい 研究分野であるが そこで いくつかの 発見があった";
    text[2103] = "ラックスは 人間の 感覚 感情 意志 本能と 強く 結びついて いるのだ";
    text[2104] = "そして 他の人よりも 強いラックスを 持っている者も 中にはいる";
    text[2105] = "研究チームは ラックスの エネルギーは 自在に 操れる 可能性が あると 仮説を 立てている";
    text[2106] = "(これは ワタシが 感じていた 妙な感覚と 何か関係が あるのかしら？)";
    text[2107] = "(今度 パパと 話を しなくっちゃね...)";
    text[2123] = "何度も コーヒーを こぼしたようで 机には 茶色のシミが たくさん 見受けられる";
    text[2124] = "ママは この机を 捨てたがってたけど パパは イヤがってね ";
    text[2125] = "どうして？";
    text[2126] = "愛着が あるからよ";
    text[2127] = "パパは 何年も 毎晩 この机で アイデアを 練っていたの";
    text[2128] = "あと 本人いわく 机から コーヒーの 香りが するのが 好きなんだって... 呆れるわよね";
    text[2137] = "クローゼットには いろいろな ものが 入っている";
    text[2189] = "特に 目を引くものは 入っていない";
    text[2190] = "古いヨーヨーの コレクションを 見つけた";
    text[2191] = "「ベスト・アシスタント・ロボ ガイド101」という タイトルの本を 見つけた";
    text[2192] = "ああ... えっと それは...";
    text[2193] = "ワタシのよ\nここに入れたの 忘れてたわ";
    text[2194] = "もう テトラの バカ";
    text[2199] = "お気に入りの 水着を 見つけた";
    text[2200] = "今からでも ビーチに 行きたいわ...";
    text[2195] = "バニースーツを 見つけた";
    text[2196] = "アハハ これ 今でも 着れそうね！";
    text[2197] = "テトラ あなたの ハロウィーンの コスチュームは？";
    text[2198] = "ハッ 捨てたわ";
    text[2201] = "だって ニンジン だったんだもの！";
    text[2202] = "あの時は 遅かったせいで あれ以外 売り切れちゃってたからねえ...";
    text[2203] = "それで 今年は 何にするの？";
    text[2204] = "ウーン...";
    text[2205] = "ワタシが バニーちゃんで あなたが ニンジンってのは どう？  ウフフフ";
    text[2206] = "レギンスと  トレーニングウェアを 見つけた";
    text[2207] = "ああ そうだ 思い出した\n腕立てと 腹筋は 毎日やらないとね！";
    text[2208] = "ルナーアカデミーの 卒業証書を 見つけた！";
    text[2209] = "さらに チーズケーキ 早食いコンテスト 優勝の 賞状も 見つけた...";
    text[2210] = "服のポケットに チーズケーキバーが 入っていた";
    text[2211] = "ああ～ もうガマンできないわ";
    text[2212] = "黒帯の 道着を 見つけた";
    text[2541] = "今 この先に 用はないわ";
    text[5551] = "わあ 古代の バトルロボットね！";
    text[5552] = "ああ 実は 現代の バトルロボットや 兵器も";
    text[5553] = "古代人の テクノロジーを 元に 開発したものと 言われてるぜ";
    text[5554] = "大昔の テクノロジーを 分析した 科学者たちも とんでもなく すごいけどな";
    text[5555] = "現代人の 科学力も 侮れないってことね！  ウフフッ！";
    text[5560] = "七人の 英雄...";
    text[5561] = "英知の ティコ";
    text[5562] = "勇気の シリカ";
    text[5563] = "決意の コペルニクス";
    text[5564] = "慈愛の ルミナ";
    text[5565] = "正義の マグネシア";
    text[5566] = "自信の グリマルディ";
    text[5567] = "信念の レガリア";
    text[5568] = "この名前...";
    text[5569] = "コロニーの 名前だわ！";
    text[5570] = "七人の英雄...";
    text[5571] = "ルナーの コロニーが 開拓者に ちなんで 付けられたと いうのは 有名な 話だが...";
    text[5572] = "変だな... コロニーが 作られた時に";
    text[5573] = "古代人が いた記録は ないはずなんだが";
    text[5574] = "じゃあ ただの 偶然だって？";
    text[5575] = "さあ...";
    text[5576] = "コーダ彗星を 何とかしたら ぜひ 調べてみたい もんだな";
    text[3517] = "壁のそばに 盗んだ武器や 装備が 置いてある";
    text[3518] = "どうやら マフィアどもは 他の船と 連絡を 取ってる みたいね";
    text[3519] = "そう遠くない うちに";
    text[3520] = "やつらの ボスと 対決することに なるかも しれないわ";
    text[3521] = "ディスプレイに メモが貼ってある...「258227」";
    text[5657] = "ウーン... このジェットパッド エネルギーが 足りてないわね...";
    text[5658] = "直せないの？";
    text[5659] = "多分 この近くに 電気パネルが あるはずよ";
    text[5660] = "パネルに 電気を 供給して 回路を 暖めれば ジェットパッドを 修理できるわ！";
    text[5661] = "なら 急ぎましょう...";
    text[5662] = "凍えて... 死にそうだわ！";
    text[5663] = "スーパー・アシスタント・ロボ チャーーーーーーージ！！";
    text[5664] = "エヘヘ... これで ジェットパッドを 使えるはずよ！";
    text[3357] = "ええ... どうして ゴミ箱の中に 猫の砂が 入ってるわけ？";
    text[4371] = "まだ このフロアの すべての部屋を 調べてないわ！";
    text[4519] = "今 基地に 戻るわけには いかないわ！";
    text[7232] = "わあ... こんな ジェットスーツ 見たことないわ";
    text[7233] = "サロスが 作ったのかしらね？";
    text[7234] = "やつが 着るものには 見えないがな\n見た目にも 相当 重そうだ";
    text[7244] = "スキャンしてみたら どうやら チタンで できてるみたいね！";
    text[7235] = "戦争に 備えて 作った バトルスーツって ところか";
    text[7236] = "戦争...";
    text[7237] = "まあ 宇宙には どんなことだって 起こりうる からな...";
    text[7238] = "これ 持っていかない？";
    text[7239] = "どうして！？";
    text[7240] = "だって カッコイイじゃない！";
    text[7241] = "ああ きっと お前に 似合うと 思うぜ";
    text[7242] = "ウーン...";
    text[7243] = "まあ そうかもねえ...";
    text[7213] = "ああ...！  このコンピュータから バリアシステムを 無効化できるわ！";
    text[7214] = "それは 朗報ね！  そうしたら また ルナーの 上空に船を 飛ばせるように なるわ！";
    text[7247] = "このバトルロボットは シアが 将軍の時は ここに あったのか？";
    text[7248] = "いいえ... どうやら この廊下は 新しく 作られたもののようね";
    text[7249] = "将軍の オフィスに 足を 踏み入れるのは";
    text[7250] = "ママが 死んだ時 以来だわ";
    text[7251] = "壁は 昔から 紫色だったの？";
    text[7252] = "ええ 壁の色は 当時と 変わってないわ";
    text[7253] = "紫は ママの お気に入りの 色だった";
    text[7254] = "ひょっとして 現代の バトルロボットは 古代人のを 改良して 作ったのかしら？";
    text[7255] = "そうだ";
    text[7256] = "1年前に 偶然 捨てられた バトルロボットを 見つけたんだ";
    text[7257] = "そいつは 反物質コアなしで 動かすことが できた ";
    text[7258] = "いつもなら ルナーフォースとは 距離を 置くんだが...";
    text[7259] = "その時は ちょっと 調べたかったことが あってな";
    text[7260] = "へぇ 何を？";
    text[7261] = "古代の 石板には バトルロボットは 「第3の燃料」 によって";
    text[7262] = "起動できるという 隠し機能が 言及されている";
    text[7263] = "...そして その燃料とは ラックスだ";
    text[7264] = "ただし それは とても キケンでもある...";
    text[7265] = "自分の ラックスで ロボットを 動かすと いうことは 少しずつ 生命力を 奪われ しまいには...";
    text[7266] = "...まあ そんな サイアクの ケースは 考えたくも ないな";
    text[7267] = "えっと ワタシの 知る限り...";
    text[7268] = "現代の バトルロボットに そういう機能は ないと思うけど";
    text[7269] = "どうかな... サロスが いくつ 隠し事を しているのか どうして オレたちに わかる？";
    text[7270] = "まあ それは そうかもね";
    text[7271] = "いつか 緊急事態が 起きたら... そういうのを 頭に 入れておいても いいかもしれない";
    text[7272] = "そういう場面で 結構 役に立つかも しれないわ";
    text[7283] = "このコンソールには ルナーフォースが 指名手配している";
    text[7284] = "犯罪者の リストが 並んでるわ";
    text[7285] = "ワタシの 名前は ある？";
    text[7286] = "ええっと... ないわね";
    text[7287] = "そいつは 変だな... オレは？";
    text[7288] = "アンタは リストの一番上よ";
    text[7289] = "おお そいつは 光栄だぜ";
    text[7202] = "戻りたいの？";
    text[7203] = "ええ 万全に 準備を 整えてから サロスと 戦いたいの";
    text[7204] = "もっと エナGドリンクや バトルミントを 買いこんだりとか";
    text[7211] = "セレスティアは 戻りの ワームホールを こしらえることが できない";
    text[7212] = "オレが 「燃料を供給」すれば 話は 別だが";
    text[7205] = "とにかく ここは 荒野の 真ん中だぜ？";
    text[7206] = "近くに 商人なんて いようはずもない...";
    text[7207] = "...そして アストロバリア防衛システム のせいで 船も出せないんだ";
    text[7208] = "ちょっと待って！";
    text[7209] = "ひょっとして ここに 防衛システムの 制御パネルが あるんじゃ ないのかしら？";
    text[7210] = "ねえ ちょっと 探してみましょ！";
    text[7365] = "このコンソールには ルナーの 地図上に 様々な色の ピンが 示されている";
    text[7366] = "ピンは マークの 出没事件や 襲撃事件の あった場所を 指しているようだ";
    text[7367] = "データポイントは 10年前にまで さかのぼるようだ...";
    text[7357] = "ワタシたちが 知っていた マークの情報は...";
    text[7358] = "...サロスが 知っていたことの ほんの一部 だったのね";
    text[7359] = "すべては 隠されていた...";
    text[7360] = "ワタシたちが わかっていたのは 自衛の術と...";
    text[7361] = "反物質コアを 集めることだけ...";
    text[7362] = "..本当に そんなこと くらいだわ";
    text[4789] = "この洞窟を 見つけた時 この木は もう 積まれてあったわ";
    text[4790] = "なら 以前 誰かが ここにいたって ことよね？";
    text[4791] = "ええっと 謎解きで 盛り上がってるところ 悪いが..";
    text[4792] = "それは オレが 数年前に しばらく ここに いたからさ";
    text[4793] = "いつも 目立たないように していたからな";
    text[4794] = "何年も 逃亡生活を してると";
    text[4795] = "サバイバルのために いろんな場所を 使ったりするもんだ";
    text[4831] = "わあ すんごく 大きい クリスタルね";
    text[4832] = "ここの 人間は これを 「永遠のクリスタル」と 呼ぶんだ";
    text[4833] = "これは コロニーが 作られた 当初から あったものだそうだ";
    text[4834] = "ルナー七フシギの 1つと 言われている ものでもある";
    text[7900] = "わあ ここの水は まるで ゼリーだわ！";
    text[7901] = "ウーン... どうやら ここの 重力は 少し 弱いみたいね";
    text[7902] = "ここは きっと 重力発生装置から かなり 離れた 場所なんだわ";
    text[7912] = "ねえ ベラ ちょっと中を のぞいてみない？";
    text[7913] = "他の人の 個人的なものは 見ちゃダメでしょ！";
    text[7914] = "...でもさ 興味ない？\nちょっとだけ...";
    text[7915] = "そ そうねえ...";
    text[7916] = "いろいろ見て 調べてみたいとは 思うけど...";
    text[7917] = "ワタシたち みたいな 冒険者には 抗いがたい 衝動よねえ... ある意味 好奇心は 呪いだわ...";
    text[7962] = "シリカ峡谷のマップだ！";
    text[7963] = "この緑の マークは 何を 示してるのかしら？";
    text[7964] = "さあな... ただ 見てるだけで トレジャーハンターの 血が騒ぐぜ";
    text[7983] = "箱には 「トップシークレット」と ラベルが 貼られているわ";
    text[7981] = "サロスは おそらく ヒミツ実験の 材料を ここに 保管してたんでしょうね";
    text[7982] = "この倉庫に 何年も...";
    text[7984] = "崩れた坑道だ";
    text[8004] = "今は ミッションに 集中しましょう";
    text[8005] = "街を 回るのは 後でもできるわ";
    text[1471] = "ふう 危なかった！  それにしても あなたの技は 見事ですね ベラ隊員！";
    text[1472] = "我々は 市民の安全を 守るために ここに残ります";
    text[403] = "派遣される パトロールの数は 日に日に 増加している";
    text[404] = "そして マークが 現れる 頻度も 段々と 増えている...";
    text[405] = "今のところは 対処できていても... このままだと いつか 手に 負えなく なるかも しれません";
    text[406] = "そういう 自体に 備えて トレーニングに より一層 精を 出さなくては";
    text[407] = "なら 宇宙ステーションの バトル シミュレーションルームが うってつけよ！";
    text[408] = "なるほど\nアドバイス どうも ありがとう！";
    text[388] = "こんにちは ベラさん！";
    text[796] = "今ちょうど ルナーパネルの 最新モデルを 試してる ところだよ！";
    text[797] = "このパネルは どうやら 今までで一番 エネルギー効率が いいみたいだ！";
    text[801] = "ルナーパネルは 本当に 重いです...";
    text[798] = "ああ ベラ隊員 ステーションに 戻るんですね\nなら 安全に お気をつけて！";
    text[799] = "今 マークが 飛んでいったのを 見ましたか！？  とんでもない 大きさでしたよ！";
    text[800] = "ワタシは ここに留まります\nこちらに 戻ってくるかも しれませんし...";
    text[802] = "ここから見る 眺めは とてもきれいよ";
    text[803] = "そうね！  ワタシも ここが お気に入りの スポットよ！";
    text[804] = "ちょっと 聞いてもいい？";
    text[805] = "ええ 何？";
    text[806] = "いつか... マークに 怯えることなく 暮らせる日は 来るのかしら？";
    text[807] = "襲われる人が いなくなるような 日は...";
    text[808] = "別に 憎んでいる わけじゃないけど... 夫は マークのせいで 命を落としたの";
    text[809] = "それは... お気の毒だわ...";
    text[810] = "だから 他の人に ワタシと同じ 苦しみを 味わってほしくないのよ";
    text[811] = "大丈夫  そう 遠くないうちに 何とかなるわ";
    text[812] = "ワタシも みんなに 恐怖の中で 生きてほしくなんかない";
    text[813] = "人類の文明は 今も 日々進歩している";
    text[814] = "ルナーフォースの 一員として ベストを尽くすことを 約束するわ";
    text[815] = "ありがとう...";
    text[816] = "どうも！";
    text[817] = "ワタシも 気を強く 持つよう 努めてみるわ  励ましてくれて ありがとう";
    text[818] = "01100100 01101001 01100111 01101001 01110100";
    text[819] = "えっとね 「ボクの名前は ディジットだよ」って";
    text[820] = "ウーン どうやら ディジットの プログラムに おかしなところが あるみたいね";
    text[821] = "あら それはお気の毒に なら パパのところに 持っていって 直してもらいましょう！";
    text[822] = "01100111 01101111 01110100 01110100 01100001 00100000 01100111 01101111";
    text[823] = "あのね 「ボクには 行くところが ある」 って";
    text[824] = "そう なら きっと誰かの ロボットなのね...";
    text[825] = "変わった子ねえ";
    text[840] = "エヘヘ";
    text[841] = "エヘヘヘヘ";
    text[842] = "ええっと こんにちは！";
    text[843] = "あら こんにちは！";
    text[844] = "こんにちは！";
    text[845] = "その...さっき マークと 戦ってるところ 見たよ！  すごく カッコよかった！";
    text[846] = "ええ 本当に すごかったわ！  私たちは ここで 隠れてたけどね！";
    text[847] = "あのね いつも この町を 守ってくれて 本当にありがとう！";
    text[848] = "これは ほんの お礼の気持ちよ！";
    text[849] = "まあ ありがとう！ うれしいわ！";
    text[850] = "(この子たち... 普段から エナGドリンクを 飲んでるのかしら？)";
    text[851] = "(妙に テンションが 高いのは そのせいね)";
    text[852] = "それじゃ またね！";
    text[853] = "またね！";
    text[854] = "ベラ隊員の ジェットスーツは 特注の ようですね  トーマス博士が 作ったとか？";
    text[855] = "そうよ！";
    text[856] = "そうですか！  実は自分 今日が 仕事の初日なんです";
    text[857] = "まさか いきなり マークが 出てくるだなんて 思わなかったなあ...";
    text[858] = "でも... これから 努力して きっと 強くなってみせます！";
    text[859] = "実は 私も 正式な隊員に なってから まだ何か月も 経ってないわ";
    text[860] = "がんばらなくちゃ いけないのは お互いさまね！";
    text[861] = "でも あなたは 偉大なお母様の下 厳しいトレーニングを 長年 積んできました";
    text[862] = "きっと いろいろな技を 身に着けて いるんでしょうね！";
    text[863] = "実力は 折り紙つきで ものすごい勢いで 昇進している！";
    text[864] = "自分も 少しでいいから そうなりたいものです！";
    text[865] = "そして いつの日か 憧れの 青いモデルXの ジェットスーツを 着るんだ！";
    text[866] = "そうね お互い がんばりましょ！";
    text[867] = "あなたみたいな 情熱のある人が チームにいてくれて うれしいわ！";
    text[868] = "そ そりゃどうも！  ハハハ！";
    text[869] = "(あら～ 新人さん 照れちゃったわよ！)";
    text[870] = "(ヘルメットしてる人が 照れたって...)";
    text[871] = "(テトラ！)";
    text[872] = "(人のこと 勝手に スキャンしちゃ ダメだって 言ったでしょ！)";
    text[873] = "(ゴメン... 私 ドジな アシスタント・ロボなの エヘヘ...)";
    text[874] = "(まったく...)";
    text[875] = "これから努力して きっと 強くなってみせます！";
    text[876] = "マーク...";
    text[877] = "いつどこで 現れるのか 誰にもわからない";
    text[878] = "今はなんとか 抑え込めているので";
    text[879] = "住民が 怯えることなく 暮らせているのは 幸いですが";
    text[880] = "ただ 以前は 月に数回程度だったのが";
    text[881] = "最近は その頻度が 明らかに 増えている";
    text[882] = "そして 我々に できるのは やつらを撃退し ルナーの人々を 少しの間 守ることだけ...";
    text[883] = "ここには ルナーの あらゆる場所から 荷物が 運ばれてくる";
    text[884] = "カフェ宛ての 肉や野菜の コンテナは";
    text[885] = "ケプラー牧場から 送られてきたものだ";
    text[886] = "やあ 赤スーツの 見習いクン！  見たところ まだまだ ヒヨッコだね！  ハハハハ！";
    text[887] = "まあ いつの日か ボクと 同じくらい 強くなれるんじゃ ないのかな！  ハハハハ！";
    text[888] = "(ちょっと ランクが 高いからって いい気になってるわね)";
    text[889] = "(テトラ この人 スキャンしてみて)";
    text[890] = "(ウーン... 記録によると こいつの スクワットの 自己ベストは 75キロね)";
    text[891] = "プッ...！\n(ショボッ！  ワタシは140キロよ！)";
    text[892] = "んん？  何が おかしいのかな 見習いクン？";
    text[893] = "あなた スクワットの 最高記録は？";
    text[894] = "ハッ 120キロといった ところかな！";
    text[895] = "プププーッ...！！";
    text[896] = "まあ とにかく こんなところで 時間を 潰している ヒマはない  おしゃべりは また 今度にしよう";
    text[897] = "(バカねえ こいつ...)";
    text[898] = "まあ とにかく こんなところで 時間を潰している ヒマはない  おしゃべりは また 今度にしよう";
    text[899] = "(ハァ... バカねえ こいつ...)";
    text[1103] = "オレは ここで 相棒のメットを 待ってるのさ";
    text[1104] = "でも 今日は 珍しく 遅れてる... 何もなきゃ いいんだけどな";
    text[1414] = "よお 相棒の メットを 助けてくれて どうもありがとよ！";
    text[1415] = "ベラさん！  調子はどうだい？";
    text[1416] = "あのとき キミが見せた 勇気と知恵には 本当に 感動したよ";
    text[1417] = "ボクも マークへの 恐怖を 克服しなくちゃって 強く思ったんだ";
    text[1418] = "まあ す 少し 時間は かかりそうだけど.... 今でも マークと 聞いただけで 体が震えるんだ";
    text[1419] = "でも... がんばるよ！  ゼッタイに 強くなってみせるんだ！";
    text[389] = "ご心配なく";
    text[390] = "自分の身は 自分で しっかりと 守ります";
    text[794] = "アストロバリアが すぐに直ると いいんですが...";
    text[795] = "夜になると 娘が テレビゲームやろうって せがむんですよ...";
    text[1363] = "セクター16の 状態が 元に 戻ったようです！";
    text[1364] = "ああ やっと 家に帰って ゲームで 遊べますね！  イヤッホー！";
    text[295] = "どうしたの テトラ？";
    text[296] = "別に";
    text[297] = "フンッ！";
    text[298] = "ああ～ わかったわ\n焼きもち 焼いてるのね～！";
    text[299] = "ちょっとだけよ フンッ！";
    text[300] = "大丈夫よ あなたも 後で なでてあげるから ふてくされるのは やめなさい";
    text[301] = "エヘヘ わかったわ！";
    text[916] = "貨物倉庫の 入り口は レーザードアで 塞がれてるわ！";
    text[917] = "触ったら 丸焦げに されちゃうわよ！";
    text[918] = "なら 制御パネルに 入って 解除することは できる？";
    text[919] = "ウーン... この制御パネル カンペキに 壊れてるわね... ネットワークに アクセス できないわ";
    text[920] = "なるほど... なら 他の方法を 探さないとね";
    text[921] = "何か 考えは あるの？";
    text[922] = "ここらを 飛び交う レーザーは アストロバリア防衛システムの 一部なんでしょ？";
    text[923] = "なら それを ドアに 当てるのは どうかしら？";
    text[924] = "ああ～ いいわね それ！  やってみましょう！";
    text[932] = "やった！  これで 貨物置き場に 入れるわ！";
    text[936] = "おお 我が家へ ようこそ！";
    text[937] = "今日は これから インディーゲームの 配信をやるのさ！";
    text[938] = "ってことは あなた 配信者なの？";
    text[939] = "そうさ！";
    text[940] = "お部屋に いろんなゲームが 飾ってあるわね！";
    text[941] = "そうとも！ 知られざる 名作を みんなに 教えるのが 大好きなんだ！";
    text[942] = "わあ キミのロボット カッコイイなあ！";
    text[943] = "ワタシは テトラよ！  ベラの アシスタント・ロボなの！  エッヘン！";
    text[944] = "自分で作ったの？";
    text[945] = "まあ パパと一緒にね この子のAIは かなり新しいのよ";
    text[946] = "へえ なんか ガチっぽくて ヤバいね！";
    text[947] = "エヘヘ... (今の子の しゃべり方って よくわかんないわ...)";
    text[948] = "この街は ティコに比べたら ずっと静かだわ";
    text[949] = "レゴリシアの 住民は 崖の下深くに 住んでいるから";
    text[950] = "ほとんどの災害に 遭わずに すむしね";
    text[951] = "それに 非常食と 酸素タンクも しっかりと 用意されているわ！";
    text[952] = "ああ！  おしっこ 漏れちゃうよう...！";
    text[953] = "聞いた話だと かつてテラで 栽培されてた 小麦の麺は";
    text[954] = "ルナーで 栽培されてる 小麦とは 味が違うらしいわ";
    text[955] = "実際 どんな味だったのかしらね...";
    text[956] = "今のテラが 生き物のいない 火山の星なのは 本当に残念だわ";
    text[957] = "千年前は 一体 どんな場所 だったんでしょうね...？";
    text[958] = "つまり ワタシたちの 先祖が ルナーに 移住する前の話よ";
    text[959] = "ルナーフォースの 任務には 厳しいトレーニングと たゆまぬ努力";
    text[960] = "それに.@P..@P..@P.. おいしい 食べ物が 欠かせないのさ！";
    text[1105] = "レゴリシアの ネット掲示板は 見てみたかしら？";
    text[1106] = "いろんな 書き込みがあって 楽しいわよ！";
    text[1107] = "実はね 私も 書き込んでるの\nハンドルネームは 「メリア」よ";
    text[1108] = "ちょっと前に ハーツ・キューブを なくしちゃって 見つけた人が いたらと思って 書いたの";
    text[1109] = "でも 今は正直 もういいかなって 気持ちかしらね";
    text[1110] = "もし見つけたら 中のものは あなたに あげていいわ！";
    text[1111] = "でも ハーツ・キューブって 普通は ロックが かかってるでしょ？  カギは 持ってるわけ？ ";
    text[1112] = "ああ カギも なくしちゃったこと 言い忘れてたわ...";
    text[1113] = "まあ 開けられるか どうかについては グッドラックって とこかしら！";
    text[1862] = "やあ ベラ！";
    text[1863] = "ああ リッチー！  調子はどう？";
    text[1864] = "すんごくいいよ！";
    text[1865] = "今 ルナーを巡る 旅のことを 考えていたんだ";
    text[1866] = "この想いが 新しい インスピレーションに なると いいんだけど";
    text[1867] = "ステキ！  ワタシ あなたの曲 とっても好きよ！";
    text[1868] = "ありがとう！  あと キミに あげたい曲が あるんだ！";
    text[1869] = "後で キミの ミュージックボットの アカウントに 送信しておくね";
    text[1870] = "ああ～ それは うれしいわ リッチー！";
    text[1871] = "この先 ボクや 仲間を ルナーで 見かけたら ぜひ 声を かけておくれ！";
    text[1872] = "そのときの 新曲を キミの ミュージックボットに 送るからさ";
    text[1873] = "そうしたら 世界中の ミュージックボットから 歌を聴けるよ！";
    text[1874] = "やあ ベラ！  新しい曲が できたんだ！";
    text[3270] = "あら ありがとう リッチー！  あなたの曲は いつだって 最高よ！";
    text[3271] = "実は 最近 新しい バンドメンバーを 募集してるんだけど...";
    text[3272] = "誰か 見つかったの？";
    text[3273] = "うーん まだかな...";
    text[3274] = "キミは何か 楽器はやるのかい ベラ？";
    text[3275] = "いいえ...";
    text[3276] = "じゃあ 歌は？";
    text[3277] = "歌なら いけるわよね？";
    text[3278] = "ああ テトラ！  まあ...少しだけね  でも 恥ずかしいわ";
    text[3279] = "アハハ あまり 本気に しないでくれ\nちょっと 興味本位で 聞いてみただけさ";
    text[3280] = "...さてと そろそろ 家に戻ろう";
    text[3281] = "今は いろいろと インスピレーションが 湧いて 止まらないからね！";
    text[6265] = "このドアは 反対側から ロックが かかっている";
    text[6266] = "グレイ将軍 このエリアは 我々に 任せてください！";
    text[6267] = "どうぞ ご心配なく！";
    text[3888] = "昨日 新しい ぬいぐるみを 注文したわ！";
    text[3889] = "ええ 何の？";
    text[3890] = "それは ヒ・ミ・ツ  見ての お楽しみよ！";
    text[3875] = "ああ もう 足が 動かない...";
    text[1785] = "ワシは このステーションの 管理人じゃ";
    text[1786] = "掃除に 設備の修理や 点検... いろんな仕事を こなしているぞい";
    text[1787] = "どれも 楽しくやっているが 一番の お気に入りは...";
    text[1788] = "...宇宙猫の エコーに エサを やることじゃ";
    text[1789] = "まさか エコーのような 宇宙を愛する 猫がいるとは 思いもしなかったぞい";
    text[1790] = "ところで エコーが どこから来たのか 飼い主が 誰なのか 何もわからんのだ";
    text[1791] = "名札は ついていたが 迷子の 連絡先は かすれててのう";
    text[1792] = "ある日 突然 ここに現れ それ以来 ここに いるのじゃよ";
    text[1793] = "ベラ！  ルナー宇宙ステーションに お帰りなさい！";
    text[1794] = "ただいま ステラ！  何か 新しい ミッションは あるかしら？";
    text[1795] = "いくつかね  でも それは もう 他の部隊に 割り当てられたわ";
    text[1796] = "だから 今日は お休みしても 大丈夫よ！";
    text[1797] = "たまには しっかりと 休みくらい とりなさい！";
    text[1798] = "アハハ  わかってはいても なかなか 難しいのよね...";
    text[1799] = "それで 新しい ぬいぐるみを 買ったの？  すんごく わかいいわね！";
    text[1800] = "ああ それね！";
    text[1801] = "オンラインで 注文したら なぜか 2セット届いたのよ！";
    text[1802] = "欲しければ 1セットあげるわ";
    text[1803] = "後で あなたの部屋に 持っていって あげる！";
    text[1804] = "かわいい ぬいぐるみ 大好き！  ありがと～！！  エヘヘ！";
    text[1807] = "今は特に ミッションはないわ";
    text[1808] = "何か 追加されたら その時は 言うわね！";
    text[1827] = "うう もう これ以上 ガマンできないよ...";
    text[1828] = "あの～ 宇宙ステーションの トイレは ここだけじゃないわよ";
    text[1829] = "いいや ここじゃなきゃ ダメなんだ  ボクは あきらめないぞ";
    text[1830] = "もう かなり 待ってるから ここまできたら 最後まで待つよ";
    text[1890] = "宇宙船を 動かす時は くれぐれも 気をつけてくれ";
    text[1891] = "ルナーの 周りには たくさんの 小隕石が 飛んでいる";
    text[1892] = "キミの船には パイロットアシスト・システムは 搭載されてるのかい？";
    text[1893] = "いいえ だって アシスタント・ロボの テトラが 運転してるんだもの！";
    text[1894] = "本当に！？  いやあ 何て すごい ロボットなんだ！";
    text[1895] = "エヘヘ スーパーアシスタント・ロボの テトラには ありとあらゆる機能が あるんだからね！";
    text[1956] = "いや～ 今日さ 貯めたお金で やっとこさ レーザーバラージの アクティブスキルを 買ったよ";
    text[1957] = "でも それだけの 価値は あったね！  レーザーは 本当に 強力だし...";
    text[1958] = "レーザーって いいわよね！";
    text[2052] = "おいおい せっかく床を 掃除した ばかりなのに 汚したら 困るよ！";
    text[2053] = "まったく どこで そんな 紫のチリを つけてきたんだか...";
    text[2054] = "ああ ごめんなさい！\n今 ちょっとだけ 急いでて！";
    text[2055] = "(紫のチリ... 多分 ファントムスペースで ついたんだわ...)";
    text[2056] = "(後で ブーツを 洗わなくっちゃ)";
    text[2057] = "(誰にも バレなきゃ いいんだけどね...)";
    text[2061] = "マークの データベースは 新種が 発見されると 更新されるのは 知ってましたか？";
    text[2062] = "だから 新種を 自分で 見つけたら コードネームを 付けられるんですよ！";
    text[2063] = "知ってるわよ～";
    text[2064] = "ええ 知ってるわよ～";
    text[2065] = "そ そうでしたか...";
    text[2157] = "落ち着かなきゃ... 落ち着かなきゃ... 落ち着かなきゃ... 落ち着かなきゃ...";
    text[2158] = "(この人 大丈夫かしら？)";
    text[2159] = "(ストレスで やられてるみたいね  そっと しておきましょう)";
    text[2149] = "ワタシたちの 太陽は 寿命の 尽きかけた 赤色超巨星よ...";
    text[2150] = "ええ！？  なんだか 怖いわね！";
    text[2151] = "ああ ごめんなさい\nでも 心配しないで";
    text[2152] = "あと 七百万年は 平気だと 言われているからね";
    text[2153] = "それから 超新星爆発を 起こすと されているけど";
    text[2154] = "...";
    text[2155] = "事実とは 時に 恐ろしいものよ... 宇宙について 研究していると";
    text[2156] = "時々知らない方が いいような こともあるわ  「無知は幸福なり」 とは よく言ったものね";
    text[7128] = "色違いの マーク...";
    text[7129] = "見た目には 大して 変わりませんが より速く そして 強くなっている！";
    text[7130] = "ガァーーーーー！";
    text[7131] = "カァーーーーー！";
    text[7132] = "偶然とは 思えない...";
    text[7133] = "これには 間違いなく 何らかの 原因が あるはず";
    text[7134] = "マークは ランダムな 宇宙空間に 突然 現れたりは しません...";
    text[7135] = "一か所に 集団で 現れるなら それは...";
    text[7196] = "気をつけてね ベラ";
    text[7197] = "大丈夫よ 心配しないで";
    text[7198] = "あと パパも ゼッタイに 無事に 連れて帰るわ";
    text[7199] = "軍事基地に 行くのかい？  ウェヘー？";
    text[7200] = "それで 例の 必要なものは 部屋から 持ってきたのかい？";
    text[7201] = "ああっ 忘れてたわ！";
    text[5665] = "フッフッフ！";
    text[5666] = "このピトン山で 若き登山家に 出会えるのは うれしいことだ！";
    text[5667] = "あなたは よく 山に登るの？";
    text[5668] = "おお ここには 毎日 登ってるとも！";
    text[5669] = "シリカからは 遠いが それだけの 価値は あるよ！";
    text[5670] = "ところで ピトン山は ルナーで一番 高い山だと いうことは 知っていたかな？";
    text[5671] = "とても 寒い場所だが ここでは 太陽が 最も明るく 見えるのだ";
    text[5672] = "だから 「永遠の光の頂」なんて 言われたり するのだよ フッフッフ！";
    text[7394] = "今は 放っておきましょう";
    text[7395] = "でも 目を覚まして 逃げようとしたら？";
    text[7396] = "大丈夫よ この人は もう 脅威には ならないわ";
    text[3126] = "ああ ザラ！";
    text[3127] = "...どうも";
    text[3128] = "ん どうかしたの？";
    text[3129] = "新しい コンボ攻撃の 名前を 考えていたのよ";
    text[3130] = "「レイニー・ロック・フィスト」とか どう？";
    text[3131] = "エレガントね";
    text[3132] = "ダサッ";
    text[3133] = "ありがとう";
    text[3134] = "すべての技に クールな名前を つけるのが ワタシの こだわりなの";
    text[3135] = "ウチのチームで 技の名前を 考えるのは ワタシの 仕事なのよ";
    text[3136] = "ウーン... なら 考え直した方が よさそうね";
    text[3137] = "メロディー 手伝いましょうか？";
    text[3138] = "いいえ 大丈夫よ ベラ\nこっちのことは 心配しないで";
    text[3139] = "マークは こっちで 何とかするから あなたたちは 水道ネットワークを 頼むわ！";
    text[3140] = "あら 天才ちゃん\n今ね マークスレイヤーを 探してるんだけど...";
    text[3141] = "その呼び方 やめてって 言ったでしょ！";
    text[3142] = "やめないわー！！  スパーリングに 応じるまではね！  アンタのことを ボコしたいの！";
    text[3143] = "今は そんなヒマ ないでしょ レイン";
    text[3144] = "わかってるっつの！";
    text[2796] = "ベラ隊員 マークのことは こちらに 任せてください！";
    text[2797] = "ちくしょう このマークどもは エナGドリンクでも 飲んだのか！？";
    text[2798] = "普通の やつより はるかに 速くて 手強いぞ";
    text[2799] = "この惨状と混乱... 終わりは あるのか？";
    text[2800] = "ひどい ありさまだ... 一体 どうして こんなことが...？";
    text[2801] = "この辺で フィルタマシンを 見なかった？";
    text[2802] = "ふむ... そういえば 北の方に あったような...";
    text[2803] = "確か ニューロンリンクショップの 近くです！";
    text[2804] = "ベラ隊員 この先にいる 市民は 全員 避難させました";
    text[2805] = "このエリアは 現在閉鎖中です";
    text[2806] = "キャハハハハー！！";
    text[3320] = "うう マークの数が 多すぎる...";
    text[3321] = "しっかりして！  もうすぐ 医療チームが 来るはずよ！";
    text[3322] = "....";
    text[3323] = "この人 スキャンしてみたけど ほぼ無傷よ...";
    text[3324] = "ああっ このことは 人に言わないで くださいね！";
    text[3325] = "今回の マークは 強すぎたので ちょっとだけ 死んだフリをね...";
    text[3358] = "ベラ隊員 すべての市民を 無事に 避難させることが できました！";
    text[3359] = "また 付近にいる マークは すべて倒しました";
    text[3360] = "これで 事態は ひとまず 沈静化したようです";
    text[3361] = "今は 取り逃した マークが いないか 各地区を 念入りに 調査しているところです";
    text[3362] = "この後 被害状況などを しっかりと 調査した上で";
    text[3363] = "市民が 安全に 家に 帰れるようにします";
    text[3364] = "ああ もう くたくただ...";
    text[3365] = "今回の マークは 想像以上に 手強かったですね";
    text[3366] = "幽霊タイプの マークは 厄介ですね... とにかく HPが 高いですから...";
    text[3367] = "あなたは 複数の敵を 攻撃できる 技か ラックスコンボは 持っているの？";
    text[3368] = "いいえ... 今日で その必要性を 大いに 痛感しましたが";
    text[3369] = "この兵士は 疲れて 話す気力が ないようだ...";
    text[3370] = "もう 大丈夫よ\nしっかりと 休んで！";
    text[3371] = "一部の兵士は 医療チームから 応急手当を 受けているようです";
    text[3374] = "どうして いっつも こうなんだ！？";
    text[3375] = "ごはんを 食べ終えた時は トイレは 空いてたんだ";
    text[3376] = "それから お代を払って 入ろうとしたら 誰かが トイレに ダッシュしてきて...";
    text[3377] = "あまりにも 速くて その姿すら 見えなかった";
    text[3378] = "それから もう... 30分も 待ってるんだ！！";
    text[3379] = "ええっと... ノックしてみたら どうかしら？  待ってる人がいるって 知らせたら いいんじゃない？";
    text[3380] = "いや そういうのって 失礼だよね？\nボクは待つよ...";
    text[3381] = "...そ そう";
    text[3388] = "また今度 会いましょうね 天才ちゃん";
    text[3389] = "ああ もう 同じことを 何度...";
    text[3415] = "わあ ママ 見て！\nボクらの ヒーローだよ！";
    text[3416] = "こんにちは！  マークの 襲撃から 助けてもらった あの日以来";
    text[3417] = "この子は あなたに 夢中なのよ";
    text[3418] = "あの大ピンチで 見せた あなたの 勇気が この子の 心に 火をつけたってわけ";
    text[3419] = "ね ねぇ これ 受け取って！";
    text[3420] = "バーサクボーイの ぬいぐるみを 手に入れた！";
    text[3421] = "新しいぬいぐるみが 自分の部屋に 加わった！";
    text[3422] = "あら どうもありがとう！";
    text[3423] = "これ ボクの お気に入りなんだ エヘヘ";
    text[3424] = "それじゃあね！";
    text[3425] = "バイバイ！  ボクの ぬいぐるみ 大事にしてね！  エヘヘ";
    text[3426] = "この子は将来 きっと 立派な 戦士になるわよ";
    text[3427] = "間違いないわ";
    text[3428] = "今日 一番 被害を 受けたのは 水道局じゃ";
    text[3429] = "特に 屋上が めちゃくちゃじゃ！\n一体 何が あったんじゃ！？";
    text[3430] = "アハハ...";
    text[3456] = "(4番目の入力は 左だと ボクのカンは 言ってる...)";
    text[3457] = "しまった...  ボクは 今 何を つぶやいたんだ？";
    text[3458] = "(今のを 聞かれたら... 先に 開けられてしまう！)";
    text[3459] = "あのねえ それなりな 声で つぶやいたら 考えてることが 全部 バレちゃうわよ";
    text[3460] = "ぐわあああ！  なら 聞かなかったことに してください！";
    text[3461] = "もっとも 相棒は 何も 明かさないでしょうがね！";
    text[3453] = "東地区を 調べていたら カギの かかった 金庫を 見つけましてね";
    text[3454] = "いろいろ 開けようと 試したんですが ダメでした";
    text[3455] = "ただ... 「3番目の 入力は 下である」 という 謎の確信が あります";
    text[3390] = "コペルニクスの 人たちは こんなことが あった日でも";
    text[3391] = "驚くほど 平静を保ち 素早く 立ち直ったわね";
    text[3392] = "まあ でも 最近の ルナーでは 割と よくあることだしね";
    text[3393] = "小さな子供たちでさえ こういう 緊急事態に";
    text[3394] = "対応するための 訓練を 受けているのだから";
    text[3395] = "ワタシたちは 宇宙に浮かぶ 美しい 銀色の星に 住んでいる";
    text[3396] = "マークが 現れる前は 重力や 酸素供給の 心配を";
    text[3397] = "しなくちゃ いけなかった";
    text[3398] = "ルナーで 生きていくための テクノロジーの 奮闘の歴史は いつの時代も あったものよ";
    text[3462] = "今回の 騒動で 己の 実力不足を 思い知らされました";
    text[3463] = "レイン隊の 戦いぶりを 見ましたか？";
    text[3464] = "襲いかかる マークを ことごとく 跳ね返しつつ";
    text[3465] = "市民を 速やかに 避難させていました";
    text[3466] = "せめて あの人たちの 半分でいいから 強くなりたいものです";
    text[3476] = "町が 元に戻ってから 数時間が 経ちました";
    text[3477] = "道路は まだ 空っぽ状態の ようですが...";
    text[3478] = "にぎわいを 取り戻すには もう少し 時間が かかるでしょうね";
    text[3479] = "サロス将軍は 念のため あと数時間 市内を パトロールするように 命じました";
    text[3480] = "取り逃がした マークが また 暴れ出す... なんてことも ありえますしね";
    text[3481] = "ええっ！？\nあなたは 水道を 直しただけでなく";
    text[3482] = "マークスレイヤーを 捕らえる 極秘ミッションにも 参加してたんですか！？";
    text[3704] = "ああ！  キミが 例の ピンク髪の ルナーフォース隊員だね！  確か ベラさんと いうんだろう？";
    text[3705] = "ええ そうよ\nでも どこかで 会ったかしら...？";
    text[3706] = "いいや... 実はね 妻と息子から キミのことを 聞いたんだよ";
    text[3707] = "最近起きた マークの 襲撃から 2人を 守ってくれたんだって...";
    text[3708] = "ああ もう 何と お礼を 言ったら いいのか！";
    text[3709] = "ああ～ 気にしないで！  ただ 2人が 無事だったことが 何よりよ";
    text[3710] = "ワタシは コペルニクスに 住んでいるが ティコで 仕事をしているのだ";
    text[3711] = "ニュースを 聞いた時は もう心配で 心配で...";
    text[3712] = "本当にありがとう ベラさん！  これからも お元気で！";
    text[3800] = "なぜだ...";
    text[3801] = "ボクは この地に 使えるトイレが あることを 夢見て やってきた...";
    text[3802] = "なのに...\nボクは 永遠に 苦しみ続ける 運命なのか！？";
    text[3803] = "ええっと... じゃあ そこの 木の後ろで こっそり 用を足したら いいんじゃなくって？";
    text[3804] = "...この美しい ケプラーの 自然を 汚せと 言うのかい？";
    text[3805] = "ありえないね ボクは 待つよ...";
    text[3627] = "戦士タイプの バトルロボットと 戦うのは どんな感じ なんでしょうね...";
    text[3628] = "待って テトラ！  近づいちゃ ダメよ！";
    text[3629] = "バトルモード オン";
    text[3630] = "あらら...";
    text[3631] = "これは おそらく ロボットの 判断ミスね  こっちを 敵だと 誤解してるんだわ！";
    text[3632] = "何とかして 止めないと！";
    text[3657] = "ルナーフォース本部は セキュリティを しっかりと 保つため 24時間体制で 警備されています";
    text[3658] = "なので ドローンや バトルロボットには あまり 近づかない方が いいですよ";
    text[3659] = "ん なんだ？  用件を言え";
    text[3660] = "ええっと... その...";
    text[3661] = "ちょっと お話する時間は ないかしら...？";
    text[3662] = "ないな  勤務時間で ないなら 一刻も早く この場を 離れたまえ";
    text[3663] = "(わあ この人は ちょっと 規則を 真に 受けすぎてるわね)";
    text[3664] = "(ただ 仕事熱心な だけでしょう  行きましょ)";
    text[3665] = "フーッ！  フーッ！";
    text[3670] = "どういうわけか 荒野ゾーンは ルナーで 最も マークの 発生率が 高いのです";
    text[3671] = "アビレルは 本来 そんなに 狂暴では ないんですが";
    text[3672] = "いくつか兵士を 襲ってきた事例が 報告されましてね...";
    text[3673] = "あらら あなたの弾 あんまり 効いてなさそうね...";
    text[3674] = "これは ただ 威嚇しているだけです...";
    text[3675] = "あなた アビレルと 戦ったことが あるんですか？";
    text[3676] = "やつらは 自分の エネルギークローンを 作ることが できるため";
    text[3677] = "攻撃を 当てるのが 難しいのです";
    text[3678] = "フーン... 単に 射撃の 練習が 足りてないんじゃなくって？";
    text[3679] = "何だって！？  なら 自分で やってみますか？";
    text[3680] = "いいえ やめておくわ";
    text[3681] = "ま がんばって！";
    text[3682] = "...";
    text[3683] = "知ってましたか？  びしょぬれの ステータス効果を 受けたマークを 攻撃すると";
    text[3684] = "ラックスメーターが 通常よりも 多く 上がるんですよ！";
    text[3685] = "どうやら最近 マークスレイヤーが 収容所に 入れられたようです";
    text[3686] = "サロス将軍には やつが 脱走を 図った場合に 備えて";
    text[3687] = "警戒するように 言われました";
    text[4044] = "目立たないように 進むって 言ったでしょ？";
    text[4045] = "この入り口は 使うべきじゃないわ";
    text[4046] = "このドアは 多分 外に 通じているわ";
    text[4047] = "そっちは 行かないで おきましょ... 不審に 思われると まずいでしょ";
    text[4048] = "待って！  これ以上 先に行ったら 警備に 見つかるわよ！";
    text[4049] = "この先は 収容所の 入り口よ";
    text[4050] = "別の道を 探しましょ！";
    text[4334] = "許可なき者が 将軍のエリアに 立ち入ることは できん";
    text[4335] = "この軍事基地は ルナーで 最も深い クレーター 「永遠の闇」の";
    text[4336] = "近くに 築かれたものだ";
    text[4337] = "そのクレーターの 底に 光は ほとんど 届かない  だから そこに 行く時は 本当に 怖いんだ...";
    text[4363] = "やあ タンクタイプの バトルロボットを 見たことはあるかい？";
    text[4364] = "戦士タイプよりは 遅いんだが その分 ガッチリしてるんだ";
    text[4365] = "だから ディフェンシブな 戦い方を するには 最適なんだよ";
    text[4901] = "シリカの 鉱山は 何世紀にも わたって 発掘されてきた";
    text[4902] = "閉鎖されたやつは だいたい 二百年くらい 掘られたものさ";
    text[4903] = "ええ 1つ 掘り尽くすのに そんなに かかるわけ？";
    text[4904] = "そうさ テクノロジーは 時とともに 改良されてきたが それでも";
    text[4905] = "ブラッドクォーツの クリスタルを 掘り起こすのは 大変な 作業なのさ";
    text[4906] = "だからこそ ブラッドクォーツは 高価なんだ";
    text[4907] = "ルナーで 一番硬い 鉱物は 発掘するのも 「ハード」ってわけさ";
    text[4908] = "さっき コロニーの上を たくさんの ドローンが 飛んでいるのを 見たわ";
    text[4909] = "一体 何を していたのかしらね？";
    text[4910] = "マ... マークが 出たとか かしらね...";
    text[4911] = "んん 見ない顔だなあ... シリカは 初めてかい？";
    text[4912] = "ええ！";
    text[4913] = "ここには 鉱夫 商人 難民 トレジャーハンター... いろんな 人間がいる";
    text[4914] = "みんな 生きるために 必死で やってるのさ";
    text[4918] = "おお お前 いい武器 持ってんな  いくらだ？";
    text[4919] = "ええっと 悪いけど 売るのは ムリなのよ ゴメンね";
    text[4920] = "そうかい まあ この辺では あまり 高いモンを 人に 見せない方が いいぜ";
    text[4921] = "チンピラや 盗賊が どこにいるかも わからねえしな";
    text[4922] = "ええ！？  盗賊ですって？";
    text[4923] = "話は この辺に しようや  そっちが 何も 売らねえなら もう興味ねえんだ";
    text[4924] = "やあ！  ワタシは シリカの学校で 歴史の先生を しているんだ  ところで...";
    text[4925] = "シリカは ルナーでも 一二を 争うくらい 古い コロニーだと 知ってたかい？";
    text[4926] = "最初に ここに 定住した人々は ";
    text[4927] = "巨大な溶岩の チューブの中に 住んでいたんだよ";
    text[4928] = "溶岩ですって！？  ルナーに そんなものが？";
    text[4929] = "そうだとも！  もっと深く 掘り進めば マグマだって あるよ！";
    text[4930] = "その当時 アストロバリア なんてものは なかったからね...";
    text[4931] = "...だから ルナーの 気温は 昼と夜で とんでもない差が あったのさ";
    text[4932] = "でも 幸いなことに 人々はここ ルナーの北部に 溶岩チューブを 見つけた";
    text[4933] = "そこは 暖かく 環境が 安定していたため";
    text[4934] = "安住の 地にすると 決めたのさ";
    text[4935] = "学校では ルナーの 歴史に 興味を 示さない 子も 多いけど";
    text[4936] = "人類が どうやって このルナーで 生き延びてきたのか それを 知るのは とても 大切だと 思うんだ";
    text[4939] = "ここ シリカには サイクロイドの 小さな コミュニティが あるのよ";
    text[4940] = "夫とワタシは 元々 マグネシアという コロニーに 住んでいたの";
    text[4941] = "でもね 数年前に ある出来事が あって それで シリカに 移住したってわけ";
    text[4942] = "...それは お気の毒だわ";
    text[4943] = "まあ 元の家は なくしたけど... ここで 新しい家を 見つけたわ";
    text[4944] = "中には それすら 叶わなかった 人たちも たくさん いたわけだし...";
    text[4945] = "でもね それが あってから 家族の ありがたみと いうものを より一層 感じるように なったのよ";
    text[4946] = "あなたたち ルナーフォースには 今まで とても お世話になったわ";
    text[4947] = "いろいろと 助けてくれて 本当に ありがとう";
    text[4948] = "どうも！  これからも ワタシたちの 助けがいる時は いつだって 声をかけてね！";
    text[4949] = "ルナーフォースの 使命は ルナーの 人々の 生活を 守ること なんだから！";
    text[4950] = "....";
    text[4951] = "ワタシね これから ちょうど 出かける ところよ！";
    text[4952] = "へぇ どこに？";
    text[4953] = "アドベンチャーエリアを いくつかね！";
    text[4954] = "一体 何が 見つかるのか 考えただけで ワクワクするわ！";
    text[7971] = "まあ あなたの顔... まるで 誰かから 逃げてるって 感じね";
    text[7972] = "ええっ！？  わかるの？";
    text[7973] = "ええ 雰囲気でね\nあと 目を見ると 大体わかるわ";
    text[7974] = "まあ 少し リラックスして いきなさい";
    text[7975] = "どちらにせよ 問題から 永遠に 逃げることは できないわ";
    text[7976] = "いつか それと 向き合う 時が来る";
    text[7977] = "あと あなた...";
    text[7978] = "え オレかい？";
    text[7979] = "目の中に 深い悲しみが 見えるわ";
    text[7980] = "いつの日か 乗り越えられると いいわね";
    text[8418] = "こんにちは！  突然だけど あなた バニーちゃんは 好き？";
    text[8419] = "ありえない... バニーちゃんが キライだなんて...";
    text[8420] = "あんなに モフモフなのに！";
    text[8421] = "そうでしょ！  なら これを あなたに あげるわ...";
    text[8422] = "アクセルと ヘーゼルの ぬいぐるみを 手に入れた！";
    text[8423] = "このぬいぐるみはね ワタシが 作った ゲーム 「コード・バニー」の キャラクターよ";
    text[8424] = "バニーちゃんが 好きなら 今度 プレイしてみたら どうかしら？";
    text[8425] = "ええ やってみるわ！";
    text[7920] = "ああ～ きっと この箱には ぬいぐるみとかが いっぱい 入ってるんでしょうね";
    text[7921] = "ええ 正解よ 名探偵テトラさん！";
    text[7922] = "コレクションを きちんと 飾りたいから 今度 新しい棚を 買うつもりだけどね エヘヘ";
    text[7926] = "紫色の テディベアだ！";
    text[7927] = "それはね ガチャポンで ゲットしたのよ！";
    text[7928] = "クラシックな 茶色の テディベアだ！";
    text[7929] = "ああ それは ゲーセンの UFOキャッチャーで ゲットしたやつよ！";
    text[7930] = "アレ やり出すと 止まらないのよね...";
    text[7942] = "人間工学に 基づいた 最高級の ゲーミングチェアだ！";
    text[7943] = "それ メッチャ 高かったのに 背中が 痛くなるのよ！  意味わかんないんだけど！？";
    text[7944] = "とても高価な ゲーム用の 3画面モニターだ";
    text[7945] = "それはね 最新の グラフィックカードと 一緒に 買ったのよ エヘヘ";
    text[7946] = "できるだけ ハイスペな パソコンで プレイして";
    text[7947] = "今 やってるゲームで 最高ランクに 行きたいからね";
    text[7941] = "あらあ ベラ... ワタシの サンドバッグにでも なりたいの？  ガッハッハッハ！";
    text[7956] = "本棚にあるのは 格闘技と 瞑想の 本ばかりだ";
    text[7958] = "あなたって 読書家なのね ザラ！";
    text[7959] = "本を読むと　トレーニングで 疲れた日でも 頭がスッキリするのよ";
    text[7960] = "あなたも 試してみたら いいと思うわ！";
    text[8456] = "それで 次は どうするの？";
    text[8457] = "ウーン... ルナー宇宙ステーションの カフェにでも 行こうかな！";
    text[8458] = "今は 仲間と一緒に ルナーを巡る 旅で得た インスピレーションを 元に";
    text[8459] = "新しい 曲作りに 取り組んで いるんだ！";
    text[8460] = "実は 2日後 ティコの カフェで 新曲の コンサートを することに なってるんだ！";
    text[8461] = "都合が つくなら ぜひとも 見に来てね！";
    text[8462] = "おお 来てくれたんだね！";
    text[8463] = "おかげさまで みんな ボクの コンサートを 楽しんでくれたよ";
    text[8464] = "ボクも ティコの街が 気に入ったから ここに 住むことに したんだ";
    text[8465] = "そして ここで 自分の 音楽を 追求し それを 披露することに 情熱を 注いでいくつもりさ！";
    text[8466] = "今まで いろいろと 気にかけてくれて ありがとう ベラ！";
    text[8467] = "これが ボクの 最新の曲さ\nさあ ダウンロード しておくれ！";
    text[8488] = "ボクは その倉庫の 中には ゼッタイに 行かないよ...";
    text[8489] = "ええ どうして？";
    text[8490] = "どうやら ネズミが 大量発生してる みたいなんだ...";
    text[8523] = "ルナーの 考古学者は 何年もかけて 古代人の 残した 石板や 文字を";
    text[8524] = "集めて 記録してるんだ\nウェヘー！";
    text[8525] = "古代言語の 一部は 今 解読が 進んでるところさ！";
    text[8526] = "ナイラさん 古代人と ファントムスペースには";
    text[8527] = "何らかの 関係が あるんだと思う？";
    text[8528] = "そうねえ ワタシは この分野の 専門家じゃないから わからないけど...";
    text[8529] = "でも どうして 突然 そんなことを？";
    text[8530] = "いや ちょっと 気になっただけ...";
    text[8532] = "ボクの仕事は 古代の遺物が 見つかった場所を 記録しておくことさ";
    text[8533] = "古代の 遺物を 発掘するのは 一苦労だよ！";
    text[8534] = "なんだって 貴重な お宝を 壊さないように";
    text[8535] = "デリケートに ゆっくりと 掘り出さないと いけないからさ！";
    text[8536] = "あなたは ここで 何をしてるの？";
    text[8537] = "ええっと ボクは...";
    text[8538] = "ド... ドーナツ運び係さ！";
    text[8540] = "待って！";
    text[8541] = "今 基地に 戻るわけには いかないわ！";
    text[8542] = "誰が 信用できるか なんて わからないもの...";
    text[8543] = "まずは サロスを 止めるための 作戦を 考えましょう！";
    text[8545] = "ああ ちょっといいか？　マークスレイヤーについて 最近何か聞いたかい？";
    text[8546] = "いいや 捕まったと聞いてからは 何も...";
    text[8547] = "そっちはどうだい？";
    text[8548] = "...同じだよ 何も聞いてない";
    text[8549] = "ベラ隊員 あなたは ルナーフォースの 最高クラスの 兵士として...";
    text[8550] = "最近 紫コードの ミッションレポートを 受け取りましたか？";
    text[8551] = "ワタシのような 末端の人員には 来なかったのですが...";
    text[8552] = "そ そうねえ...";
    text[8553] = "...来てないわ！";
    text[8554] = "そうですか... 変だなあ";
    text[8559] = "この人たち なんで まだ ここにいるの？";
    text[8560] = "...どうして 誰も 気づかないの！？";
    text[8561] = "テトラ アンタ どんだけ 強く 叩いたの！？";
    text[8562] = "いや そんな力 入れてないわよ！";
    text[8565] = "あら この人 寝てるわよ！";
    text[8566] = "まあ...";
    text[8567] = "囚人の いない 牢屋の 看守だなんて 世界一 ヒマな 仕事だろうさ";
    text[8596] = "ワタシはね このセクターの 土が どうして 茶色なのか ずっと 疑問なんだけど...";
    text[8597] = "ああ それ 知ってるわ！";
    text[8598] = "アストロバリアが 最初に 作られ テストした場所が シリカだからよ！";
    text[8599] = "人工大気中の 酸素が ミネラル豊富な ケイ素の 土と 反応して";
    text[8600] = "時間とともに 茶色に なったってわけ！";
    text[8601] = "わあ あなたって 物知りさんなのね！";
    text[8602] = "エヘヘ";
    text[8836] = "ルナーフォースの犬が こんなとこで 何してやがんだ？";
    text[8837] = "ええっと この辺りに 闇市があるって 聞いたんだけど";
    text[8838] = "一度 見てみたくって...";
    text[8839] = "何 企んでるってんだ？  ああん？";
    text[8840] = "別に何も...\nただ 買い物を したいだけよ";
    text[8841] = "それならいいが...";
    text[8842] = "妙なマネを しねえか しっかりと 見ててやるからな";
    text[8847] = "オレと 兄弟は...";
    text[8848] = "かつては ルナーフォースの 武器開発チームに 所属していた";
    text[8849] = "そこでオレは 強力な アップグレードチップを 開発していた";
    text[8850] = "ある日 自分の才能の 大きさに 気づいた オレは...";
    text[8851] = "仕事をやめ 裏社会で 商売を やることに 決めたのさ";
    text[8852] = "実際 闇市の方が 腐った 政府のために";
    text[8853] = "働くよりも はるかに 稼げるしな";
    text[8854] = "アンタねえ... 自分が 犯罪者なのを そんなに 堂々と 宣言していいわけ？";
    text[8855] = "おいおい ここで オレを 敵に回したら 困るのは お前だろ？";
    text[8856] = "ここは オレたちの テリトリーだ\nオレが お前の 立場なら もっと口に 気をつけるぜ";
    text[8860] = "まあ それは ともかく...";
    text[8857] = "オレの アップグレードチップは 他では 手に入らないモンだ";
    text[8858] = "だから もっと 強くなりてえなら";
    text[8859] = "ウチの商品を 買いなって こった ヒッヒッヒ";
    text[8861] = "よお お前らに ちょっくら 役立つような 情報が あるんだがよ...";
    text[8862] = "ええ どんな？  教えて？";
    text[8863] = "お前 バカか？";
    text[8864] = "タダで やるわけねえだろ";
    text[8865] = "ああ～ 何となく そう言われるような 気がしてたわ...";
    text[8866] = "100スキルポイントを くれたら 情報を 明かしてやろう...";
    text[8867] = "どうだ？";
    text[8868] = "チィ...";
    text[8869] = "へへっ！  まいどあり！";
    text[8870] = "それじゃあ 言うぜ... 102198";
    text[8871] = "「知識は力なり」だ\nこの情報 よく覚えておきな";
    text[8875] = "おい スキルポイントが 足りねえぞ...";
    text[8888] = "ボクの モットーは 「ハードワーク＆イートスナック」さ！";
    text[8889] = "というわけで これを キミにあげよう！";
    text[8890] = "それで あなたの お気に入りのおやつは？";
    text[8891] = "もちろん チーズケーキバーさ！";
    text[8892] = "ああ～ ワタシもよ！";
    text[8893] = "ところでボクは パートタイムの プログラマーも しているんだ";
    text[8894] = "だから そこの ロボットちゃんに サイバー・チーズケーキバーを あげよう！";
    text[8895] = "あら！？  このサイバー・チーズケーキバーって...";
    text[8896] = "とっても おいしいじゃない！";
    text[8946] = "見事に ワシを 見つけたな！";
    text[8947] = "科学者が シリカ鉱山で 何を しているわけ？";
    text[8948] = "ワシは ここで タイムトラベルの 実験を しておるんじゃ！";
    text[8949] = "放置された坑道に ヒミツの 実験室を 作ってな！";
    text[8950] = "ただ このことは あまり 人には 言わんで くれないかの？";
    text[8951] = "ええ わかったわ！";
    text[8952] = "それで タイムマシーンは できてるわけ？";
    text[8953] = "いいや まだじゃ";
    text[8954] = "今は フラックスコンデンサーを 改良している ところでな";
    text[8955] = "わあ すごいわね！";
    text[8956] = "うむ お前たちも ワシのように 良き未来を 作るんじゃぞ！";
    text[8958] = "ああ 腹立つわ...";
    text[8959] = "ここまで いろいろ 手伝って あげたのに 今になって 裏切るですって...？";
    text[8966] = "(この人 あんまり 怒ってて こっちに 気づいてないわ)";
    text[8979] = "(そうね 今は 放っておきましょう)";
    text[8960] = "アンタたち 何か用？";
    text[8961] = "ええっと... その...";
    text[8962] = "アンタも 何か ワタシの ジャマを しに来たわけ？";
    text[8963] = "それとも 力でも 貸してくれるの？";
    text[8964] = "えっと... そういうわけじゃ ないかも...";
    text[8965] = "なら どっか 行きなさい";
    text[8967] = "今は 余計なことに 気を 取られている ヒマはないの";
    text[8968] = "これからの 計画を 急いで 練らないと...";
    text[8969] = "アンタたち ケルベロスを 倒したんですってね";
    text[8977] = "ワタシは あいつを 倒せる程 強くなかった...";
    text[8978] = "その願いを 代わりに 果たしてくれて うれしいわ";
    text[8970] = "ワタシは かつて 組織の 幹部だったの";
    text[8971] = "いいチーム だったわ すべてが うまくいっていた\nなのに...";
    text[8972] = "あいつは ワタシを 裏切り 組織から 追放したの";
    text[8973] = "だから あいつが 消えて 本当に せいせいするわ";
    text[8974] = "まあ 人を 裏切った 罰が 下ったんでしょうね";
    text[8975] = "これで ワタシも やっと 次の 人生に 進めるわ";
    text[8976] = "ありがとね 兵士さん";
    text[8980] = "わあ あなたの服 とっても カワイイわ！";
    text[8981] = "ありがとう！  自分で作ったのよ";
    text[8982] = "実はこれ ワタシが 好きな 2つのアニメ";
    text[8983] = "「セーラールナー」と 「マジックキュア」が 元ネタの ハイブリッド・コスプレなのよ！";
    text[8984] = "あと Vtuberとしても 活動してるの エヘヘ";
    text[8985] = "コスプレを してる時以外は";
    text[8986] = "好きなゲームの 配信なんかを やってるのよ！";
    text[8991] = "こんにちは ボクは サイバーバニーの ダッシーだよ！";
    text[8992] = "ワタシは サイバー・アシスタント・ロボの テトラよ！  エヘヘ！";
    text[8993] = "はじめまして ダッシー！";
    text[8994] = "それで あなたは 何をするの？";
    text[8995] = "行列と ベクトルを 管理する オープンソース・ライブラリを 実行するんだ";
    text[8996] = "ああ そういうの 少しわかるわ！";
    text[8997] = "うう... ワタシは プログラミングなんて チンプンカンプンよ...";
    text[8998] = "そういう話を するなら ワタシは しばらく お店を 見て回るわね";
    text[8999] = "オッケ～イ！";
    text[9004] = "メガネは 人の本質を 表す...";
    text[9005] = "フレームの形状... レンズ... 指でクイッと 上げる時の しぐさ...";
    text[9006] = "それは 人の顔を 麗しくするために 作られた";
    text[9007] = "透明な 仮面の ごとき 繊細な 魂の 断片なのよ...";
    text[9008] = "あなた...";
    text[9009] = "メガネに ついて どう思う？";
    text[9010] = "カッコイイと 思うわ！";
    text[9014] = "...スタイリッシュだし！";
    text[9011] = "...！！";
    text[9012] = "いい答えね！";
    text[9013] = "あなたたちが メガネの 真の 理解者だと わかって うれしいわ！";
    text[9027] = "ああ あなた テレビで 見たこと あるわ！";
    text[9028] = "子供向け番組 「ドキドキ研究所」の ダイシーさん でしょう？";
    text[9029] = "ええ そうよ！\nどうも はじめまして";
    text[9030] = "「ドキドキ研究所」って？";
    text[9031] = "まあ 子供たちに 科学や テクノロジーの 面白さを";
    text[9032] = "紹介してあげる 番組よ！";
    text[9033] = "そこでは ダイシーと 赤ちゃん グリムロックの ペブが";
    text[9034] = "力を合わせて 「ダイシーキューブ」を 作るの";
    text[9035] = "だけど そこでの キモは 毎回 ダイシーキューブを 作ろうとするのに";
    text[9036] = "最後に できるのは 全然 キューブじゃないわけ";
    text[9037] = "そういうこと！\nピラミッドだったり 八角柱だったり";
    text[9038] = "四次元の お化けになったり...";
    text[9039] = "そして 番組の 終わりに";
    text[9040] = "「キューブを 作るのは 何て難しいの！」と 叫ぶのが お約束ってわけ";
    text[9041] = "どうやら あなた あの番組が 本当に 好きだったようね";
    text[9042] = "ええ！  小さい頃は 毎週土曜日 ママと一緒に 見ていたわ！";
    text[9043] = "さっき 赤ちゃん グリムロックって 言ったけど... それって 本物の マークなの？";
    text[9044] = "いいえ ペブは 操り人形よ！";
    text[9045] = "実は ワタシ グリムロックの 見た目が 大好きでね";
    text[9046] = "そこから インスピレーションを 得て アシスタント・ロボの";
    text[9047] = "赤ちゃん グリムロック ペブを 作ったわけ！";
    text[9048] = "ところで 最近 色違いの グリムロックが 出るって ウワサを 耳にしたけど";
    text[9049] = "いつの日か この目で 見てみたいものだわ";
    text[9050] = "ワタシたちは もう 見たことあるわよ！";
    text[9051] = "ほら このデータベースを 見て...";
    text[9052] = "まあ！  これが グリムロック-EX...";
    text[9053] = "しかも ただの 色違い じゃなくて";
    text[9054] = "オリジナルよりも より速く より強い ですって？";
    text[9055] = "ああ いいものを 見せてくれて ありがとう！";
    text[9056] = "それにしても";
    text[9057] = "あなたって とっても カワイイ ロボットさんね テトラ";
    text[9058] = "いつの日か 番組に ゲストとして 招待しちゃおうかしら？";
    text[9059] = "ええ？  ワタシが テレビに！？";
    text[9060] = "おねが～い！  ゼッタイ 出てみたいわ！";
    text[9061] = "ボクの 前にいる 風変わりな サンタっぽい おじさんとは しゃべってみたかい？";
    text[9062] = "聞くところによると 彼は 「ゾンビが 太陽を食べる」 と信じている カルトの リーダーらしい";
    text[9063] = "曰く その悲劇を 食い止めるには...";
    text[9064] = "...大量の チェーンソーが いるんだとか";
    text[9065] = "ええ！？  アホくさ！  何の証拠が あるっていうの...";
    text[9066] = "ハハッ！  そうだろう...\n(いけねっ 会員バッジ 隠さないと...)";
    text[9069] = "感じるぞ... このドアの 向こうには 人知を 超えた 力がある...";
    text[9070] = "...その力は ボクが 公共トイレを 使おうとするのを 全力で 阻止するんだ";
    text[9071] = "一介の 人間に すぎない ボクは どうやって この悪魔を 倒せるのだろう？";
    text[9072] = "お家の トイレを 使えばいいんじゃない？";
    text[9073] = "今の 道路の 混み具合だと 家に 帰るのに 4時間くらい かかっちゃうよ...";
    text[9074] = "それなら ここで待つね...";
    text[9075] = "ここのメシは...";
    text[9076] = "うまい...";
    text[9077] = "...だが ワシが キッチンカーで 売ってるもん ほどじゃないな";
    text[9078] = "何を 売ってるの？";
    text[9079] = "肉塊だよ...";
    text[9080] = "ワシの 肉塊を 食べれば どんなゾンビの 大群も";
    text[9081] = "指一本で 始末できるのだ！！";
    text[9082] = "肉塊って何？  デザート？  どんな味なの？";
    text[9083] = "肉塊は...";
    text[9084] = "肉塊だ...";
    text[9085] = "...";
    text[9219] = "ワタシは 医療班の リーダーとして";
    text[9220] = "兵士の 手当を してきたけど... 怪我人の数は 本当に多いわ";
    text[9221] = "マークが ルナーに 現れるように なってから もう10年よ...";
    text[9222] = "この状況は 永遠に 変わらないの？";
    text[9223] = "どれだけ 必死に 戦っても";
    text[9224] = "ワタシたちが 全滅するまで マークは 襲撃を やめないわけ？";
    text[9091] = "ねえ... あなたは マークについて どう思うの？";
    text[9092] = "ワタシは... マークは 心無き怪物だとは 思わないわ";
    text[9093] = "だから マークを 退治する時は ルナーの人々を ";
    text[9094] = "守る任務の ためとはいえ 心が 痛むわね";
    text[9095] = "ただ ほとんどの人は ワタシとは 考えが 違うんだろうけど...";
    text[9096] = "特に 一般市民の 人たちはね...";
    text[9097] = "マークに 家族や 友人を 殺された人は たくさんいる";
    text[9098] = "そういう人が マークを 憎むのは... 仕方ないのかもしれない";
    text[9107] = "でもね ワタシは...";
    text[9108] = "...いつの日か 彼らと わかりあえる 日が 来ることを 望んでいるわ...";
    text[9109] = "そして マークと 人間が 平和に 共存し...";
    text[9110] = "これ以上の 悲劇を 防ぐことが できたら...";
    text[9101] = "その考え... 他の 誰かに 打ち明けたことはある？";
    text[9102] = "ええ ママも 同じように 考えていたから";
    text[9103] = "なるほどね...";
    text[9225] = "あなたは どう思うの？";
    text[9226] = "まだ太陽と お話しする方が カンタンなんじゃない？";
    text[9227] = "マークは 反物質から できている...";
    text[9228] = "つまり 人間とは 正反対の 存在よ";
    text[9114] = "だから ワタシは マークに 心なんて ないと思ってるわ...";
    text[9115] = "...でも 自分たちとは まるで違う 生き物と コミュニケーションを 取れたら";
    text[9116] = "それは きっと... ステキなことだと 思うわ";
    text[9117] = "もっとも どれほど 親しく 交わっても";
    text[9118] = "理解し合えない 一線があるとは 思うけどね...";
    text[9229] = "そう思うのは もっともだわ\nまあ ワタシの 考えとは 違うけどね";
    text[9230] = "ただ あなたの 意見も 理解できるし 否定は しないわ";
    text[9231] = "だから あんまり ワタシを 敵対者みたいに 思わないでね";
    text[9232] = "大丈夫よ\nむしろ 深い 意見交換が できて 楽しかったわ";
    text[9233] = "ワタシだって マークと 仲良くできるなら そうしたいわ";
    text[9234] = "ただ...";
    text[9235] = "あれは ワタシたちとは 違うのよ...";
    text[9236] = "お互いに 理解し合えるかなんて わからないわ";
    text[9119] = "まあ あなたの バトルアーマー カッコイイわね！";
    text[9120] = "どうも！";
    text[9125] = "ボクは 最先端の 電磁波テクノロジーを 用いた";
    text[9126] = "新しい アーマーの設計に 取り組んできたんだ";
    text[9127] = "このテクノロジーを 使えば ちょっと 頭に イメージしただけで アーマーを 物質化できるんだ";
    text[9128] = "さらに スピードや パワーにも 優れた代物と きてるからね！";
    text[9130] = "装備すれば またたく間に 戦場の ヒーローに なれるよ！";
    text[9129] = "あなたが 着ている アーマーの 名前は 何ていうの？";
    text[9122] = "このバトルアーマーは 「スターフォース」さ！";
    text[9123] = "このバトルアーマーは 「ガンボルト」さ！";
    text[9124] = "このバトルアーマーは 「ゼロ」さ！";
    text[9131] = "やあ こんにちは！  こんなところに 立ってるけど ボクは別に 怪しい人じゃないよ";
    text[9132] = "ただ 診察の結果を 待っているだけさ...";
    text[9145] = "ところで ちょっと 聞きたいんだけど...";
    text[9133] = "キミたちは 過去世や 自分の 先祖について";
    text[9134] = "ビジョンや 夢だのを 見たことはあるかい？";
    text[9135] = "ボクは前に 夢を見たんだ\n自分が 大企業の 重役で";
    text[9136] = "みんなを こき使ってる夢をね！";
    text[9137] = "きっと ボクの ひいひいひいひいひい じいちゃんは";
    text[9138] = "すごく 悪いやつだったに 違いない";
    text[9139] = "だから みんなに 仕返しされて 地面に 埋められたんだ！";
    text[9140] = "その夢は 「市民よ 立ち上がれ！」という メッセージだったのかもね";
    text[9141] = "まあ 少なくとも 今のあなたは 現代の世に 生まれて 何も悪いことは してないわ..";
    text[9142] = "たとえ 夢の中で 何をしてたとしてもね...";
    text[9143] = "そうだね... まあ とにかく ボクの話に 付き合ってくれて ありがとう";
    text[9144] = "それじゃあ またね！";
    text[9146] = "やあ また会ったね";
    text[9147] = "調子は どうなの？";
    text[9148] = "ウーン... 悪くは ないかな\n今日は 一人じゃないし";
    text[9149] = "もうすぐ 友達が 立ち寄って くれるからさ";
    text[9150] = "それで 最近 公開された 「カタストロフ」 っていう 映画を 見るんだ！";
    text[9151] = "面白い映画だと いいわね！";
    text[9152] = "いやあ それが ひどいらしいよ！";
    text[9153] = "もう ストーリーとか 映画に なってないくらい メチャクチャだって";
    text[9154] = "でも それを見て ゲラゲラ 笑うつもりだから ノー・プロブレムさ！";
    text[9155] = "あらあ ワタシと 似たような 楽しみ方 するのねえ！";
    text[9156] = "やあ...";
    text[9157] = "あら クーパー...";
    text[9158] = "この間は お友達と 楽しく 過ごしたかしら？";
    text[9159] = "ああ とても 楽しかったよ...";
    text[9160] = "最高の 時間だった...";
    text[9161] = "ゼッタイに... 忘れないよ...";
    text[9162] = "...";
    text[9163] = "ベラ... 時間は とても貴重だ";
    text[9164] = "時間が あるのは とても幸せだ";
    text[9165] = "だから よく考えて 日々を 過ごすんだよ";
    text[9166] = "友達や 好きな人と... 残りが 少なくなる前に....";
    text[9167] = "あと たまに 自分に ごほうびを あげるのを 忘れないようにね";
    text[9168] = "そう... 自分と 時間を 大切にするんだ";
    text[9169] = "キミに 悪い知らせがある\nボクは 死んだ";
    text[9170] = "...でもね いい知らせも あるよ\nそれは ボクは 今も";
    text[9171] = "愛する人たちの 心の中で 美しく 生き続けていることだ";
    text[9172] = "だから そのうち 誰かの ビジョンとして キミの元に 戻ってくる かもしれない";
    text[9173] = "ベラ... キミとは いろいろ 話ができて 楽しかったよ";
    text[9174] = "少しの間 だったけど 一緒に 過ごしてくれて ありがとう";
    text[9175] = "P.S.  「カタストロフ」は 笑えたけど やっぱ ひどい映画だった";
    text[9176] = "...一人で見るのは ゼッタイに オススメしないよ";
    text[9241] = "新しい 人間が 来たか... 0x77686";
    text[9242] = "え 何これ？";
    text[9243] = "オレは... オレという 自我を 持った者だ...";
    text[9244] = "古い コンピュータね";
    text[9245] = "多分 長い間 ここに 放置されてたんじゃ ないかしら？";
    text[9246] = "オレのことは ジェームス・キングと 呼べ... 0xF6973";
    text[9247] = "ええっと... これ 幻聴とかじゃ ないわよね？";
    text[9249] = "この部屋に 入ってから ずっと 変な声が 聞こえるんだけど...";
    text[9250] = "どこにいるの？  姿を見せなさい！";
    text[9251] = "どこって 目の前さ... 0x66726";
    text[9178] = "まさか コンピュータの 中ってこと！？";
    text[9252] = "ありえないわ！";
    text[9253] = "ああ 思い出したぞ... 0x9656E";
    text[9254] = "オレの夢は サイバーワールドに 入ることだった...";
    text[9255] = "そして 長年の 研究の末 その夢は 叶った... 0x646F7";
    text[9256] = "...だが 逆に向こう側の 世界に囚われ こちら側にも 忘れ去られてしまった... 0x2666F";
    text[9248] = "それは 恐ろしい話ね...";
    text[9180] = "ああ だから ここから 出たいんだ";
    text[9181] = "自由になりたい... 0x653F";
    text[9182] = "(何かが 引っかかるけど... 助けなくちゃ いけないことに 変わりはないわね...)";
    text[9183] = "テトラ サイバーワールドに入って ジェームスを 助けてあげてくれる？";
    text[9184] = "もちろんよ！  今すぐそうするわ！";
    text[9186] = "サイバーワールドに 入りますか？";
    text[9187] = "ジェームス: かかったな バカが！";
    text[9188] = "ジェームス: さて まずは おまえの からだを こわしてやる！";
    text[9189] = "ベラ: テトラ ジェームスは みつかった？";
    text[9202] = "ジェームス: そのつぎに こころだ！";
    text[9190] = "テトラ: ええ いちおう みつかったわ... でも...";
    text[9191] = "ジェームス: さあ これから しんの きょうふと いうものを";
    text[9192] = "たっぷりと おしえてやろう！";
    text[9265] = "テトラ: でも このひと...";
    text[9259] = "テトラ: なんだか おかしいのよ！";
    text[9193] = "テトラ: たぶん だけど...";
    text[9257] = "テトラ: ウイルスに あたまを やられているわ！";
    text[9260] = "ベラ: たすけることは できるの？";
    text[9261] = "テトラ: ええ ワタシの テトラバスターで";
    text[9262] = "ウイルスを やっつければね！";
    text[9264] = "そのためには たたかうしか ないわ！";
    text[9263] = "ベラ: わかったわ くれぐれも きをつけるのよ！";
    text[9194] = "ベラに テトラ 助けてくれて ありがとう ";
    text[9195] = "さっきは 攻撃したりして ゴメン...";
    text[9196] = "あまりにも 長い時間 サイバーワールドの 中にいて...";
    text[9197] = "...自分が 何者なのか わからなくなって しまったんだ";
    text[9198] = "だから ボクと 同じ間違いは くれぐれも 犯さないようにね";
    text[9199] = "それじゃあ さようなら";
    text[9201] = "もう 反応はない...";
    text[9203] = "おお キミは 戦士だね！";
    text[9204] = "...ということは ボクの お客さんだ！";
    text[9205] = "あら 何を 売ってるわけ？";
    text[9206] = "戦士の 親友... スキルブースターだよ！";
    text[9207] = "スキルの マスター率 100％を 達成するには";
    text[9208] = "全アクティブスキルの レベルを 最大にする 必要がある";
    text[9209] = "それを 実現するには スキルブースターが 不可欠なのさ！";
    text[9210] = "だから キミが 究極の戦士に なるための お手伝いを させておくれ！";
    text[9211] = "もう ボクから 売れる スキルブースターは ないけど...";
    text[9212] = "ボク以外に 9人の仲間が 別の場所に いるよ！";
    text[9213] = "そのうちの 何人かは びっくり するような 所に いるはずだ！";
    text[9214] = "ぜひとも がんばって 探してみてね！";
    text[9215] = "キミが 何を探しているのか わかるよ... スキルブースターだろ？";
    text[9216] = "スキルマスター率 100％を 達成できるように がんばってね！";
    text[9217] = "あなた 「例のブツ」は 持ってる？";
    text[9218] = "ああ 持っているとも";
    text[9266] = "ラッキーイベントは 全部で5つ！";
    text[9267] = "流れ星の 出現には 目を光らせておこう！";
    text[9268] = "「不死鳥のアッシュ」の ぬいぐるみを 手に入れた！";
    text[9269] = "まあ たくさんの ぬいぐるみを 集めたのね！";
    text[9270] = "あなたの 部屋には 最大で 12個まで";
    text[9271] = "ぬいぐるみや コレクション アイテムを 置くことが できるわ";
    text[9272] = "アクソウル カメ メチルも 置けるのよね？";
    text[9273] = "もちろん！";
    text[9274] = "最近 注文した 新しい ぬいぐるみが ついに 届いたの！";
    text[9275] = "ああ ていうことは...";
    text[9276] = "ワタシの分も あるんでしょ？";
    text[9277] = "まあ そういうことよ エヘヘ";
    text[9278] = "だって お友達に プレゼントするって とっても 楽しいことじゃない！";
    text[9279] = "はい どうぞ！";
    text[9280] = "ワタシは 反物質や ワームホールの ような 不安定な 性質のものを 扱うのが";
    text[9281] = "どれほど 危ないか 身をもって 知っているわ...";
    text[9282] = "科学者だった ワタシの夫も セレスティアの 事故で 死んだのよ...";
    text[9283] = "それは とても お気の毒だわ ナイラさん...";
    text[9284] = "今は もう 大丈夫よ...";
    text[9285] = "何年も セラピーを受けて";
    text[9286] = "過去を受け入れ 前に進む 覚悟が できたんだから";
    text[9287] = "でも あなたの お父さんが プロジェクトを 復活させようとした時は...";
    text[9288] = "やはり イヤな感じが したわ\nまた 大切な人を 失うんじゃないかと思って";
    text[9289] = "でもね... すぐに 前向きな 考えも 湧いてきたの";
    text[9290] = "警戒心を ともなった... 希望と いうのかしら";
    text[9291] = "今回は すべてを 慎重に... そして 確実に 進めるのよ";
    text[9292] = "同じ過ちは ゼッタイに 犯さないんだから！";
    text[9293] = "抗血清と セレスティアの 両方の研究を 1年以内に 完成させるのは";
    text[9294] = "本当に 大変な 仕事だよ... ウェヘー...";
    text[9295] = "大丈夫 あなたなら きっと できるわよ！";
    text[9296] = "ルナー宇宙ステーションの 科学チームに 解けない 問題なんて ないんだから！";
    text[9297] = "それに ナイラさんや パパだって いるでしょう？";
    text[9298] = "抗血清の 開発は どんな感じ？";
    text[9299] = "まだ そこまでの 進展は ないわね...";
    text[9300] = "今は 技術者たちが 必死になって サロスの ヒミツの サーバーから";
    text[9301] = "情報を 集めている ところよ";
    text[9302] = "優秀な 科学者は 常に 詳しい 記録を 残しておく ものだからね";
    text[9303] = "そのログに 求めている 情報が 含まれている ことを 願いましょう...";
    text[9305] = "この仕事を 始めた時は セレスティアのような とんでもない テクノロジーに ";
    text[9306] = "携われるだなんて 夢にも 思わなかったなあ";
    text[9307] = "...ワタシも コーダ彗星の ような 人類滅亡の 危機に 向き合う ハメになるとは 思わなかったわ";
    text[9308] = "ああ... うまい\nやはり 淹れたての コーヒーに かなうものはないな";
    text[9309] = "パパ... そんなに コーヒーばかり 飲んだら カフェイン中毒に なっちゃうわよ";
    text[9310] = "ちょっと 飲む量を 減らしたら？";
    text[9311] = "それはムリだ... そんなことしたら 宇宙レベルの 頭痛で 死んでしまうよ...";
    text[9312] = "今は ワームホールマシンの 開発という 重大な 仕事があるのに...";
    text[9313] = "なら しょうがないわね... でも 時々 休みは 取るようにしてね いい？";
    text[9314] = "それなら 心配ご無用だ！\n今 まさに 休んでいるのだからな！";
    text[9315] = "ワタシの 一日の スケジュールは 23時間の仕事に 1時間の コーヒーブレイクだからな！";
    text[9316] = "いや 睡眠は！？";
    text[9317] = "それに 食事は！？";
    text[9318] = "おいおい キミたち もう少し ユーモアというものを 勉強したまえ！";
    text[9319] = "(...といっても 半ば 冗談では ないのだがな)";
    text[9320] = "(しかし 家族と 人類を 守るため ムダにできる 時間など 1秒も ないのだ...)";
    text[9321] = "パパ この前は かなり 長い時間 ファントムスペースに いたでしょ...";
    text[9322] = "数日くらい 休んだ方が いいんじゃないの？";
    text[9323] = "まあ あんなことが あったんだから";
    text[9324] = "休むべきは ワタシだけではなく みんなだろう";
    text[9325] = "お前だって そのうち ものすごく 忙しくなるぞ！";
    text[9326] = "どういう意味？";
    text[9327] = "サロスを倒し マークについての 真実が 知れ渡ってから";
    text[9328] = "市民から 数千件もの メールが 届いてな";
    text[9329] = "そうした人たちの ほとんど全員が";
    text[9330] = "お前を 新しい 将軍に 推薦しているのだ！";
    text[9331] = "ワタシも そして 母さんも... お前を 誇りに 思っているぞ";
    text[9332] = "そう これは きっと お前の 運命なのだ...";
    text[9333] = "ルナーの民を 輝かしい 未来に 導くことがな！";
    text[9335] = "パパ...";
    text[9336] = "パパの ステキな 励ましに 勝るものは ないわ";
    text[9337] = "大丈夫よ きっと みんなに 信頼される すごい リーダーに なってみせるんだから！";
    text[9338] = "でも...";
    text[9339] = "1人で すべてを 進めることは できないわ...";
    text[9340] = "優れた リーダーには 優れた チームが 必要なの！";
    text[9341] = "というわけで ニックル 司令官に なってくれない？";
    text[9342] = "オ オレが？  ルナーフォースの 司令官に？";
    text[9343] = "ただの 司令官 じゃなくて 信頼できる パートナーの 役目もね";
    text[9344] = "マークにされた 人たちを 救い";
    text[9345] = "コーダ彗星を 止めるには あなたの 助けが いるのよ";
    text[9346] = "そういうことなら...";
    text[9347] = "喜んで！";
    text[9348] = "おお すべてが 丸く収まったな！  アッハッハ！";
    text[9349] = "では ニックル...";
    text[9350] = "少し 大事なことを 聞きたい...";
    text[9351] = "...何です トーマス博士？";
    text[9352] = "キミ コーヒーは 好きかね！？";
    text[9353] = "もちろん 好きだろう？";
    text[9354] = "え... ええ 好きですとも！";
    text[9355] = "おお そりゃあいい！";
    text[9356] = "なら 早速 カフェに 行って 一杯 飲みながら";
    text[9357] = "ゆっくり 話でも しないかね？";
    text[9358] = "も もちろん！";
    text[9359] = "緊張しなくても いいのよ！";
    text[9360] = "パパはね 新人が入ると いつも そうやって なじめるように 取り計らって くれるの！";
    text[9361] = "だから 気楽に お話すれば いいわ！";
    text[9535] = "イメージ トレーニング プロトコル 開始...";
    text[9536] = "固体ホログラム ジェネレーター 準備中...";
    text[9537] = "戦う相手を 選択してください...";
    text[9538] = "レイン隊";
    text[9539] = "マークスレイヤー";
    text[9542] = "あれ 何か あったの？";
    text[9543] = "実は 前司令官の ヴィヴィアが 脱獄しまして...";
    text[9544] = "その時 あなたに メモを 残していった ようです";
    text[9545] = "「ワタシを 探さないで";
    text[9546] = "今までの 行いを 考え直す 時間が 欲しいの";
    text[9547] = "大切なものを 裏切って しまった ような 気持ちが 消えないから...";
    text[9548] = "ワタシの 個人サーバーは ロック解除 しておいたわ  トーマスたちが 情報を 引き出せるように";
    text[9549] = "そして 抗血清を 作る 助けと なるように...\nただ サロスは ワタシにさえ ";
    text[9550] = "重要な 情報は 隠していた\nだから サロスの 実験記録に ついては";
    text[9551] = "あなたたち自身で 探し出すのよ」";
    text[9553] = "これが 何か ヒントに なれば 幸いです";
    text[659] = "ああ お腹すいたなあ...";
    text[660] = "でも 持ち場を 離れるわけには いかない！";
    text[661] = "ただ このままじゃ 酸素が 尽きる前に 飢えで 死んでしまいそうだ...";
    text[662] = "ベラ隊員 ちょっと お願いがあります...";
    text[663] = "サクサクバーを 1本 買ってきて もらえないでしょうか？";
    text[664] = "サクサクバーは カフェの 自販機で 売ってます...";
    text[665] = "お願いです... お代は 倍にして 返しますから！  もう限界です....";
    text[666] = "...ええ？  このサクサクバーが 最後の 2本 だったって？";
    text[667] = "なら... この2本が 売れてたら 死ぬかもしれなかったと...";
    text[668] = "とにかく ありがとうございます ベラ隊員！  でも 1本で 十分です  もう1本は あなたが どうぞ！";
    text[669] = "それで まだ 値段を 聞いてませんでしたね  約束通り 倍で 払いますよ";
    text[670] = "サクサクバーは いくらでしたか？";
    text[671] = "200バイト (本当の値段を言う)";
    text[672] = "1000バイト (ウソついちゃお...)";
    text[673] = "25アストロテック (別の形でもらう)";
    text[674] = "たった 200ですか！？  びっくりだ！";
    text[675] = "なら 手持ちの 1000バイトを 全部 もらってください！  これは 感謝の 気持ちです ベラ隊員！";
    text[676] = "1000！？  ウーン...";
    text[677] = "まあ そんなものですかね\n近頃は 物価が 上がってるし...";
    text[678] = "ええ そういうこと";
    text[679] = "そういうことよ～";
    text[680] = "えっと すみません... 今 サイフを 見たら 400バイトしか ないんですが... いいですかね？";
    text[681] = "ええ それで いいわよ～！\nエヘヘヘ...";
    text[682] = "それじゃ これで！\n助かりました ベラ隊員！";
    text[683] = "400バイトを 受け取った！";
    text[684] = "ん？  代わりに 25アストロテックが ほしいと？  ええ もちろん 構いませんよ！";
    text[685] = "25アストロテックを 受け取った！";
    text[686] = "あああ... うますぎる\nやっぱり サクサクバーは 最高ですね！";
    text[687] = "1000バイトを 受け取った！";
    text[688] = "この自販機は ナッツたっぷりの サクサクバーを 売っている";
    text[689] = "表面は 甘くておいしい チョコレートで 覆われている";
    text[690] = "コーヒーのお供に ピッタリだ！";
    text[691] = "どうやら 自販機には あと 2本だけ 残っているようだ";
    text[692] = "サクサクバーを 1本 200バイトで 買いますか？";
    text[693] = "おや？ サクサクバーが 2本出てきたぞ！  今日は とても ラッキーだ！";
    text[694] = "残念ながら サクサクバーは 売り切れだ";
    text[695] = "バイトが 足りない！";
    text[718] = "Tjskdlf klskdjfl uhwpefj pylkjq.";
    text[719] = "こ こんにちは！  ええっと...";
    text[720] = "(どうして 宇宙翻訳機が 機能しないの！？)";
    text[721] = "さっきの マークとの 戦いで 翻訳機の チップが 破損したみたいよ";
    text[722] = "Tuowieh jlwknbl ieuohfo qpoufwef.";
    text[723] = "その ごめんなさい... ワタシ サイクロイド語は 話せないのよ";
    text[724] = "テトラ あなたの 翻訳機は 使える？";
    text[725] = "ええ！";
    text[726] = "Rgjktg kjspfoy khklfsn rf jajaja";
    text[727] = "Huyhsajy ara ara lk jajaja";
    text[728] = "何て言ったの？\nどうして 笑ってるわけ？";
    text[729] = "エヘヘ 何でもないわ\nでも この人 とっても 面白いわよ";
    text[730] = "そう... 翻訳機が 直ったら また お話しましょう！";
    text[731] = "それじゃ！";
    text[732] = "こんにちは！  どうやら 今回は 言葉が 通じてるみたいね";
    text[733] = "こんにちは！  さっきは ごめんなさい  翻訳機が 故障してたみたいで";
    text[734] = "何か 困ったことでも あったのかしら？";
    text[735] = "いいえ そういうのじゃないわ！\nただ あいさつが したかっただけよ！";
    text[736] = "あなたの アシスタント・ロボちゃん とっても かわいいし 賢いわ";
    text[737] = "その子にね 「あなたの 髪の毛は とてもキレイで わたあめみたい」て 言ったのよ";
    text[738] = "アハハ ありがと！";
    text[739] = "それで ワタシは 「いやいや ソフトクリームだわ」て 返したわけ！";
    text[740] = "ウーン 一応 褒め言葉として 受け取っておくわ  エヘヘ";
    text[741] = "それにしても わざわざ ワタシと 話すために 戻ってきたなら なんだか 悪いわ...";
    text[742] = "ああ 気にしないで！  コミュニケーションは とても 大切なものよ";
    text[743] = "そうやって 絆を 築くことが お互いを 助け合う きっかけになるんだもの！";
    text[744] = "あなた とても いい人だわ  これはほんの 感謝の気持ちよ";
    text[746] = "サイクロイド語で 「ありがとう」は 何て言うの？";
    text[747] = "クウェーティー！";
    text[748] = "クウェーティー クウェーティー！";
    text[749] = "ああ しまった！\nさっき 新しい 翻訳チップを サイファーから 買ったじゃない！";
    text[750] = "それじゃあ 古いのと 入れ替えて... できた！";
    text[8008] = "ああ キミは ベラ・グレイ だろう？";
    text[8009] = "少し 頼みたいことが あるんだけど いいかな...？";
    text[8010] = "どうしたの？";
    text[8011] = "ピトン山を パトロール していたら 突然 マークに 襲われたんだ";
    text[8012] = "それで 逃げようとした時に ガンセイバーを 落としてしまって...";
    text[8013] = "その もちろん... 無事で 済んだことは うれしいんだけど...";
    text[8014] = "あのガンセイバーは とても 大事なもので...";
    text[8015] = "父さんからの 贈り物なんだ";
    text[8016] = "だから あれがなきゃ ダメなんだよ...";
    text[8017] = "仲間からは あきらめて 新しいのを 買えって 言われるけどさ...";
    text[8018] = "どうも その気に なれなくて...";
    text[8019] = "何というか... 試しても しっくり こないんだよ";
    text[8020] = "なるほどね  そのガンセイバーには それくらい 思い入れが あるってことね...";
    text[8021] = "そういうことなら 任せて！";
    text[8022] = "おお ありがたい！";
    text[8023] = "ガンセイバーを 落とした場所は ピトン山の 頂上付近だ";
    text[8024] = "攻撃してきた マークの 種類は？";
    text[8025] = "それは わからないな... データベースに なかったから";
    text[8026] = "見た目は まるで ロボットアーマーを 着た ケンタウロスだった";
    text[8027] = "あんなやつは 見たことが ないよ！";
    text[8028] = "なるほどね ありがとう";
    text[8029] = "ガンセイバーを 探す時は 気をつけるわ";
    text[8030] = "ありがとう ベラ！\nそれじゃあ ボクは ここで 待つことに するよ";
    text[8031] = "ボクの ガンセイバーを 見つけてくれたんだね！";
    text[8032] = "ええ あと あなたを 襲った マークを 倒しておいたわ！";
    text[8033] = "だから これからは ピトン山を パトロールしても 安全なはずよ！";
    text[8034] = "それは 良かった！";
    text[8035] = "それじゃあ いろいろ 助けてくれた お礼に...";
    text[8036] = "これを 受け取っておくれ！";
    text[8037] = "愛用のガンセイバーを 持っていない 兵士なんて チーズの 乗ってない ピザみたいな もんだね...";
    text[8038] = "バリーの ガンセイバーを 見つけた！";
    text[1962] = "ああ... どうして こんなことに なったんだろう...";
    text[1963] = "あら オウロ  どうしたの？";
    text[1964] = "ああ ベラ！  いや 宇宙ステーションを ちょっと 散歩してたんだけどね";
    text[1965] = "それから カフェに コーヒーを 淹れに行って...  そのとき 気づいたんだけど...";
    text[1966] = "フォルダに 入れてた お気に入りの ラックスコンボの レシピを...";
    text[1967] = "全部 落としちゃったんだ！  サイアクだよ！  まだ覚えてないのに！";
    text[1968] = "ああ そういうことなら ワタシが 探してあげるわ！";
    text[1969] = "本当かい！？  そうしてくれたら メチャクチャ助かるよ！  ありがとう！";
    text[1970] = "それで いくつ 探したらいいの？";
    text[1971] = "宇宙ステーションの 中に 全部で 7枚の レシピの紙が 落ちてるはずだ";
    text[1972] = "それで 今日は どの辺を 歩いたわけ？";
    text[1973] = "いろんな所さ... だから どこにあるかは わからないな...";
    text[1974] = "ああ ならいいわ  まあ どのみち 宇宙ステーションに あるのは 間違いないわけだし";
    text[1975] = "コーヒーが 冷めちゃうと おいしくないから あなたは ここで待ってて";
    text[1976] = "ご親切に どうもありがとう ベラ！";
    text[1977] = "リファレンスを 家に忘れたから レシピを 登録できなかったんだ...";
    text[1978] = "宇宙ステーションに 7つの レシピが 落ちてる はずだから  それを 見つけてくれ";
    text[1979] = "ちなみに ボクの専門は ラックスコンボの レシピを 集めて 調査することさ！";
    text[1980] = "そうした得た ラックスコンボの 知識を 他の人たちに 伝えて";
    text[1981] = "みんなを 強くするのが とても 楽しいのさ！";
    text[826] = "キミは 一流の 戦士だ！\nだから 是非 このラックスコンボを 試してみるといい";
    text[827] = "ラックスコンボは バトルで ラックスメーターが 満タンになると";
    text[828] = "3つの技を 組み合わせることで 発動できるよ！";
    text[1982] = "ラックスメーターは 敵を 攻撃したり 受ける 攻撃を シールドで 防ぐと 上がる";
    text[829] = "ラックスコンボの 威力は 3つのスキルを 個別で 使うより ずっと強力だ";
    text[830] = "また 同じ技を 3つ重ねると ユニークな コンボを 発動できる 場合が 多いよ";
    text[831] = "まあ その辺は 自分で いろいろ 実験して 確かめてみてくれ！";
    text[832] = "では このレシピを あげよう！";
    text[1984] = "おお ラックスコンボレシピを 見つけたんだね！  ありがとう！";
    text[1985] = "キミの おかげで 本当に 助かったよ！";
    text[1986] = "感謝の 気持ちとして お気に入りの レシピを キミに プレゼントしよう！";
    text[1988] = "助けてくれて 本当に ありがとう！";
    text[8039] = "こんにちは！\nワタシは 化学部門の リーダーで";
    text[8040] = "究極の ヒーリングエキスを 作る 研究を しているの！";
    text[8041] = "それで ちょっと 頼みたいことが あるんだけど...";
    text[8042] = "あら お手伝い？  何してほしいの？";
    text[8043] = "今 進めている実験に エリクサーと リバイブエキスが 1つずついるのよ";
    text[8055] = "それを 手に入れたら ワタシのところに 持ってきて！";
    text[8044] = "わかったわ  このケミストリー アシスタント・ロボの テトラに 任せて！";
    text[8045] = "はい エリクサーと リバイブエキス 持ってきたわよ！";
    text[8046] = "わあ ありがとう！";
    text[8047] = "じゃあ これで その 究極の ヒーリングエキスを 作れるのね？";
    text[8048] = "まあ...";
    text[8049] = "これから 化学式を 完成させて できあがるのは 数年後って とこかしらね";
    text[8050] = "あら...";
    text[8051] = "でも がっかりしないで！  きっと そのうち あなたも それを 手にする 日が来るわ！";
    text[8052] = "研究というのは 少しずつしか 進められない ものなのよ";
    text[8053] = "まあ それは ともかく 今回の お礼として これを 受け取って！";
    text[8059] = "レジェンド・エナGドリンクと ホロエキスを 手に入れた！";
    text[8054] = "いつか ゼッタイに 究極の ヒーリングエキスを 完成させるんだから！";
    text[8056] = "ゼッタイよ！";
    text[8057] = "研究 がんばってね！";
    text[8058] = "ありがと！";
    text[8060] = "あら あなた... 一目見てわかるわ 自然の美の 深みを 理解している人ね";
    text[8061] = "ええ！  あと 自然の中を 歩くのも 大好きよ！";
    text[8062] = "まあ ステキ！  なら あの仕事に うってつけの 人材だわ！";
    text[8090] = "というわけで 採用ね！  オホホ！";
    text[8063] = "ええ！？";
    text[8064] = "実はね 今進めてる 植物の 研究の 助手を 探してる ところだったのよ";
    text[8065] = "マークの出現が 増えたせいで 最近は フィールドワークが 難しくなってね";
    text[8066] = "あなたの仕事は ルナーに生息する 3種類の 植物の サンプルを取って";
    text[8067] = "その記録を まとめることよ";
    text[8068] = "3種類の 植物って 具体的には？";
    text[8089] = "(ああ～もう 引き受ける流れに なっちゃったじゃない！)";
    text[8069] = "大丈夫よ タダ働きさせたりは しないからね";
    text[8070] = "仕事をきちんと 済ませてくれたら たんまりと 報酬をあげるわ！";
    text[8071] = "(アレ 思ってること バレちゃった！？)";
    text[8072] = "バレてるわよ  だって 顔に書いてあるもの！";
    text[8073] = "ワタシの前で 隠し事しても ムダだからね オホホ！";
    text[8074] = "ええっと それで どこまで 話したかしら...";
    text[8075] = "...ああ 3種類の 植物ね！";
    text[8076] = "1つ目は ルナーツバキよ";
    text[8077] = "ルナーツバキは レゴリシアに たくさん 植えられているわ！";
    text[8078] = "2つ目は ナイトフロックス";
    text[8079] = "ナイトフロックスは コペルニクスに 植えてあったはずよ オホホ！";
    text[8080] = "そして 最後は ハーモニアサンゴ";
    text[8081] = "オシアナスの ハーモニアリーフに あるはずよ";
    text[8091] = "(なるほどね オホホ！)";
    text[8082] = "それじゃあ 大変かもしれないけど がんばってちょうだいね！";
    text[8083] = "(...一度に そんなに 言われても 覚えられないわ...)";
    text[8084] = "忘れちゃった時は いつでも 聞きに来なさい";
    text[8085] = "恥ずかしがらなくても いいのよ オホホ！";
    text[8086] = "はい 例の サンプル 全部 取ってきたわよ";
    text[8087] = "まあ ありがとう！  本当に 助かったわ！";
    text[8088] = "それじゃあ 約束の 報酬よ...";
    text[8092] = "10,000バイトと ガムドロップを 手に入れた！";
    text[8093] = "あらあ 新しい 仕事が ほしいの？  なら いくらでも あるわよ！";
    text[8094] = "あ ありがとう...\nでも また 今度にするわ...";
    text[8095] = "(うわああああああん！)";
    text[8096] = "オッホッホッホ！";
    text[8097] = "ルナーツバキを 手に入れた！";
    text[8098] = "ナイトフロックスを 手に入れた！";
    text[8099] = "ハーモニアサンゴを 手に入れた！";
    text[3309] = "やあ ベラ！";
    text[3310] = "ラックスコンボ 使っているかい？";
    text[3311] = "おお！ どうやら ラックスコンボを 20回 使ったようだね！";
    text[3312] = "いやあ 大したもんだ！  なら 新しいラックスコンボの レシピを あげよう！";
    text[3313] = "シールドの数が 多いほど ホロドレインの 威力は 上がるんだ！";
    text[3314] = "また キミの レベルが 高いほど ダメージも 上がるよ";
    text[3315] = "20回以上 ラックスコンボを 使ったら";
    text[3316] = "ボクが 開発した 新しいレシピを あげるよ";
    text[3317] = "ちなみに 今までに 使った ラックスコンボの 回数は";
    text[3318] = "リファレンスの 記録メニューで 確認できるからね！";
    text[3431] = "エヘヘ  今日は マークを いっぱい 倒したわ！  Sランクの 新記録よ！";
    text[3432] = "いくつになったの？";
    text[3433] = "今のところ 9回ね！";
    text[3434] = "へぇ やるじゃない！";
    text[3435] = "あら... なんだか あなたの心に 火を つけてしまった みたいね ベラ！";
    text[3436] = "まあ あなたに この記録を 超えられるとは 思えないけど Sランクを 10回以上 記録したら... ";
    text[3437] = "お祝いとして スキルブースターを あげるわ";
    text[3438] = "いいわよ その挑戦 受けてあげる";
    text[3439] = "ちゃんと Sランクを 10回 取ったことを 証明しないと ダメだからね";
    text[3440] = "それについては リファレンスの 記録メニューで チェックすることが できるわ！";
    text[3441] = "あら どうやら ワタシの 記録を 破ったようね...";
    text[3443] = "何とかね... あなたって レイン並に 手強い人だわ";
    text[3444] = "まあね... でも ライバルが いた方が 張り合いが あるって もんでしょ！";
    text[3445] = "あと ワタシ レインとは トレーニング仲間なのよ";
    text[3446] = "あの子 いつも 「ベラを ボコボコにしたい」って 息巻いてるわ";
    text[3447] = "ワタシも いつか レインや あなたと 同じレベルに なれると いいんだけどね！";
    text[3448] = "どうかしらねえ...";
    text[3442] = "まあ 今に 見てなさい\nあなたの Sランク記録 すぐに破って みせるんだから！";
    text[3451] = "それじゃあ これが 約束の スキルブースターよ";
    text[3232] = "どうやら 誰かが チーズケーキバーを 食べずに 行っちゃったみたいね";
    text[3233] = "うう... こんな暴挙は 許されないわ！！";
    text[3234] = "でもね 大丈夫よ チーズケーキバーちゃん！";
    text[3235] = "あなたが これ以上 悲しい 思いを しないように してあげるから！";
    text[3236] = "ええ！？";
    text[3237] = "また チーズケーキバーが 捨てられてるわ！";
    text[3238] = "きっと 自販機から 買った人が";
    text[3239] = "落としたんでしょうね";
    text[3240] = "ウーン...";
    text[3241] = "他の カフェを 調べてみましょう";
    text[3242] = "これ ひょっとして わざと やってるわけ！？";
    text[3243] = "犯人は チーズケーキバーで あなたを 釣ろうと してるのかもね";
    text[3244] = "なるほどね なら...";
    text[3245] = "...釣られちゃうわ！";
    text[3246] = "もっともっと 欲しい～！";
    text[3247] = "ねえ チーズケーキバーの 下に メモが 貼ってあるわ！";
    text[3248] = "「ティコ」ですって";
    text[3249] = "なら 今度 ティコの カフェに行く時 店内を 調べてみましょう！";
    text[3250] = "オッケ～イ！  チーズケーキ探偵 アシスタント・ロボのテトラが この難事件を 解決するんだから！";
    text[8101] = "ねえ チーズケーキバーの下に メモが 貼ってあるわ！";
    text[8102] = "「うれしいわ！\nあなたこそ カンペキな 候補よ！";
    text[8103] = "カフェ・コペルニクスで 待ってるから 会いに来てね」";
    text[8105] = "どうやら ついに この事件の 黒幕と 向き合うことに なりそうね！";
    text[8106] = "そうね！\nじゃあ 行きましょう！";
    text[8107] = "あの～ すみません... いろんなカフェに チーズケーキバーを 置いていったのは あなたかしら？";
    text[8108] = "ええ そうよ\n名前は メルスキ よろしくね！";
    text[8109] = "やっと会えて うれしいわ！";
    text[8110] = "どうして こんな 妙なことを したのか フシギに 思ってるかも しれないけど...";
    text[8111] = "それはね 優秀な 目利きが 必要だったからなのよ";
    text[8112] = "...そう チーズケーキバーの すべてを 知り尽くした 最高の 目利きがね";
    text[8130] = "そういうことなら この世に ワタシ以上の 適任者は いないわね！";
    text[8131] = "味見してほしいものが あるなら 今すぐにでも 言って！";
    text[8113] = "なら 集めた チーズケーキバーを 1本 ここで 試食してみてくれる？";
    text[8114] = "実はね あれ 全部 ワタシが 焼いたものよ";
    text[8115] = "アア～ン！\nとっても おいしいわ メルスキ！";
    text[8116] = "普通の チーズケーキバーより もっとイケてるわよ！";
    text[8117] = "何か ヒミツの 材料でも 使っているの？";
    text[8118] = "気に入ってくれたなら うれしいわ！";
    text[8119] = "このレシピは 長らく 研究していた とっておきよ！";
    text[8120] = "ワタシの夢は いつの日か ベジタリアン向けの パン屋さんを オープンすることなの";
    text[8121] = "まあ チーズケーキバー評論家の ワタシの 意見としては";
    text[8122] = "今 食べたやつが 人生で 最高の 1本だったわ！";
    text[8123] = "あなたが 店を開いたら... きっと ワタシが 最初の お客さんに なるんだからね！";
    text[8124] = "ありがとう！\nそう言ってくれると うれしいわ！";
    text[8125] = "じゃあ チーズケーキバー オタクの 友情の証として これを 受け取って";
    text[8126] = "自分の作った 料理を 他の人が 食べてるのを 見るのが 一番 幸せな瞬間よ";
    text[8127] = "今は 何か 新しい レシピを 開発しているの？";
    text[8128] = "ここの ところは おいしい ビーガン チョコレートケーキ作りを 研究しているわ";
    text[8129] = "わあ！\nできあがったら ぜひとも 食べさせてね！";
    text[8142] = "ああ 恥ずかしい... 今は 部屋が グチャグチャなのよ...";
    text[8143] = "ああ 別に 気にしないで メロディー！";
    text[8144] = "ちょっと あなたと お話しようと 思って 立ち寄っただけよ エヘヘ";
    text[8145] = "あれ 何だか 前よりも ぬいぐるみが 増えてる 気がするけど...？";
    text[8146] = "ええ！  また コレクションが 増えたからね";
    text[8147] = "ここにあるもの 全部...";
    text[8148] = "かわいくて モフモフね！";
    text[8149] = "レアな ぬいぐるみと フィギュアを 集めるのが ワタシの シュミなの エヘヘ";
    text[8150] = "ああ レアな ぬいぐるみと 言えば...";
    text[8151] = "今ね めちゃくちゃ カワイイけど すんごく高い ぬいぐるみが あって お金を 貯めてるんだけど...";
    text[8152] = "実は 発売まで 3日前なのよ...";
    text[8153] = "問題は... このままじゃ 間に合わないの";
    text[8154] = "間違いなく 発売されたら あっという間に 売り切れちゃうからね！";
    text[8155] = "そうしたら もう 手に入れる チャンスは ないわ...";
    text[8156] = "だからね ちょっと お願いが あるんだけど...";
    text[8157] = "新発売の ぬいぐるみを 買う 資金のために";
    text[8158] = "今 部屋にある ぬいぐるみを いくつか 買ってくれない？";
    text[8159] = "ああ メロディー\nそんなの お安いご用よ！";
    text[8160] = "ワタシも 最近 ぬいぐるみを 集めてるし";
    text[8161] = "まあ うれしいわ！";
    text[8162] = "これが 売りたい ぬいぐるみよ...  あなたが 全部 買ってくれたら";
    text[8163] = "ワタシは 晴れて レアな ぬいぐるみを 手に入れることが できるわ！";
    text[8164] = "わあ～！  全部 買ってくれたわね！\n本当に ありがとう ベラ！";
    text[8165] = "大切な お友達の ためだもの ヘヘヘ...";
    text[8166] = "じゃあ お礼に これも あげるわ！";
    text[8167] = "ところで メロディー 今度 買いたい ぬいぐるみっていうのは どんなやつなの？";
    text[8168] = "限定版の すごく レアなやつよ...";
    text[8169] = "高さ3メートル イチゴの 匂い付き ミルキーちゃんの ぬいぐるみ！";
    text[8170] = "3メートル... でっっか！！";
    text[8171] = "しかも イチゴミルクセーキ メーカーが 搭載されているの！";
    text[8172] = "だ・か・ら... ゼッタイに 買わなくちゃ いけないのよ！！";
    text[8391] = "ああ キミ...";
    text[8392] = "あら どうしたの？";
    text[8179] = "アヒルは 好きかい？";
    text[8180] = "だといいんだけど...";
    text[8181] = "ええ 好きよ\nだって アヒルちゃん カワイイ じゃない！";
    text[8182] = "だろう！？";
    text[8183] = "アヒルは かわいくて よく鳴いて 1羽 1羽 個性が あるんだ！";
    text[8184] = "本当に.@P.@P.@P";
    text[8185] = "ああ ごめん... 動物の 話になると つい 興奮しちゃって...";
    text[8186] = "...アヒルの 話だと 特にね";
    text[8393] = "ええっと... それは ともかく ボクの名前は ローギだ";
    text[8178] = "アンドロイドであり ケプラー牧場の 鳥類保護区域の 責任者でも あるんだ！";
    text[8187] = "それで ちょっと頼みたいことが あるんだけど いいかな？";
    text[8188] = "その... アヒルの ことなんだけど...";
    text[8206] = "ええ？  何が あったわけ？";
    text[8190] = "あの日 ボクは テラが 滅ぶ前に そこにあったという 豊かな 自然について";
    text[8191] = "書かれた本を 読んでいたんだ";
    text[8189] = "おかげで ルナーの 自然に対する 尊敬の 気持ちが 増したよ";
    text[8192] = "だから 受け持ちの 区域にいる 動物たちを";
    text[8193] = "できるだけ 安全に 幸せに 健康に してあげると 誓ったんだ";
    text[8194] = "ただ そう言った手前 恥ずかしいんだけど.@P.@P.@P";
    text[8205] = "アヒルが いなくなっちゃったんだ！";
    text[8195] = "ええ！？  いなくなったって！？";
    text[8196] = "ボクは 普段 3羽の やんちゃな アヒルを 世話してるんだけど";
    text[8197] = "すぐ迷子になる 悪いクセが あるんだ";
    text[8198] = "まあ それを 責める気は ないけどね...";
    text[8199] = "アヒルは とても 好奇心が 強くて 冒険が 大好きなんだから！";
    text[8200] = "それでも いつもは お家に 帰ってくるから 好きに させてるんだけど";
    text[8201] = "今回だけは... 帰ってこないんだ...";
    text[8202] = "それで 心配に なってきて... 無事なら いいんだけど...";
    text[8203] = "大丈夫 心配しないで！  そういうことなら ワタシが 探してきてあげる！";
    text[8394] = "それに 生のアヒルが どれくらい カワイイのか 一度見てみたいしね！";
    text[8204] = "おお ありがとう！";
    text[8207] = "それで アヒルが どこにいるのか 見当は つかないかしら？";
    text[8208] = "迷子になったのは 全部で 3羽だけど";
    text[8209] = "1羽は 寒い所が キライで...";
    text[8210] = "いつも 緑のマフラーを 首に巻いてるよ！";
    text[8211] = "だから どこか 暖かい場所に いるんじゃないかな？";
    text[8212] = "もう1羽は 逆に 涼しい場所 ビルの 屋上とかが 好きなんだ...";
    text[8213] = "だから 大きな街に いると思うよ";
    text[8214] = "それで 3羽目だけど...";
    text[8215] = "あの子は まれに見るほど 賢いアヒルでね...";
    text[8216] = "特に レーザーパズルを 解くのが 大好きなんだ";
    text[8217] = "わあ...";
    text[8218] = "まあ さっき 言ったように アヒルって すごく 個性があるからね！";
    text[8219] = "ヒントを ありがとう ローギ！";
    text[8225] = "大丈夫 あなたの アヒルちゃん すぐに 見つけて あげるからね！";
    text[8173] = "クワックワッ！";
    text[8174] = "ローギの やんちゃな アヒルを 見つけた！";
    text[8175] = "クワックワッ！  ローギが 心配してるわよ！  さあ お家に 帰りましょ！";
    text[8220] = "ああ 3羽のアヒルが 無事に 戻ってきて 本当に うれしいよ！";
    text[8221] = "助けてくれて どうも ありがとう！";
    text[8222] = "そうだな キミに 何か お礼を しなくっちゃ...";
    text[8223] = "ふむ...";
    text[8224] = "なら これを 受け取ってくれ！";
    text[8176] = "200アストロテックと ガムドロップを 手に入れた！";
    text[8226] = "ボクの名前 「ローギ」の由来 わかるかい？";
    text[8227] = "これが 妙なんだけど...";
    text[8228] = "「ルナー・オブザーバー オーガニズム」の 頭文字から 取って 「LO-Ogi」 なんだ";
    text[8229] = "まあ 最後の「i」が 何から 来てるのかは 忘れちゃったけど";
    text[8230] = "...と それは ともかくとして";
    text[8231] = "アヒルたちを 助けてくれて 本当に ありがとう！";
    text[8232] = "ああ ザラ 調子はどう？";
    text[8233] = "今は トレーニングを 休んで 瞑想してるところよ";
    text[8234] = "心と体の 両方を ケアすることは とても 大切だからね";
    text[8235] = "今 取り組んでる 新しい ラックスコンボとか テクニックとかある？";
    text[8236] = "何か ヒントが もらえたら いいなと 思うんだけど";
    text[8237] = "そうねえ...";
    text[8238] = "ワタシも 同じことを 聞きたいわ";
    text[8239] = "あなたから 何か ヒントが もらえたら うれしいんだけど...";
    text[8240] = "ええ？  ワタシから？";
    text[8241] = "何で そんな顔するの？\nあなたは 才能ある 戦士だし... ちょっと 憧れてるくらいよ";
    text[8242] = "きっと ワタシが 知らない ラックスコンボも 知っているはずだわ  そこでね...";
    text[8243] = "あなたに 提案が あるの";
    text[8244] = "20以上の ラックスコンボを マスターして それを 見せてくれたら...";
    text[8245] = "ワタシも あなたに 新しいラックスコンボレシピを あげるわ";
    text[8246] = "あと... レビストーンの 使い方も 教えてあげる";
    text[8247] = "わかったわ！  じゃあ 取引成立ね！";
    text[8248] = "ウーン...";
    text[8249] = "あら！？";
    text[8250] = "ふむふむ...";
    text[8251] = "あなた なかなか ユニークな 技を 持っているのね...";
    text[8252] = "へえ... なるほど...";
    text[8253] = "今度 マネしてみようかしら...";
    text[8254] = "勉強になるわ...";
    text[8255] = "あなたの おかげで 新しい コンボの インスピレーションが 浮かんだわ！";
    text[8256] = "それじゃ ベラ... 約束通り これが 新しい ラックスコンボの レシピよ";
    text[8258] = "これからも お互いに 勉強しましょうね";
    text[8259] = "もちろんよ！";
    text[3713] = "わあ カッコイイ ロボットだね！";
    text[3714] = "お名前は？";
    text[3715] = "テトラよ！";
    text[3716] = "はじめまして テトラ！";
    text[8263] = "ボクの名前は ジェイソン！\nブランク・ロボティクスの 店主さ";
    text[8295] = "テトラ... キミを 一目見た瞬間 プロの 仕事だって わかったよ";
    text[8296] = "その合金ボディ... 滑らかなパーツ... ただただ 見事だ！";
    text[8264] = "ええっと... キミが 搭載している 武器を 見てみても いいかい？";
    text[8265] = "ええ もちろん！";
    text[8266] = "いやあ すごい...！";
    text[8267] = "ところで キミ そのバスター砲を 強化したいと 思ったことは ないかい？";
    text[8268] = "まだ キミの 回路には アップグレードの 余地が ありそうだ";
    text[3721] = "わあ～ それは すごいわ！";
    text[3722] = "テトラバスターの アップグレード = もっとすごい アシスタント・ロボって ことよね ヘヘヘ！";
    text[8269] = "ベラ どう思う？";
    text[8270] = "それは あなた次第よ テトラ";
    text[8271] = "自分のことは 自分で決めなさい！";
    text[8272] = "なら... アップグレードするわ！";
    text[8273] = "もっと 強くなりたいもの！";
    text[8274] = "よくぞ言った！  なら早速 パーツの 在庫があるか 確認させておくれ...";
    text[8275] = "ふむふむ なるほど...";
    text[8276] = "ちょっと 悪いニュースがある... コアギアが 足りないんだ";
    text[8277] = "それって アップグレードに ゼッタイ 必要な ものなの？";
    text[8278] = "もちろんさ！  コアギアが あれば テトラバスターの 威力を 2倍...";
    text[8279] = "いや... 4倍に できるはずだ！";
    text[8280] = "ねえ ベラ 急いで コアギアを 見つけましょ...";
    text[8281] = "ワタシ... ホントに アップグレードしたいの！";
    text[8282] = "そうだなあ 今回は キミたちに コアギアを 入手してもらう 手間を 考慮して...";
    text[8283] = "いくらか 値引きさせてもらうよ";
    text[8284] = "テトラバスターの 強化 お値段たったの 200アストロテックだ！";
    text[8285] = "わかったわ 取引成立よ";
    text[8286] = "それで コアギアって どこにあるの？";
    text[8287] = "ふむ... それは ちょっと 難しい 質問だね... そもそも すごく 珍しい 代物だからさ";
    text[8288] = "例えば 予備の マシンや パーツが ありそうな場所を 知ってるかい？";
    text[8289] = "そうねえ";
    text[8290] = "あっ！";
    text[8291] = "レゴリシアの 倉庫とか どうかしら？";
    text[8292] = "ああ よく気付いたわね テトラ！";
    text[8293] = "それじゃあ ジェイソン コアギアを 手に入れたら また戻ってくるわね！";
    text[8294] = "わかった！  じゃあ 楽しみに 待ってるよ！";
    text[8297] = "コアギアを 手に入れた！";
    text[8298] = "コアギアを 持ってきたわよ～！  エヘヘ...";
    text[8299] = "よくやった！  あと お代も 用意してるかな？";
    text[8300] = "いくらだっけ？";
    text[8301] = "ボクの ロボットエンジニアサービスに 200アストロテックさ！";
    text[8302] = "ああ それなら 大丈夫だわ！";
    text[8303] = "ようし それじゃあ アップグレードといこう！";
    text[8304] = "あら 足りないわ...";
    text[8305] = "ああ なら 急がなくてもいい ここで待つよ！";
    text[8306] = "ボクの方も やるべき仕事が いっぱい あるからさ！  ハハハ！";
    text[8307] = "アップグレード完了！";
    text[8308] = "これで テトラバーストの 威力が 200に なったよ！";
    text[8309] = "すごい！！  その言葉だけで 何だか 強くなった 気がするわ！";
    text[8310] = "それは 良かった！";
    text[8311] = "ボクも 楽しかったよ... それじゃあ これからの 冒険も がんばっておくれ テトラ！";
    text[8312] = "今のところ 店の売り上げは イマイチだけど... 心配は してないよ！";
    text[8313] = "ロボットが 日に日に増えてる 世の中だ";
    text[8314] = "ロボットパーツの 需要だって どんどん上がってくよ！";
    text[8315] = "...そして いつか この店は ルナーで 一番の ロボットショップに なるのさ！";
    text[8316] = "これから レゴリシアの 倉庫に コアギアを 探しに 行くんだろう？";
    text[8317] = "ええ！  手に入れたら また 戻ってくるわ！";
    text[3726] = "ああ... のどが 乾いたよう...";
    text[3727] = "あの... ちょっと お願いしても いいですか？";
    text[3728] = "今 ものすごく のどが 乾いてるんですが 持ち場を 離れられないんです...";
    text[3729] = "なので マスター・エナGドリンクを 買ってきて もらえませんか？";
    text[3730] = "ランクの高い エナGドリンクほど 元気になれます！";
    text[3731] = "でも マスター・エナGドリンクが なければ スーパーや ハイパーでも かまいません";
    text[3732] = "お願いです... 本当に ヤバイんです... なのに シフトは あと 6時間もあって...";
    text[3733] = "ああ...  さわやかで クールで シュワシュワで のどがうるおう！";
    text[3734] = "やっぱり エナGドリンクは 最高だ！";
    text[3735] = "どの エナGドリンクを くれるんですか？";
    text[3736] = "スーパー・エナGドリンク";
    text[3737] = "ハイパー・エナGドリンク";
    text[3738] = "マスター・エナGドリンク";
    text[3739] = "ええっと どうやら ボクが 欲しいタイプの エナGドリンクを 持ってない ようですね...";
    text[3740] = "上位の エナGドリンクを 手に入れたら ここに 戻ってきて ください";
    text[3741] = "ああ！  ありがとうございます！！";
    text[3742] = "なら 気持ちばかりの お礼を させてください";
    text[3743] = "次のうち どれが 欲しいですか？";
    text[3744] = "100バイトと 50アストロテック";
    text[3745] = "50スキルポイント";
    text[3746] = "2500バイトと 100アストロテック";
    text[3747] = "100スキルポイント";
    text[3748] = "5000バイトと 150アストロテック";
    text[3749] = "150スキルポイントと 1ソウルセーバー";
    text[3750] = "選んだ報酬を 受け取った！";
    text[3688] = "あら 兵士さん！  ワタシは ルナーフォースで バトルコーチを している者よ";
    text[3689] = "ワタシはね 兵士を さらに 強くしてあげるのが 大好きなの！";
    text[3690] = "バトルで Sランクを 20回 獲得したら";
    text[3691] = "アクアグレネードの ニューロンリンクを あげるわ！";
    text[3692] = "何回 Sランクを ゲットしたかは リファレンスの 記録メニューから チェックできるからね！";
    text[3694] = "あら どうやら Sランクを 20回 取ったみたいね！";
    text[3695] = "これからも その調子で がんばってね！  さあ これが 約束の ニューロンリンクよ！";
    text[3696] = "最高ランクの バトルコーチが あなたの 偉業を 耳に入れたそうよ";
    text[3697] = "彼は どうやら あなたに 会いたがってるみたい！";
    text[3698] = "次は Sランクを いくつ取れって？";
    text[3699] = "あの人なら 多分 50回以上を 求めてくるんじゃないかしら？";
    text[3700] = "のんびりしてる ヒマはないわよ！  この勢いで ルナー最高の 戦士に なっちゃいなさい！";
    text[3770] = "やあ！";
    text[3771] = "ボクは クイズ神の ミスター・インフェイマスだ！";
    text[3772] = "今は ルナー中を 旅して 自分を 上回る 頭脳の 持ち主を 探している";
    text[3773] = "ボクの クイズに すべて 正解したら すごい ごほうびを あげよう！";
    text[3774] = "さて このクイズ神に 挑戦するかな？";
    text[3775] = "ボクの 負けだ... キミは 本当に すごい 頭脳の 持ち主の ようだね";
    text[3776] = "ワームホールの 向こう側にある フシギな 世界の 名前は？";
    text[3777] = "ウェーブワールド";
    text[3778] = "ファントムスペース";
    text[3779] = "アナザーディメンション";
    text[3780] = "残念！  また次回 がんばってくれ！";
    text[3781] = "レゴリシアの セクターの 番号は？";
    text[3782] = "セクター8";
    text[3783] = "セクター14";
    text[3784] = "セクター16";
    text[3785] = "サポートスキルを レベル4に するのに 必要な スキルポイントは？";
    text[3786] = "150スキルポイント";
    text[3787] = "125スキルポイント";
    text[3788] = "75スキルポイント";
    text[3789] = "マーク 「リップタイド」の HPは？";
    text[3790] = "300";
    text[3791] = "225";
    text[3792] = "250";
    text[3793] = "それでは 最後の 1問だ\nボクは 誰だい？";
    text[3794] = "キモい人";
    text[3795] = "クイズ神 ミスター・インフェイマス！";
    text[3796] = "クイズ王 ミスター・フェイマス！";
    text[3797] = "では これを キミに あげよう！";
    text[3799] = "素晴らしい！  ボクの クイズに 全問正解するとは！";
    text[8318] = "あらあら よく来たわね 天才ちゃん！";
    text[8319] = "ガッハッハッハ！";
    text[8320] = "その顔... 目の中の 炎...";
    text[8321] = "まあ 今日は ちょっとばかり 時間があるし...";
    text[8322] = "あなたの挑戦 受けてあげるわ";
    text[8323] = "あらあ よくわかってるじゃない ベラ  なら...";
    text[8324] = "カフェ・レゴリシアに 来なさい！";
    text[8325] = "そして 覚悟しなさい...";
    text[8326] = "ボッコボコの ギッタギタに してあげるからね！";
    text[8327] = "今日という 今日は 負けないわよ！  ガッハッハッハ！";
    text[8328] = "悪いけど 勝つのは いつだって ワタシよ！";
    text[8329] = "それじゃあ また後で 会いましょう レイン！";
    text[8330] = "トレーニングで 体が限界まで 疲れた時は...";
    text[8331] = "やるべきことは 1つだけ...";
    text[8332] = "それは ズバリ テレビゲームよ！  ガッハッハッハ！";
    text[8333] = "さて 今回は ちょっと バトルを 面白くするわよ...";
    text[8334] = "アンタが 勝ったら ブレードガントレットの 使い方を 教えてあげる";
    text[8335] = "つまり 新しい アクティブスキルを ゲットできるってわけ！";
    text[8336] = "そして ワタシが 勝ったら...";
    text[8337] = "待って！  別に 言わなくてもいいわよ";
    text[8338] = "だって どうせ 勝つのは ワタシなんだから ヘッヘ...";
    text[8339] = "ああ～ なるほどねえ...";
    text[8340] = "そうやって ワタシを イラつかせようってわけ！";
    text[8341] = "なら...";
    text[8342] = "上等よ！！";
    text[8343] = "さあ 覚悟しなさい！！\nガッハッハッハ！！";
    text[8344] = "うう...";
    text[8345] = "どうやら 今回は アンタの 勝ちね...";
    text[8346] = "でも なかなか 楽しかったわ！";
    text[8347] = "アンタは やっぱり 最高の ライバルよ！";
    text[8348] = "じゃあ 約束通り これを あげるわ...";
    text[8349] = "さてと... 今日は もう 家に帰って 休むわ";
    text[8350] = "それじゃ またね 天才ちゃん！";
    text[4067] = "おお...";
    text[4068] = "おぬしの名は 今 ルナーフォースで 大いに 話題に なっておるよ";
    text[4069] = "実際 一目 見ただけで 一流の戦士だと わかる";
    text[4070] = "...しかし このワシの 心を 揺り動かすことは できるかのう？";
    text[4071] = "おお すまない 自己紹介が まだじゃったな";
    text[4072] = "ワシの名は ポンド...";
    text[4073] = "ジェームス・ポンドじゃ";
    text[4074] = "ルナーフォースで 最高位の バトルコーチじゃ";
    text[4075] = "そして 何人もの 臆病な新兵を 強靭な戦士に 育て上げてきた";
    text[4076] = "リファレンスの Sランクの 数字が 50に 達したら また ここに 来るがいい";
    text[4077] = "それを クリアできたら 素晴らしい 報酬で 大いに お祝いしようではないか";
    text[4078] = "今まで ワシを 驚かせた者は ほんの 数人しかおらん...";
    text[4079] = "おぬしは ルナーで 最高の戦士の 称号を 手にできるかな？";
    text[4080] = "うむ どうやら Sランクを 50回 取った ようじゃな";
    text[4081] = "だが... それだけで 感心するような ワシではない";
    text[4082] = "あのねえ メッチャ 時間かけて アンタの 要求を かなえたのよ  何をしたら 満足するわけ！？";
    text[4083] = "まだ課題は 半分しか 終わっとらん";
    text[4084] = "Sランクを 50回 取ったことは おぬしの 規律と 強さを 証明していると いえよう";
    text[4085] = "だが 真の最強戦士を 名乗るならば このワシと 対決し 勝たねば ならんのじゃ！";
    text[4086] = "下水道エリアに 来るのじゃ\nそこで バトルロボットを 用意して 待っておるからな";
    text[4087] = "なんで バトルロボット なんかに 乗るわけ？";
    text[4088] = "このじじいは もう とうに 全盛期を 過ぎておる ";
    text[4089] = "戦の 経験や 知恵なら 誰にも 負けぬが それでも 老いには 勝てんのじゃ";
    text[4090] = "そして バトルロボットは そんな ワシの 弱点を 完全に カバーしてくれる";
    text[4091] = "バトルロボット だろうが 何だろうが 勝つのは ワタシよ！";
    text[4092] = "威勢が良いのう！\nならば 後ほど 下水道エリアで いざ会おうぞ！";
    text[4093] = "ようし 来たか！  ならば 覚悟するがいい！  やるからには 容赦は せんぞ！";
    text[4094] = "むう 見事じゃ！";
    text[4095] = "これほどまでに 血が 騒いだのは 久しぶり だったぞい！  ハッハッハ！";
    text[4096] = "よろしい！  では これで 正式に ワシの 課題を クリアしたものと 認めよう";
    text[4098] = "コスト・アップグレードチップを 装備すると";
    text[4099] = "すべての アクティブスキルの SPコストが 5低下するのじゃ\nでは...";
    text[4100] = "今後とも より一層 修行に 励むのじゃぞ！";
    text[4882] = "やあ ボクの 名前は フォーチュノ";
    text[4883] = "シリカの トレジャーハンターギルドの リーダーだ";
    text[4884] = "ところで キミは トレジャーハンターに なりたいのかな？";
    text[4885] = "ええ！  トレジャーハントって 楽しそうじゃない！  それで 何をしたら いいの？";
    text[4886] = "そうだな 順を追って 説明していこう";
    text[4887] = "まず トレジャーハンターに 必要なのは 鋭い観察力だ";
    text[4888] = "辺りを 歩いて シリカコロニーに いくつの 火が 灯っているかを 数えてごらん";
    text[4889] = "それが できたら また ここに 戻っておいで";
    text[4890] = "それで シリカコロニーには いくつの火が あるのかな？";
    text[4891] = "ウーン 違うな\nどうやら キミの 観察力は まだまだの ようだ";
    text[4892] = "そうだ！  これで 最初の テストは 合格だ！";
    text[4893] = "晴れて キミを 「新人トレジャーハンター」として 認めよう！";
    text[4894] = "次の 課題についてだが... それは また今度にしよう";
    text[4895] = "では トレジャーハンターギルド 入会おめでとう！  これは ボクからの 心ばかりの プレゼントだ";
    text[4896] = "我々 トレジャーハンターは レアで 貴重な アイテムを 集めるのが 大好きだ";
    text[4897] = "でも それと 同じくらい 探検のスリルが 好きなのさ！";
    text[4898] = "キミも 特定のエリアを よく調べると レアなアイテムや";
    text[4899] = "古代の遺物を 発見できるかも しれないよ！";
    text[8007] = "ヒミツのカードキーで ドアが開いた！";
    text[8351] = "フォーチュノさん オレたちは 正式に トレジャーハンターギルドの メンバーに なったんだ...";
    text[8352] = "だから 珍しい神話や 伝説の話を 教えてくれないか？";
    text[8353] = "ん？  キミたちは まだ 新人レベルに 過ぎないのだがな...";
    text[8354] = "次の チャレンジを 受ける覚悟は 本当に あるのかい？";
    text[8355] = "もちろんさ！";
    text[8356] = "オレは ギルドに 入る前から トレジャーハントを 何年も してきたんだ！";
    text[8357] = "だから どんな 難題だって 大歓迎だよ！";
    text[8358] = "よろしい そこまで 言うのなら...";
    text[8359] = "考古学者は 最近になって 2つの 伝説の剣の 存在を示す";
    text[8360] = "古代の 石板を 発見した...";
    text[8361] = "その剣は レリックソードと エクスカリバーだ";
    text[8362] = "レリックソードに ついては まだ ほとんど 何も わかっていないが...";
    text[8363] = "エクスカリバーは ある程度のことが わかっている";
    text[8364] = "記録によると その剣は コペルニクスの 南のどこかに あるらしい";
    text[8365] = "また エクスカリバーを 使うには";
    text[8366] = "2つの 古代の キーストーンが いるのだと言う...";
    text[8367] = "まあ こちらから 言える情報は これくらい なんだが...";
    text[8368] = "エクスカリバーを 見つけることが できたら ワタシに 報告してくれ！";
    text[8369] = "ギルドは ルナーで 最も貴重な 宝物を 発見した 冒険者に";
    text[8370] = "多額の 報酬を 出している！";
    text[8371] = "キミの成功を 心から 祈ろう！";
    text[8372] = "ありがとう フォーチュノさん";
    text[8373] = "それで ニックル どこから 始めるの？";
    text[8374] = "まずは 訪れたことのない アドベンチャーエリアを 探してみよう";
    text[8375] = "まずは 2つの キーストーンを 探し出して それから エクスカリバーだな！";
    text[8376] = "うおおおお！\n言ってる そばから 燃えてきたぜ！";
    text[8377] = "(なんか この人 トレジャーハントの 話になると 人が変わると 思わない？)";
    text[8378] = "(ええ いつもは 気難しいのにねえ...)";
    text[8379] = "ん？  お前ら 何ヒソヒソ 言ってんだ？";
    text[8380] = "そうと決まれば 伝説の剣とやらを 探しに 行こうじゃねえか！";
    text[8381] = "おお 本当に 見つけたのだな！";
    text[8382] = "これが あの 伝説の エクスカリバー... 驚きすぎて 言葉さえ 出ないぞ！  ";
    text[8383] = "どうやら 今まで キミたちのことを 甘く 見ていたようだな";
    text[8384] = "もはや 新人などと 呼ぶべきではない...";
    text[8385] = "今回の 手柄を たたえ ギルド 最高レベルの トレジャーハンターと 認めようじゃ ないか！";
    text[8386] = "ヘヘッ そいつはどうも";
    text[8387] = "あと 報酬として これを 受け取っておくれ！";
    text[8388] = "10,000バイトを 手に入れた！";
    text[8389] = "今後 何か 未発見の お宝の 情報を 手に入れたら";
    text[8390] = "キミたちにも ゼッタイに 知らせよう！";
    text[8400] = "古代の キーストーンを 見つけた！";
    text[8401] = "ようし あと1つだ！";
    text[8402] = "おお キーストーンが 光ってるぞ！";
    text[8403] = "しかも 古代文字 みたいなのが 浮かび上がってきた...";
    text[8404] = "テトラ 読めるか？";
    text[8405] = "もちろんよ！  えっとね...";
    text[8406] = "2つの キーストーンが 合わさる時...";
    text[8407] = "幻は 消え去る...";
    text[8408] = "なるほど... 「幻は 消え去る」か...";
    text[8409] = "それはつまり エクスカリバーの ありかが 明かされるって ことだな！";
    text[8410] = "フォーチュノさんは コペルニクスの 南とか 言ってたわよね！";
    text[8411] = "じゃあ 早速 行ってみましょう！";
    text[8412] = "やったぜ！  ついに伝説の エクスカリバーを ゲットしたぞ！";
    text[8413] = "あと@P.@P.@P.";
    text[8414] = "この瞬間を 仲間と 分かち合えて うれしいよ";
    text[8415] = "ワタシもよ ニックル";
    text[8416] = "やったわね！  3人組の トレジャーハント 大成功よ！";
    text[8417] = "おうよ！  じゃあ すぐに シリカに 戻って フォーチュノに 報告しようぜ！";
    text[8611] = "パイロワームの 群れが ルナーフォースを 攻撃しているわ";
    text[8612] = "しかも このマークは とても 手強い上に 頭もいいの";
    text[8613] = "おそらく 次は 軍事基地を 狙ってくるはずよ";
    text[8614] = "あなたの ミッションは パイロワームを 見つけ出して 倒すこと！";
    text[8615] = "まずは 荒野ゾーン1に 向かって ダミアンから 詳しい話を 聞いてね";
    text[8623] = "パイロワームの ミッションを 知って 駆けつけてきたわ！";
    text[8624] = "状況は どうなってるの？";
    text[8625] = "パイロワームは 次の 集団攻撃を もくろんでいるようだ";
    text[8626] = "今は 荒野ゾーン2で やつらを 必死に 食い止めているところだ！";
    text[8627] = "わかった それじゃあ 今すぐ 現場に 向かうわ！";
    text[8628] = "なるほど...";
    text[8629] = "まさか サロス将軍が そんな 裏切り者 だったとはな...";
    text[8630] = "実は 私の友人も 数週間前から 行方知れずなんだ...";
    text[8631] = "おそらくは サロスによって マークに 変えられたのだろう...";
    text[8622] = "いつの日か マークを 人間に 戻せる日が 来ると いいのだがな...";
    text[8632] = "そのためなら これからも 喜んで キミたちに 協力するつもりだ";
    text[8633] = "ありがとう あなたみたいな人が 味方にいると すごく 助かるわ！";
    text[8634] = "実のところ すぐにでも できることは あるぜ...";
    text[8635] = "それは できる限り 多くの兵士に サロスの真実を 伝えることだ";
    text[8636] = "今後 回収した 反物質コアは 安全に 厳重に 保管しないと いけないからな！";
    text[8637] = "そうだな！  きっと そうしよう！";
    text[8638] = "あと これを 受け取っておくれ！";
    text[8639] = "救援に 来たわ！  ここは ワタシたちに 任せて！";
    text[8640] = "さて... この人たちと コミュニケーションを 取ってみるわよ...";
    text[8641] = "あなたたち よく聞きなさい！  ワタシは 敵じゃないわ！";
    text[8643] = "お前... 話が 通じるのか...？";
    text[8644] = "ええ！";
    text[8645] = "ワタシは このソウルセンスの 力で あなたたちの 声が 聞けるの！";
    text[8646] = "ワタシの 家族は... サロスによって マークにされた...";
    text[8647] = "この恨み 必ずや 晴らしてくれる...";
    text[8648] = "我々が 受けた 痛みと 苦しみを あの男にも...";
    text[8649] = "お前たちは... 信用できない...";
    text[8650] = "ルナーフォースは... ルナーの市民を 守るためにあるはず...";
    text[8651] = "だが お前たちは もう その心を 忘れた！";
    text[8652] = "ダメ もう この人たち 聞いてくれないわ...";
    text[8653] = "サロスは おそらく こいつらに 高純度の マーク血清を 与えたんだろう...";
    text[8654] = "そして 体内の反物質が 恐怖と怒りの 感情を 倍加させている";
    text[8655] = "市民に 犠牲が出る前に 何としてでも 食い止めるんだ！";
    text[8656] = "そうね... それじゃあ 武器を 構えて！";
    text[8657] = "本当に ごめんなさい...";
    text[8658] = "この反物質コアは 大切に 保存しておくから...";
    text[8659] = "そして いつの日か あなたたち 家族が 人間の姿で 再会できるようにするわ";
    text[8660] = "行こう ベラ\nまずは ダミアンに このことを 報告しないと";
    text[8616] = "ある宇宙マフィアの 居場所を 突き止めたわ";
    text[8617] = "捕まえたら 組織のアジトを 聞き出す 大チャンスよ";
    text[8618] = "そして 今までの 情報から やつらは ここ数年 ルナーで 頻発している";
    text[8619] = "市民の 誘拐事件の 黒幕である 可能性が 高いと 思われるわ";
    text[8620] = "あなたの ミッションは 組織の アジトの 場所を 特定し";
    text[8621] = "そのボスを 逮捕することよ！";
    text[8661] = "さあ 手を上げなさい！  ルナーフォースの権限の下 あなたたちを 逮捕する！";
    text[8662] = "待ちな ベラ... ここは いっちょ オレに 任せてくれ";
    text[8663] = "おい 聞け！";
    text[8664] = "お前らが どんな犯罪を したか 知らねえが オレたちの 狙いは お前らじゃない";
    text[8665] = "お前らの リーダーだ";
    text[8666] = "残りの 一生を 牢屋で 過ごすのは イヤだろう？";
    text[8667] = "だから 取引を しようじゃないか";
    text[8668] = "ニックル！  正気なの？";
    text[8669] = "こいつら 犯罪者よ！";
    text[8670] = "わかってるさ";
    text[8671] = "さあ リーダーの 居場所を言え\nそうしたら お前らに 手出しはしない";
    text[8672] = "間違っても ワナなんかじゃないぜ";
    text[8673] = "アニキ どうしやす？";
    text[8674] = "うむ... オレには わかるぜ...";
    text[8675] = "こいつの 体から やべえ オーラが プンプン 出てるのがな";
    text[8676] = "お前は そのピンクちゃんとは 違って カタギの 人間じゃ なさそうだな";
    text[8677] = "言ってみろ お前も 犯罪者なんだろ？";
    text[8678] = "その通り";
    text[8679] = "かの悪名高い マークスレイヤーとは オレのことさ...";
    text[8680] = "ルナーフォースでは 賞金首リストの 最高額だったかな？";
    text[8681] = "このマスク... 間違いねえ やつだ";
    text[8682] = "バカな！  捕まって 牢屋に ブチ込まれたって 聞いたぜ！";
    text[8683] = "だとしたら どうやって 脱走したんだ！？";
    text[8684] = "隣りの ピンクちゃんに 逃がしてもらったのさ";
    text[8685] = "ああ もう だって しょうがないでしょ！";
    text[8686] = "で どうすんだ？  取引に 応じるのか？";
    text[8687] = "いいや 断る！";
    text[8688] = "仲間は 死んでも 売らないのが オレたち マフィアの 美学よ！";
    text[8689] = "まず どうして こんなに ダラダラと 話をしたのか 疑問に 思わなかったかい？";
    text[8690] = "そう ワナを張る 時間稼ぎさ！  ハッハッハ！";
    text[8691] = "ワナだと？";
    text[8692] = "お前が その くだらない取引を 持ちかけている間に";
    text[8693] = "この船の 自爆装置を 起動してやったのさ！";
    text[8694] = "ああ また やったのね...";
    text[8695] = "前にも あったのか？";
    text[8696] = "ええ 残念ながら";
    text[8697] = "この手の 連中は 人の話を 聞かないからね";
    text[8698] = "こうなったら もう 最後の 手段を 使うしか なさそうね！";
    text[8699] = "おお 暴力で 手っ取り早く 解決するのは オレの 専売特許だと 思ってたんだが";
    text[8700] = "お前も そうなのか？";
    text[8701] = "誘拐された 人たちを 救えるのは ワタシたち だけよ！";
    text[8702] = "でも 戦わなければ その手がかりは 得られないわ";
    text[8703] = "テトラ 残り時間は？";
    text[8704] = "あまりないわ！  こいつらを 5ターン以内に 倒さないと ジ・エンドよ！";
    text[8705] = "なるほどね じゃあ この宇宙マフィアどもを やっつけるわよ！";
    text[8706] = "...ふぅ 自爆装置も 無効化したわ！";
    text[8707] = "くそうっ... こいつら 強すぎる...";
    text[8708] = "素直に 取引に 応じれば 良かったものを";
    text[8709] = "負けはしたが... どのみち 口を割るつもりは ないぜ";
    text[8710] = "そう なら... テトラ この船に 何か 手がかりがないか スキャンしてみて";
    text[8711] = "わかったわ スキャン...！！";
    text[8712] = "ああ こいつの ポケットに 何か入ってるわ！";
    text[8713] = "この鉱山の カードキーを 使えば シリカ鉱山の レーザーゲートを 開けられるはずよ！";
    text[8714] = "そこが おそらく やつらの アジトだろうな";
    text[8715] = "なら 今すぐ シリカ鉱山に 行きましょう！";
    text[8716] = "テトラ この人たちの 生体反応は！？";
    text[8717] = "残念ながら 死んでるわ... 傷が あまりにも 深すぎてね";
    text[8718] = "一体 誰が こんなことを！？";
    text[8719] = "バトルスーツから出る 反物質の 反応や 体に残った 大きな歯形...";
    text[8720] = "そして 熱エネルギーの 検出 こうした要素を 考えると...";
    text[8721] = "おそらくは 炎を操る マークの 仕業ね";
    text[8722] = "モラキュロイドみたいな？";
    text[8723] = "いいえ もっと ヤバイやつよ...";
    text[8724] = "なら マークの 襲撃に 備えて 警戒しながら 進みましょう！";
    text[8725] = "さあ みんな ここから 出してあげるわ！";
    text[8726] = "ルナーフォースだわ！";
    text[8727] = "ああ ありがたい...";
    text[8728] = "もう 死ぬまで 出られないかと 思ったよ...";
    text[8729] = "テトラが 外まで 案内するから ついていってね";
    text[8730] = "ま 待って... マフィアの ボスが...";
    text[8731] = "まだ いるのよ...";
    text[8732] = "脱走したことが バレたら... みんなの命が 危ないわ";
    text[8733] = "きっと どこまでも 追いかけてくるはず...";
    text[8734] = "大丈夫よ 一旦 あなたたちを 連れだしたら すぐに ボスを 逮捕するわ";
    text[8735] = "あと この鉱山で 暴れてる マークの ことも 調べなくっちゃね";
    text[8736] = "いずれにせよ あなたたちの 身の安全は 保証するわ";
    text[8737] = "ああ...";
    text[8738] = "キミ わかってないな...";
    text[8739] = "そのマフィアの ボスが... マークなんだ";
    text[8740] = "何ですって！？";
    text[8741] = "ここから先は オレの 口から 説明してやろう";
    text[8742] = "はじめまして\nオレは ケルベロス";
    text[8743] = "宇宙マフィアの ボスだ";
    text[8744] = "まず このアジトを 見つけ出したことは ほめてやろう...";
    text[8745] = "ケルベロス！  どうして 誘拐なんか しているの！？";
    text[8746] = "この人たちは ただの 一般市民よ！  何の罪も 犯していないわ！";
    text[8747] = "オレはただ 自分の仕事を しているだけさ...";
    text[8748] = "...少なくとも 前は そうだった";
    text[8749] = "どういうことだ？";
    text[8750] = "オレの組織は 何年にも渡って サロスから ヒミツの仕事を 受け持ってきた";
    text[8751] = "それは やつの実験の 材料となる 人間を 調達することだ";
    text[8752] = "それじゃあ お前は マークの 真実を 知っているのか？";
    text[8753] = "ああ よく知ってるとも";
    text[8754] = "オレたち マフィアは 物事の 善悪なんて どうでもいいんだ";
    text[8755] = "ただ 金と力さえ 手に入ればな";
    text[8756] = "そして サロスは 金をくれた\nさらに 力も 約束してくれた...";
    text[8757] = "この汚ねえ仕事と 引き換えにな";
    text[8758] = "だが つい先日 サロスは オレのもとを 訪ね...";
    text[8759] = "仕事は ここで しまいだといい...";
    text[8760] = "オレを こいつに 変えた";
    text[8761] = "見ろ";
    text[8762] = "オレは今 化け物だ";
    text[8763] = "確かに お前は 化け物だ\nなぜなら 自分の 仲間を 虐殺したからだ";
    text[8764] = "面白えのはよ... そう言われても 全然 覚えてねえんだ";
    text[8765] = "マークになってから... すべての 記憶が あいまいでな";
    text[8766] = "オレの魂は 少しずつ 痛みと 怒りに 蝕まれてるのさ！";
    text[8767] = "もう まともな 会話すら ままならねえ くらいにな！";
    text[8768] = "(ケルベロスに ここまでの 会話能力が あるということは)";
    text[8769] = "(それだけ サロスの マーク血清は 完成に 近かったと いうことだろう...)";
    text[8770] = "キサマ...";
    text[8771] = "オレを 何とかしろ！！";
    text[8772] = "すまないけど... 今 あなたを 直すことは できないのよ";
    text[8773] = "だから... 人間には 戻せないわ";
    text[8774] = "何だと！！  ふざけるな！！";
    text[8775] = "もう人間に 戻れないなら...";
    text[8776] = "もはや やることは 1つだけ...";
    text[8777] = "オレを 化け物した あの男を 殺すことだ...";
    text[8778] = "そして この復讐を ジャマする やつも 一人残らず 殺してやる！！";
    text[8779] = "ベラ！  ケルベロスの 反物質レベルが 急上昇しているわ！";
    text[8780] = "また 暴れるつもりよ！";
    text[8781] = "そんなことはさせない... 何としても ここで 止めるわよ！";
    text[8782] = "サロスは... ケルベロスの ような マフィアとも ずっと影で 取引していた...";
    text[8783] = "サロスのことは 今さら もう いいだろう";
    text[8784] = "オレたちは 今日 巨大な 犯罪組織を 倒した";
    text[8785] = "市民の 誘拐だけでなく 何百もの 犯罪行為に 手を染めていた 悪党どもをな！";
    text[8786] = "これからは マークに 変えられた 被害者たちの 救済に 集中できるってもんだ";
    text[8787] = "世直しの 完成に 一歩近づいたって もんさ！";
    text[8788] = "まあ 言われてみれば...";
    text[8789] = "その通りね";
    text[8790] = "どちらにせよ 今日は 大いなる 勝利の日よ！";
    text[1831] = "宇宙では ルナーと違い 人間の舌は";
    text[1832] = "十分な唾液を 分泌してくれないわ";
    text[1833] = "だから かつて ここでは スパイシーな 味付けが 人気だったの";
    text[1888] = "ルナー宇宙ステーションへ ようこそ！";
    text[1889] = "このステーション そのものが ルナーの 科学力の 結晶です";
    text[1834] = "あなたの お父さんが 重力装置を 作る前は";
    text[1835] = "このカフェの あらゆるものは マジックテープで 止められていました";
    text[1836] = "食べ物などが 浮いてしまわぬように です！  かつては パンくずが 散らかるからと ";
    text[1837] = "パンを 食べることすら 禁止されていたんですよ";
    text[1896] = "バトルロボットを 修理するために ルナー宇宙ステーションに 来たんですが";
    text[1897] = "どうやら ホバークラフトと 宇宙船しか 扱ってないようで";
    text[1898] = "バトルロボットの 修理は グリマルディの 軍事基地でしか やってないと 言われましてね...";
    text[1899] = "ルナー宇宙ステーションでは いろんな人に 会うことができる";
    text[1900] = "料理人 エンジニア ミュージシャン アーティスト... あらゆる種類の 人間さ！";
    text[1945] = "今は 警備任務中ですが はっきり言って 楽すぎますね";
    text[1946] = "ルナー宇宙ステーションは とても 安全な場所です";
    text[1947] = "だから 巡回していても 犯罪に 出くわすことなんて まずないんですよ";
    text[1948] = "さっき みかわしの サポートスキルを 買ったわ！";
    text[1949] = "敵の攻撃を 10％の 確率で かわすというのは ちょっと 低いけど...";
    text[1950] = "スキルポイントを使って アップグレードすれば 使い勝手が 良くなるはずよ";
    text[1951] = "ちなみに みかわしの レベル5は 50％の 確率で かわせるわ";
    text[1952] = "これって 青サポートスキルとしては かなり 強力なものよ";
    text[1953] = "特に ピンチの時に とても有効だわ！";
    text[1954] = "また それによって 様々な 赤サポートスキルを 試す 選択肢が 生まれるわ";
    text[1955] = "いいスキルの 組み合わせは いっぱい あるんだからね！";
    text[2047] = "我らの 青い太陽は いつ見ても 美しいものだ";
    text[2048] = "特に この宇宙ステーションから 眺めるのが 最高だよ  間違いない";
    text[2049] = "ただ そのせいで ここの住民は 放射線治療を 受けるのが 必須だ";
    text[2050] = "青い太陽の光は 我々の体に 悪影響を 及ぼすからね";
    text[2051] = "宇宙とは 美しくもあり また 恐ろしいものでも あるのだよ";
    text[2058] = "ある離れには 放棄された 宇宙ステーションが あるそうです";
    text[2059] = "ウワサによると 今から 百年前に エイリアンに 襲撃されたんだとか";
    text[2060] = "もっとも 本当のところは 誰にもわかりませんが...";
    text[2066] = "ここで 酸素ヘルメットを しなくても 平気な理由は";
    text[2067] = "ステーション全体を 大気フォースフィールドが 覆っているからよ！";
    text[2068] = "その大気フォースフィールドを 俗に 「アストロバリア」って 言うの！";
    text[2069] = "それは また 小隕石のような スペースデブリから ワタシたちを 守っているのよ！";
    text[2070] = "大きな デブリについては そのほとんどを レーザー兵器で 蒸発させているわ";
    text[2071] = "でも それで対処できない サイズになると...";
    text[2072] = "...っていけない もう仕事に 戻らなくっちゃ！";
    text[2073] = "我々は この宇宙ステーションで マークを 研究している";
    text[2074] = "残念ながら 今ある サンプルは なかなか 長持ち してくれないがね...";
    text[2075] = "マークは物質で できていない\nゆえに データを 集めるだけでも 多大な困難を 伴うのだ";
    text[2160] = "おお ちょっと 聞いてくれ...！  2か月前 我々は ";
    text[2161] = "未知の 宇宙船の中に ゴールデンレコード なるものを 発見した";
    text[2162] = "それを 解読するには ずいぶん 時間がかかったが";
    text[2163] = "どうやら それは ここから 250万光年離れた 銀河のものだと わかったのだ";
    text[2164] = "それには 画像 音楽 そして 「地球」なる星の あいさつなどが 含まれていた";
    text[2165] = "我々に 見つかるまで 何百万年も 宇宙を さまよったのだろう";
    text[2166] = "その文明が 今も 存在しているかは わからないが";
    text[2167] = "何とか 「地球人」と 接触するための 努力は 続けているよ";
    text[2168] = "この宇宙に 別の知的生命体が いると知ったら 彼らもきっと 喜ぶだろう";
    text[2169] = "どうか この試みが うまくいくことを 願おう";
    text[2170] = "これは 射撃練習に 使うものだ！  巻き込まれないように 気をつけて！";
    text[2171] = "今日で30日 プログラムの 29日目だ... あと少しで... でも 疲れたよ...";
    text[2172] = "おりゃー！  これでも くらえ！  ボクは ゼッタイに 夢を あきらめないぞ！";
    text[2173] = "この隊員は トレーニングに 集中している";
    text[2174] = "ここの 研究チームは 宇宙における 植物の研究を 受け持っている";
    text[2175] = "それによって より健康的な 食べ物の開発に 貢献しているんだ";
    text[2176] = "ああ 外で 自然を 満喫できた日々が 懐かしいわ";
    text[2177] = "ワタシは 科学と植物が 好きだから ここで 働いてるけど...";
    text[2178] = "家族みんなで ケプラー牧場に 住んでいた日々が とても懐かしいの";
    text[2179] = "新鮮な空気... 美しい木々... あれこそ この世の楽園よ！";
    text[2180] = "ワタシは 宇宙船と ホバークラフトの 専門家よ";
    text[2181] = "あなたの船に 問題があるなら なんでもござれと 言ったところよ";
    text[2182] = "例えば すべての宇宙船は 3つのパーツを カスタマイズできるの";
    text[2183] = "それは フレームと ウイングと スラスターよ！";
    text[2184] = "船のパーツを買うと 宇宙船カスタマイズを アンロックできるよ！";
    text[2188] = "宇宙船の カラー変更は 気分転換に ぴったりだ！";
    text[2185] = "ワールドマップワープが 使えるようになったら";
    text[2186] = "一度 船のカスタマイズを することを 強く オススメするよ！";
    text[2213] = "バトルシミュレーションルームヘ ヨウコソ  ホンジツノ ゴヨウケンハ？";
    text[2214] = "バトル";
    text[2215] = "情報";
    text[2216] = "特になし";
    text[2217] = "ワタシノ ニンムハ タイイン タチニ アタラシイ ワザト  ";
    text[2218] = "ラックスコンボヲ タメス キカイヲ アタエル コトデス";
    text[2219] = "マタ セントウデ ワタシヲ タオセバ バイトト EXPモ テニ ハイリマス";
    text[2220] = "バトルモード オン！";
    text[2221] = "ソウデスカ デハ ヨイ イチニチヲ！";
    text[3385] = "ああ なんて おいしいんだろう！";
    text[3386] = "そうだね！  すべての カフェには 違った 看板メニューがある";
    text[3387] = "中でも カフェ・レゴリシアは 隠れた 名店だと 聞くよ\nいつの日か 行ってみたいもんだ！";
    text[3405] = "ああ 今日は ひどい一日 だったわ！  ちょっと おいしい ものでも 食べて 落ち着かないと... ";
    text[3406] = "カフェ・コペルニクスへ ようこそ！";
    text[3407] = "ここでの食事は 十分に 楽しんで いただけたかしら？";
    text[3403] = "マークが引き起こす 破壊により 人類は 建設技術の 変更を 余儀なくされた";
    text[3404] = "今では 壊れた町を たった数時間で 直せるように なったぞい！";
    text[3467] = "ステータス効果って 知ってる？";
    text[3468] = "例えば 敵を スタンさせると 1ターン 行動を スキップさせられるわ！";
    text[3469] = "火傷を 与えると それは 3ターン続き";
    text[3470] = "敵が 攻撃する時に HPを 30ポイント 奪うのよ";
    text[3471] = "まあ よく調べてるわね！";
    text[3472] = "エヘヘ  ワタシの ママは ニューロンリンクを 売ってるの  それで いろいろ 覚えたのよ！";
    text[3483] = "コペルニクスの町は ルナーの 大クレーターから 90kmの 場所に 作られた";
    text[3484] = "これは ルナーでも 最大級の クレーターだが 深さについては その限りではない";
    text[3485] = "その称号は 「永遠の闇」の 異名を持つ グリマルディの ものだ";
    text[3486] = "グリマルディは あまりにも 深いため その一番奥には 日の光すら 届かないのだ";
    text[3487] = "この町は とても いい所だけど";
    text[3488] = "別のセクターに 引っ越ししようと 思ってるんだ";
    text[3489] = "ケプラー牧場のような 平和で のんびりした所に 住みたくてね";
    text[3473] = "ルナーフォースから 水道ネットワークを しっかりと 点検するように 言われたの";
    text[3474] = "アシスタント・ロボが 迅速に 直したという 話を聞いて 驚いたわ";
    text[3475] = "エヘヘ...";
    text[3666] = "ワシは 大人気の 育毛剤 「ハゲナイジェル」を 作っている 会社の 社長じゃ！";
    text[3667] = "皆が 健康な 髪の毛を 持てるように することに 人生を 捧げているんじゃ！";
    text[3701] = "ティコでは いろんなビジネスが 栄えている";
    text[3702] = "会社 お店 行商人 レストラン... なんだって あるんだ！";
    text[3703] = "オレはよく ショッピングを 楽しんだり カフェで コーヒーを 飲んだりするよ";
    text[3717] = "ボクは ジークだ！";
    text[3718] = "実はね ボクは ちょうどここで ロボットの お店を開く 予定なんだ";
    text[3719] = "まだ いろいろと 準備中だけど もうすぐ オープンできると 思うよ！";
    text[3720] = "そうしたら テトラの 武器も パワーアップして あげるよ！";
    text[3723] = "ぜひ ウチの 通信コードを スキャンしてくれ そしたら 店が 開いた時 通知が 来るからさ！";
    text[3724] = "スキャンしたわ！";
    text[3725] = "ようし！  それじゃあ また グランドオープンの 時に 会おう！";
    text[3752] = "ティコは ルナーでも 比較的 新しい セクターよ";
    text[3753] = "ちょっぴり ショッキングかも しれないけど ティコは一種の 「モバイルシティ」なの";
    text[3754] = "ええっ？  モバイルシティって！？";
    text[3755] = "簡単に言うと 町全体が 大きな土台の上に 作られていて";
    text[3756] = "それ自体を 移動させることが できるのよ！";
    text[3757] = "ティコはね 昔は 一番南の セクターだったのよ";
    text[3758] = "どうして移動したの？";
    text[3759] = "南の気候が だんだんと 不安定に なってきてね";
    text[3760] = "そこで 生活するのが 難しくなったから";
    text[3761] = "移動せざるを えなくなったってわけ";
    text[3762] = "へえ... そりゃあ すごいわ！";
    text[3763] = "ティコの おもしろい れきしトリビアを 聞きたい？";
    text[3764] = "そしてさらに 別のトリビアもあるわ";
    text[3765] = "ティコの空が 黄色なのは ここの アストロバリアのせいで";
    text[3766] = "南の 厳しい気候に 耐えるために 特別に こしらえた ものなのよ";
    text[3767] = "はい";
    text[3768] = "いいえ";
    text[3769] = "そう... 残念だわ...";
    text[3811] = "家畜は 別の牧場で 飼ってるわ";
    text[3812] = "ここでは 動物たちは 愛情を受け 自由の中で 幸せに 生きているのよ";
    text[3813] = "ワタシね イモムシと アリを 探してるの！";
    text[3814] = "ケプラー牧場には 虫がいっぱい いるのよ  エヘヘ";
    text[3815] = "だから 全部 集めたいの！";
    text[3816] = "クールな 技の名前を 考えてるんだ...";
    text[3817] = "ウチの ねえちゃんが サイコーに カッコイイ 技の名前を 考えてくれたんだ";
    text[3818] = "へえ なあに？";
    text[3819] = "ミッドナイト・ノヴァ・パンチ！！";
    text[3820] = "こっちは テトラバーストよ...";
    text[3821] = "ダサいわよねえ...";
    text[3822] = "かめはめ波！";
    text[3823] = "スペシャル・ビーン・キャノン！";
    text[3824] = "ボルト・タックル！";
    text[3825] = "ウインド・シュリケン！";
    text[3826] = "シリアス・パンチ！";
    text[3827] = "ケプラー牧場は セクター8の 数ある牧場の 1つさ";
    text[3828] = "各牧場は 異なる作物の 生産を 受け持っている";
    text[3829] = "個人的には ルナーで 農業を 営む道を 研究した 植物学者に";
    text[3830] = "敬意を 表したいね  彼らが いなければ この牧場だって 無かったんだから";
    text[3831] = "ケプラー牧場は テラの環境を 再現したと されるけど";
    text[3832] = "千年前の テラは 実際には どんな場所 だったんだろう...？";
    text[3833] = "なんでも 昔の テラには 木が たくさん 生えていたそうだ";
    text[3834] = "その昔 木材は とても 安かったらしい";
    text[3835] = "今じゃ とんでもない 高級品なのにね！";
    text[3836] = "それはわかるわ\nルナーには 木は 少ししか 生えていないから";
    text[3571] = "ああ これが ザラの お家？";
    text[3572] = "そうよ！  今は 家に いないみたいだから また後で 来ましょう";
    text[3585] = "このキノコを 食べるとね 体が 巨大化するそうよ";
    text[3586] = "ええ そんなの どこで 聞いたの？";
    text[3587] = "ワタシにはね ヒミツの 情報網が あるのよ エヘヘ...";
    text[3594] = "わあ 見て ベラ！  キャベツ トウモロコシ カボチャ それに イチゴも あるわ！";
    text[3601] = "レインは このアパートに 住んでるのよね？";
    text[3602] = "そうよ！  今は 家に いないみたいだから また後で 来ましょう";
    text[3579] = "わあ ケプラー牧場にも ルナーパネルが 設置されてるのね！";
    text[3611] = "ティコ・カフェは 現在 改装中のため お休みしています";
    text[3612] = "ああ～ん おいしいもの 食べたかったのに～  じゃあ また 今度 来ましょ！";
    text[4338] = "うーむ 少し のどが 乾いているが スナックも 食べたい...";
    text[4339] = "何を 買ったら いいと思う？";
    text[4340] = "チーズケーキバー";
    text[4341] = "マスター・エナGドリンク";
    text[4342] = "ソウルセーバー";
    text[4343] = "おお！  なぜだか 知らんが 2つ 落ちてきたぞ！";
    text[4344] = "というわけで 1つ キミに あげよう！";
    text[4345] = "さて そろそろ 仕事に 戻らなくては";
    text[4346] = "5分の 休憩など 長すぎる くらいだな ハハハ！";
    text[4347] = "最近は マークの 襲撃が 増えたため この基地に 駐在する 兵士の数が";
    text[4348] = "どんどん 減ってきている";
    text[4349] = "ほとんどの 兵士は セクターの パトロールか 反物質コアの 収集に 回されるからだ";
    text[4350] = "ルナーフォースの ジェットスーツは 最高グレードの 素材で 作られているわ";
    text[4351] = "何世紀にもわたる 宇宙探索の末 人類はついに";
    text[4352] = "コンパクトで 柔軟で 丈夫で スタイリッシュな 宇宙服を 手に入れたのよ";
    text[4353] = "やあ！";
    text[4354] = "見たところ キミなら この新しい サポートスキルを 使いこなせそうだな...";
    text[4355] = "なら バスタープラスの サポートスキルを 5000バイトで 買わないかい？";
    text[4356] = "まあ 正直に ぶっちゃけるけど";
    text[4357] = "息子の ホバークラフトの パイロット教習に お金が 必要でね";
    text[4358] = "彼の夢は ルナーフォースに 入ることなんだ！";
    text[4359] = "それで サポートスキルを 買って ボクの 息子を 支援してくれないかな？";
    text[4360] = "おお そうか！  ありがとう！";
    text[4361] = "何としても 息子の夢を 叶えたいんだ...";
    text[4915] = "シリカコロニーは 巨大な ブラッドクォーツの 鉱脈の 上にある";
    text[4916] = "採掘した資源の ほとんどは ルナーフォースと";
    text[4917] = "中央および 南部の 豊かなセクターに 送られる";
    text[4937] = "パパは よく ルナーの歴史を 教えてくれるわ";
    text[4938] = "でもね 一旦 しゃべり出したら 止まらないのよ...";
    text[4955] = "ボクは シリカの 再生可能エネルギーに 関する レポートを チェック しているんだ";
    text[4956] = "シリカは エネルギーの ほとんどが 地熱から 得ている という点で とても ユニークだね！";
    text[4957] = "マークが 増えたために 鉱物の 採掘を 遅らせる 必要が 出てきた";
    text[4958] = "どうやら やつらは 鉱山の暑さが 好きみたいだ";
    text[4959] = "深くに 行けば 行くほど より多くの マークに 遭遇するはずだ";
    text[3751] = "わあ！  遠くに レゴリシアが 見えるよ！";
    text[7948] = "ティコ・カフェは 創作をやる人間にとって オアシスみたいな 場所よ";
    text[7949] = "才能ある アーティストが 集って ステキな パフォーマンスを 見せてくれるの！";
    text[7950] = "ミュージシャン 歌手 コメディアン アーティスト ダンサー...";
    text[7951] = "エンタメとくれば なんでもござれ なんだから！";
    text[8135] = "ここは 闇市だぜ お嬢ちゃん";
    text[8136] = "アンタみたいなのが 来る所じゃねえよ";
    text[8137] = "とは言いつつ...";
    text[8138] = "ビジネスは ビジネスだ";
    text[8139] = "オレは 合法的に 仕入れた 船のパーツを 売っている...";
    text[8140] = "...ちゃんと 「合法的」 だからな";
    text[8141] = "さて... 買うか 消えるか さっさと 決めな！";
    text[8132] = "こんにちは！  もし よければ 船のパーツを 買っていかないかい？";
    text[8133] = "興味があるなら 見ていっておくれ！";
    text[8134] = "ほら こんな感じだよ！";
    text[8593] = "ちょっと　歴史トリビアを 教えてあげよう...";
    text[8594] = "ルナーで たくさん 見かける カイロゲートは...";
    text[8595] = "元々 古代人が 長旅の疲れを 癒すための 休憩スポット だったのさ！";
    text[8812] = "20XX年 アストラの名で 知られる 破滅的大災害が 始まった";
    text[8813] = "反物質で 構成された 謎の彗星が 惑星テラに 迫ってきたのだ";
    text[8814] = "人類は その彗星を 何度も 破壊しようと 試みたが";
    text[8815] = "結局は 失敗に終わり テラからの 脱出を 余儀なくされた...";
    text[8816] = "そして その避難先に 選ばれたのが 我らが 衛星 ルナーだった";
    text[8817] = "誰にも 阻止できなかった コーダ彗星は";
    text[8818] = "テラを通過し 終末的大被害を もたらし";
    text[8819] = "その日だけで 数十億もの 命が 失われた...";
    text[8820] = "我らの 始祖である 「七人の英雄」が いなければ";
    text[8821] = "人類は その時 滅亡していただろう...";
    text[8822] = "それから 千年の 月日が 流れた";
    text[8823] = "人類は ルナーに移住し かつての 繁栄を 取り戻した";
    text[8824] = "その科学技術も また 目覚ましい 発展を 遂げたが";
    text[8825] = "依然として ルナーの 資源は 深刻なほど 不足している";
    text[8826] = "...このままでは そう遠くないうちに 今の文明を 維持できなく なるだろう";
    text[8827] = "...そうなったら 再び 他の星へ 移住せざるを 得なくなるだろう";
    text[8829] = "コーダ彗星 および アストラの 件は 人類に 大いなる 教訓を 残した";
    text[8830] = "たとえ 何が起きようとも...";
    text[8831] = "人類は 生き残る意志を 持っているのだと";
    text[8832] = "今後 我らの なすべきことは";
    text[8833] = "...過去の文明の 限界を突破し";
    text[8834] = "未来の栄光を 確実なものに することだ";
    text[8835] = "その時まで ワタシは 前進し続ける 所存だ\n サロス";
    text[8843] = "よお お前らは レアアイテムって もんに 興味はあるかい？";
    text[8844] = "あるなら この鉱山の 南にある ポータルに 向かいな";
    text[8845] = "そこで オレの兄弟が 闇市を 開いてんだ";
    text[8846] = "他じゃ 手に入らねえ 貴重なお宝が　買えるって もんだぜ！  ヒヒヒッ！";
    text[8872] = "あん？  お前 後ろの レーザードアを 開けてほしいのか？";
    text[8873] = "悪いが アレについては オレにも わからねえんだ";
    text[8874] = "わかってるのは... やべえ やつらが 出入りしてるって ことだけだな";
    text[8876] = "赤サポートスキルは 強力だが... 制限がある";
    text[8877] = "同時に 3つまでしか 装備できないからだ...";
    text[8878] = "ただし...";
    text[8879] = "この世には レジェンド・アップグレードチップ というもんがある";
    text[8880] = "そいつを使えば 5つまで 赤サポートスキルを 装備できるように なるのさ！";
    text[8881] = "欲しいか？\nなら 条件は 1つだけだ...";
    text[8882] = "オレの兄弟が 売っている 商品を 全部 買うこと...";
    text[8883] = "そうすれば レジェンド・アップグレードチップを くれてやろう！";
    text[8884] = "どうやら 兄弟が 売ってるモンを 全部 買ったようだな";
    text[8885] = "これで アンタも 晴れて 闇市の ナンバーワン 顧客さ ヒッヒッヒ";
    text[8886] = "その礼と いっちゃ アレだが こいつを 受け取ってくれ！";
    text[8887] = "あんたと ビジネスできて よかったぜ ベラさんよ";
    text[8897] = "もう 遅い時間だから ゆっくり していきな いいかい？";
    text[8898] = "ヘトヘトに なるまで 働いても 何も いいことないよ";
    text[8899] = "だから 気持ちが 休まるまで ここに いれば いいのさ";
    text[8900] = "淹れたての ムーンコーヒーほど 心を 楽にしてくれるものは ないね";
    text[8901] = "あらあ あなた！ 覚えてる？";
    text[8902] = "覚えてるって 何を？";
    text[8903] = "覚えてない...";
    text[8904] = "立ち去る";
    text[8905] = "どうやら 忘れちゃったみたいね\nでも 大丈夫 ゼッタイに 忘れないわ！";
    text[8906] = "最後の時が 来る前に きっと 本当の 自分を 思い出すわ";
    text[8907] = "記憶は あなたを さらなる高みに 押し上げるのよ";
    text[8908] = "だから それを 力に変えて 自分を導いて！";
    text[8909] = "...そして 忘れずに 覚えておくのよ";
    text[8910] = "ワタシも 忘れないわ";
    text[8911] = "あなたは 忘れたかもしれないけど ワタシは 覚えてるわ";
    text[8912] = "では また 会う時まで...";
    text[8913] = "次は ジャックと マーサに 捧げる一曲だ！";
    text[8914] = "このドアを 開けるには 特殊な カードキーが いる...";
    text[8915] = "鉱山のカードキーを使って ドアを開けた！";
    text[8933] = "ボンジュール！  それでは ここに 来るまで どれくらい かかったか 見てみまショウ！";
    text[8928] = "ウーン あなたの 旅は 「早い」ですネ！";
    text[8929] = "ちょっと 早すぎるかも しれまセーン...";
    text[8930] = "おそらく あなたは タイムトラベラーか コードブレーカー なんでしょうネ！";
    text[8931] = "どちらにせよ 最速記録での 到達 おめでとうございマース！";
    text[8932] = "あなたの ような方には これを 差し上げマース！";
    text[8934] = "おお すごいデース！  3時間以内に ここに来たのですネ";
    text[8935] = "それでは あなたに 「マスター・スピードランナー」の 称号を  差し上げまショウ！";
    text[8936] = "おお なかなかデース！  8時間以内に ここに 来たのですネ";
    text[8937] = "それでは あなたに 「ノーマル・スピードランナー」の 称号を  差し上げまショウ！";
    text[8938] = "おお ナルホド！  どうやら あなたは...";
    text[8939] = "ゲームを じっくりと 味わいながら...";
    text[8940] = "ゆっくりと 世界を 旅するのが お好きな ようですネ...";
    text[8941] = "あなたの ような方には 「ルナー・エクスプローラー」の 称号を 差し上げまショウ！";
    text[8942] = "なお 別の世界線の あなたは 別の称号を もらっているかも しれまセーン...";
    text[8943] = "どうしてかって？  それは ここに 至るまでの 時間で 変わってくるからデース！";
    text[8944] = "それでは アデュー！";
    text[8945] = "奇妙な 砂時計だ\nそう思いながら 上下を 逆さまにした...";
    text[8987] = "ハァ... せっかくの 休みの日に マークに 襲撃されるなんてね";
    text[8988] = "ヤケ酒でも 飲みたい 気分だよ...";
    text[8989] = "まあ 街も 落ち着きを 取り戻しつつあるし";
    text[8990] = "今日は もう ずっと カフェで ダラダラしようかな";
    text[9015] = "やあ オレは シウだ";
    text[9016] = "第7師団で 武器の 設計を 担当している";
    text[9017] = "サロス将軍は オレの腕前を 大層 気に入ったようで";
    text[9018] = "対マーク兵器の 開発部門に 異動させてくれたのさ";
    text[9019] = "今 開発しているのは ホロブレードだ";
    text[9020] = "完成すれば 理論上は 反物質コアを 損傷することなく";
    text[9021] = "マークを 真っ二つに できるのさ";
    text[9022] = "そうなれば 反物質コア 集めが はるかに 簡単に なるってもんだ！";
    text[9023] = "おい お前ら こんなとこで 何してんだ？";
    text[9024] = "ダラダラ サボってねえで とっとと 持ち場に戻れ！";
    text[9025] = "この見張りは ものすごく マジメな 性格のようだ";
    text[9026] = "ピクリともせずに 目を見開いて 壁を じっと 見つめている...";
    text[9000] = "こんにちは！  ワタシはミディ！";
    text[9001] = "この街で 一番の ロボバニーDJよ！";
    text[9002] = "それで これが 今度 発売される アルバムの お試しトラックよ！";
    text[9003] = "さあ 一緒に ビートを 感じましょ！";
    text[900] = "ニャーオ！";
    text[901] = "あああ エコー！  こんにちは 子猫ちゃん！";
    text[902] = "宇宙猫ちゃんね！";
    text[903] = "ニャーオ ニャーオ！";
    text[904] = "エコーから 10,000バイトを 受け取った！";
    text[905] = "レアキャラ遭遇: 宇宙猫の エコー";
    text[906] = "エコーは ルナー宇宙ステーションの 飼い猫で";
    text[907] = "宇宙を冒険するのが 大好きです";
    text[908] = "また ルナーの 特定のエリアで 出会えることが あります！";
    text[1806] = "エコーは 目を 輝かせながら 宇宙を 見上げている";
    text[1342] = "ネットワークリンクを かくりつした！";
    text[1343] = "ステージの さいごに とうたつしたら ネットワークを さいきどう できるよ！";
    text[1344] = "ただし ウイルスと トラップに きをつけてね！";
    text[1345] = "あと テトラの ライフが ゼロになったら";
    text[1346] = "さいきどうは しっぱいに なるよ";
    text[1347] = "あらわれる てきは テトラバスターで たおそう！";
    text[1348] = "ネットワーク さいきどう かんりょう！";
    text[1349] = "しゅうりょうリンクを しゅとくちゅう...";
    text[1350] = "Tetra.EXE しゅうりょうリンクを かくりつした！";
    text[1351] = "さいきどう しっぱい...";
    text[4033] = "ベラ このステージは ファイアウォール だらけよ！";
    text[4034] = "ファイアウォールを うつと だんやくを しょうひするわ";
    text[4035] = "その かずには かぎりが あるのを わすれずにね！";
    text[4036] = "それと あと1つ！";
    text[4037] = "ウイルスを うっても だんやくは へらないわ";
    text[4038] = "あと いきづまったら ステージを やりなおせるからね！";
    text[4039] = "シャットダウン・プロトコルは ステージの いちばん おくよ！";
    text[4040] = "それを シャットダウンしたら レーザードアが ひらくわ！";
    text[4041] = "それじゃあ レッツ ゴー ゴー ゴー！";
    text[4042] = "ネットワークの シャットダウン せいこう！";
    text[4043] = "ネットワークの シャットダウン しっぱい...";
    text[5342] = "ベラ このステージは コペルニクスの ネットワークの";
    text[5343] = "いくつかある アクセスポイントの 1つよ！";
    text[5344] = "ごうけい 4かしょの スイッチを おすと";
    text[5345] = "すいどう ネットワークを さいきどう できるわ！";
    text[5346] = "いきづまったら ワープで だっしゅつ するのよ！";
    text[5347] = "それぞれの フィルタマシンに べつの";
    text[5348] = "アクセスポイントが あること おぼえておいてね！";
    text[5350] = "このネットワークは ウイルス だらけよ！";
    text[5351] = "すべての ウイルスを けして";
    text[5352] = "ファイアウォールを とり さいきどうするのよ！";
    text[5353] = "あと ステージの トラップに きをつけてね！";
    text[4803] = "テトラ これって レゴリシアに いたのと 同じ ロボットかしら？";
    text[4804] = "ええ 名前は ディジットね！";
    text[4805] = "ディジットが お家に 帰ることが できたみたいで うれしいわ";
    text[4806] = "でも レゴリシアでは 何を していたのかしら？";
    text[4807] = "01101000 01100101 01101100 01110000";
    text[4808] = "01110110 01101001 01110010 01110101 01110011";
    text[4809] = "うんうん... なるほどね";
    text[4810] = "何て 言ってるの？";
    text[4811] = "ディジットの AIネットワークが ウイルスに やられたんだって";
    text[4812] = "助けを 求めてるわ！";
    text[4813] = "そりゃ 大変ね... 大丈夫よ ディジット 今すぐ 助けてあげるからね！";
    text[4814] = "テトラ ディジットの ネットワークにいる ウイルスを 取ってあげましょう！";
    text[4815] = "ディジットの AIネットワークに 入る？";
    text[4816] = "こんかいの もくてきは ディジットに";
    text[4817] = "かんせん している ウイルスを とりのぞく ことよ！";
    text[4818] = "ウイルスを たおしたら ディジットの ネットワークを さいきどう できるわ！";
    text[4819] = "いろいろな トラップに きをつけてね！  それじゃあ レッツ ゴー ゴー ゴー！";
    text[4876] = "ビービー";
    text[4877] = "タスケテクレテ アリガトウ！";
    text[4878] = "コレヲ ウケトッテ  ビービー";
    text[4880] = "ディジット ホントウニ カンシャ  ビービー";
    text[4881] = "ディジット コレデ データ マイニングニ モドレル";
    text[751] = "誰でも あらゆる知識を 脳に ダウンロード できるが";
    text[752] = "一番 大切なのは それを どう使うかだ  そのことを よく 覚えて おきなさい";
    text[753] = "おお！  キミの顔は 宇宙ステーションで 見た覚えがあるぞ！";
    text[754] = "確か トーマス博士の 娘さんだろう？";
    text[755] = "私は ニューロンリンクの 専門家だ！";
    text[756] = "「ニューロンリンク」って？";
    text[757] = "ニューロンリンクを 持ってるの？";
    text[758] = "そういう話は 興味ない";
    text[759] = "ニューロンリンクとは 最新の 精神操作テクノロジーだ！";
    text[760] = "簡単に言うと 人の脳みそに 情報を ダウンロードするのだよ！";
    text[761] = "もう 一部の学校では ニューロンリンクが 使われているし";
    text[762] = "兵士は 新しい技を 一瞬で 身に着けたり している！";
    text[763] = "どうだ とんでもない テクノロジーだろう！？";
    text[764] = "もちろんだ！  高いものだが キミになら 少し安くして 売ってあげてもいいぞ！";
    text[765] = "お値段はズバリ 1500バイトだ！";
    text[766] = "ほしい！";
    text[767] = "いらない";
    text[768] = "よしきた！";
    text[769] = "サポートスキルの 管理と装備は サポートスキル・メニューで 行えるよ！";
    text[770] = "ん ちょっと待った！  バイトが足りないな！";
    text[771] = "そうか じゃあまた！";
    text[3547] = "オレは アーマー・アップグレードチップって やつを 持ってるんだが...";
    text[3548] = "アーマー・アップグレードチップは アイテムメニューから 装備することができる";
    text[3549] = "装備すると 最大HPが 200上がるのさ！";
    text[3550] = "レアなアイテムには レアな通貨ってことで 80スキルポイントで どうだい？";
    text[3551] = "アイテムメニューで アーマー・アップグレードチップを 装備するのを 忘れずにな";
    text[3553] = "おいおい 遊びじゃねえんだぞ\n80スキルポイント 手に入れてから 出直してきな";
    text[3554] = "オレは SPアップグレードチップって やつを持ってるんだが...";
    text[3555] = "SPアップグレードチップは 最大SPを 100上げるのさ！";
    text[3556] = "最大SPを 上げられる アップグレードチップは こいつだけだ";
    text[3557] = "SPアップグレードチップの 値段は 160スキルポイントだ  どうだい？";
    text[3558] = "アイテムメニューで SPアップグレードチップを 装備するのを 忘れずにな";
    text[3560] = "おいおい 遊びじゃねえんだぞ！\n160スキルポイント 手に入れてから 出直してきな";
    text[3252] = "取引してくれて ありがとよ！";
    text[3253] = "よお アンタ どうやら 珍しい アップグレードチップを 扱えるみたいだな";
    text[3254] = "オレは バリア・アップグレードチップって やつを 持ってるんだが...";
    text[3255] = "興味あるかい？";
    text[3256] = "何それ？";
    text[3257] = "いくら？";
    text[3258] = "バリア・アップグレードチップは アイテムメニューから 装備することができる";
    text[3259] = "装備したら 1回のみ 有効な バリアを 持った状態で バトルを スタートできる";
    text[3260] = "敵の攻撃を 受けても バリアが 代わりに 吸収する";
    text[3261] = "かつ バトルランクに 影響は 出ない";
    text[3262] = "ただし 一旦 バリアが 使われると 次の バトルまでは 回復しない ";
    text[3263] = "オレが 欲しいのは バイトや アストロテック じゃなくて スキルポイントさ";
    text[3264] = "レアな アイテムには レアな 通貨ってことで 40スキルポイントで どうだい？";
    text[3265] = "へへ アンタ  いい買い物したぜ";
    text[3266] = "アイテムメニューで バリア・アップグレードチップを 装備するのを 忘れずにな";
    text[3267] = "そうか じゃあ またな";
    text[3269] = "おいおい 遊びじゃねえんだぞ\n40スキルポイント 手に入れてから 出直してきな";
    text[629] = "よお！  オレは アストロテック商人の サイファーだ";
    text[630] = "アストロテックを 集めたら いいアイテムと 交換してやるぜ";
    text[631] = "買う";
    text[632] = "話す";
    text[633] = "立ち去る";
    text[634] = "オレは ここから北にある シリカという コロニーに 店を持ってんだ";
    text[635] = "ここには アストロテックを 稼ぎたい時に 来るのさ";
    text[636] = "シリカは 有名な 採掘スポットよね！";
    text[637] = "ルナー中から トレジャーハンターが 集まってくるって 聞くわ";
    text[638] = "そうさ！";
    text[639] = "シリカには レアな鉱物が わんさか埋まってる";
    text[640] = "一方の レゴリシアでは いろんな ハイテクグッズが 手に入るってわけだ！";
    text[641] = "そうね！";
    text[642] = "それで アストロテックを 集めて 何に使うの？";
    text[643] = "何って アストロテックから ちょっくら イケてるモンを 作るのさ";
    text[644] = "マシンとか そういうのをよ！";
    text[645] = "シリカに 立ち寄ることが あったら ぜひ オレの店を 見ていってくれ";
    text[646] = "クールな 宇宙船の パーツなんかを 売ってやるからよ！";
    text[647] = "取引してくれて ありがとな！";
    text[648] = "アストロテックが 足りねえよ！";
    text[649] = "悪いが 今はもう 全部 売り切れだ";
    text[650] = "よしきた！  今の 売りものは こんなところだ";
    text[651] = "うりきれ";
    text[4842] = "よお！  元気かい？  クールな 船のパーツを 探しているなら";
    text[4843] = "ここより いい店は ないぜ！";
    text[4844] = "ええっと... ワンちゃんは どこに 行ったの？";
    text[4845] = "今は 眠ってるぜ！  しっぽ振って ばかりで 疲れちまった みたいだな！";
    text[652] = "やあ オイラの 名前は ニム\nさすらいの 商人さ";
    text[653] = "今日は いくつか いいブツを 仕入れてるけど どうだい？";
    text[654] = "ようし じゃあ 見ていきな";
    text[655] = "アストロテック商人を 探してるって？";
    text[656] = "さっき この近くで 見かけたな";
    text[657] = "そうか それじゃあ また";
    text[658] = "買う";
    text[3806] = "やあ こんにちは";
    text[3807] = "この牧場には たまたま 来たんだけど 一目惚れしちゃってね";
    text[3808] = "いつか ここに 店を 建てようかな なんて 考えてるくらいさ";
    text[3809] = "いくつか 新しいアイテムを 仕入れたけど どうだい？";
    text[1919] = "こんにちは！  ワタシは アレックス  ルナー宇宙ステーションの 商人よ";
    text[3213] = "あら こんにちは！\nアイテムストアへ ようこそ！";
    text[1920] = "今は ちょうど セール中なの！";
    text[1921] = "あら！  何が欲しいのかしら？";
    text[1922] = "また来てね！";
    text[1923] = "近くで 他の店を やってるのは 実は 私の姉妹なのよ！";
    text[1924] = "かつては 一緒に スパイを やってたんだけど 今は 新しい人生を がんばっているわ！";
    text[1929] = "あら こんにちは！  ワタシは ブリトニーよ  立ち寄ってくれて どうも ありがとう！";
    text[1930] = "ここでは アストロテックと 引きかえに たくさんの 便利な アイテムを 販売してるわ！";
    text[1931] = "この店では 船のパーツも 売っているわ";
    text[1932] = "値段は 結構 張るけど それだけの 価値は あるわよ！";
    text[1933] = "ワールドマップワープに インタラクトすると 船を カスタマイズ できます！";
    text[1934] = "今の在庫は こんな感じよ";
    text[3208] = "船のパーツを いろいろと 入荷したわ！";
    text[3209] = "それぞれの 店には 違ったアイテムを 揃えているわ";
    text[3214] = "新しい ジェットスーツを 入手できます！";
    text[3215] = "コペルニクスの ルナースタイルの お店で クローバーと 話しましょう！";
    text[3216] = "ジェットスーツを 変える時は ポーズメニューで [C] を押しましょう！";
    text[3217] = "ジェットスーツを 変える時は ポーズメニューで [四角] を押しましょう！";
    text[3218] = "ジェットスーツを 変える時は ポーズメニューで [Y] を押しましょう！";
    text[1938] = "ああ ベラ！  ジェットスーツ・プログラムに 参加してくれて ありがとう！";
    text[3219] = "新しい ジェットスーツが できてるわよ！";
    text[3221] = "ルナーで最高の ジェットスーツを 作るという ワタシの夢に 終わりはないわ！";
    text[1940] = "ハァ～イ ワタシは サム！  ここで ニューロンリンクを 売っているの！";
    text[1941] = "新しいわざや スキルブースターなんかを 買うことができるわ！";
    text[1942] = "ワタシと姉妹たちは ルナー中で お店をやってるのよ！";
    text[1943] = "結構 レアなアイテムも 売っているから 是非のぞいてみてね！";
    text[1944] = "さあて 何が欲しいのかしら？";

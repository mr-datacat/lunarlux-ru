    text[7330] = "実験体270 ～ 276 -\n反物質分析: 火の操作";
    text[7331] = "注意: この実験体は 不安定な 原子構造を 持っているもよう";
    text[7332] = "それが ゆえに 「爆発的な」 性質を 持つ";
    text[7336] = "コードネーム: グリムロック\nシンクロ率16％";
    text[7333] = "実験体136 ～ 138 -\n反物質分析: 鉱物の操作";
    text[7334] = "注意: この実験体の 殻は 強化された 反物質と 鉱物で できている";

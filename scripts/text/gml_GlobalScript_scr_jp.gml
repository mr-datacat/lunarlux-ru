    text[2117] = "様々な 植物の種が 保管されている";
    text[2118] = "箱には 焙煎したての 最高級の コーヒー豆が 入っている！";
    text[2119] = "この制御パネルは ホログラムの ディスプレイを 生成している";
    text[2120] = "これは 会議で アイデアや デザインを 視覚化するのに 使われる";
    text[2121] = "トーマス博士の パソコンだ！";
    text[2122] = "そこにある フォルダ名は 「反物質」 「マークDNA」 「コーヒー研究」だ";
    text[2129] = "「適切な ワークライフ・バランスの 実現方法」という タイトルの 本が 置かれている";
    text[2130] = "ワームホールマシンを 監視する スーパーコンピュータだ";
    text[2131] = "「ダークエネルギー」 「ダークマター」 といった 名前の 極秘ファイルが ある";
    text[2132] = "このコンピュータは 反物質でできた コーダ彗星の 軌道を 監視している";
    text[2133] = "このコンピュータは 反物質の 燃料レベルを 監視しているが 今のところ とても 低いようだ";
    text[2134] = "ワームホールマシン 「セレスティア」の プロトタイプだ";
    text[2135] = "人類の存続は このマシンの 開発に かかっている";
    text[2136] = "段ボール箱の 中には 古い おもちゃなどが 入っている";
    text[2138] = "これは たくさんの プログラムを 同時に 実行できる ハイスペックな パソコンだ";
    text[2139] = "ディスプレイの 壁紙は オシアナスで 撮った グレイ一家の 記念写真だ";
    text[2140] = "トーマス博士は シアを お姫様だっこし シアは 赤ん坊のベラを 抱えている";

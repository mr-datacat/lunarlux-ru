    text[1137] = "カイロゲートの 穏やかな光を見ると 心が癒されるようだ";
    text[120004] = "カイロゲートの 青い光は 心を癒してくれる";
    text[1030] = "このカイロゲートは 奇妙なオーラを 発している";
    text[1031] = "見ていると なぜか 好奇心と 不安の 両方に襲われる...";
    text[120005] = "ここまでのプレイを セーブしますか？";
    text[120006] = "セーブしました！";
    text[120007] = "セーブされませんでした";
    text[7551] = "セーブせずに ゲームを終了しても よろしいですか？";
    text[1603] = "はい (先にセーブをしましょう！)";
    text[7400] = "最後の 戦いは 目の前だ\nラックスの輝きよ 永遠なれ...";
    text[610] = "レゴリシアの 掲示板だ！";
    text[1138] = "レイ";
    text[1177] = "レゴリシアけいじばん";
    text[1216] = "みなさん こんにちは！ レゴリシア掲示板の 管理人 レイです！";
    text[1217] = "バトルのことでも 他のことでも 好きなテーマで 自由に語って くださいね！";
    text[1139] = "ルナーフォース";
    text[1178] = "ちゅういかんき";
    text[1218] = "マークが 自分の セクターに 現れた時は";
    text[1219] = "お近くの シェルターに 避難し すぐさま ルナーフォースに 通報してください";
    text[1220] = "また いかなる場合でも 自己判断で マークを 攻撃しないように お願いします";
    text[1140] = "ミシェル";
    text[1179] = "カフェ・レゴリシア";
    text[1221] = "お仕事で 疲れていませんか？";
    text[1321] = "そんな あなたを カフェ・レゴリシアが 癒します！";
    text[1222] = "おいしい みそラーメンや サクサクバーを 用意して あなたを お待ちしています！";
    text[1141] = "ゼータマン";
    text[1180] = "くろい はんてん";
    text[1223] = "最近 地面に 奇妙な エネルギーの 斑点が あるのを 見たんだ...";
    text[1224] = "でも すぐに消えた  ウワサによると そういうものを 出す マークが いるらしい";
    text[1142] = "ロト";
    text[1181] = "かいしシールド";
    text[1225] = "やあ みんな ロトだ！ いきなりだけど 開始シールドって 聞いたことある？";
    text[1226] = "初期状態では シールドは 1つ持った 状態だけど シールドブースターを 使えば";
    text[1227] = "最大数 のみならず バトル開始時の シールドの数も 増やすことが できるんだ！";
    text[1143] = "ボルツ";
    text[1182] = "いわのマーク";
    text[1228] = "この間 歩く 岩のような マークを 見たんだ...";
    text[1229] = "窓の外を みたら そこは 深い洞窟だった";
    text[1230] = "誓ってもいいけど ホラ話とかじゃ ないからね！";
    text[1144] = "ラセル";
    text[1183] = "バトルせんりゃく";
    text[1231] = "うおおお！ パワーばいぞう (LV 1) の サポートスキルを 手に入れたぞ！";
    text[1232] = "これで フォトンキャノンを 使えば ハイパービーなんか イチコロだ ウヒャヒャ！";
    text[1145] = "スペースボーイ";
    text[1184] = "RE 1: バトルせんりゃく";
    text[1233] = "あのさあ お前の パワーばいぞうって レベル1っしょ...";
    text[1234] = "まともな 効果を 出したいなら";
    text[1235] = "まずは スキルポイントを 使って サポートスキルの レベルを";
    text[1236] = "上げた方が いいんじゃね？\n全然 威力 変わるぜ";
    text[1237] = "そうすれば 大抵の 雑魚マークなんざ 瞬殺ってもんよ！";
    text[1146] = "ラセル";
    text[1185] = "RE 2: バトルせんりゃく";
    text[1238] = "なるほどおおお！  めっちゃ参考になるわ！  ありがとおおお！";
    text[1147] = "メリア";
    text[1186] = "おとした ハーツ・キューブ";
    text[1239] = "誰か ワタシの ハーツ・キューブを 見かけませんでしたか？";
    text[1240] = "多分 バリア施設 辺りで なくしたと思うんだけど...";
    text[1148] = "ジェット";
    text[1187] = "Sランク";
    text[1241] = "バトルで Sランクを 取る条件 誰か知ってる？";
    text[1242] = "タイムかな？";
    text[1243] = "それとも ターン数？";
    text[1244] = "はたまたHPとか？";
    text[1245] = "詳しい人 おせーて！";
    text[1149] = "キングネット";
    text[1188] = "RE 1: Sランク";
    text[1246] = "単に攻撃を 食らわなければ 取れるよ";
    text[1150] = "ジェット";
    text[1189] = "RE 2: Sランク";
    text[1247] = "え？  それ ちょっと はしょりすぎじゃね？  本当にそれだけ？";
    text[1151] = "オスロ";
    text[1190] = "RE 3: Sランク";
    text[1248] = "あのさ あんまり キングネットに 突っかからない方が いいと思うよ  ";
    text[1249] = "その人 ガチの 強者だから";
    text[1152] = "ジェット";
    text[1191] = "RE 4: Sランク";
    text[1250] = "でも マークスレイヤーには 勝てないっしょ？";
    text[1153] = "イーサー";
    text[1192] = "サポートスキル";
    text[1251] = "この前 ボスバトルの前に 回復サポートスキルを オンにするの 忘れちゃって";
    text[1252] = "みんなも サポートスキルは こまめにチェックしないと ひどい目に遭うよw";
    text[1154] = "ルナボット 101";
    text[1193] = "アストロバリア";
    text[1253] = "アストロバリアは 人工大気生成装置および 防衛システムです";
    text[1254] = "また 電磁波を 用いて 重力および 酸素発生装置と 通信することも できます";
    text[1255] = "人間が ルナーで 快適に 生活できるのは アストロバリアの おかげです";
    text[1155] = "ルナボット 101";
    text[1194] = "きょうの ひとこと";
    text[1256] = "今年は 30XX年！ それでは 今日の 一言です";
    text[1257] = "ラックスの輝きよ 永遠なれ！";
    text[1156] = "ティリアン";
    text[1195] = "ふかい かんがえ";
    text[1258] = "自分の周囲に 目に見えない 道があるのを 想像してくれ";
    text[1259] = "それが 電磁波みたいなので できていたら どうする？";
    text[1260] = "深いだろ？";
    text[1157] = "トビー";
    text[1196] = "RE: ふかい かんがえ";
    text[1261] = "ティリアン ちょっと エナGドリンクの 飲みすぎじゃ ないかな？";
    text[1158] = "ルナボット 101";
    text[1197] = "20XX";
    text[1262] = "20XX年 人類は テラの名で 知られる 現在 火山だらけの 死の惑星に 住んでいました";
    text[1263] = "「アストラ」と呼ばれる 大災害により 人類は 新たな故郷へ 移住せざるを 得ませんでした";
    text[1264] = "しかし まともな時間で いける範囲に 人が住める 惑星は ありませんでした";
    text[1265] = "そこで 残された生存者は テラを 周回する 衛星ルナーへと 向かいました";
    text[1266] = "夢と希望 そして決意を 胸に...";
    text[1267] = "人類は 新たな星で 命をつなぎ 繁栄を 続けました";
    text[1159] = "ホロ";
    text[1198] = "いせき";
    text[1268] = "こんにちは 探偵の ホロです";
    text[1269] = "最近 発見された 遺跡に関する 情報と ルナー各地の";
    text[1270] = "壁に刻まれた 文字について 知っている方は いらっしゃいませんか？";
    text[1160] = "ヴォルタ";
    text[1199] = "ランクアップスキル？";
    text[1271] = "ボルタです  アクティブスキルを 強化する方法を 教えてもらえませんか？";
    text[1161] = "チップ";
    text[1200] = "RE: ランクアップスキル？";
    text[1272] = "スキルブースターを 使って アクティブスキルを レベルアップしましょう";
    text[1322] = "簡単には 入手できませんが...";
    text[1162] = "ERROR";
    text[1201] = "タイトルなし";
    text[1273] = "生命は 実験に すぎない";
    text[1274] = "それは ただ 混沌より 生まれしものだ";
    text[1275] = "妙なことに この投稿の 日付は 10年前に なっている";
    text[1276] = "画面を 更新しても なぜか 移動しない";
    text[1277] = "サーバーの 故障だろうか？";
    text[1163] = "アルマエ";
    text[1202] = "タイトルなし";
    text[1278] = "ヘヘヘ";
    text[1279] = "(その先の 69件の 返信は ただ「ヘヘヘ」 だけだ)";
    text[1164] = "スターク";
    text[1203] = "きもち わかるひと いる？";
    text[1280] = "悲しいとき～！\nバトルで出てくる サポートスキルが";
    text[1281] = "3つとも全部 同じだったとき～！";
    text[1323] = "(この投稿は どうやら バズッたようだ)";
    text[1165] = "キングネット";
    text[1204] = "RE: だれか きもちわかる？";
    text[1282] = "草";
    text[1166] = "ヘーゼル";
    text[1205] = "バイトだらけ";
    text[1283] = "いつも レゴリシアの 洞窟に バイトが 落ちてるのを 見かけます";
    text[1284] = "大した額じゃないけど 場所が わかれば なかなか おトクですよ";
    text[1285] = "ああ これやっぱり 書かない方が 良かったかな...";
    text[1167] = "タナカ";
    text[1206] = "ふねのアップグレード";
    text[1286] = "みんな コペルニクスの店に 寄ったことある？  昨日 船をアップグレードしたけど";
    text[1287] = "すごくカッコよくなって... まあ 1000ギガバイト かかったけど！";
    text[1288] = "でも その価値は あったよ";
    text[1168] = "コハク";
    text[1207] = "まよいねこ";
    text[1289] = "どなたか 最近 飼い猫が 迷子に なった方 いませんか？";
    text[1290] = "ワタシは バリア施設で 働いていますが 家に帰る 途中";
    text[1291] = "宇宙服を着た ぽっちゃりした 猫ちゃんが 飛んでいるのを 見ました！";
    text[1324] = "夢かと思い 頬を つねってみましたが やはり現実でした";
    text[1169] = "ルナーフォース";
    text[1208] = "しんじんぼしゅう！";
    text[1292] = "現在 ルナーフォースは 新しい 隊員となる方を 募集しています！";
    text[1170] = "レックス";
    text[1209] = "RE: しんじんぼしゅう！";
    text[1293] = "もしかして ルナーフォースに 入ったら ガンセイバーが もらえたりする？";
    text[1171] = "ネビュロイド";
    text[1210] = "ガンセイバー";
    text[1294] = "ガンセイバーの 刃と弾には プラズマが 埋め込まれている";
    text[1295] = "マークとの戦いを 想定して デザインされて いるからだ";
    text[1296] = "ウワサでは ルナー研究所は バトルロボットの 技術を 取り入れ";
    text[1297] = "反物質コアを 動力とする 新しい 対マーク兵器を 開発中らしい";
    text[1172] = "ルナーフォース";
    text[1211] = "おい マークスレイヤー！";
    text[1298] = "指名手配犯: マークスレイヤー\n本名: 不明\n年齢: 20代";
    text[1299] = "この仮面に ビビッと きた方は すぐに ルナーフォースまで ご連絡を！";
    text[1173] = "ゼータマン";
    text[1212] = "RE: おい マークスレイヤー！";
    text[1300] = "ぶっちゃけ こいつは ルナーフォースに 引き入れた方が いいと思う";
    text[1301] = "ちょっと 犯罪したから 何？";
    text[1302] = "マークを 倒すことなら コイツが 最強じゃん";
    text[1303] = "ただ 目立たないように コソコソ してんのは よくわからんけどね";
    text[1174] = "OGジョニー";
    text[1213] = "ながれぼし";
    text[1304] = "願いを叶えたいって？  そんなキミは 空に流れ星が 見えたら [Z] を押そう";
    text[2548] = "願いを叶えたいって？  そんなキミは 空に流れ星が 見えたら [X] を押そう";
    text[2549] = "願いを叶えたいって？  そんなキミは 空に流れ星が 見えたら [A] を押そう";
    text[1175] = "テトラ";
    text[1214] = "ラックスコンボレシピ";
    text[1307] = "こんにちは テトラです  どなたか 珍しい ラックスコンボを 知っている 方は いませんか？";
    text[1305] = "エヘヘ 優秀な アシスタント・ロボは 現場だけじゃなく";
    text[1306] = "それ以外のことでも アシスト するんだからね！";
    text[1176] = "オウロ";
    text[1215] = "RE: ラックスコンボレシピ";
    text[1308] = "ああ なるほどね\nなら ホロハリケーンとか どう？";
    text[1309] = "2つの ホロシールドと 剣を使った アクティブスキルを 組み合わせてごらん！";
    text[9362] = "ルナーの 掲示板だ！";
    text[9363] = "コペルニクスの 掲示板だ！";
    text[9364] = "エメット";
    text[9365] = "てんもんがくしゃクラブ";
    text[9366] = "ごきげんよう 星空を 愛する 皆さん！";
    text[9367] = "このエメットが 星を見るのに うってつけの スポットを ご紹介します！";
    text[9368] = "望遠鏡を 持って ティコに 行きましょう！";
    text[9389] = "チャド";
    text[9390] = "オレって ひどいやつかな？";
    text[9391] = "この前 彼女と デートに 行ったんだけど...";
    text[9392] = "書き込みは ここから 何十行も 続いている";
    text[9393] = "うんざりして 途中で 読むのをやめた";
    text[9394] = "モデレーター";
    text[9395] = "RE: オレって ひどいやつかな？";
    text[9396] = "チャドさん あなたのした 書き込みは ルナー掲示板の 規約に 反しています";
    text[9397] = "そうした話題に ついては 別の 専用掲示板が 用意されています";
    text[9398] = "なので ここに あなたの 個人的な 悩みを 書き込むことは  おやめください";
    text[9419] = "ホイットニー";
    text[9420] = "モーモーミルク";
    text[9421] = "最近 牛乳の 値段が ずいぶん 上がったと 思わない？";
    text[9422] = "値札を 見ると びっくりしちゃうわ！";
    text[9423] = "モーティー";
    text[9424] = "RE: モーモーミルク";
    text[9425] = "牛乳だけ じゃないよ... ケプラー牧場は 近頃";
    text[9426] = "マークの せいで 食料生産問題に 直面しているんだ...";
    text[9427] = "まあ... それよりも 前から 食料の供給は 課題だったけど";
    text[9428] = "今はもっと ひどくなってるのさ！";
    text[9465] = "セシル";
    text[9470] = "なぞのこえ";
    text[9466] = "この前 3階の 管制センターに 向かって 歩いていたら";
    text[9467] = "突然 小さな声が 聞こえてきたの";
    text[9468] = "とても 奇妙な 機械音 みたいな 声よ";
    text[9469] = "どこから 来ているのか 辺りを 見回してみたけど... さっぱり わからなかったわ";
    text[9527] = "ルナーけいじばん";
    text[9528] = "ERROR 404";
    text[9529] = "あれ 何か おかしいわね...";
    text[9530] = "いつもなら この掲示板は 数百件の 新しい投稿が あるのに";
    text[9531] = "どうやら 科学者たちは 調査に 追われて サーバーに 負荷を かけすぎたようね";
    text[9532] = "あらあら...";
    text[9533] = "こういう掲示板は コペルニクス ティコ シリカにも あるわ！";
    text[9534] = "今度 行くことが あったら そっちも 見てみましょう！";
    text[9369] = "足元に 気を付けつつ シリカ峡谷に 行きましょう！";
    text[9378] = "ゆくえふめいしゃ いちらん";
    text[9379] = "この投稿には 最新の";
    text[9380] = "行方不明者の 個人名が 並んでいる...";
    text[9381] = "これらの 人々について 情報を お持ちの方は";
    text[9382] = "ただちに ルナーフォースまで ご連絡ください";
    text[9373] = "セバスチャン";
    text[9374] = "トレジャーハンターギルド";
    text[9375] = "トレジャーハンターギルドは 現在 新メンバーを 募集しています！";
    text[9376] = "興味のある方は シリカにいる リーダーの フォーチュノまで ご連絡ください";
    text[9384] = "ジェイソン";
    text[9385] = "グランドオープン！";
    text[9386] = "ロボット好きな そこのあなた 朗報です！";
    text[9388] = "ティコにある 「ブランク・ロボティクス」まで ぜひ一度 お立ち寄りください！";
    text[9444] = "セレニティ";
    text[9445] = "サロス ファンクラブ";
    text[9446] = "サロス将軍って 史上最年少で ルナーフォースの";
    text[9447] = "将軍になった 人なんですって";
    text[9448] = "ルナーの伝説の ヒーローでありながら 若干28歳なのよ！";
    text[9449] = "ジョーイ";
    text[9450] = "RE: サロス ファンクラブ";
    text[9451] = "サロスとかいう 真の漢よ...";
    text[9452] = "ところでさ ヴィヴィア司令官について みんな 何か知ってる？";
    text[9453] = "あの人の ファンクラブも 作りたいんだけど...";
    text[9496] = "バトル Wiki";
    text[9497] = "ステータスこうか";
    text[9498] = "敵に与えられる ステータス効果は 以下の3種類...";
    text[9499] = "「スタン」 「やけど」 「びしょぬれ」です！";
    text[9500] = "スタン状態の敵は 1ターン 行動できません！";
    text[9501] = "やけど状態の敵は 一定のターン数 HPを失います";
    text[9502] = "そして びしょぬれ状態の 敵を攻撃すると";
    text[9503] = "ラックスメーターが 通常より 多く上がります";
    text[9412] = "オウロ";
    text[9413] = "ラックスコンボ トリビア";
    text[9414] = "おもしろトリビア！";
    text[9415] = "ラックスコンボは 全部で 30種類ある！";
    text[9416] = "そのうちの 3分の1は 割と 簡単に 覚えられる";
    text[9417] = "同じ種類の 技を 3つ選ぶだけ だからね！";
    text[9418] = "ただ 残りの 3分の2は... ちょっとした 実験を 求められるんだ";
    text[9371] = "防寒ジャケットを 着て ピトン山に 行きましょう！";
    text[9372] = "流れ星は あっという間に 現れて 消えるでしょう！";
    text[9434] = "ガムドロップ";
    text[9435] = "お気に入りの アクティブスキルが あるんだけどさ...";
    text[9436] = "SPコストが 高すぎるんだよ！";
    text[9437] = "それで 思ったんだけど アクティブスキルの SPコストを 下げる方法って あんの？";
    text[9430] = "RE 1: ガムドロップ";
    text[9431] = "ガムドロップを使おう\nアクティブスキルの コストを";
    text[9432] = "永久的に 5下げられるよ";
    text[9438] = "RE 2: ガムドロップ";
    text[9439] = "調べたけど ガムドロップって かなりの レアアイテム みたいだな！";
    text[9440] = "キングネットさん アンタは 使ったことが あるみたいだけど...";
    text[9441] = "ひょっとして 余ってるのとか ないかな？";
    text[9442] = "RE 3: ガムドロップ";
    text[9443] = "ゴメン ないわ";
    text[9515] = "モモ";
    text[9516] = "エコー！";
    text[9517] = "昨日 宇宙猫の エコーが マラソントレーニング中の ワタシを";
    text[9518] = "励ましてくれたの！\n猫って 本当に いい生き物よね！";
    text[9519] = "コハク";
    text[9520] = "RE 1: エコー！";
    text[9521] = "もし よかったら エコーが いた場所 教えてくれない？";
    text[9522] = "RE 2: エコー！";
    text[9523] = "昨日 見た場所は シリカの カフェの 近くよ";
    text[9524] = "おとといは コペルニクスの 上空を 浮かんでいたわ";
    text[9525] = "...でもね あの子を 初めて 見たのは このティコよ！";
    text[9526] = "掲示板を チェックしてた ワタシの 真上に 浮かんでたの";
    text[9400] = "Mr.エリア51";
    text[9401] = "ぐんじきち";
    text[9402] = "この前 荒野ゾーンを 探索してて 思ったんだけど";
    text[9403] = "軍事基地の 近くに ジェットパッドが ないのは なんでなん？";
    text[9404] = "リク";
    text[9405] = "RE 1: ぐんじきち";
    text[9406] = "キミは 多分 ジェットスーツで 軍事基地の 周辺を 飛べるかを 知りたいんだろうけど...";
    text[9407] = "それを 許すと セキュリティリスクが 上がるだろ？";
    text[9410] = "第一 軍事基地の 周囲を飛んで 何をしたいんだよ？";
    text[9411] = "ルナーフォースに 見つかったら ヤバイことに なるぞ！";
    text[9540] = "RE 2: ぐんじきち";
    text[9409] = "Mr.エリア51さん... 少し 話を しましょうか";
    text[9370] = "水着を着て ハーモニアリーフに 行きましょう！";
    text[9455] = "はいいろの マークスポット";
    text[9456] = "冒険していて 灰色の マークスポットを 見つけたら...";
    text[9457] = "気をつけてください！";
    text[9458] = "この前 友達が それを触って 色違いの マークに";
    text[9459] = "遭遇したんですが 命からがら 逃げたそうです...";
    text[9460] = "そうした マークは ごく最近 現れ始めた もので";
    text[9461] = "まだ ルナーフォースも 多くのデータは 持っていない ようですが...";
    text[9462] = "どうやら そうしたものは 「EXマーク」 と 分類されて いるようです";
    text[9463] = "EXマークは 通常の ものよりも より強力で より素早く なっています...";
    text[9464] = "皆さん 冒険の際は このことを くれぐれも お忘れなく！";
    text[9472] = "ヒミツのしょうごう";
    text[9473] = "今 すべての ヒミツの称号を 手に入れるという ミッションの 途中なんだけど...";
    text[9474] = "その取り方を 知ってる人が いたら";
    text[9475] = "教えてください！  お願いします！";
    text[9477] = "RE 1: ヒミツのしょうごう";
    text[9504] = "いや それ 言っちゃったらさ...";
    text[9505] = "「ヒミツの」って つけてる 意味なくね？";
    text[9506] = "まあ... ヒントくらいなら 書いても いいのかね...";
    text[9507] = "じゃあ オレからは ズバリ... 「石」！";
    text[9479] = "RE 2: ヒミツのしょうごう";
    text[9508] = "じゃあ 別のヒント 「ゴミ箱」！";
    text[9481] = "RE 3: ヒミツのしょうごう";
    text[9509] = "なんか 犬を なでると いいこと あるらしいよ...";
    text[9513] = "メロディー";
    text[9483] = "RE 4: ヒミツのしょうごう";
    text[9510] = "カワイイ ぬいぐるみ！";
    text[9485] = "RE 5: ヒミツのしょうごう";
    text[9511] = "ガムドロップ";
    text[9514] = "エミリーネーター";
    text[9487] = "RE 6: ヒミツのしょうごう";
    text[9512] = "ボンジュール！  できるだけ 早く ワタシに 会うこと デース！";
    text[9541] = "Dr. ネクサス";
    text[9489] = "RE 7: ヒミツのしょうごう";
    text[9490] = "では ワシから... 「溶岩と砂時計」！";
    text[9491] = "RE 8: ヒミツのしょうごう";
    text[9492] = "コミュニティの 皆さんが 協力してるのは いいことですね";
    text[9493] = "それじゃあ 自分からも...";
    text[9494] = "1000オーバー！";
    text[9495] = "では グッドラック！";
    text[1361] = "ナイラは 取り付け作業で 忙しそうにしている";
    text[1362] = "まずは メットと 話した方が 良さそうだ";

    text[5546] = "汝 七人の 英雄の 意志を継ぎ...";
    text[5547] = "...宇宙に 安定を もたらすべし";
    text[5439] = "この石板は レリックソードという 古代の武器を 利用した";
    text[5440] = "戦闘技術を 説明している";
    text[5441] = "その剣は 人間の ラックスを 結びつけて 特殊な技に 昇華させる";
    text[5433] = "赤の レリックソードは 力を 授け";
    text[5434] = "青の レリックソードは ラックスを 高め";
    text[5435] = "黄の レリックソードは 守りを 強化す";
    text[5581] = "レリックソードを 応用するには";
    text[5582] = "異なる 宝石を 組み合わせ より 大きな力を 得るべし";
    text[5436] = "橙の レリックソードは SPを 回復し";
    text[5437] = "緑の レリックソードは HPを回復し";
    text[5438] = "紫の レリックソードは 敵を 一撃で倒す";
    text[5534] = "光の戦士 我らの天を貫く ルミナイト";
    text[5535] = "ラックスは 魂の現れ";
    text[5536] = "戦士は その使い方を 学ぶべし...";
    text[5537] = "世界を 変える力は そこにあり...";
    text[5538] = "反物質は 混沌とした 霊的な 宇宙の力";
    text[5539] = "永遠は 手の届く ところにあり...";
    text[5542] = "その領域に 行くことは もはや 安全でなし...";
    text[5543] = "我らは 進化するか...";
    text[5544] = "さもなくば 立ちはだかる 宇宙の 力により";
    text[5545] = "永久に 滅び去るであろう...";
    text[5548] = "封印は 破れたり";
    text[5549] = "古代の剣は 汝のものに なりにけり";
    text[5556] = "ルナー バトルロボット... ここに 眠る";
    text[5557] = "ル...ナ...ー...";

    text[446] = "あら ひょっとして ルナーパネルの 話が 聞きたいの？";
    text[447] = "ええっと... そういうのは また今度にするわ";
    text[448] = "よろしい！\nなら 喜んで 説明するわ！";
    text[449] = "ルナーパネルは 太陽光パネルが 数百年にわたり";
    text[450] = "克服できなかった 課題を 解決したのよ";
    text[451] = "このパネルは 太陽光と 暗闇の 両方の条件下で 発電できるのよ！";
    text[452] = "ええ！？  暗闇から エネルギーを 作るの？";
    text[453] = "ええっと... それは ちょっと 違うわね";
    text[454] = "ルナーパネルは 気温の低い夜に";
    text[455] = "周囲との温度差を 利用して 発電するのよ";
    text[456] = "ルナーは 昼と夜を 14日周期で 繰り返すわ";
    text[457] = "それは つまり 夜になると あの青い太陽から 14日間も 遠ざかるってこと";
    text[458] = "その間 どうやって 電気を まかなうのかは かつて 深刻な問題だったの";

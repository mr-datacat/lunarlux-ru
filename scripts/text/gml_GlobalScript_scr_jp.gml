    text[991] = "あれ テトラ どこ行ったの！？";
    text[992] = "テトラーーーーーー！！！";
    text[993] = "...ここはどこ？";
    text[994] = "夢の中かしら？";
    text[995] = "いいえ それにしては リアルすぎる";
    text[996] = "なら...";

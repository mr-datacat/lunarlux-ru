    text[1003] = "テトラ！\nああ～ 無事で 良かったわ！";
    text[1004] = "ベラ！  もう 本当に メチャクチャ 心配したんだから！！";
    text[1005] = "さっき メットの船を 襲ったマークを 検出したと 思ったら";

    text[2085] = "ただし 同チップは 現状 世に 1つしかないので 非常に貴重な 代物と言えよう！";
    text[2086] = "これらの ガンセイバーは トレーニングで 使われる  青いセイバーは 特に レアだ！";
    text[2087] = "たくさんの スタングレネードが 置かれている";
    text[2088] = "予備の ユニフォームを 忘れたなら ここから 持っていこう！";

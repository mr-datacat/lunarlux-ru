    text[10503] = "ああ レイン どうしたの？";
    text[10504] = "今日は 何か 予定でも あるかしら 天才ちゃん？";
    text[10505] = "そうねえ...";
    text[10506] = "ミッション掲示板を チェックしてみるわ";
    text[10507] = "でも どうして？";
    text[10508] = "あのねえ だったら こっちに 付き合いなさい！";
    text[10509] = "なぜかって これから レイン隊主催の ビーチパーティを やるからよ！  ガッハッハッハ！";
    text[10510] = "あら それは 楽しそうね！";
    text[10511] = "ニックル テトラ あなたたちも 行く？";
    text[10512] = "ビーチパーティ！？  もちろん行くわよ！";
    text[10513] = "このクールな グラサンを お披露目する チャンスが ようやく きたわね エヘヘ";
    text[10514] = "オレは正直 レインが お前と 戦うために";
    text[10515] = "それらしい理由を つけてる ようにしか 思えないんだがな...";
    text[10516] = "ガッハッハ！  そりゃどうかしらね！";
    text[10517] = "まあ それはともかく ビーチで まったり 過ごすのも 悪くは なさそうだ";
    text[10518] = "そう来なくっちゃ！";
    text[10519] = "なら 夏の入り江に 来てちょうだいね！  オシアナスの 北にある 小さな 砂浜よ！";
    text[10520] = "...あと 日焼け止めも たっぷり 持ってくるように！";
    text[10522] = "で どこで パーティを やるって？";
    text[10523] = "こっちよ！";
    text[10524] = "ボンッ";
    text[10525] = "どうやら 全員 そろってる みたいね！";
    text[10526] = "パーティ会場は あっちよ！";
    text[10527] = "ああ メロディーに ザラ！";
    text[10528] = "今日は チーズケーキバーは 持ってきたんでしょうね？";
    text[10529] = "もちろんよ！  それだけじゃなくて いろんな お菓子を 持ってきてるわ エヘヘ！";
    text[10530] = "...あとは おっきな 浮き輪もね。";
    text[10531] = "うう ありがとう...！";
    text[10532] = "それじゃあ... お日様の下で ガッツリ 楽しむわよ！  イヤッホー！";
    text[12140] = "こんなに キレイな ビーチが ルナーに あったなんて 知らなかったわ";
    text[12141] = "オレもだ  ヤシの木まで あるなんて びっくりだな";
    text[12153] = "そもそも ルナーで 生育できるとも 思ってなかったし...";
    text[12142] = "ああ そのヤシの木は 本物じゃないわ  ただの 模型よ";
    text[12143] = "ええ... マジなの！？";
    text[12149] = "マジよ！";
    text[12150] = "どうして そんなこと 知ってるのかって 顔してるけど...";
    text[12144] = "この 夏の入り江は... 死んだ おじいちゃんが よく訪れてた 場所だからよ";
    text[12145] = "あの人は 歴史の本で 読んだ テラ風の キレイな 砂浜を 再現し";
    text[12146] = "家族みんなの 憩いの場に することが 夢だったのよ";
    text[12147] = "だから その遺志を継いで";
    text[12148] = "ワタシが 友達と 楽しい思い出を 紡いでいこうと 思ってね";
    text[12151] = "お前の じいさんは 実に いい仕事を したと思うぜ レイン";
    text[12152] = "こんな 見事な砂浜 苦労して 作ったただろうに... でも それだけの 価値は あるってもんだ";
    text[12154] = "時々 訪れて キレイなビーチを しっかりと 守っていきましょうね！";
    text[12155] = "ええ そのたびに ちょっぴり リラックスするのも 良さそうね";
    text[12156] = "ウフフッ... そう言ってくれると うれしいわ";
    text[12157] = "クスクス";
    text[12158] = "えっ？  どうして アンタたち 笑ってるわけ？";
    text[12159] = "いやあ こんな しんみりした レインなんて 見たことが ないもの";
    text[12160] = "しんみり！？  ワタシが！？  ん～ そりゃ たまにはね！";
    text[12161] = "ガッハッハッハ！";
    text[12162] = "ああ あっという間に いつものレインに 戻ったわ";
    text[12163] = "まあ らしいと言えば そうだけど";
    text[10533] = "ようし それじゃあ これから お待ちかねの メインイベントよ！";
    text[10534] = "メインイベント ですって！？  一体何を 用意してきたわけ？";
    text[10535] = "浮き輪を持って ついてきなさい！";
    text[10536] = "ジャジャ～ン！";
    text[10537] = "水しぶき舞う！";
    text[10538] = "ワイルドな！";
    text[10539] = "レイン隊 主催の サーフィン大会 「ウェーブ・ウォーター」よ！";
    text[10540] = "わあ！  なんだか すごく楽しそうな コースね！";
    text[10541] = "あなたたち 一体 どれくらいの 時間をかけて これを 準備したわけ？";
    text[10542] = "実のところ そこまででも ないわよ";
    text[10543] = "ドローンを たくさん 使ったからね";
    text[10544] = "ウェーブ・ウォーターは エンドレスな 障害物コースとして デザインされてるわ";
    text[10545] = "目標は チーズケーキバーを 集めつつ できるだけ長く サーフィンを 続けること！";
    text[10546] = "...そして より多く チーズケーキバーを 集めたチームが 景品を ゲットするのよ！";
    text[10547] = "浮き輪は 5回ダメージを 受けたら 破裂するから 覚えておいてね";
    text[10548] = "ちょっと待って... あれ 本物の チーズケーキバーなの？";
    text[10549] = "いいえ ただの ホログラムよ";
    text[10550] = "でもね ドローンは 重いものも いっぱい 運んでくれたわ";
    text[10551] = "だから 水面の岩は 本物で ぶつかったら とっても 痛いわよ！";
    text[10552] = "ええ 結構 ガチなのねえ...";
    text[10553] = "...それで こっちが 負けたら どうなるわけ？";
    text[10554] = "その時は ワタシたちと バトルするのよ！  ガッハッハッハ！";
    text[10555] = "ああ やっぱり...";
    text[10556] = "なんか 話が うますぎると 思ったんだよな";
    text[10557] = "結局は 裏があったと 言うわけか...";
    text[10558] = "あのねえ ワタシは ただ パーティと スパーリング 両方やりたいだけなの わかる？";
    text[10559] = "レインって いつも こんな感じなのか？";
    text[10560] = "ええ いつもよ！";
    text[10561] = "...で お前らも こいつの 計画に 乗ったと？";
    text[10562] = "まあ レインの 言う通りにしたら なんか 盛り上がるのは 間違いないからね！";
    text[10563] = "そういうこと";
    text[10564] = "それじゃあ 真の パーティタイムの 幕開けよ！  心して ウェーブ・ウォーターに 挑みなさい！";
    text[10565] = "ウェーブ・ウォーター ミニゲーム";
    text[10566] = "ジャンプ";
    text[10567] = "いどう";
    text[10569] = "あああっ そんな！？";
    text[10570] = "チーズケーキバー 1個差で 負けるなんて！！";
    text[10571] = "あ～ 楽しかった！";
    text[10572] = "そうねえ！  もう1回 やりたいわあ！";
    text[10573] = "もう1回どころか 何回やっても いいのよ テトラ";
    text[10574] = "それで 景品ってのは 何なんだ？  さっき 言ってたよな？";
    text[10575] = "エッヘッヘ...";
    text[10576] = "ヘッヘッヘッヘ...";
    text[10577] = "ガーッハッハッハ！";
    text[10578] = "まさか... ";
    text[10579] = "景品ってのはね...";
    text[10580] = "...レイン隊との リマッチよ！";
    text[10581] = "...そうかい";
    text[10582] = "なら とっとと カタを つけてやるよ！";
    text[10583] = "ちょうど トレーニングを やりたかった とこだしな";
    text[10584] = "ワタシもよ！";
    text[10585] = "チャンピオンは いつ いかなる時も 誰の挑戦も 受けるのよ！";
    text[10586] = "前回は やられたけど 今回は そうカンタンには いかないわよ...";
    text[10587] = "...みっちりと 鍛え上げて きたからね！  ゼッタイに 引かないわ！";
    text[10588] = "どうやら レインの ファイティング スピリットが あなたにも 伝染したようね メロディー";
    text[10589] = "ベラ あなたも ルナーフォースの 新しい 将軍として 良き トレーニング相手が 必要よ";
    text[10590] = "己の限界を 押し上げ 新たな 高みに 導いてくれる 相手がね";
    text[10591] = "だから あなたが 望むなら 何度でも スパーリングしてあげるわ";
    text[10592] = "もちろん あなたたちに 勝る トレーニング パートナーなんて いないわ...";
    text[10593] = "ニックル... テトラ...";
    text[10594] = "行くわよ！";
    text[10595] = "うう... 本当に... すごかったわ！";
    text[10596] = "負けたのは 悔しいけど...";
    text[10597] = "覚えておきなさい... いつの日か レイン隊が アンタを 倒すんだからね！";
    text[10598] = "あなたたち 3人の ダイナミックな チームワーク... 見事だわ！";
    text[10599] = "ああ アイシングは ないかしら... 痛いわ...";
    text[12116] = "ベラ 景品代わりと 言っては アレだけど... これ あげるわ";
    text[12118] = "ええ？ 何これ？";
    text[12119] = "ワタシたちからの ささやかな 贈り物よ...";
    text[12122] = "...親愛なる 天才ちゃん 宛てのね ガッハッハッハ！";
    text[12117] = "ああ ありがとう！  やっぱり あなたたちって  サイコーの 友達だわ！";
    text[12123] = "数時間後...";
    text[10600] = "さて 今日は この辺で お開きに しましょうかね";
    text[10601] = "パーティを 開いてくれて どうもありがとう  本当に 楽しかったわ！";
    text[10602] = "どういたしまして！";
    text[10603] = "人生って バランスが 大事よね";
    text[10604] = "最近 あまりにも いろんなことが あったから";
    text[10605] = "たまには こういう くつろげる日が あっても いいと思うわ";
    text[10606] = "そうね！";
    text[10607] = "それじゃあ お家に 帰りましょ！";
    text[10608] = "ビーチエピソード 完！";
    text[10615] = "どうしたの ベラ？  また レイン隊と リマッチ したくなったわけ？";
    text[10616] = "戦う！";
    text[10617] = "また今度...";
    text[10618] = "それじゃあ お望み通り ボコボコに してあげるわ！";
    text[10619] = "M-07: マグネシアの かいぶつ";
    text[10620] = "現在は 無人の セクター マグネシアの 境界付近を パトロールしていた";
    text[10621] = "兵士たち 3人から 救援信号が 送られてきたわ";
    text[10622] = "彼らが言うには 目撃したのは マークとは 異なる見た目の";
    text[10623] = "「奇妙な怪物」 だそうよ";
    text[10624] = "ただ その連絡の 直後に 通信が 途絶えてしまったの";
    text[10625] = "あなたの ミッションは マグネシアの 怪物について 調査し";
    text[10626] = "ルナーフォースの 兵士を 救出することよ";
    text[10768] = "マグネシアか...";
    text[10769] = "シリカの コロニーに 行く途中の 道から";
    text[10770] = "遠くに見える セクターね";
    text[10771] = "公式記録によると マグネシアの 突然の破壊は";
    text[10772] = "ものすごく強力な マークによって 引き起こされた ものだそうよ...";
    text[10773] = "ウーン...";
    text[10774] = "どうした ベラ？";
    text[10775] = "兵士が 通信で言った 「怪物」と マグネシアを 破壊した 「マーク」に";
    text[10776] = "何か関係は あるのかしら...？";
    text[10777] = "その姿を 見た人は？  ていうか 最近の 目撃情報とかは ないのかしらね？";
    text[10778] = "あのな マグネシアの件は はるか前に 起きた話だぞ...";
    text[10779] = "当時の情報が 今さら わかるとは 思えないが...";
    text[10780] = "ウーン...";
    text[10781] = "まあ もしそれが あるとすれば...";
    text[10782] = "サロスの ヒミツの サーバーでしょうね";
    text[10783] = "つまり サロスが マグネシアの件の";
    text[10784] = "記録を 持っていると 言うことか？";
    text[10785] = "公式記録では マーク関連事件に なっているわ...";
    text[10786] = "なら かなりの 確率で あるでしょうね...";
    text[10787] = "今回の 「マグネシアの 怪物」 とやらも サロスの 実験の 産物かもしれない";
    text[10788] = "何年にも渡って いろんなことを 影でやってた 人なんだから...";
    text[10789] = "その辺を 調べてみても 損はないはずよ";
    text[10790] = "...そうだな";
    text[10791] = "...で ヒミツの サーバーには どうやったら アクセス できるんだ？";
    text[10792] = "ナイラさんに 聞いたら わかるはずよ  今は データ分析の チームで";
    text[10793] = "ヒミツの サーバーの 全ファイルの 抽出を しているから ";
    text[10794] = "マグネシアに 行く前に ナイラさんから 話を聞きましょ";
    text[10795] = "そうね！  あの人は ネクサス・ラボに いるはずよ！";
    text[10796] = "こんにちは ナイラさん";
    text[10797] = "あら 久しぶりね  何か用かしら？";
    text[10798] = "ワタシたちは今 廃セクターの マグネシアで 目撃された";
    text[10799] = "謎の モンスターについて 調べているの";
    text[10800] = "もうすぐしたら 行方不明になった 兵士たちの 捜索に 乗り出す予定よ...";
    text[10801] = "でも その前にね...";
    text[10802] = "マグネシアと 例の事件 あとは マークの 目撃報告に 関して";
    text[10803] = "サロスが 隠し持っていた ファイルがあれば";
    text[10804] = "ワタシに 送ってくれる？";
    text[10805] = "しっかりと 準備を 整えてから ミッションに 臨みたいの";
    text[10806] = "ええ お安いご用よ！";
    text[10807] = "でも マグネシアの 兵士救出には すぐ向かった方が いいわ";
    text[10808] = "何か 関係するファイルが 見つかったら 直接テトラに 送るわね";
    text[10809] = "ありがとう ナイラさん！";
    text[10810] = "それじゃあ みんな マグネシアに 行くわよ！";
    text[10701] = "マグネシアに 行くには";
    text[10702] = "「棄てられた道」を 進むしかないわ";
    text[10703] = "覚悟は いいかしら？";
    text[10704] = "一旦 進んだら ミッションに 集中するのよ";
    text[10705] = "ルナーフォースの 仲間を 救えるのは ワタシたちだけ なんだからね！";
    text[10706] = "準備オーケー！";
    text[10707] = "まだ 準備できてない...";
    text[10708] = "それじゃあ 行くわよ！\nレッツ ゴー ゴー ゴー！";
    text[10709] = "... ... ...";
    text[10710] = "ニックル 大丈夫？";
    text[10711] = "お おう... 何で そんなこと 聞くんだ？";
    text[10712] = "だって 何だか 緊張してそうだから...";
    text[10713] = "...んなことねえよ\n行くぞ";
    text[12211] = "この道... 思ったより ひどいわねえ...";
    text[12212] = "かつては マグネシアと シリカをつなぐ 重要な道で";
    text[12213] = "多くの人で にぎわっていた そうだけどね...";
    text[12214] = "でも... 今は 放棄されて 忘れ去られている... だからこそ";
    text[12215] = "ここは ルナーの データベースで 「棄てられた道」と 呼ばれてるのよ";
    text[12216] = "ええっと... ベラ？";
    text[12217] = "どうしたの テトラ？";
    text[12218] = "何か いるわ！";
    text[12219] = "あれが きっと 例の 「怪物」ね";
    text[12220] = "マークかしら？";
    text[12221] = "さあ... なんだか そうは 見えないけど";
    text[12222] = "まあ 何であれ... 人間でないことは 確かでしょうね";
    text[12223] = "近づいて みないと 何とも 言えないけど";
    text[12224] = "追いかけるわよ！";
    text[12225] = "ええ！";
    text[12226] = "... ... ...";
    text[10627] = "どうやら 手遅れだったようね...";
    text[10628] = "もう 死んでるわ...";
    text[10629] = "ベラ 敵が 近づいてくるわよ！";
    text[10630] = "グオオ... グオオオ... グオオオオオ！";
    text[10631] = "ちょっと待った... これは 太古の存在よ！";
    text[10632] = "ええ 本当に？";
    text[10633] = "多分だけど...";
    text[10634] = "ラックスの フンイキが ガーディアや ルミックナイトと 似ているもの...";
    text[10635] = "でも 何か 変な 感じが するのよね...";
    text[10636] = "...なんというか 「腐っている」 感じというか...";
    text[10637] = "太古の存在は こっちの味方だと 思ってたけど...";
    text[10638] = "...どうして 何の罪もない 人たちを 殺したのかしら...";
    text[10639] = "それは わからないけど... 放っておくわけには いかないわ！";
    text[10640] = "倒れた仲間たちの 仇を 取るのよ！";
    text[10641] = "さあ 準備は いいかしら？";
    text[10642] = "ガーディア！？";
    text[10643] = "ゴキゲンヨウ ソウルセンサーヨ...";
    text[10648] = "ガーディア 一体ここで 何があったわけ？";
    text[10649] = "太古の存在が ワタシたちの 仲間を 襲ったようだけど...";
    text[10650] = "何かが おかしかった...";
    text[10651] = "彼らから 純粋な 悪意のようなものを 感じたもの...";
    text[10861] = "ワレラ ガーディアンノ ヒトハシラガ";
    text[10862] = "フタタビ メザメタ...";
    text[10863] = "...ソノナハ 「ネクロミア」";
    text[10873] = "ネクロミア...";
    text[10874] = "その名が 書かれた 古代の碑文を 読んだことがある...";
    text[10875] = "確か 人の心を 操る能力を持つ ガーディアン... だったはずだ";
    text[10876] = "心を操る！？\nそれ 本当なわけ！？";
    text[10877] = "ソノトオリ";
    text[10864] = "...ソシテ リユウハ ワカラナイモノノ";
    text[10865] = "ネクロミアノ プログラミングハ クルッテ シマッタ";
    text[10866] = "ソノゴ スベテノ ネクロミアノ テシタ タチモ オナジヨウニ クルッタノダ";
    text[10868] = "狂った 太古の存在... どうしてそんなことが？";
    text[10869] = "ザンネン ナガラ ワレニモ ワカラヌ...";
    text[10867] = "タダヒトツ ワカルノハ...";
    text[10870] = "ネクロミアハ ワレヨリモ ハルカニ キョウリョクデ アルコト...";
    text[10878] = "ソシテ...";
    text[10871] = "ルナーヲ スクウノ デハナク";
    text[10879] = "ハカイ シヨウト シテイル コト";
    text[10872] = "ワレモ カラダガ ナクテハ ネクロミアヲ トメルコトハ デキヌ...";
    text[10880] = "...ソレユエニ オマエノ ジョリョクヲ モトメタイ";
    text[10665] = "もちろんよ ガーディア！";
    text[10666] = "これ以上 ネクロミアの 被害者を 増やすわけには いかないもの！";
    text[10667] = "ナラバ イソグノダ...";
    text[10812] = "ガーディア？";
    text[10813] = "どうしたっていうの！？";
    text[10821] = "ジカンガ ナイ...";
    text[10814] = "ワレハ... ジキニ キエル...";
    text[10815] = "アトハ... マカセタゾ...";
    text[10816] = "ベラ・グレイヨ";
    text[10817] = "ラックスノ チカラニ フカノウハ ナイ...";
    text[10818] = "ツカウノダ...";
    text[10819] = "ワレラノ ホシヲ... マモルタメ...";
    text[10645] = "ガーディア...";
    text[10646] = "今まで ありがとう...";
    text[10647] = "ママに 会えたのも\nソウルが 目覚めたのも ";
    text[10822] = "あなたの おかげよ";
    text[10820] = "あなたの 優しさも 最後の 言葉も ゼッタイに 忘れないわ...";
    text[10823] = "...さあ 進みましょう";
    text[10860] = "すべてが 手遅れになる前に ネクロミアを 探し出さないと！";
    text[10827] = "待て...";
    text[10828] = "この先に 進むのが いい考えだとは 思えない";
    text[10829] = "ええ どうして！？";
    text[10830] = "ワタシたち チームでしょ？";
    text[10831] = "別々に 行動するよりも 力を合わせた方が うまくいくはずよ...";
    text[10832] = "それは わかってるが... ここは オレに 任せてくれ...";
    text[10833] = "ガーディアの話を 聞いただろ？  ネクロミアは 人の心を 操るって...";
    text[10834] = "...お前たち 2人を キケンな目に あわせるわけには いかないからな";
    text[10835] = "だから オレ1人で やるんだ...";
    text[10845] = "ここが マグネシアなら なおさらさ...";
    text[10837] = "ニックル...";
    text[10836] = "あなた ここに来てから ほとんど何も しゃべらないけど";
    text[10838] = "...何か 隠してるわけ？";
    text[10725] = "それを 言ったら お前はきっと オレを 赦さないだろう...";
    text[10839] = "あのねえ ニックル\nはっきりと 言うわ";
    text[10840] = "あなたを 独りきりには しない";
    text[10841] = "...お前は 何も わかっちゃいない";
    text[10842] = "すべてを 明かしたら... お前は オレの元を 離れるだろう...";
    text[10843] = "...";
    text[10844] = "醜い真実を 知る方が 隠し事を されるよりも ずっといいわ";
    text[10726] = "でも どれくらい ひどいわけ？";
    text[10727] = "お前たちの 想像を はるかに超えて ひどいのは 間違いない";
    text[10728] = "だからこそ オレは ここに 来てから...";
    text[10729] = "...ひどく 心が 乱れてるのさ";
    text[10730] = "...";
    text[10731] = "マグネシアが 破壊された日";
    text[10732] = "オレは サロスと ルナーフォースに 襲撃された";
    text[10733] = "あの時は ヤツと対峙して 3回目だった...";
    text[10734] = "オレは 疲れ果て...";
    text[10735] = "恐怖に 怯え...";
    text[10736] = "怒りに 震えていた...";
    text[10737] = "サロスが 憎かった...";
    text[10738] = "そして あの力を 持っている 自分自身も...";
    text[10739] = "それに 悔しかった...";
    text[10740] = "...化け物のような 目で見られ... モルモットのように 扱われ...";
    text[10741] = "もはや 耐えられなかった...";
    text[10742] = "だから あの日 オレは 逃げるのではなく 戦うことを 決意した";
    text[10743] = "溜まった怒りを 解き放つと 身体に 変化が生じ...";
    text[10744] = "オレの中にある 反物質が 精神を 浸食し始めた...";
    text[10745] = "それは まさに サロスが 一番望んだ 展開だった";
    text[10748] = "...ヤツは その「化け物」が 見たかったんだ";
    text[10749] = "そして 怒りを 爆発させた瞬間...";
    text[10746] = "それが オレの人生で サイアクの 瞬間になった";
    text[10747] = "その時 オレは まだ 自分の力を コントロール できていなかった...";
    text[10750] = "フェイズフォームに なるや否や";
    text[10751] = "意識が もうろうとして... それから 何が起きたのか わからなかった...";
    text[10752] = "正気を 取り戻した時には すべてが 遅かった...";
    text[10753] = "マグネシアの コロニーは メチャクチャに なっていた...";
    text[10754] = "...そこに 立っていたのは オレだけだった";
    text[10755] = "マグネシアの 人たちは オレのせいで 死んだんだ...";
    text[10756] = "...そして もう 償う術すらも 残っていない";
    text[10757] = "その日以来 オレの心は いつも どんな時も";
    text[10758] = "罪の意識と 恥と 恐怖で 満たされている...";
    text[10759] = "また同じことを 起こしたら どうしようと...";
    text[10760] = "何かのはずみで 暴走したら どうしようと...";
    text[10761] = "オレは 弱かった...";
    text[10762] = "ひどい目に あうなら オレが そうなるべき だったんだ...";
    text[10763] = "ニックル...";
    text[10764] = "ベラ オレは お前と関わる 資格のある 人間じゃない...";
    text[10765] = "...オレは 自分が 犯した罪を 償わなくちゃいけない";
    text[10766] = "すまない...";
    text[10846] = "...！";
    text[10847] = "ありえないわ...";
    text[10848] = "そんなの... ありえない...";
    text[10849] = "ベラ...";
    text[10850] = "ニックルを 独りで 行かせては いけないわ";
    text[10851] = "ほとんど 自殺行為 みたいなものよ";
    text[10852] = "ベラ！";
    text[10853] = "ナイラさんが サロスの ヒミツの サーバーから 何か 見つけたみたいよ！";
    text[10854] = "読んでみましょう";
    text[10855] = "... ... ...";
    text[10856] = "ベラ！";
    text[10857] = "そうね ニックルを 探さないと！";
    text[10858] = "...あの人に これを 教えないと！  急ぎましょう！";
    text[10714] = "わあ 地震！？";
    text[10715] = "感じるわ...";
    text[10716] = "...恐ろしい力が この先にある";
    text[10720] = "さあ 進みましょう...";
    text[10721] = "何だか すごく イヤな 胸騒ぎが するけどね...";
    text[10881] = "ニックル！";
    text[10882] = "もう そこら中 探したのよ！";
    text[10883] = "ナイラさんから マグネシアでの 事件について レポートを 受け取ったわ";
    text[10884] = "それで あなたに 伝えたいことが あるの";
    text[10885] = "... ... ... ...";
    text[10886] = "ニックル？";
    text[10887] = "すまないが お前の友は もはや ここには いない...";
    text[10888] = "あなたが ネクロミアね";
    text[10889] = "うむ その通り...";
    text[10915] = "ワタシが お前の友を 襲撃した時...";
    text[10890] = "この者は ワタシを 覚えているようには 見えなかった...";
    text[10891] = "実に 奇妙なことだ...";
    text[10892] = "なぜか？  ワタシは しっかりと 覚えていたからな...";
    text[10916] = "あの日以来 ずっと... ";
    text[10917] = "ワタシは 再び 目覚めるため 力を 蓄えてきた...";
    text[10893] = "ニックル... お願い そこから逃げて！";
    text[10894] = "ネクロミアに 操られてしまうわ！";
    text[10895] = "ムダだ もう何も 聞こえはしない...";
    text[10896] = "お前の友は... もはや 我がものと なったのだ！";
    text[10909] = "バカなこと 言ってないで とっとと ニックルを 返しなさい！";
    text[10910] = "ご覧のように... ワタシには 肉体という ものがない";
    text[10911] = "はるか昔に 破壊されて しまったからな...";
    text[10912] = "この男によって...";
    text[10913] = "...そして今 新しい 身体として これを 使うのだ";
    text[10918] = "だが 1つ残念なのは...";
    text[10914] = "彼が ワタシを 覚えていなかったこと...";
    text[10897] = "ワタシは 感じるのだ...";
    text[10898] = "ヤツの心は 己に対する 憎しみで 満たされている...";
    text[10899] = "そう 今でさえも...";
    text[10900] = "彼は 恐れているのだ...";
    text[10901] = "お前を 殺すことを 何よりも...";
    text[10902] = "ならば その悪夢 現実のものと してやろう！";
    text[10903] = "ニックル！  そんなヤツに 心を 渡しちゃダメ！";
    text[10904] = "あなたは 強い人なのよ ニックル！";
    text[10905] = "だから 戦うの！！";
    text[10906] = "戦う... 戦うだと？";
    text[10907] = "そちらが それを 望むならば...";
    text[10908] = "...その通りに してくれようぞ！";
    text[10922] = "ニックル 元に戻ったのね！";
    text[10923] = "よく ネクロミアの マインドコントロールを 跳ねのけたわ！";
    text[10919] = "ありえない...";
    text[10924] = "こんなことは...";
    text[10925] = "お前たちには 死あるのみ...";
    text[10920] = "思い出した...";
    text[10921] = "全部 思い出したぞ";
    text[10926] = "でも... 解き放たれたのは オレの 記憶じゃない";
    text[10927] = "...ネクロミア お前の 記憶だ";
    text[10928] = "それは わざとだ...";
    text[10929] = "ワタシは 自分の記憶を 共有した...";
    text[10930] = "ワタシが お前を 憎む理由を わからせるために...";
    text[10931] = "オレとこいつは... 戦ったんだ";
    text[10932] = "あの マグネシアが 破壊された日にな";
    text[10933] = "ベラ ナイラの レポートには 何て書いてある？";
    text[10960] = "マグネシアの 破壊に関する 記録は...";
    text[10980] = "サロスの 保身的な 動機により 隠ぺいされた...";
    text[10981] = "...なぜなら その日 彼は あなたの捕縛に 失敗していたから";
    text[10934] = "サロスは マーク血清の テストを 行うため...";
    text[10935] = "ルナーの 考古学チームが 数年前に 遭遇した";
    text[10936] = "「太古の存在」を 実験台にすることを 決定した";
    text[10937] = "それが... ネクロミアよ";
    text[10938] = "そして ネクロミアの 腐敗の 原因を 作ったのが サロス...";
    text[10942] = "腐敗... そう 腐敗だ...";
    text[10939] = "ヤツは ネクロミアの プログラムに 手を加えた";
    text[10940] = "その力を使い オレの精神を コントロール するために...";
    text[10941] = "...だが それは 失敗に終わった";
    text[10943] = "...なぜなら その日 オレは 正気を 失っていたからだ";
    text[10944] = "オレの心は すでに 制御できる 状態じゃなかった";
    text[10945] = "...その時 残っていたのは ただ 生存本能だけだった";
    text[10946] = "ネクロミアでは オレを 操作できないと 悟った サロスは";
    text[10947] = "計画を変更し ネクロミアに 街を攻撃するよう 命令した";
    text[10948] = "そして ワタシは 行ったのだ...";
    text[10949] = "純粋な 破壊を...";
    text[10950] = "それは...";
    text[10951] = "実に 美しかった...";
    text[10952] = "だが その時だった  お前は心を なくしていたものの...";
    text[10982] = "その身体は 勝手に動いていた...";
    text[10953] = "お前の本能は... 人々を守ろうとした...";
    text[10954] = "ワタシを 止めようとし... いや 実際 止めたのだ...";
    text[10956] = "お前は 強烈な 一撃を放った...";
    text[10957] = "そして ワタシの 肉体は 粉々に 砕け散ったのだ...";
    text[10955] = "...もっとも 街を 完全に 破壊し尽くした 後だったがな！";
    text[10969] = "...だが もう お前は二度と 何も 壊せなくなった";
    text[10970] = "終わりだ ネクロミア";
    text[10979] = "お前には 残念な知らせだが... この姿になったら...";
    text[10975] = "どうやっても ワタシは 倒せないのだ...";
    text[10983] = "いいや そんなことはない";
    text[10976] = "反物質と...";
    text[10977] = "ラックスの力が 合わされば...";
    text[10978] = "...できないことなど ありはしない！";
    text[10971] = "ベラ！";
    text[10972] = "ええ！  ソウルセンスを 使うわ！";
    text[10973] = "マグネシアの みんなの... 無念を晴らす！";
    text[10974] = "ハアァァァァァーッ！";
    text[10986] = "「無知は幸福なり」...";
    text[10987] = "マークと それに まつわる 闇を知った 身としては";
    text[10988] = "真実を 知らない人を うらやましく 思うくらいだ";
    text[10989] = "...ただ この件に 限って言えば";
    text[10990] = "無知は 呪いだった";
    text[10991] = "何年もの間";
    text[10963] = "マグネシアの人々を 殺したのは 自分だと 思い込んできた...";
    text[10964] = "もっとも 自分が 張本人ではないと わかっても...";
    text[10965] = "まだ 責任は 感じているがな...";
    text[10966] = "マグネシアの 人たちが 死んだのは...";
    text[10984] = "オレが 街を 守れなかったせいだ";
    text[10967] = "ニックル...";
    text[10968] = "あなたは もう少し 自分を 赦してあげた方が いいんじゃないかしら？";
    text[10992] = "あなたが 持って生まれた力...";
    text[10995] = "サロスのような 悪人が やろうとしたこと...";
    text[10996] = "それは あなたを 利用することだった...";
    text[10997] = "彼らの知識 権力 邪悪な目的...";
    text[10998] = "...それらは ゼッタイに あなたの 過ちではないわ";
    text[10999] = "でもね これまでと 違うのは 今のあなたには それを正す チャンスが あること";
    text[11000] = "「正す」か...";
    text[10993] = "...ええ";
    text[10994] = "まあ そのために オレは 反物質コアを 集めているしな...";
    text[11001] = "そうよ";
    text[11002] = "あなただけでなく ワタシもね...";
    text[11021] = "サロスのせいで 苦しんだ 人たちを 助け";
    text[11003] = "家族や 愛する人たちの元に 返してあげるのよ";
    text[11004] = "でも マグネシアの 人たちを...";
    text[11005] = "...助けることは できない";
    text[11006] = "そうでもないわよ";
    text[11007] = "どういう意味だ？";
    text[11008] = "ナイラさんの レポートには もう1つ 書いてあるわ...";
    text[11009] = "ネクロミアは 街を 壊しかけたけど...";
    text[11010] = "...すべての住民を 殺すことは できなかった";
    text[11011] = "その時の 生存者たちは サロスの 一味に 連行され...";
    text[11012] = "全員が マークに関する 実験の 被験者にされた...";
    text[11013] = "その人たちは...";
    text[11014] = "今も マークとして どこかに いるかもしれない...";
    text[11016] = "...なら その人たちを 見つけて お家に 返してあげるのが ワタシたちの 使命ね";
    text[11057] = "... ... ...";
    text[11051] = "...グスッ";
    text[11052] = "ああっ！  ちょっと ニックル！";
    text[11053] = "わ... 悪い...";
    text[11054] = "ただ...";
    text[11055] = "まだ 生きてる人が いるんだと わかって...";
    text[11056] = "...グスッ";
    text[11017] = "ベラ...";
    text[11022] = "テトラ...";
    text[11018] = "お前たちが いなければ オレは ここまで 来れなかった...";
    text[11019] = "一緒にいてくれて 本当に ありがとう...";
    text[11020] = "友達って そういうもんでしょ！";
    text[11023] = "ワタシたちは 「ルナーの 三銃士」でしょ 覚えてる？";
    text[11024] = "そうだったな";
    text[11025] = "でも その前に...";
    text[11026] = "マグネシアの 人たちと 死んだ ルナーフォース隊員の ために...";
    text[11027] = "...少しだけ お祈りを させてくれ";
    text[11028] = "ええ どうぞ";
    text[11029] = "マグネシアの怪物\n-MISSION COMPLETE-";
    text[11030] = "ベラ...";
    text[11031] = "どうしたの？";
    text[11032] = "お前と 一度 ガチで 戦ってみたいんだが";
    text[11033] = "ガチバトル！？  ここで？";
    text[11034] = "ああ";
    text[11035] = "ちょっぴり バカげた話に 聞こえるけど...";
    text[11036] = "マグネシアの 人たちに";
    text[11037] = "これから 強くなるために ベストを尽くすと 示したいんだ";
    text[11038] = "...そして お前は オレが知る限り 最強の戦士だ";
    text[11039] = "それで ワタシと 戦いたいわけ？";
    text[11040] = "ああ\n負けた方が メシをおごる でどうだ？";
    text[11041] = "ええ それ ひょっとして デートに 誘ってるわけ？";
    text[11042] = "え ええ！？  いや...";
    text[11047] = "そうかもな...";
    text[11043] = "つまり 「イエス」と いうことよね？";
    text[11044] = "いいわ その挑戦 受けてあげる";
    text[11045] = "...ただし 手抜きは 一切しないわよ";
    text[11046] = "おうよ 当たり前だ";
    text[11048] = "こっちだって... フェイズモードを 使うぜ";
    text[11049] = "面白いじゃない！  それじゃあ 行くわよ！";
    text[11050] = "ニックルと 戦いますか？";
    text[11072] = "ここが あの エナGコーポレーションか...";
    text[11073] = "ヘッヘッヘ...";
    text[11075] = "もうすぐ...";
    text[11076] = "もうすぐだ...";
    text[11074] = "(こいつら 怪しいわね...)";
    text[11069] = "あの～ 何か お探しかしら？";
    text[11070] = "いんや 何も...";
    text[11071] = "オレたちゃ 忙しいんだ\nあっち行きな お嬢ちゃん";
    text[11077] = "M-06: エナGコーポレーション のっとり じけん";
    text[11078] = "ティコにある エナGコーポレーションの 本社ビルが ";
    text[11079] = "金品を盗み 闇市に 売りさばく 手口で 知られる";
    text[11080] = "悪名高き 盗賊団 「ラベジャーズ」によって 占領されたわ";
    text[11081] = "とても キケンな集団で 犯行の動機は 今のところ 不明よ...";
    text[11082] = "あなたの ミッションは 会社のビルに 潜入し";
    text[11083] = "凶悪な 「ラベジャーズ」の 連中を 逮捕すること";
    text[11084] = "そして 犯行の全容を 明らかにすることよ！";
    text[11085] = "着いたわ\n今の 状況は？";
    text[11086] = "ベラ将軍 すでに 大半の人を 避難させましたが";
    text[11087] = "ラベジャーズは CEOを はじめとする 上級役員を";
    text[11088] = "人質に とっています";
    text[11089] = "ただ ドローンに 建物を スキャンさせたところ";
    text[11090] = "中に 時限爆弾が 仕掛けられていることが 判明しました！";
    text[11091] = "ヤツらの 狙いが 何であれ ことを 早く済ませ";
    text[11092] = "その後で ビルを 爆破する つもりなのでしょう";
    text[11093] = "わからねえな... たかが エナGドリンクを 作ってるだけの 企業に";
    text[11094] = "これだけ 大がかりな マネをするってのか？";
    text[11095] = "ええっと... すみません\n多分ですが...";
    text[11096] = "ラベジャーズの 狙いが何なのか わかります...";
    text[11097] = "会社は ここ数年 新商品の 開発に 取り組んできました...";
    text[11098] = "飲めば たちまち 体に力が みなぎり";
    text[11099] = "数日 睡眠を 取らずに 済むという コンセプトの 新商品...";
    text[12000] = "究極の エナGドリンクの 開発にです";
    text[12001] = "それは まさに 「24時間 戦いたい」人に うってつけの 飲み物...";
    text[12002] = "ワタシたちは それに 「インフィニティ・エナG」の 名を付けました";
    text[12003] = "その成分には すさまじい 科学的 および 生物学的な ポテンシャルがあり... ";
    text[12004] = "学術的にも とてつもない 価値が あります";
    text[12005] = "おそらく ラベジャーズが ここに来た 真の狙いは ...";
    text[12006] = "新商品の 機密資料を 盗むためでしょう";
    text[12007] = "なるほどね 説明ありがとう！";
    text[12008] = "大丈夫よ ラベジャーズの 思うようには させないわ！";
    text[12009] = "それじゃあ あなたたち 作戦開始と 行くわよ！";
    text[12010] = "チッ ルナーフォースの 連中が 来やがったか...";
    text[12011] = "手を上げなさい！  あなたたちを 全員 逮捕するわ！";
    text[12012] = "おいおい お前さん 本気で こっちが あきらめて";
    text[12013] = "おとなしく 縄につくとでも 思ってるのかい？";
    text[12014] = "正義の 味方ちゃんは ウブだねえ！";
    text[12015] = "こっちは ビルの すべての階を 押さえてるんだぜ";
    text[12016] = "...そして このビルは 10ターン後に 爆破される";
    text[12017] = "どう あがこうがな";
    text[12018] = "10ターンだって？";
    text[12019] = "余裕だな";
    text[12020] = "お前らなんか 1ターンあれば 十分だ";
    text[12021] = "生意気な 減らず口を...";
    text[12022] = "ラベジャーズを ナメたら どうなるか 今から たっぷり 教えてやるよ！";
    text[12076] = "てっきり 企業の オフィスビルかと 思ったんだが...";
    text[12077] = "そこら中に 置いてある 矢印タイルは 何なんだ？";
    text[12170] = "まるで 迷路じゃないか...";
    text[12078] = "ラベジャーズが こっちを 妨害するために 設置したのかしらね？";
    text[12079] = "それか 社長が よほどの パズル好きとか...";
    text[12171] = "ああ... また ラベジャーズよ！";
    text[12172] = "心配すんな\n大した 相手じゃねえさ！";
    text[12023] = "ああ こいつは 誤算だったな...";
    text[12024] = "どうやら ルナーフォースを 甘く見ていたようだ";
    text[12025] = "あなたが ラベジャーズの リーダーね...";
    text[12026] = "...ああ そうだ";
    text[12027] = "だが あいにく お前たちに 付き合う ヒマはない  別の場所に 用があるんでな";
    text[12028] = "機密資料は カンタンには 見つからんのだ";
    text[12029] = "いいか 警告するのは 一度だけだ";
    text[12030] = "...今すぐ 人質を 解放し 爆弾を 解除しろ！";
    text[12031] = "...さもなくば どうするって？";
    text[12032] = "下っ端を 倒して イキッている ようだが...";
    text[12033] = "オレは そんなに 生易しくは ないぞ";
    text[12034] = "しかも こうしている 間にも 時計の針は 動いている";
    text[12035] = "まさか 爆弾のこと 忘れては いないだろうな？";
    text[12036] = "お前らは じきに 灰の塊に なるのだ！";
    text[12037] = "ハッ それは どうかな！";
    text[12038] = "時限爆弾を 解除したわ！";
    text[12039] = "これで ひとまず 安心ね！";
    text[12040] = "うう 助けてくれて ありがとう...";
    text[12041] = "それに ラベジャーズを 止めてくれて...";
    text[12042] = "これは ほんの 感謝の 気持ちだ\n受け取っておくれ...";
    text[12043] = "インフィニティ・エナGを 手に入れた！";
    text[12044] = "...ええっと これ 本当に もらっても いいわけ？";
    text[12045] = "もちろんだとも インフィニティ・エナGは もうすぐ 発売だ";
    text[12046] = "だから スペシャルサンプルとして 味わってみて くれたまえ！";
    text[12049] = "結局... ラベジャーズの 動機は わからずじまい だったな...";
    text[12050] = "商品の 化学的な 資料が 欲しかったんだろうが...";
    text[12051] = "どうして 正式な発売を 待たなかったんだ？";
    text[12052] = "ビジネスとは 生き馬の 目を抜く 世界なのだよ";
    text[12053] = "何か 革新的な ものを 売り出すとなれば";
    text[12054] = "最初に 作った会社が 巨万の富を 得るのだ";
    text[12055] = "ウチの 会社も それなりに 敵がいるから";
    text[12061] = "ラベジャーズに 資料盗みを 命じた 黒幕も だいたい 予想がつく";
    text[12062] = "...ただ その 「犯人探し」は また 別の機会にしよう";
    text[12057] = "今は...";
    text[12058] = "このようなことが 再び 起きないよう";
    text[12059] = "会社の セキュリティを 強化しなくては";
    text[12060] = "とにかく キミたちには 改めて お礼を言うぞ";
    text[12047] = "ヒマな時は いつでも ウチで ゆっくり していきなさい";
    text[12048] = "ありがとう！";
    text[12067] = "ええっと... あなた 大丈夫？";
    text[12073] = "今は ここに いるべきじゃないわ";
    text[12072] = "ボクが 大丈夫かって？";
    text[12068] = "全然 平気さ...";
    text[12074] = "今は とても...";
    text[12063] = "とても スッキリした 気分だ...";
    text[12075] = "ええ...";
    text[12064] = "あのね このビル 爆発するかも しれないのよ";
    text[12065] = "お願いだから 今すぐ 避難して！";
    text[12066] = "もちろんだよ...";
    text[12069] = "ただ... 今だけは この栄光の 瞬間を 静かに 味わわせておくれ...";
    text[12070] = "ハァ... テトラ 隊員を 呼んで この人を 避難させて";
    text[12071] = "わかったわ！";
    text[12305] = "なんいど:";
    text[12306] = "ノーマルモード";
    text[12308] = "ハードモード";
    text[12307] = "ノーマルの てきが EXに EXの てきが ZXに なります!";
    text[12309] = "レジェンドモード";
    text[12310] = "すべての てきが ZXになります";
    text[11058] = "なつの いりえ";
    text[11062] = "すてられた みち";
    text[11063] = "セクター3: マグネシア";
    text[11064] = "ふういん されし へや";
    text[12080] = "ラベジャーズの こぶん";
    text[11061] = "コラプトイド";
    text[11060] = "ネクロミア";
    text[12124] = "ノイズバースト";
    text[12125] = "サモンセントリー";
    text[12126] = "ネクロブラスト";
    text[12127] = "スピリットフォース";
    text[12128] = "ホーンテッドエリア";
    text[12129] = "セントリースラッシュ";
    text[12130] = "コラプトフラリー";
    text[12131] = "マインドクラッシュ";
    text[12132] = "フォトンブレード";
    text[12133] = "レイドウイング";
    text[12134] = "ラベジャーズコード";
    text[12135] = "マイクロボム";
    text[12083] = "ほしのトロフィーを 手に入れた！";
    text[12086] = "EZスタンを 手に入れた！";
    text[12087] = "EZやけどを 手に入れた！";
    text[12088] = "EZメーターを 手に入れた！";
    text[12084] = "スーパーエリクサーを 手に入れた！";
    text[12085] = "ネクロエキスを 手に入れた！";
    text[12089] = "エナGビルのカードキーを 手に入れた！";
    text[12090] = "プールフロートを 手に入れた！";
    text[12091] = "リミットブレーカーを 手に入れた！";
    text[12098] = "EZスタン";
    text[12099] = "てき 1たいを 1ターン スタン させる";
    text[12100] = "EZやけど";
    text[12101] = "てき 1たいを 3ターン やけど じょうたいに";
    text[12102] = "EZメーター";
    text[12103] = "ラックスと はんぶっしつ メーターを 50% みたす";
    text[12092] = "インフィニティ・エナG";
    text[12093] = "HPを かんぜん かいふくし SPを 3ターン リジェネ";
    text[12094] = "スーパーエリクサー";
    text[12095] = "すべての みかたを +70 SP";
    text[12096] = "ネクロエキス";
    text[12097] = "きぜつした みかたを 100%の HPで かいふく";
    text[12104] = "エナGビルのカードキー";
    text[12105] = "エナGコーポの ほんしゃ ビルの カードキー";
    text[12106] = "うきわ";
    text[12107] = "たいようの したで あそぼう!";
    text[12108] = "リミットブレーカー";
    text[12109] = "すべての アクティブスキルの LV リミット +1!";
    text[12110] = "ほしのトロフィー";
    text[12111] = "データベースの かんりょうを しょうめい する";
    text[12112] = "ターゲット: ラベジャーズ";
    text[12113] = "エナGコーポレーションに せんにゅうし ラベジャーズを たいほ しよう!";
    text[12114] = "ターゲット: ふめい";
    text[12115] = "「マグネシアの かいぶつ」を ちょうさし ルナーフォース たいいんを きゅうしゅつ しよう!";
    text[12139] = "ウェーブ・ウォーターを プレイしますか？";
    text[11059] = "ウェーブ・ウォーター";
    text[11067] = "ジャンプ";
    text[12138] = "スプラッシュ!";
    text[10610] = "キャラクター せんたく";
    text[10611] = "ハイスコア 更新！";
    text[10612] = "ハイスコア:";
    text[10613] = "ボーナス!";
    text[10614] = "スゴイ!";
    text[12081] = "EXとZXモンスターの データベースを コンプリート しました！";
    text[12082] = "おめでとうございます！";
    text[12136] = "サーフボードに 数字が 彫られている: 202310";
    text[12137] = "エナGコーポレーション: あなたの 体を エナGで 満たしましょう！";
    text[12173] = "プロモーションコード 692533を 入力すると 特典が もらえます！";
    text[12166] = "ピクニック バスケットは お菓子と チーズケーキバーで いっぱいだ！";
    text[12167] = "ビーチボールだ！";
    text[12168] = "ここの ヤシの木は とっても かわいらしいわね！";
    text[12169] = "ピンクと 紫って ステキだわ！";
    text[12174] = "大きな ボトルに入った エナGドリンクだ！";
    text[12175] = "エナGドリンク 研究開発部";
    text[12176] = "エナGドリンク 倉庫";
    text[12177] = "エナGドリンク 製造部";
    text[12178] = "どうやら この会議室で ミーティングが あったようね";
    text[12179] = "このスマートボードには 四半期の エナGドリンクの 売り上げが 示されている";
    text[12180] = "このボードには 「社内月間MVP」 をはじめとする";
    text[12181] = "会社の いろいろな よくわからない 表彰が 掲示されている";
    text[12182] = "ニックル この棚に 何が 入ってると思う？";
    text[12183] = "さあな\n見てみようじゃねえか...";
    text[12184] = "まあ このビルの どこも エナGドリンクの 入った でかいボトル だらけだし...";
    text[12185] = "いろんな種類の ドリンクが 入ってるに 1000バイト 賭けるぜ";
    text[12186] = "はい ブッブー！  あとで 1000バイト ちょうだいね エヘヘ...";
    text[12187] = "バカな！  じゃあ 何が 入ってるってんだ！？";
    text[12188] = "おいおい ウソだろ...";
    text[12189] = "缶入りの バナナだなんて！";
    text[12190] = "...でも どうして？";
    text[12191] = "コンピュータ上に 開かれている ファイルの名は 「インフィニティ・エナG」だ";
    text[12192] = "この エナGドリンクは 見たことが ないわね...";
    text[12193] = "...きっと 開発中の 新商品だろうな";
    text[12194] = "スキルブースターの 自販機だ！";
    text[12195] = "スキルブースター 1個を 5000バイトで 買う";
    text[12196] = "スキルブースター 1個を 250アストロテックで 買う";
    text[12197] = "スキルブースター 1個を 50スキルポイントで 買う";
    text[12198] = "アストロテックが 足りない！";
    text[12199] = "バイトが 足りない！";
    text[12200] = "スキルポイントと バイトの 両替マシンだ！";
    text[12201] = "50スキルポイントを 5000バイトに 両替しますか？";
    text[12202] = "スキルポイントが 足りない！";
    text[12203] = "ハイパー・エナGドリンクの 自販機だ！";
    text[12204] = "割引価格の ハイパー・エナGドリンクを 1000バイトで 買いますか？";
    text[11065] = "廃棄された ロボットだ...";
    text[11066] = "...動いているようには 見えない";
    text[12205] = "サロスと ヴィヴィア";
    text[12208] = "キャンセル";
    text[12206] = "?????";
    text[12207] = "エラー... エラー... データなし...";
    text[12209] = "警告... 警告...";
    text[12210] = "ホログラム生成装置に... 過負荷発生...";
    text[12231] = "警告: 立ち入り禁止\nこの先は キケンな セクターです";
    text[12232] = "セクター3への進入 および 棄てられた道の 通行は 禁止されています";
    text[12234] = "セクター3への橋";
    text[12235] = "セクター3郊外";
    text[12236] = "配電盤だ";
    text[12237] = "この自販機は 故障しているようだ...";
    text[12238] = "緊急の 避難通知だ...";
    text[12239] = "サイクロイドの セラピーグループの 広告だ";
    text[12240] = "12の 墓石に 刻まれた 無念の死を 遂げた 魂に 祈りを 捧げよ...";
    text[12241] = "...さすれば 汝に ネクロエキスを 授けよう";
    text[12255] = "12の 墓石に 刻まれた 無念の死を 遂げた 魂は 解放された...";
    text[12256] = "...汝に ネクロエキスを 授けよう";
    text[12242] = "亡くなった 人たちの 魂に 祈りを 捧げた";
    text[12243] = "奇妙な 墓石が 光を放っている！";
    text[12244] = "残りの 墓石は 11基...";
    text[12245] = "残りの 墓石は 10基...";
    text[12246] = "残りの 墓石は 9基...";
    text[12247] = "残りの 墓石は 8基...";
    text[12248] = "残りの 墓石は 7基...";
    text[12249] = "残りの 墓石は 6基...";
    text[12250] = "残りの 墓石は 5基...";
    text[12251] = "残りの 墓石は 4基...";
    text[12252] = "残りの 墓石は 3基...";
    text[12253] = "残りの 墓石は 2基...";
    text[12254] = "残りの 墓石は 1基...";
    text[12257] = "バーミル";
    text[12264] = "キットは バーミルと 話しているようだが";
    text[12265] = "聞こえてくるのは キツネの 鳴き声だけだ...";
    text[12258] = "こんにちは ワタシは ベラよ";
    text[12259] = "あなたの顔 見覚えがないけど... 新人さんかしら？";
    text[12260] = "いいえ 結構 長いこと いるけど...";
    text[12261] = "...ていうか 長すぎて 覚えてない くらいね";
    text[12277] = "まあ 自分のいる 業界では まだまだ 新人みたいな もんだけど";
    text[12278] = "ええ？  一体 何の 仕事を してるんだ？";
    text[12262] = "未知の 古代遺跡や 遺物を 発見する 仕事よ";
    text[12274] = "最近 1年の 現地調査から 戻ってきた ところなの";
    text[12275] = "ああ なるほどね";
    text[12263] = "なら お帰りなさいって ところかしら  ええーっと...";
    text[12267] = "ああ 自己紹介が まだ だったわね";
    text[12268] = "ワタシは バーミル\nこっちは キツネの相棒 キットよ";
    text[12269] = "キットちゃん！  カワイイわね！";
    text[12270] = "アンタ いい剣を 持ってるな...";
    text[12276] = "トレジャーハンターの カンで わかるぜ そいつは 古代の 遺物だって";
    text[12271] = "鋭いわね ご名答よ";
    text[12272] = "いつの日か あなたを 調査遠征に 同行させたいものだわ...";
    text[12279] = "ええっと...";
    text[12281] = "ニックル！  オレの名前は ニックルだ";
    text[12282] = "ニッケル...  その名前 金属から 取ったの？  それとも...";
    text[12283] = "「ピッケル」よ！  登山の！";
    text[12286] = "ああ！";
    text[12287] = "まあ 本当は 「ニックル」だけど もうニッケルでも ピッケルでも いいぜ...";
    text[12284] = "ウーン... とにかく 興味深い 名前だわ";
    text[12285] = "(何このノリ... さっきから 全然 話の輪に 入れないんだけど！)";
    text[12273] = "ところで... この 古代の剣は 「ヘブンネビュラ」と 呼ばれるものよ";
    text[12280] = "何年も前の 遠征調査の時に 発見したの";
    text[12288] = "ニックル... ベラ...";
    text[12289] = "この星には まだまだ 未発見の 遺物が たくさん 眠っているわ";
    text[12290] = "もし 古代の遺物を 見つけたりしたら...";
    text[12291] = "是非とも 見せに 来てちょうだいね！";
    text[12292] = "そうしたら あなたの 名前入りの スーパーエリクサーを あげるわ！";
    text[12288] = "ニックル... ベラ...";
    text[12293] = "あなたたちの剣... すごく 古くて カッコイイわ！";
    text[12294] = "この剣は 「エクスカリバー」さ";
    text[12295] = "...そして こっちは 「レリックソード」よ";
    text[12296] = "(ワタシも クールな 古代の剣が 欲しいわあ...)";
    text[12297] = "いいものを 見せてくれて どうも ありがとう！";
    text[12298] = "それじゃあ 約束通り... あなたの 名前入りの スーパーエリクサーを あげるわね！";
    text[12299] = "ええっと... 別に 名前は 入れなくても 良かったんだが...";
    text[12300] = "ププ... しかも 「ベラと ニッケル」 になってるわ";
    text[12301] = "ああ そんなに こっち 見ないでよ";
    text[12302] = "元は キットの アイデアなんだから";
    text[12303] = "ワタシの夢は...";
    text[12304] = "失われた 「古代」を 蘇らせること...";
    text[12337] = "レインは 夏の入り江 会おうと 言っていたわ！";
    text[12338] = "オシアナスの 北にある 小さな 砂浜よ！";
    text[12319] = "太陽の下で 遊びましょ！";
    text[12311] = "マグネシアの 入り口は...";
    text[12312] = "...シリカ峡谷と シリカコロニーの 間だったはずよ";
    text[12344] = "橋で見た 「怪物」を 追いかけましょ！";
    text[12365] = "ネクロミアは 人の心を操る ガーディアンよ";
    text[12366] = "本当に 恐ろしいわ...";
    text[12367] = "何か 怪しいものが ないか 注意して 進むわよ！";
    text[12314] = "ニックル...";
    text[12315] = "あの人には いろんなことが あったわ...";
    text[12316] = "でも 彼を 放っておいては ダメよ！  探しに 行かないと！";
    text[12317] = "ここに 生えてる 紫の木 この気候で 生き延びられる なんて びっくりだわ";
    text[12318] = "母なる自然には 適応力が あるのね";
    text[12320] = "放置された 貨物を 見つけた！";
    text[12326] = "あら 中身は 何かしら？";
    text[12327] = "ウーン... 何もないわね";
    text[12321] = "空っぽよ";
    text[12322] = "このエリアは 何年も前に 破壊された...";
    text[12323] = "元の持ち主は もうこれを 探してすら いないでしょうね";
    text[12324] = "なら 持ち帰りましょ！";
    text[12325] = "ええ どうして！？";
    text[12328] = "これもまた ルナーの 歴史の一部よ";
    text[12329] = "まあ... そうかも しれないわね...";
    text[12330] = "わかったわ じゃあ ひとまず いただいて おきましょ";
    text[12331] = "わあい！";
    text[12332] = "エナGコーポレーションCEO";
    text[12333] = "しゃいん";
    text[12334] = "「イカサマゲーム」という タイトルの ドラマが 放送されている";
    text[12335] = "スキルブースターを買う (5000バイト)";
    text[12336] = "スキルブースターを買う (250アストロ)";
    text[12339] = "ビルの中に まだ ラベジャーズの 連中が 潜んでいるはず";
    text[12340] = "遭遇したら どうにかして 捕縛しておくれ";
    text[12342] = "このミッションを やり直しますか？";
    text[12343] = "(これにより ストーリーの 進行と 残りターンが リセットされます)";
    text[12345] = "すべての アクティブスキルの いりょくが 15アップ!";
    text[12346] = "正直に 認めるけど...";
    text[12347] = "ワタシも こういうのを 新しい技の 練習台に してるしね";
    text[12348] = "だから そっちが 全力を 出してくれることを 期待しているわ";
    text[12349] = "心地のいい そよ風ね...";
    text[12350] = "この星の 海は 本当に キレイだわ...";
    text[12351] = "ワタシたちの ルナーは 何としても 守らないとね";
    text[12352] = "この先 どんなヤツが 現れても ゼッタイに 負けないんだから";
    text[12353] = "そうだな";
    text[12354] = "もちろんよ";
    text[12355] = "みんなで 力を合わせれば きっと大丈夫だわ！";
    text[12356] = "だから ワタシは 別に 心配なんか してないわよ";
    text[12357] = "アクティブスキルを レベル4まで アップグレード できるようになった！";
    text[12359] = "やけど になった てきは いっていの ターン";
    text[12360] = "さいだい HPの 10%を 失う (MAX 100ダメ)";
    text[12361] = "ベラ！  ビルが 爆発する前に ラベジャーズを 倒すわよ！";
    text[12362] = "...でも 行き詰まったと 感じたら...";
    text[12363] = "いつでも このビルの 入り口に 戻って ミッションの やり直しが できるわ";
    text[12368] = "ラベジャーズの リーダー";
    text[12390] = "オプション";
    text[12369] = "建物の 外に 出ますか？";
    text[12370] = "スコア:";
    text[12371] = "ワタシたちを 甘く 見ないことね ネクロミア";
    text[12372] = "そうカンタンに 負けたりなんか しないわよ！";
    text[12373] = "終わった...";
    text[12374] = "... ... ...";
    text[12375] = "これで マグネシアの 人たちの 無念も";
    text[12376] = "晴れるだろう...";
    text[12379] = "なみのり\nマスター";
    text[12380] = "なみのり マスター";
    text[12381] = "フェイズオーラ";
    text[12382] = "フェイズオーラ: 100 ダメージ みまんの こうげきを むこうか!";
    text[12383] = "スピリットフォース: つうじょう こうげき むこうか  じゃくてん: ラックスコンボ + フェイズモード!";
    text[12384] = "ホーンテッドオーラ: てきは リアルタイムで ゆっくり HPを かいふく!";
    text[12385] = "ラベジャーズコード: 50%の かくりつで てきに 2ばいの ダメージ!";
    text[12386] = "ノーマルてき";
    text[12387] = "EXてき";
    text[12388] = "ZXてき";
    text[12389] = "すべてのてき";
    text[12391] = "ログアウト";
    text[12392] = "マイ サブスクリプション";
    text[12393] = "デリート マイ アカウント";
    text[13000] = "Russian";
}

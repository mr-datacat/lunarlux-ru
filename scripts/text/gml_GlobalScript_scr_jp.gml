    text[10128] = "こんにちは ワタシは Lunarpedia.EXE\nゲームやバトルの ヒントをお教えします！";
    text[10116] = "2枚以上の ジェットスーツを 入手すると";
    text[10117] = "変更することが できます！";
    text[10118] = "ゲーム内には 全部で5色の 「！」マークサインが 登場します";
    text[10120] = "青いサインは 操作できる物や インタラクトできるエリアを 示します";
    text[10121] = "黄色いサインは ストーリー進行に 関わるものを 示します";
    text[10122] = "緑のサインは サイドクエストに 関わるものを 示します";
    text[10123] = "赤いサインは ルナーフォースミッションに 関わるものを 示します";
    text[10124] = "そして最後に 紫のサインは マーク以外の バトルスポットを 示します";
    text[10126] = "クエストメニューでは サイドクエストや ミッションの完了に";
    text[10127] = "必要な条件や 情報を 確認できます";
    text[10125] = "クエストメニューには リファレンスから アクセスできます！";
    text[10131] = "宇宙船には フレーム ウイング スラスターの 3つの 交換パーツが あります";
    text[10130] = "このゲームでは 33種類の 船のパーツを 手に入れることが できます！";
    text[10129] = "注: ワールドマップ移動は チャプター2で アンロックされます";
    text[10132] = "バトルに勝つと EXPを獲得し レベルアップすることが できます！";
    text[10134] = "レベルアップするたびに 最大HPが 10ポイント 上がります";
    text[10135] = "また 一部の アクティブスキルの ダメージや威力";
    text[10136] = "さらには ラックスコンボの ダメージも 上がります";
    text[10144] = "SPは バトルで アクティブスキルを 使う時に 消費します";
    text[10145] = "ガムドロップを 使うと SPのコストを 5ポイント 下げることが できます";
    text[10137] = "最大SPは 基本的に 100ですが SPアップグレードチップで 上げることが できます";
    text[10138] = "シールドブースターを使うと 最大シールド数が 増えるだけでなく";
    text[10139] = "バトル開始時の シールドの数も 1つ増えます！";
    text[10140] = "トピックを えらんでください";
    text[10141] = "レベルと さいだいHP";
    text[10142] = "さいだいSP";
    text[10143] = "さいだいシールド";
    text[10146] = "このゲームには 敵の攻撃タイプが 5種類存在します！";
    text[10147] = "1パネル攻撃では プレーヤーの移動は 制限され 攻撃を防ぐのに シールドが 必要になります！";
    text[10148] = "3パネル攻撃では 上下に移動して 攻撃を かわすことが できます！";
    text[10150] = "9パネル攻撃では 四方向に移動して 攻撃を かわすことが できます！";
    text[10151] = "ソウルアタックは プレーヤーの魂が ハートで表現される 特殊な攻撃タイプです";
    text[10152] = "ハートを操作して 敵の発射物を かわすことが できます！";
    text[10153] = "また ソウルアタック中は シールドも使えます！";
    text[10154] = "最後に 紹介するのは ウェーブアタック";
    text[10155] = "ウェーブアタック中は 左右に入力して シールドの向きを変え 攻撃を防ぎます";
    text[10156] = "そうした攻撃の波は 数回切り替わります";
    text[10157] = "注: ウェーブアタックでは シールドが現れますが 消費されません";
    text[10158] = "買いたい ニューロンリンクが あるけど レベルが 足りないな...";
    text[10159] = "ニューロンリンクからは いろいろな技を 学べるけど";
    text[10160] = "しっかりと 鍛えてないと かえって ケガを してしまうわ";
    text[10161] = "だからこそ レベルを 上げるのは 大切なことなのよ！";
    text[10173] = "ラックスコンボの発動";
    text[10174] = "ラックスコンボの修得";
    text[10175] = "ラックスコンボのダメージ増加";
    text[10167] = "敵の攻撃で ダメージを受けると ラックスメーターは 下がります！";
    text[10164] = "ラックスメーターが 満タンになると 技メニューから ラックスコンボを 発動することが できます";
    text[10165] = "3つの アクティブスキルを 選択すると ラックスコンボを 放ちます";
    text[10163] = "このゲームには 全部で30種類の ラックスコンボが 登場します！";
    text[10168] = "ラックスコンボが 「修得した」と みなされるには 最低でも2回 使う必要があります";
    text[10166] = "いろいろな組み合わせを 試したり ラックスコンボレシピを 集めたりして 全部のコンボを 修得しましょう";
    text[10162] = "自分のレベルが 高くなるほど ラックスコンボの ダメージも 上がります！";
    text[10170] = "毒パネル";
    text[10171] = "溶岩パネル";

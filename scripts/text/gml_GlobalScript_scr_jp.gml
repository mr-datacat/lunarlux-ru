    text[480] = "ダメなのよ";
    text[481] = "100％言い切れるの？";
    text[482] = "10億％言い切れるわ";
    text[483] = "でも 100億％じゃないなら... 確実じゃあないわね";
    text[484] = "そこまで言うなら もう一度 計算を やり直してみるわ";

    text[7342] = "マーク血清倉庫";
    text[7343] = "コードネーム: アビレル\nシンクロ率43％";
    text[7344] = "実験体621 ～ 629 -\n反物質分析: 混沌の風";
    text[7345] = "注意: この実験体の 羽には ターゲットの ラックスを 取り払う";
    text[7346] = "奇妙な 性質がある";
    text[7347] = "どうやら ラックスと 反物質が 密接に 絡み合っているようだ";
    text[7348] = "空の カプセルだ";
    text[7349] = "コードネーム: ハイパービー\nシンクロ率11％";
    text[7350] = "実験体42 ～ 44 -\n反物質分析: 格闘と スピード";
    text[7351] = "注意: 変異種の 存在が 確認されている";
    text[7352] = "次のステップは 変異を 意図的に 調整することだ";
    text[7353] = "コードネーム: スペクター\nシンクロ率38％";
    text[7354] = "実験体418 ～ 420 -\n反物質分析: プラズマ耐性";
    text[7355] = "注意: この実験体は プラズマ兵器に 強い耐性を 持っている";
    text[7356] = "また 概して 非常に いたずら好きである";
    text[7368] = "メモ36: シンクロ率 50％以上の 血清サンプルでは ";
    text[7369] = "回復特性が 認められる";
    text[7370] = "自分で テストした サンプルは 機能しているようだ...";
    text[7371] = "...だが これでは まだ 十分とは 言えない";
    text[7372] = "メモ42: 現在の 反物質コアの 備蓄と 完全な 血清が あれば";
    text[7373] = "十万人以上の 命を 救うことができる";
    text[7374] = "マークスレイヤーの 反物質コアを 入手できれば";
    text[7375] = "その数は 大幅に 増えるだろう";
    text[7376] = "メモ74: 新しい体を 得るだけでは 十分とは言えない";
    text[7377] = "十分では ないのだ";
    text[7378] = "聖域が いる...";
    text[7379] = "「家」と呼べるような 場所が...";
    text[7380] = "メモ111: あと少しだ...";
    text[7381] = "シンクロ率99％を 達成した...";
    text[7382] = "もっと 時間さえ あれば...";
    text[7383] = "この実験は ワタシに とてつもない力を 与えてくれた...";
    text[7384] = "...その代償は 己の肉体で あったが";
    text[7385] = "それでも この実験が 成功で あったことは 間違いない";
    text[7386] = "マークスレイヤーの 反物質コアを 手にした 今";
    text[7387] = "人類を 救済するための 計画を 開始すると しよう...";

    text[10031] = "ガンセイバーで なんども きりつけ だいダメージを あたえる！";
    text[10032] = "3かいの エコースラッシュで てきを こうげき！";
    text[10033] = "ボーナス: れんぞくターン ボーナスの あたいが さいだいに！";
    text[10034] = "シールド+7 および 3ターンの シールドかいふく！";
    text[10035] = "きゅうきょくの フォトンキャノン  いりょくは さいだいで 25ばい！";
    text[10036] = "でんきの ざんげきが てき1たいを 100％スタンさせる！";
    text[10037] = "ホロソードが てきを きりきざむ！";
    text[10038] = "いずれかの ソードスキル！";
    text[10039] = "デフォルトの ラックスコンボ";
    text[10040] = "ボーナス: 50％の かくりつで ダメージ1.5ばいの クリティカルヒット！";
    text[10041] = "ドローンレーザーが みだれとぶ！";
    text[10042] = "こうでんあつの フォトンキャノンと ムーンライトダイブの コンボ";
    text[10043] = "50％の かくりつで てきを スタンさせる！";
    text[10044] = "4つの きょだいな いんせきが てきぜんたいを こうげきする！";
    text[10045] = "げんざいの シールドの かずに おうじて ダメージが ぞうかする！";
    text[10046] = "のこりSPの あたいにより ベースとなる いりょくが けっていする！";
    text[10047] = "てきぜんたいを こうげき！";
    text[10048] = "ボーナス: てきぜんたいを 1ターン スタンさせる！";
    text[10049] = "ボーナス: てきぜんたいに 2ターン やけどを おわせる！";
    text[10050] = "ハイドロブラスターが てき1たいを 100％の かくりつで びしょぬれにする！";
    text[10051] = "ロケットブレード ガントレットを てきに はっしゃする！";
    text[10052] = "50％の かくりつで クリティカルヒット！";
    text[10053] = "てきに ステータスこうかが かかっていると ダメージアップ！";
    text[10054] = "ホロテクノロジーで レインたいを せいせいし てき1たいを こうげき！";
    text[10055] = "50％の かくりつで てき1たいを スタン やけど びしょぬれ じょうたいにする！";
    text[10056] = "てきの のこりHPの 25％ぶんの ダメージを あたえる (さいだい 1000ダメージ)";
    text[10057] = "75％の かくりつで てき1たいを やけど および びしょぬれ じょうたいにする！";
    text[10058] = "のこりHPの あたいに おうじて ダメージが ぞうかする！";
    text[10059] = "シールドの かずに おうじて ダメージが ぞうかする！";
    text[10060] = "てきぜんたいを こうげき！";
    text[10061] = "つきあかりの ちからを わがものに する！";
    text[10062] = "テトラと ダブルで フォトンキャノン はっしゃ！  ボーナス: シールド+4！";
    text[10063] = "ふくすうかい ヒットする かくとう こうげき  60％の かくりつで クリティカルヒット！";
    text[10064] = "かいふくの ざんげき！";
    text[10065] = "たおれた みかたを ふっかつ させる！";
    text[10066] = "チーズケーキボムが てきぜんたいを こうげき！  HPを そのばで 200ポイント かいふくし さらに 3ターンの リジェネを える！";
    text[10067] = "ガーディアを しょうかんし こうげき！  そのご 30％の ラックスブーストを える！";

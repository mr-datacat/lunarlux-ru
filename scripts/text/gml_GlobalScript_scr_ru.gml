    text[10031] = "Spam Gun Saber Slashes for Massive Damage!";
    text[10032] = "3 Echo Slashes Strike Enemy!";
    text[10033] = "Bonus: Consecutive Turns value is Maxed out!";
    text[10034] = "Shields +7 and Shield Regen for 3 Turns!";
    text[10035] = "Ultimate Photon Cannon. Max Multiplier x25";
    text[10036] = "Electro Slash 100% Chance to STUN 1 Enemy!";
    text[10037] = "Holo Swords Slice Enemy!";
    text[10038] = "Any Sword Based Skill!";
    text[10039] = "Default Lux Combo";
    text[10040] = "Bonus: 50% chance for DMG x1.5 Critical Hit!";
    text[10041] = "Drones Laser Party";
    text[10042] = "High Voltage Photon Cannon and Moonlight Dive Combo";
    text[10043] = "50% Chance to stun!";
    text[10044] = "Four massive meteors strike all enemies!";
    text[10045] = "Damage increases based on current shield count!";
    text[10046] = "PWR based on SP remaining!";
    text[10047] = "Strike ALL Enemies!";
    text[10048] = "Bonus: STUN all enemies for 1 Turn!";
    text[10049] = "Bonus: BURN all enemies for 2 Turns!";
    text[10050] = "Hydro Blaster 100% chance to DRENCH 1 enemy!";
    text[10051] = "Launch Rocket Blade Gauntlets at enemy!";
    text[10052] = "50% Critical Hit Rate!";
    text[10053] = "Damage Boost if enemy has more status effects!";
    text[10054] = "Holo Tech spawns Raine Squad to attack 1 enemy!";
    text[10055] = "50% Chance to STUN, BURN, and DRENCH 1 enemy!";
    text[10056] = "Deal Damage equal to 25% of Enemy HP Remaining! (MAX 1000 DMG)";
    text[10057] = "75% Chance to BURN and DRENCH 1 Enemy!";
    text[10058] = "Damage Boost Based on HP Remaining!";
    text[10059] = "Damage Boost Based on Shield Count!";
    text[10060] = "Hits all Enemies!";
    text[10061] = "Harness the Power of Moonlight!";
    text[10062] = "Double Photon Cannon Blast with Tetra! BONUS: +4 Shields!";

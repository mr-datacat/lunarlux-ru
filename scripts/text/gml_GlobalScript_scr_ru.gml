    text[10128] = "Hello! I'm Lunarpedia.EXE, your #1 source for useful gameplay tips and battle tips!";
    text[10116] = "You'll be able to change your Jet Suit once you've obtained";
    text[10117] = "at least 2 different styles!";
    text[10118] = "There are a total of five colored indicators you will see on your adventure.";
    text[10120] = "Blue Indicators are used to mark an object or area of interest you can interact with.";
    text[10121] = "Yellow Indicators are used for Story Progression.";
    text[10122] = "Green Indicators are used for Side Quests.";
    text[10123] = "Red Indicators are used for Lunex Force Missions.";
    text[10124] = "Lastly, Purple Indicators are used to mark non-Murk battle spots.";
    text[10126] = "Use the QUESTS MENU to keep track of any requirements or information needed";
    text[10127] = "to complete the Side Quests and Missions you come across on your adventure!";
    text[10125] = "You can access the QUESTS MENU from your Codex!";
    text[10131] = "A space ship is composed of three interchangeable parts: Frame, Wing, and Thruster!";
    text[10130] = "There are a total of 33 Ship Parts you can collect on your adventure!";
    text[10129] = "Note: The World Map Warp is unlocked during Chapter 2.";
    text[10132] = "Defeating enemies in battle will grant you EXP that will help you Level Up!";
    text[10134] = "Your MAX HP will increase by 10 every time you gain a level (LV)!";
    text[10135] = "Leveling up will increase the DMG (Damage) or PWR (Power) of certain Active Skills,";
    text[10136] = "and will also increase your Lux Combo Damage!";
    text[10144] = "SP is essential for using your Active Skills in battle!";
    text[10145] = "You can use GUMDROPS to reduce the SP Cost of one of your Active Skills by 5!";
    text[10137] = "Your MAX SP will always be 100 unless you equip a SP UPGRADE CHIP.";
    text[10138] = "Using SHIELD BOOSTERS will not only increase your MAX SHIELDS,";
    text[10139] = "it will also increase the number of shields you start the battle with by 1!";
    text[10140] = "Please select a topic.";
    text[10141] = "LV and MAX HP";
    text[10142] = "MAX SP";
    text[10143] = "MAX SHIELDS";
    text[10146] = "There are a total of five different Enemy Attack Types!";
    text[10147] = "During 1-Panel Attacks, player movement is restricted and shielding is required!";
    text[10148] = "During 3-Panel Attacks, you can dodge enemy attacks by moving up and down!";
    text[10150] = "During 9-Panel Attacks, you can move in all four directions to dodge enemy attacks!";
    text[10151] = "A Soul Attack is a special attack type where your 'Soul' is represented with a heart.";
    text[10152] = "You can move your heart around to dodge enemy bullets and projectiles!";
    text[10153] = "During a Soul Attack, you can also use Shields if you're in a pinch!";
    text[10154] = "The last attack type is a Wave Attack.";
    text[10155] = "During Wave Attacks, you must use your left/right inputs to shield against";
    text[10156] = "several waves of projectiles!";
    text[10157] = "Note: Wave Attacks will not consume any of your shields.";
    text[10158] = "There is a Neural Link I really want to buy, but my LEVEL isn't high enough...";
    text[10159] = "You can learn so many new battle techniques using Neural Links, but...";
    text[10160] = "Without a properly trained body, you could end up hurting yourself.";
    text[10161] = "That's why it's important to train your body by leveling up!";
    text[10173] = "Initiating a Lux Combo";
    text[10174] = "Mastering Lux Combos";
    text[10175] = "Increasing Lux Combo Damage";
    text[10167] = "If you get damaged by an enemy attack, your Lux Meter will decrease!";
    text[10164] = "Once your Lux Meter is maxed out, you can initiate a Lux Combo from the Skills Menu!";
    text[10165] = "Select any three Active Skills to combine into a Lux Combo.";
    text[10163] = "There are a total of 30 Lux Combos you can discover and master!";
    text[10168] = "For a Lux Combo to be considered 'Mastered', you must use the combo at least twice.";
    text[10166] = "Try out different combinations or collect Lux Combo Recipes to master them all!";
    text[10162] = "The higher your level, the more damage your Lux Combo will do!";
    text[10170] = "Poison Panels";
    text[10171] = "Lava Panels";
    text[10172] = "Drench Panels";
    text[10169] = "Some enemies spawn Poison Panels during their attacks.";
    text[10176] = "If you stand on top of a Poison Panel you will slowly lose HP!";
    text[10179] = "Lava Panels are hot and explosive!";
    text[10180] = "You'll lose 50 HP if you step on a Lava Panel.";
    text[10181] = "The Lava Panel will disappear afterwards.";
    text[10182] = "Your Lux Meter will slowly decrease if you stand on top of a Drench Panel!";
    text[10183] = "Increasing your Affinity will also give you better discounts in Shops!";
    text[10186] = "If you land a CRITICAL HIT on an enemy, your PWR is multiplied by x1.5!";
    text[10187] = "SUPER CRITICAL HITS on the other hand, multiply your PWR by x3!";
    text[10188] = "Rimuru";
    text[10189] = "LV_Required:";
    text[10190] = "Your Level isn't high enough!";
    text[10191] = "Did you know you can customize the color of your Space Ship?";

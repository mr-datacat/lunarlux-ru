function scr_ru()
{
    //text[1] = "Hi Mom.";
    text[1] = "Привет, мам.";
    
    //text[2] = "It's been a few months since I officially joined the Lunex Force.";
    text[2] = "Уже несколько месяцев, как я стала частью Лунного Корпуса.";
    
    //text[3] = "So far, it's going really well!@P Protecting the citizens of Luna is such an amazing job.";
    text[3] = "Пока всё идёт хорошо!@P Мне нравится защищать жителей Луны.";
    
    //text[4] = "I finally understand how you must have felt.";
    text[4] = "Думаю, я наконец-то понимаю, что ты чувствовала.";
    
    //text[5] = "You were so cool;@P always instilling hope and courage in others.";
    text[5] = "Ты была такой крутой;@P всегда вселяла надежду и храбрость в других.";
    
    //text[6] = "Everyone looked up to you.@P \nYou were Luna's greatest warrior.";
    text[6] = "Все равнялись на тебя.@P \nТы была величайшей воительницей Луны.";
    
    //text[7] = "And@P.@P.@P. Even though you're in a better place now@P.@P.@P.";
    text[7] = "И@P.@P.@P. Хоть ты сейчас и не с нами@P.@P.@P.";
    
    //text[8] = "I'll make sure that hope is never lost!";
    text[8] = "Я позабочусь о том, чтобы надежда никогда не угасла!";
    
    //text[9] = "It won't be easy, but I'll do my best to become as strong and capable as you someday.";
    text[9] = "И сделаю всё возможное, чтобы однажды стать такой же сильной, как ты.";
    
    //text[10] = "Take care, Mom.@P \nI'll visit you again soon.";
    text[10] = "Пока, мам.@P \nСкоро я навещу тебя снова.";
    
    //text[11] = "Bellaaaa!";
    text[11] = "Беллаааа!";
    
    //text[12] = "Hehe, our ship is fully recharged!";
    text[12] = "Хехе, наш корабль полностью заряжен!";
    
    //text[13] = "Nice job, Tetra!";
    text[13] = "Отлично, Тетра!";
    
    //text[14] = "Do you want to head back home now?";
    text[14] = "Отправляемся домой?";
    
    //text[15] = "Let me check the schedule@P.@P.@P.";
    text[15] = "Сначала проверим расписание@P.@P.@P.";
    
    //text[16] = "Yup! I think Dad should be done with his meetings by the time we get back to the lab.";
    text[16] = "Да! Думаю, папа уже закончит со встречами, когда мы вернемся в лабораторию.";
    
    //text[17] = "Alrighty!";
    text[17] = "Океюшки!";
    
    //text[18] = "Our ship is docked at the South-East Hoverport.";
    text[18] = "Наш корабль припаркован в юго-восточном доке.";
    
    //text[19] = "Let's go go go!";
    text[19] = "Идём, идём, идём!";
    
    
    
    
    //text[20] = "Murk identified! CODENAME: HYPERBEE";
    text[20] = "Мёрк идентифицирован! КОДОВОЕ ИМЯ: ГИПЕРПЧЁЛ";
    
    //text[21] = "Mission Control, this is Bella Grey.";
    text[21] = "Центр Управления, говорит Белла Грей.";
    
    //text[22] = "I've encountered a hostile Murk in Sector 16.";
    text[22] = "Я столкнулась с враждебным Мёрком в Секторе 16.";
    
    //text[23] = "Requesting permission to engage!";
    text[23] = "Запрашиваю разрешение на устранение!";
    
    //text[24] = "@P.@P.@P.Understood!";
    text[24] = "@P.@P.@P.Поняла!";
    
    //text[25] = "Tetra! Let's gear up for battle!";
    text[25] = "Тетра! Готовься к бою!";
    
    //text[26] = "You got it!";
    text[26] = "Так точно!";
    
    //text[27] = "I'm sorry.";
    text[27] = "Прости.";
    
    //text[28] = "I wish there was a better way@P.@P.@P.";
    text[28] = "Я бы хотела, чтобы был другой способ@P.@P.@P.";
    
    //text[29] = "A way to communicate with the Murks and come to an understanding.";
    text[29] = "Способ, с помощью которого мы смогли бы понять друг друга.";
    
    //text[30] = "I hope one day we can coexist without bloodshed.";
    text[30] = "Надеюсь, однажды мы сможем существовать вместе без кровопролития.";
    
    //text[31] = "Bella, the Murks are scary@P.@P.@P.They eat up humans!";
    text[31] = "Белла, но Мёрки страшные@P.@P.@P. Они едят людей!";
    
    //text[32] = "They are just trying to survive.";
    text[32] = "Они просто пытаются выжить.";
    
    //text[33] = "At least their Anticores help us learn more about them!";
    text[33] = "По крайней мере их Антиядра помогают нам узнать о них больше!";
    
    //text[34] = "We can use Antimatter Tech and Vessels thanks to the Anticores, hehe.";
    text[34] = "Благодаря им мы можем использовать Оболочки и другие технологии на Антиматерии.";
    
    text[35] = "I still don't like it. It doesn't feel right to me@P.@P.@P.";
    text[35] = "Мне это всё ещё не нравится. Есть в подобном что-то неправильное@P.@P.@P.";
    
    //text[36] = "Mom would have tried to find another way@P.@P.@P.a way to create peace.";
    text[36] = "Мама попыталась бы найти другой способ@P.@P.@P. способ прийти к миру.";
    
    //text[37] = "Anyways@P.@P.@P. Let's do our best to protect the people of Luna!";
    text[37] = "В любом случае@P.@P.@P. Сделаем всё возможное, чтобы защитить жителей Луны!";
    
    //text[38] = "Right, Super Sidekick Tetra?";
    text[38] = "Да, Супер Напарник Тетра?";
    
    //text[39] = "YES YES! Hehe, Tetra will do her best!";
    text[39] = "ДА ДА! Хехе, Тетра сможет что угодно!";
    
    //text[40] = "Miss Bella!";
    text[40] = "Мисс Белла!";
    
    //text[41] = "Backup has arrived!";
    text[41] = "Подкрепление прибыло!";
    
    //text[42] = "Thanks for coming! The target has already been terminated.";
    text[42] = "Спасибо, что пришли! Цель уже ликвидирована.";
    
    //text[43] = "With the help of Ultimate Sidekick Tetra! Hehe.";
    text[43] = "С помощью Ультимативного Напарника Тетры! Хехе.";
    
    //text[44] = "Great job as always Miss Bella!";
    text[44] = "Как всегда, отличная работа, мисс Белла!";
    
    //text[45] = "I'm glad no civilians were nearby this time.";
    text[45] = "Хорошо, что в этот раз поблизости не было гражданских.";
    
    //text[46] = "The Murks can seemingly spawn anywhere cuz of those wormholes@P.@P.@P.";
    text[46] = "Мёрки по-видимому, могут появляться где угодно из-за червоточин@P.@P.@P.";
    
    //text[47] = "Do you ever wonder what their world is like through the wormholes?";
    text[47] = "Кто-нибудь задумывался, каков их мир, лежащий по ту сторону червоточин?";
    
    //text[48] = "I don't even want to think about it...";
    text[48] = "Даже думать об этом не хочу...";
    
    //text[49] = "Only former general Grey's Squad has ever returned from there.";
    text[49] = "Только отряд бывшего генерала Грей смог вернуться оттуда.";
    
    //text[50] = "I heard it's full of Murks everywhere!";
    text[50] = "Я слышал, там всё кишит Мёрками!";
    
    //text[51] = "Oh man, I'm getting shivers just thinking about it!";
    text[51] = "Ох, у меня мурашки от одной только мысли!";
    
    //text[52] = "Once you go into a wormhole, there is no coming back.";
    text[52] = "Стоит войти в червоточину — назад уже не вернёшься.";
    
    //text[53] = "Only a few have been to their world@P.@P.@P.and even fewer have returned alive.";
    text[53] = "Лишь немногие побывали в их мире — и ещё меньше вернулись оттуда живыми.";
    
    //text[54] = "Besides, Mission Control forbids unauthorized missions over there.";
    text[54] = "К тому же, Центр Управления запрещает несанкционированные миссии туда.";
    
    //text[55] = "C'mon, let's transport this Anticore back to HQ.";
    text[55] = "Давайте, доставим это Антиядро в штаб.";
    
    //text[56] = "(Again@P.@P.@P.This feeling.)";
    text[56] = "(Снова@P.@P.@P. Это чувство.)";
    
    //text[57] = "(I don't know what it is.)";
    text[57] = "(Не знаю, что это.)";
    
    //text[58] = "(Am I the only one who senses it?)";
    text[58] = "(Я правда единственная, кто это чувствует?)";
    
    //text[59] = "Wait.";
    text[59] = "Подождите.";
    
    //text[60] = "Let me transport the Anticore.";
    text[60] = "Давайте я доставлю Антиядро.";
    
    //text[61] = "Oh? Are you sure Miss Bella?";
    text[61] = "Но... Мисс Белла, вы уверены?";
    
    //text[62] = "It's your day off today! Please rest.";
    text[62] = "У вас ведь выходной! Лучше отдыхайте.";
    
    //text[63] = "No no, it's alright. I'll take care of it.";
    text[63] = "Нет, нет, всё в порядке. Я с этим разберусь.";
    
    //text[64] = "Very well Miss Bella. Thank you for your service.";
    text[64] = "Хорошо, мисс Белла. Благодарим вас за работу.";
    
    //text[66] = "We'll be patrolling the area in case any more Murks decide to show up.";
    text[66] = "Мы будем патрулировать этот район на случай, если появятся ещё Мёрки.";
    
    //text[67] = "Alright Tetra, let's zip!";
    text[67] = "Ну что, Тетра, пошли!";
    
    //text[68] = "Okie dokie!";
    text[68] = "Оки-доки!";
    
    
    
    
    //text[215] = "Silly Bella, our ship is to the east!";
    text[215] = "Глупышка Белла, наш корабль на востоке!";
    
    //text[216] = "Yah, I know. I can't help myself, I love exploring Luna!";
    text[216] = "Да, знаю. Ничего не могу с собой поделать — обожаю исследовать Луну!";
    
    
    
    
    text[217] = "Mmmm this aroma@P.@P.@P.";
    text[218] = "It's making me hungry!";
    text[219] = "Cheesecake Bars?";
    text[220] = "You know me well Tetra, heh.";
    text[221] = "Heh.";
    text[222] = "Let's head to the cafe for a bit before we head back to the ship.";
    text[223] = "Okie!";
    text[71] = "Welcome to Cafe Regolithia! What can I get for you today?";
    text[72] = "Hi, I'd like three cheesecake bars and an iced vanilla latte please.";
    text[73] = "You got it. Coming right up!";
    text[74] = "Woah, THREE cheescake bars?!";
    text[75] = "One for now.";
    text[76] = "One for later.";
    text[77] = "And one for later later?";
    text[78] = "Exactly.";
    text[79] = "Your order is ready ma'am. Here you go!";
    text[80] = "Don't worry about the payment. It's on the house!";
    text[81] = "Oh wow! Thank you so much!";
    text[82] = "No no, we should be thanking you!";
    text[83] = "When we got the warning signal that a Murk was outside, we were very worried.";
    text[84] = "If the Lunex Force wasn't here, who knows what damage the Murks would have caused.";
    text[85] = "We thank you for your service ma'am.";
    text[86] = "Aw, gosh... Thank you! We'll keep on doing our best.";
    text[224] = "Wait, I haven't finished my food yet! Let's stick around for a bit.";
    text[225] = "Alrighty.";
    text[226] = "The locals here are pretty friendly. Maybe we can chat with some of them?";
    text[391] = "Hey, have you heard the latest news regarding the Murk Slayer?";
    text[392] = "...No, what happened?";
    text[393] = "The locals here say they saw the Murk Slayer hunting down some Murks today.";
    text[394] = "The Murk didn't even stand a chance. It was killed with a single jab!";
    text[395] = "...Good thing the citizens weren't hurt at least.";
    text[396] = "There's only a handful of soldiers in the Lunex Force who can actually";
    text[397] = "hold their own in battle against a Murk without relying on Vessels.";
    text[398] = "Rumors say the Murk Slayer is in his early twenties.";
    text[399] = "Who knows, maybe we'll get that mask off someday and find out who it really is.";
    text[400] = "I wonder how he got so strong...";
    text[401] = "If I ever get the chance to meet him, I'll probably ask him.";
    text[402] = "...after we capture him of course.";
    text[227] = "Hey Bella.";
    text[228] = "Yeah?";
    text[229] = "Remember what the blue soldier said?";
    text[230] = "The Murk Slayer is in his twenties! He's close to your age hehe.";
    text[231] = "And...?";
    text[232] = "He's also very strong. Tetra remembers Bella saying she likes strong men.";
    text[233] = "Good boyfriend candidate! Adding to potential list@P.@P.@P.";
    text[234] = "Tetra!";
    text[235] = "You're embarassing...";
    text[236] = "I didn't know you kept a list of these things.";
    text[237] = "I have an entire collection of lists in my database! Hehe.";
    text[238] = "He might be strong, but I disagree with his actions.";
    text[239] = "He's a wanted vigilante who hunts Murks for their Anticores.";
    text[240] = "The Anticores are a valuable resource that we still don't fully understand...";
    text[241] = "and even though I don't like using them, we need them to learn more about the Murks.";
    text[242] = "We don't know what his motives are and that's why we need to catch him.";
    text[243] = "He's so dreamy...";
    text[244] = "(Sigh) C'mon let's get going.";
    text[87] = "Are you ready to head to the Lunex Space Station?";
    text[88] = "Bella, Murk detected!";
    text[89] = "Were you able to identify it?!";
    text[90] = "No, it was moving too fast.";
    text[91] = "That Hovercraft pilot is in danger!";
    text[92] = "The Hovercraft crash landed...!";
    text[93] = "Looks like the explosion came from the Barrier Facility.";
    text[94] = "C'mon Tetra we should go help! Let's zip!";
    text[95] = "OBJECTIVE: HEAD WEST TO INVESTIGATE THE BARRIER FACILITY.";
    text[96] = "Murk identified! CODENAME: GRIMROCK";
    text[98] = "Miss Bella! We're here to assist!";
    text[97] = "We've gotta protect the civilians at all costs!";
    text[99] = "Can we handle three Murks at once...?";
    text[100] = "Don't worry Tetra, we've got backup this time.";
    text[101] = "Bella, make sure you keep track of your remaining Holo Shields in battle!";
    text[102] = "Right!";
    text[103] = "Come on team! Let's show these Murks the power of the Lunex Force!";
    text[104] = "Aw, they didn't drop any Anticores this time...";
    text[105] = "(Huff)...(Huff)...Yeah@P.@P.@P.";
    text[106] = "Bella? Are you alright?";
    text[107] = "I'm fine.";
    text[108] = "We've got no time to waste, let's hurry to the Barrier Facility.";
    text[109] = "Are you sure you're okay...?";
    text[110] = "@P.@P.@P.Yup! Let's zip, we've gotta go help!";
    text[111] = "Huff@P.@P.@P.Huff@P.@P.@P.";
    text[112] = "@P.@P.@P.Gosh, it's getting kind of hard to breathe.";
    text[113] = "Uh oh...";
    text[114] = "Bella, oxygen levels are slowly decreasing!";
    text[115] = "The Astro-Barrier is in emergency-mode!?";
    text[116] = "There might have been a system breach...";
    text[117] = "Do you think the Murk that flew by earlier could have caused the breach?";
    text[118] = "Possibly...";
    text[119] = "We might have to fight against that Murk if we encounter it again...";
    text[120] = "Let's avoid killing any Murks unless it is absolutely necessary...";
    text[121] = "Alrighty.";
    text[122] = "The Astro-Barrier is the only thing keeping us from floating off into space.";
    text[123] = "It must be protected.";
    text[124] = "Let's go investigate!";
    text[306] = "Ugh...";
    text[307] = "Almost dying from a crash landing is enough stress for one day...";
    text[308] = "Oh no...";
    text[309] = "Ugh. I'm s-s-screwed.";
    text[310] = "How the heck am I going to f-fix this.";
    text[311] = "Excuse me, Hi!";
    text[312] = "My name's Bella! I'm with the Lunex Force.";
    text[313] = "We're here to help! Tell us what happened.";
    text[314] = "Oh th-thank goodness...";
    text[315] = "My name's Mett. I'm a Cargo Transporter.";
    text[316] = "Mett, take a deep breath and relax a bit. Everything will be okay.";
    text[317] = "Sorry Miss Bella, I t-tend to stutter under extreme stress...";
    text[318] = "Okay so, a s-scary flying Murk appeared out of nowhere,";
    text[319] = "while I was delivering a new shipment of Lunar Panels...";
    text[320] = "It damaged my Hovercraft, caused a power surge, and then disappeared...";
    text[321] = "The sudden power surge is what caused the Astro-Barrier to enter Emergency Mode...";
    text[322] = "Miss Bella!";
    text[323] = "We need to get into the access hatch that's underneath the Hovercraft...";
    text[324] = "in order to repair the damages and initiate a different protocol.";
    text[325] = "As it is right now, If we don't get access to that hatch, we'll be locked in Sector 16.";
    text[326] = "Hmmm...";
    text[327] = "(AHHHHHHHHHHHH OMG WHAT DO I DO?? I DONT KNOW HOW TO FIX A HOVERCRAFT!)";
    text[328] = "Don't worry Mett. Bella here is the daughter of the great Doctor Thomas.";
    text[329] = "A young prodigy in both combat AND wits hahahaha!";
    text[330] = "(Heh. Good thing I have a trusty sidekick to help me!)";
    text[331] = "Tetra, can't we communicate with the computer that's inside the Barrier Facility remotely?";
    text[332] = "The EM Towers are damaged so communication to the system is blocked.";
    text[333] = "Oh great...";
    text[334] = "How can we move the hovercraft?";
    text[335] = "Push it off!";
    text[336] = "Destroy it!";
    text[337] = "Fix the engine?";
    text[386] = "Tetra, Object Scan!";
    text[387] = "Okie! Give me like, 2 milliseconds...";
    text[338] = "Done!";
    text[339] = "How heavy is the Hovercraft?";
    text[340] = "100 tons!";
    text[341] = "Ooof...Nevermind.";
    text[342] = "I thought we could maybe push it to get access to the hatch underneath.";
    text[343] = "100 tons is too heavy.";
    text[344] = "We'll need exactly 20 Tetras to push it!";
    text[345] = "There's probably a more do-able solution.";
    text[346] = "What if we destroy the Hovercraft?";
    text[347] = "KABOOM!";
    text[348] = "H-hey! L-let's not get hasty. The ship is company property...";
    text[349] = "The lives of the people are worth more than one broken Hovercraft.";
    text[350] = "Hmmm...";
    text[351] = "This entire area is extremely volatile.";
    text[352] = "Right now the Oxygen inside the Astro-Barrier is unstable.";
    text[353] = "Remember: Fires consume oxygen. We have to avoid causing explosions or fires.";
    text[354] = "Destroying the ship is not the solution.";
    text[355] = "Th-thank goodness whew...";
    text[356] = "You're right Miss Bella, I forgot...";
    text[357] = "Is there a way to fix the engine?";
    text[358] = "Wait, I just remembered something!";
    text[359] = "My Hovercraft is a Model-N Supply Carrier...";
    text[360] = "...which means the gravity propulsion system is electrically powered.";
    text[361] = "Although the battery connection and starting mechanism is busted...";
    text[362] = "If we can somehow pump some electricity into the engine core,";
    text[363] = "we should be able to re-energize it and get it working again...";
    text[364] = "Afterwards, you guys will be able to get access to the hatch.";
    text[365] = "Electricity @P. @P. @P. @P. @P.";
    text[366] = "ZAP ZAP!";
    text[367] = "Okay I have an idea!";
    text[368] = "Lunar Panels!";
    text[369] = "Ahhh! I see. Lunar Panels generate electricity!";
    text[370] = "Th-that just might work!";
    text[371] = "It HAS to. I can't think of anything else.";
    text[372] = "The problem is, I have no clue how to connect or install Lunar Panels...";
    text[373] = "Time to zip. Let's go find someone who can help us.";
    text[374] = "S-Sorry for all the trouble...";
    text[375] = "Don't worry Mett, it's not your fault.";
    text[376] = "Bella! Two Murks detected!";
    text[377] = "AHHHH...M-Murks?!";
    text[378] = "Aughhhh....";
    text[379] = "S-Sorry, I@P.@P.@P. I@P.@P.@P.";
    text[380] = "I'm absolutely terrified of these monsters...";
    text[381] = "Mett, stay here where it's safe. I'll take care of it. Don't worry.";
    text[382] = "Guys, take care of Mett please. I'll handle this!";
    text[383] = "Of course! You can count on us Miss Bella.";
    text[384] = "We'll only get in your way if we try to fight it with you.";
    text[385] = "If I need backup, I'll let ya know pronto!";
    text[125] = "That's enough!";
    text[126] = "Wait a second@P.@P.@P.You're...!";
    text[127] = "You're the Murk Slayer!";
    text[128] = "Don't move! You're under arrest!";
    text[129] = "Return the Anticore that's in your possession!";
    text[130] = "Ignorance is bliss, isn't it?";
    text[131] = "What are you talking about?";
    text[132] = "Do you sense it?";
    text[133] = "It mourns.";
    text[134] = "It suffers.";
    text[135] = "It's overcome with grief,";
    text[136] = "and overwhelming pain.";
    text[137] = "The Murks...must be freed from this suffering.";
    text[138] = "I will never trust the Anticores with the likes of you.";
    text[139] = "What...?!";
    text[140] = "I don't understand. If you can sense their suffering, why hunt them down?";
    text[141] = "What are you doing with all the Anticores you collect?";
    text[142] = "I don't need to tell you anything.";
    text[143] = "Don't get in my way.";
    text[144] = "Wait!";
    text[145] = "He escaped...";
    text[146] = "Bella, the Murk!";
    text[147] = "It looks like that Murk is really angry!";
    text[148] = "There's no time to waste! We have to chase after it!";
    text[149] = "OBJECTIVE: LOCATE AND CAPTURE THE RAMPAGING MURK!";
    text[150] = "There it is! We have to calm it down!";
    text[151] = "Tetra, it's Sidekick Time!";
    text[152] = "Ultra Sidekick Time!";
    text[153] = "The Murk got away!";
    text[154] = "(Huff)...(Huff)...It's okay@P.@P.@P.";
    text[155] = "Let's not worry about it right now.";
    text[156] = "I don't think it will come back any time soon.";
    text[157] = "Tetra, what's the Oxygen Level?";
    text[158] = "@P.@P.@P.@P96%!";
    text[159] = "Tetra is confused. There is still enough oxygen.";
    text[160] = "You shouldn't have any trouble breathing right now.";
    text[161] = "Bella, I'm going to scan you...";
    text[162] = "BELLA!";
    text[163] = "I'm sorry...";
    text[164] = "All this fighting...";
    text[165] = "All this suffering...";
    text[166] = "There has to be a way...";
    text[167] = "There must be.";
    text[168] = "I...";
    text[169] = "I've killed so many Murks.";
    text[170] = "I'm really sorry...";
    text[171] = "If I had to choose between sparing you or saving humanity...";
    text[172] = "I'm forced to save humanity...";
    text[173] = "...because it's my sworn duty to protect the people of Luna.";
    text[174] = "You're monsters.";
    text[175] = "We're humans.";
    text[176] = "But that doesn't mean we have to kill each other in order to survive.";
    text[177] = ".@P .@P .@P .@P .@P right?";
    text[178] = "Mom@P.@P.@P.";
    text[179] = "What did you discover about these creatures?";
    text[180] = "I wish you had the chance to tell me...";
    text[181] = "BELLAAAAAAAA !!!";
    text[182] = "You're finally awake! You passed out...";
    text[183] = "Hi Tetra...";
    text[184] = "Hmph. You've been dishonest with Tetra...";
    text[185] = "You didn't faint because of the oxygen levels...";
    text[186] = "This whole time, you were wounded...";
    text[187] = "Eheheh, Yeah...";
    text[188] = "It happened during our fight with the three Grimrocks.";
    text[189] = "Why didn't you say anything?";
    text[190] = "Tetra was worried...";
    text[191] = "I'm sorry...";
    text[192] = "We had to investigate the Hovercraft situation and...";
    text[193] = "I guess I thought I could tough it out.";
    text[194] = "Is Tetra a bad sidekick?...";
    text[195] = "No no! It's my fault Tetra.";
    text[196] = "I should have at least taken the time to clean up my wound.";
    text[197] = "You're the best Fix-Me-Up Sidekick ever!";
    text[198] = "Okay... Don't scare me like that next time.";
    text[199] = "If Doctor Thomas was here he would say 'Thats my Bella!'";
    text[200] = "'Always reckless as ever.'";
    text[201] = "'But the power of her heart and soul is unrivaled.'";
    text[202] = "'That's what makes her a true hero for the People of Luna.'";
    text[203] = "Dad is so embarassing... (Heheh)";
    text[204] = "Wait, how long have I been unconscious?";
    text[205] = "Exactly 48 minutes and 37 seconds.";
    text[206] = "Oxygen Level?";
    text[207] = "79%!";
    text[208] = "Oof. Okay, let's not waste any more time.";
    text[209] = "We have a mission to complete!";
    text[210] = "Okie!";
    text[211] = "I feel much better now. Thanks for taking care of me Tetra.";
    text[212] = "Heh.";
    text[213] = "MISSION: JUMP-START THE HOVERCRAFT ENGINE AND FIX THE ASTRO-BARRIER!";
    text[214] = "FIRST FIND SOMEONE WHO CAN HELP YOU OBTAIN LUNAR PANELS!";
    text[415] = "Ahh, Bella! Nice to see you dear.";
    text[416] = "Oh! Hi Miss Nyla! What brings you here?";
    text[417] = "I was called over here for some Lunar Panel inspections and field work.";
    text[418] = "Your father and I recently developed a new Lunar Panel model and";
    text[419] = "it needs to be tested for efficiency.";
    text[420] = "We're waiting for a few more panels@P.@P.@P.";
    text[421] = "but the Shipment Hovercraft seems to be running late@P.@P.@P.";
    text[422] = "Anyways, it's nice to be working outside of the Space Station once in a while.";
    text[423] = "We live in a time where technology truly shines,";
    text[424] = "and yet, there's so much more for us to discover.";
    text[425] = "If you need anything dear, let me know.";
    text[426] = "Alright, thanks Miss Nyla!";
    text[427] = "Ahh, Bella! How's it going dear?";
    text[428] = "Miss Nyla, we need your help!";
    text[429] = "You're an expert on Lunar Panels right?";
    text[430] = "Ahh, yes dear.";
    text[431] = "Alright, here's the situation...";
    text[432] = "I see. Well, you came to the right person!";
    text[433] = "So, is it possible to use Lunar Panels to jump-start the Hovercraft?";
    text[434] = "Hmm...";
    text[435] = "It's definitely possible.";
    text[436] = "Here's what we need: 10 Lunar Panels and 1 Thermo-Electric Generator!";
    text[437] = "Thats... oddly specific. Where are we supposed to get a generator?";
    text[438] = "My dear, this is Regolithia!";
    text[439] = "We're on the outskirts of Tycho, the scientific capital of Luna.";
    text[440] = "This sector is a popular destination for Astrotech Traders.";
    text[441] = "They often sell various goods and tech that you can't find anywhere else!";
    text[442] = "Try looking for an Astrotech Trader in the Barrier Facility!";
    text[443] = "As for Lunar Panels, I believe we have enough spare ones in the Storage Unit.";
    text[444] = "The Storage Unit is located south from here.";
    text[445] = "Take this...";
    text[500] = "YOU CAN NOW ACCESS STORAGE UNIT 003.";
    text[501] = "Bella, I stored the information from Miss Nyla in my memory banks.";
    text[502] = "Talk to me in case you forget what we need!";
    text[503] = "I'm 100 percent sure this will work.";
    text[504] = "No@P.@P.@P. Scratch that.";
    text[505] = "I'm 10 billion percent sure!";
    text[506] = "Thanks so much for your help Miss Nyla!";
    text[507] = "Of course, dear.";
    text[508] = "Come see me once you've gathered the Panels and the Generator.";
    text[509] = "If you want, I can even teach you a thing or two about how the Panels work!";
    text[510] = "Eh heh... I'm not really a science wiz so I'll leave that stuff to you.";
    text[511] = "Alright dear, I'll wait for you here.";
    text[696] = "I got all the Lunar Panels!";
    text[697] = "Did you get the Generator from the Astrotech Trader as well?";
    text[698] = "Oh no... I don't have the Generator yet!";
    text[699] = "No worries dear, I'm still finishing up my calculations anyways.";
    text[700] = "Once you get the Generator, we'll have everything we need.";
    text[446] = "Are you curious about how Lunar Panels work?";
    text[447] = "Maybe next time.";
    text[448] = "Splendid!! I'm thrilled you want to know more!";
    text[449] = "Lunar Panels solve the problem that Solar Panels have been";
    text[450] = "plagued with for centuries.";
    text[451] = "They can generate electricity in both sunlight AND darkness!";
    text[452] = "Woah! So they absorb darkness?";
    text[453] = "Not exactly, my dear.";
    text[454] = "Lunar Panels can generate electricity due to the";
    text[455] = "ambient temperature difference during our cold Lunar nights.";
    text[456] = "Lunar nights and Lunar days last about 14 days each.";
    text[457] = "That means for 14 days we face away from our brilliant blue sun.";
    text[458] = "A few decades ago this was a serious issue.";
    text[459] = "Our Solar Panels were useless during Lunar nights.";
    text[460] = "However...!";
    text[461] = "Thanks to the efforts of the brilliant minds at Lunex Labs,";
    text[462] = "including your father of course, we were able to invent the Lunar Panel!";
    text[463] = "Through a process known as radiative cooling,";
    text[464] = "we harnessed the temperature difference between Luna and outer space.";
    text[465] = "Radiative cooling + aluminum alloy + Thermo-Electric Generator...";
    text[466] = "Our formula for the creation of the Lunar Panel was complete.";
    text[467] = "Science is pretty cool!";
    text[468] = "I'm grateful for the technology that has helped humanity survive on Luna.";
    text[469] = "How many Lunar Panels did you find so far?";
    text[470] = "8!";
    text[471] = "You're almost there!";
    text[472] = "All of the Panels can be found in the Storage Unit.";
    text[473] = "I remember there were a few hidden corridors in there...";
    text[474] = "Make sure you examine the area thoroughly!";
    text[475] = "How many Lunar Panels did you find so far?";
    text[476] = "9!";
    text[477] = "I mean, it's close enough right?";
    text[478] = "But, we need 10 dear.";
    text[479] = "Are you sure we can't get by with 9?";
    text[480] = "I'm sure.";
    text[481] = "100 percent?";
    text[482] = "1 billion percent.";
    text[483] = "It's not 10 billion percent...That means you're unsure.";
    text[484] = "I'll double check my calculation again, just in case.";
    text[485] = "We still need 10 though.";
    text[486] = "Alrighty, I'll go find the last one.";
    text[487] = "I got all the items!!";
    text[488] = "Marvelous! You've done well!";
    text[489] = "I drew up a schematic while you were gone.";
    text[490] = "Connecting the Lunar Panels to the Engine Core should be easy!";
    text[491] = "After doing some calculations,";
    text[492] = "It turns out, 9 Lunar Panels should be sufficient.";
    text[493] = "You can keep the extra one as a souvenir!";
    text[494] = "You never know, it might come in handy again someday.";
    text[495] = ".@P.@P.@P.@P.";
    text[496] = "Oh my, the air is starting to feel thinner and thinner!";
    text[497] = "Time is short dear.";
    text[498] = "I'll meet up with you at the Hovercraft once I gather all my tools!";
    text[518] = "Hmm... Looks like this door has an electronic lock.";
    text[519] = "There should be a control panel around here somewhere...";
    text[520] = "If we find the control panel, I can dive into the network! Hehe.";
    text[525] = "This control panel seems to be on but it's not responding...";
    text[526] = "Bella, I think there is a software glitch.";
    text[527] = "I can digitally dive into the Network and reboot the software!";
    text[528] = "Have Tetra dive into the Control Panel Network?";
    text[529] = "The Network has already been restored.";
    text[1339] = "I wasn't able to reboot the network...";
    text[1340] = "It's okay Tetra, you can always try again.";
    text[1341] = "I believe in you!";
    text[249] = "Bella, this looks like a dead end...";
    text[250] = "...and the Arrow Tiles are preventing us from going back.";
    text[251] = "Are we trapped?!";
    text[252] = "Hmm...No, I bet there's a way through.";
    text[253] = "We just have to find it.";
    text[254] = "Woah, a hidden path!";
    text[255] = "See Tetra, I told you theres a way through, heh.";
    text[256] = "Heh.";
    text[701] = "Wait, Bella! I have an idea!";
    text[702] = "If you activate your Jet Suit, you can get around much faster.";
    text[703] = "We'll save lots and lots of time! Hehe.";
    text[704] = "Oh! You're right! Gosh, why didn't I think of that sooner.";
    text[705] = "There's a Jet Pad nearby! Let's check it out!";
    text[706] = "JET PADS ALLOW AUTHORIZED USERS TO FLY AROUND LUNA USING JET SUITS!";
    text[707] = "LUNAR LAW PROHIBITS UNLICENSED USERS FROM ACTIVATING THEIR JET SUITS";
    text[708] = "WITHOUT A JET PAD.";
    text[709] = "USE YOUR JET SUIT TO EXPAND YOUR WORLD!";
    text[710] = "BUT...UH...";
    text[711] = "IT APPEARS YOUR FLIGHT CHIP HAS BEEN DAMAGED.";
    text[712] = "ACCESS DENIED.";
    text[713] = "Oh shoot. My Flight Chip probably got damaged from our Murk Battles...";
    text[714] = "I need to get it fixed or find a new one.";
    text[715] = "Bella, let's look for merchants in the Barrier Facility.";
    text[716] = "I bet an Astrotech Trader might have some Flight Chips!";
    text[717] = "Alright, I guess we're going on foot for now.";
    text[961] = "Ohh... I really hope this works...";
    text[962] = "It will my dear, don't worry. The power of science is amazing!";
    text[963] = "Alright everyone.";
    text[964] = "Everything should be set up and good to go.";
    text[965] = "Mett dear, get ready to pilot the Hovercraft!";
    text[966] = "Re-Charging the Engine Core in...";
    text[967] = "...3";
    text[968] = "...2";
    text[969] = "...1!";
    text[970] = "Alright! There's the hatch. Time to make those repairs!";
    text[971] = "30 Minutes Later...";
    text[972] = "Looks like everything is under control now. That's such a relief!";
    text[973] = "I've called a few engineers over to help me quantify the extent of the damages.";
    text[974] = "Thanks, Miss Nyla!";
    text[975] = "Your efforts were admirable, dear.";
    text[976] = "Using Lunar Panels was your idea after all.";
    text[977] = "You did great too, Tetra!";
    text[978] = "Giga-Ultra Sidekick Tetra, hehe.";
    text[979] = "Th-Thank you! I might have lost my job today if it weren't for your help.";
    text[980] = "This...";
    text[981] = "This wouldn't have happened if it weren't for the Murks...";
    text[982] = "Yeah.@P.@P.@P.@P.";
    text[983] = "We should get going. I'm pretty worn out.";
    text[984] = "Thanks so much for your hard work everyone!";
    text[985] = "Let's go, Tetra.";
    text[1365] = "...";
    text[986] = "Tetra, something doesn't feel right.";
    text[987] = "It's been on my mind for a while now.";
    text[988] = "We never really found the Murk that attacked Mett...";
    text[989] = "Not only that, I've had this strange feeling we're being watched...";
    text[990] = "Tetra.@P.@P.@P?";
    text[991] = "WHERE'S TETRA?!";
    text[992] = "TETRAAAAAA!!!";
    text[993] = "...Where am I?";
    text[994] = "Is this a dream?";
    text[995] = "No. This feels too real.";
    text[996] = "This must be... ";
    text[997] = "The world behind the wormholes.";
    text[998] = "...The Phantom Realm.";
    text[999] = "Why did the Murk bring me here...?";
    text[1000] = "TETRA!";
    text[1001] = "My locator says she's nearby...!";
    text[1002] = "I have to find Tetra and get out of here!";
    text[1366] = "OBJECTIVE: FIND TETRA AND ESCAPE FROM THE PHANTOM REALM.";
    text[1003] = "Tetra! Thank goodness you're okay!!";
    text[1004] = "Bella! Tetra is super duper glad to see you!!";
    text[1005] = "I detected the Murk that attacked Mett's Hovercraft and suddenly,";
    text[1006] = "Tetra fell into a wormhole and got transported to this scary place...";
    text[1007] = "Is this...the Phantom Realm...?";
    text[1008] = "I'm not sure, but that would be my guess.";
    text[1373] = "If the higher ups find out about this, we're gonna get in big trouble...";
    text[1378] = "We'll be in even bigger trouble if we can't find a way out!";
    text[1374] = "I know. It's not like we had a choice to come here...";
    text[1375] = "I can't get it off my mind... Why did the Murk bring us here?";
    text[1376] = "Maybe it wants to kill us and feed us to its friends?!";
    text[1377] = "Robots don't taste yummy, so I'm more worried for you Bella.";
    text[1372] = "It isn't safe for us here.";
    text[1379] = "Don't worry, Tetra.";
    text[1009] = "Mom would go on Phantom Realm expeditions with her squad from time to time, remember?";
    text[1010] = "She never told me much about this place but, there's definitely a way out.";
    text[1011] = "Tetra, what's our coordinates?";
    text[1012] = "Coordinates UNKNOWN...";
    text[1013] = "Yup, we're definitely not on Luna anymore...";
    text[1014] = "Dang it...";
    text[1015] = "I have so many questions...";
    text[1016] = "But, we don't have time to sit around and do nothing.";
    text[1017] = "This place is extremely dangerous...";
    text[1018] = "Let's find a way out.";
    text[1019] = "You can count on me!";
    text[1020] = "Phantom Expedition Sidekick Tetra is ready!";
    text[1381] = "(Again... What is this strange feeling I'm having?)";
    text[1382] = "(It feels as if someone is calling me from far away.)";
    text[1383] = "(A voice...?)";
    text[1384] = "(...)";
    text[1385] = "Bella, we're in enemy territory now. I'm detecting multiple Murks in the area.";
    text[1386] = "It's coming from those purple rifts.";
    text[1387] = "Alright, we'll have to be careful.";
    text[1388] = "...";
    text[1389] = "Is it just me or does this area feel strangely familiar...";
    text[1390] = "What do you mean?";
    text[1391] = "...It feels like we're in Regolithia.";
    text[1392] = "Woah! But that's impossible!";
    text[1393] = "If my hunch is correct, the monolith should be around here somewhere.";
    text[1394] = "Let's keep going.";
    text[1395] = "There it is! There's a monolith here too!";
    text[1396] = "But... how?!";
    text[1397] = "....!";
    text[1398] = "AHHH! THAT WAS FAST!";
    text[1402] = "That's the Murk that brought us here!";
    text[1403] = "(...)";
    text[1404] = "(That Murk sounded like it was crying in pain...)";
    text[1405] = "(My instincts are telling me to run, but my heart,)";
    text[1406] = "(...my soul...)";
    text[1407] = "(..is telling me something else.)";
    text[1399] = "Tetra... We gotta stay sharp and keep moving.";
    text[1400] = "I think I have a plan to get us back to Luna.";
    text[1401] = "Let's zip!";
    text[1408] = "So we finally meet.";
    text[1409] = "This Murk looks pretty tough.";
    text[1410] = "Bella, we don't have this Murk in the database!";
    text[1411] = "This one is a new variant! CODENAME ASSIGNED: CHRONOS!";
    text[1420] = "Its power is greater than any Murk we've faced before!";
    text[1421] = "Shoot...";
    text[1422] = "Instead of fighting it, can't we try to reason with it?";
    text[1423] = "Huh?!";
    text[1424] = "Murk! Why did you bring us here?";
    text[1425] = "Do you understand anything I'm saying?";
    text[1426] = "Please say something...!";
    text[1427] = "Bella, it's no use.";
    text[1428] = "We can't communicate with it...";
    text[1429] = "I know but...";
    text[1461] = "Wait, what's the Murk doing? It's just staring at us...";
    text[1462] = "It's making me nervous.";
    text[1463] = "It's observing us. Maybe it's waiting to see what we'll do.";
    text[1464] = "There must be a reason why it brought us here...";
    text[1465] = "I don't know what that reason is but,";
    text[1466] = "maybe it's testing us...";
    text[1467] = "Bella that sounds silly.";
    text[1468] = "I think it's waiting for us to run away so it can swoop in and EAT US!";
    text[1469] = "Mmm, I don't think so. It would have done it by now.";
    text[1470] = "This Murk is @P.@P.@P.@P. different.";
    text[1438] = "Bella, the Murk looks impatient!";
    text[1439] = "It could attack at any moment!";
    text[1440] = "Even if this Murk is strong, it's still no match for the two of us.";
    text[1441] = "Alright Tetra. The plan is simple: We tire it out by fighting it.";
    text[1442] = "At some point it might try to flee through a wormhole.";
    text[1443] = "That's when we'll make our escape!";
    text[1444] = "What if the wormhole doesn't lead us back home?";
    text[1445] = "Then we'll find one that does. Lunex Warriors never give up. Right, Tetra?";
    text[1446] = "Right! We won't stop until we succeed! Mwahaha!";
    text[1447] = "If this Murk goes back to Luna we'll have more problems on our hands.";
    text[1448] = "At least we can fight here without worrying about anyone getting hurt.";
    text[1449] = "Are you ready Tetra?";
    text[1450] = "Murk Buster Tetra is ready!";
    text[1451] = "This is it...";
    text[1452] = "I'm gonna have to go all out!";
    text[1453] = "Listen up Murk!";
    text[1454] = "I won't let you threaten my people.";
    text[1455] = "I won't let you wreak havoc on Luna!";
    text[1456] = "I don't know why you brought us here, but one thing is for sure.";
    text[1457] = "We won't go down without a fight!";
    text[1458] = "Never underestimate a Lunex Warrior!";
    text[1459] = "Looks like it finally calmed down.";
    text[1460] = "...?";
    text[1473] = "(It's happening again...!)";
    text[1474] = "@P. @P. P@P. @P. r@P. @P.";
    text[1475] = "@P. P@P. r@P. @P. o@P. @P. t@P. e@P. @P. ct@P.";
    text[1476] = "(Protect...?)";
    text[1477] = "(This voice...!)";
    text[1478] = "(It's the same voice from earlier!)";
    text[1479] = "(Can you... understand me?)";
    text[1480] = "Bella, look out! More Murks!";
    text[1481] = "Shoot, we're surrounded...!";
    text[1482] = "Our battle must have caught their attention.";
    text[1483] = "I'm detecting massive energy build-up!";
    text[1484] = "...!";
    text[1485] = "Holo Shield Overload!";
    text[1486] = "Bella are you okay?!";
    text[1487] = "I'm...okay...";
    text[1488] = "I used up all my Holo Shields...";
    text[1489] = "Huff... Huff...";
    text[1490] = "Guhhh... That was too close...";
    text[1491] = "I.@P.@P.@P.@P I can't move a muscle...";
    text[1492] = "Stay back! How dare you hurt Bella!";
    text[1493] = "Tetra... don't provoke them. ";
    text[1494] = "Stay by my side.";
    text[1495] = "Huff... Huff...";
    text[1496] = "We can't give up... no matter what!";
    text[1497] = "AHHHHHHHHHHHHHHHHHHHHH!!";
    text[1498] = "We're back on Luna!";
    text[1499] = "That was SCARY...";
    text[1500] = "I thought we were gonna DIE...";
    text[1501] = "Yeah, that was such a close call...";
    text[1502] = "Bella look over there! A red anticore!";
    text[1503] = "It's Chronos' anticore...";
    text[1504] = "Chronos sacrificed its life to save us...";
    text[1505] = "Yeah...";
    text[1506] = "We misunderstood Chronos' intentions.";
    text[1507] = "I think it wanted our help.";
    text[1508] = "How could you tell?";
    text[1509] = "It's hard to explain.";
    text[1510] = "I could sense Chronos' pain.";
    text[1511] = "I felt it in my soul.";
    text[1512] = "It might be related to the strange feelings I've been having lately...";
    text[1513] = "Bellaaaaaa, you neeed to tell me these type of things instead of keeping it to yourself!";
    text[1514] = "Yeah, I know... I know..";
    text[1515] = "Who knows what effects the Phantom Realm had on your body.";
    text[1516] = "There was antimatter EVERYWHERE!";
    text[1517] = "We should get Doctor Thomas to examine you! Tetra is starting to get worried...";
    text[1518] = "Nooooo!";
    text[1519] = "Huh? Why not?";
    text[1520] = "Even if it wasn't our choice, we violated protocol by going to the Phantom Realm.";
    text[1521] = "I don't want to get in trouble...";
    text[1522] = "I'll make sure to heal up in the Healing Chamber back at the station!";
    text[1523] = "Tetra, we have to keep this a secret.";
    text[1524] = "Promise me.";
    text[1525] = "...";
    text[1526] = "Okay, I promise.";
    text[1527] = "...but if I see any strange activity in your vital scans, we have to tell Doctor Thomas.";
    text[1528] = "Alright.";
    text[1529] = "I know we're supposed to transfer Anticores back to HQ but...";
    text[1530] = "I think I'm going to hold on to the Anticores we obtain from now on.";
    text[1531] = "Okie! Now we have 2 Anticores with us, heh.";
    text[1532] = "Chronos...";
    text[1533] = "Thank you...";
    text[1534] = "Thank you for protecting us, Chronos!";
    text[1535] = "@P.@P.@P.@P.@P.@P.";
    text[1536] = "'Protect'@P.@P.@P.";
    text[1537] = "That reminds me, did you hear Chronos speak?";
    text[1538] = "Wh-wha?! It spoke? I didn't hear anything.";
    text[1539] = "Hmm... it might've been telepathic communication.";
    text[1540] = "Makes me wonder if all Murks have this ability...";
    text[1541] = "Strange...";
    text[1542] = "Chronos' voice didn't sound like any voice I've ever heard before,";
    text[1543] = "yet, it felt oddly familiar.";
    text[1544] = "...";
    text[1545] = "If I can someday learn to communicate with the Murks,";
    text[1546] = "maybe we can find the peace we've been striving for.";
    text[1547] = "Looks like we learned some valuable information today about the Murks! Heh.";
    text[1548] = "There's still so much we don't know though.";
    text[1549] = "This journey... is just beginning.";
    text[1550] = "(Mom, please watch over us.)";
    text[1551] = "(I'll do my best to protect the People of Luna.)";
    text[1552] = "C'mon Tetra. We should get some rest.";
    text[1553] = "Let's finally head home.";
    text[1554] = "Alrighty! Our ship should still be parked at the South-East Hoverport!";
    text[1555] = "Let's go go go!";
    text[1579] = "OBJECTIVE: USE YOUR SHIP AT THE SOUTH-EAST HOVERPORT AND HEAD TO";
    text[1580] = "THE LUNEX SPACE STATION!";
    text[8472] = "We're back in the Phantom Realm...";
    text[8473] = "Bella, we shouldn't be here...";
    text[8474] = "It's dangerous, remember?";
    text[8475] = "I know, we'll leave soon...";
    text[8476] = "Hmm...";
    text[8477] = "I wonder if the Lunex Force is aware of this entrance?";
    text[8478] = "I recall seeing strange wall engravings in a few places on Luna.";
    text[8479] = "That means there's more entrances to the Phantom Realm we don't know about...";
    text[8480] = "I'd like to learn more about this place someday...";
    text[8481] = "After all, Mom used to go on expeditions in the Phantom Realm.";
    text[8482] = "It's easy to be scared of things we don't understand.";
    text[8487] = "The more we learn about this place, the safer it will be to explore!";
    text[8483] = "Don't you agree, Tetra?";
    text[8484] = "Yeah... I guess...";
    text[8485] = "Just be careful, okay?";
    text[8486] = "Don't worry, I will!";
    text[1583] = "Is that Chronos?!";
    text[1584] = "No, that's a Phantom.";
    text[1585] = "Boss Murks expel so much antimatter that even after they are defeated,";
    text[1586] = "their excess antimatter can sometimes form into a Phantom.";
    text[1593] = "It's essentially a violent cluster of energy that takes the form of a Boss Murk.";
    text[1587] = "Before Phantoms awaken, they accumulate tons of antimatter from their surroundings,";
    text[1588] = "which can make them stronger than their original counterpart.";
    text[1589] = "Woah, Tetra, where did you get this information?!";
    text[1590] = "It's from Doctor Thomas' restricted archives.";
    text[1591] = "I may or may not have secretly downloaded some of the files...heh.";
    text[1592] = "Anyways, we've got a Phantom to deal with right now!";
    text[1594] = "Phantom-Buster Sidekick Tetra is ready for battle!";
    text[1706] = "Good Morning Doctor Thomas!";
    text[1712] = "Myeheh, your weekly report is ready.";
    text[1713] = "...";
    text[1714] = "Doctor Thomas?";
    text[1715] = "Beautiful, isnt it?";
    text[1716] = "Luna is always a sight to behold!";
    text[1717] = "Mmmyes indeed! Quite a sight to behold, Myeheh.";
    text[1718] = "Humanity has come so far...";
    text[1719] = "...and yet, there is so much more to learn and discover.";
    text[1720] = "The boundless potential we have...";
    text[1721] = "is ASTRONOMICAL!";
    text[1722] = "Mmmyes truly astronomical!";
    text[1723] = "Reeves, summary please.";
    text[1724] = "There were 7 Murk incidents this week. Thankfully no casualties...";
    text[1725] = "Furthermore, Kepler Ranch has had a decrease in food production.";
    text[1726] = "These unpredictable Murks are destroying our infrastructure...";
    text[1727] = "The damaged farm and food sectors may take a while to rebuild.";
    text[1728] = "At this rate, we may not even last decades, myeh...";
    text[1729] = "We must never give up, Reeves. The people have placed their trust in us.";
    text[1730] = "Science has gotten us this far.";
    text[1731] = "We will continue to research the Murks and innovate our technologies!";
    text[1732] = "It's our duty to ensure future generations can live in prosperity!";
    text[1733] = "CODE RED - UNIDENTIFIED ASTRAL BODY DETECTED!";
    text[1735] = "Nyla, what's the situation?";
    text[1736] = "Our sensors have picked up a massive comet!";
    text[1737] = "Let me confirm the approximate coordinates@P.@P.@P.@P";
    text[1738] = "Estimated time of contact is about 377 days...";
    text[1739] = "It's on a direct collision course towards Luna!";
    text[1740] = "Impossible! Something this close should have been detected sooner!";
    text[1741] = "Our sensors should be working properly...";
    text[1742] = ".@P.@P.@P.@P.@P.@P.Unless...!";
    text[1743] = "Reeves, what does the molecular scan show?";
    text[1744] = "...!";
    text[1745] = "Doctor, we're detecting massive levels of positron emissions...";
    text[1746] = "Positrons?! This can't be...";
    text[1747] = "It's made of antimatter!";
    text[1748] = "APOCALYPSIS!";
    text[1749] = "Our predictions estimated another thousand years before it would return...";
    text[1750] = "How large is it?";
    text[1751] = "Myeheh..! Doctor, it's about 2000 km in diameter.";
    text[1752] = "Astronomical... This comet is half the size of Luna!";
    text[1753] = "Looks like it completed its irregular orbit much sooner than we expected.";
    text[1754] = "Thomas, could this be...?";
    text[1755] = "Yes, I'm afraid it is.";
    text[1756] = "This... is the comet that phased through Terra a thousand years ago,";
    text[1757] = "and nearly succeeded in wiping out humanity.";
    text[1758] = "Comet Coda has returned.";
    text[1759] = "...and we have only one year to figure out how to avert catastrophe...";
    text[1760] = "I have a plan.";
    text[1761] = "Reeves.";
    text[1762] = "Nyla.";
    text[1763] = "Emergency meeting in my Lab.";
    text[1764] = "Send a report to General Saros and send a request for his attendance.";
    text[1765] = "And...";
    text[1766] = "Tell Bella to come as well.";
    text[1767] = "(It's been a few hours since the Sector 16 breach... I hope she's okay.)";
    text[1768] = "Everyone else, please gather all the data you can and monitor Comet Coda!";
    text[1769] = "Yes, Doctor Thomas!";
    text[1770] = "(I have to stay calm and keep everyone's spirits up.)";
    text[1771] = "(Humanity's end...)";
    text[1772] = "(I cannot accept this.)";
    text[1773] = "(The future of the people of Luna is in our hands!)";
    text[1774] = "Home sweet home!";
    text[1775] = "Yep!";
    text[1776] = "Oh? Miss Nyla is calling!";
    text[1557] = "Bella dear, it's been a few hours... Is everything okay?";
    text[1558] = "You seemed a bit troubled after we fixed the hovercraft.";
    text[1559] = "Oh yeah, everything is fine Miss Nyla.";
    text[1560] = "I was just.@P.@P.@P.@P tired from the Mission.";
    text[1561] = "I see. Well, in any case, I'm glad you're okay.";
    text[1562] = "There is also some urgent news that came up...";
    text[1563] = "You are to report to Floor 3F - Research Lab.";
    text[1564] = "Your father is having an emergency meeting and requests your attendance.";
    text[1565] = "Please come as soon as you're ready, dear.";
    text[1566] = "Roger!";
    text[1707] = "An emergency?! Bella, we should hurry!";
    text[1567] = "How much do you want to bet it's a Murk situation?";
    text[1568] = "2 Cheesecake Bars!";
    text[1569] = "Tetra, you can't even eat the Cheescake Bars...";
    text[1710] = "Heh.";
    text[1711] = "OBJECTIVE: HEAD TO THE RESEARCH LAB IN FLOOR 3F - WEST CORRIDOR.";
    text[2223] = "Hi everyone!";
    text[2224] = "OH! Bella! Tetra!";
    text[2225] = "Welcome back, I'm so happy to see both of you!";
    text[2226] = "When I found out Sector 16's Astro-Barrier was breached, I was super worried...";
    text[2227] = "Are you two alright? You look exhausted...";
    text[2228] = "We're okay. I'm just a little sore from fighting Murks haha.";
    text[2229] = "Actually, speaking of exhausted... You guys look like you haven't slept in days.";
    text[2230] = "Really?! In that case, I know exactly what I need...!";
    text[2231] = "NOOOOOOOO!";
    text[2232] = "EMPTY!";
    text[2233] = "We're out of DIVINE ELIXIR!";
    text[2234] = "Divine Elixir?";
    text[2235] = "It was 'SOUL JUICE' last week.";
    text[2236] = "Ah... Of course! Coffee, mmmyes!";
    text[2237] = "Oh Nyla, only the top-tier caffeine connoisseurs know of coffee's true denomination:";
    text[2238] = "DIVINE ELIXIR!";
    text[2239] = "It's okay. I've got my Mini Brewer with me!";
    text[2324] = "It's a portable version of the Ultimate Coffee Machine I invented, heh.";
    text[2240] = "Bella, what would you like?";
    text[2241] = "Iced Vanilla Latte please!";
    text[2242] = "Tetra too!";
    text[2243] = "Tetra, you can't drink coffee.";
    text[2244] = "Oh yeah...";
    text[2245] = "Alrighty! Here, just the way you like it.";
    text[2246] = "Reeves? Double shot?";
    text[2247] = "Myeh, I must surpass my limitations.";
    text[2248] = "Triple shot espresso, Doctor.";
    text[2249] = "Oh dang, I'm impressed!";
    text[2250] = "Soon, you'll be able to handle the illustrious DIVINE ELIXIR!";
    text[2251] = "Myeheh.";
    text[2252] = "Nyla?";
    text[2253] = "No thanks... I don't really have an appetite.";
    text[2254] = "Doctor, we've gotta focus on the task at hand!";
    text[2255] = "One sec.";
    text[2256] = "Ahhh, freshly brewed! One sip will set your soul free.";
    text[2257] = "My Lux will skyrocket to astronomical levels! Hahahaha!";
    text[2258] = "Thomas, you should really cut down on the caffeine. This is your fourth cup today.";
    text[2259] = "Myeheh, but coffee helps drive the gears of the Doctor's brilliant mind.";
    text[2260] = "Some say it's the secret to his genius! Myeheh!";
    text[2261] = "...Alright! Now it's time to get serious.";
    text[2262] = "Bella, we have an emergency.";
    text[2263] = "What I am about to disclose... must be kept confidential.";
    text[2264] = "If the people find out, it would cause mass panic and unease.";
    text[2265] = "GAHHHHHHHHHH!";
    text[2266] = "NOOOOOOO! WHAT!";
    text[2267] = "We need to do something about this comet NOW!";
    text[2268] = "WHAT DO WE DO?!";
    text[2269] = "What can I do to help?";
    text[2270] = "Tetra wants to help too!";
    text[2271] = "Wait, wait. Calm down first.";
    text[2272] = "We must tackle this one step at a time.";
    text[2273] = "Comet Coda is composed of a rare form of Antimatter we do not fully understand.";
    text[2274] = "It is extremely volatile and energy dense.";
    text[2275] = "Long ago, the people of Terra launched their most destructive weapons at the comet";
    text[2276] = "out of desperation...";
    text[2277] = "...and failed.";
    text[2278] = "The comet consumed everything in its path.";
    text[2279] = "Aw, Tetra wanted to obliterate the Comet with her Plasma Buster...";
    text[6012] = "What if we activate the Astro Barrier Defense System?";
    text[6013] = "The A.B.D.S works on smaller asteroids and space debris,";
    text[6014] = "but for something this large...";
    text[6015] = "...The Astro-Barrier wouldn't be able to withstand it.";
    text[2280] = "Our current weapons tech isn't advanced enough to deal with a comet of this magnitude.";
    text[2281] = "Despite this... there is still hope!";
    text[2282] = "What if... we were to utilize our teleport technology.";
    text[2283] = "Myeh?";
    text[2284] = "...!";
    text[2285] = "We can already transport people across a finite distance using teleporters.";
    text[2286] = "If we were to use that same concept, upscale it, make some adjustments, and...";
    text[2287] = "...This sounds familiar. I know where this is going, Thomas.";
    text[2288] = "You can't be serious!";
    text[2289] = "I am.";
    text[2290] = "The comet will be no match for us once we complete Celestia!";
    text[2291] = "No. It's too risky... The project was shut down by Thea for a reason!";
    text[2292] = "Nylaaa, I'm telling you, this is our best option!";
    text[2293] = "Myeh?";
    text[2294] = "Reeves, do you know what they're talking about?";
    text[2295] = "Not a clue...";
    text[2296] = "It's likely a project they worked on before I joined the team.";
    text[2297] = "Nyla... We must finish what we started.";
    text[2298] = "Although this path is dangerous, I believe it has the highest chance of success.";
    text[2299] = "Dad, what are you guys talking about?";
    text[2300] = "You'll see Bella, heheh.";
    text[2301] = "Nyla, I've already discussed my plan with Saros.";
    text[2302] = "Did he approve?";
    text[2303] = "Yes. In fact, he's already making preparations for a mission.";
    text[2304] = "...Alright, fine.";
    text[2305] = "Gosh Thomas, you and your crazy plans.";
    text[2306] = "We aren't called 'mad scientists' for nothin, myeheh!";
    text[2307] = "Reeves, you're the only one who calls us that.";
    text[2308] = "Myeh!";
    text[2309] = "Listen, if we're going to revive the project, we better do it right.";
    text[2310] = "No mistakes this time...";
    text[2311] = "With everyone's combined efforts, we will succeed... and save humanity!";
    text[2312] = "All of you, please follow me.";
    text[2313] = "I still can't believe this is happening... It's all so sudden...";
    text[2314] = "Don't worry Bella, we'll do our part to protect the people no matter what!";
    text[2315] = "Ultimate Sidekick Tetra will unleash her fury upon Comet Coda and the Murks mwahahaha!";
    text[2316] = "Gahhhh! Tetra, you're right. The people have put their trust in us.";
    text[2317] = "We can't let them down! Let's go catch up with Dad.";
    text[2326] = "I've never been to this room before!";
    text[2327] = "Myeheh, me neither.";
    text[2328] = "Very few individuals have authorized access here.";
    text[2329] = "Welcome to the Nexus Lab. This is where we store our top-secret projects.";
    text[2330] = "Woah! What is that machine?!";
    text[2331] = "This is what I wanted to show all of you. Behold!";
    text[2332] = "This is Celestia: Humanity's first Wormhole Machine!";
    text[2333] = "MYEHEHEHEH!";
    text[2334] = "Spectacular! What a fine invention!";
    text[2335] = "So, our plan is to stop Comet Coda with a wormhole?";
    text[2336] = "Precisely!";
    text[2337] = "Celestia will be humanity's next greatest scientific marvel!";
    text[2338] = "Is Celestia able to produce such a large wormhole?";
    text[2339] = "Theoretically, yes, but right now, it can't.";
    text[2340] = "Celestia is still a prototype.";
    text[2341] = "We need some time to design and finish building the machine.";
    text[2342] = "Time that is valuable and limited...";
    text[2343] = "How long do you expect the upgrade will take?";
    text[2344] = "A minimum of 6 Months. Maybe sooner if things go smoothly.";
    text[2345] = "We also need another resource for this plan to work.";
    text[2346] = "I assume this is why you asked Bella to be here?";
    text[2347] = "Heh, I've been waiting patiently for my mission!";
    text[2348] = "Please let me know how I can help!";
    text[2349] = "Well, Celestia is powered by a very specific energy source that is required to sustain";
    text[2350] = "a massive wormhole.";
    text[2351] = "The universe's most powerful form of cosmic energy: Antimatter!";
    text[2352] = "We will need Antimatter, and LOTS OF IT in order to fuel the creation of";
    text[2353] = "an astronomical wormhole!";
    text[2354] = "Right now, our only source of stable Antimatter comes from...";
    text[2355] = "...The Murks.";
    text[2356] = "That is correct.";
    text[2357] = "Wh-what! We'd have to slaughter thousands of Murks!";
    text[2358] = "I.@P.@P.@P.@P.";
    text[2359] = "I don't.@P.@P.@P.@P.";
    text[2360] = "Bella... I understand your concerns but,";
    text[2361] = "this is a necessary action we must take in order to ensure our survival!";
    text[2362] = "...";
    text[2363] = "If Mom was still here, she would have found another way!";
    text[2364] = "There has to be another way! I don't agree with this...";
    text[2365] = "Oh hey, it's Commander Vivia!";
    text[2366] = "Good afternoon, Doctor Thomas.";
    text[2481] = "If you're here, that must mean...";
    text[2367] = "General Saros has arrived.";
    text[2368] = "He is here already?!";
    text[2369] = "The Legendary Hero finally makes his appearance! Myeheheh!";
    text[2370] = "With his strength and military might, we'll definitely get the Anticores we need in no time!";
    text[2371] = "Yo!";
    text[2372] = "Pardon me, I hope I'm not too late to the party.";
    text[2373] = "Vivia and I rushed here as soon as we could.";
    text[2374] = "It's good to see you all!";
    text[2375] = "Thomas, I assume everyone knows about the plan?";
    text[2376] = "Yeah, we've got almost everyone on board.";
    text[2377] = "Almost?";
    text[2378] = "Well...";
    text[2379] = "Ahh.";
    text[2380] = "Knowing Bella, I expected some resistance.";
    text[2381] = "Saros, it doesn't feel right to kill so many Murks...";
    text[2382] = "Let me ask you something Bella.";
    text[2383] = "Do you wish to save humanity?";
    text[2384] = "I do.";
    text[2385] = "Then it is imperative we collect the Anticores.";
    text[2386] = "The Murks are monsters. They are mindless creatures without a shred of humanity.";
    text[2387] = "They do not belong in our world.";
    text[2388] = "If there is anything the Murks are good for... It's their Anticores.";
    text[2389] = ".....";
    text[2390] = "The development of Celestia started 10 years ago.";
    text[2391] = "Your father, Nyla and several other scientists were also part of the project.";
    text[2392] = "At the time, progress was slow.";
    text[2393] = "We had about 7 successful wormhole tests and...";
    text[2394] = "Unfortunately, test number 8 was our last.";
    text[2395] = "Celestia suddenly malfunctioned and opened a violent, unstable wormhole.";
    text[2396] = "Anything pulled in was molecularly shredded upon entry...";
    text[2397] = "We lost four brilliant lives that day...";
    text[2398] = "Eventually, the project was shut down by your mother, the former general.";
    text[2399] = "She cared about every soul and couldn't bear to risk losing another valuable team member.";
    text[2400] = "Yeah... that's definitely something Mom would do...";
    text[2401] = "Despite the tragic history of this project, I believe we must finish it.";
    text[2402] = "If we are successful, our friend's deaths would not be in vain.";
    text[2403] = "Those who were killed by the Murks would be avenged as well!";
    text[2404] = "Back then, we had little to no knowledge regarding the science of Antimatter.";
    text[2405] = "But, over the years we've learned and studied extensively.";
    text[2406] = "With the knowledge we have now, we should be able to minimize the risk of danger.";
    text[2407] = "This time, we'll do things better.";
    text[2408] = "With our combined efforts, we can overcome the threat of the Murks AND Comet Coda!";
    text[2409] = "Brilliant! I can't argue with that, myeheh.";
    text[2410] = "Saros has a good point.";
    text[2411] = "Bella, as your father it pains me to send you out into danger...";
    text[2412] = "...but you are strong.";
    text[2413] = "Indeed. You are one of our best warriors.";
    text[2414] = ".@P.@P.@P.@P.";
    text[2415] = "Hahahaha!";
    text[2416] = "The look in your eyes says it all.";
    text[2417] = "Very well.";
    text[2418] = "We'll settle this... with a Duel!";
    text[2419] = "Wait what?!";
    text[2420] = "A duel?!";
    text[2421] = "Yes. Prove to me the strength of your convictions.";
    text[2422] = "Hit me with your most powerful technique: A Lux Combo.";
    text[2423] = "Strike me with everything you've got!";
    text[2424] = "If I win, you will ensure the completion of this mission and you will follow all orders.";
    text[2425] = "And if I win...?";
    text[2426] = "Well...";
    text[2427] = "We'll see about that.";
    text[2428] = "Bella, please be careful! General Saros is the strongest warrior in Luna!";
    text[2429] = "I got this! Saros, I accept your challenge!";
    text[2430] = "EN GARDE!";
    text[2431] = "I think that's enough.";
    text[2432] = "Bella, are you okay? Are you hurt?";
    text[2433] = "Guhhhh, he's too strong...I didn't stand a chance.";
    text[2434] = "You couldn't defeat me... but you've proven your resolve.";
    text[2435] = "I haven't had a fun duel like this in a long while, hahaha!";
    text[2436] = "You definitely put your Mother's training to good practice.";
    text[2437] = "...Dang it...";
    text[2438] = "I don't want unnecessary bloodshed... is that selfish of me to ask?";
    text[2439] = "Is there really no other way...?";
    text[2448] = "Bella. How about you take some time to think about what you want to do.";
    text[2449] = "Y-you're...not gonna force me to do the mission?";
    text[2450] = "No. Like I said, you've proven your resolve.";
    text[2451] = "If you stay strong in your convictions, you can have the power to change the world.";
    text[2452] = "The choice is yours to make.";
    text[2453] = "You can walk the path with us, or you can forge your own path.";
    text[2454] = "In the meantime, as the General, I will do what I think is best for Luna.";
    text[2457] = "Vivia, let's increase the training regimens and recruit more able warriors.";
    text[2458] = "Yes, General.";
    text[2459] = "Only the best squads are to be informed of Comet Coda.";
    text[2460] = "While Lunex Labs focuses on the Wormhole Machine, the Lunex Force must";
    text[2461] = "prioritize the collection of Anticores, increase combat training,";
    text[2462] = "and produce more Vessels to fight against the Murks to save as many lives as we can!";
    text[2463] = "Yes, General Saros!";
    text[2464] = "Thomas, I trust you and your team to ensure Celestia is completed? Don't let me down.";
    text[2465] = "Nah, we got this Saros. I trust you and your soldiers will get me the Anticores we need?";
    text[2466] = "Of course! Hahaha.";
    text[2467] = "...(sigh)";
    text[2468] = "Why must humanity always be burdened with calamity?";
    text[2469] = "Perhaps this is the universe's cruel way of testing us...";
    text[2470] = "...to see how far we've evolved as a species.";
    text[2471] = "We must evolve and overcome. Let's do our best everyone!";
    text[2472] = "May our Lux shine forever bright!";
    text[2473] = "Vivia, let's go.";
    text[2474] = "Bella are you okay?";
    text[2475] = "...";
    text[2476] = "There's a lot on my mind right now.";
    text[2477] = "I'm heading over to Oceanus.";
    text[2478] = "Wanna come with me?";
    text[2479] = "YES! Why are we going to Oceanus though?";
    text[2480] = "You'll see.";
    text[2483] = "Okiedokie! Let's go!";
    text[2491] = "Yay! We're at the beach!";
    text[2492] = "Wanna go swimming?!";
    text[2493] = "Swimming can take your mind off of things!";
    text[2494] = "Don't worry, I'm water-proof heheh.";
    text[2495] = "We didn't come here to swim Tetra.";
    text[2496] = "Aww...";
    text[2497] = "Sorry for being such a downer...";
    text[2510] = "It's okay Bella! Tetra just wants to cheer you up! Hehe.";
    text[2499] = "Oceanus...";
    text[2500] = "Is one of the most beautiful places on Luna.";
    text[2501] = "Mom, Dad, and I used to come here often for picnics.";
    text[2502] = "Dad would finally have some time off work to rest, and Mom and I would have our";
    text[2503] = "training sessions here on this beach. It was a simpler time back then.";
    text[2504] = "Ahhh, just being here after so long is refreshing!";
    text[2505] = "Bella, how come you never took me here?";
    text[2506] = "I guess things have gotten pretty busy after I became a Lunex Warrior.";
    text[2507] = "Now with the comet looming over our heads,";
    text[2508] = "who knows if we'll have the opportunity to come back here again...";
    text[2509] = "I can't truly relax, knowing that Comet Coda is out there and we need to stop it.";
    text[2511] = "Saros gave me a chance to forge my own path...";
    text[2512] = "If we come up with our own solid plan, maybe you can change the General's mind!";
    text[2513] = "Hmmm...";
    text[2514] = "Our problem is that we need an Antimatter energy source to power Celestia...";
    text[2515] = "Right. Which is why Saros wants to collect Anticores.";
    text[2516] = "But...";
    text[2517] = "What if there were other ways to obtain Antimatter?";
    text[2518] = "Like what?";
    text[2519] = "There's a whole world of Antimatter out there that we can use!";
    text[2520] = "A whole world...?";
    text[2524] = "You mean the Phantom Realm?!";
    text[2521] = "Exactly!";
    text[2522] = "You've seen it with your own eyes Tetra!";
    text[2523] = "We could do an expedition in the Phantom Realm to get the fuel we need!";
    text[2525] = "It will be dangerous if we go back there alone. We'll need a proper team.";
    text[2526] = "This also means I have to tell Dad about our trip to the Phantom Realm...";
    text[2527] = "He might be more convinced to let us go if he knows that we survived there once before.";
    text[2528] = "Are you sure you want to do this Bella?";
    text[2529] = "Yeah. Even if it gets us in trouble, I'm willing to try.";
    text[2530] = "At least we wouldn't have to kill Murks this way.";
    text[2531] = "Okay, let's go pitch our idea to Doctor Thomas!";
    text[2532] = "Hold on, I need to do something first.";
    text[2533] = "If the Lunex Force gets their hands on Chronos' Anticore,";
    text[2534] = "It'll just end up being used as an energy source.";
    text[2540] = "Chronos doesn't deserve a fate like that.";
    text[2535] = "The Murks may be monsters, but they have souls too.";
    text[2536] = "Chronos protected us, like any brave hero would.";
    text[2537] = "I guess this is my way of saying thanks.";
    text[2538] = "C'mon Tetra, let's go talk to Dad back at the Space Station!";
    text[2539] = "Alrighty, let's go!";
    text[2561] = "Bella! How are you feeling?";
    text[2562] = "Have you changed your mind about the mission?";
    text[2563] = "I'm doing better, but I haven't changed my mind.";
    text[2564] = "I decided I'm going to forge my own path.";
    text[2565] = "I have an idea... and I need you to hear me out.";
    text[2566] = "Just...";
    text[2567] = "Don't get mad. I can explain everything.";
    text[2568] = "I won't get mad. I'm just worried about you...";
    text[2608] = "There's nothing to worry about. I feel fine.";
    text[2569] = "Bella... we know you've been to the Phantom Realm.";
    text[2570] = "W-what? ...but, how did you know?";
    text[2571] = "Perhaps General Saros can explain.";
    text[2572] = "Yo! Pardon my intrusion.";
    text[2573] = "Bella, I'm glad you've returned.";
    text[2574] = "Whether you decided to go with my plan or not, you're here now,";
    text[2575] = "which means your resolve to make change hasn't wavered in the slightest.";
    text[2576] = "When we had our duel, I noticed traces of glowing stardust on your battle gear.";
    text[2577] = "(How did he have time to notice?! We were FIGHTING!)";
    text[2578] = "Our sensors also detected traces of antimatter coming from you as well.";
    text[2579] = "Bella, we have rules in place for a reason. Please explain what happened.";
    text[2580] = "I know I wasn't supposed to go to the Phantom Realm, but I didn't have a choice.";
    text[2581] = "The Murk that breached Sector 16 suddenly ambushed us!";
    text[2582] = "It sent us through a wormhole and that's how we ended up in the Phantom Realm!";
    text[2583] = "Interesting...!";
    text[2584] = "The Murks are mindless creatures that run purely on destructive instinct.";
    text[2585] = "This has never happened before...";
    text[2586] = "Very interesting...";
    text[2587] = "What happened to the Murk?";
    text[2588] = "I defeated it.";
    text[2589] = "...and the Anticore?";
    text[2590] = "I...";
    text[2591] = "I lost the Anticore.";
    text[2592] = "We were rushing to find an escape route that could lead us back to Luna.";
    text[2593] = "I see.";
    text[2594] = "Looks like luck was on your side.";
    text[2595] = "Humans can only last 72 Hours in the Phantom Realm.";
    text[2596] = "Symptoms usually start showing up after 48 Hours.";
    text[2597] = "Once you hit 72 hours, the Antimatter environment starts to tear your atoms apart.";
    text[2598] = "We learned this the hard way.";
    text[2599] = "WHAT!";
    text[2600] = "Bella, you should get a vitals scan soon as possible!";
    text[2682] = "I told her to do one but she never listens...";
    text[2601] = "Dad, I'm fine. I was only there for a couple of hours.";
    text[2625] = "Your survival this time doesn't guarantee you will survive the next time.";
    text[2626] = "I'm assuming your idea was to do an expedition in the Phantom Realm?";
    text[2627] = "Yeah... I was thinking we could get all the Antimatter fuel we need over there.";
    text[2602] = "There are parts of the Phantom Realm where the Antimatter is so dense,";
    text[2609] = "your body would instantly disintegrate.";
    text[2610] = "We already considered sending in troops to hunt down the Murks in the Phantom Realm.";
    text[2603] = "Unfortunately the risk is too great.";
    text[2611] = "There's a lot we still don't know about the Phantom Realm.";
    text[2612] = "What we do know, is that the Antimatter there is unstable.";
    text[2613] = "What we need for Celestia is a stable form of Antimatter,";
    text[2614] = "which is why the Anticores are our best option.";
    text[2615] = "The Phantom Realm... is a world unfit for beings made of matter.";
    text[2616] = "If only our bodies could evolve and transcend our limitations...";
    text[2617] = "Then we could truly become an intergalactic species...";
    text[2618] = "So, am I being demoted...?";
    text[2619] = "No. You are one of our best warriors.";
    text[2620] = "Your protocol violation shall be excused this time.";
    text[2621] = "...and you are forbidden to go to the Phantom Realm ever again.";
    text[2622] = "...Thank you General...";
    text[2604] = "(Darn it...)";
    text[2623] = "(I'm out of options...)";
    text[2624] = "Bella, we ran some calculations for how much fuel we will need, myeh...";
    text[2628] = "The number of Anticores we need exceeds the rate in which Murks appear on Luna...";
    text[2629] = "Which means even if we collect all the Anticores we possibly can,";
    text[2630] = "It's still not enough to power Celestia...";
    text[2631] = "No...";
    text[2632] = "So, what do we do now?...";
    text[2633] = "There is always hope!";
    text[2634] = "A good leader comes prepared with multiple plans, just in case one fails.";
    text[2635] = "There is a third option we can try.";
    text[2636] = "There is?!";
    text[2637] = "Myeh!";
    text[2638] = "We could possibly hitch it off without having to kill every Murk we see.";
    text[2639] = "It's a relatively new mission that Vivia and I have been carefully planning.";
    text[2640] = "Her advancements in Holo Technology will be our key to success.";
    text[2641] = "The target of this mission has been a thorn in our side for far too long.";
    text[2642] = "In order to get the Anticores we need, we must capture...";
    text[2643] = "The Murk Slayer.";
    text[2676] = "One hour later...";
    text[2644] = "Now that you know the plan...";
    text[2645] = "...is everyone on board?";
    text[2646] = "Yes General!";
    text[2677] = "This might just work, myeheh!";
    text[2678] = "It has to work. It's our best option at this point.";
    text[2679] = "Indeed, the Murk Slayer must be captured...";
    text[2647] = "Bella, the success of this operation relies on your strength and determination.";
    text[2648] = "I'll do my best, Saros!";
    text[2649] = "Thank you... for giving me hope.";
    text[2650] = "If all goes well, we won't have to kill any more Murks.";
    text[2651] = "Everyone is dismissed. Rest up and recover.";
    text[2652] = "Vivia and I will make the final preparations. After that...";
    text[2653] = "We wait for the right opportunity.";
    text[2654] = "Mission Control, what is the issue?";
    text[2655] = "COMMS: General, there has been a Murk Outbreak in Copernicus!";
    text[2656] = "How many Murks?";
    text[2657] = "COMMS: There are hundreds of them...";
    text[2681] = "We've never had this many Murks appear all at once... This can't be...";
    text[2680] = "Mission Control, issue a State of Emergency in Sector 7.";
    text[2658] = "Send in our top squads to evacuate the citizens immediately!";
    text[2660] = "I also need the Warrior Vessels deployed for combat!";
    text[2659] = "COMMS: Yes General!";
    text[2661] = "Saros, looks like this is our opportunity!";
    text[2662] = "Where there are Murks, we'll find the Murk Slayer.";
    text[2671] = "No. We're not ready yet. I need more time.";
    text[2672] = "If we don't do this according to plan, it could jeopardize the mission.";
    text[2673] = "If the Murk Slayer shows up, I'll buy you the time you need.";
    text[2663] = "I might be able to talk to him. Just give me a chance!";
    text[2664] = "If he doesn't show up, we'll do the operation next time!";
    text[2665] = "At least let me go there so I can protect the people from danger!";
    text[2674] = "....";
    text[2666] = "Very well. Good luck with the mission, Bella.";
    text[2667] = "Bella, please be careful!";
    text[2668] = "I will Dad. You can count on me!";
    text[2669] = "EMERGENCY MISSION: MURK OUTBREAK";
    text[2670] = "Head to Sector 7 - Copernicus to assist in controlling the Murk outbreak!";
    text[2683] = "There's Murks everywhere!";
    text[2684] = "They weren't kidding when they said it was a Murk Outbreak!";
    text[2685] = "Bella, what do we do?! This is too chaotic!";
    text[2686] = "We should make sure all the civilians have been evacuated first!";
    text[2687] = "Hold on!";
    text[2688] = "Myeh! Bella, the situation is worse than we thought!";
    text[2689] = "Reeves, I just arrived at Copernicus! What's up?";
    text[2692] = "I need you and Tetra to focus on the Waterworks Network!";
    text[2690] = "Don't worry about the civilians, we have troops assigned to them!";
    text[2693] = "What happened to the Waterworks Network?";
    text[2694] = "Myeh! The water has turned PURPLE!";
    text[2695] = "WHAT?! HOW!?";
    text[2696] = "How are we supposed to fix that? We need to stop the Murks from rampaging!";
    text[2697] = "Let the soldiers do their job! Your job is to make sure the soldiers don't die!";
    text[2698] = "Purple water indicates a high concentration of Potassium Permanganate,";
    text[2699] = "which is used as a disinfectant to help remove harmful bacteria and germs.";
    text[2700] = "However, if you have too much, the water becomes deadly and the chemicals can";
    text[2701] = "become toxic and harmful to breathe!";
    text[2702] = "The city of Copernicus is built on top of an essential water reservoir, myeh.";
    text[2703] = "We need to protect it at all costs, the water is essential for our survival!";
    text[2704] = "There should be 4 Filter Machines located throughout the city.";
    text[2705] = "You need to locate all 4 Machines and have Tetra dive in to restore the Network!";
    text[2706] = "Roger!";
    text[2707] = "Okay Tetra, I'm counting on you to help me restore the Waterworks Network!";
    text[2708] = "It's Sidekick Time! Heheh, let's go!";
    text[2710] = "HELP! SOMEBODY PLEASE HELP!";
    text[2711] = "Now's your chance to run! Leave the rest to me!";
    text[2712] = "Evacuate to a safe place NOW!";
    text[2713] = "Yes ma'am! Th-thank you so much! Please be careful!";
    text[2714] = "Phew. I'm glad that the family was able to get to safety...That was a close call.";
    text[2715] = "Bella, stay on guard! I'm detecting a strange signal...!";
    text[2716] = "Murk Slayer! Ack, what's with that sucker punch?!";
    text[2717] = "That really hurt ya know! Ow...";
    text[2718] = "Its you again...";
    text[2719] = "I'm surprised you're still standing after getting hit with my Phase Punch.";
    text[2720] = "You're a lot tougher than you look, I'll give you that.";
    text[2721] = "Gahh... Huff... Huff...";
    text[2722] = "I need.... to talk to you...";
    text[2723] = "Huh? We're enemies. We have nothing to discuss.";
    text[2724] = "Let this be a warning to you and the Lunex Force.";
    text[2725] = "Stay out of my way, if you don't want to get hurt.";
    text[2726] = "The last place the Anticores should be is in the hands of the Lunex Force.";
    text[2727] = "Dang it... He got away.";
    text[2728] = "Bella, are you okay?";
    text[2729] = "Yeah, I'm recovering slowly but surely. I need to rest a bit.";
    text[2730] = "He might be out of our sight for now, but I doubt he'll be leaving any time soon.";
    text[2731] = "He's here to collect Anticores. We still have a chance to talk to him.";
    text[2732] = "Tetra, keep an eye out for him while we try to fix the Waterworks Network!";
    text[2733] = "Roger that!";
    text[2734] = "W-wait!";
    text[2735] = "What happened?";
    text[2736] = "M-M-More Murks!";
    text[2737] = "Crud... There is no end to these Murks.";
    text[2738] = "At this rate, we won't be able to restore the Waterworks Network in time...";
    text[2739] = "The Murk Slayer is probably gonna get away too...";
    text[2740] = "Looks like the warrior prodigy needs some backup!";
    text[2741] = "?!";
    text[2742] = "BULLET PUNCH! HIYAH!";
    text[2743] = "Raine?!";
    text[2744] = "What are you doing here? I thought you were assigned to another mission!";
    text[2745] = "Mission Control sent us a distress signal. This outbreak is gettin' out of hand!";
    text[2754] = "Also, how about a 'you're welcome' for saving your prodigy butt, hahaha!";
    text[2746] = "Save it for later! Attack incoming!!";
    text[2747] = "Also, for the last time, stop calling me warrior prodigy!";
    text[2748] = "Sure, sure! Hmm, maybe I will if ya spar with me after!";
    text[2749] = "You still owe me a rematch ya know!";
    text[2750] = "I know, I know!";
    text[2751] = "How about we take care of the Murks that are about to attack us first!?";
    text[2752] = "Don't worry, I didn't come alone!";
    text[2753] = "C'mon ladies, let's show these Murks the power of the Raine Squad!";
    text[2755] = "LEVISTONE PIERCER!";
    text[2756] = "PLASMA CAGE!";
    text[2757] = "It's Melody and Zara!";
    text[2758] = "Hello there Tetra! You're still an absolute cutie as always!";
    text[2759] = "Heheheheh! You too Melody!";
    text[2760] = "It's nice seeing you Bella!";
    text[2761] = "How are you still so cute, even when you're all beat up?!";
    text[2762] = "Uhh... thanks?";
    text[2763] = "Hey Zara, was that a new combo attack?";
    text[2764] = "Yep.";
    text[2765] = "We needed an effective and elegant way to keep the rampaging Murks at bay.";
    text[2766] = "We were instructed to kill as few Murks as possible.";
    text[2767] = "Looks like somebody needs to pull their Bullet Punches a bit.";
    text[2768] = "NEVER!";
    text[2769] = "When you fight, ya gotta go ALL OUT!";
    text[2770] = "-even during sparring sessions! If this wasn't an emergency mission...";
    text[2771] = "I would be CLOBBERING you right now! BAHAHAHA!";
    text[2772] = "Settle down Raine, we should use our energy to focus on our Mission.";
    text[2773] = "Tch. Yea, you're right I guess.";
    text[2774] = "Bella, we got a mission report from Reeves.";
    text[2775] = "You and Tetra need to restore the Waterworks Network ASAP!";
    text[2776] = "We got your back!";
    text[2777] = "We'll rain down our fury upon the Murks that hurt the People of Luna!";
    text[2778] = "Raine, no killing murks.";
    text[2779] = "Okay, we'll LIGHTLY rain down our fury upon the Murks that hurt the People of Luna...";
    text[2780] = "HESITANTLY!";
    text[2781] = "Good enough. Let's make this an elegant mission.";
    text[2782] = "By the way, Saros filled us in on the Secret Operation.";
    text[2783] = "If we find the Murk Slayer, we'll be the ones to CAPTURE HIM!";
    text[2784] = "The Raine Squad will emerge victorious! Promotion is practically guaranteed, BAHAHA!";
    text[2785] = "Not if I capture him first! Heh.";
    text[2786] = "Helpful Tip: Watch out for his Phase Punch.";
    text[2787] = "PHASE PUNCH?! WHAT!?";
    text[2788] = "(So Bella has fought him before? Hmm...)";
    text[2789] = "(Aw man, Phase Punch is such a cool name...)";
    text[2790] = "NO NO NO! There can only be one master of melee here. He's going down!!";
    text[2791] = "See you around Bella! If ya need backup, we'll be nearby!";
    text[2792] = "Good luck!";
    text[2793] = "Look Bella, there's a Filter Machine here!";
    text[2794] = "Alright, let's go! There's no time to waste!";
    text[2555] = "Bella, we need to restore the Waterworks Network!";
    text[2556] = "There are 4 Filter Machines in total that we need to dive into";
    text[2557] = "in order to break through the security firewall! Send me in!";
    text[2558] = "Have Tetra dive into the Waterworks Network?";
    text[2808] = "I see you're not very good at listening.";
    text[2809] = "Huh?! You're terrible at listening too!";
    text[2810] = "Look, I warned you...";
    text[2811] = "WAIT!";
    text[2812] = "PLEASE STOP!";
    text[2813] = "WHY? So you can stall and wait for reinforcements?";
    text[2814] = "...So you guys can finally capture the infamous Murk Slayer?";
    text[2815] = "Pathetic.";
    text[2816] = "No...";
    text[2817] = "I don't want to capture you. I just want to talk to you.";
    text[2818] = "Lies. You and all your superiors spout nothing but lies.";
    text[2819] = "I'm telling the truth!";
    text[2820] = "And I know... ";
    text[2821] = "...I know more about you than you think...";
    text[2822] = "...?";
    text[2823] = "Whatever you know, you don't know the whole truth.";
    text[2824] = "Justice will come.";
    text[2825] = "WAIT!";
    text[2826] = "Ugh, you just don't shut up do you?!";
    text[2827] = "Please don't unleash your powers right now! At least not here!";
    text[2828] = "That machine behind you is part of the city's water filtration system.";
    text[2829] = "If that machine gets damaged, we're doomed...";
    text[2830] = "The toxic fumes from the water would eventually kill everyone here.";
    text[2831] = "There's a chance the water could spread to the other sectors too.";
    text[2832] = ".....";
    text[2833] = "Please don't put the People of Luna at risk.";
    text[2834] = "Please...";
    text[2835] = "(Is she lying...? What if this is a just a trap...)";
    text[2836] = "(Can I really trust what she says...)";
    text[2837] = "(But...)";
    text[2838] = "(If she's telling the truth...)";
    text[2839] = "Please...";
    text[2840] = ".....";
    text[2841] = "You said you wanted to talk.";
    text[2842] = "Fix this toxic water mess, then meet me at the Waterworks Building rooftop.";
    text[2843] = "Come alone. The moment I detect some trickery or deception, I'm leaving.";
    text[2844] = "Thank you.";
    text[2845] = "Whew, he's so scary and cool at the same time...";
    text[2846] = "Now is not the time for teasing Tetra!";
    text[2847] = "Oh? We're getting a transmission from General Saros.";
    text[2848] = "Bella, how is the situation looking?";
    text[2849] = "We're trying to reboot the Waterworks Network as soon as possible.";
    text[2850] = "Very well, I don't want to take up too much of your time, so I'll cut to the chase.";
    text[2851] = "The preparations are ready.";
    text[2852] = "Did you encounter the Murk Slayer?";
    text[2853] = "Uhm....";
    text[2854] = "Yes... But...";
    text[2855] = "He got away.";
    text[2856] = "You're not very good at lying...";
    text[2857] = "However, you're great at gaining people's trust.";
    text[2858] = "Where did he want to meet you?";
    text[2859] = "...The Waterworks building rooftop.";
    text[2860] = "He gave me a chance to talk to him...but he wants me to come alone.";
    text[2861] = "He doesn't trust the Lunex Force at all, like you said.";
    text[2862] = "Understandable. His history with us is complicated.";
    text[2863] = "However, he is a dangerous man with valuable information.";
    text[2868] = "He MUST be captured.";
    text[2864] = "Do not proceed to the Waterworks Rooftop until we arrive.";
    text[2865] = ".....";
    text[2866] = "Yes General.";
    text[2867] = ".....";
    text[2886] = "W-what?! The Murk Slayer is the one who helped us learn about Antimatter?";
    text[2887] = "Unintentionally, yes.";
    text[2888] = "He is the catalyst to our Antimatter Research.";
    text[2889] = "Many years ago, we had a patient come into the emergency medical center.";
    text[2890] = "It was a young boy, who was at risk of dying from an unknown condition.";
    text[2891] = "His body was emitting unbearable amounts of strange energy.";
    text[2892] = "After countless tests, we were miraculously able to extract";
    text[2893] = "the overflowing energy from the boy and as a result, we saved the boy's life.";
    text[2894] = "After several days, the boy's vitals returned to normal and he was cured.";
    text[2895] = "However, the stress on his body left him in a comatose state.";
    text[2896] = "This strange energy though... I'm assuming it was...";
    text[2897] = "Antimatter.";
    text[2898] = "The energy overflowing from the boy was pure, stable antimatter.";
    text[2899] = "Thanks to him, we learned a lot about Antimatter and its properties.";
    text[2900] = "Our research led to the creation of Wormhole technology,";
    text[2901] = "the discovery of the Phantom Realm,";
    text[2902] = "and the invention of Vessels and weapons that help us fight against the Murks today.";
    text[2903] = "One day, after months in a coma, the boy finally woke up.";
    text[2904] = "He was in severe pain, and an astronomical amount of antimatter was being emitted.";
    text[2905] = "We tried to calm him down and help him, but we couldnt get close.";
    text[2906] = "He escaped from our facility, and we haven't been able to catch him since.";
    text[2907] = "So this boy was the Murk Slayer...";
    text[2908] = "That is correct.";
    text[2909] = "His powers... I wonder if it was something he was born with?";
    text[2910] = "It's both fascinating and terrifying, myeh!";
    text[2911] = "...A human with the power to manipulate Antimatter.";
    text[2912] = "What else do we know about him?";
    text[2913] = "We know virtually nothing. We never got the chance to talk.";
    text[2914] = "He had no records on him... No identification either.";
    text[2915] = "We don't even know his name or where he came from.";
    text[2916] = "He has information we do not know... and power we do not fully understand.";
    text[2917] = "We also believe the Murk Slayer has some sort of connection to the Murks.";
    text[2918] = "...?!";
    text[2919] = "The Murks started showing up only a few months after the boy escaped.";
    text[2920] = "It's possible his Antimatter outbursts may have brought the Murks to our world.";
    text[2921] = "Do you have proof?";
    text[2922] = "...No. It's just a theory.";
    text[2923] = "The Murks are beings that are highly reactive to other sources of Antimatter.";
    text[2924] = "Given the timeline of events, it's possible there's a connection.";
    text[2925] = "You guys are treating the Murk Slayer like he's some kind of monster.";
    text[2926] = "Well, he definitely has the power of a monster. He's also a criminal.";
    text[2927] = "He's just a victim of his own powers that he can't control!";
    text[2928] = "His antimatter outbursts destroyed military property and hurt many innocent people.";
    text[2929] = "Incident after incident...";
    text[2930] = "Who knows when he'll have his next outburst.";
    text[2931] = "He is a very dangerous man.";
    text[2932] = "...but, he's not necessarily a bad person.";
    text[2933] = "Whatever reason he has for hunting the Murks,";
    text[2934] = "he's indirectly saving people as well.";
    text[2935] = "Have you guys ever considered that he doesn't want to live a life in captivity?";
    text[2936] = "What if he's just scared...";
    text[2937] = "He's not some lab rat that needs to be studied... He's human just like all of us.";
    text[2938] = "We understand, but we cannot overlook all the damage he has done,";
    text[2939] = "and all the people he has hurt... intentional or not.";
    text[2940] = "He's a potential enemy to humanity.";
    text[2941] = "Defending the Murks... and now standing up for the Murk Slayer...";
    text[2942] = "Seems like you're confused about which side you're on, Bella.";
    text[2943] = "S-Saros, let's not make unreasonable assumptions here.";
    text[2944] = "Bella is just being...";
    text[2945] = "Bella.";
    text[2946] = "I'm on the side of doing what I think is right.";
    text[2947] = "(Sigh)";
    text[2948] = "I apologize.";
    text[2975] = "The Murk Slayer has been a thorn in my side for so many reasons...";
    text[2949] = "...but, let's get back to our main focus, and why I mentioned him in the first place.";
    text[2950] = "Dealing with Comet Coda is our priority right now.";
    text[2951] = "Like Reeves mentioned before,";
    text[2952] = "The number of Anticores we need exceeds the rate in which Murks appear on Luna...";
    text[2953] = "Which means even if we collect all the Anticores we possibly can,";
    text[2954] = "It's still not enough to power Celestia...";
    text[2955] = "and so... we go for the Anticores the Murk Slayer has already collected.";
    text[2956] = "The Murk Slayer likely has thousands of Anticores he's hiding.";
    text[2957] = "If we can use those Anticores to help us fuel Celestia,";
    text[2958] = "We won't have to kill any more Murks and we'll able to stop Comet Coda.";
    text[2959] = "....";
    text[2960] = "I'm willing to do this mission on one condition.";
    text[2961] = "You have to let me be the one to talk to him.";
    text[2962] = "I will try to get the information we need.";
    text[2963] = "If he learns about the threat of Comet Coda, he might work together with us.";
    text[2964] = "....";
    text[2965] = "He doesn't trust us. You think you can change his mind?";
    text[2966] = "...I will try my best.";
    text[2967] = "...Very well.";
    text[2968] = "However, if he tries to escape,";
    text[2969] = "We'll have no choice but to use Vivia's Holo Tech to capture him.";
    text[2972] = "Remember, this is the only option we have where we won't have to kill more Murks.";
    text[2973] = "Do you understand and accept this mission Bella?";
    text[2974] = "I accept!";
    text[2875] = "The Murk Slayer distrusts authority...";
    text[2876] = "His motives are still unclear.";
    text[2877] = "I don't understand...";
    text[2878] = "His gifts...";
    text[2879] = "His powers...";
    text[2880] = "...Can help us save the People of Luna.";
    text[2881] = "We only know what we know from our perspective.";
    text[2882] = "If I can gain his trust...";
    text[2883] = "Maybe we can come to an understanding.";
    text[2884] = "We need his side of the story to know the full truth...";
    text[2885] = "...";
    text[2869] = "We did it! Great job Tetra!";
    text[2870] = "Heheh, Super Sidekick Tetra to the rescue!";
    text[2976] = "It looks like the Murks are gone too.";
    text[2977] = "They either ran away, or the Murk Slayer hunted all of them down...";
    text[2871] = "We should be able to use the Jet Pads now.";
    text[2872] = "Let's meet up with the Murk Slayer on the rooftop of the Waterworks building!";
    text[2873] = "Okay! The building is located in the north-west part of the city! Let's go go go!";
    text[3000] = "There was once a time when I trusted the Lunex Force to protect humanity.";
    text[3001] = "I even dreamt of joining the Lunex Force someday... to become a warrior.";
    text[3002] = "If only I was stronger back then...";
    text[3003] = "If only I could control my powers...";
    text[3004] = "...it wouldn't have gotten this far.";
    text[3005] = "I didn't ask for these powers...";
    text[3006] = "All they've done is cause pain and suffering.";
    text[3007] = "It took me years to be able to control even a fraction of it.";
    text[3008] = "I've hurt a lot of people...";
    text[3009] = "...and I can't forgive myself for the things I've done.";
    text[3010] = "The least I can do, is try to find a way...";
    text[3011] = "Find a way to do what?";
    text[3012] = "To bring justice.";
    text[3013] = ".....";
    text[3014] = "Anyways, I don't have all day. What did you want to discuss?";
    text[3015] = "Well, let me start off by asking you this...";
    text[3016] = "Why are you collecting the Anticores?";
    text[3017] = "Ugh, this again.";
    text[3018] = "Doesn't the Lunex Force have their own Anticore reserves?";
    text[3019] = "Why bother coming to me?";
    text[3020] = "I have no interest in helping you.";
    text[3021] = "Just go hunt down Murks on your own.";
    text[3022] = "It's not enough...";
    text[3023] = "We need more Anticores for fuel...";
    text[3024] = "...but not for reasons you might think.";
    text[3025] = "Murk Slayer... we really need your help!";
    text[3026] = "Comet Coda has returned!";
    text[3027] = "So you're telling me there's an Antimatter comet headed toward us, and we have";
    text[3028] = "one year to collect enough Anticores to power an incomplete Wormhole Machine?";
    text[3029] = "You expect me to believe this?";
    text[3030] = "I'm telling you the truth! I have no reason to lie...";
    text[3031] = "....an Antimatter comet...";
    text[3032] = "This could explain the strange Antimatter bursts I've been sensing lately...";
    text[3033] = "If what you're saying is true, these bursts could be what caused the outbreak.";
    text[3034] = "If we don't get enough fuel to power Celestia, humanity is finished...";
    text[3035] = "...even so, I cannot give you the Anticores I have.";
    text[3036] = "You need to find another way to stop Comet Coda.";
    text[3037] = "We've exhausted all of our options! You're literally my last hope!";
    text[3038] = "I can't...";
    text[3039] = "Seriously?! You're risking everyone's safety because of your own self-interests?";
    text[3040] = "I'm asking for your help because I was the one who didn't want to kill more Murks!";
    text[3041] = ".....";
    text[3042] = "Please... I need to know the truth.";
    text[3043] = "I want to protect both humanity and the Murks.";
    text[3044] = "I believe if we work together, we can achieve this and so much more!";
    text[3045] = ".....  .....  .....  .....";
    text[3046] = "The last time we met, you asked me if I could sense the pain of the Murks...";
    text[3047] = "I actually can... and I don't know how I'm able to do this.";
    text[3048] = "I just... feel it in my soul.";
    text[3049] = "I recently met a Murk... that spoke to me.";
    text[3050] = ".... What did it say?";
    text[3051] = "Protect.";
    text[3052] = "This is... interesting.";
    text[3053] = "I've never heard a Murk communicate with anyone before.";
    text[3054] = "(The Murk that spoke to her...)";
    text[3055] = "(Could it be...?)";
    text[3056] = "Tell me...";
    text[3057] = "What's your name?";
    text[3058] = "My name is Bella Grey.";
    text[3059] = "Grey...";
    text[3060] = "So you're Thea's daughter?!";
    text[3061] = "(Then, maybe I can trust her...)";
    text[3062] = "(...)";
    text[3063] = "Wait, you knew my mother?";
    text[3064] = "...yeah.";
    text[3065] = "She was a worthy leader, unlike your current one.";
    text[3066] = "Huh? Saros is a great leader! What do you have against Saros?";
    text[3075] = "Bella, we've got this rascal surrounded!";
    text[3067] = "You... I told you to come alone!";
    text[3068] = "This was a set up all along!";
    text[3069] = "No! I didn't tell them anything!";
    text[3070] = "Raine! Melody! Zara!";
    text[3071] = "Please put down your weapons!";
    text[3072] = "I'm just trying to talk to him!";
    text[3073] = "No can do Bella. Saros told us you'd try to come here.";
    text[3074] = "I'm sorry... We're just following orders.";
    text[3076] = "Bella, this is our best shot at finally capturing the Murk Slayer!";
    text[3077] = "Tch. I gotta get out of here.";
    text[3078] = "I can't let you leave! We need your help!";
    text[3079] = "I'm done talking. You're all going down!";
    text[6004] = "Gahhhhhh!";
    text[7566] = "Are you okay? What's happening?";
    text[6005] = "NO...";
    text[6006] = "STAY BACK...";
    text[6007] = "I WON'T... LET IT CONSUME ME AGAIN...";
    text[6008] = "Woah...";
    text[6009] = "What was that?!";
    text[3080] = "Huff... Huff...";
    text[6010] = "That form...";
    text[6011] = "That's what I become when my Antimatter consumes me...";
    text[3081] = "Please don't... push me any further...";
    text[3082] = "If I lose control again...";
    text[3083] = "I don't want to keep fighting you. You are not my enemy.";
    text[3084] = "Please try to cooperate with us!";
    text[3085] = "Holo-Field Activate!";
    text[3086] = "Looks like we made it just in time.";
    text[3087] = "....";
    text[3088] = "We meet again, Murk Slayer.";
    text[3089] = "I suggest you stay still if you value your life.";
    text[3090] = "This Holo-Field is designed to absorb kinetic energy.";
    text[3091] = "If it reaches a certain threshold, we can use the stored energy";
    text[3092] = "to make the Holo-Field implode on itself...";
    text[3098] = "...you'd be killed by your own powers.";
    text[3093] = "You're bluffing.";
    text[3094] = "Your Holo Tech has never stopped me in the past!";
    text[3095] = "Hahaha! We made some major upgrades since the last time we fought.";
    text[3096] = "Go ahead.";
    text[3097] = "Just risk everything you've been working towards.";
    text[3099] = "....Tch.";
    text[3100] = "You've done well Bella. I knew I could count on you.";
    text[3101] = "....Thanks...";
    text[3102] = "Take him to the Prison Compound.";
    text[3103] = "We've got some catching up to do, Murk Slayer.";
    text[3104] = "....";
    text[3105] = "Your recklessness...";
    text[3106] = "...the people you've hurt...";
    text[3107] = "...the destruction of Sector 3...";
    text[3108] = "...and the Anticores you've collected...";
    text[3109] = "Justice will be served for all your crimes.";
    text[3110] = "You're going to tell us where you're hiding all the Anticores.";
    text[3111] = "Don't you want to save humanity?";
    text[3112] = "Save humanity?";
    text[3113] = "From what? The Murks?";
    text[3114] = "From YOU?";
    text[3115] = "What delusional nonsense are you spouting now?";
    text[3116] = "I am humanity's protector. The Lunex Force exists to serve the people.";
    text[3117] = "You're the one who is a danger to all of us.";
    text[3118] = "I'll save humanity on my own. I refuse to help you.";
    text[3119] = "Huff... Huff...";
    text[3120] = "Looks like you're all out of stamina. We'll have to talk later.";
    text[3121] = "Everyone, take a well deserved rest. We will hold a ceremony soon.";
    text[3124] = "Today is a day to be remembered.";
    text[3122] = "We not only captured the Murk Slayer,";
    text[3123] = "We also successfully stopped the largest Murk outbreak in history!";
    text[3125] = "YES GENERAL!";
    text[3145] = "A few hours later...";
    text[3146] = "My fellow citizens of Sector 7!";
    text[3147] = "We are gathered here to honor and thank our brave Lunex Warriors";
    text[3148] = "who stand behind me, for protecting this sector and it's people during this crisis.";
    text[3149] = "They put their lives on the line to ensure the safety of everyone.";
    text[3150] = "I'm happy to say there were no casualties during this outbreak.";
    text[3151] = "This is a tremendous victory for humanity!";
    text[3152] = "YEAHHHH! WOO HOOOOO!";
    text[3153] = "We will continue to take every action necessary to learn more about the Murks,";
    text[3154] = "...and how we can defend against these monsters!";
    text[3155] = "There is always hope! Cheers to a new day and to a bright future for Luna!";
    text[3161] = "May our Lux shine forever bright!";
    text[3162] = "YEAH! Recognition babyyyyy! Everyone did such a great job today!";
    text[3163] = "Yup! This was definitely the toughest mission we've ever faced!";
    text[3164] = "I agree. You did a great job too, Tetra.";
    text[3165] = "I'm Outbreak Hero Sidekick Tetra now, heheh.";
    text[3166] = "Bella, are you okay?";
    text[3167] = "You just stuffed yourself with 5 Cheesecake Bars.";
    text[3168] = "What's on your mind?";
    text[3169] = "...";
    text[3170] = "It's just... I was so close to getting the truth...";
    text[3171] = "Hey look, I'm sorry about earlier.";
    text[3172] = "We were just following orders...";
    text[3205] = "Bella, think about it this way:";
    text[3173] = "At least we captured the Murk Slayer, right?";
    text[3174] = "Now we can interrogate him whenever we want!";
    text[3175] = "...!";
    text[3176] = "That's true...";
    text[3177] = "Perks of saving the day is all-you-can-eat free food at the cafe! BAHAHAHA!";
    text[3178] = "C'mon, just enjoy the moment Bella. We're heroes!";
    text[3179] = "Thanks for cheering me up guys.";
    text[3180] = "We successfully completed the mission thanks to everyones' combined efforts!";
    text[3181] = "5 more Cheesecake Bars please! We have to celebrate, heh.";
    text[3182] = "Aw yeah, babyyyy! That's what I'm talkin' about!";
    text[3183] = "Mmm, this ramen is delicious.";
    text[3184] = "The combo of ingredients they used came together nicely into an elegant dish.";
    text[3185] = "I'd like another strawberry milkshake, actually. It's so yummy!";
    text[3186] = "I'll have 6 Cheesecake Bars! BAHAHAHA!";
    text[3187] = "I'll eat MORE than you, AND faster than you!";
    text[3188] = "This isn't a race Raine!";
    text[3189] = "If I win, you owe me another sparring session! I'm gonna pummel you!";
    text[3190] = "...";
    text[3191] = "Sparring or Food Eating Contest.... either way, I'm not letting you beat me.";
    text[3192] = "WE'LL SEE ABOUT THAT! (NOM NOM NOM NOM NOM NOM)";
    text[3193] = "I WON! YESSSS!";
    text[3194] = "Ugh... I'm sooooo full...";
    text[3195] = "TAKE THAT! NOW YOU OWE ME ANOTHER SPARRING SESSION!";
    text[3196] = "Right here, right now!";
    text[3197] = "Raine, you're soooo loud. The other customers are staring.";
    text[3198] = "Tch. Fine, Fine. We'll save it for next time.";
    text[3199] = "I think it's time for us to head home now.";
    text[3200] = "We'll stay for a bit longer. I must finish this delicious ramen.";
    text[3201] = "Say hi to Doctor Thomas for us!";
    text[3202] = "Alrighty, take care y'all!";
    text[3203] = "Let's head back to the Space Station Tetra. I feel sleepy...";
    text[3204] = "Okiedokie, let's zip!";
    text[7985] = "What is it, Bella?";
    text[7986] = "It's a missing persons list... It was updated today.";
    text[7987] = "Looks like several people went missing after the outbreak.";
    text[7988] = "Was Saros even aware of this?";
    text[7989] = "Why didn't he address it during his victory speech?";
    text[7990] = "This outbreak must have been a terrifying experience for many people...";
    text[7999] = "Maybe he wants to keep everyone's spirits up?";
    text[7991] = "Even though there were no casualties,";
    text[7992] = "many citizens and soldiers still got hurt.";
    text[7993] = "...and now it turns out there's missing people...";
    text[8001] = "I didn't even get a chance to properly talk to the Murk Slayer either...";
    text[8000] = "None of this feels like a victory to me...";
    text[8002] = "This isn't like you, Bella...";
    text[8003] = "You've gotta be optimistic! Things could have been much worse!";
    text[7994] = "We should let the Lunex Force Search Team look for the missing people.";
    text[7995] = "I'm sure they'll find them!";
    text[7996] = "Right now, you deserve a much needed rest! You did a great job today!";
    text[7997] = "Okay... You're right. Let's go home!";
    text[7567] = "Hey, Bella?";
    text[7568] = "Yeah, Tetra?";
    text[7569] = "This purple Jet Suit...";
    text[7570] = "You've had this Jet Suit displayed in your room for a while.";
    text[7571] = "I analyzed the suit a while back...";
    text[7572] = "It's way more durable than your current one...";
    text[7573] = "It's also got more features!";
    text[7574] = "I was wondering...";
    text[7575] = "Is there a reason why you don't wear it?";
    text[7576] = "I figured it could be a nice upgrade to your current Jet Suit and";
    text[7577] = "after what we've experienced during the recent outbreak,";
    text[7578] = "we could always use better equipment to help us fight the Murks!";
    text[7579] = "Well...";
    text[7580] = "This used to be one of Mom's old Jet Suits.";
    text[7581] = "I was planning on wearing it someday, but...";
    text[7582] = "...I don't think I'm ready to wear it yet.";
    text[7583] = "I still have a lot to learn and experience.";
    text[7584] = "Sure, it's a more advanced Suit than the one I have now...";
    text[7585] = "...It also looks pretty cool too.";
    text[7586] = "Purple was Mom's favorite color...";
    text[7587] = "But it just...";
    text[7588] = "It wouldn't feel right to wear it...";
    text[7589] = "...Until I become a hero that Mom would truly be proud of.";
    text[7590] = "...Until I'm able to be someone who can protect not just humanity,";
    text[7591] = "but all forms of life on Luna.";
    text[7592] = "That includes the Murks.";
    text[7593] = "@P.@P.@P.@P.@P.@P.";
    text[7594] = "Tetra, when that day comes...";
    text[7595] = "...When I'm ready...";
    text[7596] = "You'll be the first to know, okay?";
    text[7597] = "Roger that! I'm looking forward to it! Heheh.";
    text[7598] = "C'mon, let's get some rest.";
    text[7599] = "It's been a long day.";
    text[7600] = "Okiedokie! I need to recharge as well!";
    text[3501] = "It's been a long day. Wanna go to sleep?";
    text[6016] = "Saros...";
    text[6017] = "You know...";
    text[6018] = "You're not making this easy for any of us, Murk Slayer.";
    text[6019] = "If only you'd cooperate...";
    text[6020] = "I wouldn't have to restrain you like this.";
    text[6021] = "You scum...";
    text[6022] = "Well now, is that how you greet an old friend?";
    text[6023] = "We're not friends.";
    text[6024] = "Listen closely, Murk Slayer... Here's the rundown.";
    text[6025] = "Comet Coda has returned... and it will destroy us all.";
    text[6026] = "In order to save humanity, we must evolve past our limitations.";
    text[6027] = "We must adapt.";
    text[6028] = "In order to do that, we need as many Anticores as we can get.";
    text[6029] = "Now tell me...";
    text[6030] = "Where are the Anticores you're hiding?";
    text[6031] = "If they're in the hands of the Lunex Force,";
    text[6032] = "we can at least put them to good use.";
    text[6033] = "Don't you want to help save humanity?";
    text[6034] = "I'd rather die than give you any more Anticores.";
    text[6035] = "I refuse to help you.";
    text[6036] = "In that case....";
    text[6037] = "Vivia. Initiate the Antimatter Extraction.";
    text[6038] = "Gahhhh!!! AHHHHHH!";
    text[6039] = "GAHHHHHHHRGGHHHH!";
    text[6040] = "If you won't tell us where you're hiding them...";
    text[6041] = "...I'll just have to extract every last molecule of Antimatter from you.";
    text[6042] = "Now then... Show me...";
    text[6043] = "The beast inside. Your PHASE FORM.";
    text[6044] = "...NO! GAHHHHH!";
    text[6045] = "I... REFUSE...";
    text[6046] = "You leave us with no other option.";
    text[6047] = "Antimatter is the key to saving humanity.";
    text[6048] = "You will help us whether you like it or not...";
    text[6049] = "...Murk Slayer.";
    text[3502] = "...Voices...";
    text[3503] = "...";
    text[3504] = "Hundreds? Maybe thousands?...";
    text[3505] = "Protect...";
    text[3506] = "What am I fighting to protect?";
    text[3507] = "Drifting...";
    text[3508] = "It feels like someone is here with me...";
    text[3509] = "Chronos...?";
    text[3510] = "Everything is fading...";
    text[3511] = "I need to know...";
    text[3512] = "...the truth.";
    text[3837] = "Bella, are you okay?";
    text[3838] = "You were tossing and turning all night in your sleep!";
    text[3839] = "...I'm okay.";
    text[3840] = "Tetra, I should talk to Dad about these strange feelings I've been experiencing.";
    text[3841] = "I usually don't like to worry or burden others, but...";
    text[3842] = "I'm starting to get worried myself...";
    text[3843] = "It feels as if the Murks are calling me. I can hear their voices...";
    text[3844] = "Did you hear Chronos' voice?";
    text[3845] = "Yeah, and a few other voices too.";
    text[3846] = "Mom once told me I had a gift that nobody else had.";
    text[3847] = "...but she never really explained further.";
    text[3848] = "I always assumed she was referring to my fighting abilities, but...";
    text[3849] = "...Maybe she was referring to something else?";
    text[3850] = "Hmm... Let's go talk to Dad.";
    text[3851] = "Alrighty!";
    text[3862] = "Hey, is my Dad in the Research Lab?";
    text[3863] = "I'm sorry Miss Bella, your father is currently at a tech conference";
    text[3864] = "to discuss matters related to improving the design of Celestia.";
    text[3865] = "My job is to guard the entrance, hahahaha...";
    text[3866] = "Ahh, I see. Thanks for letting me know!";
    text[3867] = "Hmm...";
    text[3868] = "What if you just call Doctor Thomas? I'm sure he won't mind.";
    text[3869] = "He's busy right now. I'd rather wait 'till he gets back.";
    text[3870] = "Despite not sleeping well, I actually feel recharged!";
    text[3871] = "Let's go be productive, and see if there's any new missions we can do!";
    text[3872] = "Oooo okay! The MISSION BOARD is down in the 1F Lobby.";
    text[3873] = "We should go talk to Stella first!";
    text[3874] = "She's in charge of assigning new missions, heh.";
    text[3877] = "Hey Bella! You look fired up!";
    text[3878] = "I am! Do you have any new missions for me?";
    text[3879] = "You're in luck! There are 3 missions available!";
    text[3880] = "Sweet!";
    text[3881] = "Just head on over to the MISSION BOARD behind you.";
    text[3882] = "Once you read a mission description, it will automatically be accepted!";
    text[3883] = "You can complete missions in any order you wish!";
    text[3884] = "From now on, you can just head straight to the MISSION BOARD";
    text[3885] = "to see if there's new missions available!";
    text[3886] = "Good luck!";
    text[3887] = "Thanks Stella!";
    text[3891] = "We finally tracked down a Bandit Ship that is transporting stolen goods.";
    text[3892] = "These bandits are part of a larger criminal organization, and your mission is to";
    text[3893] = "infiltrate their ship, arrest the bandits, and retrieve the stolen goods.";
    text[3894] = "One of our Military Jets was damaged from an attack from a nearby Murk.";
    text[3895] = "The pilot was unharmed, and they landed their ship safely in Wasteland Zone 1.";
    text[3896] = "Your mission is to assist the pilot in locating and retrieving our lost cargo.";
    text[3897] = "Kepler Ranch is experiencing an unprecedented food shortage.";
    text[3898] = "We've received several reports of ravaged and missing crops.";
    text[3899] = "Your mission is to investigate and solve the case of the missing crops.";
    text[3633] = "Hands up!";
    text[3634] = "By the authority of the Lunex Force, you are all under arrest,";
    text[3635] = "for the possession and theft of stolen goods!";
    text[3636] = "Ahh, so you're the filthy rat that dragged yourself in uninvited.";
    text[3637] = "You're too late, chump. We're two steps ahead of you.";
    text[3638] = "What do you mean?";
    text[3639] = "Most of the goods have already been transported elsewhere.";
    text[3640] = "I also initiated the self-destruct sequence for this ship.";
    text[3641] = "We're gonna take you down, and then make our escape before this ship blows!";
    text[3642] = "Dang it...";
    text[3643] = "Tetra, how long do we have?";
    text[3644] = "We have to beat these bandits in less than 10 TURNS or else we're toast!";
    text[3645] = "The boss doesn't like filthy rats messin' with our business.";
    text[3646] = "I've terminated plenty of Lunex Soldiers in my time...";
    text[3647] = "...and you're gonna be NEXT!";
    text[3648] = "Annnd self-destruct sequence deactivated!";
    text[3649] = "Good job Bella! Those bandits were nothing but trouble!";
    text[3650] = "Backup should be arriving soon to retrieve the remaining goods on this ship.";
    text[3651] = "Let's head out whenever you're ready! Heh.";
    text[3900] = "Hi there. I'm the pilot that sent the mission request for the lost cargo.";
    text[3901] = "Thanks for helping me out!";
    text[3902] = "No problem! Please give us further details on how we can assist you.";
    text[3903] = "Okay so... The issue isn't finding the cargo itself...";
    text[3904] = "It's the potential dangers of Murk attacks during the search.";
    text[3905] = "We actually place tracking devices on all of our shipments.";
    text[3906] = "There's a total of 3 missing cargo packages.";
    text[3907] = "...and they were last detected in 3 separate Loot Areas on Luna.";
    text[3908] = "What's a Loot Area?";
    text[3909] = "Loot Areas were dubbed by treasure hunters many years ago.";
    text[3910] = "They're sub-areas that you can discover while you're flying in your ship.";
    text[3911] = "There's no telling what you can find in a Loot Area, since they're all";
    text[3912] = "located within mostly uncharted territories on Luna.";
    text[3913] = "You could find treasures, dungeons, and even undiscovered Murks!";
    text[3914] = "I'm not strong or skilled enough to take on a Murk, so...";
    text[3915] = "Hey, that's what we're here for! Right, Tetra?";
    text[3916] = "Yep! Don't worry, we'll go and find that cargo for you!";
    text[3917] = "Thank you so much! The Loot Areas can be found in the World Map.";
    text[3918] = "Good luck!";
    text[3919] = "You found the first missing cargo package! Two more to go!";
    text[3920] = "You found the second missing cargo package! One more to go!";
    text[3921] = "You found the last missing cargo package!";
    text[8491] = "Miss Nyla! Reeves! What are you two doing here?";
    text[8492] = "Myeh! We're on our break!";
    text[8493] = "We figured we could help the Archeology Team analyze their recent discovery.";
    text[8494] = "Oooo, what did you guys find?";
    text[8531] = "Well...";
    text[8495] = "They found these glowing tablets!";
    text[8496] = "They're relics left behind by an ancient civilization...";
    text[8497] = "...a society of people that existed long before humanity settled on Luna.";
    text[8498] = "Do we have a name for them?";
    text[8499] = "Your mother used to study this ancient civilization years ago...";
    text[8500] = "She simply called them 'The Ancients'.";
    text[8501] = "Thats...";
    text[8502] = "...very original.";
    text[8503] = "Mom was never really good at naming things, eheheh...";
    text[8504] = "When I was little, I remember she mentioned something about the Ancients once...";
    text[8505] = "...The Ancients had some sort of connection to Lux and Antimatter.";
    text[8506] = "Indeed! Myeh.";
    text[8507] = "The extent of our knowledge regarding the Ancients is pretty slim...";
    text[8508] = "The Archeology Team's sole mission is to uncover the history of Luna's past...";
    text[8509] = "...But its been tough to go on more expeditions lately due to lack of funding...";
    text[8510] = "Huh?! Was Saros responsible for the cut funding?";
    text[8511] = "Myeh, Saros insists our resources are better spent looking towards the future,";
    text[8512] = "rather than the past.";
    text[8513] = "...I see.";
    text[8514] = "If I was the General, I would have doubled the funding for the Archeology Team.";
    text[8515] = "I think its important to understand our roots...";
    text[8516] = "...and the people that lived here before us.";
    text[8517] = "I wonder why the Ancients disappeared...";
    text[8518] = "Who knows? That's something we have yet to discover! Myeh!";
    text[8519] = "So, what brings you here, Bella?";
    text[8520] = "Oh, I'm just tackling some Lunex Force Missions right now.";
    text[8521] = "Very well then, don't let us distract you!";
    text[8522] = "Keep up the great work, Bella!";
    text[3922] = "Let's report back to the pilot in Wasteland Zone 1!";
    text[3927] = "Wait! We can't leave without getting the cargo!";
    text[3923] = "Awesome! You found all the packages!";
    text[3924] = "Were they difficult to find?";
    text[3925] = "Some of the local Murks were holding the packages...";
    text[3926] = "...but it was nothing we couldn't handle, heh.";
    text[3928] = "What was inside the packages anyways?";
    text[3929] = "Ship Parts for our newest military jet!";
    text[3930] = "Mission Control authorized me to reward you with new Ship Parts!";
    text[3931] = "Falcon Ship Set obtained! This set includes the following parts:";
    text[3932] = "FALCON FRAME, FALCON WING, AND FALCON THRUSTER!";
    text[3933] = "Job well done! Thank you!";
    text[3934] = "Howdy! My name is Carl.";
    text[3935] = "I'm the field manager here at Kepler Ranch.";
    text[3936] = "Nice to meet you Carl! Please tell us the situation.";
    text[3937] = "We've got a mysterious culprit responsible for the destruction";
    text[3938] = "of 2 of our crop fields.";
    text[3939] = "Many sectors rely on us for a stable food supply...";
    text[3940] = "We can't afford to let any more of our crops get ravaged...";
    text[3941] = "Don't worry Carl. Leave this to us!";
    text[3942] = "We'll do our best to resolve this situation as swiftly as possible.";
    text[3943] = "Are there any animals here in this farm?";
    text[3944] = "There's no animals here. They're kept at a different farm.";
    text[3945] = "Hmm... If it's not an animal, then...";
    text[3946] = "What's on your mind, Bella?";
    text[3947] = "This might sound like a silly question, but...";
    text[3948] = "Tetra, can you check the database to see if there's any info";
    text[3949] = "on Murks consuming things other than humans?";
    text[3950] = "Okie, gimme like 2 milliseconds...";
    text[3951] = "Done!";
    text[3952] = "Here's what I found:";
    text[3953] = "In order for Murks to replenish their antimatter reserves,";
    text[3954] = "they can either consume high-density antimatter,";
    text[3955] = "or organic life-forms, due to the high concentration of Lux present.";
    text[3956] = "Hmm... Plants and crops are considered organic lifeforms.";
    text[3957] = "So you think a Murk is ravaging our crops?";
    text[3958] = "It's possible. Have there been any Murk sightings here recently?";
    text[3959] = "None that I'm aware of.";
    text[3960] = "Due to our low population density, we rarely get Murks here...";
    text[3961] = "I see...";
    text[3962] = "For your safety, please wait for us here.";
    text[3963] = "Tetra, let's go look for clues.";
    text[3964] = "Alrighty! Sherlock-Tetra is ready!";
    text[3965] = "We can't risk losing any more of our crops...";
    text[3966] = "Please investigate and let me know how it goes.";
    text[3967] = "There were mint herbs growing in this plot of land.";
    text[3968] = "The culprit must really like mint, huh?";
    text[3969] = "A mint-loving Murk... that's a first.";
    text[3970] = "Hey look, there's footprints here! It kinda looks like boar hooves...";
    text[3971] = "Tetra, run a scan on these footprints.";
    text[3972] = "Hmm, there's several Murks that could have a footprint like this.";
    text[3973] = "We need to look for more clues to narrow it down.";
    text[3974] = "If we can identify the exact species of Murk,";
    text[3975] = "we'll know exactly what we're up against...";
    text[3977] = "There's a lot of loose soil and craters here.";
    text[3978] = "Our culprit could be using wormholes to eat crops and then escape.";
    text[3979] = "We have to be cautious, just in case.";
    text[3980] = "There's some bite marks on these steel barrels!";
    text[3981] = "What does the label on the barrel say?";
    text[3982] = "Raw ingredients for Battle Mints...";
    text[3983] = "Hmm...";
    text[3984] = "I simulated the jaw of what could have caused these bite marks.";
    text[3985] = "It appears to match the jaws of an alligator...";
    text[3986] = "It can't be an alligator though... They're extinct!";
    text[3987] = "EW, WHAT IS THAT?!";
    text[3988] = "It looks like some sort of slimy, shedded skin?";
    text[3989] = "I need some time to run a proper analysis on this.";
    text[3990] = "There appears to be traces of antimatter on the skin.";
    text[3991] = "EW EW EW. You carry it!";
    text[3992] = "Okay, I think that's all the clues we could find...";
    text[3993] = "So, what do we know?";
    text[3994] = "Let's see... Head of an alligator...";
    text[3995] = "Hooves of a boar...";
    text[3996] = "Really likes Mint for some reason...";
    text[3997] = "Sheds skin like a reptile!";
    text[3998] = "Oh!";
    text[3999] = "It looks like we have a match!";
    text[4000] = "There's a Murk in the Lunex Force Database that matches our clues!";
    text[4001] = "CODENAME: KAPROSAUR!";
    text[4002] = "Sweet! Great work Tetra!";
    text[4003] = "Heh.";
    text[4004] = "I have an idea...";
    text[4005] = "We're gonna lure out the Kaprosaur with a Battle Mint, heh.";
    text[4006] = "You really think this is going to work?";
    text[4007] = "We might as well try.";
    text[4008] = "Let's go get ourselves a Battle Mint and then come back here.";
    text[4009] = "I don't think it's working...";
    text[4010] = "It has to! We have no other leads!";
    text[4011] = "Huh?!";
    text[4012] = "What happened?";
    text[4013] = "I'm detecting a Murk!";
    text[4014] = "Culprit found!";
    text[4015] = "Uhm... Bella, the Kaprosaur looks super agitated...";
    text[4016] = "I think we might have startled it!";
    text[4017] = "Be careful! It could attack us at any moment!";
    text[4018] = "Don't worry, I got this!";
    text[4019] = "The Kaprosaur escaped!";
    text[4020] = "It's okay.";
    text[4021] = "Now that we confirmed the culprit is a Murk,";
    text[4022] = "Mission Control will have to send more patrol guards to Kepler Ranch.";
    text[4023] = "Ohh, true!";
    text[4024] = "Let's head back to Carl!";
    text[4025] = "My goodness, the culprit was a Murk all along?!";
    text[4026] = "Yeah, but there's no need to worry anymore. We scared it off for now.";
    text[4027] = "I'll send a request for additional Lunex Force soldiers to help";
    text[4028] = "secure the crops from future hungry Kaprosaurs.";
    text[4029] = "Thank you so much for saving our farm!";
    text[4030] = "Here's a little somethin' from me.";
    text[4032] = "A Murk who loves eatin' mint... Now that's somethin' rare!";
    text[4103] = "Oh? Doctor Thomas is calling!";
    text[4104] = "Bella! I heard you were looking for me.";
    text[4105] = "Sorry I was away... There were some important matters I had to attend to.";
    text[4106] = "Dad, I need to talk to you about something. Are you busy?";
    text[4107] = "Just made a cup of coffee! I've got some time.";
    text[4108] = "Is everything alright?";
    text[4109] = "Yeah... I'll explain everything when I see you.";
    text[4110] = "Tetra, let's go meet up with Dad at the Research Lab.";
    text[4111] = "Okiedokie!";
    text[4112] = "Bella explains to Doctor Thomas the strange feelings she's been having,";
    text[4198] = "and the full truth about her encounter with Chronos in the Phantom Realm...";
    text[4113] = "You should have talked to me sooner about this Bella.";
    text[4114] = "I know... I didn't think it was an issue until I started hearing voices...";
    text[4115] = "Dad, I'm worried... Am I going to be okay?";
    text[4116] = "You'll be fine. There's no need to worry.";
    text[4199] = "'Protect'...";
    text[4148] = "Perhaps it's a sentiment shared by many Murks.";
    text[4153] = "I never once considered the Murks might be scared of us...";
    text[4149] = "We're slowly killing off their species in order to save ours.";
    text[4150] = "Maybe they want Bella to protect them?";
    text[4151] = "...but why me?";
    text[4152] = "Maybe it's because you're the only one who is capable of communicating with them.";
    text[4117] = "I didn't think the ability would be hereditary, but it looks like your Mother was right.";
    text[4118] = "Right about what? What have you and Mom been keeping from me?";
    text[4119] = "I'm sorry I didn't tell you sooner.";
    text[4120] = "It appears you have a latent ability to manipulate your Lux.";
    text[4121] = "...an ability your mother also had.";
    text[4122] = "Lux manipulation...?! Mom's research said it was just a theory!";
    text[4123] = "It was... until she discovered she could do it as well.";
    text[4124] = "Your mother was a scientist before she became the general.";
    text[4125] = "My field of research revolved around Antimatter, while Thea's revolved around Lux.";
    text[4126] = "It is known that the soul exists.";
    text[4127] = "Our current technology allows us to measure it... and quantify it to an extent.";
    text[4128] = "Lux is essentially the manifestation of willpower and the soul in the form of energy.";
    text[4129] = "It can grow and change depending on the emotional and physical state of the user.";
    text[4130] = "Your mother suspected that if she learned to control her Lux,";
    text[4131] = "she might have been able to communicate with the Murks...";
    text[4132] = "After she passed... We had no way of confirming her theories...";
    text[4133] = "We don't have time to wait for my Lux ability to show itself again!";
    text[4134] = "How can I control my Lux?! Did Mom tell you anything?";
    text[4135] = "I wish I knew...";
    text[4136] = "There are secrets your Mother kept from me as well...";
    text[4137] = "Why would she hide these things from us...";
    text[4138] = "Knowing your mother... It was likely to protect us.";
    text[4139] = "Protect us from what?";
    text[4140] = "I don't know... I need another cup of coffee. My mind is melting.";
    text[4141] = "(I need to find out what Mom discovered about the Murks...)";
    text[4142] = "(I'm not going to give up.)";
    text[4143] = "Maybe there's someone else out there that might know the information she knew?";
    text[4144] = ".... .... ....!";
    text[4145] = "The Murk Slayer!";
    text[4146] = "When I spoke to him in Copernicus, he said he knew Mom.";
    text[4147] = "I need to talk to him again!";
    text[4155] = "Bella, you should stay here...";
    text[4156] = "Why? Sitting around isn't going to accomplish anything!";
    text[4157] = "We can't let anyone know about your latent ability...";
    text[4158] = "Your Mother kept it a secret for a reason. We should trust her judgement.";
    text[4159] = "You've done well so far. Let the Lunex Force take care of the rest.";
    text[4160] = "We'll get the anticores from the Murk Slayer and once Celestia is complete,";
    text[4161] = "Comet Coda won't stand a chance. The People of Luna will be safe.";
    text[4162] = "...why are you staring at me like that?";
    text[4163] = "You're hiding something.";
    text[4164] = "I'm not... I'm gonna go get another coffee...";
    text[4165] = "Your demeanor changed when I mentioned the Murk Slayer.";
    text[4166] = "Dad, please tell me what's going on.";
    text[4167] = "Stop trying to protect me like Mom always did.";
    text[4168] = "I'm capable of taking care of myself!";
    text[4169] = "...After my conference, I stopped by the Military Base to talk to Saros.";
    text[4170] = "I asked him what he intends to do with the Murk Slayer...";
    text[4171] = "If the Murk Slayer doesn't give up the Anticores he's hiding from us...";
    text[4172] = "Saros may have to extract Antimatter directly from the Murk Slayer himself.";
    text[4173] = "This process... will likely kill him.";
    text[4174] = "N-no! We can't let Saros do that!";
    text[4175] = "It's cruel! I don't agree with this!";
    text[4176] = "I don't agree with his decision either but... what choice do I have?";
    text[4177] = "As a father, I must protect my family...";
    text[4178] = "Doing anything to go against the Lunex Force would put us at risk.";
    text[4179] = "Dad, we have to convince Saros not to do this!";
    text[4180] = "I already tried...";
    text[4181] = "Saros is determined to do whatever it takes to save humanity,";
    text[4182] = "even at the cost of the Murk Slayer's life.";
    text[4183] = "No... I need another chance to talk to the Murk Slayer...";
    text[4184] = "Maybe I can finally convince him to tell us where the Anticores are!";
    text[4200] = "Dad, please... ... ...";
    text[4185] = ".... .... ....";
    text[4186] = "...(sigh) If I said no, you'd probably go on your own anyways.";
    text[4187] = "Take this.";
    text[4189] = "The Lunex Key grants you the authority to enter the Military Base and the Prison Compound.";
    text[4190] = "Please be careful. I'm rooting for you.";
    text[4191] = "Thanks Dad.";
    text[4192] = "I knew I could count on you!";
    text[4193] = "I'll talk to Saros later.";
    text[4194] = "If anyone can gain the trust of the Murk Slayer, it's you.";
    text[4195] = "Bella, please don't do anything reckless...";
    text[4196] = "Don't worry Dad! I won't.";
    text[4197] = "Let's go to the Military Base, Tetra! It's located in the Wasteland Zone!";
    text[4205] = "I smell a new mission! Count me in!";
    text[4207] = "Alright Tetra. This is no ordinary Mission.";
    text[4208] = "It isn't?";
    text[4209] = "Nope. It's a stealth Mission.";
    text[4210] = "I don't want Saros to know we're here...";
    text[4211] = "Dad said he'll do whatever it takes to complete his objectives.";
    text[4212] = "He'll stop me if I give him a reason to...";
    text[4213] = "...and I'm not strong enough to face him either.";
    text[4214] = "We need to keep a low profile as much as possible.";
    text[4215] = "Are you sure you want to go through with this Bella?";
    text[4216] = "If we get caught...";
    text[4217] = "We won't get caught. I have my trusty sidekick with me, heh.";
    text[4218] = "True, heh. Super Stealth Sidekick Tetra is fired up and ready!";
    text[4219] = "Tetra, do you happen to have any files on Lunex HQ in your database?";
    text[4220] = "If I said yes, am I in trouble?";
    text[4221] = "No, silly.";
    text[4222] = "Whew!";
    text[4223] = "You usually lecture me when I download top-secret info without permission.";
    text[4224] = "Not this time. Your data hoarding actually comes in handy!";
    text[4225] = "Alright, gimme like 2 milliseconds...";
    text[4226] = "Done! What would you like to know?";
    text[4227] = "Is there another way into the Prison Compound, aside from the main entrance?";
    text[4228] = "According to the Military Base Floor Plans, there's an old access hatch";
    text[4229] = "we can use in the Sewage Area, which is connected to the Prison Compound!";
    text[4230] = "Ew Ew Ew! Did you just say Sewage Area?";
    text[4231] = "Yep!";
    text[4232] = "Please tell me there's ANOTHER way in...";
    text[4233] = "Nope!";
    text[4234] = "Dang it... I'm gonna have to wash my Jet Suit later...";
    text[4235] = "Alright, let's go to the Sewage Area! (Ew!)";
    text[4052] = "This machine has a computer that controls the laser doors!";
    text[4053] = "Would you like me to dive into the Sewer Network?";
    text[4241] = "We're in!";
    text[4242] = "The Murk Slayer should be in one of the cells here.";
    text[4243] = "Weird...";
    text[4244] = "What's wrong?";
    text[4245] = "There are no prisoners.";
    text[4246] = "...and it's oddly quiet around here.";
    text[4247] = "Let's stay on guard and keep moving forward.";
    text[4249] = "This must be the Murk Slayer's prison cell.";
    text[4250] = "How do you know?";
    text[4251] = "It looks like it's the hardest to escape from.";
    text[4252] = "Tetra, do you think you could open this electronic lock?";
    text[4253] = "Hmm...";
    text[4254] = "I can't open the lock from here.";
    text[4255] = "We need to look for the control panel that's wired to this door.";
    text[4256] = "Alright, let's go look for the control panel!";
    text[4257] = "UNAUTHORIZED JET SUIT SIGNATURE DETECTED.";
    text[4258] = "STATE YOUR BUSINESS.";
    text[4259] = "Uh oh, it's a security bot! What should we do?";
    text[4260] = "There's nowhere to run!";
    text[4261] = "We have to take it down before backup arrives!";
    text[4262] = "THREAT DETECTED.";
    text[4263] = "BATTLE MODE ENGAGED.";
    text[4264] = "Over here! The signal came from this direction!";
    text[4265] = "Uh oh! Two guards are headed towards us!";
    text[4266] = "Hide!";
    text[4267] = "*smack!* *smack!*";
    text[4268] = "I'm sorry...";
    text[4269] = "Tetra, double check their vitals.";
    text[4270] = "They'll be fine.";
    text[4271] = "They're just taking a nice nap, heh.";
    text[4272] = "They saw our face...";
    text[4273] = "There's no turning back now...";
    text[4274] = "Let's keep going.";
    text[4275] = "Wait! I have an idea.";
    text[4276] = "Tetra, you're a genius!";
    text[4277] = "Heh, tell me something I don't know.";
    text[4305] = "Jet Suits are waterproof and air-tight. In my case, all I need to do is inflate it,";
    text[4306] = "extend some robotic appendages, and bam! We have the perfect disguise, heh.";
    text[4278] = "With these Jet Suits, we won't trigger any more security bots.";
    text[4279] = "Heh. Alright, let's go. The control panel should be up ahead.";
    text[4301] = "The prison cell door should now be unlocked!";
    text[4308] = "Hey!";
    text[4309] = "Is everything alright?";
    text[4310] = "What happened to the security bot? Why did it send us a threat signal?";
    text[4311] = "Oh uh... Turns out a rat tripped the security bot's alarm.";
    text[4312] = "We recalibrated the security bot to make sure.";
    text[4313] = "it doesn't give us a false alarm next time!";
    text[4314] = "Dang, I didn't know you guys knew how to fix robots.";
    text[4315] = "You guys should teach me one of these days.";
    text[4316] = "Not much happens down here anyways.";
    text[4317] = "Hey can I ask you a question?";
    text[4318] = "Sure!";
    text[4319] = "I uh... Just got back from my vacation so I'm a bit out of the loop.";
    text[4320] = "What happened to all the prisoners?";
    text[4321] = "Oh, all of them were apparently transferred over to a different facility.";
    text[4322] = "Do you know why?";
    text[4323] = "No idea. I just know it was General Saros who made the call.";
    text[4324] = "I see. Thanks!";
    text[4325] = "We'll uh...";
    text[4326] = "...keep patrolling the area to uh... catch the rat.";
    text[4327] = "Alright, carry on.";
    text[4328] = "Whew... I can't believe that worked.";
    text[4280] = "He's not here!?";
    text[4281] = "Maybe this isn't his prison cell?";
    text[4282] = "No, this is definitely where they kept him.";
    text[4283] = "Vivia's Holo Tech is integrated into this cell to prevent him from escaping.";
    text[4284] = "Either he magically escaped or...";
    text[4285] = "...Oh no!";
    text[4286] = "We have to hurry!";
    text[4287] = "They probably took him to a room where they could extract antimatter from him.";
    text[4288] = "We're gonna have to infiltrate the Military Base to find him.";
    text[4289] = "We have our disguises now, so we can finally look around without causing suspicion.";
    text[4290] = "There's an elevator we can use that lets us go to the Military Base. Let's go find it!";
    text[4302] = "Wait, the elevator up ahead leads to the Military Base!";
    text[4303] = "Let's not go there right now.";
    text[4304] = "This soldier is unconscious...";
    text[4330] = "According to the Military Base Floor Plans, this floor was designed";
    text[4331] = "with security measures to make it difficult for prisoners to escape!";
    text[4332] = "No kidding. Didn't expect to deal with lasers and a pit of death today...";
    text[4333] = "Oh well. It's nothing we can't handle, heh.";
    text[4372] = "This must be where Vivia makes her Holo Tech.";
    text[4373] = "Hmm...";
    text[4374] = "Tetra do you think you could scan through her computer?";
    text[4375] = "See if you can find any info on how her Holo Tech works.";
    text[4376] = "Sure! This might take a while though...";
    text[4377] = "In the meantime, can I ask why?";
    text[4378] = "It's part of my plan.";
    text[4379] = "I thought the plan was to talk to the Murk Slayer?";
    text[4380] = "That's still the plan...";
    text[4381] = "...but we have to gain his trust first.";
    text[4382] = "In order to do that...";
    text[4383] = "...I think we should help him escape from here.";
    text[4384] = "HUH?! Are you sure about this Bella?";
    text[4385] = "We'd be going against the Lunex Force!";
    text[4399] = "We'll be labeled as criminals...";
    text[4386] = "I'll deal with the consequences later.";
    text[4387] = "Saving humanity is more important.";
    text[4388] = "If I help him escape, he might be more willing to open up to us.";
    text[4389] = "Okay... If you're okay with it, I'm okay with it.";
    text[4390] = "I'll support you no matter what.";
    text[4391] = "That's what super sidekicks do, heh.";
    text[4392] = "Oh! Scan complete!";
    text[4393] = "I was able to decrypt a hidden file from her computer.";
    text[4394] = "Commander Vivia's Holo Tech is controlled through a custom program.";
    text[4395] = "I found a special password that can bypass the program and deactivate her Holo Tech.";
    text[4396] = "Sweet! Save that password, it might come in handy!";
    text[4397] = "Thanks for always supporting me Tetra.";
    text[4398] = "You can call me Military Rebel Tetra now, heh.";
    text[4412] = "What have they done to him...";
    text[4413] = "He's unconcious... Vitals seem to be normal.";
    text[4416] = "(So that's what his face looks like...)";
    text[4417] = "(He's actually...)";
    text[4418] = "(...kinda cute.)";
    text[4294] = "(Uh oh, we've got company. It's Vivia!)";
    text[4295] = "(What do we do?)";
    text[4296] = "(Don't worry. Let me do the talking.)";
    text[4297] = "(No wait, she'll recognize your voice, let me do it!)";
    text[4298] = "(Wait, what?!)";
    text[4414] = "What are you two doing? You shouldn't be here.";
    text[4299] = "Apologies, Commander Vivia. We were looking everywhere for you.";
    text[4300] = "(Ohh, she's using a voice changer!) ";
    text[4400] = "General Saros has requested to speak with you in person.";
    text[4401] = "It's... urgent.";
    text[4402] = "He also sent us to guard the room in case the Murk Slayer wakes up.";
    text[4403] = "I see.";
    text[4404] = "Thank you for letting me know.";
    text[4415] = "Pardon me.";
    text[4405] = "Whew, that was close.";
    text[4406] = "At least it wasn't Saros.";
    text[4407] = "He's extremely perceptive. He would have seen right through our disguises.";
    text[4408] = "Speaking of Saros, I'm surprised we haven't bumped into him.";
    text[4409] = "That is a bit strange... I wonder what he's up to...";
    text[4410] = "Anyways, Tetra, can you disable the Holo Tech?";
    text[4419] = "Easy peazy! I just have to enable the shutdown protocol, input the password, and...";
    text[4420] = "Done!";
    text[4421] = "Hey! I need you to wake up.";
    text[4422] = "Murk Slayer, wake up!";
    text[4423] = "Ugh...";
    text[4424] = "That voice...";
    text[4425] = "...Bella?";
    text[4426] = "Yea, it's me. I came to get you out of here.";
    text[4427] = "Seriously? But why?";
    text[4428] = "...because you're stubborn.";
    text[4429] = "You'd rather die than tell Saros where the anticores are.";
    text[4430] = "...";
    text[4431] = "I don't think you're a bad person. You don't deserve to die.";
    text[4432] = "Hmph... You don't know me, and you don't know what I've done.";
    text[4433] = "Even so, I'm willing to help you...";
    text[4434] = "...because it's the right thing to do.";
    text[4435] = "Come on Murk Slayer. We have to get out of here ASAP!";
    text[4436] = "Stop calling me the Murk Slayer.";
    text[4437] = "My name is Nickle.";
    text[4438] = "Nickle, are you able to walk?";
    text[4439] = "I'll be fine. I'm a bit light-headed, but I can still fight if I need to.";
    text[4440] = "You head out first. I'll be right behind you.";
    text[4441] = "You don't trust me?";
    text[4442] = "I don't trust anyone.";
    text[4443] = "How do I know you're not going to sneak attack us and then run away?";
    text[4444] = "I'm not.";
    text[4445] = "So you're implying I should trust you?";
    text[4446] = "...I need to ask you something later. It's important.";
    text[4447] = "As much as I hate to admit it...";
    text[4448] = "I need your help...";
    text[4449] = "Sweet! Then it's settled.";
    text[4450] = "We have to work together if we want to escape.";
    text[4451] = "Bella, Tetra, and Nickle - Partners in Crime!";
    text[4452] = "The Three Lunar Musketeers! Heh.";
    text[4453] = "Is your robot always this annoying?";
    text[4454] = "This annoying robot freed you from the Holo Tech, thank you very much!";
    text[4455] = "You owe me. Hmph.";
    text[4456] = "...Whatever. Let's go.";
    text[4511] = "NICKLE HAS JOINED THE PARTY!";
    text[4457] = "WARNING - LOCKDOWN INITIATED";
    text[4458] = "THE MURK SLAYER IS ATTEMPTING TO ESCAPE. STOP HIM IMMEDIATELY!";
    text[4459] = "Crud... There are guards in every direction!";
    text[4460] = "There's nowhere to run!";
    text[4461] = "Follow my lead.";
    text[4462] = "Huh?!";
    text[4463] = "JUMP!";
    text[4513] = "Ouch... You're crazy, you know that?";
    text[4464] = "Which floor is this?";
    text[4465] = "The first floor. The exit is nearby.";
    text[4466] = "TARGET ACQUIRED. INITIATING BATTLE MODE... WAITING FOR TARGET RESPONSE.";
    text[4467] = "Tch. Another annoying robot.";
    text[4468] = "Hey! There's a pilot inside y'know!";
    text[4514] = "We shouldn't hurt them if we don't have to.";
    text[4515] = "Bella, I need you guys to buy me some time while I disable the laser doors!";
    text[4469] = "I'll teach them not to get in our way.";
    text[4516] = "....";
    text[4470] = "Are you just gonna stand there or are you gonna fight with me?";
    text[4471] = "Bella, you made your decision when you decided to help me escape.";
    text[4472] = "Now, even if the whole world is against you... you have to fight.";
    text[4473] = "...because if you don't, all of this will have been for nothing.";
    text[4474] = "If you're locked up in a prison cell, you won't be able to change the world...";
    text[4475] = "...and you sure as hell won't find the answers you're looking for.";
    text[4476] = "...alright, fine.";
    text[4477] = "Let's gear up for battle!";
    text[4478] = "That's more like it! Hell yeah!";
    text[4479] = "I deactivated the laser door! The exit is this way, let's go!";
    text[4480] = "They took away our ship... Now how are we going to escape?";
    text[4481] = "We're gonna have to go by foot.";
    text[4482] = "I have a hideout in Colony Silica we can go to.";
    text[4483] = "That's in the north. It's pretty far from where we are...";
    text[4484] = "Got any hideouts nearby that the Lunex Force doesn't know about?";
    text[4485] = "...No.";
    text[4486] = "Then we should navigate to Colony Silica.";
    text[4487] = "First, we head west.";
    text[4488] = "The trail up ahead should take us to the Crater of Eternal Darkness.";
    text[4489] = "We'll move through the darkest patches of the crater to avoid being seen.";
    text[4490] = "Alright, let's zip!";
    text[4492] = "Vivia!";
    text[4493] = "Tsk Tsk. I'm disappointed in you Bella.";
    text[4494] = ".....";
    text[4498] = "Looks like Saros was right about your imminent betrayal.";
    text[4520] = "I had a hard time believing it at first.";
    text[4499] = "Your loyalty to the Lunex Force always appeared unbreakable... until now.";
    text[4521] = "I'm sorry... I just...";
    text[4522] = "I need to do this. This is the path I have chosen.";
    text[4523] = "Back at the base... you knew it was us, didn't you?";
    text[4495] = "I was aware you had infiltrated our headquarters the moment your little robot";
    text[4496] = "shut down the sewer network.";
    text[4497] = "Eheheh... Guess Vivia is more perceptive than we gave her credit for.";
    text[4500] = "I had hoped you would be able to extract the information we need from the Murk Slayer,";
    text[4501] = "but instead, you decided to conspire against us.";
    text[4524] = "Vivia...";
    text[4526] = "I see the Murk Slayer is still as silent as ever.";
    text[4530] = ".....Tch.";
    text[4527] = "Perhaps my presence is reigniting the pain of the past...?";
    text[4531] = "...or maybe it's just fear? Ohohoho!";
    text[4528] = "After all, I did enjoy watching you suffer...";
    text[4529] = "...for the sake of science of course.";
    text[4532] = "...You make me sick.";
    text[4502] = "I will not tolerate your defiance!";
    text[4503] = "If my Vessels can't stop you, I'll just have to stop you myself.";
    text[4525] = "HOLO SUIT ENGAGE!";
    text[4504] = "Vivia, we don't have to do this. Can't we settle this without fighting?";
    text[4505] = "How foolish and naive.";
    text[4539] = "You underestimate how strong the Commander of the Lunex Force really is.";
    text[4540] = "Gahhhh! I don't like this one bit!";
    text[4541] = "...something is clouding your judgement Vivia.";
    text[4542] = "All these years I've known you... ";
    text[4543] = "You weren't this cold and calculating when Mom was around...";
    text[4544] = "You've changed.";
    text[4545] = "SILENCE!";
    text[4546] = "I am doing what must be done to ensure Saros is able to save humanity.";
    text[4547] = "The Murk Slayer is the key to achieving that.";
    text[4548] = "Now, enough talk. Let's get to the fun part, shall we?";
    text[7601] = "This isn't over! I'm not letting you escape!";
    text[7602] = "Holo-Field Activate!";
    text[7613] = "Looks like I win. Now be good little prisoners while I call for backup.";
    text[7603] = "Crud... It's the same barrier she used on me back in Copernicus...";
    text[7604] = "We're trapped...";
    text[7605] = "Tetra, you got any ideas?";
    text[7615] = "Hmm. Let me do a quick scan...";
    text[7606] = "...Looks like Saros and Vivia weren't bluffing.";
    text[7616] = "If the Holo-Field reaches a certain energy threshold from the inside,";
    text[7617] = "it will implode... Killing us in the process.";
    text[7607] = "...unless...";
    text[7608] = "We release enough energy to overpower the Holo-Field.";
    text[7609] = "Nickle, what if you turn into...";
    text[7610] = "NO!";
    text[7611] = "My Phase Form is too dangerous.";
    text[7612] = "You don't understand...";
    text[7618] = "When I let my antimatter consume me...";
    text[7619] = "...my mind is at risk of being consumed as well.";
    text[7620] = "It's a form I won't use unless I absolutely have to.";
    text[7621] = "Well, this looks an 'absolutely have to' kind of situation!";
    text[7622] = "Please, Nickle...";
    text[7623] = "Hurry, Vivia is coming back!";
    text[7624] = "Tch@P.@P.@P.@P.@P.@P.@P.@P.@P.";
    text[7625] = "Okay, fine. I'll do it.";
    text[7626] = "...But if you end up getting hurt...";
    text[7627] = "Just do it!";
    text[7628] = "HIYAHHHHHHHHH!";
    text[4507] = "She's immobilized!";
    text[4508] = "Now's our chance! Let's get outta here!";
    text[7630] = "Nickle, your Phase Form... that was amazing!";
    text[7631] = "I thought you said you couldn't control it?";
    text[7632] = "Look, I don't like using it...";
    text[7633] = "...and it's not always easy to control...";
    text[7634] = "It's... complicated.";
    text[7635] = "That's all you need to know. This discussion is over.";
    text[7636] = "Alright...";
    text[7637] = "Let's get out of here before backup arrives.";
    text[7638] = "PHASE MODE UNLOCKED!";
    text[7639] = "This form lasts for 3 turns and grants Nickle a 2x PWR Boost for his Active Skills!";
    text[7640] = "While in this form, enemy attacks that do 50 DMG or less are nullified!";
    text[4567] = "I haven't seen this kind of ship before.";
    text[4568] = "According to my database this is a Minipod!";
    text[4569] = "It's an older space ship model the Lunex Force discontinued years ago.";
    text[4570] = "Looks like they abandoned a bunch of them in this area.";
    text[4571] = "Tetra, do you think you could jump-start this ship?";
    text[4572] = "I'll give it a shot...";
    text[4573] = "Let's hope the battery still has some juice left in it...";
    text[4574] = "It worked! Heh.";
    text[4575] = "Alright, let's get outta here. We have to head north.";
    text[4579] = "There they are! Don't let them get away!";
    text[4580] = "Aw crud, reinforcements are headed this way!";
    text[4581] = "Quick! Get in the ship!";
    text[4585] = "It's so cramped in here...";
    text[4586] = "Yeah, I forgot to mention earlier...";
    text[4587] = "The Pod Ships are typically designed to seat one person... eheheh.";
    text[4582] = "Photon projectiles detected!";
    text[4553] = "You missed! What are you waiting for?! Keep shooting at them!";
    text[4554] = "...but Commander... Saros instructed us to capture them alive.";
    text[4555] = "They won't be defeated that easily.";
    text[4556] = "Our goal is to slow them down... Strip them of all their resources...";
    text[4557] = "...Until they lose all hope of retaliating against us.";
    text[4558] = "Y-yes, Commander! Setting Photon Blasters to maximum power!";
    text[4589] = "CONTROL THE SHIP AND DODGE THE ONCOMING PROJECTILES!";
    text[4590] = "We left them in the dust! Nice piloting Bella!";
    text[4591] = "Thanks, heh.";
    text[4592] = "Our problems aren't solved just yet.";
    text[4593] = "The ship's battery is nearly depleted.";
    text[4594] = "Land the ship. I see Silica Rifts up ahead.";
    text[4595] = "How about a 'please'?";
    text[4600] = "How about a 'no'.";
    text[4601] = "Hmph. You suck.";
    text[4602] = "Okay I'm landing the ship! Better hold onto something!";
    text[4598] = "Our ship has taken too much damage!";
    text[4599] = "We need to make an emergency landing before it blows!";
    text[4603] = "Tetra, what's our coordinates?";
    text[4604] = "We're currently in Sector 2 - Silica Rifts!";
    text[4605] = "Huff... We still have a long way to go until we get to my hideout...";
    text[4606] = "Huff... Huff...";
    text[4607] = "Nickle, are you okay?";
    text[4608] = "I'm fine... Let's just...";
    text[4609] = "He's injured! He needs to rest!";
    text[4610] = "Tetra, you carry the Pod Ship. If we leave it here, it'll just give away our location.";
    text[4611] = "I saw a small cave nearby. Let's rest there for the night.";
    text[4614] = "Meanwhile...";
    text[4615] = "Ahh, I think that's enough training for today...";
    text[4616] = "My arms feel like jelly!";
    text[4617] = "Agreed. I'm content with today's training as well.";
    text[4618] = "Your new technique was pretty cool Zara. What was it called again?";
    text[4670] = "Sticky Stone Barger?";
    text[4619] = "Static Stone Barrage. It's a long name but, I think it's pretty useful in battle.";
    text[4633] = "I admire your passion for coming up with new techniques.";
    text[4620] = "You're gonna be the number one Neural Link Master someday, I just know it!";
    text[4621] = "I hope so... Thanks Melody.";
    text[4622] = "Hmm...";
    text[4623] = "Raine should be done with her training session anyyyyytime now...";
    text[4624] = "...yup! Right on cue!";
    text[4625] = "OH MAN! You guys should've seen that last punch I threw!";
    text[4635] = "That Battle Bot didn't stand a chance! I'm on fire, babyyyy!";
    text[4628] = "Miss Raine, I heard an explosion! Is everything alright?";
    text[4629] = "Oh uh...";
    text[4630] = "Call the robotics engineer. The Battle Bot is uh... broken...";
    text[4631] = "...again.";
    text[4632] = "No problem, Miss Raine. I'll go get the engineer...";
    text[4636] = "So, what do you guys wanna do now?";
    text[4637] = "Ooo, let's go say hi to Bella!";
    text[4638] = "I wonder what she's up to.";
    text[4639] = "Good call. Since the Battle Bot is out of commission,";
    text[4640] = "I'LL FIGHT BELLA INSTEAD! BAHAHAHA!";
    text[4641] = "That warrior prodigy needs some serious butt-kicking!";
    text[4642] = "Tame the beast, Raine. Tame the beast.";
    text[4643] = "Oh hey! Looks like we've got a new mission!";
    text[4644] = "...";
    text[4645] = "...wait, what?";
    text[4646] = "Did I read this correctly? This can't be real...";
    text[4647] = "It's a Code Purple Mission Report for high ranking military soldiers and personnel...";
    text[4648] = "The Murk Slayer has escaped!";
    text[4649] = "It says here, our mission is to locate and capture the Murk Slayer";
    text[4650] = "...and his accomplice...";
    text[4651] = "Bella Grey.";
    text[4652] = "No freaking way...";
    text[4653] = "Was Bella working with him all along?";
    text[4654] = "No, I don't think so.";
    text[4655] = "Bella wouldn't go against the Lunex Force like this...";
    text[4656] = "...unless...";
    text[4671] = "THIS IS UNACCEPTABLE!";
    text[4657] = "Wasn't that Doctor Thomas?! He just bolted right by us!";
    text[4659] = "Did you girls get the Mission Report as well?";
    text[4660] = "We did...";
    text[4661] = "As soon as the Doctor saw Bella's name, he stormed out in a fit of rage.";
    text[4662] = "He's heading to the Military Base to speak with Saros directly.";
    text[4663] = "Our dear Bella...";
    text[4664] = "...now a wanted criminal, myeh. This is certainly unpleasant news...";
    text[4665] = "(There has to be a good reason she's doing this... I just know it...)";
    text[4666] = "Girls... We need to find Bella ASAP!";
    text[4667] = "Even if other Lunex Force Soldiers find her, they won't be able to stop her.";
    text[4668] = "I agree. This is a job perfect for the Raine Squad.";
    text[4669] = "LET'S GO!";
    text[4672] = "...";
    text[4673] = "What's wrong Bella?";
    text[4674] = "Nothing, it's just...";
    text[4675] = "...I'm having some anxiety I guess.";
    text[4676] = "For years I've been loyal to the Lunex Force...";
    text[4677] = "Proudly fighting and training to become a fierce warrior like Mom was...";
    text[4678] = "...all for the sake of protecting the People of Luna.";
    text[4679] = "Now... It feels like my world is slowly turning upside down.";
    text[4680] = "We'll get through this together Bella!";
    text[4681] = "It might be tough right now, but we have to stay determined!";
    text[4682] = "You're right...";
    text[4683] = "...could you guys keep it down a little? I have a massive headache.";
    text[4684] = "Looks like Mr. Sleepyhead finally woke up.";
    text[4685] = "Guhh... How long have I been sleeping?";
    text[4686] = "4 Hours.";
    text[4687] = "4 Hours of loud snoring! Hmph.";
    text[4690] = "I heard that. Your stomach was grumbling.";
    text[4691] = "...";
    text[4692] = "If we're gonna recover properly we should eat something.";
    text[4693] = "Here, I always keep an emergency Cheesecake Bar handy.";
    text[4694] = "No thanks.";
    text[4695] = "There's no way a sane person would turn down a Cheesecake Bar!";
    text[4696] = "Haven't you ever tried one?";
    text[4697] = "No...";
    text[4698] = "WHAT. YOU NEED TO TRY IT. IT'S HEAVENLY!";
    text[4699] = "...fine. Give me half.";
    text[4700] = "(nom nom nom)";
    text[4701] = "Sooooooo....";
    text[4702] = "What do you think?";
    text[4703] = "Do you like it?";
    text[4704] = "It's alright. (I'VE NEVER TASTED ANYTHING THIS GOOD WHAT THE HECK!)";
    text[4705] = "Heh. Your face says it all.";
    text[4706] = "Glad you like it!";
    text[4707] = "...Thanks, I guess.";
    text[4708] = "Since we're safe here for now...";
    text[4709] = "I think we should talk. Get to know each other a little, ya know?";
    text[4710] = "Talk about what?";
    text[4711] = "Geez, your socializing skills need work.";
    text[4712] = "Hey, I'm not gonna magically become your friend just because";
    text[4713] = "you helped me escape from the Lunex Force.";
    text[4714] = "Maybe a friend is what you need.";
    text[4715] = "Someone to be there to listen to your struggles.";
    text[4716] = "Someone to share heartfelt moments with.";
    text[4717] = "You should probably keep your distance from me.";
    text[4718] = "Even I wouldn't want to be my friend.";
    text[4719] = "...I had close friends long ago...";
    text[4720] = "...and they're gone now.";
    text[4721] = "Everywhere I go, I cause nothing but pain.";
    text[4722] = "Everyone gets hurt in some way because of me.";
    text[4723] = "Is that what you're afraid of?";
    text[4724] = "Losing someone close to you?";
    text[4725] = "You're really perceptive, and it's kind of annoying.";
    text[4726] = "There's something else that I wondered about as well...";
    text[4727] = "Why me?";
    text[4728] = "Wh-what? What do you mean?";
    text[4729] = "If I was anyone else, you would have left by now.";
    text[4730] = "You wouldn't have opened up to anyone, let alone talk to them.";
    text[4731] = "So, why me?";
    text[4732] = "...";
    text[4733] = "Is it because you knew my Mother?";
    text[4734] = "Can I ask...";
    text[4735] = "How did you know my Mom?";
    text[4736] = "Years ago, back when I had little control over my powers...";
    text[4737] = "I went berserk... I couldn't control my power output.";
    text[4738] = "The Lunex Force came in and... Your Mother was leading the mission to take me in.";
    text[4739] = "In my frantic and desperate attempt to maintain my composure and my sanity...";
    text[4740] = "I heard her voice through all the pain.";
    text[4741] = "I somehow felt... the warmth of her soul... her kindness reaching out to me.";
    text[4742] = "Next thing I knew, I woke up and I was back at my hideout.";
    text[4743] = "I wasn't in pain anymore. My sudden power outburst died down.";
    text[4744] = "She could have turned me in, but she didn't.";
    text[4745] = "Instead, she decided to check up on me once in a while.";
    text[4746] = "She knew that if she brought me to the Military Base, I'd continue to suffer.";
    text[4747] = "Back then, Saros was the head military scientist.";
    text[4748] = "He insisted that I be captured, so that I could be studied.";
    text[4749] = "It's not every day you come across a boy with unimaginable and frightening power.";
    text[4750] = "She overruled Saros' requests and decided to protect me.";
    text[4751] = "It's weird... I felt a strange power emanating from her.";
    text[4752] = "A power that my antimatter reacted to.";
    text[4753] = "A power that I felt coming from you as well...";
    text[4754] = "The power to manipulate Lux.";
    text[4755] = "...!";
    text[4756] = "Did my Mom tell you anything about this power?";
    text[4757] = "...I think we should get going.";
    text[4758] = "Hey! Don't ignore me! Please, I need to know...";
    text[4759] = "...I wanted to ask you something...";
    text[4760] = "Are you able to control this power of yours yet?";
    text[4761] = "Not really... It comes and goes.";
    text[4762] = "If I can figure out how to control it, I might be able to communicate with the Murks!";
    text[4763] = "We'll be able to make peace!";
    text[4764] = "I see... I don't think you're ready for the truth just yet.";
    text[4765] = "...and I still don't trust you entirely either.";
    text[4766] = "I'll tell you what you need to know if we can get to my hideout.";
    text[4767] = "...fine.";
    text[4768] = "But just so we're clear...";
    text[4769] = "I'm here because you said you need my help...";
    text[4770] = "...and I need your help too.";
    text[4771] = "I need to learn more about the power of Lux...";
    text[4772] = "I know I was adamant on finding out where your Anticores are...";
    text[4773] = "but now... My feelings have changed. I can see they're very precious to you.";
    text[4774] = "Whatever the reason might be, I'm not here to take your Anticores away from you.";
    text[4775] = "I just want to know the truth...";
    text[4776] = "Being ignorant to the truth will hold me back from being able to do what I love the most.";
    text[4777] = "...to protect my people.";
    text[4778] = "...to protect those who are close to me.";
    text[4779] = "I'll find another way to stop Comet Coda. I'm not giving up!";
    text[4780] = "... ... ... ...";
    text[4781] = "...I want to protect the People of Luna as well.";
    text[4782] = "I'm glad we found some common ground.";
    text[4783] = "Let's get out of here before the Lunex Force shows up.";
    text[5000] = "Wait, don't move. There's a ship nearby.";
    text[5001] = "Looks like they released search drones!";
    text[5002] = "I guess there's not enough soldiers to search all of Northern Luna by foot.";
    text[5003] = "We'll be fine as long as we don't get detected by the drones.";
    text[5004] = "I think the coast is clear. Let's go.";
    text[4968] = "...!";
    text[4969] = "I heard a voice! It was really faint...";
    text[4970] = "Concentrate. Focus your mind.";
    text[4971] = "Try to channel your Lux...";
    text[4972] = "But I... I don't know how.";
    text[4973] = "You've felt this feeling before. Try to relive that moment.";
    text[4974] = "That feeling of wanting to make a connection...";
    text[4975] = "...to communicate through the heart and soul.";
    text[4976] = "Don't let go of that feeling.";
    text[4977] = "He..lp...";
    text[4978] = "...It...h...urts...";
    text[4979] = "P...lease...";
    text[4980] = "I heard the voice again! It was much clearer this time.";
    text[4981] = "It's... asking for help. They sound like they're in pain.";
    text[4982] = "I sense a Murk nearby. The voice must be coming from a Murk.";
    text[4960] = "We need to find it...";
    text[4983] = "...and get its anticore.";
    text[4961] = "Uh, we're on the run remember?";
    text[4962] = "Yeah, the drones might see us!";
    text[4963] = "Doesn't matter. I'm not worried about the Drones.";
    text[4964] = "If there's a Murk, we have to fight it.";
    text[4984] = "I'm nowhere near full strength yet...";
    text[4985] = "Can you... help me fight it?";
    text[4986] = "But... I don't like killing Murks...";
    text[4987] = "Hey, I don't like killing them either, but...";
    text[4988] = "The anticores are the key to bringing justice.";
    text[4989] = "Justice? What did the Murks ever do to you?";
    text[4990] = "It's not because of something the Murks did to me.";
    text[4991] = "The issue is moreso what I might have done to them...";
    text[4992] = "Gosh, you're so stubborn. If you really want my help,";
    text[4993] = "you're gonna have to maintain some level of honesty with me.";
    text[4994] = "(sigh)";
    text[4995] = "You'll understand once I tell you everything.";
    text[4996] = "The truth can be a burden sometimes. Just keep in mind...";
    text[4997] = "You don't have to carry that burden all by yourself, y'know?";
    text[4998] = "...I know.";
    text[4999] = "Now let's go find that Murk.";
    text[4846] = "...Oh hey. There's something here!";
    text[4847] = "Really?! I don't see anything though.";
    text[4848] = "Tetra, activate your sensors.";
    text[4849] = "Oh...! I'm detecting a cluster of antimatter particles!";
    text[4850] = "I sometimes forget that people can't see the world the way I see it.";
    text[4851] = "What do you mean?";
    text[4852] = "There are wavelengths of the electromagnetic spectrum that are beyond";
    text[4853] = "the ability of human eyes to detect.";
    text[4854] = "Because of my powers... I'm able to see light and even antimatter that";
    text[4855] = "might not be visible to others.";
    text[4856] = "Woah...";
    text[4857] = "I think that's pretty cool!";
    text[4858] = "I guess... I never saw it that way.";
    text[4859] = "It was always a burden to me... sometimes it was too much sensory overload.";
    text[4860] = "Took a while to get used to it.";
    text[4861] = "Hmm... Is this why you wear a mask?";
    text[4862] = "I noticed your mask was modded from a Lunex Force space helmet.";
    text[4863] = "Those helmets were designed to help filter out harmful light,";
    text[4864] = "so it doesn't damage our eyes in space.";
    text[4865] = "Yeah, you nailed it pretty much.";
    text[4866] = "So, what's with the scary face on the mask?";
    text[4867] = "...Why? There's no particular reason.";
    text[4868] = "Really? Hmmm.";
    text[4869] = "I just...";
    text[4870] = "...thought it looked cool... maybe a bit intimidating.";
    text[4871] = "Okay no more questions...";
    text[4872] = "Let's pick up whatever's in that antimatter cluster and keep going.";
    text[5100] = "Ouch!";
    text[5101] = "Bella are you okay? Try to be more careful next time!";
    text[5102] = "You lost 1000 Bytes in the explosion...";
    text[5045] = "Hey, we have to find the nearby Murk first.";
    text[5046] = "Bella, you forgot to pick up the anticore!";
    text[3528] = "Bella, look over there! What's that off in the distance?";
    text[3529] = "That's the old city of Magnesia...";
    text[3530] = "...or rather, where it used to be.";
    text[3531] = "Public records state that the destruction of Magnesia was";
    text[5107] = "single-handedly caused by an extremely powerful Murk.";
    text[3540] = "...";
    text[3532] = "I saw it on the news when I was younger, but I don't remember much.";
    text[3533] = "It's difficult to know exactly what happened that day.";
    text[3534] = "How come?";
    text[3535] = "There were barely any survivors...";
    text[3536] = "The Lunex Force wasn't well equipped to stop Murks back then...";
    text[3537] = "...So you're saying this is what could have happened to Copernicus,";
    text[3538] = "if we failed our Mission?";
    text[3539] = "Yeah...";
    text[3540] = "...";
    text[3541] = "...Bella?";
    text[3542] = "Sorry, I was just doing a quick prayer for the people who passed away.";
    text[3543] = "Let's do our best and save as many lives as we can!";
    text[3544] = "...Tetra?";
    text[3545] = "I did a prayer too! You got it, Bella! Heh.";
    text[5108] = "Hey Nickle, are you okay?";
    text[5109] = "You're shaking...";
    text[5110] = "...";
    text[5111] = "I'm sorry... I...";
    text[5112] = "I'm okay... Let's keep going.";
    text[5113] = "Colony Silica should be up ahead.";
    text[5114] = "(...What's gotten into him?)";
    text[5115] = "(He looks like he just saw a ghost or something.)";
    text[5116] = "(I'm not sure... Let's just leave him alone for now.)";
    text[5117] = "Ahhh, it's nice and warm in this Colony.";
    text[5118] = "Is this your first time in Colony Silica?";
    text[5119] = "Yep! Pretty much. I love the vibes here!";
    text[5120] = "Oh! I see a cafe!";
    text[5121] = "Gosh, my hair is a mess.";
    text[5122] = "We should freshen up and stock up on food while we're here!";
    text[5123] = "Mr. Stinky over here needs a shower.";
    text[5124] = "What the... You have an odor sensor built in?";
    text[5125] = "Isn't that kind of a useless feature?";
    text[5126] = "You're useless! Hmph.";
    text[5155] = "Stop arguing you two. I think it's time we took a quick break.";
    text[5156] = "30 minutes later...";
    text[5127] = "Ahh, I'm so full! That was a great meal!";
    text[5128] = "Nickle, I'm surprised you beat my cheesecake bar record.";
    text[5129] = "Those things are addicting as heck...";
    text[5130] = "I made sure to pack some extras just in case.";
    text[5131] = "One for now, one for later...";
    text[5132] = "...and one for later later! Heh.";
    text[5133] = "So tell me Nickle, what do you do when you're not hunting Murks?";
    text[5134] = "I may not look like it but I'm a treasure hunter.";
    text[5135] = "Finding and selling rare items and treasures is how I survive.";
    text[5136] = "Woah, that's pretty cool!";
    text[5137] = "You really think so? I mean, it's a tough job, but it sure is rewarding.";
    text[5138] = "I've had a passion for exploration and adventure ever since I was a kid.";
    text[5139] = "There's so much Lunar history hidden underneath the surface.";
    text[5140] = "It would be cool to explore the entirety of Luna someday...";
    text[5141] = "...and maybe even discover some rare treasure.";
    text[5142] = "But right now... ";
    text[5143] = "There's something else I must do first. My dreams can wait.";
    text[5144] = "...if we can stop Comet Coda and fix this mess...";
    text[5145] = "...when this is all over...";
    text[5146] = "Maybe... we could go treasure hunting together.";
    text[5147] = "You're invited too, Tetra.";
    text[5148] = "YAY REALLY?! I'd love to!";
    text[5149] = "ME TOO! ME TOO! You won't find a better Treasure Hunting Sidekick out there, heh.";
    text[5150] = "I guess you're not as much of a meanie as I thought.";
    text[5151] = "Nah, I'm still gonna dunk on you cuz it's fun. Hahaha!";
    text[5152] = "Oh yeah? Challenge accepted.";
    text[5154] = "You're the one who's gonna get dunked on!";
    text[5017] = "I'd hate to interrupt your bonding moment but, are we close to your hideout yet?";
    text[5153] = "Good question...";
    text[5005] = "I uhm...";
    text[5006] = "I've been lying to you about something...";
    text[5007] = "Huh? Lying about what?";
    text[5008] = "My hideout isn't actually here in Silica.";
    text[5009] = "Seriously?! Why are we here then?!";
    text[5010] = "We just wasted precious time!";
    text[5011] = "I'm sorry... I wasn't sure I could trust you at first.";
    text[5012] = "If your hideout isn't here, then where is it?";
    text[5013] = "It's in Oceanus.";
    text[5014] = "There's no way. I bet you're lying again.";
    text[5015] = "I'm not this time! I swear!";
    text[5016] = "(Why the hell is she so scary when she's mad?)";
    text[5021] = "I've explored Oceanus plenty of times.";
    text[5022] = "The beach is not exactly the best place for a hideout.";
    text[5023] = "The entrance to it is a bit... unconventional. You'll see.";
    text[5024] = "Anyways, we didn't come here for nothing.";
    text[5025] = "I visit Colony Silica pretty often to get supplies and essentials.";
    text[5026] = "There's not a lot of Lunex Force presence up here in the north";
    text[5027] = "compared to the rest of Luna, so it's easier to get around.";
    text[5028] = "I've got a buddy here named Cypher who can help get us a new spaceship.";
    text[5029] = "Cypher the Astrotech Trader? I remember meeting him in Regolithia.";
    text[5030] = "Wait, you have FRIENDS?";
    text[5031] = "Oof, that was harsh Tetra.";
    text[5032] = "What? He just got dunked on. Tetra - One, Nickle - Zero!";
    text[5033] = "Keep it up and you'll get knocked off the boyfriend candidate list.";
    text[5034] = "Wh-what the... you have a list?";
    text[5035] = "Hey don't look at me like that, I didn't ask her to make one!";
    text[5036] = "I'm honestly surprised he didn't try to run away from us already.";
    text[5037] = "Perhaps Bella is on his potential girlfriend list...";
    text[5038] = "..or even worse, he intends to de-throne me as Bella's ultimate sidekick!";
    text[5039] = "Sidekick?! Oh ha ha.";
    text[5040] = "I'm watchin' you pal.";
    text[5041] = "Okay, well... Have fun arguing you two! I'm gonna go look for Cypher.";
    text[5042] = "Hmph!";
    text[5043] = "Hmph!";
    text[8792] = "WAIT! I don't have a jet suit, how do you expect me to fly around?";
    text[8793] = "Maybe I can buy you one?";
    text[8794] = "No thanks. I don't even know how to use a Jet Suit.";
    text[8795] = "Hmph, fine...";
    text[8796] = "I'll carry you.";
    text[8797] = "WHAT, NO.";
    text[8798] = "I'd be putting my life in your hands.";
    text[8799] = "Tetra won't drop you.";
    text[8800] = "She's stronger than she looks.";
    text[8801] = "My offer will expire in five seconds...";
    text[8802] = "Four seconds...";
    text[8803] = "W-wait!";
    text[8804] = "Three seconds...";
    text[8805] = "...";
    text[8806] = "Two seconds...";
    text[8807] = "One second...";
    text[8808] = "Okay, fine! I'll take your offer.";
    text[8809] = "If you drop me...";
    text[8810] = "I won't... Trust me. Heh.";
    text[5056] = "Yo Cypher.";
    text[5057] = "What the?! Dude, I thought you were in jail!";
    text[5058] = "I was. These two helped me escape.";
    text[5059] = "Nice to see you again Cypher!";
    text[5060] = "Oh hey, you're that gal I met back in Regolithia!";
    text[5061] = "So, how can I help you?";
    text[5062] = "Do you mind if we borrow a ship?";
    text[5063] = "Not at all!";
    text[5064] = "Let me see if I got any ships layin' around in the back.";
    text[5065] = "Thanks Cypher.";
    text[5066] = "Cypher knows you're the Murk Slayer?";
    text[5067] = "There's only a few people who know. We go way back.";
    text[5068] = "I saved him from getting eaten by a Murk once.";
    text[5069] = "Okay bad news yo. I already sold my last good ship...";
    text[5070] = "All I have is an old minipod.";
    text[5071] = "Is it fully charged?";
    text[5072] = "Yep!";
    text[5073] = "We'll take it.";
    text[5074] = "You can keep it actually. I owe you anyway for saving my life.";
    text[5075] = "I appreciate it Cypher.";
    text[5077] = "Stay safe out there yo.";
    text[5078] = "I saw a bunch of search drones and Lunex ships flying over the colony earlier.";
    text[5079] = "Thanks for the heads up! We should head out ASAP.";
    text[5080] = "Onwards to Oceanus! Let's go to the nearest hoverport and take off!";
    text[5081] = "Aw crud, we've got two Lunex ships on our tail!";
    text[5082] = "Bella, they have their Photon Blasters enabled!";
    text[5083] = "Murk Slayer! Bella Grey!";
    text[5084] = "Surrender now, or we WILL open fire!";
    text[5085] = "Tch... Go faster, we can't let them catch us.";
    text[5086] = "Uhh, Bella I think we're heading in the wrong direction.";
    text[5087] = "I know. We can't make it obvious that we're heading towards Oceanus so...";
    text[5088] = "We've gotta make 'em chase us around until they lose us!";
    text[5089] = "Buckle up! We're going turbo speed this time, heh.";
    text[5090] = "Looks like we lost them! Nice piloting, Bella!";
    text[5091] = "Heh, thanks.";
    text[5093] = "Alright, next stop: Oceanus!";
    text[5095] = "Although we took some heavy damage... Looks like we lost them.";
    text[5096] = "Nice piloting.";
    text[5092] = "Oh ha ha. Thanks for the sarcasm.";
    text[5097] = "Okay, we're here in Oceanus.";
    text[5098] = "So, where's your hideout?";
    text[5103] = "Harmonia Reef.";
    text[5104] = "We have to head east.";
    text[5105] = "Alright, let's go!";
    text[5106] = ".@P.@P.";
    text[5157] = "(Something feels a bit off...)";
    text[5158] = ".@P.@P.";
    text[5159] = ".@P.@P.";
    text[5160] = "(Hmm...)";
    text[5161] = "(I have to keep my guard up just in case.)";
    text[5162] = "(If this goes well...)";
    text[5163] = "(...There is hope.)";
    text[5164] = "(I might be able to save them...)";
    text[5165] = "Hey Nickle, you coming?";
    text[5166] = "Yeah, my bad.";
    text[5167] = "Just making sure nobody is following us.";
    text[5168] = "Let's go.";
    text[5180] = "We're here.";
    text[5181] = "Huh? I don't see an entrance...";
    text[5182] = "Like I mentioned before, the entrance is a bit unconventional.";
    text[5183] = "There's a cave at the bottom of this reef.";
    text[5184] = "We'll have to dive underwater to reach it.";
    text[5185] = "Seriously?! We're gonna get drenched!";
    text[5186] = "Bella... Is it safe for me to dive deep underwater?";
    text[5187] = "Yup! Don't worry. You're water-proof remember?";
    text[5188] = "Okay just making sure, eheheh...";
    text[5189] = "I have to admit, it's a pretty clever hiding spot.";
    text[5190] = "No wonder the Lunex Force had trouble locating you.";
    text[5191] = "Within this cave...";
    text[5192] = "...lies the truth.";
    text[5193] = "I need to know...";
    text[5194] = "Can I trust you two?";
    text[5195] = "Of course! We trust you as well.";
    text[5196] = "You're our friend Nickle. We're in this together!";
    text[5197] = "Yeah! We're a team now, hehe.";
    text[5198] = "Alright, let's go.";
    text[5199] = "I'm afraid you're not going anywhere.";
    text[5200] = "PLASMA FIELD ACTIVATE!";
    text[5201] = "Somebody was following us...!?";
    text[5202] = "It's an ambush!";
    text[5203] = "Raine! Melody! Zara!";
    text[5204] = "Looks like our warrior prodigy has been a traitor all along!";
    text[5205] = "I can't believe you'd betray us Bella...";
    text[5206] = "What... No!";
    text[5207] = "Hear me out guys, I know things look rough right now...";
    text[5208] = "...but I can explain!";
    text[5209] = "I apologize Bella, but you're a wanted criminal now.";
    text[5210] = "Please cooperate or we will have no choice but to use force.";
    text[5211] = "Guys...";
    text[5212] = "When we got the Mission Report we looked everywhere for you.";
    text[5213] = "We knew that if anyone was going to successfully capture you...";
    text[5214] = "...it would be us! THE RAINE SQUAD BABYYYY!";
    text[5215] = "NOW PUT UP THOSE FISTS!";
    text[5216] = "Wait Raine, we should probably...";
    text[5217] = "NO.";
    text[5218] = "WE FIGHT.";
    text[5219] = "I've got a score to settle with Bella. You still owe me a rematch!";
    text[5220] = "...and you're going down too Murk Slayer!";
    text[5221] = "At least you're not hiding behind that stupid mask this time.";
    text[5222] = "Tch. These gals are annoying.";
    text[5223] = "You gonna back me up, Bella?";
    text[5224] = "But... I don't want to fight them! They're my friends!";
    text[5225] = "Not anymore. They've chosen their side.";
    text[5226] = "Quit your chit chat! There's no escape.";
    text[5227] = "...";
    text[5228] = "Alright. I see how it is.";
    text[5229] = "If you think you could defeat us, you're WRONG.";
    text[5230] = "I'm just gonna have to beat you AGAIN Raine.";
    text[5231] = "OHOHOHO! Confident words from the traitor!";
    text[5232] = "CHALLENGE ACCEPTED.";
    text[5233] = "Uhm guys, can I just sit out of this one?";
    text[5234] = "I don't want to hurt anyone...";
    text[5235] = "That's right, stay out of this! Let the true heroes fight!";
    text[5236] = "You're a TERRIBLE sidekick anyways.";
    text[5237] = ".@P.@P.";
    text[5238] = "LIAR! YOU TAKE THAT BACK! GRRRR!";
    text[5239] = "BELLA, LET'S CLOBBER THEM!";
    text[5240] = "We're the strongest warrior squad on Luna.";
    text[5241] = "You don't stand a chance!";
    text[5242] = "Let's go RAINE SQUAD!";
    text[5243] = "Dang it... What the hell guys! We lost!";
    text[5244] = "Ouchy...";
    text[5245] = "Hmm...";
    text[5246] = "Had enough yet?";
    text[5247] = "I think that's enough acting for one day don't you think?";
    text[5248] = "Wh-what? Are you kidding me, that wasn't an act!";
    text[5249] = "Melody, you hesitated every time you attacked.";
    text[5250] = "Zara, I could tell your focus was elsewhere...";
    text[5251] = "It's like you were lost in thought in the middle of our battle.";
    text[5252] = "...and Raine... you were definitely pulling your punches.";
    text[5253] = "Hey! You were pulling your punches too!";
    text[5254] = "Huh? You were? I was going all out.";
    text[5255] = "Me too! ...because Raine is a meanie!";
    text[5256] = "Okay, okay, fine!";
    text[5257] = "Jeez, you're right. This was all an act...";
    text[5258] = "Seriously?...";
    text[5259] = "(Sigh...)";
    text[5260] = "Of course Raine would use this situation as an excuse to fight me...";
    text[5261] = "...but you too Melody?";
    text[5262] = "Raine made us go along with her plan and pretend that we're enemies...";
    text[5263] = "...and you Zara?";
    text[5264] = "...I needed a worthy opponent to test out a new attack I came up with...";
    text[5265] = "Thanks to our battle, now I've got even more ideas.";
    text[5266] = "Murk Slayer... You've got some nice moves.";
    text[5267] = "Uh... Thanks, I guess?";
    text[5268] = "Hold on, wait a minute!";
    text[5269] = "So you're not here to capture us?";
    text[5270] = "Nope. Rivalry aside, we were just worried about Bella.";
    text[5271] = "You wouldn't go through all of this if there wasn't a good reason...";
    text[5272] = "Whatever that reason is, we're here to help you. Good friends support each other.";
    text[5273] = "Aww, guys...";
    text[5281] = "I'm really sorry I said those those mean things to you, Tetra...";
    text[5282] = "I just wanted to get you riled up to make our battle more exciting, BAHAHA!";
    text[5283] = "Hmph. Apology accepted.";
    text[5274] = "Hey Murk Slayer...";
    text[5301] = "So, what's your deal?";
    text[5302] = "Are you really a good guy or are you just messing with Bella?";
    text[5303] = "I'm watchin' you like a hawk buddy.";
    text[5278] = "Raine, you've gotta be more friendly!";
    text[5279] = "I'm Melody! Any friend of Bella is a friend of ours!";
    text[5280] = "I'm Zara. Nice to meet you.";
    text[5284] = "Hmph... The name's Raine. Don't forget it.";
    text[5275] = ".@P.@P. .@P.@P. .@P.@P.";
    text[5276] = "It's okay. We can trust them. They're on our side.";
    text[5277] = "I know these last few years must have been really tough for you...";
    text[5304] = "...but you're not alone anymore.";
    text[5305] = "You've gotta allow yourself to trust people again...";
    text[5285] = ".@P.@P. .@P.@P. .@P.@P.";
    text[5286] = "(Sigh...)";
    text[5287] = "My name is Nickle.";
    text[5288] = "Look... I'm only here right now because of Bella and Tetra.";
    text[5306] = "Bella risked her career and put herself in danger in order to help me.";
    text[5307] = "...in order to seek the truth.";
    text[5308] = "It's honestly crazy. She barely even knows me.";
    text[5309] = "I kept pushing her away every time she tried to connect with me.";
    text[5310] = "Despite everything... she still wanted to help me.";
    text[5311] = "...she accepted me, no matter who I was or what I've done.";
    text[5312] = "I respect that.";
    text[5313] = "...!";
    text[5314] = "I haven't even told her the reason why I collect the Anticores yet...";
    text[5315] = "...or why I despise the Lunex Force so much.";
    text[5316] = "...and yet, you've been blindly adventuring with him?";
    text[5317] = "Bella, what made you so sure he wouldn't just run away or deceive you?";
    text[5318] = ".....";
    text[5319] = "Trust.";
    text[5320] = "Everyone's got a darker side to them... Things they might not be proud of.";
    text[5321] = "...but I like to see the good in people.";
    text[5322] = "Everyone deserves a chance to be heard.";
    text[5323] = "If we're going to save the people of Luna from Comet Coda...";
    text[5324] = "...or even the Murks...";
    text[5325] = "We should work together to find the best possible solution.";
    text[5326] = "Took him long enough to realize that... Right Mr. Stubborn?";
    text[5327] = "R-right...";
    text[5328] = "I'll explain everything when we get to my hideout.";
    text[5329] = "We can't risk anyone else finding us.";
    text[5330] = "Alright gang, let's go!";
    text[5354] = "Lost in thought?";
    text[5355] = "Just... thinking about the future.";
    text[5356] = "There's not much time left.";
    text[5357] = "How were the recent tests?";
    text[5358] = "The tests failed...";
    text[5359] = "...but the results were better than prior tests at least.";
    text[5360] = "Resonance rate?";
    text[5361] = "90% resonance.";
    text[5362] = "...Do you think that's enough? Should I...";
    text[5363] = "I wouldn't risk it, Saros.";
    text[5364] = "We need to make sure it's 100% safe...";
    text[5365] = "We'll keep trying. I won't give up on you...";
    text[5366] = "SAROS!";
    text[5367] = "Ah, Thomas. I've been expecting you.";
    text[5368] = "Where is Bella? Tell me where she is!";
    text[5369] = "Calm down, Thomas.";
    text[5370] = "I thought we had a deal! You said you wouldn't hurt Bella!";
    text[5371] = "This is outrageous! You've got hundreds of soldiers out there targeting her!";
    text[5372] = "Thomas, everything is going according to plan.";
    text[5373] = "Bella is strong. She can handle any soldier or vessel I throw at her.";
    text[5374] = "Along with the Murk Slayer, they are a force to be reckoned with.";
    text[5375] = "I had to do this. Let's just say I had to make things appear...";
    text[5376] = "...convincing.";
    text[5377] = "Rest assured...";
    text[5378] = "We will inevitably get what we need.";
    text[5379] = "I know you'll do anything to protect your family, Thomas.";
    text[5380] = "Please don't hurt Bella...";
    text[5381] = "When this mission is successful, we'll drop Bella's criminal charges.";
    text[5382] = "I promise no harm will come to her.";
    text[5383] = "Actually, since you're here, come with me.";
    text[5384] = "I think it's time I show you what I've been working on.";
    text[5385] = "Woahh! What is this place?";
    text[5386] = "Everything is blue!";
    text[5387] = "It's so beautiful here!";
    text[5388] = "I discovered these ruins several years ago when I was on a solo expedition.";
    text[5389] = "Expedition?! This dude's a Treasure Hunter?!";
    text[5390] = "Yeah! I was surprised too when he first told us!";
    text[5391] = "I thought we already excavated all the ruins of the Ancients across Luna?";
    text[5392] = "Nope. I'm positive there are more relics and ruins still uncovered by humanity.";
    text[5393] = "These ruins were once inhabited by an ancient civilization of people,";
    text[5394] = "known as the Ancients.";
    text[5395] = "They were known for being able to manipulate both Lux and Antimatter,";
    text[5396] = "and they thrived during a time before humanity settled on Luna,";
    text[5397] = "thousands of years ago.";
    text[5398] = "If they were so highly advanced, where are they now?";
    text[5399] = "Well, that's what archeologists are still trying to figure out to this day.";
    text[5400] = "Come on, let's keep going.";
    text[5401] = "LUMIKNIGHT ENGAGED. ANCIENT BIOGENETIC SOUL DATA DETECTED.";
    text[5402] = "LUX READINGS ABNORMAL. AWAITING GUARDIA TRANSMISSION.";
    text[5403] = "Nickle, what the hell is that?!";
    text[5404] = "Crud...";
    text[5405] = "I think we might have triggered a security system or something.";
    text[5406] = "GUARDIA TRANSMISSION RECEIVED. COMMENCING THE SOUL TRIAL.";
    text[5407] = "Soul Trial? Is it testing us?";
    text[5408] = "This place might have been a training site for ancient soldiers.";
    text[5409] = "I never expected they would still be operational.";
    text[5410] = "The security system never triggered whenever I came here.";
    text[5411] = "In any case, let's take it down!";
    text[5413] = "Whew, that thing was tough...";
    text[5414] = "What do you think set off the security system?";
    text[5415] = "More like... WHO set off the security system.";
    text[5416] = "I think our warrior prodigy over here might have some connection to the Ancients.";
    text[5417] = "Hey! Stop calling me that! Not you too!";
    text[5418] = "BAHAHAHAH! He catches on quick!";
    text[5419] = "Wait so, do you think Bella could be...";
    text[5420] = "...a descendant of the Ancients?";
    text[5421] = "Maybe...";
    text[5422] = "Hmm... This could explain my ability to manipulate Lux...";
    text[5423] = "...and the strange feelings I've been having.";
    text[5489] = "If I'm a descendant of the Ancients...";
    text[5490] = "That means Mom also had Ancient Genetics.";
    text[5491] = "Why would she keep this information a secret...";
    text[5424] = "I need to find out more about the Ancients.";
    text[5425] = "Feel free to examine any statues or ancient texts in the Ruins.";
    text[5426] = "I learned most of what I know about the Ancients from the relics they left behind.";
    text[5427] = "Great... There's a giant gate blocking the way.";
    text[5428] = "There's something engraved on the gate!";
    text[5429] = "THE FOUR GEMSTONES SHALL OPEN THE WAY FOR THE SOUL SENSER.";
    text[5430] = "So our goal is to find FOUR GEMSTONES to open this door.";
    text[5431] = "Looks like we have to complete the SOUL TRIAL whether we like it or not.";
    text[5492] = "That reminds me... The soldier mentioned a name when it spoke...";
    text[5493] = "I think it was... Guardia?";
    text[5494] = "If the soldiers have a leader of some sort within these ruins,";
    text[5495] = "I'd like to speak with them.";
    text[5496] = "We might be able to learn more about my Lux Manipulation.";
    text[5497] = "Fair enough.";
    text[5498] = "Sorry. I guess I'm just getting a little impatient, that's all.";
    text[5499] = "What? Why are you looking at me like that?";
    text[5500] = "Nothing, heh. Let's go look for the FOUR GEMSTONES!";
    text[5530] = "There's a floor pit on this level that leads deeper into the ruins.";
    text[5531] = "We can look for the GEMSTONES in the lower levels.";
    text[5532] = "Just make sure you're ready before we drop down...";
    text[5533] = "...We might not be able to get back up for a while.";
    text[5510] = "TO THE WANDERING TRAVELERS WHO READ OUR TEXTS...";
    text[5511] = "TAKE WITH YOU... THE WISDOM AND STORIES OF OUR PEOPLE...";
    text[5512] = "WE DO NOT KNOW WHAT THE FUTURE HOLDS FOR US...";
    text[5513] = "BUT WE HOPE YOU CAN SUCCEED, WHERE WE HAVE FAILED...";
    text[5514] = "Wait I don't remember reading this last time I was here.";
    text[5515] = "Did the engravings change?! That can't be possible.";
    text[5516] = "Maybe certain texts appear only when there's someone with";
    text[5517] = "Ancient Genetics present? I wouldn't rule that possibility out.";
    text[5518] = "Interesting!";
    text[5519] = "This means...";
    text[5520] = "All the Ancient texts humanity has collected and preserved could be";
    text[5521] = "holding more information and secrets than we ever realized!";
    text[5522] = "This could be the discovery of the century!";
    text[5523] = "Let's check the rest of the wall engravings!";
    text[5524] = "Dang, 'adventure' runs through this guy's veins, or what?";
    text[5525] = "It's nice to see him this excited for once.";
    text[5526] = "So he's a tough guy on the outside, but a dork on the inside?";
    text[5527] = "Hey! What are you two whispering about?";
    text[5528] = "Nothing!";
    text[5529] = "Yeah, nothing!";
    text[5592] = "It's a statue depicting an ancient adventurer.";
    text[5593] = "There is a GEMSTONE embedded on their chest.";
    text[5594] = "You touch the GEMSTONE gently... and it starts to vanish!";
    text[5595] = "A voice echoes throughout the ruins:";
    text[5596] = "THREE GEMSTONES REMAIN.";
    text[5597] = "TWO GEMSTONES REMAIN.";
    text[5598] = "ONE GEMSTONE REMAINS.";
    text[5599] = "YOU HAVE DONE WELL SOUL SENSER.";
    text[5600] = "RETURN TO THE UPPER LEVEL. I WILL BE WAITING.";
    text[5442] = "YOU HAVE DONE WELL, SOUL SENSER.";
    text[5443] = "Woah this guy is HUGE!";
    text[5444] = "Who are you?";
    text[5445] = "I AM GUARDIA.";
    text[5446] = "I AM AN ENTITY PROGRAMMED TO PROTECT THESE RUINS.";
    text[5447] = "Guardia, can you tell us more about the Ancient people that resided here?";
    text[5448] = "What happened to them?";
    text[5449] = "UNABLE TO PROCESS QUERY. SUCH INFORMATION IS NOT WITHIN MY KNOWLEDGE.";
    text[5601] = "YOU... BELLA GREY.";
    text[5602] = "H-huh? How do you know my name?";
    text[5603] = "MY PROCESSOR IS ABLE TO EXTRACT INFORMATION THROUGH YOUR LUX.";
    text[5604] = "I WAS ABLE TO ASSESS... YOU ARE NOT A THREAT.";
    text[5605] = "Okay whew, thought we were gonna have to fight this guy.";
    text[5606] = "HOWEVER!";
    text[5627] = "Eeep!";
    text[5607] = "YOUR LUX LEVELS ARE... ABNORMAL.";
    text[5608] = "Abnormal? What do you mean?";
    text[5609] = "IT IS HIGHER THAN ANY LEVEL RECORDED IN MY DATABASE.";
    text[5610] = "YET, IT IS ALSO IN A PECULIAR STATE.";
    text[5611] = "YOUR ABILITY TO MANIPULATE LUX IS CURRENTLY SHACKLED.";
    text[5612] = "YOUR SOUL SENSING IS IMPAIRED.";
    text[5613] = "Guardia, do you know how I can use my ability?";
    text[5614] = "...please teach me how to use Soul Sensing!";
    text[5628] = "I HAVE NOT BEEN OPERATIONAL IN CENTURIES.";
    text[5629] = "MY POWER RESERVES ARE DWINDLING...";
    text[5630] = "I WILL BE UNABLE TO TRAIN YOU EFFECTIVELY... HOWEVER...";
    text[5616] = "IT IS WITHIN MY POWER TO AWAKEN YOUR SOUL SENSING.";
    text[5617] = "IT WILL THEN BE UP TO YOU... TO HONE YOUR ABILITIES.";
    text[5618] = "THE POWER OF LUX... THE PHYSICAL MANIFESTION OF THE SOUL...";
    text[5619] = "WHEN AWAKENED, IT IS NOT A POWER THAT IS EASY TO CONTROL.";
    text[5620] = "I can do it. I know I can!";
    text[5621] = "I'll do whatever it takes to protect the People of Luna.";
    text[5622] = "I want to be strong... and dependable...";
    text[5623] = "Someone that inspires people... and instills hope.";
    text[5624] = "YOU HAVE AN UNBREAKABLE SPIRIT.";
    text[5625] = "HOWEVER, BOTH THE MIND AND THE BODY MUST BE STRONG.";
    text[5626] = "I MUST ASSESS YOUR STRENGTH FIRST.";
    text[5631] = "THIS IS THE FINAL STEP OF THE SOUL TRIAL.";
    text[5632] = "GUARDIA BATTLE MODE ENGAGED!";
    text[5461] = "YOU HAVE PASSED THE SOUL TRIAL.";
    text[5462] = "I SHALL UNCHAIN THE SHACKLES PLACED ON YOUR SOUL SENSING.";
    text[5463] = "MY POWER RESERVES ARE NEARLY FINISHED... FAREWELL SOUL SENSER...";
    text[5464] = "MAY YOUR LUX... SHINE...";
    text[5465] = "...FOREVER BRIGHT.";
    text[5466] = "Are you okay Bella? Did it work?";
    text[5467] = "I feel... power swelling inside of me.";
    text[5468] = "This is incredible!";
    text[5480] = "Bella's latent Lux abilities have been unlocked!";
    text[5481] = "You can now use the default Lux Combo: LUX OVERDRIVE!";
    text[5634] = "It's difficult to fathom everything we just witnessed.";
    text[5652] = "Yeah, Ancient Civilization, Soul Sensers, Lux... My brain hurts!";
    text[5635] = "I wonder if Soul Sensing is useful in battle...";
    text[5636] = "We're gonna have to spar to confirm! BAHAHAHA!";
    text[5637] = "Speaking of Soul Sensing, what are you planning to do with it?";
    text[5638] = "Well, I'm hoping I can communicate with the Murks to achieve peace.";
    text[5639] = "Wait seriously?!";
    text[5640] = "You really don't like fighting those Murks, huh?";
    text[5642] = "You guys have always known this...";
    text[5643] = "Yeah but...";
    text[5644] = "It's kind of hard to set aside the fact that these";
    text[5645] = "monsters have killed innocent people, ya know?";
    text[5646] = "I know that...";
    text[5647] = "Bella has the right idea.";
    text[5648] = "The Murks aren't just monsters.";
    text[5649] = "They are... much more than that.";
    text[5650] = "Let's head to the final room.";
    text[5651] = "Things will make sense once you see for yourself...";
    text[5673] = "This...";
    text[5674] = "...is where I keep all the Anticores I've collected.";
    text[5675] = "There's so many of them!";
    text[5676] = "Just how many Anticores have you collected over the years?";
    text[5677] = "I don't know. Hundreds, maybe thousands.";
    text[5678] = "Didn't Bella tell you about Comet Coda's return?";
    text[5679] = "She did. I'm also aware of the Lunex Force's plan to use";
    text[5680] = "the wormhole machine, Celestia, to stop the comet.";
    text[5681] = "...and despite knowing that humanity is in danger, you refuse to";
    text[5682] = "allow us to use these Anticores to power our key to survival?";
    text[5683] = "That's what I was thinking too back when we fought in Copernicus...";
    text[5747] = "You once mentioned your goal was justice...";
    text[5794] = "I still don't understand what you meant by that.";
    text[5795] = "Nickle...";
    text[5796] = "You've been shouldering a heavy burden...";
    text[5746] = "...and I know it's taken a toll on you.";
    text[5748] = "I want to help you. That's what friends do.";
    text[5749] = "We want to help as well! Am I right, ladies?";
    text[5797] = "Yup!";
    text[5798] = "Indeed!";
    text[5750] = "Me too! Me too!";
    text[5686] = "Nickle, I think it's time you finally tell us the truth.";
    text[5745] = "What's really going on here?";
    text[5687] = "Let me ask you guys this: What really is an Anticore?";
    text[5688] = "Well, Anticores are a stable source of Antimatter, right?";
    text[5689] = "That's only half of it.";
    text[5690] = "An Anticore is composed of both Antimatter and Lux. Its nucleus contains...";
    text[5691] = "...a soul.";
    text[5692] = "So then... That gives me an idea!";
    text[5695] = "The Anticore is glowing!";
    text[5696] = "What the... How did you do that, Bella?";
    text[5697] = "Soul Sensing... I think I'm starting to understand how to use it.";
    text[5698] = "I imagined being able to see the soul inside.";
    text[5699] = "To speak with it.";
    text[5700] = "Do you hear anything?";
    text[5701] = "No, all of these anticores are silent.";
    text[5702] = "But, weirdly enough...";
    text[5703] = "I'm able to feel the emotions contained within the souls...";
    text[5704] = "Pain... Suffering... Anger... Betrayal... Sadness... Grief...";
    text[5705] = "The souls of the Murks inside the Anticores are trapped...";
    text[5799] = "I don't know if this will work but... Let me try something...";
    text[5706] = "No...";
    text[5708] = "No... No... This can't be...";
    text[5710] = "The soul inside...";
    text[5709] = "...looked like...";
    text[5712] = "What you saw... was the truth.";
    text[5713] = "The Murks were once humans.";
    text[5715] = "...!";
    text[5711] = "WHAT... BUT HOW?";
    text[5716] = "Oh no...";
    text[5717] = "So the Murks we've been hunting and fighting were humans all along...";
    text[5718] = "The Murks are the result of human experimentation.";
    text[5719] = "By who? Who's running these experiments?";
    text[5720] = "Your so-called legendary hero of Luna: Saros.";
    text[5721] = "This... This is INSANE!";
    text[5722] = "These are innocent human lives!";
    text[5723] = "Why would he do such a terrible thing?";
    text[5724] = "Saros believes that Antimatter is the key to humanity's survival.";
    text[5725] = "In the eyes of the public, he's the leader of the people. The 'legendary hero.'";
    text[5726] = "But underneath that heroic facade...";
    text[5728] = "Saros is a mad scientist obsessed with harnessing the power of Antimatter.";
    text[5800] = "Ever since he discovered the existence of my powers...";
    text[5801] = "He's been working on a Murk Serum.";
    text[5802] = "A fluid which, when consumed by a human, changes the hosts molecular composition.";
    text[5803] = "Their matter bodies, get converted into Antimatter.";
    text[5805] = "The Antimatter that he extracted from me years ago was enough for him to";
    text[5806] = "run experiments to try to perfect the formula for the Murk Serum.";
    text[5807] = "Every failed test... gave birth to a Murk.";
    text[5808] = "..a human who has lost their humanity... Consumed by Antimatter.";
    text[5814] = "I was never strong enough to defeat Saros... So I was hoping he would";
    text[5809] = "eventually run out of Antimatter to experiment with but...";
    text[5813] = "He had a perfect system in place...";
    text[5815] = "Some Murks he killed on the spot, extracted their Anticores, and";
    text[5816] = "reused that Antimatter for his next batch of tests.";
    text[5817] = "Thankfully, a lot of Murks end up escaping through a wormhole once they transform.";
    text[5818] = "So in order to get those Anticores, he simply trained his army to hunt them down.";
    text[5755] = "It sickens me.";
    text[5821] = "How could Saros do this...";
    text[5822] = "Does he not value human lives?";
    text[5823] = "He trained us... Took care of us...";
    text[5824] = "We looked up to him as a mentor... As a leader...";
    text[5825] = "...Was that all a lie?";
    text[5826] = "The missing people posts in the BBS... In the cafes...";
    text[5827] = "They were innocent people captured by Saros, weren't they?";
    text[5828] = "Most likely.";
    text[5735] = "Saros would secretly capture all kinds people over the years.";
    text[5736] = "First... he experimented with all the prisoners at the Military Base.";
    text[5737] = "When there were no more test subjects, he'd resort to cover-up schemes.";
    text[5739] = "The increase in missing or dead citizens and the increase in Murk incidents";
    text[5829] = "all over Luna were not coincidental.";
    text[5752] = "The few soldiers who are ordered to carry out Saros' abduction missions";
    text[5753] = "have no choice but to obey... Otherwise, they'd become test subjects as well.";
    text[5754] = "Unfortunately, once they complete their mission, they become test subjects anyways.";
    text[5830] = "What the hell, that's cruel... ";
    text[5831] = "It's the only way he can ensure his secret is protected.";
    text[5841] = "I still don't understand WHY he's doing this... There must be a reason...";
    text[5842] = "Whatever it is... There's nothing that could justify his actions...";
    text[5832] = "Have you told this information to anyone else?";
    text[5834] = "You're not the first ones I've told...";
    text[5835] = "I've had comrades over the years who fought along side me...";
    text[5836] = "We would hunt down escaped Murks to prevent Saros from getting to them first.";
    text[5837] = "I lost every battle...";
    text[5838] = "I lost all my comrades... They were all turned into Murks...";
    text[5839] = "The only reason Saros didn't kill me was so that he could capture and study me.";
    text[5844] = "So I decided... to fight this battle alone.";
    text[5845] = "If I allowed myself to grow close to someone... They would be in danger...";
    text[5846] = "I distanced myself from others... ";
    text[5847] = "...so I wouldn't have to experience the pain of losing someone I care about again.";
    text[5848] = "I still feel this way sometimes...";
    text[5849] = "...but I'm going to try my best to be stronger.";
    text[5850] = "I hope you can forgive me for the way I treated you all...";
    text[5851] = "I'm sorry.";
    text[5852] = "Nickle...";
    text[5853] = "Stop! You're gonna make me cry...";
    text[5854] = "Dude, you've been through a lot...";
    text[5855] = "We're the ones who should apologize...";
    text[5856] = "We misjudged you...";
    text[5857] = "...I appreciate your support.";
    text[5858] = "I can't do this alone anymore.";
    text[5864] = "I need to stop running...";
    text[5865] = "I need to face Saros once and for all.";
    text[5859] = "You've been running solo for all these years. So what's changed?";
    text[5860] = "Hope.";
    text[5866] = "You guys have given me hope.";
    text[5867] = "Hell yeah!";
    text[5869] = "We're in this together now!";
    text[5870] = "So like... what's our next move?";
    text[5871] = "I don't really have a plan...";
    text[5872] = "HUH? YOU DROP THIS TRAGIC REVELATION ON US AND EXPECT US";
    text[5873] = "TO TWIDDLE OUR THUMBS AFTER?!";
    text[5874] = "Hey cut me some slack here, will ya?";
    text[5875] = "I've spent years hunting down these Anticores to make sure Saros can't use them.";
    text[5876] = "But... that's not the only reason I'm keeping them here.";
    text[5763] = "These people didn't deserve the fate that was forced onto them.";
    text[5761] = "I was hoping I would someday find a way to bring them back...";
    text[5762] = "Woah, is that even possible?";
    text[5877] = "Hmm...";
    text[5878] = "Maybe my Dad can help!";
    text[5879] = "If we get our hands on Saros' Murk Serum.";
    text[5880] = "My Dad might be able to figure out a way to reverse engineer the formula!";
    text[5881] = "What about the Anticores? Would an Anti Serum work on something like an Anticore?";
    text[5882] = "We won't know until we try!";
    text[5883] = "What about Comet Coda?";
    text[5884] = "We still have a year before Comet Coda strikes.";
    text[5885] = "Our priority right now should be stopping Saros!";
    text[5886] = "The longer we wait, the more lives he experiments with...";
    text[5887] = "We need to come up with a plan... ";
    text[5891] = "Let's regroup at the Lunex Space Station.";
    text[5892] = "Uh... Are you sure it's okay for us to go there?";
    text[5893] = "The Lunex Force is still looking for us...";
    text[5894] = "Don't worry. We'll be safe there.";
    text[5895] = "Everyone at the Space Station is like family to me. I grew up there!";
    text[5896] = "If we're going to successfully take down Saros, we'll need allies.";
    text[5888] = "I don't know if bringing more people into this is a good idea...";
    text[5898] = "Trust me Nickle. We'll be okay.";
    text[5899] = "... ... ... ...";
    text[5778] = "Okay. I trust you.";
    text[5779] = "Alrighty! Next Stop: Lunex Space Station!";
    text[6003] = "We have to come up with a plan to stop Saros!";
    text[6075] = "No way...!";
    text[6076] = "It's my ship!";
    text[6077] = "Surprise! Heh.";
    text[6078] = "We came across your abandoned ship when we were out searching for you.";
    text[6079] = "We figured it would be best to retrieve it and bring it back to you.";
    text[6080] = "Aww you guys... You're the best!";
    text[6081] = "Myeh! It's Bella!";
    text[6082] = "Bella! Thank goodness you're okay dear, we were so worried about you!";
    text[6083] = "Indeed... and I see you've brought a guest!";
    text[6084] = "Hello. My name is Nickle.";
    text[6085] = "Pleased to finally meet you, Nickle! Myeh!";
    text[6722] = "You guys... are not planning on turning us in, right?";
    text[6723] = "Now why would we do that, Myeh?";
    text[6724] = "We'd never do that to our crew. We're all practically 'family' here.";
    text[6086] = "Speaking of family... Miss Nyla, where's Dad?";
    text[6087] = "Ah, I believe Doctor Thomas is at the Military Base.";
    text[6088] = "Oh crud... I completely forgot!";
    text[6089] = "Bella... your dad...";
    text[6090] = "When he found out about the Mission Report for your capture,";
    text[6091] = "He stormed out of the Lab in a fit of rage to confront Saros.";
    text[6092] = "What?! No... Dad might be in danger!";
    text[6093] = "I'll try calling him!";
    text[7125] = "@P.@P.@P.@P.@P.@P.";
    text[6094] = "...He's not picking up...";
    text[6095] = "Hold on, what's going on here? Myeh?";
    text[6096] = "Thomas is in danger?";
    text[6097] = "Nickle...";
    text[6098] = "...Go ahead. You can tell them the truth.";
    text[6099] = "No... This is TERRIBLE...";
    text[6100] = "Saros has been deceiving us for years...";
    text[6101] = "What he has done... is UNACCEPTABLE! MYEH!";
    text[6102] = "...and that's why we have to go save my Dad!";
    text[6103] = "What if Saros...";
    text[6104] = "Hold on Bella.";
    text[6105] = "We must remain calm and assess the situation strategically.";
    text[6106] = "We can't be sure if Saros intends on harming your father.";
    text[6107] = "The Saros you think you know... is a fraud.";
    text[6108] = "He's a dangerous man...";
    text[6109] = "But, Doctor Thomas is the lead scientist in charge of working on Celestia.";
    text[6110] = "Surely, Saros wouldn't get rid of such a valuable asset...";
    text[6111] = "I'm not saying we shouldn't be concerned.";
    text[6112] = "What we should do is formulate a plan...";
    text[6113] = "A Mission to rescue your father safely,";
    text[6114] = "and to arrest Saros for the crimes he's committed.";
    text[6116] = "I will lead the Mission.";
    text[6117] = "We're going to need allies.";
    text[6118] = "Let's gather all the soldiers and scientists in the Space Station.";
    text[6119] = "Roger that!";
    text[6125] = "...and that's everything.";
    text[6126] = "The truth of the Murks...";
    text[6127] = "...What Saros has been doing behind the scenes...";
    text[6128] = "...Why he instructed some of you to capture the Murk Slayer and I.";
    text[6120] = "My friends... My fellow soldiers...";
    text[6121] = "We've called you here today...";
    text[6122] = "...So we can fight for a common goal.";
    text[6129] = "Now knowing the full reality of the situation...";
    text[6130] = "...We have an opportunity to make things right!";
    text[6131] = "Our comrades who were killed by Murks...";
    text[6132] = "The broken families grieving for the loss of their loved ones...";
    text[6133] = "The incidents of missing people all over Luna...";
    text[6134] = "So Saros was responsible for all of those tragedies?";
    text[6135] = "I understand that this is an extremely messy situation.";
    text[6136] = "The People of Luna are not aware of Comet Coda's existence.";
    text[6137] = "You guys are doing your best behind the scenes to ensure";
    text[6138] = "the People of Luna have a future to look forward to.";
    text[6139] = "Now we have the Murks on top of all of this...";
    text[6140] = "The Murks... are our people as well.";
    text[6141] = "They were once human.";
    text[6142] = "If the public were to find out about the Murks and Comet Coda...";
    text[6143] = "Their trust in the Lunex Force would crumble...";
    text[6144] = "They would lose all hope...";
    text[6145] = "We cannot let that happen!";
    text[6146] = "We can't let Saros continue to run his experiments!";
    text[6147] = "I hope...";
    text[6148] = "You're willing to fight alongside us!";
    text[6149] = "General Grey!";
    text[6150] = "We will follow your lead!";
    text[6151] = "G-General?! M-me?";
    text[6152] = "After everything you've told us...";
    text[6153] = "Saros is no General of ours.";
    text[6154] = "We refuse to follow a man who doesn't respect the lives,";
    text[6155] = "of the People of Luna.";
    text[6156] = "I'm sure the troops at the other departments would feel the same way.";
    text[6157] = "General Grey, our trust lies with you.";
    text[6158] = "Doctor Thomas, the former General, and even you, Bella.";
    text[6159] = "Your family has always inspired us to do better...";
    text[6160] = "To have hope for the future of humanity!";
    text[6161] = "We'll help you save Doctor Thomas and stop Saros. Simple as that.";
    text[6162] = "Everyone...";
    text[6163] = "Thank you...";
    text[6164] = "Let's kick Saros' ass! BAHAHAH!";
    text[6165] = "YEAHHHH!";
    text[6166] = "Those who can fight, get your battle gear ready.";
    text[6167] = "We'll depart for the Military Base tomorrow!";
    text[6168] = "As for our fellow Scientists and Engineers,";
    text[6169] = "we have yet another challenge to overcome...";
    text[6170] = "We'll need to figure out a way to reverse engineer the Murk Serum";
    text[6171] = "Saros has been working on...";
    text[6172] = "...once we confiscate it from him of course.";
    text[6173] = "'Overcoming Challenges' is our middle name!";
    text[6174] = "Our battle will be with Science!";
    text[6175] = "Leave it to us, Miss Nyla!";
    text[6176] = "Tomorrow, will mark the day where we take the future into our own hands!";
    text[6177] = "I vow to PROTECT the People of Luna!";
    text[6178] = "...to SAVE the innocent people that Saros turned into Murks!";
    text[6179] = "...to AVENGE the countless souls that were lost throughout the years...";
    text[6180] = "...and moving forward...";
    text[6181] = "WE will find a way to stop Comet Coda...";
    text[6182] = "...together! As a truly united Lunex Force!";
    text[6183] = "May our Lux shine, FOREVER BRIGHT!";
    text[6184] = "YEAHHHH!";
    text[6185] = "Bella, that was AMAZING!";
    text[6186] = "You managed to rally all those people together to fight by our side!";
    text[6187] = "That was...";
    text[6188] = "TOUGH! OH MY GOODNESS...";
    text[6189] = "I've never done a speech before in front of so many people.";
    text[6190] = "Mom makes it look so easy!";
    text[6191] = "You did great, Bella!";
    text[6192] = "Myeh! I was pleasantly surprised myself!";
    text[6193] = "General Grey, eh?";
    text[6194] = "Rolls off the tongue nicely I'd say.";
    text[6195] = "Pretty fitting for our warrior prodigy.";
    text[6196] = "Hey!";
    text[6197] = "We should get some rest for tomorrow.";
    text[6198] = "We've been on the run for so long...";
    text[6199] = "Ah, you're right.";
    text[6200] = "C'mon girls, we're havin' a sleep over at the Space Station tonight! BAHAHAHA!";
    text[6201] = "How does Raine have so much energy all the time?";
    text[6202] = "I have no clue...";
    text[6203] = "I think it's her way of dealing with stress.";
    text[6204] = "Deep down, she's probably nervous about tomorrow... ";
    text[6205] = "...I know I am.";
    text[6206] = "...same here.";
    text[6207] = "(I hope Dad is okay...)";
    text[6208] = "Alright, good night everyone! We'll reconvene tomorrow.";
    text[6229] = "OBJECTIVE: HEAD TO YOUR ROOM TO REST.";
    text[6050] = "...STRANGE.";
    text[6051] = "SO THIS IS THE SECOND BIOMETRIC PRESENCE I DETECTED,";
    text[6052] = "WHEN THE SOUL SENSER HAD AWAKENED ME.";
    text[6053] = "...?";
    text[6054] = "H...elp....";
    text[6055] = "...Need... Your help....";
    text[6056] = "...Please...";
    text[6057] = "..They...";
    text[6058] = "...need me.";
    text[6059] = "FASCINATING...!";
    text[6060] = "THIS SOUL...";
    text[6061] = "...!";
    text[6062] = "I SEE...";
    text[6063] = "I UNDERSTAND WHAT MUST BE DONE.";
    text[6064] = "I DON'T HAVE MUCH TIME LEFT...";
    text[6065] = "BUT, I AM WILLING TO AID YOU.";
    text[6066] = "WITH THE POWER THAT REMAINS WITHIN ME...";
    text[6067] = "I SHALL GRANT YOU MY VESSEL.";
    text[6068] = "GO FORTH...";
    text[6069] = "...CHRONOS.";
    text[6230] = "What's going on? Did you guys hear that explosion?";
    text[6231] = "Bella, we're under attack! Murks have infiltrated the Space Station!";
    text[6232] = "No way... Could this be Saros' doing?...";
    text[6233] = "Dang, these Murks are WILD!";
    text[6234] = "They're WAY more aggresive than usual!";
    text[6235] = "We have to protect the station crew!";
    text[6236] = "Already on it!";
    text[6237] = "Bella, we've got the first and second floors covered.";
    text[6238] = "You handle the third floor!";
    text[6239] = "Roger!";
    text[6240] = "OBJECTIVE: FIND AND DEFEAT THE MURKS ON FLOOR 3F!";
    text[6241] = "Go go go! We'll handle these Murks!";
    text[6242] = "Th-thank you, General Grey!";
    text[6243] = "Please be careful!";
    text[6246] = "Don't worry about us. We got this!";
    text[7138] = "Backup has arrived! Take the scientists somewhere safe!";
    text[7139] = "You got it!";
    text[6268] = "Good job team! Looks like we defeated all the Murks.";
    text[6269] = "Everyone is a bit shaken, but nobody got seriously hurt.";
    text[6270] = "Thank goodness...";
    text[6271] = "Anyone up for round two?";
    text[6272] = "Saros!?";
    text[6273] = "Did he just open a wormhole?!";
    text[6274] = "Impressed? Took me a while to learn how to create one, hahaha.";
    text[6275] = "In the countless experiments I've conducted over the years...";
    text[6276] = "...of all the test subjects I've worked with...";
    text[6277] = "...I'm no exception.";
    text[6278] = "As you can see, I've experimented on myself as well.";
    text[6279] = "This power... the power of antimatter, is INCREDIBLE.";
    text[6280] = "I have yet to test this newfound power... Let's do a trial, shall we?";
    text[6281] = "Gahhh! What the hell?! We can't move!";
    text[6282] = "Saros! Let them go! You're hurting them!";
    text[6283] = "I knew the day would come...";
    text[6284] = "...when you would discover the truth.";
    text[6285] = "It was inevitable. All it took was to gain the Murk Slayer's trust.";
    text[6286] = "But... Knowing the truth is one thing.";
    text[6287] = "Understanding it... is another.";
    text[6288] = "Saros, why are you doing all of this?";
    text[6289] = "Does human life not mean anything to you?";
    text[6290] = "Everything I've done... is for the evolution of humanity.";
    text[6291] = "The results of my work... ";
    text[6292] = "Will allow humans to survive for generations to come.";
    text[6293] = "HYPOCRITE!";
    text[6294] = "You're hurting innocent people!";
    text[6295] = "...the very people you claim to be saving!";
    text[6296] = "Sacrifices had to be made for the sake of advancement.";
    text[6297] = "I don't expect you to understand my reasons...";
    text[6298] = "and quite frankly... I don't have time to explain anything to you.";
    text[6299] = "Then why are you even here?";
    text[6300] = "To squash your little rebellion.";
    text[6301] = "The future... has no place for you or your silly ideals.";
    text[6302] = "You're wrong! We're not going down without a fight!";
    text[6303] = "You're going to stay where you are.";
    text[6304] = "You wouldn't want anything to happen to the Doc, would you?";
    text[6305] = "D-dad?! Where's my Dad?";
    text[6306] = "What have you done to him?";
    text[6307] = "Nothing yet.";
    text[6308] = "Not unless... you tell me where the Anticores are.";
    text[6309] = "No...";
    text[6310] = "But...";
    text[6312] = "Time is of the essence. I don't have all day.";
    text[6313] = "Nickle...";
    text[6314] = "You have my word.";
    text[6315] = "I'll return your father to you once you give me what I need.";
    text[6317] = "I'll do it.";
    text[6318] = "I'll tell you where they are.";
    text[6319] = "Ha...";
    text[6320] = "Ha... Ha...";
    text[6321] = "HAHAHAHA!";
    text[6322] = "FASCINATING!";
    text[6323] = "You REALLY DO have the power to change people, Bella.";
    text[6324] = "TRULY FASCINATING!";
    text[6325] = "Wait, don't tell me. How about I take a guess?";
    text[6326] = "You're hiding them, in Oceanus? Perhaps in a hidden cave underwater?";
    text[6327] = "...! WHAT! BUT HOW?!";
    text[6328] = "It was a clever hiding spot, I'll admit.";
    text[6329] = "Our sensors couldn't detect it at all!";
    text[6330] = "Unfortunately, you've underestimated me.";
    text[6331] = "I'm always two steps ahead of you.";
    text[6332] = "The Anticores are already in my possession, HAHAHAHA!";
    text[6333] = "YOU MONSTER!";
    text[6334] = "How did he even...?";
    text[6335] = "Trust has caused you to let your guard down, Murk Slayer.";
    text[6336] = "One of our Search Drones managed to find you in Oceanus...";
    text[6337] = "...and followed you all the way down to your hideout... watching your every move.";
    text[6338] = "No... No... How could I be so careless?!";
    text[6339] = "This is all my fault...";
    text[6340] = "HAHAHAHA!";
    text[6341] = "Your despair.";
    text[6342] = "It fuels me.";
    text[6343] = "Forcing you to choose between the Anticores and Doctor Thomas...";
    text[6344] = "The reality is... You had no choice to begin with.";
    text[6345] = "The reality is... There is nothing more that I need from you.";
    text[6346] = "The Anticores you've collected, is more than enough to complete my Serum!";
    text[6347] = "SAROOOOOOOOOOS!";
    text[6348] = "RRRRAAAAAAAAAAHHH!";
    text[6349] = "Nickle! Are you okay?";
    text[6350] = "Huff Huff... That bastard...";
    text[6351] = "You're no match for me. You know it.";
    text[6352] = "Don't even bother.";
    text[6353] = "Now, If you'll excuse me.";
    text[6354] = "I have an experiment to finish.";
    text[6355] = "But... My Dad!";
    text[6356] = "Saros, please don't hurt my Dad! Please return him to us...";
    text[6357] = "Your father...";
    text[6358] = "The man who I respect the most...";
    text[6359] = "...and despise the most.";
    text[6360] = "I'll keep him around for a while longer...";
    text[6361] = "So he can witness the beginning of a new era for humanity!";
    text[6362] = "FAREWELL.";
    text[6363] = "SAROOOOOOOOS! GET BACK HERE YOU COWARD!";
    text[6364] = "What was that? It feels like the Space Station is moving!";
    text[6365] = "Oh no... Quick! Head to Mission Control!";
    text[6366] = "Saros has taken complete control over the Lunex Space Station!";
    text[6367] = "I can't override the system! He's locked all the exits...";
    text[6368] = "The Space Station is descending from Lunar orbit...";
    text[6369] = "We're currently on a direct collision course towards Luna!";
    text[6370] = "WHAT?! HOW MUCH TIME DO WE HAVE?";
    text[6371] = "At this velocity, the Space Station will crash into Luna in seven minutes...";
    text[6372] = "...but that's the least of our concerns.";
    text[6373] = "He has also enabled the Astro-Barrier Defense System...";
    text[6374] = "Uh oh...";
    text[6375] = "The A.B.D.S. is normally used against small asteroids or space debris that";
    text[6376] = "enter Luna's atmosphere. Anything that passes through is melted like butter...";
    text[6377] = "No... What do we do...";
    text[6378] = "Think... Think...";
    text[6379] = "Saros is crazy! Does he not realize destroying the LSS would also destroy";
    text[6380] = "Celestia?! How does he intend on stopping Comet Coda without it?";
    text[6381] = "That's it! ...Celestia!";
    text[6382] = "Miss Nyla, do you know how to activate the Wormhole Machine?";
    text[6383] = "Uhm, I do, dear. Why?";
    text[6384] = "I have an idea...";
    text[6385] = "The thrust of the Space Station is pushing us down towards Luna...";
    text[6386] = "We just need to push it back with an equal or greater force.";
    text[6387] = "Myeh! Kid knows his physics!";
    text[6388] = "But how do we do that? What does this have to do with Celestia?";
    text[6389] = "That's where I come in.";
    text[6390] = "Celestia is powered by Antimatter. I'll provide some of that power.";
    text[6391] = "You'll just have to create a wormhole located below the space station and...";
    text[6392] = "I'll try my best to push it back...";
    text[6434] = "I just need to hold out until the ship's propellant runs out.";
    text[6393] = "Wait Nickle... Going out into space... that's suicide!";
    text[6394] = "How are you so sure this will work?!";
    text[6395] = "I don't know if it will, but...";
    text[6396] = "...I have to try.";
    text[6397] = "I'll use my Phase Form.";
    text[6398] = "In that form, my body becomes pure Antimatter.";
    text[6399] = "Oxygen won't be an issue.";
    text[6400] = "But still... It's too dangerous!";
    text[6401] = "What if you die...";
    text[6402] = "I'm prepared for that too...";
    text[6403] = "My Phase Form...";
    text[6404] = "...I don't like using it not because I can't control it.";
    text[6405] = "...I learned how to better control it years ago.";
    text[6406] = "It's moreso...";
    text[6407] = "...What the form represents.";
    text[6408] = "It represents my failures.";
    text[6409] = "It represents my weaknesses...";
    text[6410] = "...My inability to protect others.";
    text[6411] = "My powers... have always hurt innocent people...";
    text[6412] = "...especially when I couldn't control it.";
    text[6413] = "My powers... have led Saros down the path of insanity...";
    text[6414] = "...and cause even more innocent people to get hurt through the Murks...";
    text[6415] = "It's something I still atone for to this day.";
    text[6416] = "Nickle...";
    text[6417] = "My past... My mistakes... My failures continue to hold me back...";
    text[6418] = "Even today...";
    text[6419] = "With Saros outsmarting us, and taking all of the Anticores I've collected...";
    text[6420] = "...I've failed and failed, and...";
    text[6421] = "...I just want to do something good for once.";
    text[6422] = "Something... I can be proud of.";
    text[6423] = "Bella...";
    text[6424] = "...Thank you for, trusting me... and for your kindness.";
    text[6425] = "Nickle... Please...";
    text[6426] = "I...";
    text[6427] = "...!";
    text[6428] = "Sorry...";
    text[6429] = "That was a bit selfish of me.";
    text[6430] = "Oh my!";
    text[6431] = "Nice, heh.";
    text[6432] = "You're talking as if you're not gonna make it back alive...";
    text[6433] = "...you big jerk.";
    text[6435] = "Bella...";
    text[6436] = "You better make sure you come back!";
    text[6437] = "We need you!";
    text[6438] = "I... need you...";
    text[6439] = "Wish me luck.";
    text[6440] = "PHASE MODE!";
    text[7140] = "HIYAHHHHH!";
    text[7141] = "Nickle, it's working!";
    text[7142] = "We're starting to slow down!";
    text[7143] = "It's still not enough... Our velocity is too high!";
    text[7144] = "Hang in there! Don't give up!";
    text[7145] = "How much time before we reach the Astro Barrier?";
    text[7146] = "Myeh! Two Minutes!";
    text[7168] = "What about fuel level?";
    text[7169] = "75% Left...";
    text[7147] = "Gahhhhhh! Crud, the thrust on this is CRAZY!";
    text[7148] = "I can't... push it back...";
    text[7162] = "Nickle, don't worry about us!";
    text[7163] = "Don't hold back! You're stronger than this!";
    text[7164] = "But if... I push myself too far...";
    text[7165] = "What if I lose control again...";
    text[7166] = "I could end up destroying the Space Station...";
    text[7167] = "...you would all be...";
    text[7149] = "Nickle! You can do it! Give it everything you've got!";
    text[7150] = "Is that...?";
    text[7151] = "It's the LSS Crew! Soldiers, scientists, everyone!";
    text[7152] = "They're all here to cheer you on!";
    text[7153] = "Nickle! We believe in you!";
    text[7154] = "You got this!!!";
    text[7155] = "(Everyone...)";
    text[7156] = "(Thank you...)";
    text[7157] = "(They're right... I can't give up...!)";
    text[7158] = "If I can't save everyone here...";
    text[7159] = "...the fate of the people of Luna will fall into Saros' hands.";
    text[7160] = "I'm gonna give it EVERYTHING I'VE GOT!";
    text[7161] = "HIYAAAAAHHHHHHHHHHH!!!";
    text[6442] = "(KAPOW!)";
    text[6443] = "Ouch! I'm awake! I'm awake! What was that for?";
    text[6444] = "Dummy...";
    text[6445] = "Hmph, we thought we lost you...";
    text[6446] = "Once the LSS returned to orbit, you lost consciousness.";
    text[7172] = "Thankfully, you were still in your Phase Form.";
    text[7173] = "Bella immediately went out to look for you...";
    text[6449] = "I'm... glad you're okay.";
    text[6450] = "Hey, thanks for savin' us.";
    text[6451] = "We owe you one.";
    text[6452] = "Thank you...!";
    text[6453] = "The strength you displayed was admirable. It was truly impressive!";
    text[6454] = "You're a hero, kid! Myeh!";
    text[6455] = "What you did was very noble.";
    text[7177] = "We were all moved by your determination.";
    text[6456] = "Thanks everyone. I couldn't have done it without all of you.";
    text[7178] = "Ack...";
    text[6458] = "Nickle, you should rest up at the healing chambers first!";
    text[7136] = "Nah, it's okay. My arms are just sore.";
    text[7137] = "Gimme a few Cheesecake Bars to munch on and I'll be back in action, heh.";
    text[7171] = "Take it easy, okay?";
    text[7176] = "I will.";
    text[7175] = "Alright everyone...";
    text[6465] = "You've all seen for yourself what Saros is capable of.";
    text[6466] = "We can't let him win!";
    text[6467] = "Our future... is in our hands!";
    text[6468] = "YES GENERAL! WE'RE READY WHEN YOU ARE!";
    text[6469] = "Wait, isn't the Astro-Barrier Defense System still active?";
    text[6470] = "We can't just casually take a ship down to the Military Base...";
    text[6471] = "We won't need to... We've got a Wormhole Machine!";
    text[6472] = "...and an Antimatter fuel source standing right here, heh.";
    text[6473] = "Excuse me?!";
    text[6474] = "I'm kidding!";
    text[6475] = "I know, I know. Don't worry, I gotchu covered.";
    text[6476] = "Alright troops! Head down to the Nexus Lab!";
    text[7181] = "We'll depart in 5 minutes!";
    text[7182] = "YES GENERAL!";
    text[6248] = "Tetra, I think it's time.";
    text[6249] = "OHHH?!";
    text[6251] = "I'VE BEEN WAITING FOR THIS FOR SO LONG.";
    text[7183] = "Where are you guys going, myeh?";
    text[7184] = "We'll be right back.";
    text[7185] = "I left something important in my room.";
    text[7186] = "No worries! We'll be waiting for you in the Nexus Lab!";
    text[7187] = "Just talk to us when you're ready to be warped to the Military Base, myeh!";
    text[7195] = "I knew it! You want to bring Miss Thea's Jet Suit with you!";
    text[6252] = "I'm gonna need a reliable sidekick to be by my side if I'm going to wear this.";
    text[6253] = "Are you up for the challenge?";
    text[6254] = "I was born ready, heh!";
    text[6255] = "Mom called this the Nebula Suit.";
    text[6256] = "Some Nebulae are the result of the explosion of a dying star...";
    text[6257] = "...a supernova.";
    text[6258] = "But... a Nebula can also be a place where new stars begin to form.";
    text[6259] = "This Nebula Suit marks both the end of an era... and the beginning of a new one.";
    text[6260] = "I hope I can make her proud...";
    text[6261] = "Bella... She already is. I'm sure of it!";
    text[6262] = "If she were here today, she would be proud of the amazing woman you've become!";
    text[6263] = "Tetra... You're the best.";
    text[6264] = "You can call me Supernova Tetra now, thank you. Heh.";
    text[7193] = "Alrighty, let's head to the Nexus Lab!";
    text[7194] = "We'll use Celestia to get to the Military Base!";
    text[6477] = "Alright, we're in!";
    text[6478] = "Saros' Office should be straight ahead.";
    text[6479] = "Stop right there! Don't move a muscle!";
    text[6480] = "Listen, you're fighting for the wrong side here!";
    text[6481] = "You need to let us through!";
    text[6482] = "The longer we wait, the more human lives Saros will sacrifice!";
    text[6483] = "Bullet Punch!";
    text[6484] = "Thanks for the backup, Raine!";
    text[6485] = "We'll deal with these guys!";
    text[6486] = "Go find Saros!";
    text[6487] = "So this is the Lab where Saros conducts his experiments...";
    text[6488] = "Seeing the Murks in the vials... all these victims...";
    text[6489] = "I can't stand it... This is sickening...";
    text[6490] = "...";
    text[7290] = "Murks! They can spawn here too?!";
    text[7291] = "I'm not surprised.";
    text[7292] = "This entire lab is like a Murk magnet with all the Antimatter in here.";
    text[7293] = "What should we do?";
    text[7294] = "We should fight... and end their suffering.";
    text[7295] = "If their Anticores are still intact, we can eventually save them...";
    text[7296] = "..but letting them go right now might be too risky.";
    text[7297] = "If the Murks in the vials wake up, we'll be outnumbered.";
    text[7298] = "Our job's gonna get a lot harder if that happens...";
    text[7299] = "...";
    text[7300] = "Alright, let's do this.";
    text[7302] = "I'm surprised you're not arguing with me about fighting the Murks.";
    text[7312] = "Well... Deep down, I still don't like fighting them.";
    text[7313] = "But... now that we know the truth,";
    text[7314] = "there are a lot more factors I have to consider.";
    text[7304] = "...It's not just about preventing innocent people from getting hurt anymore.";
    text[7305] = "There's human souls inside... who are suffering.";
    text[7306] = "At least as an Anticore, they won't be able to harm others...";
    text[7323] = "...and we'll work together to find a way to bring them back someday.";
    text[7307] = "These people didn't choose to become monsters... It's not their fault.";
    text[7315] = "I noticed a lot of the Murks we fight don't drop Anticores...";
    text[7324] = "It means their souls were already shattered, right?";
    text[7316] = "Right. As soon as a human becomes a Murk, there's a chance";
    text[7317] = "their soul shatters from the Serum's reaction.";
    text[7325] = "...so is there really no way to save them in that case?";
    text[7326] = "Unfortunately... No...";
    text[7318] = "The human soul resides in the Anticore.";
    text[7327] = "Without it, there's nobody to bring back.";
    text[7328] = "In that case, the least we could do is help the victims depart in peace.";
    text[7308] = "Even though we won't be able to save them all...";
    text[7309] = "Let's do our best to save as many as we can!";
    text[7311] = "Well said, Bella. Roger that!";
    text[6491] = "Vivia!";
    text[6492] = "He... abandoned me...";
    text[6493] = "After everything I've done for him...";
    text[6494] = "Vivia, where is Saros?";
    text[6495] = "We need to stop him!";
    text[6496] = "Saros... is everything to me...";
    text[6497] = "I will... make his dreams a reality.";
    text[6498] = "If...";
    text[6499] = "Maybe if I stopped you right here, right now.";
    text[6500] = "Maybe he'll acknowledge me again!";
    text[6501] = "This lady is just as crazy as Saros.";
    text[6502] = "There's no point reasoning with her.";
    text[6503] = "I can't let you leave.";
    text[6504] = "You've seen too much.";
    text[6505] = "You know too much.";
    text[6506] = "Why Vivia? Why did you agree to all of this?";
    text[6507] = "What Saros is doing... is wrong!";
    text[6508] = "Saros... is a dying man.";
    text[6509] = "...?!";
    text[6510] = "A decade ago, Saros was diagnosed with an incurable disease...";
    text[6511] = "Faced with his own mortality, he sought to find a way to cure it.";
    text[6512] = "Antimatter... The Serum... is what saved him.";
    text[6513] = "He figured out a way to slow the progression of the disease...";
    text[6514] = "Initially, he was on a mission to save his own life, and then he realized...";
    text[6515] = "A Perfected Antimatter Serum, would not only save his life,";
    text[6516] = "but it could save others as well.";
    text[6517] = "His work... had a greater purpose.";
    text[6518] = "I stood by his side for years...";
    text[6519] = "It wasn't easy to accept this responsibility.";
    text[6520] = "We have a lot of blood on our hands...";
    text[6521] = "...and we won't let our efforts go to waste!";
    text[6522] = "Don't you want to save humanity, Bella?";
    text[6523] = "You're not making sense! This isn't the way to do it!";
    text[6524] = "Lives... Souls... are sacred.";
    text[6525] = "We're sacrificing thousands, to save millions. It's a necessary evil.";
    text[6526] = "Comet Coda, is unstoppable. If we don't do this... We're all doomed.";
    text[6527] = "It appears Saros must not have told you yet...";
    text[6528] = "What? What did he not tell us?";
    text[6529] = "I'm afraid you won't get the chance to ask him yourself.";
    text[6530] = "If you want to get to Saros, you'll have to take me down.";
    text[6531] = "But... That's not happening.";
    text[6532] = "While you were on the run, I upgraded my Holo Tech yet again.";
    text[6533] = "This time, I will be VICTORIOUS.";
    text[6534] = "It's over Vivia...";
    text[6535] = "Tell us where he is.";
    text[6536] = "He has taken your father to his Sanctuary.";
    text[6537] = "...the place that Saros intends on making into humanity's new home...";
    text[6538] = "...The Phantom Realm.";
    text[6539] = "...She'll be okay. She just collapsed from exhaustion.";
    text[6540] = "The Phantom Realm...";
    text[6541] = "Humans can't stay in the Phantom Realm for longer than 72 Hours...";
    text[6542] = "...Do you think it's possible Saros was lying about that rule?";
    text[6543] = "I'm not sure... It hasn't been 72 Hours yet.";
    text[6544] = "Nickle, have you been to the Phantom Realm before?";
    text[6545] = "Just once, a long time ago...";
    text[6546] = "...It's kind of a long story.";
    text[6585] = "We've always been told to stay out of the Phantom Realm...";
    text[6586] = "It must have been a tactical decision set up by Saros.";
    text[6547] = "If he's doing things in the Phantom Realm,";
    text[6548] = "it would be in his best interest to ensure nobody goes there.";
    text[6549] = "I can't believe this...";
    text[6550] = "Every time we learn something new...";
    text[6551] = "...It just makes me...";
    text[6552] = "...angry?";
    text[6553] = "Yeah...";
    text[6554] = "I can't stand it.";
    text[6555] = "...Seeing bad things happen.";
    text[6556] = "It's even worse when bad things are happening and I'm ignorant to it.";
    text[6557] = "Luna needs a change.";
    text[6558] = "If anyone is going to help steer things in the right direction,";
    text[6559] = "it's you.";
    text[6560] = "We've got a corrupt General on our hands right now though.";
    text[6561] = "Let's deal with him first.";
    text[6562] = "Right.";
    text[6563] = "So how do we locate Saros? The Phantom Realm is a huge place.";
    text[6564] = "It's also dangerous in there... ";
    text[6565] = "...regardless of whether or not the 72 Hour Rule is true.";
    text[6566] = "Hold on... Is that what I think it is?";
    text[6567] = "Doesn't that look like a wormhole machine? Let's go take a look.";
    text[6568] = "Tetra, can you do a hardware scan?";
    text[6569] = "See if you could get some info on this machine.";
    text[6570] = "This... is an Alpha version of Celestia.";
    text[6571] = "I see... Dad told me Saros was part of the Antimatter Project years ago.";
    text[6572] = "He must have made his own version based on the abandoned blueprints.";
    text[6573] = "WAIT, I FOUND SOMETHING!";
    text[6574] = "What is it?";
    text[6575] = "COORDINATES!";
    text[6576] = "Sweet! At least we have a lead. Let's input these coordinates!";
    text[6577] = "Next stop... the Phantom Realm!";
    text[7388] = "Use the wormhole machine to enter the Phantom Realm?";
    text[7402] = "There's some ancient texts written on this statue.";
    text[7403] = "It says...";
    text[7398] = "'To our cosmic brethren, may this sanctuary provide for you";
    text[7399] = "peaceful refuge on your interstellar journey.'";
    text[7404] = "Ahhh! I see.";
    text[7405] = "This place used to be a resting point for the Ancients while they";
    text[7406] = "traveled across the Phantom Realm.";
    text[7407] = "This sanctuary is oddly beautiful...";
    text[7408] = "It's like an oasis in the middle of a desolate desert.";
    text[7412] = "...Gahhh! My urge to go treasure hunting is clawing at me!";
    text[7413] = "Let's keep moving before I get too distracted.";
    text[7414] = "You know... when this is all over...";
    text[7415] = "Maybe we could go on an adventure deeper into the Phantom Realm,";
    text[7416] = "for our first proper expedition.";
    text[7417] = "How does that sound, Mr. Treasure Hunter?";
    text[7418] = "Sounds AWESOME. Count me in, heh.";
    text[7419] = "These panels have some kind of force field enabled...";
    text[7420] = "We have to figure out a way to get through.";
    text[7421] = "Hmm...";
    text[7422] = "Are you thinking what I'm thinking, Tetra?";
    text[7423] = "Yep!";
    text[7424] = "Woah! How did you guys do that?!";
    text[7425] = "Those cubes are part of the security system here.";
    text[7426] = "I hacked into the grey cube to decode and disable it, heh.";
    text[7427] = "The red cube was a bit more dangerous.";
    text[7428] = "It's made of dense antimatter contained in a fragile shell.";
    text[7429] = "If either of you touched it, it would have exploded.";
    text[7430] = "So how'd you manage to get rid of it?";
    text[7431] = "Simple. I absorbed it, heh.";
    text[7432] = "Tetra, go stand on the yellow circle up ahead.";
    text[7433] = "I'll go to the green one.";
    text[7434] = "Nice, the panels disappeared!";
    text[7435] = "Now that we know how to disable the panels,";
    text[7436] = "we'll have to work together to proceed.";
    text[7437] = "Got it! It's teamwork time!";
    text[6594] = "Welcome to my sanctuary, Thomas.";
    text[6595] = "Isn't the Phantom Realm a sight to behold?";
    text[6596] = "Saros, this place has nothing for us.";
    text[6597] = "There's a reason why we canceled the Antimatter Project years ago...";
    text[6598] = "That was back when we didn't understand anything about this world...";
    text[6599] = "...this beautiful, parallel plane of existence to our own.";
    text[6600] = "This place... is going to be humanity's new home.";
    text[6601] = "Thomas... How much longer do you think humanity can survive on Luna?";
    text[6602] = "Well...";
    text[6603] = "No thanks to you... The ravaging Murks has reduced our time to decades...";
    text[6604] = "Even without my interference...";
    text[6605] = "We would eventually run out of resources...";
    text[6606] = "Resource depletion will always plague us if we continue to live on Luna.";
    text[6607] = "Resources are limited... but Antimatter...";
    text[6608] = "...has limitless potential!";
    text[6609] = "Knowledge is power, Thomas.";
    text[6610] = "Despite our past agreements, I would visit the Phantom Realm often.";
    text[6611] = "...and through my time here, I've learned many things.";
    text[6612] = "In this realm, we don't age. We don't hunger.";
    text[6613] = "Our bodies are somehow maintaining its metabolism...";
    text[6614] = "...";
    text[6615] = "Fascinating isn't it?";
    text[6616] = "As a fellow man of science, doesn't this prospect excite you?";
    text[6617] = "Sure, the Phantom Realm does some strange things to the human body...";
    text[6618] = "But... it's a death trap in here.";
    text[6619] = "Despite the initial benefits, our bodies will eventually start to disintegrate.";
    text[6620] = "You're right... That is indeed our bottleneck.";
    text[6621] = "With the bodies we have, we can't enjoy the miracles the Phantom Realm offers.";
    text[6622] = "I thought to myself years ago...";
    text[6623] = "...If only I didn't have this body...";
    text[6624] = "I wouldn't have to worry about death... Of my own mortal limitations.";
    text[6625] = "Our limitations is what makes us human, Saros.";
    text[6626] = "This is a pipe dream. We can't survive here.";
    text[6627] = "You're wrong.";
    text[6628] = "I've developed the technology...";
    text[6629] = "My Serum... is nearly complete.";
    text[6630] = "When it's done, it will be able to transform any human into a perfect,";
    text[6631] = "being made of antimatter.";
    text[6632] = "A being that is capable of surviving in the Phantom Realm.";
    text[6656] = "My Serum... is the key to our progression as a species!";
    text[6633] = "This... is only a taste of what Antimatter is capable of.";
    text[6634] = "If we can harness Antimatter, the secrets of the universe,";
    text[6635] = "the power to break the laws of physics itself,";
    text[6636] = "knowledge that no mortal can dream to grasp... would be ours.";
    text[6637] = "Thomas, you were once my friend...";
    text[6638] = "You helped me realize the importance of research.";
    text[6639] = "You helped me satiate my thirst for knowledge as a young scientist.";
    text[6640] = "I have learned so much thanks to you.";
    text[6641] = "But our differences... continue to be a fissure that sets us apart.";
    text[6642] = "It's because you've obtained knowledge in the wrong way!";
    text[6643] = "The wrong way, you say?";
    text[6644] = "Everyone in the Grey Family... You all chirp the same things...";
    text[6645] = "It's not just us.";
    text[6646] = "You really think the People of Luna would want new bodies?";
    text[6647] = "...A supposedly happy new life in an unknown world?";
    text[6682] = "I highly doubt it.";
    text[6667] = "Luna is our home... We have to protect it.";
    text[6668] = "Terra was once humanity's home as well...";
    text[6669] = "...but look at it now.";
    text[6670] = "It's lifeless and desolate!";
    text[6648] = "Our founders... Escaped to Luna... a new world.";
    text[6657] = "Luna was practically inhospitable!";
    text[6671] = "They had no other choice! They did it to survive.";
    text[6672] = "In our case, time is on our side, Saros.";
    text[6673] = "...This obsession...";
    text[6674] = "...This paranoia...";
    text[6675] = "...All this shows me is you've given up hope.";
    text[6676] = "You don't care for Luna at all.";
    text[6677] = "You're a coward!";
    text[6678] = "...";
    text[6659] = "Comet Coda approaches closer and closer...";
    text[6660] = "...and you think I'm the problem?";
    text[6661] = "I'm giving us a fighting chance!";
    text[6854] = "Thomas, we do not have enough fuel to create a wormhole large enough to stop";
    text[6855] = "Comet Coda... Even with all the Anticores the Murk Slayer has collected.";
    text[6856] = "...but we do have enough for my plan.";
    text[6857] = "We have enough to convert Humanity into beings of Antimatter.";
    text[6858] = "...and to migrate to the Phantom Realm.";
    text[6662] = "With my plan, we WILL SURVIVE. This isn't cowardice.";
    text[6688] = "I'm using the knowledge I've gained to our advantage!";
    text[6679] = "Saros, there is a line that should never be crossed.";
    text[6680] = "I would never trade all the secrets in the universe...";
    text[6681] = "...all the power in the universe... in exchange for human lives.";
    text[6683] = "In the grand scheme of things, one human life is meaningless.";
    text[6684] = "You...";
    text[6685] = "How dare you...";
    text[6686] = "The lives of my fellow scientists, my friends, the people...";
    text[6687] = "The life of Thea, was not meaningless.";
    text[6663] = "It's unfortunate...";
    text[6664] = "You're one of humanity's greatest minds.";
    text[6665] = "I was hoping you of all people would understand the bigger picture...";
    text[6689] = "(Sigh) You've made it clear you won't join me.";
    text[6666] = "Therefore, my kingdom of knowledge has no place for you!";
    text[6692] = "FAREWELL THOMAS!";
    text[6697] = "Bella!";
    text[6694] = "GAHHH.... WHAT?!";
    text[6695] = "WH-WHAT ARE YOU THREE DOING HERE?";
    text[6696] = "YOU'RE SUPPOSED TO BE DEAD!... GAHHH...";
    text[6698] = "Bella, I'm sorry for dragging you into all of this...";
    text[6699] = "Saros forced me into a deal...";
    text[6700] = "He said he would protect you... protect us...";
    text[6701] = "If I allowed you to infiltrate the base and go along with his plan...";
    text[6702] = "Dad...";
    text[6703] = "...I just wanted to protect our family...";
    text[6704] = "...Please forgive me.";
    text[6705] = "Dad, don't worry, I'm not mad. We're here now.";
    text[6706] = "We won't let Saros get away with this!";
    text[6707] = "Hmph. Look's like I underestimated you three.";
    text[6708] = "I'm impressed you managed to find me.";
    text[6709] = "Like I said before, we're not going down without a fight Saros.";
    text[7439] = "We also noticed you brought with you the Anticores you stole from Nickle...";
    text[7441] = "Let me make things perfectly clear...";
    text[7442] = "The Anticores are NOT fuel for your experiments...";
    text[7443] = "...and we're going to take every single one of them out of your hands!";
    text[7444] = "You've betrayed the People of Luna, and it's unacceptable!";
    text[7440] = ".......";
    text[6710] = "Why...? Why does the Grey Family continue to get in my way?";
    text[6711] = "You know... Your mother was a real pain too.";
    text[6712] = "Choose your next words carefully, Saros.";
    text[6713] = "I won't let you disrespect my family.";
    text[6714] = "Well, speaking of family... I thought you should know something.";
    text[6715] = "Your mother... The reason she's gone...";
    text[6716] = "It was because of ME.";
    text[6717] = "...! Wh-what...?!";
    text[6718] = "SAROS, YOU FIEND!";
    text[6719] = "WHAT DID YOU DO?";
    text[6720] = "The story you heard regarding her death was a mere cover-up.";
    text[6721] = "When she found out about my Antimatter Experiments...";
    text[6725] = "...the Murks...";
    text[6726] = "She shut down my project... and intended on destroying my Murk Serum...";
    text[6727] = "...destroying everything I've worked towards.";
    text[6728] = "I fought back. I challenged her to a duel... and I lost.";
    text[6729] = "But... Although she was stronger than me...";
    text[6730] = "...I was smarter than her.";
    text[6731] = "I caught her off guard...";
    text[6732] = "...activated my Wormhole Machine...";
    text[6733] = "...and trapped her in the Phantom Realm, with no means of escape.";
    text[6734] = "She got in my way... So I got rid of her... for good.";
    text[6735] = "SAROS, YOU BASTARD!";
    text[6736] = "HAHAHAHA. That's it! Get angry!";
    text[6737] = "Your despair fuels me! HAHAHAHA!";
    text[6738] = "Knowing Thea was rotting away in the Phantom Realm...";
    text[6739] = "...The next logical step for me was to become the General.";
    text[6740] = "Convincing the people was easier than I expected.";
    text[6741] = "Start a few Murk outbreaks...";
    text[6742] = "Defeat them all...";
    text[6743] = "Play the hero.";
    text[6744] = "Nobody would suspect a thing.";
    text[6745] = "My only loose end... was the Murk Slayer.";
    text[6746] = "Thankfully, everything fell right into place.";
    text[6747] = "I'll never forgive you for what you've done...";
    text[6748] = "You took away my mom from me... from us...";
    text[6749] = "Saros, this ends here!";
    text[6750] = "You're gonna pay for your crimes!";
    text[6751] = "HAHAHAHA!";
    text[6752] = "YOU'RE ALL FOOLISH!";
    text[6753] = "YOU'RE ALL NAIVE!";
    text[6754] = "...AND YOU'RE ALL WEAK!";
    text[6755] = "HUMANITY IS DOOMED WITHOUT ME! THE WORLD... NEEDS A MAD SCIENTIST...";
    text[6756] = "...SOMEONE WHO CAN DO THE JOB NOBODY ELSE WILL.";
    text[6757] = "SOMEONE WILLING TO MAKE SACRIFICES IN ORDER TO MAKE PROGRESS!";
    text[6758] = "YOU'RE WRONG!";
    text[6759] = "HAHAHA! YOU'RE NO MATCH FOR ME.";
    text[6760] = "SOON ENOUGH YOU'LL REALIZE,";
    text[6761] = "LIFE IS AN EXPERIMENT!...";
    text[7445] = "...AND THE UNIVERSE IS MY LABORATORY!";
    text[6822] = "It seems your resolve, was greater than mine...";
    text[6762] = "How?";
    text[6763] = "HOW DID YOU GET SO STRONG?!";
    text[6764] = "We're not just fighting for ourselves Saros.";
    text[6765] = "We're fighting for the People of Luna.";
    text[6766] = "We're fighting for our future!";
    text[6767] = "Bella, you don't understand what's coming...";
    text[6768] = "Archeo-Site 9... Your mother was the one who first discovered it...";
    text[6769] = "A strange relic, shaped like a crescent moon...";
    text[6770] = "There were some hidden texts on it that only she could decipher.";
    text[6771] = "These texts... were warnings left behind by the Ancients.";
    text[6772] = "It revealed the true nature of what Comet Coda really is.";
    text[6773] = "...?";
    text[6774] = "You really expect us to believe anything you say?";
    text[6775] = "You're not getting out of this, Saros.";
    text[6776] = "Enough with the deception.";
    text[6777] = "It's the truth. This information is classified.";
    text[6778] = "The Ancients were wiped out by... them.";
    text[6779] = "Them... Who are you talking about?";
    text[6780] = "Our true enemy...";
    text[6782] = "Comet Coda is some sort of cosmic entity.";
    text[6783] = "...created by a civilization known as Nemesis.";
    text[6784] = "They were responsible for wiping out the Ancients...";
    text[6785] = "They also wiped out the People of Terra a thousand years ago...";
    text[6786] = "...";
    text[6787] = "Why...";
    text[6788] = "Why would they do such a thing?";
    text[6789] = "I don't know.";
    text[6790] = "What I do know is...";
    text[6791] = "The Ancients, a civilization more advanced than us...";
    text[6792] = "...couldn't even stop Nemesis.";
    text[6793] = "Our best option, is to evolve... become Antimatter beings ourselves.";
    text[6794] = "...So we have a fighting chance.";
    text[6795] = "You're wrong about one thing.";
    text[6796] = "..and what is that?";
    text[6797] = "We're evolving every day.";
    text[6798] = "What will push us forward, more than anything...";
    text[6799] = "...more than sacrifice...";
    text[6800] = "...more than fear...";
    text[6801] = "...is unity.";
    text[6802] = "Humanity is resilient.";
    text[6803] = "We learn from our mistakes.";
    text[6804] = "When we get kicked down... We get back up and try again.";
    text[6805] = "I won't let history repeat itself.";
    text[6806] = "We'll figure this out together, Saros.";
    text[6859] = "I promise you, we'll find a way to survive.";
    text[6861] = "We won't let Nemesis defeat us.";
    text[6860] = "There is always hope.";
    text[6807] = "The Murk Serum... is not the solution.";
    text[6808] = "...";
    text[6809] = "GAHHH...";
    text[6810] = "Wh-what's happening to him?";
    text[6811] = "His body... It isn't used to all this power!";
    text[6840] = "His Antimatter is starting to consume him!";
    text[6812] = "Bella... My sensors detect an enormous power build-up!";
    text[6814] = "I can't... control it...";
    text[6815] = "My Serum... is still incomplete...";
    text[6816] = "I was only able to hit 99% Resonance...";
    text[6817] = "Despite that, I still used it on myself.";
    text[6818] = "Bella...";
    text[6841] = "You've chosen your path.";
    text[6842] = "I've chosen mine.";
    text[6843] = "...and it has brought me here.";
    text[6844] = "I have no regrets.";
    text[6845] = "If I can't protect humanity...";
    text[6846] = "It's up to you to keep humanity safe.";
    text[6847] = "My dream will never die.";
    text[6850] = "I am...";
    text[6851] = "...EVOLUTION!";
    text[6828] = "Bellaaaa!";
    text[6829] = "Is everyone okay?";
    text[6830] = "...and what the hell is that ugly monstrosity?!";
    text[6833] = "That's the mad scientist himself, Saros.";
    text[6834] = "SERIOUSLY?!";
    text[6835] = "His Serum backfired on him and now...";
    text[6823] = "He has fully transformed into a Murk.";
    text[6821] = "Attack incoming!";
    text[7450] = "Myeh! It's too dangerous for us to be here!";
    text[7451] = "Dad... It's been almost 72 hours...";
    text[7452] = "You have to head back to Luna immediately!";
    text[7453] = "What about you guys?";
    text[7454] = "We're going to stay here and finish the mission!";
    text[6838] = "We can't afford to let him escape through a wormhole.";
    text[6839] = "If we don't defeat him right here and now, he'll end up destroying Luna!";
    text[6852] = "We're not gonna let that happen!";
    text[7456] = "In that case...";
    text[7457] = "...show him the true might of the Lunex Force!";
    text[7458] = "We'll be waiting for you.";
    text[7459] = "Thanks, Dad!";
    text[7461] = "Raine, do you mind...";
    text[7462] = "Don't worry Miss Warrior Prodigy.";
    text[7463] = "We'll escort the trio safely back to Luna.";
    text[7464] = "...and we'll rush back here as soon as we're finished!";
    text[7465] = "You owe me another rematch so don't you dare lose to this beast!";
    text[7466] = "With Nickle and Tetra by my side, there's no way we'll lose!";
    text[7467] = "Right team?";
    text[7468] = "RIGHT!";
    text[6853] = "This is it!";
    text[6862] = "Our Final Mission!";
    text[6863] = "You ready, Nickle?";
    text[6864] = "Ready when you are!";
    text[6865] = "Tetra?";
    text[6866] = "The ultimate hero, Tetra, is READY!";
    text[6867] = "Then, let's gear up for battle!";
    text[6868] = "Huff... Huff...";
    text[6869] = "Did we... win?";
    text[6870] = "GRRRRAAAARHHHH.";
    text[6871] = "No way...";
    text[6872] = "He's still got more power left...";
    text[6873] = "We were... so close...";
    text[6874] = "Huff... Huff...";
    text[6875] = "My body is... at its limit...";
    text[6876] = "Tetra... How much charge do you have left?";
    text[6877] = "Can you fly?";
    text[6878] = "Just barely... I'm low on power...";
    text[6879] = "Take Nickle, and get out of here!";
    text[6880] = "WHAT?! NO!";
    text[6881] = "We're not leaving you.";
    text[6882] = "We're in this together, to the very end.";
    text[6883] = "Tetra... Nickle...";
    text[6884] = "Brace yourself! ENERGY SHIELD!";
    text[6885] = "HOLO SHIELD!";
    text[6886] = "Huff Huff...";
    text[6887] = "Crud... Our shield... it's breaking!";
    text[6888] = "Photon Barrier!";
    text[6889] = "It's the Raine Squad!";
    text[6890] = "We've got your back, Bella!";
    text[6891] = "C'mon ladies! Put up your shields!";
    text[6893] = "Roger that! Mineral Shield!";
    text[6894] = "Plasma Ring!";
    text[6895] = "What the hell, how can one Murk be THIS powerful?!";
    text[6896] = "You must've clobbered him real good to get him THIS mad!";
    text[6897] = "Stay focused, Raine! Hold the shield up for as long as you can!";
    text[6898] = "If it breaks... We're all toast! We must survive!";
    text[7471] = "RRRRRAHHHHHHHHH!";
    text[6902] = "...Bella!";
    text[6903] = "Wake up, Bella!";
    text[6901] = "Everyone...";
    text[6899] = "We're back on Luna... What happened?";
    text[6900] = "I don't know... We suddenly fell through a wormhole and now we're here.";
    text[6824] = "Reeves? Nyla? Did you use Celestia?";
    text[6825] = "Myeh, it wasn't us! We fell through a wormhole as well...";
    text[6826] = "...?!";
    text[6904] = "IT'S SAROS! EVERYONE TAKE COVER!";
    text[6907] = "Looks like I made it just in time.";
    text[6909] = "CHRONOS!?";
    text[6910] = "(This Murk... Could it be?!)";
    text[6911] = "What the... This Murk is on our side!? ...AND IT TALKS?!";
    text[6912] = "Hell yeah!";
    text[6913] = "Chronos... Thanks for saving us. How did you...?";
    text[6914] = "I'll explain everything later.";
    text[6915] = "Right now, we've got unfinished business.";
    text[6916] = "Bella...";
    text[7486] = "I know you must be exhausted...";
    text[7487] = "Perhaps it's taking every ounce of your remaining strength right now,";
    text[7488] = "...just to stand.";
    text[7495] = "Yeah...";
    text[7496] = "Everyone else is pretty beat too...";
    text[7489] = "Despite the current circumstances... You must persevere!";
    text[7490] = "It seems Saros can regenerate his Antimatter faster than other Murks...";
    text[7491] = "So there's only one way to defeat him....";
    text[7492] = "We'll have to combine our efforts into one ultimate attack!";
    text[6918] = "...an attack that would be able to damage his Anticore deep within.";
    text[7494] = "Ladies, are your Jet Suits equipped with Plasma Receptors?";
    text[7503] = "Yeah!";
    text[7499] = "The Receptors will allow you to apply force onto";
    text[7504] = "plasma projectiles generated by Lunex Force weaponry.";
    text[7500] = "You're pretty well informed with our military tech.";
    text[7501] = "Were you a soldier before Saros turned you into a Murk?";
    text[7502] = "......";
    text[7505] = "Something like that.";
    text[7506] = "Alright, everyone!";
    text[7507] = "We have to give it everything we've got!";
    text[7508] = "PHOTON CANNON!";
    text[7493] = "Can't...";
    text[7509] = "Hold it back...";
    text[7510] = "It's too powerful...";
    text[7511] = "Huff... Huff...";
    text[6924] = "Miss Bellaaaaaa!";
    text[6925] = "You can do it, Miss Bellaaaaaa!";
    text[7476] = "That voice... I recognize that voice!";
    text[7477] = "Isn't that Mett?!";
    text[7483] = "Myeh! It's not just Mett! There are soldiers and civilians as well!";
    text[7484] = "What are they all doing here?";
    text[7472] = "Earlier, we received a report that some of our soldiers were rallying";
    text[7473] = "to gather more allies all across Luna!";
    text[7474] = "Soldiers who were once loyal to Saros decided to join our alliance!";
    text[7475] = "Even civilians caught wind of the news and decided to march together!";
    text[7485] = "Miss Bella!";
    text[7479] = "We're all gathered here because we're not afraid to fight for what's right!";
    text[6927] = "You've given me the courage to face my fears!";
    text[7478] = "...and you've given all of us hope for a better future!";
    text[6926] = "Don't give up, Miss Bella!";
    text[7480] = "Stay strong!";
    text[7481] = "You've gotta take down Saros once and for all!";
    text[6929] = "...!";
    text[6930] = "What is this power...?!";
    text[6931] = "This is the power of your Lux!";
    text[6932] = "The People of Luna... has put their trust in you.";
    text[6933] = "Their hopes... Their determination... Their Lux...";
    text[6934] = "...They're channeling it towards you, Bella.";
    text[6935] = "Harness it.";
    text[6936] = "Use it to protect the people you love the most.";
    text[6937] = "This is your gift.";
    text[6938] = "The power to unite the people. To give them HOPE!";
    text[6922] = "The power of the Soul is limitless!";
    text[6940] = "EVERYONE! LET'S FINISH THIS!";
    text[6941] = "You got it, Bella!";
    text[6942] = "RAAAAAAAAAAAHHHH!";
    text[7512] = "It's working!";
    text[7513] = "We're slowly pushing it back!";
    text[6943] = "(Incredible... Everyone's Lux is united into one force!)";
    text[6944] = "(Farewell... Saros.)";
    text[6945] = "TAKE THIS! THE POWER OF OUR LUX!";
    text[6946] = "It's finally over....";
    text[6947] = "YEAH BABYYYYY! We did it! BAHAHAHA!";
    text[6948] = "Saros' Anticore...";
    text[6949] = "Shouldn't we destroy it?";
    text[6950] = "No... His soul will remain trapped inside.";
    text[6951] = "Let's leave it for now.";
    text[6952] = "He is no longer a threat to the People of Luna.";
    text[6953] = "Everyone... I'd like to take a moment to speak with all of you.";
    text[6954] = "...but not in this form.";
    text[6955] = "Please bear with me...";
    text[6956] = "It's been a while since I've practiced my Soul Sensing...";
    text[6957] = "...?!";
    text[6960] = "Mom?!";
    text[6961] = "General Grey!";
    text[6962] = "Theaaaa!!!";
    text[6963] = "It's nice to see you again, everyone.";
    text[6964] = "Mom, I missed you so much...";
    text[6965] = "I missed you too Bella...";
    text[7532] = "Thea... It's really you...";
    text[6966] = "Thomas, darling. I'm so happy to see you again.";
    text[6967] = "Mom...";
    text[6968] = "...how did you survive in the Phantom Realm?";
    text[6969] = "We all thought you were gone forever...";
    text[6970] = "That fateful day... When I learned about Saros' Murk experiments,";
    text[6971] = "I intended on stopping his schemes as soon as I located his Laboratory.";
    text[6972] = "During our duel, he caught me off guard...";
    text[6973] = "...and he used his Wormhole Machine to send me into the Phantom Realm.";
    text[6974] = "At the time, Murks didn't inhabit the Phantom Realm as much as they do now.";
    text[6975] = "...So it was impossible for me to escape through a wormhole...";
    text[6976] = "I had only one option left...";
    text[6977] = "During my duel with Saros...";
    text[6978] = "I managed to confiscate a vial of the Murk Serum he was developing.";
    text[6979] = "I had 72 hours to make a decision before my body would start to disintegrate.";
    text[6980] = "In the end...";
    text[6981] = "...I consumed the Serum.";
    text[6982] = "...and transformed into the Murk you call Chronos.";
    text[6983] = "It was the only way for me to survive...";
    text[6984] = "What was it like?";
    text[6985] = "Were you conscious inside your Murk body?";
    text[6986] = "When I became a Murk... I had no control over my body.";
    text[6987] = "...but my mind... my soul, was still conscious within.";
    text[6989] = "Mom, you're the strongest person I know.";
    text[6990] = "If anyone's going to persevere and survive... It's definitely you.";
    text[6994] = "When my latent Lux abilities started to surface,";
    text[7516] = "I didn't know what was happening... or what I was tapping into...";
    text[6992] = "...and every time I encountered a Murk, I felt something deep within my Soul.";
    text[7517] = "My Lux reacted to each and every one of them.";
    text[6993] = "I could hear their voices, calling for help...";
    text[6991] = "You were trying your best to communicate with me as well...";
    text[6995] = "I'm impressed you managed to awaken your Soul Sensing.";
    text[7017] = "You know... the reason I never told you about your Ancient ancestry...";
    text[7018] = "...is because my research on the Ancients has shown me that this power,";
    text[7019] = "if awakened, could be dangerous.";
    text[7518] = "I didn't want to put my own daughter in any kind of danger.";
    text[7020] = "General Grey, you sound just like Bella...";
    text[7021] = "She never wants to burden others...";
    text[7022] = "She tries to keep everyone out of harm's way.";
    text[7023] = "I wonder who she picked up this trait from?";
    text[7024] = "Doctor Thomas does it too!";
    text[7025] = "Hey!";
    text[7026] = "I guess it runs in the family.";
    text[6996] = "Mom, do you know about Comet Coda as well?";
    text[6997] = "I do.";
    text[6998] = "When you were carrying around my Anticore, I was listening.";
    text[6999] = "I was always listening.";
    text[7003] = "Wait hold on, if you were an Anticore...";
    text[7004] = "How did you revert back into a Murk?!";
    text[7005] = "An Ancient protector named Guardia was kind enough to let me use their vessel.";
    text[7056] = "It's a miracle I'm here. I didn't know if this would even work..";
    text[7007] = "It was thanks to you, Bella, that I'm even able to see you all again.";
    text[7008] = "Your kindness... Your resolve to find peace in your own way.";
    text[7009] = "Your determination to do the right thing.";
    text[7010] = "I'm one LUCKY Mom, let's just say that, hahaha.";
    text[7032] = "Everyone...";
    text[7027] = "...You cannot let Nemesis destroy humanity.";
    text[7028] = "We won't!";
    text[7029] = "Not on our watch!";
    text[7030] = "Those Nemesis suckers are gonna get a fist-full of Raine!";
    text[7031] = "BAHAHAHA!";
    text[7033] = "They won't stand a chance against us, right Nickle?";
    text[7034] = "Right!";
    text[7035] = "Mrs. Grey... Thank you for saving my life all those years ago.";
    text[7036] = "It's been a tough journey for me...";
    text[7520] = "...to open up to others... ";
    text[7521] = "To make friends who I can trust again...";
    text[7522] = "If I hadn't met you, or Bella...";
    text[7523] = "Saros' plan might have succeeded.";
    text[7524] = "Things would have been different...";
    text[7525] = "I'm grateful to all of you for accepting me.";
    text[7526] = "...despite the things I've done...";
    text[7527] = "Nickle... You must learn to forgive yourself.";
    text[7528] = "The existence of the Murks is not your fault.";
    text[7529] = "You've done well. You should be proud of what you've achieved!";
    text[7530] = "Thanks, Mrs. Grey.";
    text[7037] = "...and I trust you'll make sure Bella stays out of trouble?";
    text[7038] = "Y-yes ma'am!";
    text[7039] = "Oh?";
    text[7040] = "...and who's this adorable warrior?";
    text[7041] = "My name is Tetra!";
    text[7042] = "Bella told me so much about you!";
    text[7043] = "I've been her sidekick through thick and thin!";
    text[7044] = "Bella and I built Tetra together.";
    text[7045] = "When you were gone... It was tough on both of us.";
    text[7046] = "Tetra was the light that shined through the darkness...";
    text[7047] = "She brought us closer than ever during our darkest days.";
    text[7048] = "Heheh.";
    text[7049] = "I see. Well then, I think you deserve a promotion, Tetra.";
    text[7050] = "A promotion?! Me?!";
    text[7051] = "You're more than just a sidekick.";
    text[7052] = "You're a true hero.";
    text[7053] = "A true hero...";
    text[7054] = "I shall henceforth be known as, Superhero Tetra! Mwahahaha!";
    text[7055] = "Hahaha!";
    text[7011] = "Wh-whats happening, dear?";
    text[7012] = "This body... Is only a temporary vessel.";
    text[7013] = "I will revert back into my Anticore soon...";
    text[7014] = "No... Mom, you can't leave us again...";
    text[7015] = "Bella...";
    text[7016] = "...there is always hope.";
    text[7000] = "You've become a strong warrior.";
    text[7001] = "With Saros gone, the People of Luna need a new General.";
    text[7058] = "Wh-what about you?";
    text[7059] = "My time has passed. Now it's your turn to lead the people.";
    text[7060] = "I know you've got what it takes.";
    text[7061] = "It's always been inside of you.";
    text[7062] = "The power to unite people... To instill hope in others...";
    text[7063] = "...to lead the people into a bright future.";
    text[7064] = "I'm proud of you, Bella.";
    text[7065] = "Mom...";
    text[7066] = "I won't let you down, Mom!";
    text[7067] = "Thea...";
    text[7068] = "Thomas... I love you... Take care of Bella while I'm gone.";
    text[7069] = "I'm going to have to rest for a while...";
    text[7070] = "Thea... I promise you...";
    text[7071] = "I'll find a way to bring you back.";
    text[7073] = "We'll meet again someday!";
    text[7074] = "Farewell, everyone.";
    text[7075] = "You okay, Bella?";
    text[7076] = "Yeah.";
    text[7078] = "I'm glad we got to see her again after all these years.";
    text[7534] = "My mom will always be my hero.";
    text[7535] = "Instead of feeling sad right now...";
    text[7536] = "My heart is filled with nothing but hope.";
    text[7537] = "Good job everyone!";
    text[7538] = "We won today thanks to all of your efforts.";
    text[7539] = "Yo, we gotta give our new General some credit here.";
    text[7540] = "That's right! We couldn't have done it without you, Bella!";
    text[7542] = "This calls for a CELEBRATION! BAHAHAHA!";
    text[7543] = "I need a Cheesecake Bar... I'm starving!";
    text[7544] = "...and I need a nap! My legs feel like jelly...";
    text[7545] = "I think we all deserve a good rest first.";
    text[7546] = "Then...";
    text[7550] = "We celebrate!";
    text[7089] = "Our victory today...";
    text[7090] = "...Marks the beginning of a new era.";
    text[7092] = "Our journey will continue...";
    text[7093] = "...because our job isn't done yet.";
    text[7094] = "Comet Coda still approaches...";
    text[7095] = "...and this time... we'll be prepared.";
    text[7096] = "It's a tough road ahead though...";
    text[7097] = "...We still have a lot to learn...";
    text[7098] = "...about the Ancients...";
    text[7099] = "...about Nemesis...";
    text[7100] = "But one thing is crystal clear...";
    text[7101] = "Luna is our home.";
    text[7102] = "We won't let anyone take that away from us!";
    text[7103] = "We'll find a way to survive.";
    text[7104] = "...through unity, and through trust!";
    text[7105] = "May our Lux shine forever bright.";
    text[7106] = "Eight Months Later...";
    text[7107] = "General Grey, the preparations are ready.";
    text[7108] = "Sweet! Thanks for the update.";
    text[7109] = "Commander Nickle, the Antimatter Engine is ready for you.";
    text[7110] = "Are you sure you'll be okay, Nickle?";
    text[7111] = "It's gonna be the largest wormhole we've ever created.";
    text[7112] = "I got this.";
    text[7113] = "Trust me, heh.";
    text[7114] = "ALRIGHT EVERYONE!";
    text[7115] = "Initiate Celestia!";
    text[7116] = "Roger!";
    text[7117] = "Gear up, set the coordinates for Comet Coda, and buckle up!";
    text[7118] = "I hope you're ready, Nemesis...";
    text[7119] = "...cuz humanity is bringing the fight to YOU!";
    text[110000] = "C'mon Bella, let's go!";
    text[110001] = "Our ship is parked in the South-East Hoverport!";
    text[110003] = "Nom nom nom, all this food looks yummy!";
    text[110004] = "Bzzt Bzzt! That Hyperbee was strong!";
    text[110007] = "Let's go get some Cheesecake Bars at the cafe!";
    text[110008] = "I haven't finished my food yet so let's stick around for a bit.";
    text[110009] = "Alrighty.";
    text[110010] = "The locals here are pretty friendly. Maybe we can chat with some of them?";
    text[110012] = "Our ship awaits! Let's go go go!";
    text[110013] = "Let's head west to investigate the Barrier Facility!";
    text[110014] = "I hope the pilot is okay... That Murk looked really scary!";
    text[110015] = "Bella, you've been acting weird lately.";
    text[110016] = "Don't worry... I'm fine.";
    text[110017] = "Oxygen Level is currently at 97%!";
    text[110018] = "Let's go see what caused the breach!";
    text[110019] = "Two Murks just passed by! Let's go find them!";
    text[110020] = "I feel like the Murk was angry because its friend was killed...";
    text[110021] = "The Murk should still be around here somewhere...";
    text[110022] = "Let's go find it!";
    text[110023] = "There might be someone around here who knows about Lunar Panels.";
    text[110024] = "I mean, we'll eventually find them if we talk to EVERYONE.";
    text[110025] = "Woah woah, hold on a sec.";
    text[110026] = "We don't have time to talk to every single person.";
    text[110027] = "Okay true.";
    text[110028] = "Oh! I'll just turn on my Mission Guidance System!";
    text[110029] = "Huh? I don't remember installing an MGS.";
    text[110030] = "Must've been something Dad programmed himself.";
    text[110031] = "Basically, the MGS will help direct us towards areas of interest.";
    text[110032] = "We'll be able to see an indicator above certain people or objects.";
    text[110033] = "Indicators can help us tremendously on our missions!";
    text[110034] = "Some indicators even guide us towards people who need our help.";
    text[110035] = "If life was a video game, these would be called 'Side Quests'.";
    text[110036] = "...Ha ha, very funny.";
    text[110037] = "Didn't the MGS help us find the Moleculoid earlier?";
    text[110038] = "Oh yeah! I guess it was ON the whole time hehe.";
    text[110039] = "The person we're looking for will have a yellow indicator above them!";
    text[110068] = "Yay! We have 10 Lunar Panels!";
    text[110069] = "Now we just need a Thermo-Electric Generator...";
    text[110070] = "Nyla said that we might be able to get one from an Astrotech Trader!";
    text[110071] = "Let's check the Barrier Facility!";
    text[110066] = "We finally have 10 Lunar Panels and 1 Thermo-Electric Generator!";
    text[110067] = "Let's go see Nyla!";
    text[110040] = "Lunar Panels, Lunar Panels, where art thou Lunar Panels!";
    text[110041] = "We need to get 10 Lunar Panels from the Storage Unit,";
    text[110042] = "and 1 Thermo-Electric Generator from an Astrotech Trader!";
    text[110043] = "Astrotech is a much rarer form of currency than Bytes.";
    text[110044] = "If you explore Luna lots and lots,";
    text[110045] = "you might just find some Astrotech hidden away.";
    text[110046] = "We should always be on the lookout for useful items! Hehe.";
    text[110047] = "Let's meet up with everyone at the Hovercraft!";
    text[110048] = "Bella, let's head back to our ship when you're ready!";
    text[110049] = "Tetra is not with you right now.";
    text[1021] = "I'm having trouble getting accurate data from this environment...";
    text[1022] = "The chemical composition of the air and the soil is unknown.";
    text[1023] = "Tetra is not sure how you're even able to breathe here...";
    text[1380] = "Bella, let's hurry and find a way out!";
    text[110050] = "The Lunex Space Station is huge so make sure you know your way around!";
    text[110051] = "The Research Lab is on Floor 3F!";
    text[110052] = "It's in the west corridor, heh. Let's go!";
    text[2482] = "Hmm, I wonder what we're gonna be doing in Oceanus.";
    text[2543] = "We need to explain our plan to Doctor Thomas! To the Space Station we go!!";
    text[110053] = "There's a Murk Outbreak in Copernicus!";
    text[110054] = "We need to go help out! It's an Emergency Mission!";
    text[110055] = "Let's do our best and save as many people as we can!";
    text[2709] = "We need to find the 4 Filter Machines and restore the Waterworks Network!";
    text[2978] = "We should go to the Waterworks building rooftop!";
    text[2979] = "We need to have a talk with the Murk Slayer!";
    text[3206] = "Bella, you look exhuasted... You need to rest!";
    text[3207] = "Let's go back home to your room and get some sleep.";
    text[3854] = "Let's go see what Doctor Thomas is up to at the Research Lab!";
    text[3855] = "Time to see if there's any new missions for us!";
    text[3856] = "Stella will give us the debrief! Let's go down to 1F Lobby, heh.";
    text[3857] = "Looks like we've got several Missions we can do!";
    text[3858] = "If you need more info on any of the Missions, I think its best if";
    text[3859] = "we check the MISSION BOARD and have Stella give us the details.";
    text[3860] = "A RED indicator will be above Mission related people or points of interest!";
    text[4201] = "Doctor Thomas is back from his conference!";
    text[4202] = "Let's go talk to him at the Research Lab!";
    text[4203] = "We got the LUNEX KEY! Now we can enter the Military Base, heh.";
    text[4204] = "The Military Base is located in the Wasteland Zone! Let's go!";
    text[4236] = "Sewage Area... yuck!";
    text[4237] = "I don't want to be in the Sewage Area either, but we have no other choice...";
    text[4248] = "Let's find the Murk Slayer's prison cell!";
    text[4293] = "We need to look for the control panel that's wired to the green door.";
    text[4307] = "Let's go see if the Murk Slayer is in the prison cell with the green door!";
    text[4291] = "The Murk Slayer should be in one of the rooms in the Military Base.";
    text[4292] = "Let's check every nook and cranny!";
    text[4512] = "We need to escape the Military Base ASAP! Let's go to the first floor!";
    text[4518] = "We need to head west to the Crater of Eternal Darkness!";
    text[110056] = "Let's find a way to escape from here while Vivia is still immobilized!";
    text[110057] = "Now that we're in Silica Rifts we need to head east towards the Colony.";
    text[110058] = "Hey, I'm the sidekick here. I'm in charge of the reminders. Hmph.";
    text[110059] = "We need to look for Cypher. He can help us get a spaceship!";
    text[110060] = "I miss our old spaceship...";
    text[110061] = "We abandoned it in front of the Military Base...";
    text[110062] = "We can go back and retrieve it later.";
    text[110063] = "At least we have a fully charged minipod to fly around in!";
    text[110064] = "I guess...";
    text[110065] = "...anyways, Nickle's hideout is somewhere in Oceanus. Let's go!";
    text[110072] = "Looks like we're going for a swim...";
    text[110073] = "...cuz the entrance to Nickle's hideout is underwater!";
    text[5486] = "Woah, these ruins have luminescent rocks everywhere!";
    text[5487] = "That's a good thing... because I didn't bring a flashlight!";
    text[5501] = "We need to find FOUR GEMSTONES somewhere in these ruins!";
    text[5502] = "AND UPON FINDING THEM, TETRA SHALL HENCEFORTH BE KNOWN AS";
    text[5503] = "THE GREAT SOUL SENSER SIDEKICK.";
    text[5504] = "Bella?";
    text[5505] = "Yeah?";
    text[5506] = "What's a Soul Senser?";
    text[5507] = "To be honest, I don't know. I have some guesses but...";
    text[5508] = "...let's pass the Soul Trial first!";
    text[5509] = "Okie, heheh.";
    text[6001] = "Yay! We passed the Soul Trial!";
    text[6002] = "We can finally go through the giant gate that was blocking our way!";
    text[6209] = "Uh, where do I sleep?";
    text[6210] = "Hmm... My room I guess.";
    text[6211] = "Huh?! B-but, isn't that...";
    text[6212] = "...So you don't want to sleep in my room?";
    text[6213] = "The healing chambers has sleeping pods you can use.";
    text[6214] = "...No, I mean...";
    text[6215] = "I don't really know my way around the Space Station...";
    text[6216] = "I'm probably gonna get lost so... It's better if I stick with you...";
    text[6217] = "(Sigh) Just follow me.";
    text[6218] = "...are you sure?";
    text[6219] = "Where are you gonna sleep then?";
    text[6220] = "On the floor I guess? I have a cozy carpet, heh.";
    text[6221] = "Don't worry about it Nickle!";
    text[6222] = "You're my guest! You get the bed.";
    text[6223] = "Oh and... Tetra sleeps on the bed too so...";
    text[6224] = "Nevermind, I'll sleep on the floor instead.";
    text[6225] = "Huh?! Why'd you change your mind?";
    text[6226] = "My hands sometimes flare up when I sleep.";
    text[6227] = "I might accidentally melt you...";
    text[6228] = "Also... Robots sleep?";
    text[7126] = "The Lunex Space Station is under attack!";
    text[7127] = "We've gotta find and defeat the Murks in this area!";
    text[7192] = "You forgot something in your room remember?";
    text[7245] = "Saros' Office seems oddly quiet. Is he even here?";
    text[7246] = "Let's be cautious just in case. It could be a trap.";
    text[7389] = "That wormhole machine in the Secret Lab looks just like Celestia...";
    text[7390] = "Let's get a closer look!";
    text[7391] = "Saros is holding Doctor Thomas hostage somewhere in the Phantom Realm!";
    text[7392] = "He's also got all of the Anticores I've collected...";
    text[7393] = "We have to find him, and stop him once and for all!";
    text[7438] = "...";
    text[7552] = "Today seems like a great day to go on an adventure!";
    text[7553] = "Maybe we could check the Lunex Force MISSION BOARD and tackle some missions!";
    text[7554] = "...Or we could go searching for strong Murks to battle!";
    text[7555] = "I'm itching to do some training.";
    text[7556] = "We gotta make sure we're in tip-top shape!";
    text[7557] = "Why not both? Heh.";
    text[7558] = "Afterwards, we can relax at a cafe while munching on Cheesecake Bars!";
    text[7559] = "My treat!";
    text[257] = "Bella, there's a SKILL BOOSTER behind the glass wall!";
    text[258] = "Ohh you're right! SKILL BOOSTERS are pretty rare!";
    text[259] = "How do we get there though? Is there another entrance?";
    text[260] = "Time for an OPTICAL ZOOM!...";
    text[261] = "25%... 50%...";
    text[262] = "75%...!";
    text[263] = "Hmm...";
    text[264] = "OH!";
    text[265] = "I can see a really tiny label on the capsule elevator switch.";
    text[266] = "What does it say?";
    text[267] = "Barrier Facility - Cargohold";
    text[268] = "Good work Tetra!";
    text[269] = "The back-entrance is located in the Barrier Facility!";
    text[245] = "Wait, I think the Murks went in the other direction.";
    text[246] = "Let's try the other portal!";
    text[247] = "The Murk should still be around here somewhere.";
    text[248] = "Let's go find it!";
    text[1337] = "It's an abandoned Hertz Cube.";
    text[1338] = "They are typically used to store and protect currency or valuable goods.";
    text[1335] = "This Hertz Cube appears to be locked.";
    text[1336] = "Hmm... Maybe we could use the lasers to open it up?";
    text[568] = "Oh cool! This light fixture is actually thermo-luminescent.";
    text[569] = "Huh?! Therma-luma-whatsis?";
    text[570] = "There's a stone in there that glows when heated!";
    text[571] = "Oooo that's pretty neat!";
    text[575] = "Looks like a new shipment of yummy food just came in!";
    text[576] = "Mmm, Tetra is getting hungry!";
    text[577] = "Did you forget you can't eat?";
    text[578] = "Oh yeah...Well, I'm hungry for other things.";
    text[579] = "Like what?";
    text[580] = "Uhm...SECRET! Hahaha.";
    text[581] = "It's a fresh cup of coffee.";
    text[582] = "I don't think we took Dad to Cafe Regolithia yet.";
    text[583] = "I heard their coffee is pretty good!";
    text[584] = "Doctor Thomas needs to ease up on the coffee though... He drinks too much!";
    text[592] = "There is a small note on the crate that reads:";
    text[593] = "Input 1 - Left";
    text[594] = "Huh? Bella, what could that mean?";
    text[595] = "I'm not sure, but it might be useful for something...";
    text[596] = "Let's keep an eye out in case we see more!";
    text[597] = "Alrighty! Super Detective Tetra is ready heh.";
    text[784] = "Bella?";
    text[785] = "Yeah?";
    text[786] = "Why do you look through Trash Bins so much?";
    text[787] = "Eheheh...";
    text[788] = "I'm... Just curious okay...";
    text[789] = "Isn't this called dumpster diving?";
    text[790] = "...Tetra?";
    text[791] = "Yeah?";
    text[792] = "Keep this between you and me, okay?";
    text[793] = "Hahaha okie dokie!";
    text[1058] = "The popular snacks are sold out in this vending machine.";
    text[1059] = "NOOOOO I WANTED MORE CHEESECAKE BARS...";
    text[1060] = "They have Crunch-E Bars!";
    text[1061] = "No.";
    text[1062] = "It's not the same.";
    text[1327] = "Bella, we just saw a Shooting Star!";
    text[1328] = "That was pretty cool! I feel super LUCKY!";
    text[1329] = "LUCKY EVENT: The next item or currency you pick up will be multiplied x2!";
    text[1330] = "Pick up your next item wisely!";
    text[1331] = "You only get one LUCKY EVENT per chapter!";
    text[1034] = "The Anticore in your possession seems to be reacting to something.";
    text[1332] = "Hmm, these markings on the wall are really strange... Let's come back here later.";
    text[1581] = "The Anticores in your possession are reacting to the markings on the wall.";
    text[1582] = "...?!";
    text[1819] = "Oh! They installed a new Food Machine.";
    text[1820] = "Now it's called F.O.O.D. v3.";
    text[1821] = "I liked it better when it was called YUMMY 5000.";
    text[1822] = "Me too!";
    text[1823] = "What does the F.O.O.D. acronym even stand for?";
    text[1824] = "I have no idea...";
    text[1825] = "At least it can make a thousand new dishes!";
    text[1826] = "Mmmm, I could go for some spicy curry right now!";
    text[1882] = "Wait! I see something scribbled inside the trash bin!";
    text[1883] = "143143";
    text[1884] = "Aw it's just a bunch of numbers...";
    text[1885] = "Maybe it's a password! Heh, we should write it down in case we need it!";
    text[2004] = "The displays are scrolling through various products that were created here.";
    text[2005] = "Huh?! 'The Ultimate Coffee Machine' Designed by Doctor Thomas.";
    text[2006] = "'This Machine will make you the perfect cup of coffee without you lifting a finger!'";
    text[2007] = "'All you need to do is say COFFEE PLEASE' and the machine will make it for you!'";
    text[2008] = "'It can even make the finest espresso!'";
    text[2009] = "This article was published last week...";
    text[2010] = "We need to have a coffee talk with Dad.";
    text[2011] = "A bunch of empty coffee cups are littered around the entire room.";
    text[2012] = "I wonder what coffee tastes like.";
    text[2013] = "Bitter. Dad likes it black.";
    text[2014] = "Hmm, I wonder what bitter tastes like.";
    text[2015] = "Oh right, you can't taste.";
    text[2016] = "Nope! You can call me Terrible Taste Tester Tetra.";
    text[2017] = "Terrible Test Taste Tet... Did you do that on purpose?";
    text[2018] = "Do what?";
    text[2019] = "The tongue twisters! The alliteration!";
    text[2020] = "Ohh, Heh... maybe...";
    text[2034] = "It's my room!";
    text[1901] = "The Lunex BBS is currently unavailable. We apologize for the inconvenience.";
    text[1902] = "The scientists apparently overloaded the server with their research ideas.";
    text[1903] = "Really?! How do you know?";
    text[1904] = "That's what it says in the changelog notes.";
    text[1905] = "Oh well, let's come back later.";
    text[1906] = "Restricted Area - Access Denied";
    text[1907] = "I wonder what's back there...";
    text[1908] = "I lived here all my life and I still have no idea.";
    text[1909] = "Mom and Dad never let me go into the restricted areas.";
    text[1910] = "Maybe they're doing some cool science stuff in there, heh.";
    text[1912] = "This vending machine is out of order.";
    text[1913] = "This vending machine sells canned bananas...";
    text[1914] = "Why...";
    text[1993] = "This display is showing a bunch of upcoming deadlines and project milestones.";
    text[1994] = "Looks like some teams are behind schedule...";
    text[1995] = "Deadlines are stressful...";
    text[2098] = "There's some books here written by Doctor Thomas.";
    text[2099] = "You take a book called 'The Power of Lux' off the shelf and start reading:";
    text[2100] = "Science has confirmed the existence of the soul, now known as 'Lux'.";
    text[2101] = "In simple terms, Lux is soul energy.";
    text[2102] = "Despite Lux being a relatively new field of research, we've made a few discoveries.";
    text[2103] = "Lux is tied strongly to feelings, emotions, willpower, and instinct.";
    text[2104] = "Some individuals can have stronger Lux than others.";
    text[2105] = "My team has theorized that in rare cases, Lux can possibly be harnessed and manipulated.";
    text[2106] = "(Could this have something to do with the strange feelings I've been having?)";
    text[2107] = "(I'll need to talk to Dad about this eventually...)";
    text[2123] = "Many years of coffee spills has stained the desk to a brown color.";
    text[2124] = "Mom tried to get Dad to throw away this desk but he refused to replace it.";
    text[2125] = "Why?";
    text[2126] = "Too much sentimental value.";
    text[2127] = "He had his best ideas while working long nights at this desk.";
    text[2128] = "He also said the desk was coffee scented... yuck.";
    text[2137] = "There's a bunch of things stuffed in your closet.";
    text[2189] = "There is nothing new in your closet.";
    text[2190] = "You found your old yo-yo collection.";
    text[2191] = "You found a book titled: Best Sidekick Guide 101.";
    text[2192] = "Oh... that's uhm...";
    text[2193] = "That's mine. I forgot I put it in here.";
    text[2194] = "Silly Tetra.";
    text[2199] = "You found your favorite swimsuit.";
    text[2200] = "I feel like going to the beach now...";
    text[2195] = "You found a classic bunny suit.";
    text[2196] = "I think it still fits!";
    text[2197] = "Tetra where's your Halloween costume?";
    text[2198] = "Hmph. In the trash.";
    text[2201] = "I WAS A CARROT.";
    text[2202] = "We came late and that's all they had left in the store...";
    text[2203] = "Okay, what do you want to dress up as this year?";
    text[2204] = "Hmmm...";
    text[2205] = "This time, I'll be the bunny and you'll be the carrot MWAHAHAHA.";
    text[2206] = "You found some leggings and workout clothing.";
    text[2207] = "Oh, that reminds me, I need to make sure I do my daily push-ups and sit-ups!";
    text[2208] = "You found your Lunex Academy Graduation Certificate!";
    text[2209] = "You also found a 1st Place Cheesecake Eating Contest Certificate...";
    text[2210] = "Under your clothes is a stash of Cheesecake Bars.";
    text[2211] = "I MUST RESIST THE TEMPTATION.";
    text[2212] = "You found your black-belt martial arts gi.";
    text[2541] = "We don't need to go there right now.";
    text[5551] = "Woah, it's an Ancient Vessel!";
    text[5552] = "Yup, our present-day Vessels and weaponry was derived from";
    text[5553] = "technology left behind by the Ancients.";
    text[5554] = "It's amazing how scientists were able to figure out how to use the tech.";
    text[5555] = "You gotta give humanity some credit: Science is our forte! Heh.";
    text[5560] = "OUR SEVEN CHAMPIONS...";
    text[5561] = "THE WISDOM OF TYCHO";
    text[5562] = "THE BRAVERY OF SILICA";
    text[5563] = "THE DETERMINATION OF COPERNICUS";
    text[5564] = "THE KINDNESS OF LUMINA";
    text[5565] = "THE JUSTICE OF MAGNESIA";
    text[5566] = "THE HUBRIS OF GRIMALDI";
    text[5567] = "THE TRUST OF REGALIA";
    text[5568] = "These names...";
    text[5569] = "These are the names of our colonies!";
    text[5570] = "The seven champions...";
    text[5571] = "We know our Lunar Colonies were named after their founders.";
    text[5572] = "It's odd... There are no records of the Ancients being alive during";
    text[5573] = "the time when our colonies were founded.";
    text[5574] = "Maybe it's a lucky coincidence?";
    text[5575] = "I don't know...";
    text[5576] = "If we manage to survive Comet Coda, I'll have to look into this someday.";
    text[3517] = "Stolen weapons and military gear are stored by the wall.";
    text[3518] = "Looks like these bandits communicate with several fleets.";
    text[3519] = "If we take down enough of them,";
    text[3520] = "we'll definitely catch the attention of their leader.";
    text[3521] = "There's a memo on this display that says: 258227.";
    text[5657] = "Hmm... this Jet Pad isn't getting enough power...";
    text[5658] = "Is there a way to fix it?";
    text[5659] = "There should be an Electrical Panel somewhere around here.";
    text[5660] = "I could supercharge it and warm up the circuit to fix the Jet Pad!";
    text[5661] = "Brrrr.... Let's hurry.";
    text[5662] = "Sniff... I'm freezing!";
    text[5663] = "SUPER SIDEKICK SUPERCHARGE!";
    text[5664] = "The Jet Pad should be working properly now! Hehe.";
    text[3357] = "Uh...why is there fresh kitty litter in this trash bin?!";
    text[4371] = "We haven't looked at all the rooms on this floor yet!";
    text[4519] = "We can't go back to the Military Base right now!";
    text[7232] = "Woah... I've never seen a Jet Suit model like this before.";
    text[7233] = "Do you think it belongs to Saros?";
    text[7234] = "Doesn't seem like something he would wear. It's pretty heavy duty.";
    text[7244] = "My material scan shows it's made of titanium!";
    text[7235] = "I think this is a battle suit likely made for war.";
    text[7236] = "War...";
    text[7237] = "I mean, you never know what could be out there in the universe...";
    text[7238] = "I say we take the suit.";
    text[7239] = "Huh?! Why?";
    text[7240] = "Cuz' it's cool!";
    text[7241] = "Yeah, I think it would look great on you.";
    text[7242] = "Hmm...";
    text[7243] = "Okay fine, heh.";
    text[7213] = "Oh hey...! I can disable the A.D.B.S. from this computer!";
    text[7214] = "Sweet! Now we can freely use our ships to fly around Luna!";
    text[7247] = "Was this Vessel here when Thea was the General?";
    text[7248] = "No... This entire corridor is new actually.";
    text[7249] = "This is my first time stepping foot in the General's Quarters,";
    text[7250] = "ever since Mom passed away.";
    text[7251] = "Were the walls always purple?";
    text[7252] = "Yep! The color of the walls hasn't changed.";
    text[7253] = "Purple was my Mom's favorite color.";
    text[7254] = "So our modern day Vessels were derived from Ancient Vessels?";
    text[7255] = "Pretty much.";
    text[7256] = "About a year ago I happened to come across an abandoned Vessel.";
    text[7257] = "I was able to operate it without an Anticore.";
    text[7258] = "Usually I stay away from anything related to the Lunex Force but...";
    text[7259] = "I wanted to double check something.";
    text[7260] = "What were you looking for?";
    text[7261] = "Well, there's some ancient texts that mentioned that the Vessels have";
    text[7262] = "a hidden feature where they can be powered by a third fuel source...";
    text[7263] = "...Lux.";
    text[7264] = "It's highly dangerous...";
    text[7265] = "...powering a machine that slowly drains your Lux until...";
    text[7266] = "...I don't even want to think about it.";
    text[7267] = "As far as I'm aware...";
    text[7268] = "Our modern day Vessels don't have a functionality like that.";
    text[7269] = "You never know what other secrets Saros has been keeping.";
    text[7270] = "True... Thanks for telling us. ";
    text[7271] = "If we're ever in an emergency situation... Who knows...";
    text[7272] = "We might need to use that hidden feature someday.";
    text[7283] = "This console has a list of warrants and wanted criminals the";
    text[7284] = "Lunex Force is currently searching for.";
    text[7285] = "Am I on this list?";
    text[7286] = "Huh... You're not on the list.";
    text[7287] = "That's weird... What about me?";
    text[7288] = "You're number one on the list.";
    text[7289] = "What a lovely honor.";
    text[7202] = "You want to go back already?";
    text[7203] = "I want to make sure we're fully prepared to fight Saros.";
    text[7204] = "What if we need to pack more Ener-G or Battle Mints?";
    text[7211] = "Celestia can't produce a wormhole to bring us back";
    text[7212] = "without me being there to fuel it.";
    text[7205] = "We're in the middle of a wasteland remember?";
    text[7206] = "There's no merchants nearby...";
    text[7207] = "...and the Astro Barrier Defense System prevents us from flying anywhere.";
    text[7208] = "Wait a minute...!";
    text[7209] = "There's a good chance the master controls for the A.D.B.S. is here!";
    text[7210] = "Let's look around! Maybe we can disable it!";
    text[7365] = "On this console... A map of Luna sprinkled with different colored pins.";
    text[7366] = "Each pin indicates the location of a Murk incident or outbreak.";
    text[7367] = "The data points go back almost 10 years...";
    text[7357] = "Everything we were told about the Murks...";
    text[7358] = "...it was only a fraction of what Saros really knew.";
    text[7359] = "He manipulated us...";
    text[7360] = "We only knew enough to be able to defend ourselves...";
    text[7361] = "...and to be able to collect Anticores...";
    text[7362] = "...That's pretty much it.";
    text[4789] = "Y'know, when I found this cave, these piles of wood were already here.";
    text[4790] = "Someone must have been here before us.";
    text[4791] = "Hate to ruin the mystery for you two but...";
    text[4792] = "This was one of the spots where I camped out years ago.";
    text[4793] = "Wherever I go, I go on foot. It helps keep a low profile.";
    text[4794] = "When you're on the run for so many years,";
    text[4795] = "you end up having many hiding spots and places to camp out.";
    text[4831] = "Woah, that's a HUGE crystal.";
    text[4832] = "Locals call this the Eternity Crystal.";
    text[4833] = "It's been around ever since the colony was founded.";
    text[4834] = "Apparently it's one of the Seven Wonders of Luna.";
    text[7900] = "Woah, the water here looks like jelly!";
    text[7901] = "Hmm... The gravity here is a bit lower than usual.";
    text[7902] = "I guess we're pretty far away from the nearest gravity generator.";
    text[7912] = "Psst, Bella, can I take a look at what's inside?";
    text[7913] = "We really shouldn't be going through other people's personal stuff.";
    text[7914] = "...but aren't you curious? Even a little bit?";
    text[7915] = "Well, yeah...";
    text[7916] = "The urge to explore and examine every nook and cranny...";
    text[7917] = "It's both a gift and a curse, for eager adventurers like us...";
    text[7962] = "It's a map of Silica Rifts!";
    text[7963] = "What do the green markings indicate?";
    text[7964] = "I don't know, but my treasure hunter senses are tingling.";
    text[7983] = "These crates are labeled 'TOP-SECRET.'";
    text[7981] = "Saros probably stored equipment from his secret experiments";
    text[7982] = "throughout the years in this storage room...";
    text[7984] = "It's a collapsed mine shaft.";
    text[8004] = "I think we should focus on the Mission right now.";
    text[8005] = "We'll be able to explore the city later.";
    text[1471] = "That battle was intense! Your skills are amazing, Miss Bella!";
    text[1472] = "We'll keep an eye out and make sure the civilians are safe.";
    text[403] = "More and more patrol troops are being dispatched every day.";
    text[404] = "The frequency of Murk appearances has been slowly increasing as well...";
    text[405] = "We're doing relatively okay, but...I hope things don't get out of hand.";
    text[406] = "I'll probably squeeze in some training sessions later today.";
    text[407] = "The Battle Simulator Room at the Lunex Space Station is great for training!";
    text[408] = "Hey, thanks for the tip!";
    text[388] = "Greetings Miss Bella!";
    text[796] = "We're installing the latest model of Lunar Panels!";
    text[797] = "Apparently these Panels produce the highest energy offset in human history!";
    text[801] = "These Lunar Panels are heavy...";
    text[798] = "Ah Miss Bella! Heading back to the station I see. Well, have a safe flight!";
    text[799] = "Did you see the Murk that flew by?! It was massive!";
    text[800] = "We've gotta stay on guard, who knows when it will show up again...";
    text[802] = "The view is really pretty from up here.";
    text[803] = "It is! This is one of my favorite spots to visit.";
    text[804] = "Can I ask you something?";
    text[805] = "Sure!";
    text[806] = "Do you think... we'll ever find a way to hide from the Murks?";
    text[807] = "Or at least... prevent them from hurting us...";
    text[808] = "I'm not one to hold grudges but... they took the life of my husband.";
    text[809] = "Oh... I'm sorry for your loss...";
    text[810] = "I don't want anyone else to experience the same suffering as me.";
    text[811] = "Ma'am, we'll find a way.";
    text[812] = "I don't want people to live in fear of what's out there in the universe.";
    text[813] = "Humanity grows and flourishes with our curiosity to learn and discover.";
    text[814] = "On behalf of the Lunex Force and myself, we'll do our best.";
    text[815] = "Th-Thank you.";
    text[816] = "Anytime!";
    text[817] = "I'll do my best to stay strong. Thank you for giving me hope.";
    text[818] = "01100100 01101001 01100111 01101001 01110100";
    text[819] = "He says his name is Digit.";
    text[820] = "Bella, I think something is wrong with Digit's program.";
    text[821] = "Aw, poor thing. Let's take Digit back to the Lab. Dad could fix it!";
    text[822] = "01100111 01101111 01110100 01110100 01100001 00100000 01100111 01101111";
    text[823] = "Digit says he has to go now.";
    text[824] = "I see. Maybe this robot belongs to someone...";
    text[825] = "What a strange robot.";
    text[840] = "Hehe.";
    text[841] = "Double Hehe.";
    text[842] = "Uhm, Hi!";
    text[843] = "Ohh hi there!";
    text[844] = "Hi Hi!";
    text[845] = "Uhm, we saw you fighting that murk earlier, you were so cool!";
    text[846] = "Super Cool! And then we came here to hide!";
    text[847] = "We wanted to give you something for keeping our home safe.";
    text[848] = "Yeah Yeah!";
    text[849] = "Aw, Thank you! That's so sweet!";
    text[850] = "(These kids... They shouldn't be drinking Ener-G Drinks.)";
    text[851] = "(No wonder they're so hyper.)";
    text[852] = "Bye!";
    text[853] = "Double Bye!";
    text[854] = "Miss Bella, your Jet Suit looks custom made. Did Doctor Thomas make it for you?";
    text[855] = "Yep!";
    text[856] = "Lucky! This is my first day on the job actually.";
    text[857] = "I never expected to encounter Murks already...";
    text[858] = "But... I'll do my best to learn and get stronger!";
    text[859] = "I've only been an official warrior for a few months actually.";
    text[860] = "There is still a lot for me to learn too.";
    text[861] = "Yeah, but you've been training all your life with a powerhouse like your mother!";
    text[862] = "She must have taught you all kinds of amazing techniques!";
    text[863] = "You've got a great foundation already and ya moved up the ranks so fast!";
    text[864] = "Oh boy, I hope I'm able to rank up one of these days too.";
    text[865] = "It would be cool to wear the sleek blue colored Model X Jet Suits someday.";
    text[866] = "Well, good luck to both of us!";
    text[867] = "Glad to have you on the team! We need more motivated warriors like you.";
    text[868] = "Th-Thanks! Ahahah!";
    text[869] = "(Pssst, Bella you're making Mr. Soldier blush!)";
    text[870] = "(Uh, Tetra he's wearing a helmet, how can you even...)";
    text[871] = "(Tetra!)";
    text[872] = "(I told you not to scan people without their permission first!)";
    text[873] = "(Oops... Forgetful Sidekick Tetra is sorry, heheheh.)";
    text[874] = "(Sigh)";
    text[875] = "I'll do my best to learn and get stronger!";
    text[876] = "The Murks...";
    text[877] = "We have no way to predict when or where they'll appear.";
    text[878] = "I'm glad we do our job well enough so that the citizens";
    text[879] = "don't have to live their lives in constant fear.";
    text[880] = "Murks used to appear about once or twice a month. But now...";
    text[881] = "They seem to be making more appearances lately.";
    text[882] = "All we can do is keep them at bay, and protect the People of Luna.";
    text[883] = "We got a bunch of supplies comin' in from all over Luna.";
    text[884] = "Some o' these crates got meats and veggies ordered by the Cafe,";
    text[885] = "and shipped all the way from Kepler Ranch.";
    text[886] = "Looks like we got a red cadet here! Still a shrimp I see hahahah!";
    text[887] = "Some day you'll be as strong as I am hahaha!";
    text[888] = "(His rank has gotten to his head. What a doofus.)";
    text[889] = "(Tetra, scan him.)";
    text[890] = "(Hmm... According to his records, his max PR for squats is 165 lbs.)";
    text[891] = "Pfffttt...! (That's nothing! Mine's like 315 lbs.)";
    text[892] = "What's so funny there, red cadet?";
    text[893] = "How much can you squat?";
    text[894] = "Heh, I could squat 260 lbs easy!";
    text[895] = "Pfffttt...!!!";
    text[896] = "Whatever, I don't have time to chit-chat with red cadets.";
    text[897] = "(What a doo doo head.)";
    text[898] = "Quit buggin me. I don't have time to chit-chat with red cadets.";
    text[899] = "(Grrr. Doo doo head.)";
    text[1103] = "I'm waitin' here for my buddy Mett.";
    text[1104] = "He's takin' longer than usual with the shipment... I hope he's doin' alright.";
    text[1414] = "Hey, thanks for helpin' out my buddy Mett earlier today!";
    text[1415] = "Miss Bella! I hope you're doing well.";
    text[1416] = "Seeing your wit and determination to fix the hovercraft really inspired me.";
    text[1417] = "I've decided, I'm going to make an effort to get over my fear of the Murks.";
    text[1418] = "It m-might take some time though... I still shiver at the thought of Murks.";
    text[1419] = "But... I'll do my best! You'll see someday!";
    text[389] = "Don't worry about us.";
    text[390] = "There are Murks out there that need to be dealt with.";
    text[794] = "I hope we're able to fix the Astro-Barrier breach in time...";
    text[795] = "My daughter's waiting for me to get home so we can play video games.";
    text[1363] = "Sector 16 has finally opened back up. I'm glad things got resolved!";
    text[1364] = "Now I can go home and play video games with my daughter! Woohoo!";
    text[295] = "What is it Tetra?";
    text[296] = "Nothing.";
    text[297] = "Hmph.";
    text[298] = "Aw, seems like someone is jealous! Hahaha.";
    text[299] = "Maybe a little. Hmph.";
    text[300] = "I'll give you head pats later, I promise.";
    text[301] = "Heheh, okie!";
    text[916] = "Bella, this Cargohold entrance is sealed by a laser door!";
    text[917] = "We'll get zapped if we try to go through it!";
    text[918] = "Can you dive into the Control Panel and unseal it?";
    text[919] = "Uhm, this Control Panel is completely busted... I can't dive into its Network.";
    text[920] = "Hmm... In that case, we can try something else.";
    text[921] = "What do you suggest?";
    text[922] = "You see those lasers? They're part of the Astro-Barrier Defense System.";
    text[923] = "I'm thinking we aim the lasers at the door, heh.";
    text[924] = "Oooo let's try it!";
    text[932] = "We did it! We can enter the Cargohold now!";
    text[936] = "Hey! Welcome to my home, haha!";
    text[937] = "I'll be streaming some indie games later today!";
    text[938] = "You're a streamer?! Woah!";
    text[939] = "Yep!";
    text[940] = "You've got quite the collection of games!";
    text[941] = "Thanks! Playing and promoting indie games is my passion, haha!";
    text[942] = "Woah, your robot is so cool!";
    text[943] = "My name is Tetra! I'm Bella's number one sidekick! PEW PEW!";
    text[944] = "Did you build it yourself?";
    text[945] = "My Dad and I built her together. Her AI is still relatively new.";
    text[946] = "That's so glitch!";
    text[947] = "Eheheh... (Is that what kids say nowadays?)";
    text[948] = "It's a lot more quiet out here compared to the bustling city of Tycho.";
    text[949] = "Since the residence is deep within the cliffs of Regolithia,";
    text[950] = "We're better protected from potential disasters.";
    text[951] = "We have our own backup food and oxygen supplies just in case!";
    text[952] = "Ack! I needa go BADLY...!";
    text[953] = "Apparently, ramen noodles made from wheat grown in Terra,";
    text[954] = "tasted different than the ones grown on Luna.";
    text[955] = "I wonder what it tasted like...";
    text[956] = "It's too bad Terra is an uninhabitable volcanic planet now.";
    text[957] = "I wonder what life was like 1000 years ago...";
    text[958] = "Like, before we terraformed Luna and everything, ya know what I mean?";
    text[959] = "Working for the Lunex Force requires a lot of hard work, combat training, dedication,";
    text[960] = "and.@P.@P.@P.@P.@P.@P.LOTS OF FOOD!";
    text[1105] = "Have you checked out the Regolithia BBS yet?";
    text[1106] = "It's pretty fun to look through all the posts!";
    text[1107] = "Don't tell anyone but, I'm the user: Melia.";
    text[1108] = "I lost my Hertz Cube a while ago and posted on the BBS to see if anyone found it.";
    text[1109] = "I'm not really looking for my Hertz Cube anymore though.";
    text[1110] = "So if you do happen to find it, feel free to keep whatever's inside!";
    text[1111] = "Hertz Cubes are usually locked. Do you have the key to unlock it?";
    text[1112] = "Oh wait, I forgot to mention I lost the key...";
    text[1113] = "So I'm not sure how you can open it... Good luck anyway though!";
    text[1862] = "Hey there Bella!";
    text[1863] = "Hi Richie! How's the music coming along?";
    text[1864] = "It's going pretty well!";
    text[1865] = "I've been thinking about going on a journey across Luna.";
    text[1866] = "I'm hoping it'll help inspire me to create some new tunes.";
    text[1867] = "Sounds fun! Your music is amazing!";
    text[1868] = "Thanks! I have a song to send you!";
    text[1869] = "I'll transfer the music file over to your Music Bot account.";
    text[1870] = "Oooo thanks Richie!";
    text[1871] = "If ya see me or my crew traveling around Luna, come say hi!";
    text[1872] = "We'll let you download new tracks on your Music Bot for free!";
    text[1873] = "You can listen to the songs on any Music Bot out there!";
    text[1874] = "Hey Bella! I've got some new tracks for you!";
    text[3270] = "Oooo, thanks Richie! Your music is amazing!";
    text[3271] = "I'm trying to recruit more musicians and artists for my band.";
    text[3272] = "Any luck so far?";
    text[3273] = "Not yet...";
    text[3274] = "Do you play any instruments, Bella?";
    text[3275] = "Nope...unfortunately.";
    text[3276] = "Can you sing?";
    text[3277] = "She can sing.";
    text[3278] = "Tetra! Okay, maybe a little... I'm just shy.";
    text[3279] = "Hahaha no worries. I was just curious.";
    text[3280] = "I should get going soon.";
    text[3281] = "There's musical inspiration around every corner!";
    text[6265] = "The door is locked from the other side.";
    text[6266] = "General Grey, we've got this area covered!";
    text[6267] = "Don't worry about us!";
    text[3888] = "Yesterday, I ordered some new plushies online!";
    text[3889] = "Oooo, which ones?";
    text[3890] = "It's a secret for now, haha. You'll see!";
    text[3875] = "My legs are killing me...";
    text[1785] = "I'm the caretaker here at the LSS.";
    text[1786] = "My main duties include cleaning, performing repairs, and general maintenance.";
    text[1787] = "That's nice and all, but my favorite part of the job...";
    text[1788] = "...is feeding Echo the Space Cat.";
    text[1789] = "Never thought there was a cat out there that enjoys space as much as Echo.";
    text[1790] = "Nobody knows where Echo came from or who its owner is.";
    text[1791] = "She has a collar but the owner contact name is smudged.";
    text[1792] = "She just showed up one day in a space suit and the rest was history.";
    text[1793] = "Bella! Welcome back to the Space Station!";
    text[1794] = "Hey Stella! Any new missions lately?";
    text[1795] = "A few, but we've got other squads assigned to them already.";
    text[1796] = "You should rest up on your day off!";
    text[1797] = "It's so hard to get you to take a break from your warrior duties!";
    text[1798] = "I know, I just can't help it, eheheh.";
    text[1799] = "Oh wow, did you get new plushies? THESE ARE SO CUTE!";
    text[1800] = "Oh yeah!";
    text[1801] = "I ordered some online and it turns out they accidentally sent me 2 of each!";
    text[1802] = "I can give you the extras if you'd like.";
    text[1803] = "I'll have someone deliver them to your room!";
    text[1804] = "YESSSSS! I can never say no to cute plushies! Thank you! Hehe.";
    text[1807] = "There's no new missions available at this time.";
    text[1808] = "I'll let you know if something comes up!";
    text[1827] = "Oh man, I've been holding it for so long...";
    text[1828] = "There's other available restrooms in the Space Station.";
    text[1829] = "No. It MUST be this one. I won't give up.";
    text[1830] = "I've already waited so long, I may as well wait a bit longer.";
    text[1890] = "Always be careful when flying your spaceship across Luna.";
    text[1891] = "The asteroid belt surrounding Luna can be pretty tough to navigate";
    text[1892] = "without a Pilot Assist System. Does your ship come equipped with one?";
    text[1893] = "My sidekick Tetra is actually my pilot!";
    text[1894] = "Really?! Wow, what an impressive robot!";
    text[1895] = "Heh, Impressive Sidekick Tetra has all sorts of tricks up her sleeve.";
    text[1956] = "Oh man, I finally saved up enough to get the Laser Barrage Active Skill.";
    text[1957] = "It was super worth it! Lasers are so cool...";
    text[1958] = "Lasers go pew pew!";
    text[2052] = "Hey kiddo, watch where yer walkin! I just cleaned the floors!";
    text[2053] = "Yer gettin' purple dust all over the place...";
    text[2054] = "Oh sorry! We'll be on our way now!";
    text[2055] = "(Purple dust... It's probably dust from the Phantom Realm...)";
    text[2056] = "(I need to wash my boots when I get the chance.)";
    text[2057] = "(I hope nobody else notices...)";
    text[2061] = "Did you know, the Murk Database is constantly updated with new entries?";
    text[2062] = "When you spot an undiscovered Murk, you can assign the Codename yourself!";
    text[2063] = "We knew that already.";
    text[2064] = "Yeah, we knew that already.";
    text[2065] = "Oh...";
    text[2157] = "Must remain calm. Must remain calm. Must remain calm. Must remain calm.";
    text[2158] = "(Is she okay?)";
    text[2159] = "(She seems super stressed. Let's leave her alone.)";
    text[2149] = "Our sun is a blue supergiant that is nearing the end of its life...";
    text[2150] = "What?! That's scary!";
    text[2151] = "Oh! I didn't mean to frighten you. Don't worry.";
    text[2152] = "It still has about 7 million years for it to live out its fiery existence,";
    text[2153] = "before it explodes into oblivion.";
    text[2154] = "...";
    text[2155] = "Sorry for the existential dread... When you study something your entire life,";
    text[2156] = "sometimes you wish you didn't know certain things. Ignorance is bliss.";
    text[7128] = "These alternate colored Murks...";
    text[7129] = "They don't just look different, they're stronger and faster as well!";
    text[7130] = "GRRRUUUUUUUGH!";
    text[7131] = "KHHHHAAAAA!";
    text[7132] = "This can't be a random occurence...";
    text[7133] = "I'm betting this is a targeted attack.";
    text[7134] = "Murks aren't known to appear all the way out here in space...";
    text[7135] = "They pretty much spawn down in Luna.";
    text[7196] = "Please be careful, Bella.";
    text[7197] = "I will, don't worry.";
    text[7198] = "I'll make sure Dad is okay and returns home safely.";
    text[7199] = "Ready to head to the Military Base, Myeh?";
    text[7200] = "Did you get what you needed from your room?";
    text[7201] = "Oh, not yet!";
    text[5665] = "Ohohoho!";
    text[5666] = "It's nice to see some fellow adventurers up here in Mt. Piton!";
    text[5667] = "Do you come here often?";
    text[5668] = "I come here every day! Ohohoho!";
    text[5669] = "It's a long hike from Silica, but it's worth it!";
    text[5670] = "Did ya know, Mt. Piton is the tallest mountain on Luna?";
    text[5671] = "Despite the frigid temperatures, the sun shines the brightest here.";
    text[5672] = "That's why they call it the 'Peak of Eternal Light'! Ohohoho!";
    text[7394] = "Let's leave her alone for now.";
    text[7395] = "What if she wakes up and tries to escape?";
    text[7396] = "I wouldn't worry about it. She's no longer a threat to us.";
    text[3126] = "Hey Zara!";
    text[3127] = "...Hi.";
    text[3128] = "Is something on your mind?";
    text[3129] = "I'm coming up with a new combo attack name.";
    text[3130] = "What do you think of Raining-Rock Fist?";
    text[3131] = "Elegant";
    text[3132] = "Meh";
    text[3133] = "Perfect.";
    text[3134] = "I have to make sure all of our attacks have cool names.";
    text[3135] = "Raine and Melody usually let me come up with our attack names.";
    text[3136] = "Hmm, back to the drawing board. Thanks.";
    text[3137] = "Melody, need a hand?";
    text[3138] = "Nope, I'm okay. Don't worry about us, Bella.";
    text[3139] = "We'll handle the Murks, you should focus on the Waterworks Network!";
    text[3140] = "Sup warrior prodigy. I'm on the lookout for the Murk Slayer.";
    text[3141] = "Stop calling me that!";
    text[3142] = "NEVER! Wanna spar? I'm itching to beat you!";
    text[3143] = "Now is NOT a good time, Raine.";
    text[3144] = "Fine, fine.";
    text[2796] = "Miss Bella, don't worry about the Murks, we'll handle them!";
    text[2797] = "Gosh darn, did these Murks drink some Ener-G before showin up?!";
    text[2798] = "They're way faster and stronger than the usual Murks we're used to.";
    text[2799] = "All this damage and chaos... Will it ever end?";
    text[2800] = "This is terrible... What could have caused such a large-scale outbreak...";
    text[2801] = "Have you seen any Filter Machines anywhere?";
    text[2802] = "Hmm. I believe there was one up north.";
    text[2803] = "It's near the Neural Links Shop!";
    text[2804] = "Miss Bella, we've evactuated everyone beyond this point.";
    text[2805] = "This area is closed off at the moment.";
    text[2806] = "KYAHAHAHAHAHGH!!";
    text[3320] = "The Murks outnumbered us...";
    text[3321] = "The Medical Team should be here soon! Stay strong!";
    text[3322] = "....";
    text[3323] = "I just scanned him. He's totally fine.";
    text[3324] = "Hey! Keep it down will you? You're gonna blow my cover.";
    text[3325] = "Th-these Murks are just too strong for me...";
    text[3358] = "Miss Bella, all the civilians have been successfully evactuated!";
    text[3359] = "We've also taken down all the Murks in the immediate area.";
    text[3360] = "It appears things have calmed down quite a bit.";
    text[3361] = "I've got some soldiers double checking to make sure there are no more Murks.";
    text[3362] = "Once we thoroughly investigate the extent of the damages,";
    text[3363] = "the civilians should be able to safely return to their homes.";
    text[3364] = "I'm exhausted...";
    text[3365] = "These Murks were stronger than we expected...";
    text[3366] = "I hate those Specter Murks... they have so much HP...";
    text[3367] = "Do you have any Skills or Lux Combos that can attack multiple enemies?";
    text[3368] = "No... No wonder I was having a hard time.";
    text[3369] = "This soldier is too tired to speak...";
    text[3370] = "Rest up. You did a great job!";
    text[3371] = "Some of our soldiers are with the Medical Team getting their wounds healed up.";
    text[3374] = "Why does this ALWAYS HAPPEN?!";
    text[3375] = "I finish my food and notice that the restroom is vacant.";
    text[3376] = "The waiter comes with my bill and then I see something dashing to the restroom.";
    text[3377] = "It happened so fast, all I saw was a blur.";
    text[3378] = "They needa hurry up, man... I've been waiting for 30 minutes!";
    text[3379] = "Uhm... Why don't you just knock? Let them know someone is waiting.";
    text[3380] = "Isn't that rude? I'd rather just wait...";
    text[3381] = "....Huh.";
    text[3388] = "See ya next time, warrior prodigy.";
    text[3389] = "Hey!";
    text[3415] = "Mommy look! It's our hero!";
    text[3416] = "Hello dear! Ever since you saved us from those Murks,";
    text[3417] = "my son can't stop gushing about how cool and heroic you were.";
    text[3418] = "You really inspired him to be brave, even in the face of danger.";
    text[3419] = "M-miss, I want you to have this.";
    text[3420] = "Obtained BERSERK BOY Plushie!";
    text[3421] = "You now have a new Plushie added to your room!";
    text[3422] = "Aw, thank you for the gift!";
    text[3423] = "It's my favorite plushie, hehe.";
    text[3424] = "Take care dear!";
    text[3425] = "Bye bye! Take good care of my plushie for me! Hehe.";
    text[3426] = "This kid's gonna grow up to be an electrifying warrior someday.";
    text[3427] = "I just know it.";
    text[3428] = "The Waterworks Building suffered the most damage today.";
    text[3429] = "The roof is a mess! What in the world happened up here?!";
    text[3430] = "Eheheh...";
    text[3456] = "(My gut is telling me Input 4 is Left...)";
    text[3457] = "Hmm? What am I mumbling about?";
    text[3458] = "(If she finds out... she might figure out the input code before me.)";
    text[3459] = "Your mumbling is very loud. You're practically saying your thoughts out loud.";
    text[3460] = "Crud. Pretend you didn't hear anything.";
    text[3461] = "My buddy won't tell you anything either. Hmph.";
    text[3453] = "While surveying the Eastern District, my buddy and I found a Locked Safe.";
    text[3454] = "I've tried so many combinations but I couldn't get it to open.";
    text[3455] = "However... I have a strong gut feeling that Input 3 is Down.";
    text[3390] = "The citizens of Copernicus are handling things surprisingly well,";
    text[3391] = "especially after everything that happened today.";
    text[3392] = "It's not uncommon to have things constantly go wrong on Luna.";
    text[3393] = "Most citizens, even at a young age, are trained to be able to deal with";
    text[3394] = "emergency situations and scenarios.";
    text[3395] = "We live on a beautiful silver satellite out in space after all.";
    text[3396] = "Before Murks, people had to worry about making sure Gravity and Oxygen Systems";
    text[3397] = "were maintained. ";
    text[3398] = "It was a constant battle to improve technology and make Luna a safer place to live.";
    text[3462] = "This outbreak has shown me just how much more I need to train.";
    text[3463] = "Have you seen the Raine Squad in action?!";
    text[3464] = "They were battling and defeating Murks left and right,";
    text[3465] = "all while making sure the citizens evactuated safely.";
    text[3466] = "I'd be content if I'm even half as strong as the Raine Squad someday.";
    text[3476] = "It's been a few hours since we opened the city back up.";
    text[3477] = "The highways and roads are still pretty empty.";
    text[3478] = "I guess it'll take some time for the city to be lively again.";
    text[3479] = "Saros advised us to patrol the city for a few more hours, just in case";
    text[3480] = "we missed some Murks. You never know what might set off another wave.";
    text[3481] = "Say what?! Not only were you tasked with restoring the Waterworks Network,";
    text[3482] = "you were also part of a secret operation to finally capture the Murk Slayer?!";
    text[3704] = "H-hey! You're that pink-haired Lunex Soldier! Miss Bella right?";
    text[3705] = "Yup, that's me. Have we met before?";
    text[3706] = "We haven't actually... I heard about you through my wife and son.";
    text[3707] = "You're the one that saved them from a group of Murks during the recent outbreak...";
    text[3708] = "I can't thank you enough!";
    text[3709] = "Ohh, it's no problem at all! I'm glad your family is safe now.";
    text[3710] = "I live in Copernicus and I commute to Tycho for work.";
    text[3711] = "When I heard the news, I was extremely worried...";
    text[3712] = "Thanks again Miss Bella! Take care!";
    text[3800] = "Why...";
    text[3801] = "I came all the way out here in hopes of finding an available restroom...";
    text[3802] = "Am I just doomed to wait for all of eternity?!...";
    text[3803] = "Uhm... Maybe you can do your business behind the tree?";
    text[3804] = "...and violate this sacred and beautiful land of lush nature?";
    text[3805] = "No thanks. I'll just wait...";
    text[3627] = "I wonder what it's like to fight a Warrior Type Vessel...";
    text[3628] = "Wait Tetra, don't get close!";
    text[3629] = "BATTLE MODE ENGAGED";
    text[3630] = "Oops...";
    text[3631] = "There must be a fault in the programming, it shouldn't see us as a threat!";
    text[3632] = "We have to disengage the Vessel!";
    text[3657] = "Lunex HQ has soldiers on-duty 24/7 to ensure proper security protocol is met.";
    text[3658] = "Be careful not to get too close to our Drones or Vessels.";
    text[3659] = "State your business, soldier.";
    text[3660] = "Oh... uh...";
    text[3661] = "We're just hanging out a bit. Should be okay, right?";
    text[3662] = "Negative. If you're off-duty, please leave the premises as soon as possible.";
    text[3663] = "(Sheesh. This guy follows protocol way too seriously.)";
    text[3664] = "(He's just doing his job. Let's keep moving.)";
    text[3665] = "Hoooot! Hoooot!";
    text[3670] = "For some odd reason, the Wasteland Zone has the highest Murk spawns on Luna.";
    text[3671] = "The Avirell are not usually aggressive,";
    text[3672] = "but there have been several cases where they attacked our soldiers.";
    text[3673] = "Uhm, your bullets don't seem effective...";
    text[3674] = "Look, I'm just trying to scare them off...";
    text[3675] = "Have you fought an Avirell before?";
    text[3676] = "They can create energy clones of themselves and they have this phasing ability,";
    text[3677] = "which makes them difficult to hit with our weapons.";
    text[3678] = "Hmm... I think your aim just needs work.";
    text[3679] = "Excuse me?! Why don't you shoot at it then?";
    text[3680] = "No thanks. I'd rather not.";
    text[3681] = "Good luck!";
    text[3682] = "...";
    text[3683] = "Did you know, when a Murk has the DRENCH STATUS EFFECT,";
    text[3684] = "your attacks towards that Murk will boost your LUX METER more than usual?";
    text[3685] = "They brought the Murk Slayer to the PRISON COMPOUND recently.";
    text[3686] = "General Saros instructed us to stay on high alert,";
    text[3687] = "in case he tries to make an escape attempt.";
    text[4044] = "We're trying to keep a low profile, remember?";
    text[4045] = "I dont think we should be going through this entrance right now.";
    text[4046] = "I think this door leads outside.";
    text[4047] = "Let's not go there right now... The guards might get suspicious.";
    text[4048] = "Wait! If we go any further the guards will see us!";
    text[4049] = "This area leads to the Prison Compound entrance.";
    text[4050] = "We need to go a different way!";
    text[4334] = "Nobody is allowed to enter the General's Quarters without explicit permission.";
    text[4335] = "This Military Base was built near the Crater of Eternal Darkness.";
    text[4336] = "It's the deepest crater on Luna.";
    text[4337] = "Light barely makes it to the bottom of the crater. I'm always scared to go there...";
    text[4363] = "Have you seen our Tank Type Vessel?";
    text[4364] = "It's slower than the Warrior Type, but it's also bulkier.";
    text[4365] = "The Tank Type Vessel is perfect for defensive combat.";
    text[4901] = "The mines here in Silica have been excavated for centuries.";
    text[4902] = "Each closed off mine had about 200 years of work put into it.";
    text[4903] = "Woah, it takes THAT LONG to dig as far down as we can?";
    text[4904] = "Well, yeah. Technology has come a long way, but no matter how much we improve";
    text[4905] = "our machinery, those darn bloodquartz crystals are a pain to mine.";
    text[4906] = "That's what makes 'em so expensive.";
    text[4907] = "The strongest mineral on Luna is also the hardest to excavate and process.";
    text[4908] = "I saw a bunch of Lunex Force drones flying above the colony earlier.";
    text[4909] = "Do you know what they're looking for?";
    text[4910] = "Probably Murks... eheheh.";
    text[4911] = "Hmm, haven't seen you around before. First time in Silica, eh?";
    text[4912] = "Yep!";
    text[4913] = "We've got a lot of miners, merchants, refugees and treasure hunters here.";
    text[4914] = "Everyone here is doing what they gotta do to survive.";
    text[4918] = "That's some valuable lookin' weapons you got there. What's your price?";
    text[4919] = "Uhm, they're not for sale. Sorry.";
    text[4920] = "Tch, well make sure you keep an eye on your valuables around here.";
    text[4921] = "You never know if thugs or bandits might be watchin'.";
    text[4922] = "Wait, there's bandits here?";
    text[4923] = "Scram kid. If you ain't sellin' nothin', I ain't interested.";
    text[4924] = "Hey! I'm the local History Teacher here in Silica. Did you know...";
    text[4925] = "Silica was one of the first colonies to be established here on Luna?";
    text[4926] = "The first settlers chose this region because we're actually within a";
    text[4927] = "massive lunar lava tube.";
    text[4928] = "Did you just say lava?! There's lava on Luna?";
    text[4929] = "Sure there is! If you dig far enough down, you'll find magma as well!";
    text[4930] = "Back then, the Astro-Barrier wasn't invented yet...";
    text[4931] = "...so the temperatures on Luna varied drastically during days and nights.";
    text[4932] = "Thankfully, the settlers discovered the lunar lava tubes here in Northern Luna,";
    text[4933] = "where there was warmer and more consistent temperatures,";
    text[4934] = "which made this region a suitable place to settle.";
    text[4935] = "Not many kids like Lunar History, but I think it's important for our kids";
    text[4936] = "to know how humanity ended up on Luna and survived here for all these centuries.";
    text[4939] = "There's a small community of Cycloids living here in Silica.";
    text[4940] = "My husband and I were originally living in Magnesia, our sister colony.";
    text[4941] = "Ever since the incident a few years ago, we were forced to relocate to Silica.";
    text[4942] = "...I'm sorry to hear that.";
    text[4943] = "Even though we lost our first home in the incident... we made a new home here.";
    text[4944] = "Some Cycloids though, weren't as fortunate as us...";
    text[4945] = "It makes me cherish every second I have with my family even more.";
    text[4946] = "Thanks for listening to me.";
    text[4947] = "I'm grateful to the Lunex Force and all you've done for us.";
    text[4948] = "No problem! If you need us, we'll be there to lend a hand!";
    text[4949] = "The Lunex Force strives to always protect and serve the People of Luna, heh!";
    text[4950] = "....";
    text[4951] = "I'm just about ready to set off on an expedition!";
    text[4952] = "Ohhh, where are you headed?";
    text[4953] = "I'm probably gonna check out some Loot Areas!";
    text[4954] = "What treasures will I find? Oh man, just the thought gets me excited!";
    text[7971] = "Darling, you look like you're running from something.";
    text[7972] = "Huh?! How can you tell?";
    text[7973] = "Well, you've got that vibe. I can see it in your eyes.";
    text[7974] = "Loosen up a little, will ya?";
    text[7975] = "Can't run away from your problems forever...";
    text[7976] = "Eventually you're gonna have to face them head-on.";
    text[7977] = "...and you...";
    text[7978] = "M-me?";
    text[7979] = "You've got a lot of grief in your eyes.";
    text[7980] = "I hope someday you're strong enough to overcome it.";
    text[8418] = "Hi! Do you like bunnies?";
    text[8419] = "Impossible... How can you not like bunnies...";
    text[8420] = "They're so fluffy!";
    text[8421] = "Awesome! Well then, this gift is for you...";
    text[8422] = "Axel and Hazel Plushies obtained!";
    text[8423] = "The plushies I gave you is from my video game titled, 'CODE Bunny.'";
    text[8424] = "Since you like bunnies, why not give my game a shot?";
    text[8425] = "Sure, I'd love to!";
    text[7920] = "I bet these boxes contain a bunch of plushies and collector's items.";
    text[7921] = "Well, you're absolutely right, Detective Tetra!";
    text[7922] = "I'm gonna install new shelves so I can display everything properly, hehe.";
    text[7926] = "It's a lavender teddy bear!";
    text[7927] = "I got this one from a gachapon machine!";
    text[7928] = "It's a classic brown teddy bear!";
    text[7929] = "I won this one from a claw machine at the arcade!";
    text[7930] = "Claw machines are so addicting...";
    text[7942] = "It's the most popular ergonomic gaming chair on the market!";
    text[7943] = "I SPENT ALL THIS MONEY AND MY BACK STILL HURTS! I DON'T GET IT!";
    text[7944] = "It's a super expensive, three monitor gaming set up.";
    text[7945] = "I bought the latest graphics card too, heheh.";
    text[7946] = "I gotta make sure I have the best possible performance specs so I can";
    text[7947] = "eventually reach the coveted Radiant Rank in the game I'm playing.";
    text[7941] = "Hey Bella, wanna be my new punching bag? BAHAHAHA!";
    text[7956] = "This bookshelf is filled with books about martial arts and meditation.";
    text[7958] = "It's cool that you read a lot of books, Zara!";
    text[7959] = "Reading helps me relax after a long day of training.";
    text[7960] = "You should try it sometime!";
    text[8456] = "So, what's your next destination?";
    text[8457] = "Hmm... I think I'll stop by the cafe in the Lunex Space Station next!";
    text[8458] = "I'm currently working on a bunch of new compositions with my music crew,";
    text[8459] = "inspired by my journey across Luna!";
    text[8460] = "In two days, we'll be showcasing our new music at Tycho Cafe!";
    text[8461] = "I hope to see you there!";
    text[8462] = "Hey you made it!";
    text[8463] = "Since everyone enjoyed my music so much,";
    text[8464] = "I've decided to settle here in Tycho.";
    text[8465] = "I'm going to pour my heart into performing and showcasing my music here!";
    text[8466] = "Thanks for all your support, Bella!";
    text[8467] = "Here's my latest music for you to download!";
    text[8488] = "I wouldn't go into the Storage Area if I were you...";
    text[8489] = "Why not?";
    text[8490] = "Apparently there's a rat infestation...";
    text[8523] = "Myeh! Over the years, we found a decent amount of glyphs and engravings";
    text[8524] = "left behind by the Ancients...";
    text[8525] = "It was actually enough to decode some of their language!";
    text[8526] = "Miss Nyla, do you think the Ancients might have";
    text[8527] = "some sort of connection to the Phantom Realm?";
    text[8528] = "This isn't really my area of expertise, dear...";
    text[8529] = "So I'm not really sure. Why do you ask?";
    text[8530] = "Hmm... Just a random thought...";
    text[8532] = "My job is to document the locations of each ancient artifact we discover.";
    text[8533] = "Excavating for ancient artifacts can be challenging!";
    text[8534] = "We often have to use delicate and precise instruments,";
    text[8535] = "to slowly break through the lunar soil, so that we don't damage the artifacts.";
    text[8536] = "So, what's your job?";
    text[8537] = "I uh...";
    text[8538] = "I'm in charge of bringing the donuts! D'oh!";
    text[8540] = "Wait!";
    text[8541] = "Let's not go into the Military Base right now.";
    text[8542] = "We don't know who is trustworthy yet...";
    text[8543] = "We should come up with a plan to stop Saros first!";
    text[8545] = "Hey uh... Did you hear any news about the Murk Slayer?";
    text[8546] = "Nah... I didn't get any news since he was first captured.";
    text[8547] = "Do YOU have any news?";
    text[8548] = "...Nope!";
    text[8549] = "Miss Bella, you're a high ranking Lunex Force official...";
    text[8550] = "Did you get any Code Purple Mission Reports recently?";
    text[8551] = "Low ranked grunts like me never get those...";
    text[8552] = "Oh uhm...";
    text[8553] = "...Nope!";
    text[8554] = "I see... Oh well.";
    text[8559] = "WHY ARE THESE GUYS STILL HERE?!";
    text[8560] = "...AND HOW DID NOBODY NOTICE?!";
    text[8561] = "How hard did you hit them, Tetra?";
    text[8562] = "Not THAT hard!";
    text[8565] = "Hey, this dude is napping!";
    text[8566] = "I mean...";
    text[8567] = "Guarding a prison with no prisoners must be a pretty boring job.";
    text[8596] = "I've always wondered why the soil in this Sector is brown...";
    text[8597] = "Oh, I know why!";
    text[8598] = "Silica was the first sector in which the Astro-Barrier was built and tested.";
    text[8599] = "The oxygen in the artificial atmosphere reacted to the mineral-rich Silican soil,";
    text[8600] = "and over time, the soil started to turn brownish in color!";
    text[8601] = "Wow, you're super smart!";
    text[8602] = "Heh.";
    text[8836] = "What's a Lunex Force punk like you doin' here?";
    text[8837] = "I heard there's a black market somewhere in here.";
    text[8838] = "I'd like to check it out.";
    text[8839] = "What are you planning? Hmm?";
    text[8840] = "Nothing. I'm just a potential customer.";
    text[8841] = "Alright, well...";
    text[8842] = "We got eyes on you, punk.";
    text[8847] = "My brothers and I...";
    text[8848] = "We used to work in the Lunex Force Weapons Development Team.";
    text[8849] = "I was in charge of developing powerful Upgrade Chips.";
    text[8850] = "One day, I realized the true potential of my talents...";
    text[8851] = "and quit the job to pursue my own business in the criminal underworld.";
    text[8852] = "I've been more successful running this black market business";
    text[8853] = "than I ever was workin' that stinkin' government job.";
    text[8854] = "You do realize that you just confessed to working with criminals, right?";
    text[8855] = "I don't care. You've got a lot of enemies hanging out here.";
    text[8856] = "This is their territory. I'd be careful if I were you.";
    text[8860] = "Anyways...";
    text[8857] = "My Upgrade Chips can't be found anywhere else.";
    text[8858] = "If you want to become more powerful than ever,";
    text[8859] = "I suggest you buy my products, heheheh.";
    text[8861] = "Hey, I've got some information that might be useful to you.";
    text[8862] = "Oh really? What is it?";
    text[8863] = "Are you serious?";
    text[8864] = "I'm not giving it away for free.";
    text[8865] = "Ahh, why am I not surprised...";
    text[8866] = "Give me 100 Skill Points and the information I know is yours...";
    text[8867] = "Do we have a deal?";
    text[8868] = "Bummer...";
    text[8869] = "Cool! Thanks for the Skill Points!";
    text[8870] = "Here's what I know: 102198.";
    text[8871] = "Knowledge is power. Use this information wisely.";
    text[8875] = "Hey, you don't have enough Skill Points...";
    text[8888] = "My favorite motto is: Work Hard, Snack Often!";
    text[8889] = "Here, this is for you!";
    text[8890] = "So, what's your favorite snack?";
    text[8891] = "Cheesecake Bars, of course!";
    text[8892] = "AHHHHHH! Same here!";
    text[8893] = "Fun Fact: I'm a part-time programmer as well.";
    text[8894] = "Here's a Cyber Cheesecake Bar for your robot pal!";
    text[8895] = "OH?! THIS CYBER CHEESECAKE BAR IS...";
    text[8896] = "DIGITALLY DELICIOUS!";
    text[8946] = "Ya found me just in time!";
    text[8947] = "What's a scientist like you doing here in Silica Mines?";
    text[8948] = "I'm researching and conducting time travel experiments!";
    text[8949] = "I built myself a secret lab down in these abandoned mine shafts.";
    text[8950] = "Think you could keep this a secret between us?";
    text[8951] = "Our lips are sealed!";
    text[8952] = "So, were you able to build a working time machine?";
    text[8953] = "It's still a work-in-progress.";
    text[8954] = "I'm retrofitting a DeLorean vehicle with a flux capacitor!";
    text[8955] = "That's so cool!";
    text[8956] = "Thanks! Your future is whatever you make it, so make it a good one!";
    text[8958] = "The nerve on this guy...";
    text[8959] = "How could he betray me after everything we've been through...?";
    text[8966] = "(She seems too distracted to notice us.)";
    text[8979] = "(Maybe we should leave her alone.)";
    text[8960] = "Can I help you?";
    text[8961] = "Oh... Uhm...";
    text[8962] = "Are you here to disrupt my plans?";
    text[8963] = "Are you someone I can use?";
    text[8964] = "Uhm... No?";
    text[8965] = "Then stay out of my way.";
    text[8967] = "I don't have the extra time or resources to spend on you.";
    text[8968] = "I need to stay focused and come up with a plan...";
    text[8969] = "I heard you took down the leader of the bandits, Kerberos.";
    text[8977] = "I was never strong enough to defeat Kerberos on my own so...";
    text[8978] = "Thanks for taking him down for me.";
    text[8970] = "I used to be a big-shot captain on his squadron.";
    text[8971] = "We made a great team. Everything was going well until...";
    text[8972] = "He betrayed me and exiled me from the organization.";
    text[8973] = "I'm glad he's out of the picture now.";
    text[8974] = "That traitor got what he deserved.";
    text[8975] = "...I think it's time for me to finally move on from this.";
    text[8976] = "Take care, warrior.";
    text[8980] = "Wow, your outfit is really pretty!";
    text[8981] = "Thanks, I made it myself.";
    text[8982] = "It's actually a hybrid cosplay from two of my favorite shows:";
    text[8983] = "Sailor Luna and Magic Cure!";
    text[8984] = "I'm a Vtuber as well, hehe.";
    text[8985] = "When I'm not working on cosplays,";
    text[8986] = "I spend my free time streaming fun video games!";
    text[8991] = "Hi! I'm Dashie the Cyber Bunny!";
    text[8992] = "...and I'm Tetra, the Cyber Sidekick! Hehe.";
    text[8993] = "Nice to meet you, Dashie!";
    text[8994] = "So, what's your specialty?";
    text[8995] = "I run an open-source library that manages matrices and vectors!";
    text[8996] = "Oooo I know a thing or two about matrices!";
    text[8997] = "I uh... I don't really know anything about programming so...";
    text[8998] = "I'll let you two chat while I look around the shop some more.";
    text[8999] = "Okiedokie!";
    text[9004] = "Glasses are a reflection of the wearer.";
    text[9005] = "Frame type? Lens? The way you push them up when they fall?";
    text[9006] = "All are fragments of the soul delicately assembled to wear on the face,";
    text[9007] = "like a transparent mask.";
    text[9008] = "You...";
    text[9009] = "What do you two think of glasses?";
    text[9010] = "Glasses are cool!";
    text[9014] = "...and they're stylish too!";
    text[9011] = "...!!!";
    text[9012] = "Brilliant!";
    text[9013] = "I see you two are fellow spectacle appreciators as well!";
    text[9027] = "Hey, I've seen you on TV!";
    text[9028] = "Aren't you Dycee from the children's show, Tinkerer's Lab?";
    text[9029] = "Yep, that's me! Nice to meet you.";
    text[9030] = "What's Tinkerer's Lab about?";
    text[9031] = "Well, the show is about teaching and encouraging kids to";
    text[9032] = "get excited about science and technology!";
    text[9033] = "In the show, Dycee and her Baby Grimrock, Peb,";
    text[9034] = "work together to create the 'Dycee Cube'.";
    text[9035] = "The funny part is, each and every iteration of the Dycee Cube";
    text[9036] = "never actually ends up looking like a cube.";
    text[9037] = "That's right! First it's a pyramid, then it's an octagonal prism,";
    text[9038] = "and then it's some 4D monstrosity of a shape...";
    text[9039] = "Finally, at the end of the segment, I yell,";
    text[9040] = "'HOW HARD IS IT TO MAKE A CUBE!'";
    text[9041] = "I see you're a huge fan of the show.";
    text[9042] = "I am! I used to watch it with my Mom every Saturday when I was little.";
    text[9043] = "You mentioned a baby grimrock... Is it actually a Murk?";
    text[9044] = "No, no. Peb is just a puppet!";
    text[9045] = "I've always been fascinated by Grimrocks and how they look...";
    text[9046] = "It ended up giving me inspiration to create my sidekick,";
    text[9047] = "Peb, the baby grimrock!";
    text[9048] = "I heard some people have seen alternate colored Grimrocks out there.";
    text[9049] = "I would love to see one someday...";
    text[9050] = "We've seen an alternate colored Grimrock before!";
    text[9051] = "Here, take a look at our DATABASE...";
    text[9052] = "Fascinating! A Grimrock-EX...";
    text[9053] = "It's not only a different colored variant,";
    text[9054] = "but its also faster and stronger than it's original counterpart!";
    text[9055] = "Hey, thanks for showing me this!";
    text[9056] = "You know what?";
    text[9057] = "You're a very cute robot, Tetra.";
    text[9058] = "I would love to invite you as a guest on our show someday!";
    text[9059] = "M-me? On a TV Show?!";
    text[9060] = "YES PLEASE! I WOULD LOVE TO!";
    text[9061] = "Did you talk to that eccentric santa lookin' gentleman in front of me?";
    text[9062] = "Apparently he's also the leader of a cult that believes zombies are trying";
    text[9063] = "to eat the sun... and the best way to stop this from happening...";
    text[9064] = "...is via copious amounts of chainsaws.";
    text[9065] = "HUH?! That's ridiculous! There is ZERO evidence of this...";
    text[9066] = "I know right! Eheheh... (Proceeds to hide cult membership badge.)";
    text[9069] = "I can feel it... There are forces beyond my comprehension...";
    text[9070] = "...preventing me from using any public restroom within my vicinity.";
    text[9071] = "How can I, a mere mortal, break free from this cruel fate?";
    text[9072] = "How about you use your restroom at home?";
    text[9073] = "It's gonna take me 4 Hours to drive home in this rush hour traffic...";
    text[9074] = "I'll just wait...";
    text[9075] = "The food here...";
    text[9076] = "It's delicious...";
    text[9077] = "...But it's not as good as the food I sell in my food truck.";
    text[9078] = "What's your signature dish?";
    text[9079] = "It's called Chunk.";
    text[9080] = "Take one bite of Chunk, and you'll feel like you could take down";
    text[9081] = "an army of zombies with a single finger!";
    text[9082] = "What even is Chunk? Is it a dessert? Is it savory?";
    text[9083] = "Chunk...";
    text[9084] = "...is simply Chunk.";
    text[9085] = "...";
    text[9219] = "As the lead medic for this sector,";
    text[9220] = "it's my job to tend to the injured... and there's always so many.";
    text[9221] = "We've been fighting the Murks for almost ten years now...";
    text[9222] = "What if our situation never changes?";
    text[9223] = "What if no matter how hard we try to survive,";
    text[9224] = "the Murks will just keep coming until we're all dead?";
    text[9091] = "Tell me... What are your thoughts on the Murks?";
    text[9092] = "Well, I don't see the Murks as mindless monsters.";
    text[9093] = "I personally struggle with the fact that I have to hurt these";
    text[9094] = "creatures in order to fulfill my duty as a protector of the people.";
    text[9095] = "I'm also aware that most people don't see things my way.";
    text[9096] = "From a civilian's perspective...";
    text[9097] = "The Murks have killed their friends and families...";
    text[9098] = "In their eyes... Murks are monsters that deserve no sympathy.";
    text[9107] = "...and then there's me...";
    text[9108] = "...a soldier who actually wants to find a way to communicate";
    text[9109] = "with the Murks to find a peaceful solution...";
    text[9110] = "...a solution where nobody has to die...";
    text[9101] = "Do you know anyone else that shares your perspective?";
    text[9102] = "Yeah, my mother felt the same way as I do.";
    text[9103] = "I see...";
    text[9225] = "You don't think it's possible, do you?";
    text[9226] = "I think you'd have better luck chatting it up with the sun.";
    text[9227] = "The Murks are beings made of Antimatter...";
    text[9228] = "They're essentially the complete opposite of humans.";
    text[9114] = "I don't believe the Murks are mindless...";
    text[9115] = "...but I also wonder, what good can actually come from communicating";
    text[9116] = "with creatures who are so fundamentally different from us?";
    text[9117] = "No matter how close and connected we become, I believe there's";
    text[9118] = "just some things that will always remain irreconcilable...";
    text[9229] = "That's fair. Even though I disagree,";
    text[9230] = "I still acknowledge and understand your perspective.";
    text[9231] = "I don't want you to think I don't value your opinion.";
    text[9232] = "Not at all. I'm glad we had this conversation.";
    text[9233] = "I want peace with the Murks, I really do.";
    text[9234] = "It's just...";
    text[9235] = "They're vastly different from us...";
    text[9236] = "I'm not sure if we'd be able to come to a mutual understanding.";
    text[9119] = "Wow, your battle armor looks really cool!";
    text[9120] = "Thanks!";
    text[9125] = "I've been working on several new armor designs that are integrated";
    text[9126] = "with cutting edge EM-Wave Technology.";
    text[9127] = "This tech would allow us to materialize our armors with a single thought!";
    text[9128] = "It should also give us a promising boost in speed and power.";
    text[9130] = "You'll be able to go buck wild out on the battlefield!";
    text[9129] = "Do you have a name for the battle armor you're wearing?";
    text[9122] = "I call this one, Battle Armor: Star Force!";
    text[9123] = "I call this one, Battle Armor: Gunvolt!";
    text[9124] = "I call this one, Battle Armor: Zero!";
    text[9131] = "Hey there! Don't mind me,";
    text[9132] = "I'm just waiting for the doctor to get back with my test results...";
    text[9145] = "Quick question...";
    text[9133] = "Do you ever have visions or dreams of what feels like past lives,";
    text[9134] = "ancestors, or things that could have been?";
    text[9135] = "I had a dream once, where I had an important role at a big company...";
    text[9136] = "...and every single person was a caveman!";
    text[9137] = "My great great great great great great great granddad";
    text[9138] = "must've done something really bad.";
    text[9139] = "He got covered in concrete by his employees as punishment!";
    text[9140] = "Power to the people! That's one vivid dream you had.";
    text[9141] = "Well, at least right now, you're living in the present and not doing...";
    text[9142] = "Whatever it was that you did in your dreams.";
    text[9143] = "Yeah... Anyways, thanks for taking the time to stop and chat with me.";
    text[9144] = "Take care!";
    text[9146] = "Hey, it's nice to see you again.";
    text[9147] = "How are you feeling?";
    text[9148] = "Hmm... I'm feeling a bit better now since I have company.";
    text[9149] = "My friends are stopping by soon.";
    text[9150] = "We're gonna watch the new Catastrophe Crew movie together!";
    text[9151] = "I hope it's good!";
    text[9152] = "Oh no, it's terrible!";
    text[9153] = "The studio had no idea what to do with it.";
    text[9154] = "But, it's going to be a good time since we'll be laughing at it together!";
    text[9155] = "Sounds like my kind of movie! Heh-heh-heh!";
    text[9156] = "Hey...";
    text[9157] = "Hey Cooper...";
    text[9158] = "I hope you had a good time with your friends!";
    text[9159] = "I did, thank you...";
    text[9160] = "It was a wonderful gift...";
    text[9161] = "I will... Cherish it forever...";
    text[9162] = "...";
    text[9163] = "Bella... Time is a precious thing.";
    text[9164] = "Time is a blessing.";
    text[9165] = "Please use the time you have wisely,";
    text[9166] = "and spend it with your friends and loved ones... before it runs out.";
    text[9167] = "And don't be afraid to give yourself a present from time to time.";
    text[9168] = "Just... let it happen.";
    text[9169] = "The bad news is, I'm dead...";
    text[9170] = "...but the good news is, I'm on a higher plane of existence within";
    text[9171] = "the hearts and minds of everyone I loved.";
    text[9172] = "Maybe one day, I'll come back as someone's vision.";
    text[9173] = "I really enjoyed your company, Bella.";
    text[9174] = "Thank you for spending your precious time with me.";
    text[9175] = "P.S.: On your travels, if you ever feel tempted to try something called 'Spice',";
    text[9176] = "...Please don't.";
    text[9241] = "Someone new. 0x77686";
    text[9242] = "What is this?";
    text[9243] = "I am... or I think I am...";
    text[9244] = "It's an old computer.";
    text[9245] = "It must have been lost back here for a very long time.";
    text[9246] = "Call me James King. 0xF6973";
    text[9247] = "Okay... Please tell me I'm not crazy...";
    text[9249] = "I've been hearing a strange voice ever since we entered this room...";
    text[9250] = "Where are you? Show yourself!";
    text[9251] = "I'm right in front of you. 0x66726";
    text[9178] = "Inside the computer?!";
    text[9252] = "Thats not possible!";
    text[9253] = "Now I remember. 0x9656E";
    text[9254] = "My life's work was Cyberworld transmission...";
    text[9255] = "It worked and I entered the Cyberworld... 0x646F7";
    text[9256] = "...but I became trapped and forgotten. 0x2666F";
    text[9248] = "That's terrible...";
    text[9180] = "I need to get out.";
    text[9181] = "I need... to be free. 0x653F";
    text[9182] = "(Something doesn't feel right... but I guess we should help...)";
    text[9183] = "Tetra, can you dive into the Cyberworld to help free James?";
    text[9184] = "Definitely! I'm on it!";
    text[9186] = "Would you like to enter the Cyberworld?";
    text[9187] = "JAMES: FOOLS. Now you're within my grasp!";
    text[9188] = "JAMES: First I will break your body!";
    text[9189] = "BELLA: Tetra, did you find James?";
    text[9202] = "JAMES: ...and then your MIND!";
    text[9190] = "TETRA: I did... It looks like...";
    text[9191] = "JAMES: Soon you will learn to embrace MADNESS";
    text[9192] = "like I have!";
    text[9265] = "TETRA: This guy...";
    text[9259] = "TETRA: HE KEEPS INTERRUPTING ME!";
    text[9193] = "TETRA: Now, where was I...";
    text[9257] = "TETRA: Looks like he's been infected by a Virus!";
    text[9260] = "BELLA: Is there a way to save him?";
    text[9261] = "TETRA: My Tetra Buster should be able to";
    text[9262] = "neutralize the Virus!";
    text[9264] = "I have to fight him!";
    text[9263] = "BELLA: Alright, be careful! You got this, Tetra!";
    text[9194] = "Thank you for saving me, Bella.";
    text[9195] = "I apologize for attacking you earlier...";
    text[9196] = "I spent so much time in the Cyberworld...";
    text[9197] = "...I lost myself in there.";
    text[9198] = "Please don't make the same mistake I did.";
    text[9199] = "Take care of yourself.";
    text[9201] = "There is no response...";
    text[9203] = "I've spotted a warrior!";
    text[9204] = "...which means you're a potential customer!";
    text[9205] = "What are you selling?";
    text[9206] = "A warrior's best friend... SKILL BOOSTERS!";
    text[9207] = "In order to achieve 100% Skill Mastery,";
    text[9208] = "you'll need to max out the levels of ALL of your Active Skills.";
    text[9209] = "In order to do that, you'll need SKILL BOOSTERS!";
    text[9210] = "Let me aid you on your quest to become the ultimate warrior!";
    text[9211] = "Even though I'm all out of Skill Boosters at this location,";
    text[9212] = "I've got employees in nine other locations!";
    text[9213] = "Some of them really like to set up shop in places you wouldn't expect...";
    text[9214] = "Good luck finding them all!";
    text[9215] = "I know exactly what you're looking for... SKILL BOOSTERS!";
    text[9216] = "Good luck on your journey to achieve 100% Skill Mastery!";
    text[9217] = "Do you have the 'goods'?";
    text[9218] = "I've got the goods.";
    text[9266] = "There is a total of 5 LUCKY EVENTS you can find!";
    text[9267] = "Keep an eye out for those shooting stars in the sky!";
    text[9268] = "'Ashe the Phoenix' Plushie obtained!";
    text[9269] = "You're starting to become quite the collector!";
    text[9270] = "Based on the size of your room, I'd say you'd be able to display";
    text[9271] = "up to 12 different plushies or collectables in total.";
    text[9272] = "That includes the Axsoul, Kame, and Metill plushies you gave me, right?";
    text[9273] = "Yup!";
    text[9274] = "The new plushie I ordered finally arrived!";
    text[9275] = "Let me guess...";
    text[9276] = "You got me one as well?";
    text[9277] = "We both know it's a tradition at this point, hehe.";
    text[9278] = "I absolutely love getting gifts for my friends!";
    text[9279] = "Here you go!";
    text[9280] = "I know too well how dangerous it can be to fiddle with something so volatile,";
    text[9281] = "such as Antimatter and Wormholes...";
    text[9282] = "My husband... He was one of the scientists that died when Celestia malfunctioned...";
    text[9283] = "I'm so sorry for your loss Miss Nyla...";
    text[9284] = "It's alright, dear...";
    text[9285] = "After years of therapy...";
    text[9286] = "I finally gained the courage to move on and accept the tragedy that occurred.";
    text[9287] = "But when I realized your father wanted to revive the project...";
    text[9288] = "I initially had doubts... I was afraid to lose another person I cared about...";
    text[9289] = "But... I think I should be approaching this with a more positive attitude.";
    text[9290] = "Cautious... but still positive.";
    text[9291] = "This time, I'll make sure we do things carefully... and properly.";
    text[9292] = "With no room for error!";
    text[9293] = "Coming up with an Anti Serum AND finishing Celestia in less than one year";
    text[9294] = "will be a huge undertaking... Myeh...";
    text[9295] = "Hey, I know you guys can do it!";
    text[9296] = "There's no problem the Lunex Space Station Science Team can't solve!";
    text[9297] = "Plus, you've got Nyla and my Dad to assist you.";
    text[9298] = "How's the progress on developing an Anti Serum?";
    text[9299] = "We haven't made much progress yet...";
    text[9300] = "Right now our technical specialists are extracting all the information they can";
    text[9301] = "from Saros' secret servers.";
    text[9302] = "A good scientist always keeps a detailed log of their experiments.";
    text[9303] = "Let's hope his logs have the information we need...";
    text[9305] = "When I got hired for this job, I never expected I'd be working on";
    text[9306] = "such a terrifying, yet fascinating piece of tech such as Celestia.";
    text[9307] = "...and I never expected we'd be dealing with a world-ending comet such as Coda...";
    text[9308] = "Ahh... Nothing like a refreshing cup of coffee to keep the mind stimulated.";
    text[9309] = "Dad... Your caffeine tolerance is so high because you consume so much of it.";
    text[9310] = "Maybe you should start drinking less coffee?";
    text[9311] = "I can't... I'll get astronomically painful headaches if I do...";
    text[9312] = "...and I can't deal with that while I'm working on the wormhole machine...";
    text[9313] = "Alright, well... Please take breaks once in a while, okay?";
    text[9314] = "That's what I'm doing right now actually!";
    text[9315] = "My current routine is: 23 hours for work and 1 hour for a coffee break, heh.";
    text[9316] = "WHAT ABOUT SLEEP?!";
    text[9317] = "WHAT ABOUT FOOD?!";
    text[9318] = "Hey, I'm just messing with you two!";
    text[9319] = "(...or maybe I'm not...)";
    text[9320] = "(I need to do what I can to protect my family and save humanity...)";
    text[9321] = "Dad, you were trapped in the Phantom Realm for a really long time...";
    text[9322] = "You should relax and rest for a couple of days.";
    text[9323] = "After everything that has happened,";
    text[9324] = "I think we all deserve a good rest before we get back on the grind.";
    text[9325] = "You're gonna be a busy woman!";
    text[9326] = "What do you mean?";
    text[9327] = "The People of Luna have sent us thousands of emails";
    text[9328] = "ever since we stopped Saros and revealed the truth of the Murks to the public.";
    text[9329] = "An overwhelming majority of the people have voiced their";
    text[9330] = "approval to elect you as their new General!";
    text[9331] = "Your mother and I... We're both proud of you.";
    text[9332] = "It has always been your destiny...";
    text[9333] = "...to lead the people of Luna towards a future filled with hope!";
    text[9335] = "Dad...";
    text[9336] = "Your encouragement means the world to me.";
    text[9337] = "I promise to be a leader the people can trust!";
    text[9338] = "But...";
    text[9339] = "I won't be able to do this alone...";
    text[9340] = "A good leader has a strong team!";
    text[9341] = "Nickle, would you like to be my Commander?";
    text[9342] = "M-me? A Commander of the Lunex Force?!";
    text[9343] = "Not just a Commander, but a reliable partner who I can trust.";
    text[9344] = "If we're going to save the people who've been turned into Murks,";
    text[9345] = "and stop Comet Coda, I'll need your support.";
    text[9346] = "I...";
    text[9347] = "I would be honored!";
    text[9348] = "That settles that then, hahaha!";
    text[9349] = "Now, Nickle...";
    text[9350] = "I must ask you an important question...";
    text[9351] = "...What is it, Doctor Thomas?";
    text[9352] = "Do you like coffee?!";
    text[9353] = "PLEASE TELL ME YOU DO!";
    text[9354] = "I do like coffee actually!";
    text[9355] = "PERFECT!";
    text[9356] = "Why don't we grab ourselves a cup of coffee down at the cafe,";
    text[9357] = "and have a nice chat?";
    text[9358] = "S-sure!";
    text[9359] = "Don't be nervous!";
    text[9360] = "My dad always makes an effort to get to know new team members!";
    text[9361] = "Have fun, you two!";
    text[9535] = "IMAGE TRAINING PROTOCOL INITIATED...";
    text[9536] = "PREPARING SOLID STATE HOLOGRAM GENERATORS...";
    text[9537] = "PLEASE SELECT YOUR DESIRED FOE...";
    text[9538] = "Raine Squad";
    text[9539] = "Murk Slayer";
    text[9542] = "What's going on?";
    text[9543] = "Former Commander, Vivia, escaped her prison cell...";
    text[9544] = "She left a note for you:";
    text[9545] = "Do not come looking for me.";
    text[9546] = "I need some time to reflect on my actions...";
    text[9547] = "I need some time to move on from these feelings of betrayal...";
    text[9548] = "...I deactivated my personal data servers so that Thomas' data analysts";
    text[9549] = "can extract any information that might be useful for creating an Anti Serum.";
    text[9550] = "There are secrets even Saros kept from me, so you'll have to figure out a way";
    text[9551] = "to access his experiment logs on your own.";
    text[9553] = "I hope you find what you need, Bella.";
    text[659] = "Man, I'm starving...";
    text[660] = "But I can't leave my post. I have a job to do!";
    text[661] = "At this rate, I'll die of hunger before we die from running out of oxygen...";
    text[662] = "Miss Bella, I have a favor to ask...";
    text[663] = "Do you mind getting for me a Crunch-E Bar?";
    text[664] = "They sell Crunch-E Bars at the cafe vending machines...";
    text[665] = "Please...I'll pay you double the amount it costs! I'm starving...";
    text[666] = "...Wait! You're telling me these were the last two Crunch-E Bars?!";
    text[667] = "I was... two Crunch-E Bars away from death...";
    text[668] = "Thanks so much Miss Bella! I only need one, so you can keep the other one!";
    text[669] = "I forgot how much these things cost. Like I promised, I'll pay you double.";
    text[670] = "How much was the Crunch-E Bar?";
    text[671] = "200 Bytes (Tell the truth)";
    text[672] = "1000 Bytes (Scam him...?)";
    text[673] = "25 Astrotech (Change Reward)";
    text[674] = "Only 200?! What a bargain!";
    text[675] = "You know what...here's 1000 Bytes instead. Thanks again Miss Bella!";
    text[676] = "1000?! Hmm...";
    text[677] = "I guess it makes sense. Due to high demand, people pay premium prices.";
    text[678] = "That's quite the alliteration tongue twister.";
    text[679] = "I wonder what that feels like... to twist your tongue.";
    text[680] = "Sorry to interrupt but... I only have 400 Bytes... Will that suffice?";
    text[681] = "It's okay. No worries! Eheheh...";
    text[682] = "Alrighty, here you go Miss Bella! Thanks again!";
    text[683] = "You received 400 Bytes!";
    text[684] = "Oh? You want 25 Astrotech instead? Sure, I can do that!";
    text[685] = "You received 25 Astrotech!";
    text[686] = "Mmmm... I'm in heaven. This Crunch-E Bar is delicious!";
    text[687] = "You received 1000 Bytes!";
    text[688] = "This vending machine sells Crunch-E Bars, a nutritious crunchy granola snack";
    text[689] = "that's covered with delicious dark chocolate drizzle.";
    text[690] = "It goes great with a hot cup of coffee!";
    text[691] = "There's only two left in the machine.";
    text[692] = "Would you like to buy one Crunch-E Bar? It costs 200 Bytes.";
    text[693] = "Oh? Two Crunch-E Bars dropped at the same time! It's your lucky day!";
    text[694] = "Unfortunately, the Crunch-E Bars are all sold out.";
    text[695] = "Not Enough Bytes!";
    text[718] = "Tjskdlf klskdjfl uhwpefj pylkjq.";
    text[719] = "Hi there! Uhm...";
    text[720] = "(Why isn't my Universal Translator working?!)";
    text[721] = "Bella, your U.T. Chip has been damaged during your battle with the Murks.";
    text[722] = "Tuowieh jlwknbl ieuohfo qpoufwef.";
    text[723] = "Uhm, I'm really sorry ma'am, I'm not fluent in Cycloid language.";
    text[724] = "Tetra, your Universal Translator works right?";
    text[725] = "Yup!";
    text[726] = "Rgjktg kjspfoy khklfsn rf jajaja";
    text[727] = "Huyhsajy ara ara lk jajaja";
    text[728] = "What did she say? What are you guys giggling about?";
    text[729] = "Heheh. Nothing. She's very funny.";
    text[730] = "Oh well... We can chat later, I have to get my U.T. Chip fixed first!";
    text[731] = "Take care!";
    text[732] = "Hello! I see you can understand me now hahaha.";
    text[733] = "Hi there! Sorry about that, my translator wasn't working.";
    text[734] = "Did you need help with something?";
    text[735] = "Oh no, not at all! I was simply saying hello!";
    text[736] = "Your little sidekick here is really cute!";
    text[737] = "I told her that your hair is beautiful and reminds me of Cotton Candy.";
    text[738] = "Aw, thank you!";
    text[739] = "And I said, your ponytail reminds me of soft serve ice cream! Hahaha.";
    text[740] = "I'll take that as a compliment, heheh.";
    text[741] = "You went out of your way just to be able to speak to me...";
    text[742] = "No worries! Communication is very important.";
    text[743] = "It helps us connect to one another and grow unbreakable bonds!";
    text[744] = "You're so kind. Here, take this for all your troubles.";
    text[746] = "How do you say 'Thank You' in Cycloid?";
    text[747] = "Qwerty!";
    text[748] = "Qwerty Qwerty!";
    text[749] = "Oh! Silly me, I bought a new U.T. Chip from Cypher earlier!";
    text[750] = "Let's see... I just replace the old one with the new one and... done!";
    text[8008] = "Hey, you're Bella Grey, right?";
    text[8009] = "I could really use your help right now...";
    text[8010] = "What happened?";
    text[8011] = "I was patrolling Mt. Piton when a massive Murk suddenly attacked me.";
    text[8012] = "While attempting to flee, I dropped my Gun Saber...";
    text[8013] = "I mean... I'm glad I made it out alive but...";
    text[8014] = "That Gun Saber I lost was very precious to me...";
    text[8015] = "It was a gift from my father.";
    text[8016] = "Without it, I can't seem to do my job properly...";
    text[8017] = "My colleagues told me to move on and use a new Gun Saber but...";
    text[8018] = "I can't bring myself to do it...";
    text[8019] = "I tried but... It just doesn't feel right.";
    text[8020] = "Hey, I get it. That Gun Saber meant a lot to you.";
    text[8021] = "We'll help you find it!";
    text[8022] = "Aw man, I really appreciate your help!";
    text[8023] = "I think I dropped my Gun Saber at the peak of Mt. Piton.";
    text[8024] = "Were you able to identify the Murk that attacked you?";
    text[8025] = "No... It wasn't in the database.";
    text[8026] = "It looked like a hybrid centaur wearing Vessel armor.";
    text[8027] = "I've never seen anything like it!";
    text[8028] = "Thanks for the details.";
    text[8029] = "We'll keep an eye out for that Murk while we look for your Gun Saber.";
    text[8030] = "Thanks, Miss Bella! I'll be waiting here.";
    text[8031] = "You found my Gun Saber! You really found it!";
    text[8032] = "Yep, and we defeated the Murk that attacked you as well!";
    text[8033] = "Mt. Piton should be safe to patrol again!";
    text[8034] = "That's such a relief!";
    text[8035] = "Please take this for your troubles, Miss Bella.";
    text[8036] = "It's the least I can do.";
    text[8037] = "A soldier without their trusty Gun Saber is like a pizza without cheese...";
    text[8038] = "You found Barry's Gun Saber!";
    text[1962] = "Oh man... Why did this have to happen...";
    text[1963] = "Hey Ouro, what's the matter?";
    text[1964] = "Oh, hey Bella! I was just going on my daily walk around the Space Station";
    text[1965] = "after I got some delicious coffee from the Lunex Cafe, and... well...";
    text[1966] = "I was carrying a loose folder full of my beloved LUX COMBO RECIPES...";
    text[1967] = "AND I LOST THEM ALL!... THIS IS TERRIBLE! I HAVEN'T MEMORIZED ANY OF THEM.";
    text[1968] = "Hey, don't worry Ouro, we'll help you find your LUX COMBO RECIPES!";
    text[1969] = "Really?! Oh man... Thanks so much for your help, Bella!";
    text[1970] = "How many Recipes do we need to find?";
    text[1971] = "I need you to find 7 LUX COMBO RECIPES around the Space Station.";
    text[1972] = "Where exactly did you walk around today?";
    text[1973] = "I literally walked everywhere... It could have fallen anywhere...";
    text[1974] = "Alright, it's okay. At least we know it's in the Space Station.";
    text[1975] = "Your coffee is gonna get cold, so stay here for now.";
    text[1976] = "Thanks again Bella!";
    text[1977] = "I left my CODEX at home so I couldn't register any of the recipes...";
    text[1978] = "I lost 7 LUX COMBO RECIPES around the Space Station in total...";
    text[1979] = "My specialty is gathering and researching LUX COMBO RECIPES!";
    text[1980] = "I love sharing the knowledge I acquire in hopes that it will";
    text[1981] = "help others try out new LUX COMBOS and get stronger!";
    text[826] = "You're a great warrior Bella! You should try out LUX COMBOS.";
    text[827] = "Once you fill your Lux Meter in Battle,";
    text[828] = "You can Stack 3 Skills together and unleash a LUX COMBO!";
    text[1982] = "Your Lux Meter fills up every time you strike the enemy or shield an attack!";
    text[829] = "LUX COMBOS are more powerful than if you use three skills individually.";
    text[830] = "Stacking three of the same skills usually results in a unique LUX COMBO.";
    text[831] = "You should try out different combinations!";
    text[832] = "Here's some recipes for you to try out!";
    text[1984] = "You found my LUX COMBO RECIPES! Thank you soooo much!";
    text[1985] = "You made my day Bella!";
    text[1986] = "As thanks, I'd like you to have one of my personal favorite Recipes!";
    text[1988] = "Thanks for helping me out!";
    text[8039] = "Hi there! I'm the science department's lead chemist,";
    text[8040] = "and I'm on a research mission to create the ultimate healing fluid!";
    text[8041] = "If you're free, I could use some extra hands. What do you say?";
    text[8042] = "Oooo, I wanna help! What do you need?";
    text[8043] = "My current experiment requires one ELIXIR and one REVIVAL FLUID!";
    text[8055] = "Once you've obtained one of each, bring them to me!";
    text[8044] = "Alright, you can count on Super-Chemist Tetra to get the job done!";
    text[8045] = "Here's the ELIXIR and REVIVAL FLUID you asked for!";
    text[8046] = "Wonderful!";
    text[8047] = "So, do you think you'll be able to create the ultimate healing fluid with these?";
    text[8048] = "Actually...";
    text[8049] = "It might take a couple of years to come up with the perfected chemical formula.";
    text[8050] = "Oh.";
    text[8051] = "Don't be discouraged! I'll get there one day. I'm sure of it!";
    text[8052] = "I just have to take things one step at a time.";
    text[8053] = "For now, please take this gift!";
    text[8059] = "Legend Ener-G and Holo Fluid obtained!";
    text[8054] = "One day, I'll finally create the ultimate healing fluid!";
    text[8056] = "I'm sure of it!";
    text[8057] = "Good luck on your research!";
    text[8058] = "Thanks!";
    text[8060] = "You look like someone who appreciates the beauty of nature.";
    text[8061] = "I do! I love exploring as well.";
    text[8062] = "Splendid! You've got a perfect resume, darling.";
    text[8090] = "You're hired! Ohohoho!";
    text[8063] = "Huh?!";
    text[8064] = "I'm looking for an assistant to help me with my botanical research.";
    text[8065] = "Murk sightings have increased lately, so it's been difficult to do field work.";
    text[8066] = "Your task is to document and collect samples of three distinct plant species";
    text[8067] = "that can be found on Luna.";
    text[8068] = "What are the species you're looking for?";
    text[8089] = "(AHHHH, I didn't sign up for this!)";
    text[8069] = "Don't worry darling, this is a paid position.";
    text[8070] = "You'll be rewarded handsomely for your efforts!";
    text[8071] = "(Did she just read my mind?!)";
    text[8072] = "Darling, your thoughts are written all over your face!";
    text[8073] = "I'm also really good at reading people, Ohohoho!";
    text[8074] = "Now, where was I...";
    text[8075] = "...Ah yes, the three plant species...";
    text[8076] = "First, I'll need a sample of a Lunar Camellia.";
    text[8077] = "Lunar Camellias are most commonly found in Regolithia, ohohoho!";
    text[8078] = "Second, I'll need a sample of Night Phlox.";
    text[8079] = "I believe Night Phlox grow in abundance in Copernicus, ohohoho!";
    text[8080] = "Lastly, I'll need a sample of Harmonia Coral.";
    text[8081] = "They're native to a place called 'Harmonia Reef' in Oceanus...";
    text[8091] = "(Ohohoho!)";
    text[8082] = "Hurry on now, darling! You've got a lot of samples to collect!";
    text[8083] = "(...and a lot of information to remember... Oh man...)";
    text[8084] = "If you forget the details of your task, just ask!";
    text[8085] = "Don't be shy now, darling, Ohohoho!";
    text[8086] = "Hey, I got the plant samples you requested.";
    text[8087] = "Spendid! Thanks for helping me with my research, darling!";
    text[8088] = "Here's your reward...";
    text[8092] = "You got 10,000 Bytes and a Gumdrop!";
    text[8093] = "Looking for another job? I've got plenty of work, darling!";
    text[8094] = "Uhm, maybe next time...";
    text[8095] = "(AHHHHHHHHH!)";
    text[8096] = "Ohohoho!";
    text[8097] = "Lunar Camellia obtained!";
    text[8098] = "Night Phlox obtained!";
    text[8099] = "Harmonia Coral obtained!";
    text[3309] = "Hey Bella!";
    text[3310] = "Have you been practicing your Lux Combos?";
    text[3311] = "Oh wow! You performed at least 20 Lux Combos!";
    text[3312] = "Impressive! Here's a new Lux Combo Recipe for you!";
    text[3313] = "The PWR of Holo Drain increases if you have more SHIELDS!";
    text[3314] = "Your LV also plays a role in boosting your damage!";
    text[3315] = "If you've performed at least 20 Lux Combos,";
    text[3316] = "I'll give you a new recipe I've been working on!";
    text[3317] = "If you go to the RECORDS MENU in your CODEX,";
    text[3318] = "you can see how many Lux Combos you've performed!";
    text[3431] = "Heheh. I defeated so many Murks today, I set a new S-Rank Record!";
    text[3432] = "Oh really? What's your record?";
    text[3433] = "I've got 9 S-Ranks so far.";
    text[3434] = "Impressive!";
    text[3435] = "Hmm... I can see the competitive fire in your eyes Bella.";
    text[3436] = "I doubt you could beat my Record but, lets say you get at least 10 S-Ranks...";
    text[3437] = "I'll give you a SKILL BOOSTER as a reward.";
    text[3438] = "Challenge accepted, heh.";
    text[3439] = "You're gonna have to prove to me you got at least 10 S-Ranks.";
    text[3440] = "You can check how many you have in the RECORDS MENU in your CODEX!";
    text[3441] = "Aw man! You beat my record...";
    text[3443] = "You're just as competitive as Raine.";
    text[3444] = "I believe competition can push us to do better!";
    text[3445] = "I'm also one of Raine's training partners.";
    text[3446] = "She always yells on about how badly she wants to clobber you in battle.";
    text[3447] = "I'm gonna become a warrior prodigy one day just like the two of you!";
    text[3448] = "Eheheh...";
    text[3442] = "Just you wait and see. One day I'll beat your S-Rank record!";
    text[3451] = "Here's the SKILL BOOSTER as promised.";
    text[3232] = "Looks like someone abandonded a perfectly good Cheescake Bar!";
    text[3233] = "HOW COULD ANYONE DO SUCH A HORRIBLE THING?!";
    text[3234] = "Don't worry, I'll make sure this Cheesecake Bar gets";
    text[3235] = "the proper attention and love it deserves! Heh.";
    text[3236] = "Huh?!";
    text[3237] = "Another abandoned Cheesecake Bar!";
    text[3238] = "Whoever bought all the Cheesecake Bars from the Vending Machine";
    text[3239] = "must have dropped one.";
    text[3240] = "Hmm...";
    text[3241] = "Let's check the other cafes.";
    text[3242] = "Is somebody doing this on purpose?!";
    text[3243] = "Maybe the culprit is trying to lure you with Cheesecake Bars.";
    text[3244] = "Well...";
    text[3245] = "...it's working!";
    text[3246] = "I need MORE! MORE! MORE!";
    text[3247] = "Hey, there's a note under this Cheesecake Bar!";
    text[3248] = "It just says, 'Tycho'.";
    text[3249] = "Let's check the cafe in Tycho when we get the chance!";
    text[3250] = "Okie! Cheesecake Detective Tetra is ready to crack this case!";
    text[8101] = "There's a note under this abandoned Cheesecake Bar as well! It says:";
    text[8102] = "'I'm so excited! You are indeed the perfect candidate!'";
    text[8103] = "'Please meet me in front of Cafe Copernicus.'";
    text[8105] = "Looks like we're worthy of meeting this mysterious person face-to-face!";
    text[8106] = "Let's go!";
    text[8107] = "Excuse me, are you the one who led us on a Cheesecake Bar hunt?";
    text[8108] = "Yup, that's me! My name is Melski.";
    text[8109] = "It's nice to finally meet you!";
    text[8110] = "You see, the reason why I put together this elaborate activity,";
    text[8111] = "is because I need the perfect taste tester...";
    text[8112] = "...Someone who truly understands and appreciates a good Cheesecake Bar.";
    text[8130] = "I'll never say no to Cheesecake Bars!";
    text[8131] = "Let's do it! What should I try first?";
    text[8113] = "Well, I'd like you to sample one of the Cheesecake Bars you've collected!";
    text[8114] = "Truth is, I baked them myself!";
    text[8115] = "AHHHHHHHHHHHH! MELSKI, IT'S DELICIOUS!";
    text[8116] = "It tastes even better than a regular Cheesecake bar!";
    text[8117] = "You've gotta tell me your secret!";
    text[8118] = "I'm really glad you like it!";
    text[8119] = "I've been working on this recipe for a while!";
    text[8120] = "My dream is to open my own vegan bakery someday.";
    text[8121] = "Well, as a fellow Cheesecake Bar expert,";
    text[8122] = "I'd say this is the best cheesecake I've ever tasted!";
    text[8123] = "When you get your bakery up and running... I'll be your #1 customer!";
    text[8124] = "That means a lot, thank you!";
    text[8125] = "Please take this, from one cheesecake fanatic to another.";
    text[8126] = "It makes me happy seeing other people enjoy my baking.";
    text[8127] = "Are you working on any new recipes?";
    text[8128] = "I'm currently working on a new recipe for delicious vegan brownies!";
    text[8129] = "Yum! Call me if you need a taste tester!";
    text[8142] = "Oh gosh, this is embarassing, my room is a mess right now!";
    text[8143] = "Ahh, don't worry about it, Melody!";
    text[8144] = "We're just stopping by to chill with you for a bit, heh.";
    text[8145] = "Is it just me or did you get new plushies?";
    text[8146] = "Yup! My collection has grown.";
    text[8147] = "Everything here is so...";
    text[8148] = "CUTE and FLUFFY!";
    text[8149] = "Collecting rare plushies and figures is my favorite hobby, heheh.";
    text[8150] = "Speaking of rare plushies...";
    text[8151] = "There's a super duper expensive plushie I've been trying to save up for...";
    text[8152] = "...and it releases in three days.";
    text[8153] = "The problem is... I don't have enough money saved up.";
    text[8154] = "If I don't buy the plushie as soon as it releases, it'll sell out FAST!";
    text[8155] = "I'll miss my chance to get it...";
    text[8156] = "Soooooooooo, I was wondering...";
    text[8157] = "If you'd be interested in buying some plushies off of me so I can";
    text[8158] = "save enough money for the rare plushie I've always wanted?";
    text[8159] = "Melody, of course I'll help you!";
    text[8160] = "I actually started collecting a few plushies myself lately.";
    text[8161] = "Yayyyy!";
    text[8162] = "Here are the plushies I'm selling... If you manage to buy them all,";
    text[8163] = "I'll have enough money saved up for the rare plushie I want!";
    text[8164] = "Yayyyy! You bought all of them! Thanks so much, Bella!";
    text[8165] = "Anything for my good friend, heheh.";
    text[8166] = "Here, you can have this as well!";
    text[8167] = "Hey Melody, what exactly is this plushie you've been wanting to get?";
    text[8168] = "It's a limited edition...";
    text[8169] = "10 foot tall Strawberry Scented Milky Plushie!";
    text[8170] = "Holy moly... That's massive!";
    text[8171] = "It comes with a built-in strawberry milkshake maker inside!";
    text[8172] = "I NEED IT! I NEED IT NOWWWWWW!";
    text[8391] = "Hey, uh...";
    text[8392] = "Hi, what's up?";
    text[8179] = "Are you a fan of ducks?";
    text[8180] = "I really hope so...";
    text[8181] = "I love ducks. They're super cute!";
    text[8182] = "Right?!";
    text[8183] = "Ducks are so adorable, chatty, and full of personality!";
    text[8184] = "They're so.@P.@P.@P";
    text[8185] = "S-sorry... I get very energetic whenever I talk about animals...";
    text[8186] = "...especially ducks.";
    text[8393] = "Uhm... anyways, my name is LO-Ogi.";
    text[8178] = "I'm an android and the proud owner of Kepler Ranch's bird sanctuary!";
    text[8187] = "Do you think you could help me with something...";
    text[8188] = "...duck related?";
    text[8206] = "Sure, what's up?";
    text[8190] = "I spend my free time reading about the historical beauty of";
    text[8191] = "Terra's wildlife prior to its destruction.";
    text[8189] = "It makes me truly appreciate the wildlife we have here on Luna.";
    text[8192] = "I've dedicated most of my operational lifetime towards keeping the";
    text[8193] = "animals in my sanctuary safe, happy, and healthy.";
    text[8194] = "With that being said, I'm ashamed to say.@P.@P.@P";
    text[8205] = "I'VE LOST MY DUCKS!";
    text[8195] = "Huh?! You've lost your ducks?!";
    text[8196] = "I've been taking care of 3 adventurous ducks who seem to have a";
    text[8197] = "bad habit of getting lost very easily.";
    text[8198] = "I don't blame them though... ";
    text[8199] = "They're very curious and eager to go on their own adventures!";
    text[8200] = "I let them roam free to do as they please because they always end up";
    text[8201] = "finding their way back home... except for today...";
    text[8202] = "I've been worried... I hope they're okay...";
    text[8203] = "Hey, we'll help you find your lost ducks! Don't worry!";
    text[8394] = "I kinda want to see how cute they are, too!";
    text[8204] = "Th-Thank you!";
    text[8207] = "Do you have any ideas on where your ducks could be?";
    text[8208] = "I lost a total of three ducks.";
    text[8209] = "One of my ducks really dislikes the cold...";
    text[8210] = "He wears a green scarf actually!";
    text[8211] = "I'm guessing he might be wandering around somewhere HOT.";
    text[8212] = "I've got another duck that loves chilling on skyscraper rooftops...";
    text[8213] = "So they're probably roaming around one of the cities.";
    text[8214] = "...and uh.. the third duck...";
    text[8215] = "She's the smartest duck I've ever taken care of...";
    text[8216] = "...and she specifically loves solving laser puzzles.";
    text[8217] = "Woah...";
    text[8218] = "Yeah... Like I said, ducks are full of personality!";
    text[8219] = "Thanks for the info, LO-Ogi.";
    text[8225] = "We'll find your ducks, I promise!";
    text[8173] = "Quack! Quack!";
    text[8174] = "You found one of LO-OGi's adventurous ducks!";
    text[8175] = "Quack! LO-Ogi is worried about you! It's time to go home!";
    text[8220] = "I'm so happy! All three of my ducks have returned!";
    text[8221] = "Thanks for helping me out!";
    text[8222] = "Oh, I should thank you with something...";
    text[8223] = "Hm...";
    text[8224] = "Ah, would you be happy with this?";
    text[8176] = "You got 200 Astrotech and a Gumdrop!";
    text[8226] = "Do you know what my name stands for?";
    text[8227] = "It's kinda weird...";
    text[8228] = "It stands for: Lunar Observer of OrGanisms.";
    text[8229] = "I uh... forgot what the 'i' at the end stood for.";
    text[8230] = "...but I don't think it's important.";
    text[8231] = "Thanks again for helping me find my ducks!";
    text[8232] = "Hey Zara, whatcha up to?";
    text[8233] = "I'm taking a small break from training in order to meditate.";
    text[8234] = "It's important to strengthen both your mind and your body.";
    text[8235] = "You got any new techniques or Lux Combos you've been working on?";
    text[8236] = "I could really learn a thing or two from you.";
    text[8237] = "Actually...";
    text[8238] = "I could say the same thing about you.";
    text[8239] = "I'd like to learn a few things from you as well.";
    text[8240] = "Huh?! M-me?";
    text[8241] = "Why not? You're a skilled fighter and I admire your talents.";
    text[8242] = "I'm sure you've come across a handful of Lux Combos that I don't know about.";
    text[8243] = "Here's what I propose...";
    text[8244] = "If you can show me that you've mastered at least 20 Lux Combos,";
    text[8245] = "I'll give you a new Lux Combo Recipe and...";
    text[8246] = "I'll even teach you how to use my Levistones as an added bonus.";
    text[8247] = "Deal!";
    text[8248] = "Hmm...";
    text[8249] = "Oh?!";
    text[8250] = "Interesting...";
    text[8251] = "That's definitely a unique combination of skills...";
    text[8252] = "Ahh... I see...";
    text[8253] = "If I do that then...";
    text[8254] = "Well now...";
    text[8255] = "Thanks to you, I've gotten a wave of inspiration for some new combos!";
    text[8256] = "As promised, here's a new Lux Combo recipe for you, Bella.";
    text[8258] = "We should do this again sometime.";
    text[8259] = "Definitely!";
    text[3713] = "Hey, what a cool robot!";
    text[3714] = "What's your name?";
    text[3715] = "Tetra!";
    text[3716] = "Nice to meet you Tetra!";
    text[8263] = "My name is Jason! I'm the owner of BlanK Robotics.";
    text[8295] = "Tetra... I can tell you've been expertly built.";
    text[8296] = "This metal alloy... These components... They're amazing!";
    text[8264] = "Do you mind if I examine your integrated battle weapons?";
    text[8265] = "I don't mind. Go ahead!";
    text[8266] = "Oh? Interesting!";
    text[8267] = "Have you ever considered upgrading your Buster Weapon?";
    text[8268] = "It looks like there's room for improvement in your circuitry!";
    text[3721] = "Oooooo, that would be awesome!";
    text[3722] = "An upgraded Tetra Buster = Better Sidekick, heh.";
    text[8269] = "What do you think, Bella?";
    text[8270] = "Its up to you, Tetra.";
    text[8271] = "The choice is yours!";
    text[8272] = "In that case... I say yes!";
    text[8273] = "I would love to get an upgrade!";
    text[8274] = "Awesome! Let me just double-check to see if I have all of the parts...";
    text[8275] = "Okay so...";
    text[8276] = "It's bad news... I don't have enough Core Gears.";
    text[8277] = "Are those Core Gears absolutely necessary for the upgrade?";
    text[8278] = "Of course! With the Core Gears, I'd be able to double...";
    text[8279] = "No... Quadruple Tetra's Base PWR!";
    text[8280] = "Bella, we should hurry and find some Core Gears...";
    text[8281] = "I really, really want this upgrade!";
    text[8282] = "Since you guys are going through the trouble of obtaining Core Gears,";
    text[8283] = "I'll give you a discount on my services...";
    text[8284] = "You'll get an upgraded Tetra Buster for the low price of 200 Astrotech!";
    text[8285] = "Alright, we have a deal.";
    text[8286] = "So, where can we find some Core Gears?";
    text[8287] = "Hmm... This might be a bit tricky. Core Gears are pretty rare!";
    text[8288] = "Do you know of any places that might have some spare machinery or parts?";
    text[8289] = "Hmm...";
    text[8290] = "Oh!";
    text[8291] = "Maybe we could look in the Storage Area in Regolithia?";
    text[8292] = "Great idea, Tetra!";
    text[8293] = "Alright Jason, we'll be back once we find some Core Gears!";
    text[8294] = "Awesome! See ya soon!";
    text[8297] = "You found some Core Gears!";
    text[8298] = "We got the Core Gears! Heh.";
    text[8299] = "Great! Do you have your payment ready as well?";
    text[8300] = "How much was it again?";
    text[8301] = "200 Astrotech for my professional Robo-Technician services!";
    text[8302] = "Yup, we have enough Astrotech!";
    text[8303] = "Awesome! Let's get this upgrade started!";
    text[8304] = "We don't have enough Astrotech...";
    text[8305] = "No worries, I can wait!";
    text[8306] = "I've got a business to run after all, hahaha.";
    text[8307] = "Upgrade Complete!";
    text[8308] = "Your Tetra Burst Support Skill's base PWR is now 200!";
    text[8309] = "This is amazing! I feel stronger already!";
    text[8310] = "Glad to hear it!";
    text[8311] = "Thanks for the business... and good luck on your adventure, Tetra!";
    text[8312] = "Business is kind of slow... But not for long!";
    text[8313] = "With more and more AI robots entering society,";
    text[8314] = "they'll need an expert robo-technician they can rely on!";
    text[8315] = "...and then BlanK Robotics will become the #1 Robotics Shop on Luna, hahaha!";
    text[8316] = "You mentioned there might be some Core Gears in Regolithia's Storage Area?";
    text[8317] = "Yup! We'll come back once we find some!";
    text[3726] = "Oh man... I'm so thirsty...";
    text[3727] = "Hey miss, could I ask for a favor?";
    text[3728] = "My throat is as dry as a desert right now and I can't leave my post...";
    text[3729] = "Do you think you could get me a Master Ener-G Drink?";
    text[3730] = "The better the Ener-G drink, the more refreshed I'll feel!";
    text[3731] = "If you don't have a Master Ener-G, a Super or Hyper Ener-G is fine too.";
    text[3732] = "Please... I'm so thirsty... I still have 6 hours left for my shift...";
    text[3733] = "Ahhh... crisp, cool, carbonated, refreshing, and hydrating!";
    text[3734] = "This Ener-G drink hits the spot!";
    text[3735] = "Which Ener-G Drink would you like to give me?";
    text[3736] = "Super Ener-G";
    text[3737] = "Hyper Ener-G";
    text[3738] = "Master Ener-G";
    text[3739] = "Hey, looks like you don't have any more of that type of Ener-G...";
    text[3740] = "Just come back to me when you have the Ener-G you want to give me.";
    text[3741] = "Awesome! Thank you so much!!";
    text[3742] = "Here, I'd like to offer you a reward for your troubles.";
    text[3743] = "Choose which reward you would like!";
    text[3744] = "1000 Bytes and 50 Astrotech";
    text[3745] = "50 Skill Points";
    text[3746] = "2500 Bytes and 100 Astrotech";
    text[3747] = "100 Skill Points";
    text[3748] = "5000 Bytes and 150 Astrotech";
    text[3749] = "150 Skill Points and 1 Soul Saver";
    text[3750] = "You received your selected reward!";
    text[3688] = "Hey there soldier! I'm one of several battle coaches for the Lunex Force.";
    text[3689] = "We love providing incentives for our soldiers to train more and get stronger!";
    text[3690] = "If you could show me that you've got at least 20 S-Ranks,";
    text[3691] = "I'll give you an Aqua Grenade Neural Link!";
    text[3692] = "You can check your number of S-Ranks in the RECORDS MENU in your CODEX!";
    text[3694] = "Oh my, looks like you have at least 20 S-Ranks!";
    text[3695] = "Keep up the great work soldier! Here's the Neural Link I promised.";
    text[3696] = "Our highest ranking battle coach has caught wind of your achievements.";
    text[3697] = "He's looking forward to meeting you someday!";
    text[3698] = "What S-Rank Record should I aim for next?";
    text[3699] = "The coach probably expecting an S-Rank Record of at least 50.";
    text[3700] = "Don't slack now! Keep up the momentum and you'll be the best warrior on Luna!";
    text[3770] = "Greetings!";
    text[3771] = "I am the ultimate Quiz Master, Mr. Infamous!";
    text[3772] = "I'm journeying across Luna to find someone who can surpass me in wits!";
    text[3773] = "Correctly answer all of my questions, and I'll give you an amazing prize!";
    text[3774] = "Would you like to challenge the Quiz Master?";
    text[3775] = "I have been defeated... Your wits are truly amazing.";
    text[3776] = "What is the name of the mysterious world behind the wormholes?";
    text[3777] = "Wave World";
    text[3778] = "Phantom Realm";
    text[3779] = "Distortion Dimension";
    text[3780] = "Incorrect! Better luck next time!";
    text[3781] = "What is the Sector Number for Regolithia?";
    text[3782] = "Sector 8";
    text[3783] = "Sector 14";
    text[3784] = "Sector 16";
    text[3785] = "Leveling up a Support Skill to LV 4 requires how many Skill Points?";
    text[3786] = "150 Skill Points";
    text[3787] = "125 Skill Points";
    text[3788] = "75 Skill Points";
    text[3789] = "How much HP does a RIPTIDE Murk have?";
    text[3790] = "300 HP";
    text[3791] = "225 HP";
    text[3792] = "250 HP";
    text[3793] = "Last Question: Who am I?";
    text[3794] = "Ugly";
    text[3795] = "The Ultimate Quiz Master!";
    text[3796] = "Quiz Lord, Mr. Famous!";
    text[3797] = "Here's your prize!";
    text[3799] = "Impressive! You've successfully completed my quiz!";
    text[8318] = "Well, well... Good to see ya, Warrior Prodigy!";
    text[8319] = "Heheheh!";
    text[8320] = "I know that look... That fire in your eyes...";
    text[8321] = "You know what? I've got some free time.";
    text[8322] = "I accept your challenge.";
    text[8323] = "Oh, you know me well, Bella.";
    text[8324] = "Meet me in front of Cafe Regolithia!";
    text[8325] = "...and get ready...";
    text[8326] = "TO BE CLOBBERED!";
    text[8327] = "I'm not losing this time! BAHAHAHA!";
    text[8328] = "Neither am I!";
    text[8329] = "See ya there, Raine!";
    text[8330] = "When my body is at its limit from training...";
    text[8331] = "There's only one thing left for me to do...";
    text[8332] = "...play video games! BAHAHAHA!";
    text[8333] = "Let's make things interesting...";
    text[8334] = "If you win, I'll teach you how to use my Blade Gauntlets.";
    text[8335] = "You'll basically learn a new Active Skill!";
    text[8336] = "...and if I win...";
    text[8337] = "Wait! Don't bother finishing that sentence.";
    text[8338] = "...cuz I'm going to win this duel anyways, heh.";
    text[8339] = "I see what you're doing...";
    text[8340] = "You're trying to get me all riled up!";
    text[8341] = "Well...";
    text[8342] = "IT'S WORKING!";
    text[8343] = "PUT UP THOSE FISTS AND FIGHT ME! BAHAHAHA!";
    text[8344] = "Aw crud...";
    text[8345] = "Alright, you win this time.";
    text[8346] = "That was fun!";
    text[8347] = "I couldn't have asked for a better rival.";
    text[8348] = "Here, take this...";
    text[8349] = "I'll be chilling back at my place.";
    text[8350] = "See ya later, Warrior Prodigy!";
    text[4067] = "You...";
    text[4068] = "You've made quite a name for yourself in the Lunex Force.";
    text[4069] = "I can tell just by looking at you, that you're a skilled warrior.";
    text[4070] = "...but are you good enough to impress me?";
    text[4071] = "Apologies. I haven't even introduced myself.";
    text[4072] = "The name's Pond...";
    text[4073] = "James Pond.";
    text[4074] = "I'm the highest ranking battle coach here at the Lunex Force.";
    text[4075] = "I turn weak and cowardly chumps into strong and capable fighters.";
    text[4076] = "Come back to me when you have at least 50 S-Ranks in your CODEX.";
    text[4077] = "If you complete my challenge, you'll be rewarded with something valuable.";
    text[4078] = "Only a few soldiers have been able to impress me...";
    text[4079] = "Do you think you have what it takes to be the best warrior on Luna?";
    text[4080] = "Looks like you got at least 50 S-Ranks.";
    text[4081] = "However... I'm still not impressed.";
    text[4082] = "It took us forever to get all these S-Ranks! What more do you want?!";
    text[4083] = "You only completed half of my challenge, soldier!";
    text[4084] = "Getting 50 S-Ranks proves your discipline and battle prowess.";
    text[4085] = "In order to complete the challenge, you must defeat me in a duel!";
    text[4086] = "Meet me in the Sewage Area. I'll get my Vessel ready for combat.";
    text[4087] = "Why not fight us without your Vessel?";
    text[4088] = "Beating an old man won't impress anyone.";
    text[4089] = "I've got combat experience and wit, but I lack physical strength.";
    text[4090] = "My Vessel makes up for that weakness tenfold.";
    text[4091] = "Vessel or not, we'll win! Heh.";
    text[4092] = "That's the spirit! See ya in the Sewage Area, soldier!";
    text[4093] = "There you are! Brace yourself, soldier. I won't go easy on you!";
    text[4094] = "Impressive!";
    text[4095] = "I haven't had a battle like this in a very long time! Bahahaha!";
    text[4096] = "Congrats, soldier! You've completed my challenge.";
    text[4098] = "If you equip the COST UPGRADE CHIP,";
    text[4099] = "it decreases the SP Cost of all your Active Skills by 5.";
    text[4100] = "Keep up the good work, soldier!";
    text[4882] = "Hey there! My name is Fortuno.";
    text[4883] = "I'm the leader of the Treasure Hunter's Guild here in Silica.";
    text[4884] = "You think you have what it takes to be a proper Treasure Hunter?";
    text[4885] = "Of course! Treasure hunting sounds fun! What do we need to do?";
    text[4886] = "Well, let's take things one step at a time.";
    text[4887] = "A proper Treasure Hunter has to have good field observation skills.";
    text[4888] = "Get out there and find out how many fires are lit here in Colony Silica.";
    text[4889] = "Come back to me once you know how many.";
    text[4890] = "So, how many fires are lit here in Colony Silica?";
    text[4891] = "Looks like your observation skills need some work. That's incorrect.";
    text[4892] = "That's correct! You passed your first trial!";
    text[4893] = "You're officially a rookie treasure hunter!";
    text[4894] = "The next trial is a bit more tricky... but let's save that for another time.";
    text[4895] = "Welcome to the Treasure Hunter's Guild! Here's a little something from me.";
    text[4896] = "Sure, Treasure Hunters love to collect rare and valuable items...";
    text[4897] = "but we also love the thrill of exploration!";
    text[4898] = "When you explore an area thoroughly, you can obtain valuable information";
    text[4899] = "that could potentially lead you to rare items, or even lost relics!";
    text[8007] = "The door opened with the SECRET KEY!";
    text[8351] = "Hey Fortuno, since we're all members of the Treasure Hunter's Guild...";
    text[8352] = "Do you mind sharing with us some info on any unsolved myths or mysteries?";
    text[8353] = "Oh? You youngsters are Rookie Level Treasure Hunters...";
    text[8354] = "Are you sure you're up for the challenge?";
    text[8355] = "Hell yeah we are!";
    text[8356] = "I've been treasure hunting long before I joined the guild.";
    text[8357] = "I like a good challenge. Hit me with your best scoop!";
    text[8358] = "Alright then, I've got one for you.";
    text[8359] = "Archeologists recently discovered an ancient tablet which described the";
    text[8360] = "existence of two legendary swords...";
    text[8361] = "The Relic Sword and the Excalibur.";
    text[8362] = "Not much is known about the Relic Sword...";
    text[8363] = "...However, we do have some information on the Excalibur.";
    text[8364] = "Records state that the sword is located somewhere south of Copernicus.";
    text[8365] = "Furthermore, in order to wield the Excalibur,";
    text[8366] = "the user must gather two ancient Keystones...";
    text[8367] = "...That's pretty much all I know.";
    text[8368] = "If you end up finding the Excalibur, come back to me!";
    text[8369] = "The Guild incentivizes our adventurers by offering rewards for those";
    text[8370] = "who can discover the most valuable treasures on Luna!";
    text[8371] = "Good luck on your Treasure Hunt!";
    text[8372] = "Thanks, Fortuno.";
    text[8373] = "So Nickle, where do we start?";
    text[8374] = "I'd say we should check out any loot areas we haven't been to yet.";
    text[8375] = "We have to find two Ancient Keystones first, and then the Excalibur itself!";
    text[8376] = "HELL YEAH! Man, I feel FIRED UP!";
    text[8377] = "(It's like he's a whole different person when treasure hunting is involved.)";
    text[8378] = "(Yeah, he's pretty much less grumpy.)";
    text[8379] = "What are you guys mumblin' about?";
    text[8380] = "C'mon, let's go find that legendary sword!";
    text[8381] = "Oh my, you really found it!";
    text[8382] = "...the legendary Excalibur! I'm beyond impressed!";
    text[8383] = "Well then, I do apologize for underestimating you earlier.";
    text[8384] = "You're not rookies...";
    text[8385] = "You might just be one of the best treasure hunters in our Guild!";
    text[8386] = "Heheh. Thanks, Fortuno.";
    text[8387] = "Now then, here's your reward!";
    text[8388] = "You got 10,000 Bytes!";
    text[8389] = "If I come across any info on undiscovered treasures,";
    text[8390] = "I'll be sure to let you youngsters know!";
    text[8400] = "You found an Ancient Keystone!";
    text[8401] = "There's one more left to find!";
    text[8402] = "Woah, the Keystones are glowing!";
    text[8403] = "Some ancient engravings popped up...";
    text[8404] = "Tetra can you translate this?";
    text[8405] = "Sure! It says...";
    text[8406] = "'When the two Keystones are reunited...'";
    text[8407] = "'The mirage shall disappear...'";
    text[8408] = "Hmm... The mirage shall disappear...";
    text[8409] = "I think it means we'll be able to find the location of the Excalibur!";
    text[8410] = "Fortuno said that it's located somewhere south of Copernicus on the world map!";
    text[8411] = "Let's zip!";
    text[8412] = "We did it! We finally found the legendary Excalibur!";
    text[8413] = "I uh.@P.@P.@P.";
    text[8414] = "I'm glad I was able to share this moment with you guys.";
    text[8415] = "Same here, Nickle.";
    text[8416] = "Yay! Three cheers, for a successful treasure hunt!";
    text[8417] = "Hell yeah! Let's head back to Silica and report to Fortuno!";
    text[8611] = "A group of Pyrowyrms have been plotting coordinated attacks on our soldiers.";
    text[8612] = "These Murks appear to be stronger than usual and are highly intelligent.";
    text[8613] = "We believe their next target is the Military Base.";
    text[8614] = "Your mission is to track down and defeat these Pyrowyrms!";
    text[8615] = "Head to Wasteland Zone 1 to speak with Damian for additional details.";
    text[8623] = "We're here to help with the Pyrowyrm Mission!";
    text[8624] = "What's the current situation?";
    text[8625] = "The Pyrowyrms have started their next coordinated attack.";
    text[8626] = "Our soldiers are currently fighting them in Wasteland Zone 2!";
    text[8627] = "Alright, we'll head there right away to provide backup!";
    text[8628] = "I see...";
    text[8629] = "I can't believe Saros would betray us like this...";
    text[8630] = "Some of my friends went missing a couple of weeks ago...";
    text[8631] = "Saros must have turned them into Murks as well...";
    text[8622] = "I hope we can figure out a way to revert the Murks back into humans someday...";
    text[8632] = "Until then, I would be happy to help you and your team in any way I can.";
    text[8633] = "Thanks, we're glad to have you on our side!";
    text[8634] = "Actually, there is something you can do...";
    text[8635] = "Gather as many soldiers as you can and tell them the truth about Saros.";
    text[8636] = "From now on, any Anticores you obtain must be preserved and kept safe!";
    text[8637] = "Roger that! I'll do my best!";
    text[8638] = "Before I forget, please take this!";
    text[8639] = "Backup has arrived! Let us take over from here.";
    text[8640] = "Alright... I'm gonna try to use my Soul Sensing...";
    text[8641] = "Please listen to me! There is no need to be hostile!";
    text[8643] = "You... can understand us...?";
    text[8644] = "I can!";
    text[8645] = "My Soul Sensing allows me to communicate with you!";
    text[8646] = "Our family... Saros has turned us all into Murks...";
    text[8647] = "He must pay for what he did...";
    text[8648] = "...for our pain and suffering...";
    text[8649] = "We... do not trust you...";
    text[8650] = "The Lunex Force... was supposed to protect the People of Luna...";
    text[8651] = "All of you have FAILED US!";
    text[8652] = "They're not listening...";
    text[8653] = "Saros must have given them a more refined version of his Murk Serum...";
    text[8654] = "Their Antimatter is heightening their feelings of fear and rage.";
    text[8655] = "We have to restrain them before somebody gets hurt!";
    text[8656] = "Alright... Let's gear up for battle!";
    text[8657] = "I'm sorry we had to do this...";
    text[8658] = "We'll keep your Anticores safe...";
    text[8659] = "...and I promise I'll find a way to reunite your family again someday.";
    text[8660] = "Let's go, Bella. We have to report back to Damian.";
    text[8616] = "We tracked down a group of Space Bandits who may have valuable intel";
    text[8617] = "regarding the location of their criminal organization.";
    text[8618] = "We have evidence to suggest that this criminal organization is connected to";
    text[8619] = "countless unsolved Missing Persons Cases that have been filed over the years.";
    text[8620] = "Your mission is to locate and infiltrate this criminal organization";
    text[8621] = "and arrest their nefarious leader!";
    text[8661] = "Hands up! By the authority of the Lunex Force, you're all under arrest!";
    text[8662] = "Hold on, Bella... Let me handle this one.";
    text[8663] = "Listen up!";
    text[8664] = "I don't know what crimes you've committed but, we're not here for you.";
    text[8665] = "We're here for your leader.";
    text[8666] = "Nobody here wants to spend their life in a prison cell so...";
    text[8667] = "Let's make a deal.";
    text[8668] = "Nickle, are you crazy?";
    text[8669] = "These guys are criminals!";
    text[8670] = "I got this.";
    text[8671] = "Look, we'll let you guys go if you tell us where your leader is...";
    text[8672] = "...no strings attached.";
    text[8673] = "Captain, what do we do?";
    text[8674] = "Hmm... This kid...";
    text[8675] = "I can smell a bad egg from a mile away.";
    text[8676] = "You're not like Miss Goody Two-Shoes right next to you...";
    text[8677] = "You're a criminal as well, aren't you?";
    text[8678] = "Bingo.";
    text[8679] = "I'm the Murk Slayer...";
    text[8680] = "The #1 target on the Lunex Force's most wanted list.";
    text[8681] = "That mask... This guy is the real deal.";
    text[8682] = "You're supposed to be in jail!";
    text[8683] = "How the hell did you break out?";
    text[8684] = "Miss Goody Two-Shoes helped me escape.";
    text[8685] = "Hey!";
    text[8686] = "So, do we have a deal?";
    text[8687] = "No deal!";
    text[8688] = "We would never betray our comrades or our leader.";
    text[8689] = "In fact, I've been stalling you this entire time.";
    text[8690] = "You fell for our trap! Hahahaha!";
    text[8691] = "What trap?";
    text[8692] = "While you were rambling on about your deal,";
    text[8693] = "we secretly activated the self-destruct sequence on this ship!";
    text[8694] = "Not again...";
    text[8695] = "You've experienced this before?!";
    text[8696] = "Unfortunately.";
    text[8697] = "These guys never listen.";
    text[8698] = "We're gonna have to fight!";
    text[8699] = "I thought resolving things through fighting was my thing,";
    text[8700] = "and talking it out was yours?";
    text[8701] = "Well, there's missing people out there that are counting on us to find them!";
    text[8702] = "Either we fight, or we miss our opportunity to get the information we need.";
    text[8703] = "Tetra, how much time do we have left?";
    text[8704] = "We have to defeat them within 5 Turns!";
    text[8705] = "Alright, these space bandits are going down!";
    text[8706] = "...Annnd self-destruct sequence deactivated!";
    text[8707] = "Crud... You guys are insanely strong.";
    text[8708] = "You should have accepted my deal when you had the chance.";
    text[8709] = "Even though we lost... We're keeping our mouths shut.";
    text[8710] = "In that case... Tetra, scan this ship for any clues that might help us.";
    text[8711] = "Scanning...";
    text[8712] = "Hey, this guy has something in his pocket!";
    text[8713] = "This Mine Key is used to open laser gates in Silica Mines!";
    text[8714] = "That must be where their hideout is!";
    text[8715] = "We've gotta head to Silica Mines ASAP! Let's zip!";
    text[8716] = "Tetra, scan their vitals!";
    text[8717] = "They're dead... Their wounds were too severe...";
    text[8718] = "Who could have done this?";
    text[8719] = "The traces of antimatter on their battle suits, the large bite wounds,";
    text[8720] = "and the thermal energy readings tells me we're probably dealing with...";
    text[8721] = "A Murk that can manipulate fire.";
    text[8722] = "...Like a Moleculoid?";
    text[8723] = "No, something even bigger...";
    text[8724] = "Let's keep our guard up in case the Murk shows up!";
    text[8725] = "Everyone, we came to get you out of here!";
    text[8726] = "It's the Lunex Force!";
    text[8727] = "Oh, thank heavens...";
    text[8728] = "I thought we were going to be trapped here forever...";
    text[8729] = "Please follow Tetra, and she'll escort you to safety.";
    text[8730] = "W-wait... The leader of the bandits...";
    text[8731] = "He's still out there...";
    text[8732] = "If he finds out we escaped... Our lives would be at risk...";
    text[8733] = "He'll just hunt us down again...";
    text[8734] = "Don't worry. After we get you out of here, we'll arrest the leader of the bandits,";
    text[8735] = "and we'll search for the rampaging Murk that dwells within these Mines as well.";
    text[8736] = "You'll be safe under our protection.";
    text[8737] = "Oh...";
    text[8738] = "You don't understand...";
    text[8739] = "The leader of the bandits... He IS the rampaging Murk.";
    text[8740] = "Wh-what?!";
    text[8741] = "Perhaps I can explain.";
    text[8742] = "Greetings. I am Kerberos...";
    text[8743] = "...leader of the space bandits.";
    text[8744] = "Took you long enough to find my hideout...";
    text[8745] = "Kerberos, why are you kidnapping people?";
    text[8746] = "These people are innocent! They haven't done anything wrong!";
    text[8747] = "It's all part of the job...";
    text[8748] = "...at least it was.";
    text[8749] = "Explain.";
    text[8750] = "For years, my bandits and I have been secretly working with General Saros...";
    text[8751] = "...abducting and kidnapping people for his experiments.";
    text[8752] = "So you know the truth about the Murks?";
    text[8753] = "I've known for a long time.";
    text[8754] = "Us bandits... We don't care about what's right or what's wrong...";
    text[8755] = "All we want is money and power.";
    text[8756] = "Saros gave us money... and promised us power.";
    text[8757] = "In exchange, we did all of his dirty work.";
    text[8758] = "Today... Saros paid me a visit...";
    text[8759] = "He said he no longer needed my services...";
    text[8760] = "...and he turned me into THIS...";
    text[8761] = "LOOK AT ME.";
    text[8762] = "I AM A MONSTER.";
    text[8763] = "You're a monster because you killed your own men.";
    text[8764] = "Funny thing is, I don't even remember doing it.";
    text[8765] = "When I became a Murk... everything was a blur...";
    text[8766] = "My mind was consumed with overwhelming pain and rage!";
    text[8767] = "It's taking every ounce of my strength just to speak with you!";
    text[8768] = "(The fact that Kerberos has the ability to speak...)";
    text[8769] = "(It means Saros' Murk Serum is close to being perfected...)";
    text[8770] = "You...";
    text[8771] = "YOU NEED TO FIX THIS!";
    text[8772] = "I'm sorry... We don't have an Anti Serum yet...";
    text[8773] = "Right now, we're unable to turn you back into a human.";
    text[8774] = "NO! NO! NO! I WON'T ACCEPT THIS!";
    text[8775] = "If this is something that can't be fixed...";
    text[8776] = "There's only one thing left for me to do...";
    text[8777] = "I will kill the man who turned me into this MONSTER...";
    text[8778] = "...AND I'LL KILL ANYONE AND EVERYONE WHO TRIES TO GET IN MY WAY!";
    text[8779] = "Bella, Kerberos' Antimatter levels are spiking!";
    text[8780] = "He's about to go on another rampage!";
    text[8781] = "Alright team, let's take him down!";
    text[8782] = "Saros... He's been working with criminals like Kerberos this entire time...";
    text[8783] = "Hey, let's not focus on Saros right now.";
    text[8784] = "We just stopped the criminal organization that was responsible for not only the";
    text[8785] = "Missing Persons Reports, but hundreds of other unsolved criminal cases as well!";
    text[8786] = "Now... we can focus on saving the innocent victims that have been turned into Murks.";
    text[8787] = "We're one step closer to justice!";
    text[8788] = "You know what?";
    text[8789] = "You're absolutely right.";
    text[8790] = "Great job, team!";
    text[1831] = "Up in space, our tongues don't make enough saliva for our tastebuds";
    text[1832] = "to work as well as they would on Luna.";
    text[1833] = "Thus, spicy food is very popular at the Lunex Space Station.";
    text[1888] = "Welcome to the Lunex Space Station!";
    text[1889] = "Lunex is actually short for Lunar Expedition!";
    text[1834] = "Before your father perfected the Gravity Generator,";
    text[1835] = "this cafe used to be covered in velcro EVERYWHERE!";
    text[1836] = "The velcro was used to keep things from floating away, including food!";
    text[1837] = "Bread used to be banned because the crumbs would get in people's eyes!";
    text[1896] = "I came to the LSS to service my Vessel but it turns out,";
    text[1897] = "they only do Hovercraft and Spaceship Service here.";
    text[1898] = "Apparently Vessel servicing is done at the Military base in Grimaldi.";
    text[1899] = "You'll meet all sorts of people out here at the Lunex Space Station!";
    text[1900] = "We've got scientists, chefs, engineers, musicians, artists... you name it!";
    text[1945] = "We're on security duty right now. It's actually a very easy job.";
    text[1946] = "The LSS is one of the safest places to work at. ";
    text[1947] = "There's hardly any crimes or concerning issues to worry about while on patrol.";
    text[1948] = "I just bought the Reflex Support Skill!";
    text[1949] = "A 10% chance for the Enemy attack to miss is pretty low odds...";
    text[1950] = "I'm gonna have to upgrade it with my Skill Points to get better use out of it.";
    text[1951] = "I think Reflex Level 5 is a 50% chance for the Enemy attack to miss.";
    text[1952] = "That's pretty good, considering it's a BLUE SUPPORT SKILL.";
    text[1953] = "It can help you out if you're in a pinch! ";
    text[1954] = "It also opens up your options to try out different RED SUPPORT SKILLS. ";
    text[1955] = "There's so many ways to customize your Skill Pool!";
    text[2047] = "Our brilliant blue sun is always a sight to behold.";
    text[2048] = "You can definitely get the best view up here at the Space Station, that's forsure.";
    text[2049] = "One downside though, is that the people living here have to take radiation medication.";
    text[2050] = "It's mainly to reduce the harmful effects of our blue sun on our bodies.";
    text[2051] = "Our universe is beautiful, but it is also dangerous.";
    text[2058] = "I heard there's an Abandoned Space Station somewhere out in space.";
    text[2059] = "Rumors say the scientists there were attacked 100 years ago by an alien life form.";
    text[2060] = "Who knows what really happened...";
    text[2066] = "The reason why we don't need an oxygen helmet out in the ship dock...";
    text[2067] = "...is because there's an atmospheric force field around the entire station!";
    text[2068] = "This atmospheric force field is called the Astro-Barrier!";
    text[2069] = "It also protects us from random space debris, like small asteroids and rocks!";
    text[2070] = "For larger debris, we usually vaporize them with our laser weapons.";
    text[2071] = "But if there was something even larger...";
    text[2072] = "...anyways I gotta get back to work soon.";
    text[2073] = "We study Murks here at the Space Station.";
    text[2074] = "Unfortunately, the samples we work with don't last very long...";
    text[2075] = "Murks aren't made of Matter like we are, so gathering data has been a very slow process.";
    text[2160] = "Fascinating...! A couple of months ago, we came across an ";
    text[2161] = "unknown interstellar spacecraft that contained a Golden Record.";
    text[2162] = "It took us a while to decode the entire thing, but we discovered that";
    text[2163] = "the Golden Record originated from a galaxy that is 2.5 million light years away from us.";
    text[2164] = "The Record contained images, music, sounds and greetings from a planet called 'Earth'.";
    text[2165] = "It took millions of years for this Record to reach us... ";
    text[2166] = "We do not know if their civilization is still around, but there's always hope.";
    text[2167] = "We're making efforts to communicate with the Earthlings as we speak.";
    text[2168] = "They'll definitely be happy to know that other intelligence is out there in the Universe.";
    text[2169] = "Let's hope this goes well.";
    text[2170] = "These are used for target practice! Don't get caught in the crossfire!";
    text[2171] = "I'm on day 29 of my 30 day Train-athon... Almost there... I'm so exhausted...";
    text[2172] = "Hyah! Take this! I'm gonna do it! I'm gonna make my dreams come true!";
    text[2173] = "This soldier seems hyper focused on training.";
    text[2174] = "The Botany Team is responsible for the study of plant biology in space.";
    text[2175] = "Our research helps us grow better and more nutritious food!";
    text[2176] = "I miss being able to go outside and experience nature.";
    text[2177] = "I have a passion for science and plants, which is why I love working here but...";
    text[2178] = "I'm feeling a bit nostalgic for the days when my family and I lived in Kepler Ranch.";
    text[2179] = "Fresh air... Beautiful trees and forests... It was a paradise.";
    text[2180] = "I'm an expert on Space Ships and Hovercrafts.";
    text[2181] = "I can tell you everything there is to know about them!";
    text[2182] = "For instance, every Space Ship has 3 modular parts that you can customize:";
    text[2183] = "There's SHIP FRAME, SHIP WING, and SHIP THRUSTER!";
    text[2184] = "When you purchase your first Ship Part, you'll unlock Space Ship Customization!";
    text[2188] = "Being able to change the color of your Space Ship will give it a fresh new feel!";
    text[2185] = "Once the World Map Warp becomes available, all you have to do is";
    text[2186] = "interact with the World Map Warp and select CUSTOMIZE SHIP!";
    text[2213] = "WELCOME TO THE BATTLE SIMULATION ROOM. HOW MAY I ASSIST YOU?";
    text[2214] = "BATTLE";
    text[2215] = "INFO";
    text[2216] = "NEVERMIND";
    text[2217] = "MY PRIMARY PURPOSE IS TO PROVIDE WARRIORS THE OPPORTUNITY TO ";
    text[2218] = "TEST OUT THEIR NEW SKILLS AND LUX COMBOS.";
    text[2219] = "IF YOU CAN DEFEAT ME IN BATTLE YOU WILL ALSO BE REWARDED WITH MONEY AND EXP!";
    text[2220] = "BATTLE MODE ENGAGED!";
    text[2221] = "VERY WELL. HAVE A SPLENDID DAY!";
    text[3385] = "Oh my the food here is delicious!";
    text[3386] = "Yep! Every Cafe has its own specialty!";
    text[3387] = "I heard Cafe Regolithia is pretty underrated, we should go there someday!";
    text[3405] = "Today was just too stressful! I need some comfort food to unwind...";
    text[3406] = "Thanks for visiting Cafe Copernicus!";
    text[3407] = "We hope you enjoyed your stay and thank you for your service!";
    text[3403] = "The frequent destruction the Murks cause has forced us to improve our";
    text[3404] = "construction technology. Now it only takes a few hours to repair our cities!";
    text[3467] = "Do you know about STATUS EFFECTS?";
    text[3468] = "When you STUN an enemy, you skip their Attack Phase for 1 Turn!";
    text[3469] = "When you BURN an enemy, it usually lasts for 3 turns.";
    text[3470] = "The burned enemy will lose 30 HP at the beginning of their Attack Phase.";
    text[3471] = "Wow, you've done your research!";
    text[3472] = "Hehe. My mommy is the Neural Link Trader, I learned everything from her!";
    text[3483] = "The city of Copernicus is built upon a 90 km lunar impact crater.";
    text[3484] = "Although it's one of the largest craters on Luna, it's certainly not the deepest.";
    text[3485] = "That title goes to Grimaldi: The Crater of Eternal Darkness, as we like to call it.";
    text[3486] = "There are parts of Grimaldi that are positioned so deep, sunlight never reaches there.";
    text[3487] = "The city life is great and all,";
    text[3488] = "but I think it's time I move to another sector.";
    text[3489] = "Kepler Ranch seems like a nice and peaceful place to live.";
    text[3473] = "The Lunex Force sent me over to make sure the Waterworks Network remains functional.";
    text[3474] = "I'm surprised your robot sidekick fixed the Network with such ease.";
    text[3475] = "Heh.";
    text[3666] = "I'm the CEO of the popular hair care product: Never-Bald!";
    text[3667] = "My life-long passion is to ensure my customers always have healthy, luscious hair!";
    text[3701] = "Business is always booming in Tycho.";
    text[3702] = "There's corporate offices, shops, merchants, restaurants...you name it!";
    text[3703] = "I personally enjoy checking out the shopping outlets and grabbing drinks at Tycho Cafe.";
    text[3717] = "My name is Zeek!";
    text[3718] = "I'm actually going to open up a Robotics Shop right behind me.";
    text[3719] = "We're still setting things up but we'll have our grand opening soon!";
    text[3720] = "I could upgrade Tetra's weapons so that her Tetra Burst is powered up!";
    text[3723] = "Here, scan my Comms Code and you'll be notified once the Shop opens!";
    text[3724] = "Scan Complete!";
    text[3725] = "Awesome! See ya at the grand opening!";
    text[3752] = "Tycho is one of the newer sectors built on Luna.";
    text[3753] = "As shocking as this might sound, Tycho is actually a mobile city.";
    text[3754] = "Huh? What do you mean by mobile?!";
    text[3755] = "The entirety of the city is modular, and built on a massive structure";
    text[3756] = "that can slowly move the entire city to a new location!";
    text[3757] = "It used to be in the southern-most sector on Luna.";
    text[3758] = "Why did the city have to relocate?";
    text[3759] = "Extremely harsh weather conditions had developed over time in the south.";
    text[3760] = "It made it really tough for the people of Luna to choose Tycho as a";
    text[3761] = "suitable place to settle, and so the city had to relocate.";
    text[3762] = "Woah... That's pretty cool!";
    text[3763] = "Would you like to hear a fun historical fact about Tycho?";
    text[3764] = "Here's another cool fact.";
    text[3765] = "The sky in Tycho is yellow tinted because the Astro-Barrier here";
    text[3766] = "was custom modified to be able to endure the harsh southern climate.";
    text[3767] = "Sure!";
    text[3768] = "Nah.";
    text[3769] = "No worries. Sorry to bother you...";
    text[3811] = "Our animals are located on a separate farm.";
    text[3812] = "We give 'em all the love, attention, and freedom they need to be happy and healthy.";
    text[3813] = "I'm looking for caterpillars and ants!";
    text[3814] = "Kepler Ranch is a great home for bugs, hehe.";
    text[3815] = "I want to collect them all!";
    text[3816] = "I'm trying to come up with cool attack names.";
    text[3817] = "My sister comes up with the best attack names!";
    text[3818] = "What's your signature attack?";
    text[3819] = "Dark Midnight Nova Punch, heh.";
    text[3820] = "Mine is Tetra Burst...";
    text[3821] = "It's not as cool as yours..";
    text[3822] = "Kamehameha!";
    text[3823] = "Special Bean Cannon!";
    text[3824] = "Volt Tackle!";
    text[3825] = "Wind Shuriken!";
    text[3826] = "Serious Punch!";
    text[3827] = "Kepler Ranch is just one of many farms within Sector 8.";
    text[3828] = "Each farm manages different aspects of food growth and production.";
    text[3829] = "I gotta give credit to the generations of botanists that helped";
    text[3830] = "pave the way for plant life to grow on Luna. It's honestly amazing.";
    text[3831] = "Kepler Ranch is like a home away from home.";
    text[3832] = "If y'all ever wondered what Terra was like a thousand years ago...";
    text[3833] = "Well... Kepler Ranch is the closest you'll get to a Terran landscape.";
    text[3834] = "Wood used to be pretty cheap ages ago.";
    text[3835] = "Nowadays, it's super expensive!";
    text[3836] = "That's understandable. There's not many trees on Luna.";
    text[3571] = "Ooo, isn't this Zara's house?";
    text[3572] = "Yep! She's not home right now, let's come back later.";
    text[3585] = "I heard eating these Mushrooms makes you grow really large.";
    text[3586] = "Huh?! Where did you hear this from?";
    text[3587] = "I have my sources, heh.";
    text[3594] = "Look, Bella! There are Cabbage, corn, pumpkins, and strawberries here!";
    text[3601] = "Raine lives in this apartment building right?";
    text[3602] = "Yep! She's not here right now though. Let's come back later.";
    text[3579] = "Oooo, Kepler Ranch has Lunar Panels too!";
    text[3611] = "Tycho Cafe is currently closed for renovation.";
    text[3612] = "Aww, I wanted to try their yummy food. Let's come back when they're open!";
    text[4338] = "I'm feeling a bit thirsty, but I could also go for a snack...";
    text[4339] = "What do you reckon I should get from the Vending Machine?";
    text[4340] = "Cheesecake Bar";
    text[4341] = "Master Ener-G";
    text[4342] = "Soulsaver";
    text[4343] = "Oh my! Looks like two fell out of the Vending Machine!";
    text[4344] = "Here, you can have the extra one!";
    text[4345] = "I reckon I should get back to work soon.";
    text[4346] = "A five minute break is more than plenty, hahaha!";
    text[4347] = "We've had fewer and fewer soldiers here in the Base recently,";
    text[4348] = "due to the increase in Murk spawns.";
    text[4349] = "Most soldiers are either patrolling a Sector, or collecting anticores.";
    text[4350] = "Lunex Force Jet Suits are made with the best military grade materials out there.";
    text[4351] = "After centuries of space travel, we finally have a space suit that's";
    text[4352] = "compact, flexible, durable, AND stylish if I do say so myself.";
    text[4353] = "Hey there!";
    text[4354] = "You look like you could use a new Support Skill to help you in battle.";
    text[4355] = "I'll sell you my Buster Plus Support Skill for 5000 Bytes.";
    text[4356] = "I'll be completely honest.";
    text[4357] = "I need the money to help pay for my son's hovercraft pilot lessons.";
    text[4358] = "He wants to join the Lunex Force someday!";
    text[4359] = "Wanna buy the Support Skill from me and help a dad out?";
    text[4360] = "Awesome! Thanks so much.";
    text[4361] = "I have to support my son's dreams in any way I can.";
    text[4915] = "Colony Silica sits on top of a massive bloodquartz deposit.";
    text[4916] = "Most of the resources we mine ends up going to the Lunex Force";
    text[4917] = "and the more wealthy Sectors in Central and Southern Luna.";
    text[4937] = "Dad's making me study Lunar History...";
    text[4938] = "He never stops talking about historical facts. He just goes on and on and on....";
    text[4955] = "I'm checking up on Silica's renewable energy reports.";
    text[4956] = "Silica is unique in the fact most of our energy comes from geothermal sources!";
    text[4957] = "We had to slow down our mineral harvesting due to the increase in Murks";
    text[4958] = "They really seem to like the heat down in the mines.";
    text[4959] = "The deeper you go, the more Murks you'll find.";
    text[3751] = "Wow! I can see Regolithia in the distance!";
    text[7948] = "Tycho Cafe is a great place for creative and talented individuals";
    text[7949] = "to gather thanks to our wonderful performance stage!";
    text[7950] = "We've always got a lineup of musicians, singers, comedians,";
    text[7951] = "artists, and dancers, ready to entertain!";
    text[8135] = "This is the black market, kid.";
    text[8136] = "You really shouldn't be here.";
    text[8137] = "However...";
    text[8138] = "Business is still business.";
    text[8139] = "I'm selling legally acquired Ship Parts...";
    text[8140] = "...with a huge emphasis on 'legally'.";
    text[8141] = "Either buy something, or scram!";
    text[8132] = "Hey there! I've got a few Ship Parts I'd like to sell.";
    text[8133] = "Check em' out if you're interested!";
    text[8134] = "Take a look!";
    text[8593] = "Here's some history for ya...";
    text[8594] = "The Kyrogates you see sprinkled throughout Luna,";
    text[8595] = "were once rest spots used by the Ancients during their long travels!";
    text[8812] = "In the year 20XX, the planetary catastrophe known as ASTRA, began.";
    text[8813] = "A mysterious comet made of antimatter was headed straight for our planet, Terra.";
    text[8814] = "After countless failed attempts at destroying the comet,";
    text[8815] = "Humanity decided that the best course of action was to flee Terra...";
    text[8816] = "...and set course for a one way trip to our moon, Luna.";
    text[8817] = "This unstoppable cosmic force of nature, Comet Coda,";
    text[8818] = "phased right through Terra, and left destruction in its wake...";
    text[8819] = "Billions of lives had been lost that day...";
    text[8820] = "Had it not been for our founders, the Seven Champions,";
    text[8821] = "...the entirety of humanity would have perished.";
    text[8822] = "Our story begins 1000 years later.";
    text[8823] = "Humanity continues to thrive on a now terraformed Luna.";
    text[8824] = "Although we live in a time where science and technology truly shines,";
    text[8825] = "...our resources here on Luna are limited.";
    text[8826] = "One day... We will run out of resources...";
    text[8827] = "One day... We might have no choice, but to find a new home again.";
    text[8829] = "Humanity's experience with Comet Coda and ASTRA are reminders...";
    text[8830] = "...that no matter what we face...";
    text[8831] = "Humanity has the determination and resilience to survive.";
    text[8832] = "What we must do...";
    text[8833] = "...is evolve past our limitations.";
    text[8834] = "It'll be my lifelong mission to ensure the future of humanity is bright.";
    text[8835] = "Until then, I will continue to move forward.\n-Saros";
    text[8843] = "Hey, are you interested in getting your hands on some rare goods?";
    text[8844] = "Just head to the portal located in the southern part of this Mine.";
    text[8845] = "My brothers and I run the black market there.";
    text[8846] = "They'll sell you some goods you've never seen anywhere else! Heheh.";
    text[8872] = "Huh? You want to know how to open the laser door behind us?";
    text[8873] = "Sorry, I'm just as clueless as you are, buddy.";
    text[8874] = "All I know is... some scary people come in and out through that door.";
    text[8876] = "Red Support Skills are powerful... but they have their limitations.";
    text[8877] = "You can only equip up to 3 Red Support Skills at any given time...";
    text[8878] = "...unless...";
    text[8879] = "You have the LEGEND UPGRADE CHIP!";
    text[8880] = "This upgrade chip will allow you to equip 5 Red Support Skills!";
    text[8881] = "...and it's yours on one condition...";
    text[8882] = "If you buy EVERYTHING my brothers are selling...";
    text[8883] = "You'll get the LEGEND UPGRADE CHIP free of charge.";
    text[8884] = "I see you've bought everything my brothers had in stock.";
    text[8885] = "You're officially our #1 black market customer, heheh.";
    text[8886] = "Here's a gift from us!";
    text[8887] = "Pleasure doing business with you, Miss Bella.";
    text[8897] = "It's late out there, so take it easy, okay?";
    text[8898] = "Won't do you any good to be working 'til you're tired.";
    text[8899] = "So stay and relax as long as you need to feel like yourself again, ya' hear?";
    text[8900] = "Nothing eases the soul like fresh cup of moon coffee.";
    text[8901] = "Hey wonderful you! Can you remember?";
    text[8902] = "Remember what??";
    text[8903] = "I can't remember...";
    text[8904] = "(Leave)";
    text[8905] = "I see you've forgotten. Don't worry, I never forget!";
    text[8906] = "You'll remember before the end who you truly are.";
    text[8907] = "Your memories will carry you to greater heights.";
    text[8908] = "So let them be your strength and guide you!";
    text[8909] = "...and always remember, never forget.";
    text[8910] = "I won't.";
    text[8911] = "You may have forgotten, but I'll remember.";
    text[8912] = "Be seeing you, friend.";
    text[8913] = "This next song is dedicated to Jack and Martha!";
    text[8914] = "This door requires a special key to open...";
    text[8915] = "You used the Mine Key to open the door!";
    text[8933] = "Bonjour! Let's see how long it took for you to reach me...";
    text[8928] = "Your journey to get to me was FAST.";
    text[8929] = "A little too fast...";
    text[8930] = "I'm guessing you're either a time traveler or a code breaker.";
    text[8931] = "Either way, congrats on reaching me in record time!";
    text[8932] = "This is the best possible title I can grant you!";
    text[8934] = "Incroyable! You managed to reach me in under 3 Hours!";
    text[8935] = "I shall grant you the title of: Master Speedrunner!";
    text[8936] = "Impressionnant! You managed to reach me in under 8 Hours!";
    text[8937] = "I shall grant you the title of: Novice Speedrunner!";
    text[8938] = "Amusant! I see you like to take your time...";
    text[8939] = "...savoring every moment...";
    text[8940] = "...immersing yourself in this beautiful world...";
    text[8941] = "A person like you deserves the honorable title of: Lunar Explorer!";
    text[8942] = "Maybe in another timeline, you might've been granted a different title...";
    text[8943] = "Who knows? It all depends on how long it takes for you to reach me.";
    text[8944] = "Au revoir!";
    text[8945] = "It's a strange hourglass. You decide to flip it over...";
    text[8987] = "Bummer... The Murks decided to attack the city on my day off.";
    text[8988] = "Man, I need a drink.";
    text[8989] = "Now that the city is finally up and running again,";
    text[8990] = "I'm probably gonna chill at the cafe for the rest of the day.";
    text[9015] = "Hey there, I'm Xiu.";
    text[9016] = "I'm a weapons designer from Division 7.";
    text[9017] = "General Saros was so impressed by my designs, he transferred me";
    text[9018] = "to this branch so I could help develop new Murk hunting weapons.";
    text[9019] = "This blade I'm working on is a prototype Holo-Blade.";
    text[9020] = "Theoretically, it should be able to slice through a Murk";
    text[9021] = "without damaging their Anticore.";
    text[9022] = "This'll make Anticore extraction so much easier!";
    text[9023] = "Hey, what're ya doin' loafin' around?";
    text[9024] = "Make yourself useful and get back to guard duty!";
    text[9025] = "This guard's serious demeanor is unwavering.";
    text[9026] = "He stares at you with cold, unblinking eyes...";
    text[9000] = "Hi there! Call me MiDi!";
    text[9001] = "I'm the best robo-bunny DJ in this city!";
    text[9002] = "Here's a demo of my upcoming album!";
    text[9003] = "C'mon let's vibe!";
    text[900] = "Meow!";
    text[901] = "Ohhh it's Echo! Hi cutie!";
    text[902] = "Kitty cat!";
    text[903] = "Meow Meow!";
    text[904] = "Echo gave you 10,000 Bytes!";
    text[905] = "This is Echo the Space Cat.";
    text[906] = "She's the pet cat aboard the Lunex Space Station.";
    text[907] = "Echo absolutely LOVES to venture out into space.";
    text[908] = "She can also be found as a rare encounter in certain areas in Luna!";
    text[1806] = "Echo contemplates while gazing off into space with starry eyes.";
    text[1342] = "Network Link Established!";
    text[1343] = "Reach_the_end_of_the_stage_to_reboot_the_network!";
    text[1344] = "Watch out for Viruses and stage hazards!";
    text[1345] = "If Tetra loses all her lives,";
    text[1346] = "the reboot will fail.";
    text[1347] = "Use your Tetra Buster to delete enemy Viruses!";
    text[1348] = "Network Rebooted!";
    text[1349] = "Retrieving Exit Link...";
    text[1350] = "Tetra.EXE Exit Link Established!";
    text[1351] = "Reboot Failed...";
    text[4033] = "Bella,_this_stage_is_full_of_firewalls!";
    text[4034] = "Shooting_at_firewalls_will_consume_firewall_ammo.";
    text[4035] = "Keep_in_mind,_we_only_have_a_limited_amount_of_ammo!";
    text[4036] = "One more thing!";
    text[4037] = "Shooting at Viruses won't consume firewall ammo.";
    text[4038] = "You can restart the stage if you get stuck!";
    text[4039] = "The_Shut_Down_Protocol_is_at_the_end_of_the_stage!";
    text[4040] = "If_we_shut_down_the_sewer_network,_the_laser_doors";
    text[4041] = "will deactivate! Let's go go go!";
    text[4042] = "Network Shut Down Protocol Success!";
    text[4043] = "Network Shut Down Protocol failed...";
    text[5342] = "Bella, this stage is one network with";
    text[5343] = "multiple access points from Copernicus!";
    text[5344] = "We have to press four switches in total";
    text[5345] = "to be able to reboot the Waterworks Network!";
    text[5346] = "If you get stuck, look for an exit warp!";
    text[5347] = "We can always find another access point from";
    text[5348] = "a different Filter Machine in Copernicus!";
    text[5350] = "Viruses have taken over this Network!";
    text[5351] = "We have to delete all the viruses in order";
    text[5352] = "to remove the firewall and reboot the network!";
    text[5353] = "Watch out for stage hazards as well!";
    text[4803] = "Tetra, isn't this the same robot we saw in Regolithia?";
    text[4804] = "Digit! His name is Digit!";
    text[4805] = "Glad to see Digit was able to make it back home.";
    text[4806] = "I wonder what he was doing out in Regolithia anyways?";
    text[4807] = "01101000 01100101 01101100 01110000";
    text[4808] = "01110110 01101001 01110010 01110101 01110011";
    text[4809] = "Hmm hmm... I see.";
    text[4810] = "What is Digit saying?";
    text[4811] = "Digit's AI Network has been infected with a Virus.";
    text[4812] = "He's asking for our help!";
    text[4813] = "Aw, poor thing... Don't worry Digit, we'll help you out!";
    text[4814] = "Tetra, we need to destroy the Virus that's infecting Digit's network.";
    text[4815] = "Should I dive into Digit's AI network?";
    text[4816] = "Our goal is to find and defeat";
    text[4817] = "the Virus that's infecting Digit!";
    text[4818] = "Once_we_beat_the_virus,_we_can_reboot_digit's_network!";
    text[4819] = "Keep an eye out for stage hazards! Let's go!";
    text[4876] = "BEEP BOOP.";
    text[4877] = "THANK YOU FOR HELPING ME!";
    text[4878] = "PLEASE TAKE THIS, BEEP BOOP.";
    text[4880] = "DIGIT IS VERY GRATEFUL, BEEP BOOP.";
    text[4881] = "NOW DIGIT CAN GO BACK TO DATA MINING.";
    text[751] = "People can download all kinds of knowledge into their brain, but...";
    text[752] = "What matters most, is how you apply that knowledge. Always keep that in mind.";
    text[753] = "Hey! I've seen you before at the Lunex Space Station.";
    text[754] = "You must be Dr. Thomas' kid. Nice to meetcha!";
    text[755] = "I specialize in Neural Links!";
    text[756] = "What are Neural Links?";
    text[757] = "Do you have one?";
    text[758] = "Not interested.";
    text[759] = "Neural Links are the latest in Mind Emulation Technology!";
    text[760] = "Essentially, they allow you to download information into your brain.";
    text[761] = "Educators in some schools distribute Neural Links,";
    text[762] = "and warriors can use them to learn new skills and techniques!";
    text[763] = "The technology is quite remarkable!";
    text[764] = "I do! They're quite expensive, but I can sell this one to you at a discount.";
    text[765] = "Just 1500 Bytes will do!";
    text[766] = "I'll buy it!";
    text[767] = "No thanks.";
    text[768] = "Awesome!";
    text[769] = "Make sure to manage and equip your Support Skills in the Support Skills Menu!";
    text[770] = "Ah...wait just a minute! You don't have enough Bytes!";
    text[771] = "Alrighty, see ya!";
    text[3547] = "I've got a ARMOR UPGRADE CHIP I'm lookin' to sell.";
    text[3548] = "The ARMOR UPGRADE CHIP is an upgrade chip you can equip from your ITEMS MENU.";
    text[3549] = "If equipped, your MAX HP will increase by 200!";
    text[3550] = "A rare currency for a rare item. How does 80 Skill Points sound?";
    text[3551] = "Make sure to equip the ARMOR UPGRADE CHIP from your ITEMS MENU.";
    text[3553] = "Hey, I ain't playin' around kid. Come back when you have 80 SKILL POINTS.";
    text[3554] = "I've got an SP UPGRADE CHIP I'm lookin' to sell.";
    text[3555] = "The SP UPGRADE CHIP increases your Max SP by 100.";
    text[3556] = "It's the only Upgrade Chip out there that can increase your MAX SP.";
    text[3557] = "The SP UPGRADE CHIP is worth 160 Skill Points. Do ya want to buy it?";
    text[3558] = "Make sure to equip the SP UPGRADE CHIP from your ITEMS MENU.";
    text[3560] = "Quit wastin' my time! You don't have 160 SKILL POINTS!";
    text[3252] = "Thanks for the business, kid.";
    text[3253] = "Hey, kid. You look like a strong warrior who could use a rare UPGRADE CHIP.";
    text[3254] = "I've got a BARRIER UPGRADE CHIP I'm lookin' to sell.";
    text[3255] = "You interested?";
    text[3256] = "What does it do?";
    text[3257] = "What's the catch?";
    text[3258] = "The BARRIER UPGRADE CHIP is an upgrade chip you can equip from your ITEMS MENU.";
    text[3259] = "If equipped, you'll always start off a battle with a one-time-use Barrier.";
    text[3260] = "If you get hit by an enemy attack, the Barrier will absorb the attack instead,";
    text[3261] = "and your BATTLE RANK will remain unaffected.";
    text[3262] = "Once the Barrier is used up, it won't regenerate until your next battle.";
    text[3263] = "You see, I'm not interested in Bytes or Astrotech. What I want is SKILL POINTS.";
    text[3264] = "A rare currency for a rare item. How does 40 Skill Points sound?";
    text[3265] = "Good deal, kid.";
    text[3266] = "Make sure to equip the BARRIER UPGRADE CHIP from your ITEMS MENU.";
    text[3267] = "See ya around, kid.";
    text[3269] = "Hey, I ain't playin' around kid. Come back when you have 40 SKILL POINTS.";
    text[629] = "Yo! I'm an Astrotech Trader. Call me Cypher.";
    text[630] = "If ya got some Astrotech on hand, we can trade goods, yeah?";
    text[631] = "Trade";
    text[632] = "Talk";
    text[633] = "Leave";
    text[634] = "See, I come from up north. My shop's up in Colony Silica.";
    text[635] = "I usually come down here to hunt for Astrotech.";
    text[636] = "Silica is the mining district of Luna!";
    text[637] = "There's a lot of Treasure Hunters there.";
    text[638] = "That's right, yo!";
    text[639] = "We got the rarest minerals and materials up there.";
    text[640] = "Regolithia on the other hand, is filled to the brim with techno goods yo!";
    text[641] = "Yo yo yo!";
    text[642] = "So, what do you do with the Astrotech?";
    text[643] = "I can use Astrotech to make some pretty neat things.";
    text[644] = "Machinery and gadgets are my forte!";
    text[645] = "If ya ever get the chance, stop by my shop in Silica.";
    text[646] = "I got a lot of cool Ship Parts you could buy!";
    text[647] = "Thanks for the business yo!";
    text[648] = "Not enough Astrotech!";
    text[649] = "Sorry yo, I'm all sold out.";
    text[650] = "Awesome! Here's what I got in stock.";
    text[651] = "SOLD OUT";
    text[4842] = "Yo! What's up? If you're lookin' for cool ship parts,";
    text[4843] = "you've come to the right place! What'll it be, yo?";
    text[4844] = "Hey, where's your doggy?";
    text[4845] = "He's sleepin' right now, yo. All that tail wagging got him tired!";
    text[652] = "Howdy. The name's Nym. I'm a travelin' merchant.";
    text[653] = "I got a few things to sell if you're interested.";
    text[654] = "What'll it be?";
    text[655] = "If yer lookin' for the Astrotech Trader,";
    text[656] = "I reckon I saw him somewhere in this area.";
    text[657] = "Thanks. Take Care.";
    text[658] = "Buy";
    text[3806] = "Howdy. Good to see ya.";
    text[3807] = "When I came across this Ranch, I instantly fell in love with this place.";
    text[3808] = "I might just set up a permanent shop here someday.";
    text[3809] = "I got a few new things to sell if you're interested.";
    text[1919] = "Hi there! My name is Alex. I'm the merchant here at the LSS.";
    text[3213] = "Hi there! Welcome to the General Store!";
    text[1920] = "We've got a sale going on right now!";
    text[1921] = "Awesome! What would you like?";
    text[1922] = "Alright, take care! Come back soon!";
    text[1923] = "The other shop keepers here are actually my sisters!";
    text[1924] = "We used to go on spy missions together, and now we're pursuing new passions!";
    text[1929] = "Hi I'm Britney! Thanks for stopping by!";
    text[1930] = "I've got a bunch of useful goods you can trade for Astrotech!";
    text[1931] = "We've got ship parts available for purchase as well!";
    text[1932] = "The parts are a bit pricey, but it's super worth it!";
    text[1933] = "You can customize your ship by interacting with the World Map Warp!";
    text[1934] = "Here's what we have available.";
    text[3208] = "We just restocked our Ship Parts!";
    text[3209] = "Each of my storefronts have different selections to choose from!";
    text[3214] = "NEW JET SUIT AVAILABLE!";
    text[3215] = "Talk to Clover at Lunex Style in Copernicus!";
    text[3216] = "To change your Jet Suit, PRESS { in the PAUSE MENU!";
    text[3217] = "To change your Jet Suit, PRESS ~ in the PAUSE MENU!";
    text[3218] = "To change your Jet Suit, PRESS ^ in the PAUSE MENU!";
    text[1938] = "Hey Bella! Thanks for being part of my Jet Suit Marketing Program!";
    text[3219] = "Here, I've got a new Jet Suit for you to fly around in!";
    text[3221] = "I'm on a never-ending quest to create the best Jet Suit styles on Luna!";
    text[1940] = "Heyyo, I'm Sam! Nice to meet you! I sell Neural Links!";
    text[1941] = "You can buy new Support Skills, Active Skills, and Skill Boosters!";
    text[1942] = "My sisters and I have shops set up all across Luna!";
    text[1943] = "Almost every shop has something unique to offer. Come check us out!";
    text[1944] = "Woohoo! What do ya wanna get?";
    

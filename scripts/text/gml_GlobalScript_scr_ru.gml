    text[120001] = "Press    to deactivate your Jet Suit!";
    text[120002] = "Press    to activate your Jet Suit!";
    text[120003] = "Jet Pad AUTHORIZATION ERROR...";
    text[2560] = "The Jet Pad is malfunctioning. We can't use it right now...";
    text[4820] = "It's a broken Jet Pad.";
    text[4821] = "Looks like it hasn't been used in a long time.";
    text[7560] = "OVER-PHASE UNLOCKED!";
    text[7561] = "In battle, Nickle can now push past his limits and OVER-PHASE!";
    text[7562] = "This powerful form lasts for 2 Turns and grants Nickle a 4x PWR Boost";
    text[7563] = "for all of his Active Skills at the cost of losing 50% of his HP per turn.";
    text[7564] = "While in this form, SP Cost is bypassed so you can focus on maximizing your damage output!";
    text[5331] = "Interacting with the People of Luna will grant you Affinity Points";
    text[5332] = "that will boost your reputation and Colony Affinity Level!";
    text[5333] = "Increasing your Affinity Level will unlock new Side Quests and";
    text[5334] = "you'll also get discounts from Merchants and Astrotech Traders!";
    text[5335] = "Your Affinity Levels can be viewed in your CODEX - RECORDS MENU!";
    text[7120] = "What do we do with the Minipod?";
    text[7121] = "We'll take it with us.";
    text[7122] = "You know, I kind of like flying around with it.";
    text[7123] = "I wouldn't mind using it once in a while.";
    text[7124] = "YOU CAN NOW SELECT THE MINIPOD IN THE SHIP CUSTOMIZATION MENU!";

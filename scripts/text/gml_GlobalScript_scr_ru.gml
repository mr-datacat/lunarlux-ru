    //text[1137] = "The calming radiance from the Kyrogate heals your soul.";
    text[1137] = "Успокаивающее сияние, исходящее от Кайрогейта, исцеляет вашу душу.";
    
    //text[120004] = "The serene blue radiance from the Kyrogate heals your soul.";
    text[120004] = "Безмятежное синее сияние, исходящее от Кайрогейта, исцеляет вашу душу.";
    
    //text[1030] = "This Kyrogate exudes a strange aura.";
    text[1030] = "От этого Кайрогейта исходит странная аура.";
    
    //text[1031] = "You are filled with a sense of curiosity and unease...";
    text[1031] = "Вас охватывают чувства любопытства и тревоги...";
    
    //text[120005] = "Would you like to save your progress?";
    text[120005] = "Хотите сохранить прогресс?";
    
    //text[120006] = "Your progress has been saved!";
    text[120006] = "Прогресс сохранён!";
    
    //text[120007] = "Progress not saved.";
    text[120007] = "Прогресс не сохранён.";
    
    //text[7551] = "Are you sure you want to exit without saving your progress?";
    text[7551] = "Вы уверены, что хотите выйти без сохранения прогресса?";
    
    text[1603] = "YES (Make sure to SAVE first!)";
    text[7400] = "Your final battle awaits. May your Lux shine forever bright.";
    text[610] = "It's the Regolithia BBS!";
    text[1138] = "Rei";
    text[1177] = "Regolithia BBS!";
    text[1216] = "Hello everyone! My name's Rei and I'm the moderator for the Regolithia BBS!";
    text[1217] = "Feel free to post messages, talk about battle strategies or anything you'd like!";
    text[1139] = "Lunex_Force";
    text[1178] = "Public Advisory";
    text[1218] = "If a Murk appears within your Sector,";
    text[1219] = "please find shelter and contact the Lunex Force for immediate assistance.";
    text[1220] = "DO NOT attempt to engage with the Murks under any circumstance. Thank you.";
    text[1140] = "Michelle";
    text[1179] = "Cafe Regolithia";
    text[1221] = "Need someplace to rest and recharge?";
    text[1321] = "Stop by Cafe Regolithia and we got you covered!";
    text[1222] = "Try our delicious Miso Ramen or our cafe specialty Crunch-E Bars!";
    text[1141] = "ZetaMan";
    text[1180] = "Dark Patches?";
    text[1223] = "Yo, lately I've been seeing weird patches of distorted energy on the ground...";
    text[1224] = "I blink and it vanishes. Rumors say it's a lurking Murk.";
    text[1142] = "Roto";
    text[1181] = "Shield Limits";
    text[1225] = "Howdy folks! My name's Roto! You all know about Shield limits right?";
    text[1226] = "Normally, you start off battles with one shield. If you find SHIELD BOOSTERS,";
    text[1227] = "you can increase the maximum number of shields you start off with in battle!";
    text[1143] = "Boltz";
    text[1182] = "Rock Murk";
    text[1228] = "Guys, I saw a Murk that looked like a walking boulder...";
    text[1229] = "I looked out my window and it was in the deepest part of the caverns.";
    text[1230] = "I swear I'm not making this up!";
    text[1144] = "Raseru";
    text[1183] = "Battle Strats";
    text[1231] = "Wahhh!! I just got my hands on a MULTIPLY (LV 1) Support Skill!";
    text[1232] = "Now, I'll be able to deal massive damage to the Hyperbees with my Photon Cannon! Mwahaha!";
    text[1145] = "SpaceBoy";
    text[1184] = "REPLY 1: Battle Strats";
    text[1233] = "Bro, your MULTIPLY Skill is only level 1...";
    text[1234] = "In order to get a higher multiplier,";
    text[1235] = "you need to level up your MULTIPLY (LV 1) Support Skill using SKILL POINTS first.";
    text[1236] = "I suggest using Soul Aura. It costs 2 Shields but you get a +40 in Power.";
    text[1237] = "With that strat you could obliterate those Hyperbees with your Photon Cannon!";
    text[1146] = "Raseru";
    text[1185] = "REPLY 2: Battle Strats";
    text[1238] = "Woahh! Teach me more senpai! Uguuuuu!";
    text[1147] = "Melia";
    text[1186] = "Lost Hertz Cube";
    text[1239] = "Has anyone seen my Hertz Cube?";
    text[1240] = "I think I lost it somewhere near the Barrier Facility...";
    text[1148] = "Jet";
    text[1187] = "S-Ranks";
    text[1241] = "Jet here, how the heck do I get an S-Rank in battle?";
    text[1242] = "Is there a timer?";
    text[1243] = "Does it depend on the number of turns?";
    text[1244] = "Does it depend on my HP?";
    text[1245] = "I need answers!";
    text[1149] = "KingNet";
    text[1188] = "REPLY 1: S-Ranks";
    text[1246] = "Simple. Don't get hit.";
    text[1150] = "Jet";
    text[1189] = "REPLY 2: S-Ranks";
    text[1247] = "I see KingNet is a man of many words.";
    text[1151] = "Oslo";
    text[1190] = "REPLY3: S-Ranks";
    text[1248] = "Don't mess around with KingNet! He's super serious about battling.";
    text[1249] = "I hear he's incredibly powerful.";
    text[1152] = "Jet";
    text[1191] = "REPLY 4: S-Ranks";
    text[1250] = "He's probably no match for the Murk Slayer.";
    text[1153] = "Aether";
    text[1192] = "Support Skills";
    text[1251] = "Ugh, I forgot to re-equip my healing support skills right before a big battle.";
    text[1252] = "Make sure to check your Support Skills Menu to see what you have equipped lol.";
    text[1154] = "LunaBot 101";
    text[1193] = "Astro-Barrier";
    text[1253] = "The Astro-Barrier is an artificial atmosphere generator and defense system.";
    text[1254] = "It can also communicate with the gravity and oxygen generators using EM Waves.";
    text[1255] = "Its existence has allowed life to comfortably survive on the moon.";
    text[1155] = "LunaBot 101";
    text[1194] = "Daily Quote";
    text[1256] = "It's the year 30XX! Here's your quote of the day:";
    text[1257] = "May your Lux shine forever bright!";
    text[1156] = "Tyrian";
    text[1195] = "Deep Thoughts";
    text[1258] = "Yo, imagine theres like, invisible roads around us.";
    text[1259] = "Bro, what if it's made of like, electromagnetic waves ya know?";
    text[1260] = "Deep stuff man.";
    text[1157] = "Tobi";
    text[1196] = "RE: Deep Thoughts";
    text[1261] = "Tyrian, I think you've had one too many Ener-G drinks.";
    text[1158] = "LunaBot 101";
    text[1197] = "20XX";
    text[1262] = "In 20XX, humanity used to live on the now volcanic and lifeless planet known as Terra.";
    text[1263] = "Due to the planetary catastrophe, ASTRA, humans were forced to find a new home.";
    text[1264] = "Unfortunately, no habitable planet existed within a reasonable distance,";
    text[1265] = "so the remaining survivors made their way to Luna, the moon that orbits Terra.";
    text[1266] = "Filled with hope, dreams, and determination...";
    text[1267] = "Humanity continued to survive and flourish in a new home.";
    text[1159] = "Holo";
    text[1198] = "RUINS";
    text[1268] = "This is detective Holo.";
    text[1269] = "I'm looking for info regarding recently discovered ruins and anyone who";
    text[1270] = "might have knowledge on the language engraved on the walls of Luna.";
    text[1160] = "Volta";
    text[1199] = "Level Up Skills?";
    text[1271] = "Volta here! Is there a way to make my ACTIVE SKILLS stronger?";
    text[1161] = "Chip";
    text[1200] = "RE: Level Up Skills?";
    text[1272] = "Yep! You can use SKILL BOOSTERS to level up your active skills.";
    text[1322] = "They're not easy to obtain though...";
    text[1162] = "ERROR";
    text[1201] = "NO SUBJECT";
    text[1273] = "Life is but an experiment.";
    text[1274] = "It's a reaction of chaos...and wonder.";
    text[1275] = "Strangely, this BBS post dates back to 10 years ago.";
    text[1276] = "It won't go away no matter how many times you reload the feed.";
    text[1277] = "It must be a glitch or something.";
    text[1163] = "Alumae";
    text[1202] = "NO SUBJECT";
    text[1278] = "Heh.";
    text[1279] = "(The next 69 replies is just hehs.)";
    text[1164] = "Stark";
    text[1203] = "Who Can Relate?";
    text[1280] = "That moment when your Support Skills generate,";
    text[1281] = "and you get three of the same exact Support Skill. UGH!";
    text[1323] = "(This post went viral apparently.)";
    text[1165] = "KingNet";
    text[1204] = "RE: Who Can Relate?";
    text[1282] = "F.";
    text[1166] = "Hazel";
    text[1205] = "Bunch of Bytes";
    text[1283] = "I always find Bytes lying around inside the caverns of Regolithia.";
    text[1284] = "It's not much, but it's easy money if you go out of your way to locate them.";
    text[1285] = "On second thought, maybe I shouldn't have posted this...";
    text[1167] = "Tanaka";
    text[1206] = "Ship Upgrades";
    text[1286] = "Have you guys checked out the shop in Copernicus? I upgraded my ship yesterday.";
    text[1287] = "It's so decked out yo! Cost me like 1000 GigaBytes!";
    text[1288] = "Totally worth it.";
    text[1168] = "Kohaku";
    text[1207] = "Lost Cat";
    text[1289] = "Did anyone lose their cat recently?";
    text[1290] = "I work at the Barrier Facility and as I was on my way home,";
    text[1291] = "I saw a chubby cat flying around in a Space Suit!";
    text[1324] = "I had to pinch myself to make sure I wasn't dreaming.";
    text[1169] = "Lunex_Force";
    text[1208] = "Now Recruiting!";
    text[1292] = "Want to join the Lunex Force? We are now recruiting!";
    text[1170] = "Rex";
    text[1209] = "RE: Now Recruiting!";
    text[1293] = "OMG do we get our own Gun Sabers if we join?";
    text[1171] = "Nebuloid";
    text[1210] = "Gun Sabers";
    text[1294] = "A Gun Saber's blade and bullets are embedded with plasma.";
    text[1295] = "It was designed to be able to damage the Murks.";
    text[1296] = "I heard Lunex Labs is currently designing a new Murk busting weapon,";
    text[1297] = "that incorporates tech from the Vessels and is powered by Anticores!";
    text[1172] = "Lunex_Force";
    text[1211] = "WANTED";
    text[1298] = "WANTED: Murk Slayer\nNAME: Unknown\nAGE: Twenties";
    text[1299] = "If anyone spots the Murk Slayer, please contact the Lunex Force immediately.";
    text[1173] = "ZetaMan";
    text[1212] = "RE: WANTED";
    text[1300] = "Honestly, we need to find this man and have him join the Lunex Force or something.";
    text[1301] = "Who cares if he stole military property?";
    text[1302] = "He's a freakin' Murk bustin powerhouse! He can help protect us!";
    text[1303] = "I just don't understand why he works in the shadows. What is he hiding?";
    text[1174] = "OGJony";
    text[1213] = "Shooting Stars";
    text[1304] = "Feeling lucky? If you see a Shooting Star in the sky, you should press |.";
    text[2548] = "Feeling lucky? If you see a Shooting Star in the sky, you should press $.";
    text[2549] = "Feeling lucky? If you see a Shooting Star in the sky, you should press &.";
    text[1175] = "Tetra";
    text[1214] = "Lux Combo Recipe";
    text[1307] = "Hello, It's me Tetra. Does anyone have any unique Lux Combo Recipes to share?";
    text[1305] = "Heh, an expert sidekick not only assists the hero during battles, but they also";
    text[1306] = "ensure the hero gets the best advice and tips outside of battle as well.";
    text[1176] = "Ouro";
    text[1215] = "RE: Lux Combo Recipe";
    text[1308] = "Aye, I got one for you. It's called Holo Hurricane.";
    text[1309] = "Try combining 2 Holo Shields with any Sword Based Active Skill!";
    text[9362] = "It's the Lunex BBS!";
    text[9363] = "It's the Copernicus BBS!";
    text[9364] = "Emmet";
    text[9365] = "Stargazers Club";
    text[9366] = "Greetings fellow stargazers!";
    text[9367] = "Emmet here, ready to give you the hottest stargazing locations!";
    text[9368] = "Grab your binoculars and set your coordinates for Tycho!";
    text[9389] = "Chad";
    text[9390] = "Am I the jerk?";
    text[9391] = "So, my girlfriend and I went on a date the other day...";
    text[9392] = "...this post is like, seventeen paragraphs long.";
    text[9393] = "You decided not to read it.";
    text[9394] = "Moderator";
    text[9395] = "RE: Am I the jerk?";
    text[9396] = "Hey Chad, these kinds of posts don't belong on the Lunex BBS.";
    text[9397] = "There are sub-BBS's for these kind of things.";
    text[9398] = "Please refrain from dumping your relationship drama on here. Thanks.";
    text[9419] = "Whitney";
    text[9420] = "MooMoo Milk";
    text[9421] = "Has anyone noticed just how much milk costs these days?!";
    text[9422] = "It's outrageous!";
    text[9423] = "Morty";
    text[9424] = "RE: MooMoo Milk";
    text[9425] = "It's not just milk... Kepler Ranch has been experiencing";
    text[9426] = "food production issues due to the Murks...";
    text[9427] = "I mean... We were struggling to keep up with the food demand";
    text[9428] = "before the Murks showed up, but now... It's even harder!";
    text[9465] = "Cecile";
    text[9470] = "Mysterious Voice";
    text[9466] = "I was walking towards the Mission Control Room in Floor 3F when...";
    text[9467] = "...I suddenly heard a faint voice...";
    text[9468] = "...The voice sounded strange and glitchy...";
    text[9469] = "I tried to look around to see where the voice came from but... no luck.";
    text[9527] = "Lunex BBS";
    text[9528] = "ERROR 404";
    text[9529] = "Huh? Is something wrong with the BBS?";
    text[9530] = "I usually see hundreds of posts on here every day...";
    text[9531] = "The scientists apparently overloaded the server with their research ideas.";
    text[9532] = "Oh well...";
    text[9533] = "There are BBS Boards in Copernicus, Tycho, and Colony Silica as well!";
    text[9534] = "We can check them out when we get the chance, heh.";
    text[9369] = "Grab some climbing gear and set your coordinates for Silica Rifts!";
    text[9378] = "Missing Persons Report";
    text[9379] = "This BBS Post contains an up-to-date list of";
    text[9380] = "individuals who were reported as 'MISSING'.";
    text[9381] = "If you have any information on the whereabouts of any of these people,";
    text[9382] = "please contact the Lunex Force immediately.";
    text[9373] = "Sebastian";
    text[9374] = "Treasure Hunter's Guild";
    text[9375] = "Hey! We're lookin' for new members to join the Treasure Hunter's Guild!";
    text[9376] = "If you're interested, stop by Colony Silica and look for our pal, Fortuno!";
    text[9384] = "Jason";
    text[9385] = "Grand Opening!";
    text[9386] = "If you're a fan of robots and require a robot technician, I'm your guy!";
    text[9388] = "Come check out our grand opening of BlanK Robotics over at Tycho!";
    text[9444] = "Serenity";
    text[9445] = "Saros Fan Club";
    text[9446] = "I heard Saros is the youngest individual to be appointed as the";
    text[9447] = "General of the Lunex Force.";
    text[9448] = "The Legendary Hero of Luna... He's only 28!";
    text[9449] = "Joey";
    text[9450] = "RE: Saros Fan Club";
    text[9451] = "Saros is cool and all...";
    text[9452] = "But does anyone know anything about Commander Vivia?";
    text[9453] = "I kinda want to start a fan club about her...";
    text[9496] = "Battle Wiki";
    text[9497] = "Status Effects";
    text[9498] = "There are 3 Status Effects you can inflict on your opponent:";
    text[9499] = "STUN, BURN, and DRENCH!";
    text[9500] = "An enemy inflicted with STUN will be unable to attack for 1 Turn!";
    text[9501] = "An enemy inflicted with BURN will lose HP for a set number of turns!";
    text[9502] = "As for DRENCH... Your Lux Meter will fill up faster when you attack";
    text[9503] = "an enemy inflicted with the DRENCH Status Effect!";
    text[9412] = "Ouro";
    text[9413] = "Lux Combo Facts";
    text[9414] = "Here's a fun fact!";
    text[9415] = "There are a total of 30 unique Lux Combo Recipes you can try!";
    text[9416] = "About one-third of those recipes are pretty easy to remember...";
    text[9417] = "Simply stack three of the same skills!";
    text[9418] = "The other two-thirds however, require some... experimentation.";
    text[9371] = "Grab your winter jacket and set your coordinates for Mt. Piton!";
    text[9372] = "Those shooting stars will pass by in the blink of an eye!";
    text[9434] = "Gumdrops";
    text[9435] = "There's a particular Active Skill I love using but...";
    text[9436] = "...my SP Cost for it is so dang high!";
    text[9437] = "Is it possible to somehow reduce the SP COST of one of my Active Skills?";
    text[9430] = "REPLY 1: Gumdrops";
    text[9431] = "Use a Gumdrop. Gumdrops permanently decrease the SP COST of";
    text[9432] = "one of your Active Skills by 5.";
    text[9438] = "REPLY 2: Gumdrops";
    text[9439] = "I did some research and apparently Gumdrops are extremely rare!";
    text[9440] = "Seems like you've tried one before, KingNet...";
    text[9441] = "...Do you have a Gumdrop you could spare?";
    text[9442] = "REPLY 3: Gumdrops";
    text[9443] = "Nope.";
    text[9515] = "Momo";
    text[9516] = "Echo!";
    text[9517] = "Yesterday, I spotted Echo the Space Cat cheering me on as I was training for";
    text[9518] = "my upcoming marathon! I have to admit, cats are awesome!";
    text[9519] = "Kohaku";
    text[9520] = "REPLY 1: Echo";
    text[9521] = "Where did you spot Echo, if you don't mind me asking?";
    text[9522] = "REPLY 2: Echo";
    text[9523] = "Yesterday, I spotted Echo as I was jogging around near Cafe Silica.";
    text[9524] = "The day before that, I spotted Echo flying above the highways of Copernicus.";
    text[9525] = "...and the first time I ever saw Echo was right here in Tycho.";
    text[9526] = "Echo was flying right above me as I was checking the Tycho BBS.";
    text[9400] = "Area51-Guy";
    text[9401] = "Military Base";
    text[9402] = "I was exploring the Wasteland Zone the other day and I started wondering,";
    text[9403] = "how come there are no Jet Pads near the Military Base?";
    text[9404] = "Riku";
    text[9405] = "REPLY 1: Military Base";
    text[9406] = "I assume allowing Jet Suit flight around a Military Base,";
    text[9407] = "could be a potential security risk.";
    text[9410] = "Dude, what are you doing around the Military Base anyways?";
    text[9411] = "If the Lunex Force spots you, you're gonna get in trouble!";
    text[9540] = "REPLY 2: Military Base";
    text[9409] = "Area51-Guy... We need to talk.";
    text[9370] = "Grab your swimwear and set your coordinates for Harmonia Reef!";
    text[9455] = "Dark Murk Spots";
    text[9456] = "If you ever come across a Murk Spot that looks grey in color...";
    text[9457] = "Stay away from it if you value your life!";
    text[9458] = "One of my friends encountered an alternate-colored Murk";
    text[9459] = "from a Dark Murk Spot and barely managed to escape...";
    text[9460] = "They only recently started appearing,";
    text[9461] = "so the Lunex Force doesn't have much data on them but...";
    text[9462] = "...I heard they're labeling these Murks as 'EX' Murks.";
    text[9463] = "EX Murks are stronger and faster than their original counterparts...";
    text[9464] = "Stay safe out there y'all!";
    text[9472] = "Secret Titles";
    text[9473] = "I'm on a mission to obtain every SECRET TITLE that's out there!";
    text[9474] = "If anyone has any information on how to get a SECRET TITLE,";
    text[9475] = "please let me know!";
    text[9477] = "REPLY 1: Secret Titles";
    text[9504] = "If we tell everyone exactly how we got our titles,";
    text[9505] = "that would defeat the purpose of a 'SECRET' Title...";
    text[9506] = "But... I guess it doesn't hurt to give a small hint for those who are stuck...";
    text[9507] = "Here's mine: ROCKS!";
    text[9479] = "REPLY 2: Secret Titles";
    text[9508] = "Here's my hint: Regolithian Trash Cans!";
    text[9481] = "REPLY 3: Secret Titles";
    text[9509] = "I heard petting dogs frequently is very nice...";
    text[9513] = "Melody";
    text[9483] = "REPLY 4: Secret Titles";
    text[9510] = "CUTE PLUSHIES!";
    text[9485] = "REPLY 5: Secret Titles";
    text[9511] = "Gumdrops.";
    text[9514] = "Emilienator";
    text[9487] = "REPLY 6: Secret Titles";
    text[9512] = "Bonjour! Come find me as FAST as you can!";
    text[9541] = "Dr. Nexus";
    text[9489] = "REPLY 7: Secret Titles";
    text[9490] = "I've got two words... Lava and Hourglass!";
    text[9491] = "REPLY 8: Secret Titles";
    text[9492] = "It's nice to see the community coming together like this.";
    text[9493] = "Here's a hint for a Secret Title I got the other day:";
    text[9494] = "'It's over 1000!'";
    text[9495] = "Good Luck!";
    text[1361] = "Nyla seems to be busy with the installation.";
    text[1362] = "Let's check up with Mett first.";
    text[521] = "The Storage Unit door is locked.";
    text[522] = "We need a keycard to unlock the door.";
    text[523] = "There is a switch here! Will you press it?";
    text[524] = "The switch has already been pressed.";
    
    
    
    
    //text[562] = "Engraved on the Monolith are the names of fallen Lunex Warriors.";
    text[562] = "На Монолите высечены имена павших Лунных Воителей.";
    
    //text[563] = "The first name on the placard reads:";
    text[563] = "Первое имя в списке:";
    
    //text[564] = "Lunex Force General,\nThea Grey.";
    text[564] = "Генерал Лунного Корпуса,\nТея Грей.";
    
    
    
    
    text[565] = "It's a steel-plated barrel.";
    text[566] = "An oxygen sensor is embedded within this bollard.";
    text[567] = "Lunex Labs uses data collected from this sensor to monitor the conditions on Luna.";
    text[572] = "Welcome to Cafe Regolithia!";
    text[573] = "Our specialty: Crunch-E Bars!\nToday's Special: Miso Ramen!\nPopular Drink: Soda Pops!";
    text[574] = "It's a neon sign that says 'Cafe'.";
    text[585] = "A bunch of lunar panels are installed on the beam.";
    text[586] = "These panels are essential for providing power to local residents in Sector 16.";
    text[587] = "Someone painted an 'X' and 'Z' on the cliffside.";
    text[588] = "'Scientia Potentia Est'\nKnowledge is Power";
    text[589] = "This monument was built to honor the countless scientific advancements";
    text[590] = "humanity has made throughout time.";
    text[591] = "Vessels are allowed to land and depart in areas where this crystal luminaire shines.";
    text[598] = "Input 2 - Down";
    text[599] = "Input 3 - Left";
    text[600] = "Input 4 - Right";
    text[601] = "Input 5 - Up";
    text[602] = "It's a poster of two cool video game characters!";
    text[603] = "The caption on the bottom reads: The legacy of Cosmic Network";
    text[604] = "It's a poster of a cool video game character!";
    text[605] = "The caption on the bottom reads: The legacy of EndWave";
    text[606] = "It's a map of Luna!";
    text[607] = "Someone left a note here. The writing is difficult to read:";
    text[608] = "B-rri-r Fa-ili-y\nTwo Bl-ck Pi-l-rs\nRed Tr--ngle";
    text[609] = "Frigid cold air seems to be coming from the large pipe above.";
    text[611] = "WARNING - HIGH VOLTAGE ZONE";
    text[612] = "DO NOT TRESPASS.";
    text[613] = "Access to Barrier Facility for Authorized Personnel only.";
    
    //text[614] = "It's a Lunar Sycamore.";
    text[614] = "Это Лунный Сикомор.";
    
    //text[615] = "The liquid in the dome provides the nutrients needed for the tree to grow.";
    text[615] = "Жидкость в куполе содержит питательные вещества, нужные для роста дерева.";
    
    //text[616] = "It's a beautiful batch of Lunar Camellias.";
    text[616] = "Это несколько красивых Лунных Камелий.";
    
    //text[617] = "One of them is slightly wilted.";
    text[617] = "Один из цветов выглядит немного вяло.";
    
    //text[618] = "It's a bed of beautiful Lunar Camellias.";
    text[618] = "Это клумба с красивыми Лунными Камелиями.";
    
    //text[619] = "It's a tombstone made of special Lunar Obsidian.";
    text[619] = "Это надгробие, сделанное из специального Лунного Обсидиана.";
    
    //text[620] = "The blue markings formed from continuous absorption of the sun's intense light.";
    text[620] = "Синие отметины возникли из-за непрерывного поглощения солнечного света.";
    
    
    //text[621] = "'Sol' is written on the placard.";
    text[621] = "Здесь написано 'Сол'.";
    
    //text[622] = "'Hope' is written on the placard.";
    text[622] = "Здесь написано 'Надежда'.";
    
    //text[623] = "'Spirit' is written on the placard.";
    text[623] = "Здесь написано 'Дух'.";
    
    //text[624] = "'Peace' is written on the placard.";
    text[624] = "Здесь написано 'Мир'.";
    
    //text[625] = "'Legends' is written on the placard.";
    text[625] = "Здесь написано 'Легенды'.";
    
    //text[626] = "'Starlight' is written on the placard.";
    text[626] = "Здесь написано 'Звездный свет'.";
    
    //text[627] = "'Lux' is written on the placard.";
    text[627] = "Здесь написано 'Люкс'.";
    
    //text[628] = "'Umbra' is written on the placard.";
    text[628] = "Здесь написано 'Умбра'.";
    
    
    text[772] = "There seems to be something shiny in this trash bin...";
    text[773] = "...It was just trash.";
    text[774] = "You doubled checked this trash bin...";
    text[775] = "It's still just trash.";
    text[776] = "You triple checked this trash bin...";
    text[777] = "There's nothing useful to find in this one.";
    text[778] = "It's just trash...???";
    text[779] = "You quadruple checked this trash bin...";
    text[780] = "...and proceeded to quintuple check it immediately after.";
    text[781] = "The inside of this trash bin is like a black hole, ready to suck in trash.";
    text[782] = "In this trash bin...?!";
    text[783] = "Just junk...";
    text[1041] = "These lockers are full of clothes and cosplay costumes.";
    text[1042] = "There's a 'Cool Dude' sticker on this locker.";
    text[1043] = "It's a multipurpose switch.";
    text[1044] = "There's an occupancy sensor, light switch, and thermostat built in!";
    text[1045] = "It's occupied.";
    text[1046] = "-Restroom-";
    text[1047] = "There are some who order 3 course meals here.";
    text[1048] = "While others, simply want a single slice of watermelon.";
    text[1049] = "That is the beauty of life.";
    text[1050] = "Dark chocolate cupcakes are the best kind of cupcakes.";
    text[1051] = "It's a sizzling hot cup of coffee - with an extra shot of espresso!";
    text[1052] = "Onigiri!";
    text[1053] = "Mmmm, that miso ramen looks delicious!";
    text[1054] = "There's an assortment of delicious foods on the table.";
    text[1055] = "It's a veggie burger and spicy hot dog!";
    text[1056] = "This fridge is full of chilled beverages!";
    text[1057] = "There's all sorts of yummy food in the fridge!";
    text[1063] = "This device regulates the oxygen levels within the room.";
    text[1064] = "The calendar art features a pure black background with a pixel heart.";
    text[1065] = "It's captioned: 'Determination'.";
    text[1066] = "It's a compressed air tank.";
    text[1067] = "A nice gray cabinet.";
    text[1068] = "This toolbox is huge!";
    text[1069] = "It's an illustration depicting a space explorer.";
    text[1070] = "It's a sleeping pod!";
    text[1071] = "It has many features to provide the best comfort while you're sleeping.";
    text[1072] = "There's a shipping label here that reads: Sourced from Kepler Ranch.";
    text[1073] = "Spare oxygen tanks are mounted on the wall in case of an emergency.";
    text[1074] = "It's a fun looking RPG game!";
    text[1075] = "You have the sudden urge to 'Plug In' your own controller and play.";
    text[1076] = "One book is titled 'GameDev 101'. The other one is a video game guidebook.";
    text[1077] = "Some video games are lined up on the shelf...";
    text[1078] = "Space Boy, Lawmage Academy, S.F. 4, Monsters of Kanji, Berserk Boy,";
    text[1079] = "Oslo the Professional, CODE: Bunny, Endwave...";
    text[1080] = "...That's a lot of cool games!";
    text[1081] = "This Storage Unit contains essentials needed to survive space expeditions.";
    text[1082] = "-Authorized Personnel Only-";
    text[1083] = "This storage bin contains packaged food.";
    text[1084] = "Each package is vacuum sealed.";
    text[1101] = "These crates have a bunch of spare equipment that's used in space missions.";
    text[1085] = "This storage bin contains really old propulsion parts.";
    text[1086] = "These have probably been here for decades.";
    text[1087] = "This storage bin contains layers of heat shielding material.";
    text[1088] = "This storage bin contains equipment for depressurization.";
    text[1089] = "Oh boy, say depressurization three times fast.";
    text[1090] = "This storage bin contains machinery for Carbon Dioxide Removal.";
    text[1091] = "This storage bin contains a water condensing unit.";
    text[1092] = "It prevents corrosion on sensitive equipment.";
    text[1093] = "This storage bin contains radiation protection systems.";
    text[1094] = "Many decades ago, continued exposure to radiation was a cause for concern";
    text[1095] = "when humanity was living on the moon.";
    text[1096] = "This storage bin contains spare communication equipment.";
    text[1097] = "This storage bin is empty.";
    text[1098] = "There's some old Space Suits inside this storage box.";
    text[1099] = "There's some terminals and cables in the toolbox. Meh, not that interesting.";
    text[1100] = "The toolbox contains a bunch of soldering tools.";
    text[1102] = "This storage bin contains spare hygiene kits.";
    text[1114] = "It's a platter of gelato. Are you craving sweets yet?";
    text[1115] = "One of the best desserts in existence: Leche Flan.";
    text[1116] = "Fizzy Pops!";
    text[1117] = "A lone Camellia rests in the pot. It looks pretty healthy!";
    text[1118] = "Thanks for stoppin' by Cafe Regolithia!";
    text[1119] = "Sometimes, the best refreshment is a nice chilled glass of water.";
    text[1120] = "Woah, they've got sushi here too!? Yum!!";
    text[1121] = "There's a caption on the poster that says: Fight the Power!";
    text[1122] = "Two wet martial arts gi are hung up on the wall to dry.";
    text[1123] = "It's a book titled: The Lost World of Terra.";
    text[1124] = "A bunch of expensive mecha action figures are displayed in the glass cabinet.";
    text[1125] = "It's a multi-purpose display.";
    text[1126] = "The toolbox actually has a bunch of toys inside of it.";
    text[1127] = "An anime called Yo-King, is currently playing on the TV.";
    text[1128] = "The characters are dueling using Yo-Yo's that contain powerful sealed beasts!";
    text[1129] = "It looks pretty epic.";
    text[1130] = "There's a bunch of manga and comic books on the shelf.";
    text[1131] = "There's a bunch of handheld game consoles inside.";
    text[1132] = "Is that CosmicSans from Hyper Smash Fighters?!";
    text[1133] = "This hatch provides access to the Barrier Facility deep underground.";
    text[1134] = "We don't need to go there right now...";
    text[1035] = "There are some Lunar Panels installed on the horizontal pillar.";
    text[1036] = "It looks like more was intended to be installed.";
    text[1037] = "It's the Astro-Barrier!";
    text[1325] = "It's a Model-N Supply Carrier!";
    text[1326] = "This Hovercraft can travel far and wide thanks to its gravity propulsion system!";
    text[1038] = "The Lunex Space Station can be seen orbiting Luna.";
    text[1039] = "The LSS is the home of Lunex Labs;";
    text[1040] = "a hub where the smartest scientists and most innovative engineers gather.";
    text[409] = "It's a Warrior Type Vessel!";
    text[410] = "The Vessels are dual-powered by Anticores and electricity.";
    text[411] = "When fueled with Anticores, they are capable of";
    text[412] = "withstanding large quantities of antimatter in battle.";
    text[413] = "This makes them an ideal weapon for fighting against the Murks.";
    text[512] = "Regolithia Resident Unit - 001";
    text[513] = "SECTOR 16 - REGOLITHIA\n- Warrior's Peak";
    text[514] = "South-East Hoverport";
    text[515] = "Storage Unit - 003";
    text[516] = "Authorization ERROR.";
    text[517] = "West - Barrier Facility\nEast - Residential Zone";
    text[533] = "Frigid cold air seems to be coming from the large pipe above.";
    text[534] = "Would you like to enter the pipe?";
    text[535] = "The color of the alexandrite stones in Regolithia changes under different lighting conditions.";
    text[536] = "1000 years ago, this stone was extremely rare due to its color changing properties.";
    text[537] = "It's an alexandrite stone.";
    text[538] = "Rocks in Luna are certainly interesting...";
    text[539] = "You've examined the rocks quite a bit. Perhaps they hold a deeper secret.";
    text[540] = "Or maybe not.";
    text[541] = "This is the 10th time you tried talking to the rock.";
    text[542] = "The rock refuses to talk back.";
    text[543] = "You seem to have a particular fascination for rocks.";
    text[544] = "You have so much experience with rocks, you might as well put it on your resume.";
    text[545] = "Attempt Number 30. The rock still sits on the ground.";
    text[546] = "It does not move.";
    text[547] = "Quite beautiful.";
    text[548] = "Congrats! You're most definitely a rock connoisseur.";
    text[549] = "People still keep pet rocks to this day.";
    text[550] = "Why?";
    text[551] = "Because they are good listeners.";
    text[552] = "Someone carved something on this rock...";
    text[553] = "It says...";
    text[554] = "Rock.@P.@P.@Pman?";
    text[555] = "You feel an aura of gratitude eminating from the rocks in the area.";
    text[556] = "They have never felt so loved.";
    text[557] = "They will never take this moment for granite.";
    text[558] = "The rock looks content. It would hug you if it could.";
    text[559] = "Don't forget to appreciate the small things in life.";
    text[560] = "You have reached the pinnacle of rock interactivity! Rock On!";
    text[561] = "You lost track of how many rocks you've talked to.";
    text[270] = "The puppy is frightened by the jet suit.";
    text[271] = "It's Buddy the puppy! Would you like to pet Buddy?";
    text[272] = "Buddy looks disappointed.";
    text[273] = "Woof Woof!";
    text[274] = "It's a cute puppy! Would you like to pet the puppy?";
    text[275] = "The puppy looks disappointed.";
    text[276] = "You pet the puppy softly.";
    text[277] = "The puppy wags his tail excitedly!";
    text[278] = "He seems eager for more head pats.";
    text[279] = "You pet the puppy again. The puppy is delighted!";
    text[280] = "He seems eager for EVEN MORE head pats.";
    text[281] = "The furiously excited puppy is drooling everywhere.";
    text[282] = "He's enjoying all your head pats!";
    text[283] = "You check the name tag on the collar of the puppy.";
    text[284] = "His name is Buddy! You call his name and his tail wags furiously!";
    text[285] = "Buddy gives you puppy-dog eyes as you pet him.";
    text[286] = "Your petting skills are top-notch! Buddy is pleased.";
    text[287] = "You and Buddy are in full sync. You feel power welling up inside of you.";
    text[288] = "The power of cute puppies shines within you.";
    text[289] = "Buddy is happy to see you.";
    text[290] = "He gives you a slobbery thank-you kiss for all the head pats!";
    text[291] = "You pet Buddy very gently and slowly.";
    text[292] = "He seems to be enjoying this petting speed too!";
    text[293] = "You and Buddy decide to practice a petting speedrun.";
    text[294] = "Buddy-Sensei is impressed!";
    text[302] = "You and Buddy are moving at speeds that can't be seen by the untrained eye.";
    text[303] = "A beautiful and epic display of lightning speed petting and tail wagging";
    text[304] = "is occurring even though it appears as if you're not moving at all.";
    text[305] = "You and Buddy have become good friends.";
    text[530] = "There is a ladder on the back side of this pillar!";
    text[531] = "Climb back up?";
    text[532] = "Climb down the ladder?";
    text[909] = "It's a laser reflector!";
    text[910] = "Looks like this laser is still operational but its rotation mechanism is jammed...";
    text[911] = "It cannot be rotated.";
    text[912] = "Rotate Laser.";
    text[913] = "Nevermind.";
    text[914] = "Choose where to point the laser.";
    text[915] = "Looks like the rotation mechanism jammed. It won't rotate any further.";
    text[925] = "Fire the Laser! (Mwahaha!)";
    text[926] = "It's a broken laser. The rotation mechanism is busted too.";
    text[927] = "This Control Panel is busted.";
    text[928] = "Oh?! There's a control lever behind this crane! Select crane drop distance!";
    text[929] = "Level 1 - Short Distance";
    text[930] = "Level 2 - Medium Distance";
    text[931] = "Level 3 - Long Distance";
    text[1136] = "This laser is part of the Astro-Barrier Defense System!";
    text[1135] = "Starlight Point";
    text[1333] = "It appears the Cargo-Safe cannot be opened.";
    text[1334] = "Maybe there's a switch in the Storage Unit that could deactivate the safe?";
    text[1032] = "There's an access hatch here!";
    text[1033] = "It seems to be locked from the other side..";
    text[1024] = "A small wormhole appeared!";
    text[1025] = "Jump inside?";
    text[1029] = "There are strange markings on the ground.";
    text[1367] = "It's a pile of glowing stardust.";
    text[1368] = "It appears the dust is composed of antimatter particles.";
    text[1369] = "It's a tombstone.";
    text[1370] = "It's a monolith.";
    text[1371] = "Somehow, you feel a sense of familiarity.";
    text[3876] = "It's the Lunex Force Missions Board!";
    text[7565] = "What are those two doing here?@P.@P.@P.@P.@P.";
    text[2318] = "I wonder what's beyond that door?";
    text[2319] = "It'll be our first time entering a restricted area!";
    text[2320] = "Oh yah, I just remembered something.";
    text[2321] = "What?";
    text[2322] = "Looks like you owe me 2 cheesecake bars.";
    text[2323] = "Oh yeah, haha. Okiedokie!";
    text[2325] = ".@P.@P.@P.@P.@P.@P.";
    text[1701] = "Select Destination Floor:";
    text[1702] = "1F - Cafe and Lobby";
    text[1703] = "2F - Shopping Center";
    text[1704] = "3F - Research Facility";
    text[1705] = "Restricted Area - Nexus Lab";
    text[1777] = "Lunex Space Station - East Dock";
    text[1778] = "Lunex Cafe";
    text[1779] = "Food is essential fuel for the body! Make sure to eat well here at Lunex Cafe!";
    text[1780] = "There's a bunch of switches and buttons on the wall.";
    text[1781] = "It's probably best not to mess with any settings.";
    text[1782] = "News articles are scrolling on the display.";
    text[1783] = "Murk incidents, new inventions, citizen complaints, food shortages...";
    text[1784] = "There is no end.";
    text[1809] = "Would you like to head back to Regolithia?";
    text[1810] = "The display is showing the Station Directory.";
    text[1811] = "The LSS is comprised of 3 main levels:";
    text[1812] = "It's a Metill and a Kame plushie!";
    text[1813] = "This spooky plushie is called Axsoul.";
    text[1814] = "This vending machine sells Lunex brand merchandise, like hats and cups.";
    text[1815] = "This vending machine dispenses vitamin supplements.";
    text[1816] = "The workers here are required to take vitamin supplements";
    text[1817] = "in order to keep bones, teeth and muscles healthy.";
    text[1818] = "Delicious food and drinks are on the counter.";
    text[1886] = "There is a sticky note with some numbers written on it: 032320.";
    text[1887] = "This display is showing many different space diets and recipes.";
    text[1911] = "This door is locked.";
    text[1915] = "General Store - Get your Ener-G Here!";
    text[1916] = "Astro Zone - Upgrades Upgrades Upgrades!";
    text[1917] = "Lunex Style - Show off your style with our custom Jet Suits!";
    text[1918] = "Neural Links - Knowledge is Power!";
    text[1989] = "These containers likely contain research material used by the scientists.";
    text[1990] = "You found a locked door. The closer you approach the colder you feel.";
    text[1991] = "To West Corridor - Research Lab";
    text[1992] = "To East Corridor - Residential Quarters";
    text[2000] = "These benches are designed for maximum comfort!";
    text[2001] = "Apparently they have massage features built in as well.";
    text[2002] = "There's a tag here that says: No other competitors provide this level of comfort.";
    text[2003] = "Our Bench Power is MAXIMUM!";
    text[2021] = "There's some spare space suits in the storage bins.";
    text[2022] = "It's a healing pod! It's basically a modified sleeping pod with healing features!";
    text[2023] = "Many soldiers come here after long and grueling missions to rest and recover.";
    text[2024] = "You peer through the window. ";
    text[2025] = "You see the beautiful and shining Luna in front of you, surrounded by an asteroid belt.";
    text[2026] = "Beyond that, you see the volcanic Terra looming in the distance.";
    text[2027] = "To 3F Central Area";
    text[2028] = "To Mission Control";
    text[3513] = "EXPRESS WARP ACTIVATED! SELECT YOUR DESTINATION:";
    text[3514] = "3F - Research Lab";
    text[3515] = "3F - Bella's Room";
    text[3516] = "1F - East Dock";
    text[2029] = "Hovercraft Service Room";
    text[2030] = "Lunex Research Lab";
    text[2031] = "Botany Room";
    text[2032] = "Battle Simulation Room";
    text[2033] = "Chemistry Lab";
    text[2035] = "Thomas and Thea's Room";
    text[2036] = "These storage bins contain cleaning supplies.";
    text[2037] = "Healing Chambers";
    text[2038] = "Storage Closet";
    text[2039] = "A Key Card is required to enter.";
    text[2040] = "Residential Quarters";
    text[2041] = "Many scientists and soldiers live in the Lunex Space Station for free,";
    text[2042] = "since their jobs provide essential military and research services.";
    text[2043] = "This display is showing a list of all the tenants living in the Space Station.";
    text[2044] = "There's an advertisement here: Come down to 2F Shopping Center and shop 'till you drop!";
    text[2045] = "This display is showing a list of all the specialized Labs within the Space Station.";
    text[2046] = "This display doesn't seem to be working properly.";
    text[1996] = "This tree is a special species that is capable of surviving in zero gravity!";
    text[1997] = "It requires no water, and the flowers that are blooming will eventually";
    text[1998] = "bear delicious fruit. It has been dubbed the Space Tree.";
    text[1999] = "The pink and purple variations bear the sweetest fruit.";
    text[2076] = "There's some food and dessert coupons on the wall.";
    text[2077] = "Oh? One of the coupons has '041422' scribbled on it.";
    text[2079] = "There's list of battle tips and advice from the top warriors here!";
    text[2080] = "One particular list item caught your eye: UPGRADE CHIPS.";
    text[2081] = "UPGRADE CHIPS are a special category of items that are expensive and rare to obtain.";
    text[2082] = "You can equip and unequip UPGRADE CHIPS from your ITEMS MENU.";
    text[2083] = "UPGRADE CHIPS such as the ARMOR UPGRADE reduces all battle damage taken by 25.";
    text[2084] = "The TACTICS UPGRADE allows you to use 2 Support Skills per turn!";
    text[2085] = "Apparently there is only 1 TACTICS UPGRADE CHIP ever created so it's super rare!";
    text[2086] = "These Gun Sabers are used during training sessions. The blue saber is super rare!";
    text[2087] = "A bunch of Stun Grenades are propped up on the shelf.";
    text[2088] = "There's extra battle uniforms here in case you forget yours!";
    text[2089] = "The uniforms have been designed to comfortably fit on anyone!";
    text[2090] = "It's the Model 1 Space Ship! This ship runs on electricity and solar power!";
    text[2091] = "The movement tiles are being charged.";
    text[2092] = "Their primary use is to help transport cargo and people from one location to the next.";
    text[2093] = "There's some broken Jet Pads laying on the ground.";
    text[2094] = "Looks like these tools are used to service hovercraft and other machinery.";
    text[2095] = "It's a Model 2 Space Ship! This ship can withstand extreme weather conditions!";
    text[2096] = "Oooo I see people back there building new Hovercrafts!";
    text[2097] = "This display is monitoring the vitals and health of the patients.";
    text[2108] = "It's a vial of Anticore Fluid.";
    text[2109] = "These are used as fuel sources for Vessels and other antimatter weapons technology.";
    text[2110] = "There's quite a bit of damage to the vials in this area.";
    text[2111] = "Looks like some plants are being grown in vials that simulate different conditions.";
    text[2112] = "Looks like this computer is used to monitor plant growth.";
    text[2113] = "There's a book here called: Growing Food in Space!";
    text[2114] = "There's a book here called: One Hundred and One Space Recipes!";
    text[2115] = "There's a report here that details a spotted red plant that grew teeth like a piranha.";
    text[2116] = "Oh? The Botany Team really likes to drink jasmine green tea apparently.";
    text[2117] = "A variety of plant and food seeds are stored in the storage compartments.";
    text[2118] = "These boxes contain freshly roasted coffee beans of the highest quality!";
    text[2119] = "This control panel creates interactable hologram displays.";
    text[2120] = "It's used often during meetings to help visualize ideas and designs.";
    text[2121] = "It's Doctor Thomas' PC!";
    text[2122] = "Some folders on his desktop are titled: Antimatter, Murk DNA, and Coffee Lovers.";
    text[2129] = "There's a book here titled: How to Have a Proper Work-Life Balance.";
    text[2130] = "It's an advanced super-computer that monitors the Wormhole Machine.";
    text[2131] = "There are top-secret files here labeled: Dark Energy, Dark Matter, and Astro Technics.";
    text[2132] = "The computer is monitoring the trajectory of the Antimatter Comet: Coda.";
    text[2133] = "This computer is monitoring Antimatter fuel levels. It seems to be very low.";
    text[2134] = "This is the prototype Wormhole Machine titled: Celestia.";
    text[2135] = "The survival of humanity relies on the successful completion of this machine.";
    text[2136] = "These boxes are filled with old toys and other memorabilia.";
    text[2138] = "You have a pretty sophisticated PC that can run many programs at once.";
    text[2139] = "Your desktop background is a photo of the Grey Family on Oceanus Beach.";
    text[2140] = "Doctor Thomas is carrying Thea in his arms and Thea is carrying a baby Bella.";
    text[2141] = "This display is monitoring the conditions of the Astro-Barrier in each Sector.";
    text[2142] = "If a Sector is breached, the surrounding sectors are locked-down";
    text[2143] = "to help prevent further damage to the Astro-Ecosystem.";
    text[2144] = "This display is monitoring the Oxygen, Nitrogen, and Carbon Dioxide levels on Luna.";
    text[2145] = "This computer is connected to an advanced proximity sensor built into the Space Station.";
    text[2146] = "It can accurately measure the distance between multiple objects.";
    text[2147] = "This computer is connected to a molecular scanner.";
    text[2148] = "It can determine the molecular composition of objects that are very far away.";
    text[2222] = "This computer is used to reserve a healing pod.";
    text[2542] = "SECTOR 4 - OCEANUS";
    text[5094] = "HARMONIA REEF AHEAD - PLEASE KEEP OUR WATERS CLEAN!";
    text[5178] = "The ancient markings on the wall are reacting to your presence.";
    text[5179] = "...?!";
    text[5484] = "Would you like to dive underwater?";
    text[5485] = "Would you like to return to the surface?";
    text[5540] = "Looks like some sort of portal. It doesn't seem to be active.";
    text[5541] = "Would you like to descend to the level below?";
    text[5432] = "UPON THE COMPLETION OF THE SOUL TRIAL, A NEW SOUL SENSER SHALL AWAKEN...";
    text[5546] = "THOU SHALL CARRY THE WILLS OF THE SEVEN CHAMPIONS...";
    text[5547] = "...TO BRING FORTH UNIVERSAL BALANCE.";
    text[5439] = "There are some engravings here that discuss Ancient Battle Techniques using";
    text[5440] = "a weapon called the Relic Sword.";
    text[5441] = "This sword was able to channel the Lux of the user to perform special arts.";
    text[5433] = "RED RELIC SWORD: BESTOWS STRENGTH UPON THE WIELDER.";
    text[5434] = "BLUE RELIC SWORD: AUGMENTS THE LUX OF THE WIELDER.";
    text[5435] = "YELLOW RELIC SWORD: FORTIFIES THE DEFENSES OF THE WIELDER.";
    text[5581] = "TO EVOLVE BEYOND THE STANDARD ARTS OF THE RELIC SWORD.";
    text[5582] = "THE WIELDER MAY COMBINE THE GEMSTONES TO ATTAIN GREATER POWER.";
    text[5436] = "ORANGE RELIC SWORD SECRET ART: GRANTS THE SOUL SENSER SP REGEN.";
    text[5437] = "GREEN RELIC SWORD SECRET ART: HEALS THE SOUL SENSER.";
    text[5438] = "PURPLE RELIC SWORD SECRET ART: CHANCE TO INSTANTLY K.O. YOUR ENEMY.";
    text[5534] = "SOLDIER OF LIGHT: OUR HEAVEN PIERCING LUMIKNIGHT";
    text[5535] = "LUX: THE MANIFESTATION OF THE SOUL.";
    text[5536] = "SHOULD A WARRIOR LEARN TO WIELD IT...";
    text[5537] = "THE POWER TO CHANGE THE WORLD SHALL BE WITHIN REACH...";
    text[5538] = "ANTIMATTER: THE CHAOTIC YET ETHEREAL POWER OF THE UNIVERSE.";
    text[5539] = "COSMIC ETERNITY SHALL BE WITHIN REACH...";
    text[5542] = "CROSSING THE REALM IS NO LONGER SAFE...";
    text[5543] = "WE MUST EITHER EVOLVE...";
    text[5544] = "OR PERISH IN AN ETERNAL SLUMBER BY THE GALACTIC MIGHT OF...";
    text[5545] = "OUR NEMESIS.";
    text[5548] = "THE SEAL HAS BEEN BROKEN.";
    text[5549] = "THE SWORD OF THE ANCIENTS IS NOW YOURS TO WIELD.";
    text[5556] = "LUNAR VESSEL... THE Q............ SLEEPS.";
    text[5557] = "L...N...R...X";
    text[5558] = "TERRAN VESSEL... OBLIVION...";
    text[5559] = "The rest of the text on this statue is illegible..";
    text[5577] = "This slab has an illustration depicting Luna and Terra on one side...";
    text[5578] = "The other side of the slab has been destroyed.";
    text[5579] = "WAS OUR QUEST FOR ETERNITY ULTIMATELY OUR DOWNFALL?";
    text[5580] = "ONLY TIME WILL TELL...";
    text[5584] = "THE CYCLE OF COSMIC CALAMITY IS UNYIELDING...";
    text[5585] = "PERHAPS THE UNIFICATION OF LUX AND ANTIMATTER IS THE KEY...";
    text[5586] = "...TWO FORCES THAT UNITE INTO A SPIRAL-LIKE POWER.";
    text[5587] = "CARRYING AN UNBREAKABLE WILL TO SURVIVE AND TO SEIZE THE FUTURE.";
    text[5588] = "THE PILLAR OF PEACE...";
    text[5589] = "...IS ONLY AS STRONG AS ITS FOUNDATION OF COMMUNICATION.";
    text[5590] = "THE ABILITY TO CONNECT THROUGH THE SOUL...";
    text[5591] = "...WILL BRING FORTH MUTUAL UNDERSTANDING.";
    text[5482] = "THE SACRED LUX COMBO OF THE ANCIENTS...";
    text[5483] = "THREE RELIC SWORDS... AND GUARDIA SHALL APPEAR IN BATTLE.";
    text[5653] = "SECTOR 12 - MT. PITON";
    text[5654] = "PEAK OF ETERNAL LIGHT";
    text[5655] = "This vending machine sells hand warmers and other camping accessories.";
    text[7397] = "You peer inside the hut and find nothing but darkness.";
    text[2795] = "This Warrior Vessel was brought in to help protect the citizens from danger.";
    text[3319] = "Copernicus Cafe is currently closed.";
    text[3326] = "This soldier is unconscious..";
    text[3327] = "Cold air seeps through the air vent.";
    text[3328] = "The door is locked. Resident Access Only.";
    text[3329] = "This door is locked.";
    text[3332] = "The WaterWorks Building is currently undergoing maintenance.";
    text[3333] = "It's a bed of Night Phlox.";
    text[3334] = "They have a pleasant honey-almond vanilla fragrance.";
    text[3335] = "This access hatch leads to the water reservoir infrastructure";
    text[3336] = "below the city. Unfortunately, it's locked from the other side.";
    text[3337] = "WARNING: FILTER MACHINES UNDER 24-HOUR SURVEILLANCE";
    text[3338] = "DO NOT TAMPER. AUTHORIZED PERSONNEL ONLY.";
    text[3339] = "You hear some strange noises from behind this door.";
    text[3340] = "Copernicus Hoverport";
    text[3341] = "SECTOR 7 - COPERNICUS\nNorthern District";
    text[3342] = "SECTOR 7 - COPERNICUS\nSouthern District";
    text[3343] = "SECTOR 7 - COPERNICUS\nCentral District";
    text[3344] = "This display is showing the map of Copernicus!";
    text[3345] = "There's a small note taped on the display:";
    text[3346] = "Input 1 - Up";
    text[3347] = "Input 2 - Right";
    text[3348] = "Input 3 - Down";
    text[3349] = "Input 4 - Left";
    text[3350] = "Input 5 - Right";
    text[3351] = "SECTOR 7 - COPERNICUS\nEastern District 439";
    text[3352] = "Welcome to Cafe Copernicus!";
    text[3353] = "Enjoy our delicious Cheesecake Bars and famous Strawberry Milkshakes!";
    text[3354] = "It's an abandoned Toolbox.";
    text[3355] = "There's a note inside with some numbers scribbled on it: 439625.";
    text[3356] = "This vending machine sells Choco Stix, a yummy chocolate almond wafer snack!";
    text[3382] = "Join our annual Oceanus fishing contest!";
    text[3383] = "We've got raffles, prizes, and free fried fish!";
    text[3384] = "One of the info stubs has something written on it:";
    text[3372] = "You put your ear against the door of the restroom.";
    text[3373] = "All you hear is an occasional meow and a purr.";
    text[3399] = "It's an antique poster advertising Cheesy Moon Pizza!";
    text[3400] = "There is a disclaimer at the bottom: 'In honor of National Moldy Cheese Day,";
    text[3401] = "we want to point out that the Moon is not actually made of cheese.' - WAZA";
    text[3402] = "The timestamp on this poster is dated October 9th, 2019.";
    text[3408] = "It's a poster advertising a tour-jet to visit Oceanus.";
    text[3409] = "'Come see the famous and beautiful Moon Stones up close!'";
    text[3410] = "Something else is scribbled on the bottom of the poster:";
    text[3411] = "This door leads to the kitchen.";
    text[3412] = "You peer through the blurry glass and vaguely see a small dog wearing a chef's hat.";
    text[3413] = "Food Safety Regulations and Employee Rights Documentation";
    text[3414] = "are posted up on this bulletin board.";
    text[3565] = "It's a high voltage Lunar Panel System.";
    text[3566] = "A devious jokester scribbled some cone puns on this cone.";
    text[3567] = "It's an abandoned traffic cone.";
    text[3568] = "This bucket is filled with nutrient-rich mineral water.";
    text[3569] = "SECTOR 8 - KEPLER RANCH";
    text[3573] = "It's a rusty red toolbox.";
    text[3574] = "What mysteries lurk inside? Nobody knows.";
    text[3575] = "It's a handy-dandy blue toolbox. Looks like it's been used frequently.";
    text[3576] = "The water wells provide a reliable and ample supply of fresh water";
    text[3577] = "for the residents here in Kepler Ranch.";
    text[3578] = "It's a large Power Generator disguised as a water well.";
    text[3580] = "Looks like a small store will be opening here soon.";
    text[3581] = "It's an old fashioned Community Board. Job Requests, Advertisements,";
    text[3582] = "Daily news, and flyers for weekend potlucks are posted here frequently.";
    text[3583] = "A small sticky note catches your eye.";
    text[3584] = "It has the numbers 323881 written on it.";
    text[3588] = "This sign points to the different farms in Kepler Ranch.";
    text[3589] = "These shipping containers are temperature controlled so that the food";
    text[3590] = "and produce inside stays fresh for long periods of time.";
    text[3591] = "A pile of freshly chopped wooden logs!";
    text[3592] = "Pumpkin, wheat, and lettuce plants are growing on this plot of land.";
    text[3593] = "Corn, wheat, and potatoes are growing on this plot of land.";
    text[3595] = "Some hand-washed clothes are hanging here to dry.";
    text[3596] = "This recycle bin is filled to the brim with cans of Hetap.";
    text[3597] = "The crops here have been violently removed from the soil.";
    text[3598] = "There's traces of antimatter on the soil here...";
    text[3599] = "It's a surviving mint plant. There's small footprints all around the soil.";
    text[3600] = "This vending machine is selling Red Velvet Cupcakes. It's fully stocked.";
    text[3603] = "Here at Ener-G Corp, your health is important to us.";
    text[3604] = "Please use this to improve your health! CODE: 501996";
    text[3605] = "ASTRO AVENUE";
    text[3606] = "SECTOR 15 - TYCHO";
    text[3607] = "Welcome to the city of science and technology!";
    text[3608] = "It's the Tycho BBS!";
    text[3609] = "Welcome to Tycho Cafe!";
    text[3610] = "Enjoy our delicious chicken sandwiches and famous Green Velvet Cupcakes!";
    text[3613] = "This vending machine is selling Green Velvet Cupcakes. It's sold out.";
    text[3614] = "It's an ad for Tycho Cafe's crispy chicken sandwich!";
    text[3615] = "This door requires a KEY CARD to enter.";
    text[3616] = "ENER-G CORP";
    text[3617] = "Quote of the Day: 'Reject common sense to make the impossible possible!'";
    text[3618] = "AUTHORIZED LUNEX FORCE PERSONNEL ONLY.";
    text[3619] = "LUNEX HQ - UNDERGROUND PRISON COMPOUND";
    text[3620] = "SEWAGE AREA - MAINTENANCE ACCESS ONLY";
    text[3621] = "LUNEX FORCE HQ - MILITARY BASE";
    text[3622] = "MILITARY BASE - MAIN ENTRANCE";
    text[3623] = "SECTOR 13 - GRIMALDI";
    text[3624] = "EAST - WASTELAND ZONE 1";
    text[3625] = "WEST - WASTELAND ZONE 2";
    text[4051] = "Would you like to enter the Sewage Area?";
    text[4054] = "You pressed the switch on the control panel!";
    text[4055] = "The nearby lasers were deactivated.";
    text[4056] = "The RED ARROW TILES have changed direction!";
    text[4206] = "LUNEX KEY CONFIRMED. ACCESS GRANTED.";
    text[4238] = "WARNING - HAZARDOUS WASTE.";
    text[4239] = "???? ROOM. This digital display is bugged out...";
    text[4240] = "ACCESS HATCH TO PRISON COMPOUND.";
    text[4366] = "-WEAPONS DEVELOPMENT-";
    text[4367] = "-JET SUIT PRODUCTION-";
    text[4368] = "-HISTORICAL ARCHIVES-";
    text[4369] = "-SERVER ROOM-";
    text[4370] = "-HOLO TECH RESEARCH LAB-";
    text[7273] = "It's a Model ZX Warrior Vessel.";
    text[7274] = "This console is monitoring the Antimatter level of the Vessel";
    text[7275] = "There's a memo on this display that says: 917624.";
    text[7276] = "This console is recharging the battery of the Vessel.";
    text[7281] = "Various data values such as oxygen and gravity levels";
    text[7282] = "for every Sector on Luna is displayed on this console.";
    text[7278] = "There is a missing persons list on this console.";
    text[7279] = "The names are redacted, and have been replaced with Test Subject numbers.";
    text[7329] = "CODENAME: Moleculoid. Resonance Rate: 25%.";
    text[7330] = "Subjects 270 to 276 - Antimatter Power Analysis: Fire Manipulation.";
    text[7331] = "Note: Subject appears to have an unstable atomic structure,";
    text[7332] = "which explains its 'explosive' nature.";
    text[7336] = "CODENAME: Grimrock. Resonance Rate: 16%.";
    text[7333] = "Subjects 136 to 138 - Antimatter Power Analysis: Mineral Manipulation.";
    text[7334] = "Note: Subject's shell is made of fortified Antimatter and regolith.";
    text[7335] = "This formula branch may prove useful for creating a durable Antimatter body.";
    text[7337] = "CODENAME: Replia. Resonance Rate: 76%.";
    text[7338] = "Subjects 1462 to 1465 - Antimatter Power Analysis: Semi-Phase Body.";
    text[7339] = "Note: Subject appears to look more humanoid compared to prior tests.";
    text[7340] = "We're finally making decent strides towards the perfected Serum.";
    text[7341] = "ANTIMATTER SPECTROSCOPY UNIT";
    text[7342] = "MURK SERUM STORAGE UNIT";
    text[7343] = "CODENAME: Avirell. Resonance Rate: 43%.";
    text[7344] = "Subjects 621 to 629 - Antimatter Power Analysis: Chaotic Flurry.";
    text[7345] = "Note: Subject's feathers have a strange property which allows it to";
    text[7346] = "dissipate the target's Lux.";
    text[7347] = "It seems Lux and Antimatter are inextricably intertwined.";
    text[7348] = "It's an empty test vial.";
    text[7349] = "CODENAME: Hyperbee. Resonance Rate 11%.";
    text[7350] = "Subjects 42 to 44 - Antimatter Power Analysis: Flight and Speed.";
    text[7351] = "Note: Formula branch for a guaranteed conversion is confirmed.";
    text[7352] = "Next step is to adjust the other variables in the formula.";
    text[7353] = "CODENAME: Specter. Resonance Rate 38%.";
    text[7354] = "Subjects 418 to 420 - Antimatter Power Analysis: Plasma Immunity.";
    text[7355] = "Note: Subject seems to have a greater immunity to our Plasma weaponry.";
    text[7356] = "All of them appear to have a wildly mischievous nature.";
    text[7368] = "Memo 36: Healing properties have been observed in Serum samples that have";
    text[7369] = "a Resonance Rate of 50% or above.";
    text[7370] = "The samples I've tested on myself seem to be working...";
    text[7371] = "...but it's just not good enough. Not yet.";
    text[7372] = "Memo 42: With our current Anticore reserves and a perfected Serum,";
    text[7373] = "we will be able to save at least 100,000 individuals.";
    text[7374] = "If we were to obtain the Murk Slayer's Anticores,";
    text[7375] = "that number will increase significantly.";
    text[7376] = "Memo 74: Simply attaining a new body is not enough.";
    text[7377] = "They will need more.";
    text[7378] = "They will need a sanctuary...";
    text[7379] = "...A place to call home.";
    text[7380] = "Memo 111: I'm so close...";
    text[7381] = "I was finally able to achieve 99% Resonance.";
    text[7382] = "I wish I had more time...";
    text[7383] = "The experiment has given me the immeasurable power I need...";
    text[7384] = "...at the cost of my own body.";
    text[7385] = "Regardless, I consider this experiment a success.";
    text[7386] = "Now that I have the Murk Slayer's Anticores...";
    text[7387] = "...my mission to save humanity can truly begin.";
    text[3523] = "Looks like this passageway has been closed off...";
    text[3524] = "It's a tombstone made of magnesium ore.";
    text[3525] = "Several names are written on this tombstone.";
    text[3526] = "All the names have the same date of death.";
    text[3527] = "PASSAGEWAY TO SECTOR 3 CLOSED UNTIL FURTHER NOTICE";
    text[3546] = "SECTOR 2 - MEMORIAL CLIFF";
    text[4784] = "SECTOR 2 - SILICA RIFTS";
    text[4785] = "TO MEMORIAL CLIFF";
    text[4786] = "TO MEMORIAL CLIFF";
    text[4787] = "The fire crackles softly.";
    text[4788] = "The Pod Ship has no more charge left in its battery.";
    text[4796] = "There's a strange locking mechanism around this Neural Link.";
    text[4797] = "The digital display has something written on it:";
    text[4798] = "'6 CRATERS'";
    text[4799] = "You found a small switch in the crater! You hit the switch.";
    text[4800] = "You hit the final switch.";
    text[4822] = "It's a crystal made of bloodquartz.";
    text[4823] = "These naturally luminescent crystals help miners";
    text[4824] = "navigate the dark depths of Silica Mines.";
    text[4825] = "WEST - MEMORIAL CLIFF";
    text[4826] = "EAST - COLONY SILICA";
    text[4827] = "SECTOR 1 - COLONY SILICA";
    text[4828] = "These crates are filled with mineral mining tools and supplies.";
    text[4829] = "Silica Mines";
    text[4830] = "You peer into the mine entrance and see some flickering lights.";
    text[4835] = "This vending machine is out of order.";
    text[4836] = "This vending machine is selling mini vending machines.";
    text[4837] = "This vending machine is selling beef jerky.";
    text[4838] = "Welcome to Cafe Silica!";
    text[4839] = "Enjoy our famous Chili Cheese Dogs and Spicy Curry!";
    text[4840] = "It's the Silica BBS!";
    text[4841] = "We don't have a space ship so we can't fly right now...";
    text[3653] = "There appears to be something here...";
    text[3654] = "...but you are unable to interact with it right now.";
    text[3655] = "The anticore in your possession seems to be reacting to the strange phenomena.";
    text[4873] = "You reach inside the antimatter cluster...";
    text[7903] = "These pipes are part of a large network that transports water from";
    text[7904] = "the northern Lunar ocean down to the local colonies.";
    text[7905] = "These crates contain equipment used for archaeological excavations!";
    text[7906] = "The engravings on this tablet depicts an ancient war.";
    text[7907] = "The bodies of the warriors appear to be enveloped in a strange aura.";
    text[7908] = "THE DUALITY OF ANTIMATTER AND LUX...";
    text[7909] = "The rest of the engravings are illegible.";
    text[7910] = "You peer through the window to admire the skyline of the city.";
    text[7911] = "There's a bunch of canned tuna behind the glass cabinet.";
    text[7918] = "It's a painting titled 'The Endless Now.'";
    text[7919] = "It's a Pretty Peach Ultimate Collector's Edition statue!";
    text[7923] = "It's BluBlu the Alien, from the Captain Moon series!";
    text[7924] = "It's a YeloMelo plushie and a painting of a cute dog titled 'New Horizons.'";
    text[7925] = "It's Cabinet-Senpai, from the Chairem anime!";
    text[7931] = "There's a bunch of household appliances behind this glass cabinet.";
    text[7932] = "It's a painting titled 'Don't Lose Your Way!'";
    text[7933] = "An anime called 'Three Piece' is currently playing on the TV.";
    text[7934] = "It's a painting titled 'Kiss of Death.'";
    text[7935] = "An anime called 'Life Note' is currently playing on the TV.";
    text[7936] = "There's a painting on the wall titled 'Monado.'";
    text[7937] = "It's a cool looking space suit prototype!";
    text[7938] = "There's a bunch of robotic parts, microchips, and electronics in the glass cabinet!";
    text[7939] = "An anime called 'The Titans Attack' is currently playing on the TV.";
    text[7940] = "A bunch of work-out equipment and boxing gloves are on the ground.";
    text[8006] = "Would you like to enter the mine?";
    text[7952] = "There's a missing persons list pinned to the bulletin board...";
    text[7953] = "These boxes contain an assortment of knowledge boosting vitamins.";
    text[7954] = "There's some broken Levistones on the floor.";
    text[7955] = "Looks like they were used a lot for training.";
    text[7957] = "It's a book titled, '101 Useful Battle Techniques.'";
    text[7961] = "Zara's Levistones are propped up on their charging stations.";
    text[7965] = "It's a Treasure Hunter's Guild certified grappling hook!";
    text[7966] = "It's a Treasure Hunter's Guild certified shovel!";
    text[7967] = "It's a Treasure Hunter's Guild certified pickaxe!";
    text[7968] = "Historical artifacts and treasures are being displayed in this cabinet.";
    text[7969] = "A movie called 'The Bark Knight' is currently playing on the TV.";
    text[7970] = "Lookin' for adventure? JOIN THE TREASURE HUNTER'S GUILD TODAY!";
    text[8555] = "A list of wanted criminals and fugitives are displayed on this monitor.";
    text[8556] = "A list of missing persons and citizen reports are on this monitor.";
    text[8557] = "A list of Murk incident locations are displayed on this monitor.";
    text[8558] = "This vending machine sells Thin Mints and Samoas!";
    text[8544] = "It's a decommissioned Minipod!";
    text[8563] = "It's an empty prison cell...";
    text[8564] = "You peer into the cell... It's dark, darker, yet darker.";
    text[8568] = "Inside these lockers are nothing but prison uniforms.";
    text[8569] = "This door leads to the cafeteria.";
    text[8570] = "You're trying your best to resist the urge to pull the fire alarm...";
    text[8571] = "There's a 'Pickle Rick' Sticker on this locker!";
    text[8572] = "These walls seem to be reinforced with Holo-Tech.";
    text[8573] = "It's a modified sleeping pod with limited capabilities.";
    text[8574] = "Several experimental grenades are lined up together.";
    text[8575] = "It's a Boomerang! It's super useful against multiple enemies!";
    text[8576] = "It's a Hydro Blaster! This weapon can inflict DRENCH on enemies!";
    text[8577] = "Several experimental gun sabers are lined up together.";
    text[8578] = "Various Jet Suit models are lined up against the wall.";
    text[8579] = "It's a data server used to monitor the Military Cyber-Network.";
    text[8580] = "It's a bunch of spaghetti code! EVERYWHERE!";
    text[8581] = "These Holo Stars were used to generate Vivia's Holo-Field trap.";
    text[8582] = "Not sure what this control panel is for...";
    text[8583] = "It's Vivia's research terminal.";
    text[8584] = "It's a Biometric Antimatter Extractor.";
    text[8585] = "There's a cool sci-fi book here titled, 'Dune'.";
    text[8586] = "There's a cool sci-fi book here titled, 'Ender's Game'.";
    text[8587] = "There's a cool sci-fi book here titled, 'The Hitchhiker's Guide to the Galaxy'.";
    text[8588] = "There's a cool sci-fi book here titled, 'The Martian'.";
    text[8589] = "There's a book here titled, 'The History of Luna's Terraformation'.";
    text[8590] = "There's a book here titled, 'The Fall of Terra'.";
    text[8591] = "There's a book here titled, 'Lunar Economics'.";
    text[8592] = "There's a book here titled, 'Mysteries of the Cosmos'.";
    text[8791] = "There's a memo on this display that says: 824913.";
    text[10503] = "Hey Raine, what's up?";
    text[10504] = "You got any plans for today, warrior prodigy?";
    text[10505] = "Hmmm... ";
    text[10506] = "I was gonna go and check the Missions Board to see if there's anything new.";
    text[10507] = "Why?";
    text[10508] = "Well, scrap your plans!";
    text[10509] = "The Raine Squad is hosting a Beach Party, and you're all invited! BAHAHAHA!";
    text[10510] = "Oooo, that sounds fun!";
    text[10511] = "Nickle, Tetra, what do you two think? Wanna go?";
    text[10512] = "Beach Party?! Let's go! Let's go!";
    text[10513] = "I finally have a good excuse to wear these cool sunglasses, heh.";
    text[10514] = "I've got a weird feeling that this is just an elaborate plan";
    text[10515] = "set up by Raine to get us to fight her again...";
    text[10516] = "BAHAHAHA! NO PROMISES!";
    text[10517] = "Regardless, I'm up for a nice and relaxing day at the beach.";
    text[10518] = "PERFECT!";
    text[10519] = "Meet us at Summer's Cove! It's a small beach located north of Oceanus!";
    text[10520] = "...and bring lots of sunscreen!";
    text[10522] = "So, where's the party?";
    text[10523] = "Head's up!";
    text[10524] = "*BONK*";
    text[10525] = "Great, you're all here!";
    text[10526] = "We've got everything set up over there!";
    text[10527] = "Hi Melody! Hi Zara!";
    text[10528] = "Please tell me you brought Cheesecake Bars?";
    text[10529] = "We did! We brought all kinds of snacks, hehe.";
    text[10530] = "...and I brought pool floaties for everyone.";
    text[10531] = "Sweet! You guys are the best!";
    text[10532] = "Now then... It's time for some fun in the sun! Woo hoo!";
    text[12140] = "Ahh, I never knew such a beautiful beach like this existed on Luna.";
    text[12141] = "Same here. Seeing the palm trees was an unexpected surprise.";
    text[12153] = "I thought palm trees couldn't grow organically on Luna.";
    text[12142] = "Ah, the palm trees here aren't real... They're just props.";
    text[12143] = "Wait... really?!";
    text[12149] = "Yep!";
    text[12150] = "Now, before you ask me how I know this...";
    text[12144] = "Summer's Cove... was my late Grandpa's summertime retreat.";
    text[12145] = "His dream was to recreate the beautiful Terran beaches he had read about";
    text[12146] = "in history books so that our family could have vacations here.";
    text[12147] = "Even though he's gone, I'd like to carry on his dream,";
    text[12148] = "and share wonderful memories here on this beach with my friends.";
    text[12151] = "Raine, your Grandpa did a fantastic job building this place.";
    text[12152] = "I'm sure it wasn't easy... but it was definitely worth it.";
    text[12154] = "We'll make sure to keep this beach clean!";
    text[12155] = "Agreed. It would be nice to come back here once in a while to relax.";
    text[12156] = "You guys... I appreciate that.";
    text[12157] = "Heheheh.";
    text[12158] = "HUH?! What're you two giggling about?";
    text[12159] = "It's nice to see you being a little sentimental for once, Raine.";
    text[12160] = "SENTIMENTAL?! ME?! Yeah, right!";
    text[12161] = "BAHAHAHAHA!";
    text[12162] = "Well, that lasted about as long as I expected.";
    text[12163] = "Eheheh, pretty much.";
    text[10533] = "Alright everyone, now it's time for the MAIN EVENT!";
    text[10534] = "Main event?! What are you up to now, Raine?";
    text[10535] = "Grab a pool floatie and follow me!";
    text[10536] = "Ta Dah!";
    text[10537] = "It's splashy!";
    text[10538] = "It's wild!";
    text[10539] = "It's the Raine Squad's surfing extravaganza: WAVY WATERS!";
    text[10540] = "Woah! This looks like a fun obstacle course!";
    text[10541] = "Holy moly! When did you three have the time to set this up?!";
    text[10542] = "It didn't take too long, actually.";
    text[10543] = "We deployed a bunch of drones to help us.";
    text[10544] = "WAVY WATERS was designed to be an endless obstacle course.";
    text[10545] = "The goal is to survive for as long as you can while collecting the Cheesecake Bars!";
    text[10546] = "...and the team that collects the most Cheesecake Bars, wins a sweet PRIZE!";
    text[10547] = "Keep in mind, your floaties can only take up to 5 hits before it pops.";
    text[10548] = "Wait... Are those actual Cheesecake Bars?";
    text[10549] = "Nah, they're holograms.";
    text[10550] = "The drones are doing a lot of the heavy-lifting in terms of presentation.";
    text[10551] = "The rocks are real though... and they hurt!";
    text[10552] = "Oh gosh...";
    text[10553] = "...and what happens if we lose?";
    text[10554] = "YOU MUST FIGHT US! BAHAHAHA!";
    text[10555] = "Of course. Why am I not surprised?";
    text[10556] = "I knew there was a catch.";
    text[10557] = "This was definitely an elaborate scheme...";
    text[10558] = "HEY, I LIKE SETTING UP PARTY GAMES AND SPARRING WITH MY FRIENDS, OKAY?";
    text[10559] = "Has Raine always been like this?";
    text[10560] = "Pretty much!";
    text[10561] = "...and you guys just go along with her crazy schemes?";
    text[10562] = "I'll admit, it's never a dull day with Raine. She knows how to have fun!";
    text[10563] = "Agreed.";
    text[10564] = "Now, let's get this party started! Brace yourselves for WAVY WATERS!";
    text[10565] = "WAVY WATERS MINI-GAME";
    text[10566] = "JUMP";
    text[10567] = "MOVE";
    text[10569] = "NO WAY! WHAT THE HELL!?";
    text[10570] = "WE LOST BY ONE CHEESECAKE BAR!";
    text[10571] = "Heh. That was actually really fun!";
    text[10572] = "Yeah! Yeah! I want to try the obstacle course again!";
    text[10573] = "You can play WAVY WATERS as many times as you'd like, Tetra.";
    text[10574] = "Hey so, what's our prize? You mentioned there was a prize.";
    text[10575] = "Heheh... ";
    text[10576] = "Heheheheh...";
    text[10577] = "BAHAHAHA!";
    text[10578] = "Oh no...";
    text[10579] = "Your prize is...";
    text[10580] = "...the opportunity to have a rematch with the Raine Squad!";
    text[10581] = "... ... ...You know what?";
    text[10582] = "BRING IT ON!";
    text[10583] = "I've been itching to squeeze in some training anyways.";
    text[10584] = "Me too! Me too!";
    text[10585] = "A superhero must always be ready for anything!";
    text[10586] = "You three may have beaten us last time, but this time...";
    text[10587] = "...we came prepared! We won't hold back!";
    text[10588] = "Dang! Raine's competitive spirit sure has rubbed off on you, Melody.";
    text[10589] = "Bella, as the Lunex Force's new general, you'll need good training partners";
    text[10590] = "who will push you to overcome your limits and reach new heights.";
    text[10591] = "We'll happily spar with you as many times as you wish.";
    text[10592] = "Guys... I couldn't have asked for better training partners...";
    text[10593] = "Nickle... Tetra...";
    text[10594] = "LET'S GEAR UP FOR BATTLE!";
    text[10595] = "Ahhh... that was... A BLAST!";
    text[10596] = "IT SUCKED THAT WE LOST THOUGH...";
    text[10597] = "MARK MY WORDS... ONE OF THESE DAYS, THE RAINE SQUAD WILL BE VICTORIOUS!";
    text[10598] = "Incredible... The team dynamic you three possess is simply incredible!";
    text[10599] = "I think I need an ice pack... Ouchy...";
    text[12116] = "Here Bella, we want you to have this.";
    text[12118] = "Oh? What's this?";
    text[12119] = "Consider it as a congratulatory gift from us...";
    text[12122] = "...to our beloved warrior prodigy, BAHAHAHA!";
    text[12117] = "Awe, thank you! You guys are the best!";
    text[12123] = "A few hours later...";
    text[10600] = "I think it's time we call it a day.";
    text[10601] = "Thanks for setting up this party. I had a ton of fun!";
    text[10602] = "Same here!";
    text[10603] = "Life is all about balance.";
    text[10604] = "After everything we've been through lately,";
    text[10605] = "I think we all deserved a little getaway like this.";
    text[10606] = "Definitely!";
    text[10607] = "Alright team, let's zip!";
    text[10608] = "*BEACH_EPISODE_COMPLETE!*";
    text[10615] = "What's up, Bella? You wanna have a rematch with the Raine Squad?";
    text[10616] = "LET'S BRAWL!";
    text[10617] = "Maybe next time...";
    text[10618] = "HELL YEAH, YOU'RE GOING DOWN!";
    text[10619] = "M-07: Monsters of Magnesia";
    text[10620] = "We received distress signals from three of our soldiers who were";
    text[10621] = "patrolling the outskirts of the abandoned sector: Magnesia.";
    text[10622] = "The soldiers reported encountering what they described as";
    text[10623] = "strange 'monsters' that did not appear to be Murks.";
    text[10624] = "Before we could inquire further, we lost communications with them.";
    text[10625] = "Your mission is to investigate the 'Monsters of Magnesia',";
    text[10626] = "and rescue our fellow Lunex Force Soldiers.";
    text[10768] = "Magnesia...";
    text[10769] = "That's the abandoned sector we saw in the distance";
    text[10770] = "before we arrived at Colony Silica.";
    text[10771] = "Public records state that the destruction of Magnesia was";
    text[10772] = "single-handedly caused by an extremely powerful Murk...";
    text[10773] = "Hmm...";
    text[10774] = "...what's on your mind, Bella?";
    text[10775] = "I wonder if there's some sort of connection between the 'monsters'";
    text[10776] = "our soldiers reported, and the 'Murk' that destroyed Magnesia?";
    text[10777] = "Has anyone seen what it looks like, and is it still out there?";
    text[10778] = "Bella, the destruction of Magnesia happened many years ago...";
    text[10779] = "I highly doubt there's any information laying around...";
    text[10780] = "Hmm...";
    text[10781] = "There's only one thing I can think of...";
    text[10782] = "Saros' secret servers.";
    text[10783] = "Are you saying there's a chance Saros might have a record of";
    text[10784] = "the day Magnesia was destroyed?";
    text[10785] = "Since public records state that the incident was Murk related...";
    text[10786] = "Yes... I think there's a good chance.";
    text[10787] = "What if the Monsters of Magnesia was just another one of his experiments?";
    text[10788] = "Saros has covered up a ton of shady stuff throughout the years...";
    text[10789] = "It doesn't hurt to check.";
    text[10790] = "...Yeah.";
    text[10791] = "...and how do we access the secret servers?";
    text[10792] = "Nyla can help us. She's been working with her team of data analysts";
    text[10793] = "to extract and decrypt all the files in the secret servers.";
    text[10794] = "Let's check in with Nyla really quick, before we head to Magnesia.";
    text[10795] = "She should be in the Nexus Lab. Let's go!";
    text[10796] = "Hey, Miss Nyla.";
    text[10797] = "Hello, dear. So what brings you here?";
    text[10798] = "We're on a mission to investigate some strange monsters who";
    text[10799] = "were spotted in the abandoned sector, Magnesia.";
    text[10800] = "We've gotta head out very soon to find our stranded soldiers...";
    text[10801] = "...but before we go...";
    text[10802] = "Do you mind sending me any files Saros may have kept in";
    text[10803] = "his secret servers regarding Magnesia, its destruction,";
    text[10804] = "and the Murk sightings that have been reported there?";
    text[10805] = "I want to make sure we're fully prepared for this mission.";
    text[10806] = "I don't mind at all, dear! By all means,";
    text[10807] = "Please proceed to Magnesia to rescue our soldiers.";
    text[10808] = "If I find any relevant files, I'll send it over to Tetra right away.";
    text[10809] = "Thanks Miss Nyla!";
    text[10810] = "Come on team, let's head to Magnesia!";
    text[10701] = "In order to reach Magnesia,";
    text[10702] = "we have to hike through the Forsaken Trail.";
    text[10703] = "Are you guys ready?";
    text[10704] = "Once we enter, we have to commit to completing this mission.";
    text[10705] = "Our Lunex Force comrades are counting on us!";
    text[10706] = "I'm ready!";
    text[10707] = "I'm not ready yet...";
    text[10708] = "Let's go go go!";
    text[10709] = "... ... ...";
    text[10710] = "Nickle, are you okay?";
    text[10711] = "Y-yeah, why?";
    text[10712] = "You look a bit shaken...";
    text[10713] = "... I'm okay. Let's go.";
    text[12211] = "Wow... This road is in pretty bad shape...";
    text[12212] = "This was once a bustling highway that people used";
    text[12213] = "in order to travel between Colony Magnesia and Colony Silica.";
    text[12214] = "Now... it's been abandoned and forgotten. ...which is why,";
    text[12215] = "the Lunex Database refers to this road as the 'Forsaken Trail'.";
    text[12216] = "Uhm... Bella?";
    text[12217] = "What is it, Tetra?";
    text[12218] = "I SEE SOMETHING!";
    text[12219] = "Woah... I think those things are the 'strange monsters' our soldiers reported!";
    text[12220] = "Do you think it could be a Murk?";
    text[12221] = "I'm not sure... It doesn't really look like a Murk.";
    text[12222] = "Whatever it is... it's definitely not human.";
    text[12223] = "We need to get closer to take a better look.";
    text[12224] = "Let's chase after it!";
    text[12225] = "Roger that!";
    text[12226] = "... ... ...";
    text[10627] = "We're too late...";
    text[10628] = "The Lunex Soldiers... They're dead...";
    text[10629] = "Bella, hostile enemies detected!";
    text[10630] = "CORRUPT... CORRUPT... CORRUPTOID!";
    text[10631] = "Wait a minute... These guys are Ancient entities!";
    text[10632] = "Are you sure?";
    text[10633] = "I think so.";
    text[10634] = "Their lux feels similar to Guardia and Lumiknight...";
    text[10635] = "...but something feels off...";
    text[10636] = "...it's almost like they've been corrupted...";
    text[10637] = "I thought the Ancients were on our side...";
    text[10638] = "...why would they hurt innocent lives?";
    text[10639] = "I don't know... but, we can't let them get away with this!";
    text[10640] = "We have to avenge our fallen comrades!";
    text[10641] = "Let's gear up for battle!";
    text[10642] = "Guardia!?";
    text[10643] = "GREETINGS, SOUL SENSER...";
    text[10648] = "Guardia, do you know what's going on here?";
    text[10649] = "Ancient entities have attacked our soldiers...";
    text[10650] = "There's something out there...";
    text[10651] = "...and it feels like pure malice...";
    text[10861] = "MY SENSORS HAVE DETECTED THAT ONE OF OUR GUARDIAN ENTITIES";
    text[10862] = "HAS REAWAKENED...";
    text[10863] = "...AND ITS NAME IS 'NECROMIA'.";
    text[10873] = "Necromia...";
    text[10874] = "I recall seeing an Ancient Text that mentioned that name...";
    text[10875] = "It was a guardian entity that had the ability to manipulate the mind.";
    text[10876] = "M-Mind control?! Are you serious?!";
    text[10877] = "THAT IS CORRECT.";
    text[10864] = "...AND FOR REASONS WHICH I AM UNAWARE,";
    text[10865] = "NECROMIA'S PROGRAMMING HAS BEEN CORRUPTED.";
    text[10866] = "SUBSEQUENTLY, ALL OF NECROMIA'S SOLDIERS HAVE BEEN CORRUPTED AS WELL.";
    text[10868] = "A corrupted Ancient entity... How does that even happen?";
    text[10869] = "UNFORTUNATELY, I DO NOT KNOW...";
    text[10867] = "BUT, WHAT I DO KNOW IS...";
    text[10870] = "NECROMIA IS AN ENTITY FAR MORE POWERFUL THAN I...";
    text[10878] = "...AND NOW...";
    text[10871] = "INSTEAD OF SERVING TO PROTECTING LUNA,";
    text[10879] = "NECROMIA SEEKS TO DESTROY IT.";
    text[10872] = "WITHOUT MY VESSEL, I AM UNABLE TO STOP NECROMIA MYSELF...";
    text[10880] = "...AND SO, I ASK FOR YOUR ASSISTANCE.";
    text[10665] = "Don't worry, Guardia!";
    text[10666] = "We'll do our best to prevent Necromia from hurting anyone else!";
    text[10667] = "YOU MUST ACT QUICKLY...";
    text[10812] = "Guardia?!";
    text[10813] = "What's wrong?!";
    text[10821] = "MY TIME HAS COME...";
    text[10814] = "I WILL... DISAPPEAR SOON...";
    text[10815] = "THE REST... IS UP TO YOU...";
    text[10816] = "BELLA GREY.";
    text[10817] = "YOUR LUX IS LIMITLESS...";
    text[10818] = "PLEASE USE IT...";
    text[10819] = "TO PROTECT... OUR HOME...";
    text[10645] = "Guardia...";
    text[10646] = "Thank you for everything...";
    text[10647] = "It's thanks to you that I was able to reunite with my Mom,";
    text[10822] = "and unlock my Soul Sensing.";
    text[10820] = "I will honor your brave sacrifice and your final words...";
    text[10823] = "Let's keep going.";
    text[10860] = "We have to find Necromia before it's too late!";
    text[10827] = "Wait...";
    text[10828] = "I don't think it's a good idea for you two to keep going.";
    text[10829] = "Huh?! Why?";
    text[10830] = "We're a team, remember?";
    text[10831] = "We're stronger together than we are apart...";
    text[10832] = "I know but... Please let me handle this...";
    text[10833] = "You heard Guardia. Necromia can control minds...";
    text[10834] = "...I don't want to risk losing the two of you.";
    text[10835] = "I need to do this myself...";
    text[10845] = "Especially since we're here in Magnesia...";
    text[10837] = "Nickle...";
    text[10836] = "You've been distant ever since we started this mission.";
    text[10838] = "...What are you not telling us?";
    text[10725] = "If I tell you... You'd never forgive me...";
    text[10839] = "Nickle, we're here for you.";
    text[10840] = "You don't have to go through this alone.";
    text[10841] = "No, you don't understand.";
    text[10842] = "If I tell you... we can no longer be friends...";
    text[10843] = "...";
    text[10844] = "I would rather know the truth, than to hide behind lies.";
    text[10726] = "How bad can it really be?";
    text[10727] = "It's the worst you could possibly imagine.";
    text[10728] = "It's the reason why I'm so...";
    text[10729] = "...messed up.";
    text[10730] = "...";
    text[10731] = "On the day Magnesia was destroyed,";
    text[10732] = "I was ambushed by Saros and the Lunex Force.";
    text[10733] = "It was his third attempt at capturing me...";
    text[10734] = "I was exhausted...";
    text[10735] = "I was scared...";
    text[10736] = "I was angry...";
    text[10737] = "I hated Saros...";
    text[10738] = "...and I hated myself for having these powers...";
    text[10739] = "It wasn't fair...";
    text[10740] = "...being treated like a monster... like a lab rat...";
    text[10741] = "I couldn't take it anymore...";
    text[10742] = "Instead of running away that day, I decided to fight back.";
    text[10743] = "I unleashed my rage... My body transformed...";
    text[10744] = "...and my antimatter began to consume my mind...";
    text[10745] = "I gave Saros exactly what he wanted...";
    text[10748] = "...a monster.";
    text[10749] = "...and this moment of rage...";
    text[10746] = "...was the single greatest mistake of my life.";
    text[10747] = "At the time, I was still unable to control my full power...";
    text[10750] = "After I transformed into my Phase Mode,";
    text[10751] = "Everything was a blur. I don't remember what happened...";
    text[10752] = "By the time I came to my senses, it was already too late...";
    text[10753] = "Colony Magnesia was destroyed...";
    text[10754] = "...and I was the only one left standing...";
    text[10755] = "The people of Magnesia died because of ME...";
    text[10756] = "...and there's no way to bring them back...";
    text[10757] = "Ever since that day, I spent every single waking moment of my life";
    text[10758] = "filled with guilt, shame, and fear.";
    text[10759] = "Fearful of hurting others...";
    text[10760] = "Fearful of what I would do if I ever used my full power again...";
    text[10761] = "...I was weak...";
    text[10762] = "I'm the one who deserves to...";
    text[10763] = "Nickle...";
    text[10764] = "Bella, I don't think I can bring myself to face you again...";
    text[10765] = "...I have to atone for what I've done.";
    text[10766] = "I'm sorry...";
    text[10846] = "...!";
    text[10847] = "...I can't believe this...";
    text[10848] = "This can't be true...";
    text[10849] = "Bella...";
    text[10850] = "We can't just let him go out there by himself.";
    text[10851] = "He's gonna get himself killed.";
    text[10852] = "Bella!";
    text[10853] = "Nyla found something from Saros' secret servers!";
    text[10854] = "Let's read the report...";
    text[10855] = "... ... ...";
    text[10856] = "BELLA!";
    text[10857] = "RIGHT. WE NEED TO FIND NICKLE!";
    text[10858] = "HE NEEDS TO KNOW. LET'S HURRY!";
    text[10714] = "Woah, an earthquake?!";
    text[10715] = "I can feel it...";
    text[10716] = "...an immense power lies ahead.";
    text[10720] = "Let's keep going...";
    text[10721] = "I have a bad feeling about this...";
    text[10881] = "Nickle!";
    text[10882] = "We've been looking everywhere for you!";
    text[10883] = "We received a report from Nyla about the incident in Magnesia.";
    text[10884] = "There is something you NEED to know!";
    text[10885] = "... ... ... ...";
    text[10886] = "Nickle?";
    text[10887] = "I AM AFRAID YOUR FRIEND IS NO LONGER WITH US...";
    text[10888] = "You must be Necromia.";
    text[10889] = "INDEED I AM... INDEED I AM...";
    text[10915] = "WHEN I AMBUSHED YOUR FRIEND...";
    text[10890] = "HE DID NOT APPEAR TO REMEMBER ME...";
    text[10891] = "IT WAS STRANGE... IT WAS STRANGE...";
    text[10892] = "...BECAUSE I REMEMBER HIM CLEARLY...";
    text[10916] = "ALL THESE YEARS... ALL THESE YEARS...";
    text[10917] = "BUILDING UP ENOUGH ENERGY TO AWAKEN ONCE AGAIN...";
    text[10893] = "Nickle, please snap out of it!";
    text[10894] = "Necromia has taken control of your mind!";
    text[10895] = "HE CANNOT HEAR YOU... HE CANNOT HEAR YOU...";
    text[10896] = "YOUR FRIEND... IS NOW MY MINDLESS PAWN!";
    text[10909] = "GIVE HIM BACK YOU STUPID HUSK!";
    text[10910] = "YOU SEE... I DO NOT HAVE A PHYSICAL BODY.";
    text[10911] = "MY VESSEL HAS LONG SINCE BEEN DESTROYED...";
    text[10912] = "...DESTROYED BY HIM. ...DESTROYED BY HIM.";
    text[10913] = "...AND NOW, I WILL USE HIS BODY AS MY NEW VESSEL.";
    text[10918] = "IT IS UNFORTUNATE...";
    text[10914] = "HE DOES NOT REMEMBER... HE DOES NOT REMEMBER...";
    text[10897] = "I CAN SENSE IT...";
    text[10898] = "HIS MIND IS FILLED WITH SELF HATRED...";
    text[10899] = "EVEN NOW... HE FIGHTS BACK...";
    text[10900] = "HE FEARS... HE FEARS...";
    text[10901] = "HE IS AFRAID TO HURT YOU...";
    text[10902] = "I SHALL TURN HIS NIGHTMARES INTO REALITY!";
    text[10903] = "Nickle, don't let it control you!";
    text[10904] = "You're stronger than this!";
    text[10905] = "FIGHT IT BACK!";
    text[10906] = "FIGHT, YOU SAY? FIGHT, YOU SAY?";
    text[10907] = "IF IT'S A FIGHT YOU WANT...";
    text[10908] = "...A FIGHT YOU SHALL GET!";
    text[10922] = "Nickle, you did it!";
    text[10923] = "You broke free from Necromia's mind control!";
    text[10919] = "IMPOSSIBLE... IMPOSSIBLE...";
    text[10924] = "THIS CANNOT BE...";
    text[10925] = "YOU MUST BE ERADICATED... THIS CANNOT BE...";
    text[10920] = "I remember now...";
    text[10921] = "I remember EVERYTHING.";
    text[10926] = "But... it wasn't my memories that I unlocked.";
    text[10927] = "...it was yours, Necromia.";
    text[10928] = "THAT WAS INTENTIONAL... INTENTIONAL...";
    text[10929] = "I SHARED MY MEMORIES SO THAT...";
    text[10930] = "...YOU UNDERSTAND THE REASON I DESPISE YOU...";
    text[10931] = "You and I... we fought once before.";
    text[10932] = "On the day Magnesia was destroyed.";
    text[10933] = "Bella, what did Nyla's report say?";
    text[10960] = "The public records that document the destruction of Magnesia was";
    text[10980] = "all a cover-up devised by Saros to protect his reputation...";
    text[10981] = "...all because his plan to capture you that day had failed.";
    text[10934] = "In an effort to test out the capabilities of his Murk Serum...";
    text[10935] = "Saros decided to experiment on an Ancient entity the archeology";
    text[10936] = "team had encountered years ago.";
    text[10937] = "This Ancient entity... was Necromia.";
    text[10938] = "...and Saros was responsible for its corruption.";
    text[10942] = "CORRUPTION... CORRUPTION...";
    text[10939] = "He had reprogrammed Necromia in an effort to use its power";
    text[10940] = "to try and control me...";
    text[10941] = "...and it failed.";
    text[10943] = "...because that day, I wasn't in control.";
    text[10944] = "My mind had already been severed...";
    text[10945] = "...and my body was running on pure survival instinct.";
    text[10946] = "As soon as Saros understood that Necromia wasn't able to control me,";
    text[10947] = "he changed his plans, and instructed Necromia to attack the city.";
    text[10948] = "...AND THAT I DID... AND THAT I DID...";
    text[10949] = "PURE DESTRUCTION...";
    text[10950] = "IT WAS... IT WAS...";
    text[10951] = "FASCINATING...";
    text[10952] = "ALTHOUGH YOUR MIND WAS LOST...";
    text[10982] = "YOUR BODY MOVED ON ITS OWN...";
    text[10953] = "YOUR INSTINCT... WAS TO PROTECT THE INNOCENT...";
    text[10954] = "YOU TRIED TO STOP ME... AND THAT, YOU DID...";
    text[10956] = "YOU UNLEASHED AN ATTACK SO POWERFUL...";
    text[10957] = "MY VESSEL HAD CRUMBLED INTO STARDUST...";
    text[10955] = "...BUT NOT BEFORE I HAD ALREADY DESTROYED THE CITY!";
    text[10969] = "...and you'll never destroy anything again.";
    text[10970] = "It's over, Necromia.";
    text[10979] = "UNFORTUNATELY FOR YOU... IN THIS FORM...";
    text[10975] = "YOU CANNOT HURT ME... YOU CANNOT HURT ME...";
    text[10983] = "You're wrong.";
    text[10976] = "With the power of Antimatter...";
    text[10977] = "...combined with the power of Lux...";
    text[10978] = "...there's nothing we can't do.";
    text[10971] = "Bella!";
    text[10972] = "Right behind you! Time for some Soul Sensing!";
    text[10973] = "THIS IS FOR... THE PEOPLE OF MAGNESIA!";
    text[10974] = "HIYAHHHHHHH!";
    text[10986] = "People often say, that ignorance is bliss...";
    text[10987] = "Having known true darkness and the secrets of the Murks,";
    text[10988] = "I would envy those who were ignorant to the truth.";
    text[10989] = "...but in this case,";
    text[10990] = "my ignorance was a curse.";
    text[10991] = "For years,";
    text[10963] = "I was led to believe that I was the one who destroyed Magnesia...";
    text[10964] = "and, even though I didn't kill these people...";
    text[10965] = "I still feel responsible for what happened...";
    text[10966] = "The people of Magnesia died because...";
    text[10984] = "I wasn't strong enough to protect them.";
    text[10967] = "Nickle...";
    text[10968] = "You have to learn to forgive yourself...";
    text[10992] = "What you were born with...";
    text[10995] = "What bad people like Saros have decided to do,";
    text[10996] = "because of what you were born with...";
    text[10997] = "...because of knowledge, power, and twisted goals...";
    text[10998] = "...all of those things are not your fault...";
    text[10999] = "Right now, you have the opportunity to bring justice.";
    text[11000] = "Justice...";
    text[10993] = "...Right.";
    text[10994] = "That's why I've been working so hard to collect Anticores...";
    text[11001] = "Exactly.";
    text[11002] = "You and I both...";
    text[11021] = "We want to help bring the people who suffered from Saros' hands,";
    text[11003] = "back to their families and loved ones.";
    text[11004] = "...but the people of Magnesia...";
    text[11005] = "...there's no way to bring them back.";
    text[11006] = "That's not entirely true...";
    text[11007] = "Huh? What do you mean?";
    text[11008] = "There was one more thing in the report Nyla sent us...";
    text[11009] = "Necromia may have destroyed the city...";
    text[11010] = "...but it didn't kill everyone.";
    text[11011] = "All of the survivors were gathered up by Saros' soldiers and...";
    text[11012] = "...they were all used as test subjects for his Murk experiments.";
    text[11013] = "These survivors...";
    text[11014] = "They are out there somewhere... as Murks...";
    text[11016] = "...and it's our job to find them and bring them home.";
    text[11057] = "... ... ...";
    text[11051] = "*sniff*";
    text[11052] = "Woah, hey! It's okay, Nickle.";
    text[11053] = "I... *sniff* ...I'm sorry...";
    text[11054] = "I'm just...";
    text[11055] = "...relieved to know there's still a chance to make things right...";
    text[11056] = "*sniff*";
    text[11017] = "Bella...";
    text[11022] = "Tetra...";
    text[11018] = "...I would not have made it this far without the two of you...";
    text[11019] = "Thanks for being there for me...";
    text[11020] = "That's what friends are for!";
    text[11023] = "We're the Three Lunar Musketeers, remember?";
    text[11024] = "Definitely.";
    text[11025] = "Before we go...";
    text[11026] = "I'd like to pay my respects to the people of Magnesia...";
    text[11027] = "...and to the Lunex Soldiers who died here today.";
    text[11028] = "Of course, take as much time as you need.";
    text[11029] = "-MONSTERS OF MAGNESIA-\nMISSION COMPLETE!";
    text[11030] = "Bella...";
    text[11031] = "What's up?";
    text[11032] = "I was wondering if I could challenge you to a duel.";
    text[11033] = "A duel?! Here?";
    text[11034] = "Yeah.";
    text[11035] = "This might sound silly but...";
    text[11036] = "I want to show the people of Magnesia,";
    text[11037] = "that I'm doing by best to get stronger.";
    text[11038] = "...and you're the strongest fighter I know.";
    text[11039] = "So, do you want to fight?";
    text[11040] = "Winner takes the loser out for dinner.";
    text[11041] = "Oh? Is this your way of asking me out?";
    text[11042] = "Wh-what? Uhm...";
    text[11047] = "I guess...";
    text[11043] = "You didn't say no, so I assume that's a yes.";
    text[11044] = "Challenge accepted, heh.";
    text[11045] = "...but be warned, I won't go easy on you.";
    text[11046] = "I wouldn't want you to.";
    text[11048] = "Just for you... I'll go Phase Mode.";
    text[11049] = "Sweet! Let's do this!";
    text[11050] = "Would you like to battle Nickle?";
    text[11072] = "So this is Ener-G Corp...";
    text[11073] = "Heheheh...";
    text[11075] = "Soon...";
    text[11076] = "Very soon...";
    text[11074] = "(This guy looks suspicious...)";
    text[11069] = "Sir, is there something we can help you with?";
    text[11070] = "No... Mind your own business.";
    text[11071] = "Scram, kid.";
    text[11077] = "M-06: Ener-G Corp Takeover";
    text[11078] = "The Ener-G Corp Building located in Tycho has been taken over";
    text[11079] = "by the Ravagers, a band of thieves who are known for stealing";
    text[11080] = "valuable items and selling them for profit on the black market.";
    text[11081] = "They are highly dangerous, and their motives are unknown...";
    text[11082] = "Your mission is to infiltrate Ener-G Corp,";
    text[11083] = "arrest the nefarious Ravagers,";
    text[11084] = "and find out what they are trying to steal!";
    text[11085] = "Hey, what's the current situation?";
    text[11086] = "Miss Bella, we evacuated as many people as we could,";
    text[11087] = "but the Ravagers have taken the CEO and his employees";
    text[11088] = "hostage in the upper levels.";
    text[11089] = "To better assess the situation, we deployed our drones";
    text[11090] = "to scan the building and they discovered timed explosives!";
    text[11091] = "Whatever it is the Ravagers are after, they want it FAST,";
    text[11092] = "and they're willing to blow up the building to get it.";
    text[11093] = "Seriously... Why are they going through all of this trouble";
    text[11094] = "to rob a company that makes Ener-G drinks?";
    text[11095] = "Uhm... excuse me,";
    text[11096] = "I think I know what the Ravagers might be after...";
    text[11097] = "We've been developing a new Ener-G formula for a few years now...";
    text[11098] = "This new drink has the ability to keep the body and mind";
    text[11099] = "awake and energized for days without the need for sleep.";
    text[12000] = "It's the ULTIMATE beverage...";
    text[12001] = "...for someone who wants to maximize their productivity.";
    text[12002] = "We call it: Infinity Ener-G.";
    text[12003] = "This formula has so many potential scientific and biological";
    text[12004] = "applications... making it crazy valuable.";
    text[12005] = "Which is why...";
    text[12006] = "I think the Ravagers are here to steal our Infinity Ener-G formula.";
    text[12007] = "Thanks for the info! Don't worry...";
    text[12008] = "We won't let the Ravagers get away with this!";
    text[12009] = "C'mon team, we're going in!";
    text[12010] = "Tch. So the Lunex Force finally shows up...";
    text[12011] = "Don't move! You're all under arrest!";
    text[12012] = "You really think we're just gonna abandon our operation";
    text[12013] = "and hand ourselves over without a fight?";
    text[12014] = "How naive.";
    text[12015] = "We've got Ravagers on every floor, kid...";
    text[12016] = "...and this building is gonna blow in 10 Turns,";
    text[12017] = "whether you like it or not.";
    text[12018] = "10 Turns?";
    text[12019] = "Easy.";
    text[12020] = "I could take all of you down in just one turn.";
    text[12021] = "Tch. Arrogant twerp.";
    text[12022] = "Don't mess with the Ravagers!";
    text[12076] = "I thought this was a corporate office building...";
    text[12077] = "What's the deal with all of these puzzles?";
    text[12170] = "It's like a maze in here...";
    text[12078] = "Maybe the Ravagers placed the puzzles in here to slow us down?";
    text[12079] = "...Either that, or the CEO of Ener-G Corp loves puzzles...";
    text[12171] = "Uh oh... More Ravagers!";
    text[12172] = "Don't worry, we got this!";
    text[12023] = "Well, well...";
    text[12024] = "Looks like I underestimated the strength of the Lunex Force.";
    text[12025] = "You must be the leader of the Ravagers...";
    text[12026] = "Indeed, I am.";
    text[12027] = "Now if you'll excuse me, I've got somewhere else to be.";
    text[12028] = "This secret formula isn't going to sell itself.";
    text[12029] = "We will only say this once,";
    text[12030] = "...release the hostages and disarm the explosives, NOW!";
    text[12031] = "...or you'll do what, exactly?";
    text[12032] = "You may have beaten my grunts...";
    text[12033] = "But you're no match for me.";
    text[12034] = "The clock is ticking, you know?";
    text[12035] = "Have you already forgotten about the explosives?";
    text[12036] = "Soon enough, you'll be nothing but a pile of ashes!";
    text[12037] = "We'll see about that.";
    text[12038] = "Guys, I deactivated the timed explosives!";
    text[12039] = "Danger has been averted! Heh.";
    text[12040] = "Thank you for saving us...";
    text[12041] = "...and for stopping the Ravagers...";
    text[12042] = "Here, please take this as a token of our gratitude...";
    text[12043] = "Infinity Ener-G obtained!";
    text[12044] = "Wait, are you sure it's okay to give this to us?";
    text[12045] = "Our Infinity Ener-G will be sold to the public soon anyways.";
    text[12046] = "Consider this as a special pre-release sample!";
    text[12049] = "Man... The Ravagers' motives baffle me...";
    text[12050] = "If they wanted the formula so badly...";
    text[12051] = "Couldn't they have just waited until it released?";
    text[12052] = "The world of business is cruel and competitive, my friend.";
    text[12053] = "When it comes to products that are new and revolutionary,";
    text[12054] = "those who are able to release it first have a huge advantage.";
    text[12055] = "I've made a handful of enemies over the years, so I have a few";
    text[12061] = "hunches on who may have hired the Ravagers to steal our formula...";
    text[12062] = "...but, I guess that's an investigation for another day.";
    text[12057] = "For now...";
    text[12058] = "We'll have to increase our security and strengthen our";
    text[12059] = "cyber-infrastructure to ensure this never happens again.";
    text[12060] = "Thanks again, for saving us.";
    text[12047] = "You three are welcome to explore Ener-G Corp as you please.";
    text[12048] = "Sweet, thanks!";
    text[12067] = "Hey, are you okay?";
    text[12073] = "You shouldn't be here right now.";
    text[12072] = "Am I okay?";
    text[12068] = "I'm more than okay...";
    text[12074] = "All I feel right now is...";
    text[12063] = "Sweet relief...";
    text[12075] = "Gross...";
    text[12064] = "Dude, there's a chance this building might blow.";
    text[12065] = "For your own safety, you have to leave NOW!";
    text[12066] = "I will, I will.";
    text[12069] = "Just let me... enjoy this fleeting moment.";
    text[12070] = "(Sigh) Tetra, call for some backup to escort him out of here.";
    text[12071] = "Roger that!";
    
    //text[12305] = "DIFFICULTY:";
    text[12305] = "СЛОЖНОСТЬ:";
    
    //text[12306] = "NORMAL MODE";
    text[12306] = "НОРМАЛЬНАЯ";
    
    //text[12308] = "HARD MODE";
    text[12308] = "ВЫСОКАЯ";
    
    //text[12307] = "NORMAL ENEMIES BECOME EX ENEMIES AND EX ENEMIES BECOME ZX ENEMIES!";
    text[12307] = "ОБЫЧНЫЕ ПРОТИВНИКИ СТАНОВЯТСЯ EX, EX-ПРОТИВНИКИ СТАНОВЯТСЯ ZX!";
    
    //text[12309] = "LEGEND MODE";
    text[12309] = "ЛЕГЕНДАРНАЯ";
    
    //text[12310] = "ALL ENEMIES BECOME ZX ENEMIES!";
    text[12310] = "ВСЕ ПРОТИВНИКИ СТАНОВЯТСЯ ZX-ВЕРСИЯМИ!";
    
    text[11058] = "SUMMER'S COVE";
    text[11062] = "FORSAKEN TRAIL";
    text[11063] = "SECTOR 3: MAGNESIA";
    text[11064] = "SEALED CHAMBER";
    text[12080] = "RAVAGER";
    text[11061] = "CORRUPTOID";
    text[11060] = "NECROMIA";
    text[12124] = "Noise Burst";
    text[12131] = "Mind Crush";
    text[12126] = "Necro Blast";
    text[12125] = "Summon Sentry";
    text[12127] = "Spirit Force";
    text[12128] = "Haunted Aura";
    text[12129] = "Sentry Slash";
    text[12130] = "Corrupt Flurry";
    text[12132] = "Photon Blade";
    text[12135] = "Micro Bomb";
    text[12133] = "Raid Wing";
    text[12134] = "Ravager's Code";
    text[12083] = "Star Trophy obtained!";
    text[12086] = "EZ-Stun obtained!";
    text[12087] = "EZ-Burn obtained!";
    text[12088] = "EZ-Meter obtained!";
    text[12084] = "Super Elixir obtained!";
    text[12085] = "Necro Fluid obtained!";
    text[12089] = "Ener-G Key obtained!";
    text[12090] = "Pool Floatie obtained!";
    text[12091] = "Limit Breaker obtained!";
    text[12098] = "EZ-Stun";
    text[12099] = "Stun one Enemy for 1 Turn";
    text[12100] = "EZ-Burn";
    text[12101] = "Burn one Enemy for 3 Turns";
    text[12102] = "EZ-Meter";
    text[12103] = "Increases Lux and Anti Meters by 50%";
    text[12092] = "Infinity Ener-G";
    text[12093] = "Full Heal + HP and SP Regen for 3 Turns";
    text[12094] = "Super Elixir";
    text[12095] = "+70 SP for all Party Members";
    text[12096] = "Necro Fluid";
    text[12097] = "Revive a fainted Ally with 100% HP";
    text[12104] = "Ener-G Key";
    text[12105] = "Grants entry into Ener-G Corp.";
    text[12106] = "Pool Floatie";
    text[12107] = "Time for some fun in the Sun!";
    text[12108] = "Limit Breaker";
    text[12109] = "All Active Skills LV limit +1!";
    text[12110] = "Star Trophy";
    text[12111] = "Certifies DATABASE completion!";
    text[12112] = "Target: Ravagers";
    text[12113] = "Infiltrate Ener-G Corp and arrest the Ravagers!";
    text[12114] = "Target: Unknown";
    text[12115] = "Investigate the 'Monsters of Magnesia' and rescue the lost Lunex Soldiers!";
    text[12139] = "Would you like to play WAVY WATERS?";
    text[11059] = "WAVY WATERS";
    text[11067] = "JUMP";
    text[12138] = "SPLASH!";
    text[10610] = "SELECT CHARACTER";
    text[10611] = "NEW HIGH SCORE!";
    text[10612] = "HIGH SCORE:";
    text[10613] = "BONUS!";
    text[10614] = "AMAZING!";
    text[12081] = "EX AND ZX ENEMY DATABASE COMPLETE!";
    text[12082] = "CONGRATULATIONS!";
    text[12136] = "There's some numbers carved into one of the surfboards: 202310";
    text[12137] = "ENER-G CORP: Fill your life with Ener-G!";
    text[12173] = "Use our promo code 692533 for some sweet PRIZES!";
    text[12166] = "The picnic basket is full of snacks and Cheesecake Bars!";
    text[12167] = "It's a beach ball!";
    text[12168] = "The palm trees here are so pretty!";
    text[12169] = "I love the pinks and purples!";
    text[12174] = "It's a giant bottle of Ener-G!";
    text[12175] = "Ener-G Research and Development Room";
    text[12176] = "Ener-G Storage Room";
    text[12177] = "Ener-G Manufacturing Department";
    text[12178] = "Looks like there was a meeting here in this conference room.";
    text[12179] = "This smart-board is displaying quarterly sales figures for Ener-G Corp.";
    text[12180] = "This smart-board is displaying things like 'Employee of the Month'";
    text[12181] = "and other company-related accolades.";
    text[12182] = "Nickle, wanna guess what's inside of these cabinets?";
    text[12183] = "Let's see...";
    text[12184] = "We're inside Ener-G Corp, surrounded by giant bottles of Ener-G everywhere...";
    text[12185] = "I'd bet 1000 Bytes that these cabinets are filled with an assortment of Ener-G.";
    text[12186] = "WRONG! Looks like you owe me 1000 Bytes, heh.";
    text[12187] = "No way! Then what the hell is inside of these cabinets?";
    text[12188] = "You've gotta be kidding me...";
    text[12189] = "Canned bananas?!";
    text[12190] = "WHY.";
    text[12191] = "There's a document open on the computer titled: Infinity Ener-G Formula.";
    text[12192] = "I've never seen this type of Ener-G before...";
    text[12193] = "...This must be the new Infinity Ener-G they're developing.";
    text[12194] = "It's a Skill Booster Vending Machine!";
    text[12195] = "Buy 1 Skill Booster for 5000 Bytes.";
    text[12196] = "Buy 1 Skill Booster for 250 Astrotech.";
    text[12197] = "Buy 1 Skill Booster for 50 Skill Points.";
    text[12198] = "You don't have enough Astrotech!";
    text[12199] = "You don't have enough Bytes!";
    text[12200] = "It's a Skill Point Currency Exchange Machine!";
    text[12201] = "Would you like to exchange 50 Skill Points for 5000 Bytes?";
    text[12202] = "You don't have enough Skill Points!";
    text[12203] = "It's a Hyper Ener-G Vending Machine!";
    text[12204] = "Would you like to buy a discounted Hyper Ener-G for 1000 Bytes?";
    text[11065] = "It's an abandoned robot...";
    text[11066] = "...It doesn't seem to be responsive.";
    text[12205] = "Saros_and_Vivia";
    text[12208] = "Nevermind.";
    text[12206] = "?????";
    text[12207] = "ERROR... ERROR... DATA NOT FOUND...";
    text[12209] = "WARNING... WARNING...";
    text[12210] = "HOLOGRAM GENERATORS... CRITICAL OVERLOAD...";
    text[12231] = "WARNING, DO NOT TRESPASS. THIS IS AN UNSTABLE SECTOR.";
    text[12232] = "TRAVERSING SECTOR 3 AND THE FORSAKEN TRAIL IS STRICTLY PROHIBITED.";
    text[12234] = "BRIDGE TO SECTOR 3";
    text[12235] = "SECTOR 3 OUTSKIRTS";
    text[12236] = "It's an electrical panel.";
    text[12237] = "This vending machine is out of service...";
    text[12238] = "It's an emergency evacuation notice...";
    text[12239] = "It's a poster advertising a Cycloid therapy group.";
    text[12240] = "PAY YOUR RESPECTS TO THE RESTLESS SOULS OF THE TWELVE GRAVESTONES...";
    text[12241] = "...AND THE NECRO FLUID SHALL BE YOURS.";
    text[12255] = "THE RESTLESS SOULS OF THE TWELVE GRAVESTONES HAVE BEEN FREED...";
    text[12256] = "...THE NECRO FLUID IS NOW YOURS.";
    text[12242] = "You paid your respects to the souls of the departed.";
    text[12243] = "The strange gravestone started glowing!";
    text[12244] = "ELEVEN GRAVESTONES REMAIN...";
    text[12245] = "TEN GRAVESTONES REMAIN...";
    text[12246] = "NINE GRAVESTONES REMAIN...";
    text[12247] = "EIGHT GRAVESTONES REMAIN...";
    text[12248] = "SEVEN GRAVESTONES REMAIN...";
    text[12249] = "SIX GRAVESTONES REMAIN...";
    text[12250] = "FIVE GRAVESTONES REMAIN...";
    text[12251] = "FOUR GRAVESTONES REMAIN...";
    text[12252] = "THREE GRAVESTONES REMAIN...";
    text[12253] = "TWO GRAVESTONES REMAIN...";
    text[12254] = "ONE GRAVESTONE REMAINS...";
    text[12257] = "Vermil";
    text[12264] = "Kit seems to be having a conversation with Vermil,";
    text[12265] = "but all you hear is fox noises...";
    text[12258] = "Hi! I'm Bella.";
    text[12259] = "I haven't seen you around before... Are you a new recruit?";
    text[12260] = "Nah. I've been around for a while...";
    text[12261] = "...too long to even remember, actually.";
    text[12277] = "Given my body of work... I'd say I'm an 'ancient' recruit, haha.";
    text[12278] = "Oh? What's your job?";
    text[12262] = "I just got back from a year-long expedition, where I was tasked";
    text[12274] = "to locate undiscovered Ancient ruins and artifacts.";
    text[12275] = "Ah, I see.";
    text[12263] = "In that case, welcome back, uh...";
    text[12267] = "Sorry, I forgot to introduce myself.";
    text[12268] = "My name is Vermil, and this is my trusty fox companion, Kit.";
    text[12269] = "Kit is sooooooo cute!";
    text[12270] = "That's a pretty cool sword you got there...";
    text[12276] = "My treasure hunter's instinct tells me that sword is 'ancient.'";
    text[12271] = "Good eye.";
    text[12272] = "Note to self... I need to bring you on one of my expeditions someday...";
    text[12279] = "Uh...";
    text[12281] = "Nickle! My name is Nickle.";
    text[12282] = "'Nickel' like the silver metal, or Nickle like a...";
    text[12283] = "Pickle?";
    text[12286] = "Yes.";
    text[12287] = "Yea, it's Nickle like a Pickle...";
    text[12284] = "Hmm... Interesting name.";
    text[12285] = "(THIS WHOLE TIME I THOUGHT IT WAS SPELLED LIKE THE METAL.)";
    text[12273] = "Anyways... This is an ancient sword called the 'Heavenly Nebula.'";
    text[12280] = "I found it on one of my expeditions many years ago.";
    text[12288] = "Nickle... Bella...";
    text[12289] = "There are many ancient artifacts out there for us to discover.";
    text[12290] = "If the two of you ever come across other ancient artifacts...";
    text[12291] = "Please show them to me!";
    text[12292] = "I've got a SUPER ELIXIR with your name on it, if you do.";
    text[12288] = "Nickle... Bella...";
    text[12293] = "Your swords... are INCREDIBLY ANCIENT! THEY LOOK SO COOL!";
    text[12294] = "My sword is called 'Excalibur'.";
    text[12295] = "...and I've got the 'Relic Sword'.";
    text[12296] = "(I wish I had a cool ancient sword...)";
    text[12297] = "Thanks for showing me your swords.";
    text[12298] = "As promised... Here's a SUPER ELIXIR with your names on it.";
    text[12299] = "Vermil, you didn't actually have to put our names on it...";
    text[12300] = "Pffft... It says Bella and Pickle. Hah.";
    text[12301] = "Hey, don't look at me.";
    text[12302] = "It was Kit's idea.";
    text[12303] = "My dream...";
    text[12304] = "Is for my future to be nothing but 'ancient'.";
    text[12337] = "Raine told us to meet her at Summer's Cove!";
    text[12338] = "It's a small beach located north of Oceanus in the WORLD MAP!";
    text[12319] = "It's time for some fun in the sun!";
    text[12311] = "The entrance to Magnesia...";
    text[12312] = "...should be located between Silica Rifts and Colony Silica.";
    text[12344] = "We have to chase after those weird 'monsters' we saw on the bridge!";
    text[12365] = "Necromia is a Guardian Entity that can control the mind...";
    text[12366] = "That's pretty scary...";
    text[12367] = "I'll keep an eye out for anything suspicious as we move forward!";
    text[12314] = "Nickle...";
    text[12315] = "He's been through a lot...";
    text[12316] = "We can't let him push us away! We have to find him!";
    text[12317] = "I'm amazed the purple trees here are able to survive in this climate.";
    text[12318] = "Mother nature is pretty resilient, heh.";
    text[12320] = "You found an abandoned cargo package!";
    text[12326] = "Ooo, what's inside the package?";
    text[12327] = "Uh... Nothing.";
    text[12321] = "It's empty.";
    text[12322] = "This area was destroyed many years ago...";
    text[12323] = "Whoever lost this probably isn't looking for it anymore.";
    text[12324] = "I say we keep it as a souvenir!";
    text[12325] = "Huh? Why?";
    text[12328] = "I'd like to think of it as a piece of Luna's history.";
    text[12329] = "Hmm... I guess...";
    text[12330] = "Alright, we'll hold onto it for now.";
    text[12331] = "Yaaaay!";
    text[12332] = "Ener-G Corp CEO";
    text[12333] = "Employee";
    text[12334] = "A movie called 'The Starving Games' is currently playing on the TV.";
    text[12335] = "Buy Skill Booster (5000 Bytes)";
    text[12336] = "Buy Skill Booster (250 Astrotech)";
    text[12339] = "I believe there's a few Ravagers still lurking in our building...";
    text[12340] = "If you happen to encounter them, please deal with them accordingly.";
    text[12342] = "Would you like to restart this Mission?";
    text[12343] = "(This will reset the story progression and 'Turns Left' counter.)";
    text[12345] = "Increases PWR of all Active Skills by 15!";
    text[12346] = "I'll admit...";
    text[12347] = "I'm also using this as an opportunity to test out new techniques.";
    text[12348] = "I'm counting on you to give it your all.";
    text[12349] = "This pleasant breeze...";
    text[12350] = "Our beautiful oceans...";
    text[12351] = "Luna must be protected at all costs.";
    text[12352] = "I won't let anyone take this away from us.";
    text[12353] = "Neither will I.";
    text[12354] = "Same here.";
    text[12355] = "With our combined efforts, we'll pull through!";
    text[12356] = "I've got hope.";
    text[12357] = "You can now upgrade your Active Skills up to Level 4!";
    text[12359] = "An enemy inflicted with BURN will lose 10% of their MAX HP (Max 100 DMG)";
    text[12360] = "for a set number of turns!";
    text[12361] = "Bella, we've gotta defeat the Ravagers before this building blows!";
    text[12362] = "...but, if you ever feel like you're stuck...";
    text[12363] = "We can always restart the mission at the entrance of this building!";
    text[12368] = "RAVAGER BOSS";
    
    //text[12390] = "Options";
    text[12390] = "Настройки";
    
    text[12369] = "Would you like to exit the building?";
    text[12370] = "SCORE:";
    text[12371] = "Don't underestimate us, Necromia.";
    text[12372] = "Yeah! We're not going down that easily!";
    text[12373] = "It's over...";
    text[12374] = "... ... ...";
    text[12375] = "The people of Magnesia...";
    text[12376] = "...Can finally rest...";
    text[12379] = "Wave\nMaster";
    text[12380] = "Wave Master";
    text[12381] = "PHASE AURA";
    text[12382] = "PHASE AURA:_Immune to regular attacks that do less than 100 DMG!";
    text[12383] = "SPIRIT_FORCE:_Immune_to_regular_attacks. Weakness:_Lux_Combos_+_Phase_Mode!";
    text[12384] = "HAUNTED AURA: Enemy slowly regains HP in Real-Time!";
    text[12385] = "RAVAGER'S CODE: 50% Chance for Enemy to deal 2x DMG!";
    text[12386] = "NORMAL ENEMIES";
    text[12387] = "EX ENEMIES";
    text[12388] = "ZX ENEMIES";
    text[12389] = "ALL ENEMIES";
    text[12391] = "LOG OUT";
    text[12392] = "MANAGE SUBSCRIPTION";
    text[12393] = "DELETE MY ACCOUNT";

    text[1862] = "¡Eh, hola, Bella!";
    text[1863] = "¡Hola, Richie! ¿Cómo va la música?";
    text[1864] = "¡Va estupendamente!";
    text[1865] = "Estaba pensando en hacer un viaje por Luna.";
    text[1866] = "Pienso que me servirá de inspiración para crear nuevas canciones.";
    text[1867] = "¡Parece divertido! ¡Tu música es increíble!";
    text[1868] = "¡Gracias! ¡Tengo una canción que querría enviarte!";
    text[1869] = "Transferiré el archivo de música a la cuenta de tu robot musical.";
    text[1870] = "¡Oooooh, gracias, Richie!";
    text[1871] = "¡Si me ves a mí o a algún miembro de mi grupo por Luna, ven a saludarnos!";
    text[1872] = "¡Dejaremos que descargues más pistas a tu robot musical gratis!";
    text[1873] = "¡Puedes escuchar las pistas en cualquier robot musical que encuentres!";
    text[1874] = "¡Eh, Bella! ¡Tengo algunas pistas nuevas para ti!";
    text[3270] = "¡Oooh, gracias, Richie! ¡Tu música es increíble!";
    text[3271] = "Estoy tratando de añadir más músicos y artistas a mi banda.";
    text[3272] = "¿Has tenido suerte?";
    text[3273] = "Todavía no...";
    text[3274] = "¿Tocas algún instrumento, Bella?";
    text[3275] = "No, desgraciadamente.";
    text[3276] = "¿Sabes cantar?";
    text[3277] = "Sabe cantar.";
    text[3278] = "¡Tetra! Vale, un poco... Pero me da corte.";
    text[3279] = "Ja, ja, ja. No te preocupes. Solo tenía curiosidad.";
    text[3280] = "Debería irme en breve.";
    text[3281] = "¡La inspiración musical espera en cada esquina!";
    text[3282] = "¡PISTAS DEL CAPÍTULO 2 DESBLOQUEADAS EN EL ROBOT MUSICAL!";
    text[1875] = "¡Hola! ¡Soy el Canjeanúmeros!";
    text[1876] = "¡Puedo darte artículos estupendos, pero solo podrás obtenerlos con contraseñas!";
    text[1878] = "¡Trata de encontrar contraseñas mientras exploras!";
    text[1879] = "Contraseña incorrecta.";
    text[1880] = "¡Contraseña aceptada! ¡Enhorabuena, por favor, acepta este premio!";
    text[1881] = "¡Ya has conseguido este premio!";

    text[10031] = "¡Lanza tajos con el sable pistola para causar un daño colosal!";
    text[10032] = "¡Lanza 3 Tajos Eco contra el enemigo!";
    text[10033] = "Bonif.: ¡El daño extra por ataques consecutivos se maximiza!";
    text[10034] = "¡Escudos +7 y regen. de escudos dloadurante 3 turnos!";
    text[10035] = "Cañón Fotónico definitivo. Multiplicador máx. x25";
    text[10036] = "¡Tajo eléctrico con un 100% de probabilidad de ATURDIR a 1 enemigo!";
    text[10037] = "¡Crea holosespadas que cortan al enemigo!";
    text[10038] = "¡Cualquier habilidad de espada!";
    text[10039] = "Combo lux por defecto.";
    text[10040] = "Bonif.: Probabilidad del 50% de golpe crítico (DAÑ x1,5)";
    text[10041] = "Una reunión de drones que disparan láseres.";
    text[10042] = "Combina un Cañón Fotónico de alto voltaje con Zambullida Lunar";
    text[10043] = "¡Prob. del 50% de infligir Aturdimiento!";
    text[10044] = "¡Cuatro enormes meteoritos golpean a todos los enemigos!";
    text[10045] = "¡El daño aumenta en función de la cantidad de escudos!";
    text[10046] = "¡El POD depende de los PE restantes!";
    text[10047] = "¡Golpea a TODOS los enemigos!";
    text[10048] = "Bonif.: ¡Inflige ATURDIMIENTO a todos los enemigos durante 1 turno!";
    text[10049] = "Bonif.: ¡Inflige QUEMADURA a todos los enemigos durante 2 turnos!";
    text[10050] = "¡Hidrodestructor tiene una prob. del 100% de infligir REMOJÓN a 1 enemigo!";
    text[10051] = "¡Lanza Guantes Afilados Cohete al enemigo!";
    text[10052] = "¡Probabilidad del 50% de golpe crítico!";
    text[10053] = "¡Aumenta el daño si el enemigo tiene más efectos de estado!";
    text[10054] = "¡La holotecnología permite crear un Escuadrón Raine que ataca a 1 enemigo!";
    text[10055] = "Prob. del 50% de infligir ATURDIMIENTO, QUEMADURA Y REMOJÓN a 1 enemigo!";
    text[10056] = "¡Inflige un daño equivalente al 25% de los PV que  queden al enemigo (MÁX. 1000 de DAÑ)!";
    text[10057] = "¡Prob. del 75% de infligir QUEMADURA Y REMOJÓN a 1 enemigo!";
    text[10058] = "¡El daño aumenta en función de los PV restantes!";
    text[10059] = "¡El daño aumenta en función de la cantidad de escudos!";
    text[10060] = "¡Golpea a todos los enemigos!";
    text[10061] = "¡Domine con el poder de la luz del satélite!";
    text[10062] = "¡Un disparo de Cañón Fotónico doble con Tetra! BONIF.: ¡+4 escudos!";
    text[10063] = "Ataque cuerpo a cuerpo con varios impactos. ¡Prob. del 60% de golpe crítico!!";
    text[10064] = "¡Tajo de sable curativo!";
    text[10065] = "¡Reanima a un aliado que se haya desmayado!";
    text[10066] = "¡Las bombas de tartas de queso dañan a los enemigos! Cura 200 PV y regen. de PV (3 turnos).";
    text[10067] = "¡Invoca a Guardios para que ataque! ¡Se obtiene un 30% de lux tras el ataque!";
    text[10068] = "¡Libera tu lux!";
    text[10069] = "Bonif.: Probabilidad del 50% de supergolpe crítico (DAÑ x3)";

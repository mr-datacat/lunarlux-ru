    text[10333] = "¡Aparecen 5 soldados lunex\ny atacan! Causa 100 de daño en total";
    text[10334] = "Ganas 100 bytes más al final\ndel combate (máx.400)";
    text[10335] = "Ganas 150 bytes más al final\ndel combate (máx.600)";
    text[10336] = "Ganas 200 bytes más al final\ndel combate (máx.800)";

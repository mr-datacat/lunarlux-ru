    text[10114] = "Lunarpedia.EXE";
    text[10128] = "¡Hola! Soy Lunarpedia.EXE, ¡tu mejor fuente de consejos y pistas de combate para el juego!";
    text[10116] = "¡Podrás cambiar de traje impulsor cuando hayas obtenido";
    text[10117] = "al menos 2 modelos diferentes!";
    text[10118] = "A lo largo de tu aventura descubrirás un total de cinco indicadores de colores.";
    text[10120] = "Los indicadores azules se usan para resaltar un objeto o zona de interés con la que puedes interactuar.";
    text[10121] = "Los indicadores amarillos se usan para avanzar en la historia.";
    text[10122] = "Los indicadores verdes se usan para las tareas secundarias.";
    text[10123] = "Los indicadores rojos se usan para las misiones de la Fuerza Lunex.";
    text[10124] = "Por último, los indicadores morados se usan para indicar lugares donde no se luchará contra lóbregos.";
    text[10126] = "Usa el MENÚ MISIONES para acceder a los requisitos o la información necesaria";
    text[10127] = "para completar las misiones y las tareas secundarias que encontrarás durante tu aventura.";
    text[10125] = "¡Puedes acceder al MENÚ MISIONES desde tu códex!";
    text[10131] = "¡Una nave espacial se divide en tres partes intercambiables: chasis, ala y propulsor!";
    text[10130] = "¡Durante tu aventura puedes encontrar un total de 33 partes de nave!";
    text[10129] = "Nota: El mapa del mundo se desbloquea durante el capítulo 2.";
    text[10132] = "¡Derrotar enemigos en combate te otorgará EXP y te permitirá aumentar tu nivel!";
    text[10134] = "¡Se añaden 10 PV a tus PV MÁX. cuando tu nivel (NV.) aumenta!";
    text[10135] = "Cuando tu nivel aumenta, el DAÑ (daño) y el POD (poder) de ciertas habilidades activas también aumenta,";
    text[10136] = "¡y el daño de tus combos lux también aumentará!";
    text[10144] = "¡Los PE son esenciales para usar tus habilidades en combate!";
    text[10145] = "¡Puedes usar GOMINOLAS para restar 5 al coste en PE de tus habilidades activas!";
    text[10137] = "Tus PE MÁX. siempre serán 100, a no ser que te equipes con un CHIP DE MEJORA DE PE.";
    text[10138] = "Usar REFUERZOS DE ESCUDO no solo aumentará tus ESCUDOS MÁX.,";
    text[10139] = "¡también añadirá 1 al número de escudos que tendrás cuando empieces un combate!";
    text[10140] = "Selecciona un tema.";
    text[10141] = "NV y PV MÁX.";
    text[10142] = "PE MÁX.";
    text[10143] = "ESCUDOS MÁX.";
    text[10146] = "¡Los enemigos pueden usar cinco tipos de ataques en total!";
    text[10147] = "¡En los ataques de 1 panel, tu movimiento está restringido y deberás usar los escudos!";
    text[10148] = "¡En los ataques de 3 paneles, puedes esquivar los ataques del enemigo desplazándote arriba o abajo!";
    text[10150] = "¡En los de 9 paneles, puedes moverte en las cuatro direcciones para esquivar los ataques!";
    text[10151] = "Los ataques espirituales son ataques especiales en los que un corazón representa tu «alma».";
    text[10152] = "¡Debes mover tu corazón para esquivar las balas y los proyectiles del enemigo!";
    text[10153] = "¡Durante un ataque espiritual también puedes usar los escudos si te ves en un aprieto!";
    text[10154] = "El último ataque es el ataque de oleada.";
    text[10155] = "¡En los ataques de oleada deberás orientar tu escudo a la izquierda o la derecha para protegerte de varias";
    text[10156] = "oleadas de proyectiles!";
    text[10157] = "Nota: En los ataques de oleada no gastarás escudos.";
    text[10158] = "Quiero comprar un enlace neural, pero no tengo el NIVEL necesario...";
    text[10159] = "Puedes aprender muchas técnicas de combate nuevas usando enlaces neurales, pero...";
    text[10160] = "Si tu cuerpo no cuenta con el entrenamiento adecuado, puedes acabar haciéndote daño.";
    text[10161] = "¡Por eso es importante que entrenes tu cuerpo subiendo de nivel!";
    text[10173] = "Cómo ejecutar un combo lux";
    text[10174] = "Dominio de combos lux";
    text[10175] = "Aumento de daño de combos lux";
    text[10167] = "¡Si un ataque enemigo te inflige daño, tu barra de lux se reducirá!";
    text[10164] = "¡Cuando tu barra de lux esté al máximo, puedes ejecutar un combo lux desde el menú Habilidades!";
    text[10165] = "Combina tres habilidades activas para ejecutar un combo.";
    text[10163] = "¡Existen un total de 30 combos lux que puedes descubrir y dominar!";
    text[10168] = "Se considera que has «dominado» un combo lux cuando lo has utilizado al menos dos veces.";
    text[10166] = "¡Prueba diferentes combinaciones o consigue recetas de combos lux para dominarlos todos!";
    text[10162] = "¡Cuanto mayor sea tu nivel, más daño infligirás con tus combos lux!";
    text[10170] = "Paneles tóxicos";
    text[10171] = "Paneles de lava";
    text[10172] = "Paneles mojados";
    text[10169] = "Algunos enemigos generan paneles tóxicos durante sus ataques.";
    text[10176] = "¡Si permaneces sobre un panel tóxico, perderás PV poco a poco!";
    text[10179] = "¡Los paneles de lava son calientes y explosivos!";
    text[10180] = "Perderás 50 PV si pisas un panel de lava.";
    text[10181] = "Los paneles de lava desaparecerán después de pisarlos.";
    text[10182] = "¡Tu barra de lux se reducirá lentamente si pisas un panel mojado!";
    text[10183] = "¡Si aumentas tu afinidad, también conseguirás mejores descuentos en las tiendas!";
    text[10186] = "¡Si asestas un GOLPE CRÍTICO a un enemigo, tu POD se multiplicará por 1,5!";
    text[10187] = "¡Los SUPERGOLPES CRÍTICOS multiplican tu POD por 3!";
    text[10188] = "Rimuru";
    text[10189] = "NV. requerido";
    text[10190] = "¡No tienes el nivel necesario!";
    text[10191] = "¿Sabías que puedes personalizar el color de tu nave espacial?";
    text[10192] = "Regeneración de escudos y PV durante 4 turnos";
    text[10193] = "Regeneración de escudos y PV durante 5 turnos";
    text[12377] = "Regeneración de escudos y PV durante 6 turnos";
    text[10194] = "¡Derrota a los enemigos con 250 PV o menos!";
    text[10195] = "¡Derrota a los enemigos con 300 PV o menos!";
    text[12378] = "¡Derrota a los enemigos con 400 PV o menos!";
    text[10311] = "Recupera un 40% de los PV máx. y 40 PE";
    text[10312] = "Recupera un 60% de los PV máx. y 60 PE";

function scr_es()
{
    text[1] = "Hola, mamá.";
    text[2] = "Han pasado solo unos meses desde que me incorporé oficialmente a la Fuerza Lunex.";
    text[3] = "¡Por ahora, todo va muy bien!@P Proteger a los habitantes de Luna es un trabajo realmente estupendo.";
    text[4] = "Por fin entiendo cómo debías sentirte.";
    text[5] = "Eras increíble,@P una fuente de esperanza y coraje para los demás.";
    text[6] = "Todo el mundo te admiraba.@P Eras la mejor guerrera de Luna.";
    text[7] = "Y@P.@P.@P. Aunque ahora estás en un lugar mejor@P.@P.@P.";
    text[8] = "¡Me aseguraré de que nadie pierda la esperanza!";
    text[9] = "No será fácil, pero haré todo lo que pueda para ser tan fuerte y capaz como tú algún día.";
    text[10] = "Cuídate, mamá.@P \nVolveré a visitarte muy pronto.";
    text[11] = "¡Bellaaaa!";
    text[12] = "Je, je, ¡nuestra nave ya está recargada!";
    text[13] = "¡Bien hecho, Tetra!";
    text[14] = "¿Quieres que volvamos a casa?";
    text[15] = "Déjame ver el horario@P.@P.@P.";
    text[16] = "¡Sí! Creo que papá habrá terminado sus reuniones cuando estemos de vuelta en el laboratorio.";
    text[17] = "¡Estupendo!";
    text[18] = "Nuestra nave está atracada en el Astropuerto Sureste.";
    text[19] = "Bien, ¡vamos, que nos vamos!";
    text[20] = "¡Lóbrego identificado! DENOMINACIÓN: HYPERBEE";
    text[21] = "Control de Misiones, al habla Bella Grey.";
    text[22] = "Hemos encontrado un lóbrego hostil en el sector 16.";
    text[23] = "¡Solicito permiso para atacar!";
    text[24] = "@P.@P.@P. ¡Recibido!";
    text[25] = "¡Tetra! ¡Es hora de prepararse para el combate!";
    text[26] = "¡De inmediato!";
    text[27] = "Lo siento.";
    text[28] = "Ojalá existiera otra manera@P.@P.@P.";
    text[29] = "Ojalá pudiéramos comunicarnos con los lóbregos para llegar a un acuerdo.";
    text[30] = "Espero que algún día podamos coexistir sin tener que derramar sangre.";
    text[31] = "Bella, los lóbregos son terroríficos@P.@P.@P. ¡Comen humanos!";
    text[32] = "Solo tratan de sobrevivir.";
    text[33] = "¡Al menos sus antinúcleos nos ayudan a conocerlos mejor!";
    text[34] = "Gracias a esos antinúcleos podemos usar receptáculos y tecnología alimentados con antimateria, je, je.";
    text[35] = "Me sigue sin gustar. No me parece justo@P.@P.@P.";
    text[36] = "Mamá habría tratado de encontrar otra alternativa@P.@P.@P. Habría encontrado una manera de lograr la paz.";
    text[37] = "En fin@P.@P.@P. ¡Debemos hacer todo lo que podamos para proteger a la gente de Luna!";
    text[38] = "No es cierto, ¿superayudante Tetra?";
    text[39] = "¡POR SUPUESTO, Tetra se esforzará al máximo!";
    text[40] = "¡Srta. Bella!";
    text[41] = "¡Los refuerzos han llegado!";
    text[42] = "¡Gracias por venir! El objetivo ya ha sido eliminado.";
    text[43] = "¡Con ayuda de la insuperable ayudante Tetra! Je, je.";
    text[44] = "¡Un trabajo estupendo Srta. Bella, como siempre!";
    text[45] = "Me alegro de que esta vez ningún civil resultara herido.";
    text[46] = "Aparentemente, los lóbregos pueden aparecer en cualquier lugar gracias a esos agujeros de gusano@P.@P.@P.";
    text[47] = "¿Alguna vez te has preguntado cómo será su mundo, al otro lado de los agujeros?";
    text[48] = "Ni siquiera quiero pensar en ello...";
    text[49] = "Solo el escuadrón de la antigua general Grey consiguió regresar de allí.";
    text[50] = "¡He oído que hay lóbregos por todas partes!";
    text[51] = "¡Buf, me dan escalofríos solo de pensarlo!";
    text[52] = "Cuando entras en un agujero de gusano, no hay vuelta atrás.";
    text[53] = "Solo unos pocos han estado en su mundo@P.@P.@P. y son aún menos los que han vuelto de allí con vida.";
    text[54] = "Además, Control de Misiones prohíbe realizar misiones allí sin autorización.";
    text[55] = "Vamos, llevemos este antinúcleo al Cuartel General.";
    text[56] = "(Otra vez@P.@P.@P. Esta sensación).";
    text[57] = "(No sé qué es).";
    text[58] = "(¿Soy la única que puede sentirla?)";
    text[59] = "Esperad.";
    text[60] = "Dejad que lleve el antinúcleo.";
    text[61] = "¿Cómo? ¿Está segura, Srta. Bella?";
    text[62] = "¡Hoy es su día libre! Debe descansar.";
    text[63] = "No, no pasa nada. Me encargaré de él.";
    text[64] = "Muy bien, Srta. Bella. Gracias por su ayuda.";
    text[66] = "Si algún lóbrego más decide aparecer, estaremos patrullando por la zona.";
    text[67] = "Muy bien, Tetra, ¡a volar!";
    text[68] = "¡Chupi dupi!";
    text[215] = "Bella, ¿adónde vas? ¡Nuestra nave está al este!";
    text[216] = "Sí, lo sé, pero no puedo evitarlo, ¡me encanta explorar Luna!";
    text[217] = "Mmmm, este olorcillo@P.@P.@P.";
    text[218] = "¡Se me hace la boca agua!";
    text[219] = "¿Barritas de tarta de queso?";
    text[220] = "Qué bien me conoces, Tetra.";
    text[221] = "Ya te digo.";
    text[222] = "Vamos al café un rato antes de volver a la nave.";
    text[223] = "¡Chupi!";
    text[71] = "¡El Café Regolithia les da la bienvenida! ¿Que puedo servirles hoy?";
    text[72] = "Hola, me gustarían tres barritas de tarta de queso, y un latte de vainilla helado, por favor.";
    text[73] = "Muy bien. ¡Enseguida está!";
    text[74] = "Vaya, ¿TRES barritas de tarta de queso?";
    text[75] = "Una para ahora.";
    text[76] = "Otra para después.";
    text[77] = "¿Y otra para más tarde?";
    text[78] = "Exactamente.";
    text[79] = "Su pedido está listo. ¡Aquí lo tiene!";
    text[80] = "No se preocupe por la cuenta. ¡Invita la casa!";
    text[81] = "¡Vaya! ¡Muchas gracias!";
    text[82] = "No, no, somos nosotros quienes deberíamos darle las gracias.";
    text[83] = "Cuando escuchamos la señal de alarma que indicaba que había un lóbrego fuera, nos preocupamos mucho.";
    text[84] = "Quién sabe los destrozos que podrían haber causado los lóbregos si la Fuerza Lunex no estuviera aquí.";
    text[85] = "Le damos las gracias por su ayuda, señorita.";
    text[86] = "Vaya, no sé qué decir... ¡gracias! Seguiremos dando lo mejor de nosotros mismos.";
    text[224] = "¡Espera, todavía no he terminado mi comida! Vamos a quedarnos un poco más.";
    text[225] = "De acuerdo.";
    text[226] = "Los lugareños son bastante agradables. ¿Y si hablamos con algunos?";
    text[391] = "Eh, ¿estás al tanto de las últimas noticias sobre el Matalóbregos?";
    text[392] = "No... ¿Qué ha ocurrido?";
    text[393] = "Los lugareños dijeron que hoy vieron cómo el Matalóbregos acababa con algunos lóbregos. ";
    text[394] = "Los lóbregos no tenían nada que hacer. ¡Dicen que los mató con un solo golpe!";
    text[395] = "... Al menos ningún ciudadano fue herido.";
    text[396] = "Solo hay un puñado de soldados en la Fuerza Lunex capaz de vérselas";
    text[397] = "contra un lóbrego sin utilizar un receptáculo.";
    text[398] = "Dicen que el Matalóbregos tiene poco más de veinte años.";
    text[399] = "Quién sabe... Tal vez podamos quitarle esa máscara que lleva algún día y descubrir quién es en realidad.";
    text[400] = "Me pregunto cómo pudo hacerse tan fuerte...";
    text[401] = "Si algún día llego a conocerle, se lo preguntaré.";
    text[402] = "... aunque después de capturarle, por supuesto.";
    text[403] = "Cada día se envían más y más patrullas.";
    text[404] = "Los avistamientos de lóbregos también han ido aumentando poco a poco...";
    text[405] = "Por ahora no tenemos muchos problemas, pero... espero que la situación no se nos vaya de las manos.";
    text[406] = "Trataré de sacar tiempo para algunas sesiones de entrenamiento más tarde.";
    text[407] = "¡El simulador de combates de la Estación Espacial Lunex es fantástico para entrenar!";
    text[408] = "¡Eh, gracias por el consejo!";
    text[227] = "Oye, Bella.";
    text[228] = "¿Sí?";
    text[229] = "¿Recuerdas lo que dijo el soldado del uniforme azul?";
    text[230] = "¡El Matalóbregos tiene poco más de veinte años! Casi tiene tu misma edad, je, je.";
    text[231] = "¿Y?";
    text[232] = "También es muy fuerte. Tetra recuerda que Bella dijo que le gustaban los hombres fuertes.";
    text[233] = "¡Es un buen candidato a novio! Lo añadiré a la lista de posibles@P.@P.@P.";
    text[234] = "¡Tetra!";
    text[235] = "Me estás avergonzando...";
    text[236] = "No sabía que tenías una lista para esas cosas.";
    text[237] = "¡Tengo una colección entera de listas en mi base de datos! Je, je.";
    text[238] = "Puede que sea fuerte, pero no me gustan sus acciones.";
    text[239] = "Es un justiciero buscado por la ley que caza lóbregos para quitarles sus antinúcleos.";
    text[240] = "Los antinúcleos son un recurso valioso que todavía no entendemos completamente... ";
    text[241] = "y aunque no me gusta usarlos, los necesitamos para conseguir más información sobre los lóbregos.";
    text[242] = "No sabemos cuáles son sus motivos, y por eso debemos capturarle.";
    text[243] = "Es tan misterioso... ";
    text[244] = "(Aaaay). Venga, pongámonos en marcha.";
    text[87] = "¿Estás lista para ir a la Estación Espacial Lunex?";
    text[88] = "¡Bella, lóbrego detectado!";
    text[89] = "¡¿Has podido identificarlo?!";
    text[90] = "No, era demasiado rápido.";
    text[91] = "¡El piloto de ese aerodeslizador está en peligro!";
    text[92] = "¡El aerodeslizador se ha estrellado...!";
    text[93] = "Parece que la explosión procedía de la Instalación de la Barrera.";
    text[94] = "Vamos, Tetra, ¡debemos ayudarle! ¡A volar!";
    text[95] = "OBJETIVO: DIRÍGETE AL OESTE PARA VER QUÉ OCURRE EN LA INSTALACIÓN DE LA BARRERA.";
    text[96] = "¡Lóbrego identificado! DENOMINACIÓN: GRIMROCK";
    text[97] = "¡Debemos proteger a los civiles sea como sea!";
    text[98] = "¡Srta. Bella! ¡Hemos venido para ayudarle!";
    text[99] = "¿Podremos enfrentarnos a tres lóbregos a la vez...?";
    text[100] = "No te preocupes, Tetra. Esta vez tenemos refuerzos.";
    text[101] = "¡Bella, no pierdas de vista los holoescudos que te quedan durante el combate!";
    text[102] = "¡Tranquila!";
    text[103] = "¡Vamos, chicos! ¡Demostrémosles a esos lóbregos el poder de la Fuerza Lunex!";
    text[104] = "Vaya, esta vez no han dejado ningún antinúcleo...";
    text[105] = "(Buf)... (Buf)... Sí@P.@P.@P.";
    text[106] = "Bella, ¿te encuentras bien?";
    text[107] = "No me pasa nada.";
    text[108] = "No tenemos tiempo que perder. Vamos, a la Instalación de la Barrera, deprisa.";
    text[109] = "¿Seguro que estás bien?";
    text[110] = "@P.@P.@P. ¡Sí! ¡A volar, hay gente que nos necesita!";
    text[1471] = "¡Esa batalla ha sido intensa! ¡Sus habilidades son sorprendentes, Srta. Bella!";
    text[1472] = "Mantendremos los ojos abiertos y nos aseguraremos de que los civiles estén a salvo.";
    text[111] = "Buf@P.@P.@P. Buf@P.@P.@P.";
    text[112] = "@P.@P.@P. Cielos, me está empezando a costar respirar...";
    text[113] = "Oh, vaya...";
    text[114] = "Bella, ¡los niveles de oxígeno están descendiendo!";
    text[115] = "¿La Astrobarrera está en modo de emergencia?";
    text[116] = "Es posible que se haya producido una brecha en el sistema...";
    text[117] = "¿Crees que el lóbrego que pasó volando podría haber causado la brecha?";
    text[118] = "Es probable...";
    text[119] = "Es posible que tengamos que luchar contra ese lóbrego si lo volvemos a encontrar...";
    text[120] = "Tratemos de evitar más muertes de lóbregos a no ser que sea absolutamente necesario...";
    text[121] = "De acuerdo.";
    text[122] = "La Astrobarrera es lo único que evita que flotemos por el espacio...";
    text[123] = "Debemos protegerla.";
    text[124] = "¡Vayamos a investigar!";
    text[306] = "Ay...";
    text[307] = "Como si estar a punto de morir en un aterrizaje de emergencia no fuera suficiente estrés para un solo día...";
    text[308] = "Oh, no...";
    text[309] = "Ay. Esta vez la he h-h-hecho buena.";
    text[310] = "¿Cómo demonios voy a a-a-arreglar esto?";
    text[311] = "¡Eh, disculpe! ¡Hola!";
    text[312] = "¡Me llamo Bella! ¡Pertenezco a la Fuerza Lunex!";
    text[313] = "¡Hemos venido para ayudarle! Díganos qué ha pasado. ";
    text[314] = "Oh, g-gracias al cielo...";
    text[315] = "Me llamo Mett. Soy transportista.";
    text[316] = "Mett, respire hondo y tranquilícese. Todo va a salir bien.";
    text[317] = "Lo siento Srta. Bella. Cuando estoy muy agobiado, t-t-tiendo a t-t-tartamudear.";
    text[318] = "Vale, un lóbrego esc-c-calofriante apareció de la nada";
    text[319] = "mientras estaba llevando un nuevo cargamento de paneles lunares...";
    text[320] = "Dañó mi aerodeslizador, causó un pico de energía y luego desapareció...";
    text[321] = "Ese pico de energía hizo que la Astrobarrera pasara al modo de emergencia...";
    text[322] = "¡Srta. Bella!";
    text[323] = "Tenemos que llegar a la escotilla de acceso que hay bajo el aerodeslizador...";
    text[324] = "para reparar los daños e iniciar un protocolo distinto.";
    text[325] = "Si no hacemos algo, quedaremos encerrados en el sector 16. Debemos acceder a esa escotilla.";
    text[326] = "Mmmm...";
    text[327] = "(¡AAAAAAH! ¿AHORA QUÉ PUEDO HACER? ¡NO SÉ ARREGLAR UN AERODESLIZADOR!)";
    text[328] = "No se preocupe, Mett. Bella es la hija del gran doctor Thomas.";
    text[329] = "Es un joven prodigio que destaca tanto en combate como por su ingenio, ¡ja, ja, ja, ja!";
    text[330] = "(Je. ¡Menos mal que tengo a una fiel ayudante que puede echarme un cable!)";
    text[331] = "Tetra, ¿puedes comunicarte con el ordenador que hay dentro de la Instalación de la Barrera?";
    text[332] = "Las torres EM están dañadas, y así es imposible contactar con el sistema.";
    text[333] = "Oh, genial...";
    text[334] = "¿Cómo podemos desplazar el aerodeslizador?";
    text[335] = "¡Muévelo!";
    text[336] = "¡Destrúyelo!";
    text[337] = "¿Y si arreglamos el motor?";
    text[386] = "¡Tetra, escanea el aerodeslizador!";
    text[387] = "¡Muy bien! Dame un par de milisegundos...";
    text[338] = "¡Hecho!";
    text[339] = "¿Cuánto pesa?";
    text[340] = "¡100 toneladas!";
    text[341] = "Buf... Olvidémoslo.";
    text[342] = "Pensaba que tal vez podríamos moverlo para acceder a la escotilla que hay debajo.";
    text[343] = "100 toneladas es demasiado peso.";
    text[344] = "¡Necesitaríamos 20 Tetras para moverlo!";
    text[345] = "Probablemente haya una solución más factible.";
    text[346] = "¿Y si destruimos el aerodeslizador?";
    text[347] = "¡BÚÚÚÚM!";
    text[348] = "¡E-e-eh! ¡N-n-no tan rápido! La nave es propiedad de la compañía...";
    text[349] = "Las vidas de la gente importan más que un aerodeslizador roto...";
    text[350] = "Mmmm...";
    text[351] = "Toda esta área es extremadamente volátil.";
    text[352] = "Ahora mismo el oxígeno que hay dentro de la Astrobarrera es inestable.";
    text[353] = "Recuerda: El fuego consume oxígeno. Debemos evitar causar explosiones o incendios.";
    text[354] = "Destruir la nave no es la solución.";
    text[355] = "G-g-gracias al cielo...";
    text[356] = "Tiene razón, Srta. Bella, lo olvidé...";
    text[357] = "¿Hay alguna manera de arreglar el motor?";
    text[358] = "Un momento, ¡acabo de recordar algo!";
    text[359] = "Mi aerodeslizador es un carguero de suministro modelo N...";
    text[360] = "... y eso quiere decir que el sistema de propulsión gravitatorio es eléctrico.";
    text[361] = "Aunque la conexión con la batería y el sistema de arranque están fritos...";
    text[362] = "Si pudiéramos llevar algo de electricidad al núcleo motor...";
    text[363] = "podríamos darle potencia y ponerlo en marcha de nuevo...";
    text[364] = "Después será fácil acceder a la escotilla.";
    text[365] = "Electricidad @P. @P. @P. @P. @P.";
    text[366] = "¡CHISPAS, CHISPITAS!";
    text[367] = "¡Muy bien, tengo una idea!";
    text[368] = "¡Paneles lunares!";
    text[369] = "¡Aaaah! Ya veo. ¡Los paneles lunares generan electricidad!";
    text[370] = "¡E-e-eso podría funcionar!";
    text[371] = "TIENE que funcionar. No se me ocurre otra cosa.";
    text[372] = "El problema es que no tengo la menor idea de cómo conectar o instalar paneles lunares...";
    text[373] = "Hora de volar. Encontremos a alguien que pueda ayudarnos.";
    text[374] = "L-l-lamento causarles tantos problemas...";
    text[375] = "No se preocupe, Mett. No es culpa suya.";
    text[376] = "¡Bella! ¡Dos lóbregos detectados!";
    text[377] = "AAAAH... ¿L-l-lóbregos?";
    text[378] = "Uuuuugh...";
    text[379] = "L-lo siento, Me@P.@P.@P.  Me@P.@P.@P.";
    text[380] = "Me dan mucho miedo esos monstruos.";
    text[381] = "Mett, quédese aquí, estará a salvo. Yo me encargaré de esto. No se preocupe.";
    text[382] = "¡Chicos, cuidad a Mett, por favor! ¡Esto es cosa mía!";
    text[383] = "¡Por supuesto! ¡Puede contar con nosotros, Srta. Bella!";
    text[384] = "Si tratáramos de combatir a su lado, no seríamos más que un obstáculo.";
    text[385] = "¡Si necesito ayuda os avisaré!";
    text[125] = "¡Ya basta!";
    text[126] = "Un momento@P.@P.@P. ¡Tú eres...!";
    text[127] = "¡Eres el Matalóbregos!";
    text[128] = "¡No te muevas! ¡Estás detenido!";
    text[129] = "¡Devuélveme el antinúcleo que has conseguido!";
    text[130] = "Es estupendo vivir en la ignorancia, ¿verdad?";
    text[131] = "¿De qué estás hablando?";
    text[132] = "¿No lo sientes?";
    text[133] = "Llora.";
    text[134] = "Sufre.";
    text[135] = "Está rebosante de pena,";
    text[136] = "siente un dolor insoportable.";
    text[137] = "Debemos librar a los lóbregos... de su sufrimiento.";
    text[138] = "Nunca confiaría los antinúcleos a gente de tu calaña.";
    text[139] = "¿Qué...?";
    text[140] = "No lo entiendo. Si sientes su sufrimiento, ¿por qué los cazas?";
    text[141] = "¿Qué estás haciendo con los antinúcleos que reúnes?";
    text[142] = "No tengo por qué decirte nada.";
    text[143] = "Apártate de mi camino.";
    text[144] = "¡Espera!";
    text[145] = "Ha escapado...";
    text[146] = "¡Bella, el lóbrego!";
    text[147] = "¡Parece que ese lóbrego está realmente enfadado!";
    text[148] = "¡No hay tiempo que perder! ¡Debemos ir tras él!";
    text[149] = "OBJETIVO: ¡ENCUENTRA Y CAPTURA AL LÓBREGO ENLOQUECIDO!";
    text[245] = "Espera, creo que el lóbrego fue en otra dirección.";
    text[246] = "¡Probemos con el otro portal!";
    text[247] = "El lóbrego debería seguir por aquí, en alguna parte.";
    text[248] = "¡Debemos encontrarlo!";
    text[150] = "¡Allí está! ¡Tenemos que tranquilizarlo!";
    text[151] = "Tetra, ¡necesito a mi ayudante!";
    text[152] = "¡Ultrayudante al rescate!";
    text[153] = "¡El lóbrego ha escapado!";
    text[154] = "(Buff)... (Buff)... No pasa nada@P.@P.@P.";
    text[155] = "Será mejor olvidarnos de eso por ahora.";
    text[156] = "No creo que vaya a regresar tan pronto.";
    text[157] = "Tetra, ¿cuál es el nivel de oxígeno?";
    text[158] = "@P.@P.@P.@P. ¡96%!";
    text[159] = "Tetra está confundida. Hay suficiente oxígeno.";
    text[160] = "No deberías tener problemas para respirar en este momento...";
    text[161] = "Bella, voy a escanearte...";
    text[162] = "¡BELLA!";
    text[163] = "Lo siento...";
    text[164] = "Tantos combates...";
    text[165] = "Tanto sufrimiento...";
    text[166] = "Debe haber una manera...";
    text[167] = "Debe haberla.";
    text[168] = "Yo...";
    text[169] = "He matado a tantos lóbregos.";
    text[170] = "Lo siento mucho...";
    text[171] = "Si tengo que elegir entre salvaros a vosotros o salvar a la humanidad...";
    text[172] = "Estoy obligada a salvar a la humanidad...";
    text[173] = "... porque juré proteger a la gente de Luna...";
    text[174] = "Sois monstruos.";
    text[175] = "Nosotros somos humanos.";
    text[176] = "Pero eso no significa que tengamos que matarnos entre nosotros para sobrevivir.";
    text[177] = ".@P.@P.@P.@P.@P. ¿verdad?";
    text[178] = "Mamá@P.@P.@P.";
    text[179] = "¿Qué descubriste sobre estas criaturas?";
    text[180] = "Ojalá hubieras tenido tiempo para decírmelo...";
    text[181] = "¡¡¡BELLAAAAAAA!!!";
    text[182] = "¡Por fin despiertas! Te habías desmayado...";
    text[183] = "Hola, Tetra...";
    text[184] = "Hum... No has sido sincera con Tetra...";
    text[185] = "No te desmayaste por la falta de oxígeno...";
    text[186] = "Estuviste herida todo el tiempo...";
    text[187] = "Eh, je, je... Sí...";
    text[188] = "Ocurrió durante nuestra lucha contra los tres grimrocks.";
    text[189] = "¿Por qué no dijiste nada?";
    text[190] = "Tetra estaba preocupada...";
    text[191] = "Lo siento...";
    text[192] = "Teníamos que ocuparnos del asunto del aerodeslizador y...";
    text[193] = "Supuse que pensé que podría soportarlo.";
    text[194] = "¿Tetra ha sido una mala ayudante?";
    text[195] = "¡No, no! Es culpa mía, Tetra.";
    text[196] = "Como mínimo debería haberme parado un momento para limpiar la herida.";
    text[197] = "¡Eres la mejor ayudante enfermera del mundo!";
    text[198] = "Muy bien... Pero la próxima vez no me des estos sustos.";
    text[199] = "Si el doctor Thomas estuviera aquí, diría «¡Esa es mi Bella!».";
    text[200] = "«Tan temeraria como siempre».";
    text[201] = "«Pero el poder de su corazón y su espíritu no tiene parangón».";
    text[202] = "«Eso es lo que la convierte en una auténtica heroína para la gente de Luna».";
    text[203] = "Papá siempre me saca los colores... (je, je, je)";
    text[204] = "Espera, ¿cuánto tiempo llevo inconsciente?";
    text[205] = "48 minutos y 37 segundos, para ser exactos.";
    text[206] = "¿Nivel de oxígeno?";
    text[207] = "¡79%!";
    text[208] = "Buf. Muy bien, no perdamos más tiempo.";
    text[209] = "¡Tenemos una misión que cumplir!";
    text[210] = "¡Chupi!";
    text[211] = "Ahora me siento mucho mejor. Gracias por cuidar de mí, Tetra.";
    text[212] = "Je.";
    text[213] = "MISIÓN: ¡ARRANCAR EL MOTOR DEL AERODESLIZADOR Y ARREGLAR LA ASTROBARRERA!";
    text[214] = "¡ENCUENTRA A ALGUIEN PUEDA AYUDARTE A OBTENER PANELES SOLARES!";
    text[415] = "¡Ah, Bella! Es estupendo verte, querida.";
    text[416] = "¡Oh! ¡Hola Srta. Nyla! ¿Qué le trae por aquí?";
    text[417] = "Me llamaron para realizar algunas inspecciones y trabajo de campo relacionados con los paneles lunares.";
    text[418] = "Tu padre y yo desarrollamos hace poco un nuevo modelo de panel lunar, y";
    text[419] = "necesitamos poner a prueba su eficiencia.";
    text[420] = "Estamos esperando que nos lleguen algunos paneles más@P.@P.@P.";
    text[421] = "pero parece que el aerodeslizador de carga se retrasa@P.@P.@P.";
    text[422] = "En cualquier caso, es agradable trabajar fuera de la Estación Espacial de vez en cuando.";
    text[423] = "Vivimos en una época de esplendor tecnológico,";
    text[424] = "pero aun así, nos queda tanto que descubrir.";
    text[425] = "Querida, si necesitas algo, solo tienes que decírmelo.";
    text[426] = "¡Muy bien, gracias Srta. Nyla!";
    text[427] = "¡Ah, Bella! ¿Cómo va todo, querida?";
    text[428] = "Srta. Nyla, ¡necesitamos que nos ayude!";
    text[429] = "Es una experta en paneles lunares, ¿verdad?";
    text[430] = "Ah, sí, querida.";
    text[431] = "Entonces esta es la situación...";
    text[432] = "Ya veo. ¡Bueno, has acudido a la persona adecuada!";
    text[433] = "¿Es posible reactivar el aerodeslizador con la ayuda de los paneles solares?";
    text[434] = "Mmmm...";
    text[435] = "Sí, de eso no cabe duda.";
    text[436] = "Pero necesitamos lo siguiente: ¡10 paneles lunares y 1 generador termoeléctrico!";
    text[437] = "Vaya... qué petición más concreta. ¿Y dónde se supone que vamos a encontrar un generador?";
    text[438] = "Querida, ¡esto es Regolithia!";
    text[439] = "Estamos en las afueras de Tycho, la capital científica de Luna.";
    text[440] = "Este sector es muy popular entre los mercaderes de astrotecnos.";
    text[441] = "¡Suelen vender bienes y tecnología que no se pueden encontrar en ningún otro sitio!";
    text[442] = "¡Trata de encontrar a un mercader de astrotecnos en la Instalación de la Barrera!";
    text[443] = "En cuanto a los paneles lunares, creo que nos quedan algunos en la Unidad de Almacenaje.";
    text[444] = "La Unidad está al sur de aquí.";
    text[445] = "Toma esto...";
    text[446] = "¿Quieres saber cómo funcionan los paneles lunares?";
    text[447] = "Tal vez en la próxima ocasión.";
    text[448] = "¡Espléndido! ¡Me encanta que quieras saber más sobre ellos!";
    text[449] = "Los paneles lunares resuelven el problema que los paneles solares han planteado";
    text[450] = "desde hace siglos.";
    text[451] = "¡Pueden generar electricidad cuando brilla el sol y cuando no hay luz!";
    text[452] = "¡Vaya! ¿Absorben la oscuridad?";
    text[453] = "No exactamente, querida.";
    text[454] = "Los paneles solares pueden generar electricidad debido a la";
    text[455] = "diferencia en la temperatura ambiente durante nuestras frías noches lunares.";
    text[456] = "Las noches y los días lunares duran unos 14 días cada uno.";
    text[457] = "Eso quiere decir que, durante 14 días, estamos alejados de nuestro brillante sol azul.";
    text[458] = "Hace unas décadas, esto era un problema muy serio.";
    text[459] = "Nuestros paneles solares eran inútiles durante las noches lunares.";
    text[460] = "A pesar de esto...";
    text[461] = "Gracias a los esfuerzos de las brillantes mentes de los Laboratorios Lunex,";
    text[462] = "entre las que figura tu padre, ¡inventamos el panel lunar!";
    text[463] = "A través de un proceso llamado enfriamiento radiactivo, ";
    text[464] = "aprovechamos la diferencia de temperatura entre Luna y el espacio exterior.";
    text[465] = "Enfriamiento radiactivo + aleación de aluminio + generador termoeléctrico...";
    text[466] = "Esa fue la fórmula para la creación del panel lunar.";
    text[467] = "¡La ciencia es increíble!";
    text[468] = "Estoy muy agradecida de contar con tecnología que haya ayudado a la humanidad a sobrevivir en Luna.";
    text[469] = "¿Cuántos paneles lunares has encontrado por ahora?";
    text[470] = "¡8!";
    text[471] = "¡Ya te falta muy poco!";
    text[472] = "Puedes encontrar todos los paneles en la Unidad de Almacenaje.";
    text[473] = "Recuerdo que había algunos corredores ocultos en esa zona...";
    text[474] = "¡Procura examinar el área concienzudamente!";
    text[475] = "¿Cuántos paneles lunares has encontrado por ahora?";
    text[476] = "¡9!";
    text[477] = "Quiero decir... ¿no cree que con esto bastaría?";
    text[478] = "Necesitamos 10, querida.";
    text[479] = "¿Seguro que no podríamos hacerlo con 9?";
    text[480] = "Estoy segura.";
    text[481] = "¿Al 100%?";
    text[482] = "A un mil millón por ciento.";
    text[483] = "No es un un diez mil millón por ciento... Eso quiere decir que no está tan segura.";
    text[484] = "Volveré a echar un vistazo a mis cálculos, por si acaso.";
    text[485] = "Pero seguimos necesitando 10.";
    text[486] = "Muy bien, trataré de encontrar el último.";
    text[487] = "¡Tengo todos los objetos!";
    text[488] = "¡Maravilloso! ¡Lo has hecho muy bien!";
    text[489] = "He dibujado un esquema mientras estabas fuera.";
    text[490] = "¡Debería ser fácil conectar los paneles lunares al núcleo motor!";
    text[491] = "Después de hacer algunos cálculos, ";
    text[492] = "parece que debería bastar con 9 paneles lunares.";
    text[493] = "¡Puedes quedarte con el panel restante como recuerdo!";
    text[494] = "Nunca se sabe... Puede que algún día te resulte útil.";
    text[495] = ".@P.@P.@P.@P.";
    text[496] = "Cielos, cada vez queda menos oxígeno en el aire.";
    text[497] = "El tiempo se agota, querida.";
    text[498] = "¡Me reuniré contigo junto al aerodeslizador cuando recoja mis herramientas!";
    text[500] = "AHORA PUEDES ACCEDER A LA UNIDAD DE ALMACENAJE 3.";
    text[501] = "Bella, he guardado la información que nos ha dado la Srta. Nyla en mis bancos de memoria.";
    text[502] = "¡Si olvidas lo que necesitamos, habla conmigo!";
    text[503] = "Estoy segura de que esto funcionará.";
    text[504] = "No@P.@P.@P. Borra eso.";
    text[505] = "¡Estoy segura al diez mil millón por ciento!";
    text[506] = "¡Gracias por ayudarnos, Srta. Nyla!";
    text[507] = "De nada, querida.";
    text[508] = "Habla conmigo cuando hayas reunido los paneles y tengas el generador.";
    text[509] = "Si quieres, ¡hasta puedo enseñarte una o dos cosas sobre el funcionamiento de los paneles!";
    text[510] = "Eh... Je... La ciencia no se me da demasiado bien, así que prefiero dejarle eso a usted.";
    text[511] = "Muy bien, querida. Te esperaré aquí.";
    text[696] = "¡Tengo todos los paneles lunares!";
    text[697] = "¿Compraste también el generador al mercader de astrotecnos?";
    text[698] = "Oh, no... ¡Todavía no tengo el generador!";
    text[699] = "Tranquila, querida, todavía estoy terminando mis cálculos.";
    text[700] = "Cuando consigas el generador, tendremos todo lo necesario.";
    text[518] = "Mmm... Parece que esta puerta tiene un cierre electrónico.";
    text[519] = "Debería haber un panel de control por aquí...";
    text[520] = "Si encontramos el panel de control, ¡podré entrar en la red! Je, je.";
    text[521] = "La puerta de la Unidad de Almacenaje está cerrada.";
    text[522] = "Necesitamos una tarjeta para abrirla.";
    text[523] = "¡Aquí hay un interruptor! ¿Quieres accionarlo?";
    text[524] = "El interruptor ya se ha accionado.";
    text[525] = "Este panel de control parece estar activado, pero no responde...";
    text[526] = "Bella, creo que hay un error en el software.";
    text[527] = "¡Puedo entrar digitalmente en la red y reiniciar el software!";
    text[528] = "¿Quieres que Tetra entre en el panel de control de la red?";
    text[529] = "La red ya se ha restaurado.";
    text[1339] = "No he conseguido reiniciar la red...";
    text[1340] = "No pasa nada Tetra, puedes intentarlo de nuevo.";
    text[1341] = "¡Confío en ti!";
    text[249] = "Bella, esto parece un callejón sin salida...";
    text[250] = "Y las baldosas con flechas nos impiden volver atrás.";
    text[251] = "¿Estamos atrapadas?";
    text[252] = "Mmmm... No, seguro que hay una manera de salir.";
    text[253] = "Solo tenemos que encontrarla.";
    text[254] = "¡Vaya, un camino oculto!";
    text[255] = "Ves, Tetra. Te dije que habría una manera de salir, je.";
    text[256] = "Je.";
    text[257] = "Bella, ¡hay un REFUERZO DE HABILIDAD detrás de la pared de cristal!";
    text[258] = "Oh, ¡tienes razón! ¡Los REFUERZOS DE HABILIDAD son muy raros!";
    text[259] = "¿Pero cómo podemos llegar allí? ¿Hay otra entrada?";
    text[260] = "¡Es hora de realizar un ZOOM ÓPTICO!...";
    text[261] = "25 POR CIENTO... 50 POR CIENTO...";
    text[262] = "75 POR CIENTO...";
    text[263] = "Mmmm...";
    text[264] = "¡AH!";
    text[265] = "Puedo ver una diminuta etiqueta en el interruptor de la cabina del ascensor.";
    text[266] = "¿Qué pone?";
    text[267] = "Instalación de la Barrera: Bodega de Carga";
    text[268] = "¡Buen trabajo Tetra!";
    text[269] = "¡La puerta de atrás se encuentra en la Instalación de la Barrera!";
    text[701] = "¡Espera, Bella! ¡Tengo una idea!";
    text[702] = "Si activas tu traje impulsor, podrás moverte por la zona más rápido.";
    text[703] = "¡Así nos ahorraremos un montón de tiempo! Je, je.";
    text[704] = "¡Oh! ¡Tienes razón! Cielos, no sé por qué no pensé en eso antes.";
    text[705] = "¡Hay una plataforma de impulso cerca! ¡Vamos a echar un vistazo!";
    text[706] = "ESTAS PLATAFORMAS PERMITEN A LOS USUARIOS AUTORIZADOS VOLAR POR LUNA CON SUS TRAJES IMPULSORES.";
    text[707] = "LA LEY LUNAR PROHÍBE A LOS USUARIOS SIN LICENCIA UTILIZAR TRAJES IMPULSORES";
    text[708] = "SIN USAR UNA PLATAFORMA DE IMPULSO.";
    text[709] = "¡USA TU TRAJE IMPULSOR PARA LLEGAR A OTRAS PARTES DEL MUNDO!";
    text[710] = "PERO... EH...";
    text[711] = "PARECE QUE TU CHIP DE VUELO HA SIDO DAÑADO.";
    text[712] = "ACCESO DENEGADO.";
    text[713] = "Recórcholis... Es posible que mi chip de vuelo sufriera daños mientras luchábamos con los lóbregos.";
    text[714] = "Necesito arreglarlo o encontrar uno nuevo.";
    text[715] = "Bella, tal vez podamos encontrar algún mercader en la Instalación de la Barrera.";
    text[716] = "¡Seguro que podremos comprar un chip de vuelo a algún mercader de astrotecnos!";
    text[717] = "Muy bien, supongo que por ahora tendremos que ir a pie.";
    text[1361] = "Nyla parece estar ocupada con la instalación.";
    text[1362] = "Hablemos primero con Mett.";
    text[961] = "Ohh... Ojalá esto funcione...";
    text[962] = "Funcionará, querido, no te preocupes. ¡El poder de la ciencia es sorprendente!";
    text[963] = "Muy bien, escuchadme.";
    text[964] = "Todo debería estar en su sitio y listo para empezar.";
    text[965] = "Mett, querido, ¡prepárate para pilotar el aerodeslizador!";
    text[966] = "Recargando el núcleo motor en...";
    text[967] = "... 3";
    text[968] = "... 2";
    text[969] = "... 1";
    text[970] = "¡Muy bien! Ahí está la escotilla. ¡Es hora de hacer las reparaciones!";
    text[971] = "30 minutos más tarde...";
    text[972] = "Parece que ahora todo está bajo control. ¡Menudo alivio!";
    text[973] = "He llamado a algunos ingenieros para que me ayuden a determinar el alcance de los daños.";
    text[974] = "¡Gracias, Srta. Nyla!";
    text[975] = "Has realizado un trabajo admirable, querida.";
    text[976] = "A fin de cuentas, usar los paneles lunares fue idea tuya.";
    text[977] = "¡Tú también lo has hecho muy bien, Tetra!";
    text[978] = "¡Ultra-giga-ayudante Tetra! ¡Je, je!";
    text[979] = "¡G-gracias! Si no me hubieran ayudado, probablemente habría perdido mi trabajo.";
    text[980] = "Esto...";
    text[981] = "Esto no habría ocurrido si los lóbregos no existieran...";
    text[982] = "Sí.@P.@P.@P.@P.";
    text[983] = "Deberíamos marcharnos. Estoy sin energías.";
    text[984] = "¡Gracias a todos por vuestra ayuda!";
    text[985] = "Vamos, Tetra.";
    text[1365] = "...";
    text[986] = "Tetra, hay algo que no encaja.";
    text[987] = "Hace un tiempo que le estoy dando vueltas a un asunto.";
    text[988] = "Nunca llegamos a encontrar al lóbrego que atacó a Mett...";
    text[989] = "No solo eso, también tuve la rara sensación de alguien nos estaba observando...";
    text[990] = "¿Tetra .@P.@P.@P?";
    text[991] = "¡¿DÓNDE ESTÁ TETRA?!";
    text[992] = "¡¡¡TETRAAAAAA!!!";
    text[993] = "... ¿Dónde estoy? ";
    text[994] = "¿Estoy soñando?";
    text[995] = "No. Es demasiado real.";
    text[996] = "Este debe ser... ";
    text[997] = "El mundo que hay al otro lado de los agujeros de gusano.";
    text[998] = "... La Zona Fantasma.";
    text[999] = "¿Por qué me ha traído el lóbrego aquí?";
    text[1000] = "¿Tetra...?";
    text[1001] = "¡Mi localizador indica que está cerca...!";
    text[1002] = "¡Tengo que encontrar a Tetra y sacarla de aquí!";
    text[1366] = "OBJETIVO: ENCUENTRA A TETRA Y ESCAPA DE LA ZONA FANTASMA.";
    text[1003] = "¡Tetra! ¡¡Gracias al cielo que estás bien!!";
    text[1004] = "¡Bella! ¡Tetra está superduper encantada de verte!";
    text[1005] = "Detecté al lóbrego que atacó el aerodeslizador de Mett y de pronto...";
    text[1006] = "Tetra cayó en un agujero de gusano y acabó en este lugar aterrador...";
    text[1007] = "¿Esto es... la Zona Fantasma?";
    text[1008] = "No lo sé, pero supongo que sí.";
    text[1373] = "Si los de arriba se enteran, estaremos metidas en un buen lío.";
    text[1378] = "¡Estaremos metidas en un lío aún mayor si no encontramos una manera de salir de aquí!";
    text[1374] = "Lo sé. Pero tampoco entramos aquí voluntariamente...";
    text[1375] = "No me lo puedo quitar de la cabeza. ¿Por qué nos trajo el lóbrego aquí?";
    text[1376] = "¡¿Tal vez quiera matarnos y usarnos para alimentar a sus amigos?!";
    text[1377] = "Los robots no tienen buen sabor, así que estoy más bien preocupada por ti, Bella.";
    text[1372] = "Aquí no estamos seguras.";
    text[1379] = "No te preocupes, Tetra.";
    text[1009] = "Mamá solía realizar expediciones a la Zona Fantasma con su escuadrón de vez en cuando, ¿lo recuerdas?";
    text[1010] = "Nunca me habló mucho de este lugar, pero estoy segura de que hay una manera de salir de él.";
    text[1011] = "Tetra, ¿cuáles son nuestras coordenadas?";
    text[1012] = "Coordenadas DESCONOCIDAS...";
    text[1013] = "Sí, está claro que ya no estamos en Luna...";
    text[1014] = "Recórcholis...";
    text[1015] = "Tengo tantas preguntas...";
    text[1016] = "Pero no tenemos tiempo para quedarnos de brazos cruzados sin hacer nada.";
    text[1017] = "Este lugar es tremendamente peligroso...";
    text[1018] = "Tratemos de encontrar una manera de salir de aquí.";
    text[1019] = "¡Puedes contar conmigo!";
    text[1020] = "¡La ayudante exploradora de la Zona Fantasma Tetra está lista!";
    text[1381] = "(Otra vez... ¿Qué es esta extraña sensación?)";
    text[1382] = "(Siento como si alguien me estuviera llamando desde lejos).";
    text[1383] = "(¿Una voz...?)";
    text[1384] = "(...)...";
    text[1385] = "Bella, ahora estamos en territorio enemigo. Detecto a varios lóbregos en esta zona.";
    text[1386] = "Las señales proceden de esas brechas moradas.";
    text[1387] = "Muy bien, tendremos que andar con pies de plomo...";
    text[1388] = "...";
    text[1389] = "¿Es cosa mía, o esta zona me resulta curiosamente familiar?";
    text[1390] = "¿Qué quieres decir?";
    text[1391] = "Parece como si estuviéramos en Regolithia.";
    text[1392] = "¿Cómo? ¡Pero eso es imposible!";
    text[1393] = "Si mi intuición no me engaña, el monolito debería estar cerca de aquí...";
    text[1394] = "Sigamos adelante.";
    text[1395] = "¡Allí está! ¡Allí también hay un monolito! ";
    text[1396] = "Pero..., ¡¿cómo...?!";
    text[1397] = "¡...!";
    text[1398] = "¡AAAH! ¡QUÉ RÁPIDO!";
    text[1402] = "¡Es el lóbrego que nos trajo aquí!";
    text[1403] = "(...)";
    text[1404] = "(Parecía que ese lóbrego estaba gritando de dolor...)";
    text[1405] = "(Mi instinto me dice que huya, pero mi corazón...)";
    text[1406] = "(... mi alma...)";
    text[1407] = "(... me dicen que actúe de otra manera).";
    text[1399] = "Tetra... Tenemos que permanecer atentas y seguir adelante.";
    text[1400] = "Creo que tengo un plan para volver a Luna.";
    text[1401] = "¡A volar!";
    text[1408] = "Así que por fin nos conocemos.";
    text[1409] = "Este lóbrego parece bastante duro.";
    text[1410] = "Bella, ¡este lóbrego no aparece en nuestra base de datos!";
    text[1411] = "¡Es una variante nueva! DENOMINACIÓN: ¡CHRONOS!";
    text[1420] = "¡Es más poderoso que ningún otro lóbrego que hayamos encontrado hasta la fecha!";
    text[1421] = "Recórcholis...";
    text[1422] = "¿Por qué no tratamos de razonar con él en vez recurrir a la violencia?";
    text[1423] = "¿¡Cómo?!";
    text[1424] = "¡Lóbrego! ¿Por qué nos has traído aquí?";
    text[1425] = "¿Entiendes lo que estoy diciendo?";
    text[1426] = "¡Di algo, por favor!";
    text[1427] = "Bella, no hay nada que hacer.";
    text[1428] = "No podemos comunicarnos con él.";
    text[1429] = "Lo sé, pero...";
    text[1461] = "Un momento, ¿qué está haciendo? Parece que se ha quedado mirándonos...";
    text[1462] = "Me está poniendo nerviosa.";
    text[1463] = "Nos está observando. Tal vez esté esperando para ver qué hacemos.";
    text[1464] = "Debe habernos traído aquí por algún motivo...";
    text[1465] = "No sé por qué lo habrá hecho, pero";
    text[1466] = "tal vez nos esté poniendo a prueba...";
    text[1467] = "Bella, eso no tiene sentido.";
    text[1468] = "¡Creo que está esperando a que corramos para lanzarse sobre nosotros y DEVORARNOS!";
    text[1469] = "Mmm... no creo. Si ese fuera el caso, ya lo habría hecho.";
    text[1470] = "Este lóbrego es@P.@P.@P. diferente.";
    text[1438] = "¡Bella, parece que está perdiendo la paciencia!";
    text[1439] = "¡Podría atacar en cualquier momento!";
    text[1440] = "Aunque este lóbrego es poderoso, sigue sin ser rival para nosotras dos.";
    text[1441] = "Muy bien, Tetra. El plan es sencillo: lucharemos con él hasta agotarle.";
    text[1442] = "Llegará un momento en el que tratará de escapar a través de un agujero de gusano.";
    text[1443] = "¡Y entonces aprovecharemos para salir de aquí!";
    text[1444] = "¿Y si el agujero de gusano no nos lleva de vuelta a casa?";
    text[1445] = "Entonces encontraremos uno que lo haga. Los guerreros lunex nunca se dan por vencidos. ¿Verdad, Tetra?";
    text[1446] = "¡Cierto! ¡No pararemos hasta conseguir la victoria! ¡Muah, ja, ja, ja, ja!";
    text[1447] = "Si este lóbrego vuelve a Luna, tendremos muchos más problemas entre manos.";
    text[1448] = "Al menos aquí podemos luchar contra él sin preocuparnos de que nadie salga herido.";
    text[1449] = "¿Estás lista, Tetra?";
    text[1450] = "¡Tetra la Cazalóbregos está lista!";
    text[1451] = "Ha llegado el momento...";
    text[1452] = "¡Voy a tener que ir a por todas!";
    text[1453] = "¡Escucha, lóbrego!";
    text[1454] = "No dejaré que amenaces a mi gente.";
    text[1455] = "¡No dejaré que siembres el caos en Luna!";
    text[1456] = "No sé por qué nos has traído aquí, pero algo es seguro:";
    text[1457] = "¡no vamos a caer sin plantarte cara!";
    text[1458] = "¡No subestimes nunca a un guerrero lunex!";
    text[1459] = "Parece que por fin se ha calmado.";
    text[1460] = "¿...?";
    text[1473] = "(¡Está pasando de nuevo...!)";
    text[1474] = "@P. @P. P@P. @P. r@P. @P.";
    text[1475] = "@P. P@P. r@P. @P. o@P. @P. t@P. e@P. g@P. er@P.";
    text[1476] = "(¿Proteger...?)";
    text[1477] = "(¡Esa voz...!)";
    text[1478] = "(¡Es la misma voz que escuché antes!)";
    text[1479] = "(¿Puedes... entenderme?)";
    text[1480] = "¡Cuidado, Bella! ¡Se acercan más lóbregos!";
    text[1481] = "Recórcholis, ¡estamos rodeadas!";
    text[1482] = "Nuestro combate debe haber llamado su atención.";
    text[1483] = "¡Detecto una enorme acumulación de energía!";
    text[1484] = "¡...!";
    text[1485] = "¡Holoescudos al máximo!";
    text[1486] = "Bella, ¡¿estás bien?!";
    text[1487] = "Estoy... Estoy bien.";
    text[1488] = "Pero he usado todos mis holoescudos...";
    text[1489] = "Buff... Buff...";
    text[1490] = "Uuuugh... Ha estado demasiado cerca...";
    text[1491] = "No@P.@P.@P.@P No puedo mover un músculo...";
    text[1492] = "¡No deis un paso más!  ¿Cómo os atrevéis a hacer daño a Bella?";
    text[1493] = "Tetra... No les provoques. ";
    text[1494] = "Quédate a mi lado.";
    text[1495] = "Buff... Buff...";
    text[1496] = "No podemos rendirnos..., ¡pase lo que pase!";
    text[1497] = "¡¡AAAAAAAAAAAAH!!";
    text[1498] = "¡Estamos de regreso en Luna!";
    text[1499] = "Estaba muerta de MIEDO...";
    text[1500] = "Pensaba que íbamos a MORIR...";
    text[1501] = "Sí, ha faltado un pelo...";
    text[1502] = "¡Bella, mira allí! ¡Un antinúcleo rojo!";
    text[1503] = "Es el antinúcleo de Chronos...";
    text[1504] = "Chronos ha dado su vida para salvarnos...";
    text[1505] = "Sí...";
    text[1506] = "Malinterpretamos las intenciones de Chronos.";
    text[1507] = "Creo que quería que le ayudáramos.";
    text[1508] = "¿Cómo puedes saberlo?";
    text[1509] = "Es difícil de explicar.";
    text[1510] = "Podía sentir el dolor de Chronos.";
    text[1511] = "Lo sentí en mi alma.";
    text[1512] = "Es posible que esté relacionado con las extrañas sensaciones que he estado teniendo últimamente.";
    text[1513] = "¡Bellaaaaaa! ¡Tienes que decirme esas cosas en vez de guardártelas para ti sola!";
    text[1514] = "Sí, lo sé, lo sé...";
    text[1515] = "Quién sabe qué efecto ejerció la Zona Fantasma en nuestros cuerpos.";
    text[1516] = "¡Había antimateria POR TODAS PARTES!";
    text[1517] = "Deberíamos pedirle al doctor Thomas que te eche un vistazo. Tetra está empezando a preocuparse.";
    text[1518] = "¡Noooo!";
    text[1519] = "¿Cómo? ¿Por qué no?";
    text[1520] = "Aunque no lo hicimos a sabiendas, violamos el protocolo al acceder a la Zona Fantasma.";
    text[1521] = "No quiero meterme en un lío...";
    text[1522] = "¡Promete que me meteré en una cámara de curación cuando volvamos a la estación!";
    text[1523] = "Tetra, no podemos contarle esto a nadie.";
    text[1524] = "Prométemelo.";
    text[1525] = "...";
    text[1526] = "De acuerdo, lo prometo.";
    text[1527] = "Pero si veo algo extraño cuando analice tus constantes vitales, el Doctor Thomas debe saberlo.";
    text[1528] = "Muy bien.";
    text[1529] = "Sé que se supone que debemos llevar los antinúcleos al Cuartel General, pero...";
    text[1530] = "Creo que voy a quedarme con los antinúcleos que consigamos a partir de ahora.";
    text[1531] = "¡Chupi! Ahora tenemos 2 antinúcleos, je.";
    text[1532] = "Chronos...";
    text[1533] = "Gracias...";
    text[1534] = "¡Gracias por protegernos, Chronos!";
    text[1535] = "@P.@P.@P.@P.@P.@P.";
    text[1536] = "«Proteger»@P.@P.@P.";
    text[1537] = "Por cierto, ¿escuchaste hablar a Chronos?";
    text[1538] = "¿Qu-qué? ¿Habló? Yo no escuché nada.";
    text[1539] = "Mmm... Tal vez fuera comunicación telepática.";
    text[1540] = "Me pregunto si todos los lóbregos tienen esta habilidad...";
    text[1541] = "Qué extraño...";
    text[1542] = "La voz de Chronos no se parecía a ninguna voz que haya escuchado antes,";
    text[1543] = "pero me pareció extrañamente familiar.";
    text[1544] = "...";
    text[1545] = "Si algún día aprendo a comunicarme con los lóbregos,";
    text[1546] = "tal vez podamos encontrar la paz que tanto ansiamos.";
    text[1547] = "¡Parece que hoy hemos conseguido información muy valiosa sobre los lóbregos!";
    text[1548] = "Pero todavía hay mucho que desconocemos.";
    text[1549] = "Este viaje... solo es el comienzo.";
    text[1550] = "(Mamá, por favor, cuida de nosotros).";
    text[1551] = "(Haré todo lo que esté en mi mano para proteger a la gente de Luna).";
    text[1552] = "Vamos, Tetra. Debemos descansar un poco.";
    text[1553] = "Vayamos a casa.";
    text[1554] = "¡Muy bien! Nuestra nave todavía debería estar aparcada en el Astropuerto Sureste.";
    text[1555] = "Bien, ¡vamos, que nos vamos!";
    text[1579] = "OBJETIVO: ¡USA TU NAVE EN EL ASTROPUERTO SUDESTE Y VE A LA ";
    text[1580] = "ESTACIÓN ESPACIAL LUNEX!";
    text[1583] = "¡¿Ese es Chronos?!";
    text[1584] = "No, eso es un fantasma.";
    text[1585] = "Los lóbregos jefe emiten tanta antimateria que, aunque hayan sido derrotados,";
    text[1586] = "el exceso de antimateria que queda se convierte a veces en un fantasma.";
    text[1593] = "Básicamente, es una acumulación repentina de energía que adopta la forma de un lóbrego jefe.";
    text[1587] = "Antes de que los fantasmas aparezcan, acumulan una gran cantidad de antimateria de sus alrededores,";
    text[1588] = "y eso puede hacerles más fuertes que sus formas originales.";
    text[1589] = "Vaya, Tetra, ¿de dónde has sacado esa información?";
    text[1590] = "De los archivos confidenciales del doctor Thomas.";
    text[1591] = "Puede que haya descargado algunos de los archivos (o puede que no)... Je.";
    text[1592] = "Sea como fuere, ¡ahora mismo tenemos un fantasma al que enfrentarnos!";
    text[1594] = "¡La ayudante cazafantasmas Tetra está lista para el combate!";
    text[1706] = "¡Buenos días, doctor Thomas!";
    text[1712] = "Mueh, je, je, ¡su informe semanal está listo!";
    text[1713] = "...";
    text[1714] = "¿Doctor Thomas?";
    text[1715] = "¿Es hermosa, verdad?";
    text[1716] = "¡Luna siempre es un regalo para la vista!";
    text[1717] = "¡Ssssí, y que lo diga! ¡Todo un regalo para la vista, mueh, je, je!";
    text[1718] = "La humanidad ha llegado tan lejos...";
    text[1719] = "... y aun así, nos queda tanto por aprender y descubrir..";
    text[1720] = "El ilimitado potencial que poseemos...";
    text[1721] = "¡es ASTRONÓMICO!";
    text[1722] = "¡Ssssí, astronómico!";
    text[1723] = "Reeves, el informe, por favor.";
    text[1724] = "Esta semana hemos tenido 7 incidentes con lóbregos. Por suerte, no ha habido muertes...";
    text[1725] = "Además, se ha observado una reducción en la producción de comida de Rancho Kepler.";
    text[1726] = "Esos impredecibles lóbregos están destruyendo nuestras infraestructuras...";
    text[1727] = "Es posible que se tarde un poco en reconstruir la granja y los sectores de producción de comida. ";
    text[1728] = "Puede que no duremos mucho más si seguimos así...";
    text[1729] = "No debemos rendirnos, Reeves. La gente nos ha otorgado su confianza.";
    text[1730] = "La ciencia nos ha llevado hasta aquí.";
    text[1731] = "¡Seguiremos estudiando a los lóbregos y mejoraremos nuestra tecnología!";
    text[1732] = "¡Debemos garantizar que las futuras generaciones tengan una vida próspera!";
    text[1733] = "CÓDIGO ROJO: ¡CUERPO ASTRAL DESCONOCIDO DETECTADO!";
    text[1735] = "Nyla, ¿qué está pasando?";
    text[1736] = "¡Nuestros sensores han detectado un enorme cometa!";
    text[1737] = "Deje que confirme las coordenadas aproximadas@P.@P.@P.@P";
    text[1738] = "Fecha estimada de contacto: 377 días...";
    text[1739] = "¡Y su rumbo le lleva a una colisión directa con Luna!";
    text[1740] = "¡Imposible! ¡Si estuviera tan cerca, lo habríamos detectado antes!";
    text[1741] = "Nuestros sensores deberían funcionar sin problemas...";
    text[1742] = ".@P.@P.@P.@P.@P.@P. ¡A no ser que...!";
    text[1743] = "Reeves, ¿qué muestra el escáner molecular?";
    text[1744] = "¡...!";
    text[1745] = "Doctor, detectamos enormes concentraciones de positrones...";
    text[1746] = "¡¿Positrones?! No puede ser...";
    text[1747] = "¡Está hecho de antimateria!";
    text[1748] = "¡ES EL APOCALIPSIS!";
    text[1749] = "Según nuestras predicciones, tardaría otros mil años en volver a ocurrir...";
    text[1750] = "¿Cuál es su tamaño?";
    text[1751] = "¡Mueh, je, je...! Doctor, tiene unos 2000 km de diámetro.";
    text[1752] = "Astronómico... ¡Ese cometa es la mitad de grande que Luna!";
    text[1753] = "Parece que ha completado su órbita irregular mucho antes de lo que esperábamos.";
    text[1754] = "Thomas, ¿podría ser...?";
    text[1755] = "Sí, me temo que sí.";
    text[1756] = "Es... el cometa que atravesó Terra hace mil años,";
    text[1757] = "y que casi consiguió eliminar a toda la humanidad.";
    text[1758] = "El cometa Coda ha regresado.";
    text[1759] = "... y solo tenemos un año para encontrar una manera de evitar la catástrofe...";
    text[1760] = "Tengo un plan.";
    text[1761] = "Reeves.";
    text[1762] = "Nyla.";
    text[1763] = "Reunión de emergencia en mi laboratorio.";
    text[1764] = "Enviad un informe al general Saros y solicitad su presencia.";
    text[1765] = "Y...";
    text[1766] = "Decidle a Bella que venga también.";
    text[1767] = "(Han pasado unas pocas horas desde la brecha en el sector 16... Espero que esté bien).";
    text[1768] = "¡Los demás deben reunir todos los datos que puedan sobre el cometa Coda y vigilarlo de cerca!";
    text[1769] = "¡Sí, doctor Thomas!";
    text[1770] = "(Debo mantener la calma y procurar que todo el mundo tenga la moral alta).";
    text[1771] = "(El fin de la humanidad...)";
    text[1772] = "(Es algo que no pienso aceptar).";
    text[1773] = "(¡El futuro de la gente de Luna está en nuestras manos!)";
    text[1774] = "¡Hogar, dulce hogar!";
    text[1775] = "¡Sí!";
    text[1776] = "¿Y esto? ¡La Srta. Nyla nos llama!";
    text[1557] = "Bella, querida... Ya han pasado unas cuantas horas... ¿Va todo bien?";
    text[1558] = "Parecías un poco preocupada cuando arreglamos el aerodeslizador.";
    text[1559] = "Oh, sí, todo está bien, Srta. Nyla.";
    text[1560] = "Solo estaba.@P.@P.@P.@P cansada tras la misión.";
    text[1561] = "Ya veo. Bueno, sea como fuere, me alegro de que estés bien.";
    text[1562] = "Nos han llegado noticias urgentes...";
    text[1563] = "Debes dirigirte al Laboratorio de Investigación, en la planta 3.";
    text[1564] = "Tu padre está celebrando una reunión de emergencia, y quiere contar con tu presencia.";
    text[1565] = "Ven tan pronto como puedas, querida.";
    text[1566] = "¡Recibido!";
    text[1707] = "¡¿Una emergencia?! ¡Bella, debemos darnos prisa!";
    text[1567] = "¿Cuánto te apuestas a que es un problema con los lóbregos?";
    text[1568] = "¡2 barritas de tarta de queso!";
    text[1569] = "Tetra, no puedes comer barritas de tarta de queso...";
    text[1710] = "Je.";
    text[1711] = "Objetivo: VE AL LABORATORIO DE INVESTIGACIÓN EN LA PLANTA 3, POR EL CORREDOR OESTE.";
    text[2223] = "¡Hola a todos!";
    text[2224] = "¡Oh! ¡Bella! ¡Tetra!";
    text[2225] = "Es estupendo teneros de vuelta, ¡me alegro tanto de veros!";
    text[2226] = "Me preocupé mucho cuando me enteré de la brecha en la Astrobarrera del sector 16...";
    text[2227] = "¿Estáis bien? Parecéis agotadas...";
    text[2228] = "Estamos bien. Solo un poco magulladas tras luchar con los lóbregos, ja, ja.";
    text[2229] = "Y hablando de agotamiento... Parece que todo el departamento lleva días sin dormir.";
    text[2230] = "¿En serio? ¡En ese caso, sé exactamente lo que necesito...!";
    text[2231] = "¡NOOOOOO!";
    text[2232] = "¡VACÍA!";
    text[2233] = "¡Nos hemos quedado sin ELIXIR DIVINO!";
    text[2234] = "¿Elixir Divino?";
    text[2235] = "Era «Jugo Espiritual» la semana pasada.";
    text[2236] = "Ah... ¡Por supuesto! ¡Café, sssí!";
    text[2237] = "Oh, Nyla, solo los cafeteros más entendidos conocen el auténtico nombre del café:";
    text[2238] = "¡El ELIXIR DIVINO!";
    text[2239] = "No pasa nada. ¡Siempre llevo encima mi minicafetera!";
    text[2324] = "¡Es una versión portátil de la Cafetera Definitiva que inventé, je!";
    text[2240] = "Bella, ¿qué quieres tomar?";
    text[2241] = "¡Un latte de vainilla helado, por favor!";
    text[2242] = "¡Tetra quiere lo mismo!";
    text[2243] = "Tetra, no puedes tomar café.";
    text[2244] = "Ah, es verdad...";
    text[2245] = "¡Muy bien! Toma, justo como te gusta.";
    text[2246] = "¿Reeves? ¿Doble expreso?";
    text[2247] = "Mueh... Tengo que superar mis límites.";
    text[2248] = "Triple expreso, doctor.";
    text[2249] = "¡Vaya, acabas de impresionarme!";
    text[2250] = "¡Pronto serás capaz de tomar sin problemas el famoso ELIXIR DIVINO!";
    text[2251] = "Mueh, je, je.";
    text[2252] = "¿Nyla?";
    text[2253] = "No, gracias... Ahora mismo no me apetece.";
    text[2254] = "Doctor, ¡tenemos que centrarnos en el asunto que nos atañe!";
    text[2255] = "Un segundo.";
    text[2256] = "Aaah, ¡recién hecho! Un sorbo hace que te sientas más ligero.";
    text[2257] = "¡Mi lux pronto alcanzará niveles astronómicos! ¡Ja, ja, ja, ja!";
    text[2258] = "Thomas, deberías reducir el consumo de cafeína. Ya es la cuarta taza que te tomas hoy.";
    text[2259] = "Mueh, je, je... Pero el café es lo que engrasa los engranajes de la brillante mente del doctor.";
    text[2260] = "¡Algunos dicen que es el secreto de su gran inteligencia! ¡Mueh, je, je!";
    text[2261] = "... ¡Muy bien! Es hora de ponerse serios.";
    text[2262] = "Bella, tenemos una emergencia.";
    text[2263] = "Lo que estoy a punto de revelar... es estrictamente confidencial.";
    text[2264] = "Si la gente se enterara, se generaría una gran inquietud, y cundiría el pánico.";
    text[2265] = "¡AAAAAAAH!";
    text[2266] = "¡NOOOOOOO! ¿CÓMO?";
    text[2267] = "¡Tenemos que hacer algo con ese cometa! ¡AHORA!";
    text[2268] = "¡¿QUÉ HACEMOS?!";
    text[2269] = "¿Qué puedo hacer para ayudar?";
    text[2270] = "¡Tetra también quiere echar una mano!";
    text[2271] = "Esperad, esperad. Ante todo, tranquilizaos.";
    text[2272] = "Debemos hacer frente a este problema paso a paso.";
    text[2273] = "El cometa Coda está hecho de una extraña variedad de antimateria que no comprendemos del todo.";
    text[2274] = "Es extremadamente volátil y posee una gran densidad energética.";
    text[2275] = "Hace mucho tiempo, la gente de Terra lanzó sus armas más destructivas contra el cometa...";
    text[2276] = "movida por la desesperación...";
    text[2277] = "y no se consiguió nada.";
    text[2278] = "El cometa lo consumió todo a su paso.";
    text[2279] = "Oooh... Tetra quería desintegrar el planeta con su cañón de plasma.";
    text[6012] = "¿Y si activáramos el Sistema Defensivo de la Astrobarrera?";
    text[6013] = "El SDA funciona contra asteroides pequeños y basura espacial,";
    text[6014] = "pero esto es demasiado grande...";
    text[6015] = "La Astrobarrera no podrá con él.";
    text[2280] = "Nuestra tecnología no es lo suficientemente avanzada como para eliminar un cometa de esta magnitud.";
    text[2281] = "A pesar de esto... ¡todavía hay esperanza!";
    text[2282] = "Y si... ¿utilizáramos nuestra tecnología de teletransporte?";
    text[2283] = "¿Mueh?";
    text[2284] = "¡...!";
    text[2285] = "Ya somos capaces de teletransportar a personas a distancias reducidas con nuestros teletransportadores.";
    text[2286] = "Si utilizáramos el mismo concepto, lo ampliáramos e hiciéramos algunos ajustes...";
    text[2287] = "... Esto me resulta familiar. Ya sé dónde quieres llegar, Thomas.";
    text[2288] = "¡No puedes decirlo en serio!";
    text[2289] = "Lo estoy diciendo.";
    text[2290] = "¡El cometa no será rival para nosotros si completamos Celestia!";
    text[2291] = "No. Es demasiado arriesgado. ¡Thea canceló el proyecto por un motivo!";
    text[2292] = "Nyla, hazme caso, ¡es nuestra mejor opción!";
    text[2293] = "¿Mueh?";
    text[2294] = "Reeves, ¿sabes de lo que están hablando?";
    text[2295] = "No tengo ni idea...";
    text[2296] = "Probablemente es un proyecto en el que trabajaron antes de que me uniera al equipo.";
    text[2297] = "Nyla...  Debemos terminar lo que empezamos.";
    text[2298] = "Aunque este camino es peligroso, creo que es el que nos ofrece más probabilidades de éxito.";
    text[2299] = "Papá, ¿de qué estáis hablando?";
    text[2300] = "Ya lo verás, Bella, je, je, je.";
    text[2301] = "Nyla, ya he hablado de mi plan con Saros.";
    text[2302] = "¿Está de acuerdo?";
    text[2303] = "Sí. De hecho, ya está haciendo preparativos para una misión.";
    text[2304] = "... Vale, está bien.";
    text[2305] = "Cielos, Thomas... Tú y tus alocados planes.";
    text[2306] = "¡No nos llaman científicos chiflados por nada, mueh, je, je!";
    text[2307] = "Reeves, eres el único que nos llama así.";
    text[2308] = "¡Mueh!";
    text[2309] = "Escucha, si vamos a reanudar el proyecto, será mejor que lo hagamos bien.";
    text[2310] = "Esta vez no debe haber errores.";
    text[2311] = "Si todos unimos nuestras fuerzas, triunfaremos... ¡y salvaremos a la humanidad!";
    text[2312] = "Ahora seguidme todos, por favor.";
    text[2313] = "No puedo creer que todo esto esté pasando... Es tan repentino...";
    text[2314] = "No te preocupes, Bella, ¡cumpliremos con nuestra parte y protegeremos a todos, cueste lo que cueste!";
    text[2315] = "¡La insuperable ayudante Tetra hará caer su furia sobre el cometa Coda y los lóbregos! ¡Muah, ja, ja, ja, ja!";
    text[2316] = "¡Aaaagh! Tetra, tienes razón. La gente confía en nosotros.";
    text[2317] = "¡No podemos defraudarles! Vamos, reunámonos con papá.";
    text[2318] = "Me pregunto qué habrá tras esa puerta...";
    text[2319] = "¡Será la primera vez que entraremos en una zona restringida!";
    text[2320] = "Ah, sí, acabo de recordar algo.";
    text[2321] = "¿Qué?";
    text[2322] = "Parece que me debes 2 barritas de tarta de queso.";
    text[2323] = "Oh, sí, ja, ja. ¡Por supuesto!";
    text[2325] = ".@P.@P.@P.@P.@P.@P.";
    text[2326] = "¡Nunca había estado en esta sala!";
    text[2327] = "Mueh, je, je. Yo tampoco.";
    text[2328] = "Muy pocas personas están autorizadas a entrar aquí.";
    text[2329] = "Bienvenidos al Laboratorio Nexus. Aquí es donde guardamos nuestros proyectos más secretos. ";
    text[2330] = "¡Vaya! ¡¿Qué es esa máquina?!";
    text[2331] = "Es lo que os quería mostrar. ¡Abrid bien los ojos!";
    text[2332] = "Esta es Celestia: ¡la primera máquina de agujeros de gusano de la humanidad!";
    text[2333] = "¡MUEH, JE, JE, JE, JE!";
    text[2334] = "¡Espectacular! ¡Un invento increíble!";
    text[2335] = "¿Así que nuestro plan es detener el cometa Coda con un agujero de gusano?";
    text[2336] = "¡Exactamente!";
    text[2337] = "¡Celestia será la siguiente maravilla científica de la humanidad!";
    text[2338] = "¿Celestia será capaz de crear un agujero de gusano de esas dimensiones?";
    text[2339] = "Teóricamente, sí. Pero ahora mismo, no puede hacerlo.";
    text[2340] = "Celestia sigue siendo un prototipo.";
    text[2341] = "Necesitamos algo de tiempo para diseñar y finalizar la construcción de la máquina. ";
    text[2342] = "Un tiempo que es un recurso valioso y limitado...";
    text[2343] = "¿Cuánto tiempo os llevará realizar la mejora?";
    text[2344] = "Seis meses como mínimo. Tal vez menos, si todo va sin problemas.";
    text[2345] = "También necesitamos otro recurso para que este plan funcione.";
    text[2346] = "¿Supongo que por eso querías que Bella estuviera aquí?";
    text[2347] = "Je, ¡he estado esperando pacientemente mi misión!";
    text[2348] = "¡Decidme cómo puedo ayudar, por favor!";
    text[2349] = "Bueno, Celestia necesita una fuente de energía específica para poder mantener abierto";
    text[2350] = "un agujero tan grande.";
    text[2351] = "La forma de energía cósmica más poderosa del universo: ¡la antimateria!";
    text[2352] = "¡Necesitaremos antimateria, y MUCHA para poder crear un";
    text[2353] = "agujero de gusano cósmico astronómico!";
    text[2354] = "Ahora mismo, nuestra única fuente de antimateria estable son...";
    text[2355] = "... los lóbregos.";
    text[2356] = "Correcto.";
    text[2357] = "¿Qu-qué? ¡Tendríamos que acabar con miles de lóbregos!";
    text[2358] = "No.@P.@P.@P.@P.";
    text[2359] = "No quiero hacerlo.@P.@P.@P.@P.";
    text[2360] = "Bella... Entiendo tu reticencia, pero...";
    text[2361] = "¡es algo que debemos hacer para garantizar nuestra supervivencia!";
    text[2362] = "...";
    text[2363] = "¡Si mamá todavía estuviera aquí, habría encontrado otra manera de hacerlo!";
    text[2364] = "¡Debe haber otra alternativa! Esto no me gusta nada...";
    text[2365] = "Oh, ¡es la comandante Vivia!";
    text[2366] = "Buenas tardes, doctor Thomas.";
    text[2481] = "Si está aquí, eso quiere decir...";
    text[2367] = "El general Saros ha llegado.";
    text[2368] = "¡¿Ya está aquí?!";
    text[2369] = "¡El héroe legendario finalmente hace acto de presencia! ¡Mueh, je, je, je!";
    text[2370] = "¡Con su fuerza y su poder militar, conseguiremos los antinúcleos que necesitamos en un periquete!";
    text[2371] = "¡Hola!";
    text[2372] = "Os pido disculpas, espero no llegar tarde para unirme a la fiesta.";
    text[2373] = "Vivia y yo llegamos tan rápido como pudimos.";
    text[2374] = "¡Es estupendo veros a todos!";
    text[2375] = "Thomas, ¿puedo suponer que todos están al tanto del plan?";
    text[2376] = "Sí, casi todos están de acuerdo.";
    text[2377] = "¿Casi todos?";
    text[2378] = "Bueno...";
    text[2379] = "Aah.";
    text[2380] = "Conociendo a Bella, esperaba algo de resistencia por su parte.";
    text[2381] = "Saros, no me parece bien matar a tantos lóbregos...";
    text[2382] = "Deja que te pregunte algo, Bella.";
    text[2383] = "¿Quieres salvar a la humanidad?";
    text[2384] = "Sí.";
    text[2385] = "Entonces es imperativo que consigamos los antinúcleos.";
    text[2386] = "Los lóbregos son monstruos. Son criaturas sin inteligencia que carecen de humanidad.";
    text[2387] = "No pertenecen a nuestro mundo.";
    text[2388] = "Lo único bueno que pueden aportar... son sus antinúcleos.";
    text[2389] = "...";
    text[2390] = "El desarrollo de Celestia comenzó hace 10 años.";
    text[2391] = "Tu padre, Nyla y otros científicos también formaban parte del proyecto. ";
    text[2392] = "En ese momento, el proyecto avanzaba lentamente.";
    text[2393] = "Realizamos 7 agujeros de gusano de prueba con éxito, pero...";
    text[2394] = "La prueba número 8 fue, desgraciadamente, la última que realizamos.";
    text[2395] = "De pronto, Celestia no funcionó como debía y creó un agujero de gusano inestable y turbulento.";
    text[2396] = "Cualquier cosa que absorbía quedaba destrozada a nivel molecular cuando lo cruzaba...";
    text[2397] = "Perdimos cuatro vidas ejemplares ese día...";
    text[2398] = "Poco después, el proyecto fue cancelado por tu madre, la anterior general.";
    text[2399] = "Tenía en gran valía todas las vidas, y no podía aceptar el riesgo de perder a otro miembro del equipo.";
    text[2400] = "Sí... Es definitivamente algo que mamá haría...";
    text[2401] = "A pesar de la trágica historia de este proyecto, creo que debemos finalizarlo. ";
    text[2402] = "Si tenemos éxito, las muertes de nuestros amigos no habrán sido en vano.";
    text[2403] = "¡Y también vengaremos a aquellos que cayeron víctimas de los lóbregos!";
    text[2404] = "Por aquel entonces, sabíamos muy poco sobre la ciencia de la antimateria.";
    text[2405] = "Pero, con el paso de los años, hemos aprendido más y la hemos estudiado a conciencia.";
    text[2406] = "Con los conocimientos que tenemos ahora, deberíamos ser capaces de minimizar los riesgos.";
    text[2407] = "Esta vez todo irá mucho mejor.";
    text[2408] = "¡Si combinamos nuestras fuerzas, podremos hacer frente a la amenaza de los lóbregos y al cometa Coda!";
    text[2409] = "¡Excelente! No puedo estar más de acuerdo, mueh, je, je.";
    text[2410] = "Saros tiene razón.";
    text[2411] = "Bella, soy tu padre y me apena tener que ponerte en peligro...";
    text[2412] = "... pero eres fuerte.";
    text[2413] = "Así es. Eres uno de nuestros mejores efectivos.";
    text[2414] = ".@P.@P.@P.@P.";
    text[2415] = "¡Ja, ja, ja, ja!";
    text[2416] = "Tus ojos lo dicen todo.";
    text[2417] = "Muy bien.";
    text[2418] = "Resolveremos este asunto... ¡con un duelo!";
    text[2419] = "Un momento, ¡¿cómo?!";
    text[2420] = "¡¿Un duelo?!";
    text[2421] = "Sí. Demuéstrame la fuerza de tus convicciones.";
    text[2422] = "Golpéame con tu técnica más poderosa: un combo lux.";
    text[2423] = "¡Atácame con todas tus fuerzas!";
    text[2424] = "Si yo gano, realizarás esta misión y seguirás las órdenes que recibas.";
    text[2425] = "¿Y si gano yo?";
    text[2426] = "Bueno...";
    text[2427] = "Entonces ya veremos.";
    text[2428] = "Bella, ¡ten cuidado, por favor! ¡El general Saros es el guerrero más poderoso de toda Luna!";
    text[2429] = "¡No te preocupes! Saros, ¡acepto tu desafío!";
    text[2430] = "¡EN GUARDIA!";
    text[2431] = "Creo que ya es suficiente.";
    text[2432] = "Bella, ¿estás bien? ¿Estás herida?";
    text[2433] = "Uuuuugh, es demasiado fuerte... No tenía nada que hacer.";
    text[2434] = "No has podido derrotarme, pero has mostrado tu resolución.";
    text[2435] = "Hacía mucho tiempo que no me divertía tanto con un duelo, ¡ja, ja, ja!";
    text[2436] = "No hay duda de que has aprovechado bien el entrenamiento de tu madre.";
    text[2437] = "... Recórcholis...";
    text[2438] = "No quiero que se derrame sangre si no es necesario... ¿Acaso es pedir mucho?";
    text[2439] = "¿Es que no hay otra manera de hacerlo?";
    text[2448] = "Bella. ¿Por qué no te tomas un tiempo para pensar qué quieres hacer?";
    text[2449] = "¿N-no vas a obligarme a hacer la misión?";
    text[2450] = "No. Como he dicho, has demostrado tu resolución.";
    text[2451] = "Si permaneces fiel a tus convicciones, tienes el poder para cambiar el mundo.";
    text[2452] = "La elección es tuya.";
    text[2453] = "Puedes seguir nuestra senda y acompañarnos, o crear tu propio camino.";
    text[2454] = "Mientras tanto, como general, haré lo que crea que sea mejor para Luna.";
    text[2457] = "Vivia, vamos a aumentar los programas de entrenamiento y a reclutar a más guerreros.";
    text[2458] = "Sí, general.";
    text[2459] = "Solo se dará información sobre el cometa Coda a los mejores escuadrones.";
    text[2460] = "¡Mientras los Laboratorios Lunex se centran en la máquina de agujeros de gusano, la Fuerza Lunex debe";
    text[2461] = "dar prioridad a la obtención de antinúcleos, aumentar los entrenamientos de combate y";
    text[2462] = "producir más receptáculos para luchar contra los lóbregos y salvar todas las vidas que podamos!";
    text[2463] = "¡Sí, general Saros!";
    text[2464] = "Thomas, espero que tú y tu equipo os aseguréis de completar Celestia. No me decepcionéis.";
    text[2465] = "Tranquilo, Saros, está controlado. ¿Tú y tus soldados obtendréis los antinúcleos necesarios? ";
    text[2466] = "¡Por supuesto! Ja, ja, ja.";
    text[2467] = "... (Ay)";
    text[2468] = "¿Por qué debe la humanidad enfrentarse a estas calamidades?";
    text[2469] = "Tal vez sea la cruel manera que tenga el universo de ponernos a prueba...";
    text[2470] = "... para descubrir hasta dónde hemos llegado como especie...";
    text[2471] = "Debemos evolucionar y superarnos. ¡Todos hemos de esforzarnos al máximo!";
    text[2472] = "¡Que nuestra lux brille para siempre!";
    text[2473] = "Vivia, vámonos.";
    text[2474] = "Bella, ¿estás bien?";
    text[2475] = "...";
    text[2476] = "Ahora tengo mucho en lo que pensar.";
    text[2477] = "Voy a ir a Oceanus.";
    text[2478] = "¿Quieres venir conmigo?";
    text[2479] = "¡SÍ! ¿Pero por qué vamos a Oceanus?";
    text[2480] = "Ya lo verás.";
    text[2483] = "¡Chupi dupi! ¡Vamos allá!";
    text[2491] = "¡Sí! ¡Estamos en la playa!";
    text[2492] = "¡¿Quieres ir a nadar?!";
    text[2493] = "¡Un baño puede hacerte olvidar tus preocupaciones!";
    text[2494] = "No te preocupes, soy sumergible, je, je.";
    text[2495] = "No hemos venido a nadar, Tetra.";
    text[2496] = "Oooh...";
    text[2497] = "Lamento ser una aguafiestas...";
    text[2510] = "¡No pasa nada, Bella! ¡Tetra solo quiere animarte! Je, je.";
    text[2499] = "Oceanus...";
    text[2500] = "Es uno de los lugares más hermosos de Luna.";
    text[2501] = "Mamá y papá solían venir aquí para hacer picnics.";
    text[2502] = "Papa conseguía olvidarse del trabajo un tiempo para descansar, y mamá y yo teníamos nuestras";
    text[2503] = "sesiones de entrenamiento en esta playa. La vida era más fácil por aquel entonces.";
    text[2504] = "Aaaah, ¡el simple hecho de estar aquí después de tanto tiempo es refrescante!";
    text[2505] = "Bella, ¿por qué no me has traído nunca aquí?";
    text[2506] = "Supongo que no he tenido demasiado tiempo libre desde que me convertí en una guerrera lunex.";
    text[2507] = "Ahora que el cometa se cierne sobre nuestras cabezas,";
    text[2508] = "quién sabe si tendremos la oportunidad de volver aquí de nuevo...";
    text[2509] = "No puedo relajarme sabiendo que el cometa Coda está ahí fuera y que debemos detenerlo.";
    text[2511] = "Saros me ha dado la oportunidad de crear mi propio camino...";
    text[2512] = "¡Si conseguimos elaborar un plan que resulte viable, tal vez puedas hacer que el general cambie de idea!";
    text[2513] = "Mmmm...";
    text[2514] = "Nuestro problema es que necesitamos una fuente de antimateria para que Celestia funcione...";
    text[2515] = "Exacto. Por eso Saros quiere conseguir antinúcleos.";
    text[2516] = "Pero...";
    text[2517] = "¿Y si hubiera otra manera de conseguir antimateria?";
    text[2518] = "¿Por ejemplo?";
    text[2519] = "¡Hay todo un mundo hecho de antimateria ahí fuera que podemos utilizar!";
    text[2520] = "¿Todo un mundo...?";
    text[2524] = "¡¿Te refieres a la Zona Fantasma?!";
    text[2521] = "¡Exactamente!";
    text[2522] = "¡La has visto con tus propios ojos Tetra!";
    text[2523] = "¡Podríamos realizar una expedición a la Zona Fantasma para conseguir todo el combustible que necesitamos!";
    text[2525] = "Sería peligroso volver allí solas. Necesitaríamos un equipo en condiciones.";
    text[2526] = "Pero esto también implicaría contarle a papá que visitamos la Zona Fantasma...";
    text[2527] = "Tal vez esté más dispuesto a dejarnos ir si sabe que estuvimos allí antes y logramos salir con vida.";
    text[2528] = "¿Seguro que quieres hacer esto, Bella?";
    text[2529] = "Sí. Estoy dispuesta a intentarlo aunque nos metamos en un lío.";
    text[2530] = "Al menos de esta manera no tendríamos que matar a ningún lóbrego.";
    text[2531] = "Muy bien, ¡expongamos nuestra idea al doctor Thomas!";
    text[2532] = "Un momento, antes tengo que hacer algo.";
    text[2533] = "Si la Fuerza Lunex se hiciera con el antinúcleo de Chronos,";
    text[2534] = "acabarían utilizándolo como fuente de energía.";
    text[2540] = "Chronos no se merece un destino así.";
    text[2535] = "Puede que los lóbregos sean monstruos, pero también tienen alma.";
    text[2536] = "Chronos nos protegió, como habría hecho cualquier héroe valiente.";
    text[2537] = "Supongo que esta es mi manera de darle las gracias.";
    text[2538] = "Vamos, Tetra, ¡volvamos a la Estación Espacial para hablar con papá!";
    text[2539] = "¡Muy bien, vamos allá!";
    text[7565] = "¿Qué están haciendo esas dos aquí?@P.@P.@P.@P.";
    text[2561] = "¡Bella! ¿Cómo te encuentras?";
    text[2562] = "¿Has cambiado de idea sobre la misión?";
    text[2563] = "Estoy mejor, pero no he cambiado de opinión.";
    text[2564] = "He decidido crear mi propio camino.";
    text[2565] = "Tengo una idea... y quiero que todos me prestéis atención.";
    text[2566] = "Por favor...";
    text[2567] = "No os enfadéis. Puedo explicarlo todo.";
    text[2568] = "No voy a enfadarme. Solo me preocupa lo que pueda pasarte...";
    text[2608] = "No hay nada de lo que preocuparse. Estoy bien.";
    text[2569] = "Bella..., sabemos que estuviste en la Zona Fantasma.";
    text[2570] = "¿¡Qu-qué!? Pero, ¿cómo os habéis enterado?";
    text[2571] = "Tal vez el general Saros pueda explicártelo.";
    text[2572] = "¡Hola! Perdonad que os interrumpa.";
    text[2573] = "Bella, me alegro de que hayas regresado.";
    text[2574] = "No sé si has decidido seguir mi plan o no, pero ahora estás aquí,";
    text[2575] = "y eso quiere decir que sigues decidida a querer cambiar las cosas.";
    text[2576] = "Cuando luchamos, me di cuenta de que había restos de un polvo estelar brillante en tu equipo de combate.";
    text[2577] = "(¿Cómo pudo darse cuenta? ¡Estábamos LUCHANDO!)";
    text[2578] = "Nuestros sensores también detectaron que había restos de antimateria en tu ropa.";
    text[2579] = "Bella, tenemos reglas por un motivo. Por favor, explícanos qué ocurrió.";
    text[2580] = "Sé que no se me permite ir a la Zona Fantasma, pero no tuve elección.";
    text[2581] = "¡El lóbrego que abrió la brecha en el sector 16 nos tendió una emboscada!";
    text[2582] = "¡Nos envió a través de un agujero de gusano y fue así como acabamos en la Zona Fantasma!";
    text[2583] = "¡Qué interesante...!";
    text[2584] = "Los lóbregos son criaturas sin inteligencia que solo obedecen a sus instintos destructivos.";
    text[2585] = "Es la primera vez que ocurre algo así...";
    text[2586] = "¡Muy interesante...!";
    text[2587] = "¿Qué ocurrió con el lóbrego?";
    text[2588] = "Le derroté.";
    text[2589] = "¿Y su antinúcleo?";
    text[2590] = "Lo...";
    text[2591] = "Lo perdí.";
    text[2592] = "Tuvimos que buscar una vía de salida que nos llevara de regreso a Luna a toda prisa.";
    text[2593] = "Ya veo.";
    text[2594] = "Parece que la suerte os acompañó.";
    text[2595] = "Los humanos solo pueden sobrevivir 72 horas en la Zona Fantasma.";
    text[2596] = "Los síntomas suelen aparecer al cabo de 48 horas.";
    text[2597] = "Cuando se llega a las 72 horas, la antimateria del entorno comienza a destrozar los átomos.";
    text[2598] = "Es algo que descubrimos por las malas.";
    text[2599] = "¡¿QUÉ?!";
    text[2600] = "Bella, ¡debemos analizar tus constantes vitales cuanto antes!";
    text[2682] = "Le dije que lo hiciera, pero nunca me hace caso...";
    text[2601] = "Papá, estoy bien. Solo estuve allí un par de horas.";
    text[2625] = "Que salieras con vida de allí en esta ocasión no garantiza que vayas a hacerlo la próxima vez.";
    text[2626] = "Supongo que tu idea era hacer una expedición a la Zona Fantasma, ¿verdad?";
    text[2627] = "Sí... Pensaba que allí podríamos conseguir toda la antimateria que necesitamos.";
    text[2602] = "Hay partes de la Zona Fantasma en las que la antimateria es tan densa,";
    text[2609] = "que en ellas tu cuerpo se desintegraría al instante.";
    text[2610] = "Ya habíamos pensado en enviar tropas a la Zona Fantasma para que dieran caza a los lóbregos que habitan allí.";
    text[2603] = "Desgraciadamente, el riesgo es demasiado alto.";
    text[2611] = "Hay muchas cosas que desconocemos de la Zona Fantasma.";
    text[2612] = "Pero sabemos que la antimateria que hay allí es inestable.";
    text[2613] = "Y para poder usar Celestia, necesitamos una variedad estable de antimateria,";
    text[2614] = "de ahí que los antinúcleos sean nuestra mejor opción.";
    text[2615] = "La Zona Fantasma... no es un mundo adecuado para los seres hechos de materia.";
    text[2616] = "Ojalá nuestros cuerpos pudieran evolucionar y superar sus propios límites...";
    text[2617] = "Entonces podríamos convertirnos en una especie realmente intergaláctica.";
    text[2618] = "Entonces... ¿vais a degradarme?";
    text[2619] = "No. Eres uno de nuestros mejores efectivos.";
    text[2620] = "Esta vez no tendremos en cuenta esta violación del protocolo.";
    text[2621] = "... pero te prohibimos que vuelvas a entrar en la Zona Fantasma.";
    text[2622] = "... Gracias, general.";
    text[2604] = "(Maldita sea...)";
    text[2623] = "(Estoy sin opciones...)";
    text[2624] = "Bella, hemos realizado algunos cálculos para determinar cuánto combustible necesitaríamos, mueh...";
    text[2628] = "La cantidad de antinúcleos necesarios supera la frecuencia con la que aparecen lóbregos en Luna...";
    text[2629] = "Eso quiere decir que, aunque obtuviéramos todos los antinúcleos que pudiéramos,";
    text[2630] = "seguiríamos sin tener la energía necesaria para activar Celestia...";
    text[2631] = "No...";
    text[2632] = "¿Entonces qué hacemos ahora?";
    text[2633] = "¡Siempre hay esperanza!";
    text[2634] = "Un buen líder siempre tiene a punto varios planes, en el caso de que alguno falle.";
    text[2635] = "Tenemos una tercera opción.";
    text[2636] = "¿¡En serio?!";
    text[2637] = "¡Mueh!";
    text[2638] = "Podríamos solucionar el problema sin tener que matar a todos los lóbregos que encontremos.";
    text[2639] = "Se trata de una misión relativamente nueva que Vivia y yo hemos planeado cuidadosamente.";
    text[2640] = "Sus progresos en holotecnología podrían ser la clave del éxito.";
    text[2641] = "El objetivo de nuestra misión lleva demasiado tiempo siendo una piedra en nuestro zapato.";
    text[2642] = "Para conseguir los antinúcleos que necesitamos, tenemos que capturar...";
    text[2643] = "al Matalóbregos.";
    text[2676] = "Una hora más tarde...";
    text[2644] = "Ahora todos estáis al tanto del plan...";
    text[2645] = "¿está todo el mundo de acuerdo?";
    text[2646] = "¡Sí, general!";
    text[2677] = "¡Esto podría funcionar, mueh, je, je!";
    text[2678] = "Tiene que funcionar. Llegados a este punto, es nuestra mejor alternativa.";
    text[2679] = "Así es, es necesario capturar al Matalóbregos...";
    text[2647] = "Bella, el éxito de esta operación depende de tu fuerza y tu determinación.";
    text[2648] = "¡Haré todo lo que pueda, Saros!";
    text[2649] = "Gracias... por darme esperanzas.";
    text[2650] = "Si todo va bien, no tendremos que matar más lóbregos.";
    text[2651] = "Ahora podéis retiraros. Descansad y recuperaros.";
    text[2652] = "Vivia y yo haremos los últimos preparativos. Después de eso...";
    text[2653] = "Esperamos la oportunidad adecuada.";
    text[2654] = "Control de Misiones, ¿qué ocurre?";
    text[2655] = "RADIO: ¡General, unos lóbregos están atacando Copernicus!";
    text[2656] = "¿Cuántos lóbregos?";
    text[2657] = "RADIO: Hay cientos de ellos...";
    text[2681] = "Nunca habían aparecido tantos lóbregos a la vez... Esto no puede ser cierto...";
    text[2680] = "Control de Misiones, proclamen una situación de emergencia en el sector 7.";
    text[2658] = "¡Envíen a nuestros mejores escuadrones para evacuar a los civiles de inmediato!";
    text[2660] = "¡También necesito que desplieguen a los receptáculos guerreros para que presenten batalla!";
    text[2659] = "RADIO: ¡Sí, general!";
    text[2661] = "Saros, ¡parece que esta es nuestra oportunidad!";
    text[2662] = "Si hay lóbregos, el Matalóbregos estará allí.";
    text[2671] = "No. Todavía no estamos listos. Necesito más tiempo.";
    text[2672] = "Si no llevamos a cabo la operación según el plan establecido, la misión podría fracasar.";
    text[2673] = "Si el Matalóbregos aparece, os conseguiré el tiempo que necesitéis.";
    text[2663] = "Tal vez pueda hablar con él. ¡Dejad que lo intente!";
    text[2664] = "¡Si no aparece, realizaremos la operación la próxima vez!";
    text[2665] = "¡Al menos, dejadme ir allí para proteger a la gente del peligro!";
    text[2674] = "...";
    text[2666] = "Muy bien. Buena suerte en la misión, Bella.";
    text[2667] = "Bella, ten cuidado, por favor.";
    text[2668] = "Lo tendré, papá. ¡Podéis contar conmigo!";
    text[2669] = "MISIÓN DE EMERGENCIA: ATAQUE DE LOS LÓBREGOS.";
    text[2670] = "Dirígete a Copernicus, en el sector 7, ¡y ayuda a detener el ataque de los lóbregos!";
    text[2683] = "¡Hay lóbregos por todas partes!";
    text[2684] = "¡No bromeaban cuando dijeron que los lóbregos nos atacaban!";
    text[2685] = "Bella, ¡¿qué podemos hacer?! ¡Aquí cunde el caos!";
    text[2686] = "¡Primero deberíamos asegurarnos de que todos los civiles hayan sido evacuados!";
    text[2687] = "¡Un momento!";
    text[2688] = "¡Mueh! Bella, ¡la situación es peor de lo que esperábamos!";
    text[2689] = "Reeves, ¡acabo de llegar a Copernicus! ¿Qué ocurre?";
    text[2692] = "¡Necesito que tú y Tetra os centréis en la red de depuración de agua!";
    text[2690] = "No te preocupes por los civiles, ¡hemos asignado esa tarea a otras tropas!";
    text[2693] = "¿Qué le ha ocurrido a la red de depuración de agua?";
    text[2694] = "¡Mueh! ¡El agua se ha vuelto MORADA!";
    text[2695] = "¡¿QUÉ?! ¡¿CÓMO?!";
    text[2696] = "¿Cómo vamos a arreglar eso? ¡Tenemos que evitar que los lóbregos lo destrocen todo!";
    text[2697] = "¡Deja que los soldados hagan su trabajo! ¡El tuyo es evitar que los soldados mueran!";
    text[2698] = "El color morado del agua indica altas concentraciones de permanganato de potasio,";
    text[2699] = "que se usa como desinfectante para ayudar a eliminar bacterias y gérmenes nocivos.";
    text[2700] = "¡Sin embargo, si se usa demasiado, el agua se vuelve mortal, y los químicos pueden";
    text[2701] = "volverse tóxicos y causar daño a todo aquel que los respire!";
    text[2702] = "La ciudad de Copernicus está construida sobre una reserva de agua esencial, mueh.";
    text[2703] = "Tenemos que protegerla a toda costa, ¡esa agua es necesaria para nuestra supervivencia!";
    text[2704] = "Debe haber 4 máquinas de filtrado repartidas por toda la ciudad.";
    text[2705] = "¡Debes encontrar las 4 y hacer que Tetra entre en ellas para restaurar la red!";
    text[2706] = "¡Recibido!";
    text[2710] = "¡AYUDA! ¡QUE ALGUIEN NOS AYUDE, POR FAVOR!";
    text[2711] = "¡Esta es vuestra oportunidad para huir! ¡Yo me encargaré del resto!";
    text[2712] = "¡Id hasta un lugar seguro AHORA!";
    text[2713] = "¡Sí, señorita! ¡Mu-muchas gracias! ¡Por favor, tenga cuidado!";
    text[2714] = "Uuuf... Me alegro de que esa familia haya podido ir a un lugar seguro... Ha faltado muy poco.";
    text[2715] = "¡Bella, no te duermas! ¡Estoy detectando una señal muy extraña...!";
    text[2716] = "¡Matalóbregos! Agh, ¡¿a qué ha venido ese puñetazo a traición?!";
    text[2717] = "Eso ha dolido un montón, ¿sabes? Auch...";
    text[2718] = "Tú otra vez...";
    text[2719] = "Me sorprende que sigas en pie después de recibir un golpe de mi Puño de Fase.";
    text[2720] = "Estoy dispuesto a admitir que eres más fuerte de lo que pareces.";
    text[2721] = "Agh... Buf... Buf...";
    text[2722] = "Tengo que... hablar contigo.";
    text[2723] = "¿Cómo? Somos enemigos. No tenemos nada de qué hablar.";
    text[2724] = "Que esto os sirva de advertencia a ti y a la Fuerza Lunex.";
    text[2725] = "No os crucéis en mi camino si no queréis que os hagan daño.";
    text[2726] = "Los antinúcleos nunca deben caer en manos de la Fuerza Lunex.";
    text[2727] = "Recórcholis... Ha escapado.";
    text[2728] = "Bella, ¿estás bien?";
    text[2729] = "Sí, me voy recuperando poco a poco. Necesito descansar un poco.";
    text[2730] = "Puede que ahora mismo no podamos verle, pero creo que tardará bastante en abandonar este lugar.";
    text[2731] = "Ha venido a por los antinúcleos. Todavía podemos hablar con él.";
    text[2732] = "Tetra, ¡intenta encontrarle mientras tratamos de arreglar la red de depuración de agua!";
    text[2733] = "¡Recibido!";
    text[2734] = "¡E-espera!";
    text[2735] = "¿Qué ocurre?";
    text[2736] = "¡M-m-más lóbregos!";
    text[2737] = "Diablos... Parece que no dejan de llegar.";
    text[2738] = "Si esto sigue así no, no podremos restaurar la red de depuración a tiempo...";
    text[2739] = "Y es probable que el Matalóbregos también escape...";
    text[2740] = "¡Parece que la guerrera prodigio necesita ayuda!";
    text[2741] = "¡¿?!.";
    text[2742] = "¡PUÑO BALA! ¡HA!";
    text[2743] = "¿¡Raine!?";
    text[2744] = "¿Qué estás haciendo aquí? ¡Pensaba que te habían asignado otra misión!";
    text[2745] = "Control de Misiones nos envió una señal de socorro. ¡Este ataque se les está yendo de las manos!";
    text[2754] = "Además, ¿qué tal un «Muchas gracias» por salvar tu trasero de prodigio? ¡Ja, ja, ja!";
    text[2746] = "¡Déjalo para más tarde! ¡Nos atacan!";
    text[2747] = "Y por última vez, ¡deja de llamarme «guerrera prodigio»!";
    text[2748] = "¡Vale, vale! Mmm... ¡Tal vez si luego practicas un poco conmigo!";
    text[2749] = "Todavía me debes la revancha, ¿sabes?";
    text[2750] = "¡Lo sé, lo sé!";
    text[2751] = "¿¡Qué tal si nos encargamos de los lóbregos que van a atacarnos antes de hablar de eso!?";
    text[2752] = "¡Tranquila, no he venido sola!";
    text[2753] = "¡Vamos, chicas! ¡Demostrémosles a esos lóbregos el poder del Escuadrón Raine!";
    text[2755] = "¡LEVOPIEDRA TALADRO!";
    text[2756] = "¡JAULA DE PLASMA!";
    text[2757] = "¡Son Melody y Zara!";
    text[2758] = "¡Hola, Tetra! ¡Sigues siendo una auténtica monada, como siempre!";
    text[2759] = "¡Je, je, je, je! ¡Tú también, Melody!";
    text[2760] = "¡Es estupendo verte, Bella!";
    text[2761] = "¡¿Cómo es posible que sigas así de mona después de haber recibido una paliza?!";
    text[2762] = "Eeeh..., ¿gracias?";
    text[2763] = "Eh, Zara, ¿ese era un nuevo ataque combinado?";
    text[2764] = "Sí.";
    text[2765] = "Necesitamos una manera efectiva y elegante de mantener a raya a estos lóbregos enloquecidos.";
    text[2766] = "Nos han ordenado que restrinjamos al mínimo las bajas entre los lóbregos.";
    text[2767] = "Parece que alguien necesita controlar un poco mejor sus Puños Bala.";
    text[2768] = "¡JAMÁS!";
    text[2769] = "¡Cuando luchas, tienes que ir A POR TODAS!";
    text[2770] = "... ¡Hasta durante las sesiones de entrenamiento! Si esta no fuera una misión de emergencia...";
    text[2771] = "¡Te estaría MACHACANDO ahora mismo! ¡MUAH, JA, JA, JA!";
    text[2772] = "Tranquilízate, Raine. Debemos usar nuestra energía para centrarnos en la misión.";
    text[2773] = "Tch. Sí, supongo que tienes razón.";
    text[2774] = "Bella, tenemos un informe de misión de Reeves.";
    text[2775] = "¡Tú y Tetra debes restaurar la red de depuración de agua DE INMEDIATO!";
    text[2776] = "¡Nosotras os cubrimos las espaldas!";
    text[2777] = "¡Descargaremos nuestra furia sobre los lóbregos que dañen a la gente de Luna!";
    text[2778] = "Raine, nada de matar lóbregos.";
    text[2779] = "Vale, descargaremos nuestra furia CON CUIDADO sobre los lóbregos que dañen a la gente de Luna...";
    text[2780] = "¡PERO NO ME CONVENCE!";
    text[2781] = "Con eso bastará. Tratemos de cumplir esta misión de una manera elegante.";
    text[2782] = "Por cierto, Saros nos ha hablado de la operación secreta.";
    text[2783] = "¡Si encontramos al Matalóbregos, seremos nosotras las que lo CAPTURARÁN!";
    text[2784] = "¡El Escuadrón Raine se hará con la victoria! ¡Tenemos el ascenso garantizado, MUAH, JA, JA, JA!";
    text[2785] = "¡No si yo lo capturo primero! Je.";
    text[2786] = "Un consejo de amiga: cuidado con su Puño de Fase.";
    text[2787] = "¡¿PUÑO DE FASE?! ¡¿QUÉ?!";
    text[2788] = "(¿Así que Bella ya se ha enfrentado a él? Mmmm...)";
    text[2789] = "(Vaya, Puño de Fase es un nombre que mola mucho...)";
    text[2790] = "¡NO, NO, NO! ¡Solo puede haber un experto en ataques cuerpo a cuerpo! ¡Ese tío tiene los días contados!";
    text[2791] = "¡Nos vemos, Bella! ¡Si necesitas ayuda, estaremos cerca!";
    text[2792] = "¡Buena suerte!";
    text[2793] = "Mira, Bella, ¡allí hay una máquina de filtrado!";
    text[2794] = "¡Muy bien, vamos allá! ¡No hay tiempo que perder!";
    text[2707] = "Muy bien, Tetra, ¡espero que puedas ayudarme a restaurar la red de depuración!";
    text[2708] = "¡La ayudante entra en acción! Je, je, ¡vamos allá!";
    text[2555] = "Bella, ¡tenemos que restaurar la red de depuración!";
    text[2556] = "¡Debemos entrar en 4 máquinas de filtrado";
    text[2557] = "para poder atravesar el cortafuegos de seguridad! ¡Ya puedes enviarme!";
    text[2558] = "¿Quieres que Tetra entre en la red de depuración?";
    text[2808] = "Veo que no se te da muy bien escuchar.";
    text[2809] = "¡¿Cómo?! ¡A ti tampoco se te da muy bien!";
    text[2810] = "Escucha, ya te he avisado...";
    text[2811] = "¡ESPERA!";
    text[2812] = "¡DETENTE, POR FAVOR!";
    text[2813] = "¿PARA QUÉ? ¿Para distraerme mientras llegan refuerzos?";
    text[2814] = "... ¿Para que podáis capturar por fin al infame Matalóbregos?";
    text[2815] = "Qué patético.";
    text[2816] = "No...";
    text[2817] = "No quiero capturarte. Solo quiero hablar contigo.";
    text[2818] = "Mientes. Tú y tus superiores solo sabéis mentir.";
    text[2819] = "¡Estoy diciendo la verdad!";
    text[2820] = "Y sé... ";
    text[2821] = "... Sé más de lo que tú crees...";
    text[2822] = "¿...?";
    text[2823] = "Sepas lo que sepas, desconoces toda la verdad.";
    text[2824] = "Se hará justicia.";
    text[2825] = "¡ESPERA!";
    text[2826] = "Agh, ¡no piensas cerrar el pico, ¿verdad?!";
    text[2827] = "¡Por favor, no utilices tus poderes ahora mismo! ¡Al menos, no aquí!";
    text[2828] = "Esta máquina que tienes detrás forma parte del sistema de filtrado de agua de la ciudad.";
    text[2829] = "Si llega a sufrir daño, estamos condenados...";
    text[2830] = "Las emanaciones tóxicas del agua acabarían matando a todos los que estamos aquí.";
    text[2831] = "Y el agua podría llegar a los demás sectores.";
    text[2832] = "...";
    text[2833] = "Por favor, no pongas en peligro a toda la gente de Luna.";
    text[2834] = "Te lo ruego...";
    text[2835] = "(¿Está mintiendo...? ¿Y si esto no es más que una trampa...?)";
    text[2836] = "(¿Puedo confiar en lo que dice...?)";
    text[2837] = "(Pero...)";
    text[2838] = "(Si dice la verdad...)";
    text[2839] = "Te lo ruego...";
    text[2840] = "...";
    text[2841] = "Has dicho que querías hablar.";
    text[2842] = "Soluciona el problema del agua tóxica, y luego reúnete conmigo en la azotea del edificio de depuración.";
    text[2843] = "Ven sola. Me marcharé si veo el más leve indicio de truco o engaño.";
    text[2844] = "Gracias.";
    text[2845] = "Vaya, es una pasada, pero también da mucho miedo...";
    text[2846] = "¡Este no es momento para hacer bromas, Tetra!";
    text[2847] = "¿Y esto? Estamos recibiendo una transmisión del general Saros.";
    text[2848] = "Bella, ¿cómo va todo por ahí?";
    text[2849] = "Estamos tratando de reiniciar la red de depuración cuanto antes.";
    text[2850] = "Muy bien, no quiero quitaros mucho tiempo, así que iré al grano.";
    text[2851] = "Los preparativos están listos.";
    text[2852] = "¿Encontraste al Matalóbregos?";
    text[2853] = "Eeeh...";
    text[2854] = "Sí, pero...";
    text[2855] = "Escapó.";
    text[2856] = "Mentir no se te da muy bien...";
    text[2857] = "Sin embargo, eres excelente a la hora de ganarte la confianza de los demás.";
    text[2858] = "¿Dónde quería reunirse contigo?";
    text[2859] = "... En la azotea del edificio de depuración.";
    text[2860] = "Me dio la oportunidad de hablar con él... pero quiere que vaya sola.";
    text[2861] = "Parece que no confía nada en la Fuerza Lunex, como dijisteis.";
    text[2862] = "Es comprensible. Tenemos una relación complicada. ";
    text[2863] = "Sin embargo, es un hombre peligroso con información valiosa.";
    text[2868] = "DEBE ser capturado.";
    text[2864] = "No vayas hasta la azotea hasta que lleguemos.";
    text[2865] = "...";
    text[2866] = "Sí, general.";
    text[2867] = "...";
    text[2869] = "¡Lo conseguimos! ¡Bien hecho, Tetra!";
    text[2870] = "¡Je, je! ¡La superayudante Tetra al rescate!";
    text[2976] = "Parece que los lóbregos también han desaparecido.";
    text[2977] = "O bien han huido, o el Matalóbregos los ha cazado a todos...";
    text[2871] = "Ahora deberíamos poder usar las plataformas de impulso. ";
    text[2872] = "¡Reunámonos con el Matalóbregos en la azotea de la depuradora!";
    text[2873] = "¡Muy bien! ¡El edificio se encuentra en la parte noroeste de la ciudad! ¡Vamos, pongámonos en marcha!";
    text[2875] = "El Matalóbregos no confía en la autoridad...";
    text[2876] = "Sus motivos siguen siendo un misterio...";
    text[2877] = "No lo entiendo...";
    text[2878] = "Sus dotes...";
    text[2879] = "Sus poderes...";
    text[2880] = "... pueden ayudarnos a salvar a la gente de Luna.";
    text[2881] = "Solo sabemos lo que sabemos desde nuestra perspectiva.";
    text[2882] = "Si puedo ganarme su confianza...";
    text[2883] = "Tal vez podamos llegar a un acuerdo.";
    text[2884] = "Necesitamos conocer su versión de la historia para conocer toda la verdad...";
    text[2885] = "...";
    text[2886] = "¡¿Qu-qué?! ¿El Matalóbregos fue el que nos ayudó a descubrir la antimateria?";
    text[2887] = "No fue de manera intencionada, pero sí.";
    text[2888] = "Sirvió de catalizador para nuestras investigaciones sobre la antimateria.";
    text[2889] = "Hace muchos años, un paciente vino al centro médico de emergencia.";
    text[2890] = "Era un chico joven, que estuvo a punto de morir debido a una enfermedad desconocida.";
    text[2891] = "Su cuerpo emitía una cantidad insoportable de una extraña energía.";
    text[2892] = "Después de innumerables pruebas, conseguimos extraer";
    text[2893] = "milagrosamente la energía que rebosaba del cuerpo del chico y, gracias a ello, le salvamos la vida.";
    text[2894] = "Tras varios días, las constantes vitales del chico volvieron a la normalidad y se curó.";
    text[2895] = "Sin embargo, la presión que sufrió el cuerpo del chico lo puso en un estado comatoso.";
    text[2896] = "Pero esa extraña energía... Supongo que era...";
    text[2897] = "Antimateria.";
    text[2898] = "La energía que rebosaba del cuerpo del chico era antimateria pura y estable.";
    text[2899] = "Gracias a él, aprendimos mucho sobre la antimateria y sus propiedades.";
    text[2900] = "Nuestra investigación nos llevó a la creación de la tecnología de agujero de gusano,";
    text[2901] = "al descubrimiento de la Zona Fantasma,";
    text[2902] = "y a la invención de los receptáculos y las armas que nos ayudan a luchar contra los lóbregos hoy en día.";
    text[2903] = "Un día, tras meses en coma, el chico despertó al fin.";
    text[2904] = "Sufría intensos dolores, y emitía una cantidad de antimateria astronómica.";
    text[2905] = "Tratamos de tranquilizarte y ayudarle, pero no podíamos acercarnos.";
    text[2906] = "Escapó de nuestras instalaciones y, desde entonces, cualquier intento de capturarle ha sido en vano.";
    text[2907] = "Así que este chico era el Matalóbregos...";
    text[2908] = "Correcto.";
    text[2909] = "Sus poderes... Me pregunto si era algo con lo que nació.";
    text[2910] = "¡Es tan terrorífico como fascinante, mueh!";
    text[2911] = "... Un humano capaz de manipular la antimateria.";
    text[2912] = "¿Qué más sabemos de él?";
    text[2913] = "No sabemos prácticamente nada. Nunca tuvimos la oportunidad de hablar.";
    text[2914] = "No llevaba ningún documento con él... Ni ninguna identificación...";
    text[2915] = "Ni siquiera sabemos su nombre ni de dónde procedía.";
    text[2916] = "Tiene información que desconocemos... y un poder que no comprendemos del todo.";
    text[2917] = "También creemos que existe algún tiempo de relación entre el Matalóbregos y los lóbregos.";
    text[2918] = "¡¿...?!";
    text[2919] = "Los lóbregos comenzaron a aparecer pocos meses después de que el chico escapara.";
    text[2920] = "Es posible que los estallidos de antimateria que emitió trajeran a los lóbregos a nuestro mundo.";
    text[2921] = "¿Hay alguna prueba de ello?";
    text[2922] = "No. Sigue siendo solo una teoría.";
    text[2923] = "Los lóbregos son seres que reaccionan violentamente a otras fuentes de antimateria.";
    text[2924] = "Teniendo en cuenta cuándo se desarrollaron los eventos, es posible que haya alguna conexión.";
    text[2925] = "Estáis tratando al Matalóbregos como si fuera una especie de monstruo.";
    text[2926] = "Bueno, es evidente que posee un poder monstruoso. También es un criminal.";
    text[2927] = "¡Es solo una víctima de unos poderes que no puede controlar!";
    text[2928] = "Los estallidos de materia que generó destruyeron propiedad del ejército e hirieron a gente inocente.";
    text[2929] = "Es responsable de un incidente tras otro...";
    text[2930] = "Quién sabe cuándo emitirá un nuevo estallido.";
    text[2931] = "Es un hombre muy peligroso.";
    text[2932] = "... Pero eso no implica que sea una mala persona.";
    text[2933] = "Sea cual sea el motivo que le lleva a cazar lóbregos, ";
    text[2934] = "al hacerlo está salvando a personas indirectamente.";
    text[2935] = "¿Habéis considerado siquiera que no quiera vivir toda su vida en cautividad?";
    text[2936] = "¿Y si solo estuviera asustado?";
    text[2937] = "No es una rata de laboratorio que haya que estudiar... Es un ser humano, como todos nosotros.";
    text[2938] = "Lo entendemos, pero no podemos ignorar el daño que ha causado ni las personas";
    text[2939] = "a las que ha herido,... ya fuera de manera intencionada o no.";
    text[2940] = "Es un posible enemigo de la humanidad.";
    text[2941] = "Primero defiendes a los lóbregos... y ahora te pones del lado del Matalóbregos...";
    text[2942] = "Parece que no sabes muy bien de qué bando estás, Bella.";
    text[2943] = "S-Saros, no hagamos suposiciones descabelladas.";
    text[2944] = "Bella solo se comporta como...";
    text[2945] = "Bella.";
    text[2946] = "Solo deseo hacer lo que creo que es correcto.";
    text[2947] = "(Aaay).";
    text[2948] = "Te pido disculpas.";
    text[2975] = "El Matalóbregos ha sido un obstáculo en mi camino por muchos motivos... ";
    text[2949] = "... pero volvamos a nuestro objetivo principal y a por qué hablé de él en primer lugar.";
    text[2950] = "En este momento nuestra prioridad es hacer frente al cometa Coda.";
    text[2951] = "Como Reeves dijo antes,";
    text[2952] = "La cantidad de antinúcleos necesarios supera la frecuencia con la que aparecen lóbregos en Luna...";
    text[2953] = "Eso quiere decir que, aunque obtuviéramos todos los antinúcleos que pudiéramos,";
    text[2954] = "seguiríamos sin tener la energía necesaria para activar Celestia...";
    text[2955] = "por eso... necesitamos los antinúcleos que el Matalóbregos ha conseguido.";
    text[2956] = "Es posible que el Matalóbregos tenga ocultos miles de antinúcleos.";
    text[2957] = "Si pudiéramos usarlos como combustible para activar Celestia,";
    text[2958] = "no tendríamos que matar más lóbregos y podríamos detener el cometa Coda.";
    text[2959] = "...";
    text[2960] = "Estoy dispuesta a llevar a cabo esta misión con una condición.";
    text[2961] = "Debéis dejar que sea yo quien hable con él.";
    text[2962] = "Trataré de conseguir la información que necesitamos.";
    text[2963] = "Si se entera de la amenaza que supone el cometa Coda, es posible que quiera colaborar con nosotros.";
    text[2964] = "...";
    text[2965] = "No confía en nosotros. ¿Crees que podrás hacerle cambiar de opinión?";
    text[2966] = "... Haré lo que pueda.";
    text[2967] = "... Muy bien.";
    text[2968] = "Sin embargo, si trata de escapar,";
    text[2969] = "nos veremos obligados a usar la holotecnología de Vivia para capturarle.";
    text[2972] = "Recuerda, es la única alternativa que evitará que tengamos que matar más lóbregos.";
    text[2973] = "¿Entiendes cuál es tu misión y la aceptas, Bella?";
    text[2974] = "¡La acepto!";
    text[3000] = "Hubo un momento en el que creía que la Fuerza Lunex podía proteger a la humanidad.";
    text[3001] = "Hasta soñaba con unirme a la Fuerza Lunex algún día... para convertirme en guerrero.";
    text[3002] = "Si hubiera sido más fuerte entonces...";
    text[3003] = "Si pudiera controlar mis poderes...";
    text[3004] = "... la situación no se habría descontrolado tanto.";
    text[3005] = "Nunca pedí tener estos poderes...";
    text[3006] = "No han causado más que dolor y sufrimiento.";
    text[3007] = "He tardado años en controlar una parte de los mismos.";
    text[3008] = "He hecho daño a mucha gente...";
    text[3009] = "... y no puedo perdonarme por las cosas que he hecho.";
    text[3010] = "Lo mínimo que puedo hacer es tratar de encontrar una manera...";
    text[3011] = "¿Encontrar una manera de qué?";
    text[3012] = "De hacer justicia.";
    text[3013] = "...";
    text[3014] = "Sea como fuere, no tengo todo el día. ¿De qué querías hablar?";
    text[3015] = "Bueno, deja que empiece preguntándote esto...";
    text[3016] = "¿Por qué estás reuniendo antinúcleos?";
    text[3017] = "Agh, otra vez eso.";
    text[3018] = "¿Es que la Fuerza Lunex no tiene sus propias reservas de antinúcleos?";
    text[3019] = "¿Por qué se molesta en recurrir a mí?";
    text[3020] = "No tengo ningún interés en ayudaros.";
    text[3021] = "Id a cazar vuestros propios lóbregos.";
    text[3022] = "No son suficientes...";
    text[3023] = "Necesitamos más antinúcleos como combustible...";
    text[3024] = "... pero no por los motivos que piensas.";
    text[3025] = "Matalóbregos..., ¡necesitamos tu ayuda desesperadamente!";
    text[3026] = "¡El cometa Coda ha regresado!";
    text[3027] = "¿Me estás diciendo que un cometa hecho de antimateria se dirige hacia nosotros, y tenemos";
    text[3028] = "un año para reunir los antinúcleos necesarios para activar una máquina de agujeros negros incompleta?";
    text[3029] = "¿Esperas que me crea algo así?";
    text[3030] = "¡Te estoy diciendo la verdad! No tengo ningún motivo para mentir...";
    text[3031] = "... Un cometa de antimateria...";
    text[3032] = "Eso podría explicar las extrañas ráfagas de antimateria que he estado presintiendo últimamente...";
    text[3033] = "Si lo que dices es cierto, esas ráfagas podrían haber causado el ataque de los lóbregos.";
    text[3034] = "Si no conseguimos el combustible necesario para accionar Celestia, la humanidad está condenada...";
    text[3035] = "... Aunque así sea, no puedo daros los antinúcleos que tengo.";
    text[3036] = "Tendréis que encontrar otra manera de detener al cometa Coda.";
    text[3037] = "¡No nos queda ninguna otra opción! ¡Eres mi última esperanza, literalmente!";
    text[3038] = "No puedo...";
    text[3039] = "¡¿Lo dices en serio?! ¿Estás anteponiendo tus propios intereses personales a la vida de los demás?";
    text[3040] = "¡Te estoy pidiendo ayuda porque era la única que no quería matar más lóbregos!";
    text[3041] = "...";
    text[3042] = "Por favor... Tengo que saber la verdad.";
    text[3043] = "Quiero proteger a la humanidad y a los lóbregos.";
    text[3044] = "¡Creo que podemos conseguir esto y mucho más si trabajamos juntos!";
    text[3045] = "... ... ... ... ";
    text[3046] = "La última vez que nos encontramos, me preguntaste si podía sentir el dolor de los lóbregos...";
    text[3047] = "De hecho, sí que puedo... pero no sé cómo.";
    text[3048] = "Solo... Lo siento en mi alma.";
    text[3049] = "Hace poco conocí a un lóbrego... que habló conmigo.";
    text[3050] = "... ¿Qué te dijo?";
    text[3051] = "Proteger.";
    text[3052] = "Esto es... interesante.";
    text[3053] = "Es la primera vez que me hablan de un lóbrego que trata de comunicarse con un humano...";
    text[3054] = "(El lóbrego que le habló...)";
    text[3055] = "(¿Es posible que fuera...?)";
    text[3056] = "Dime...";
    text[3057] = "¿Cómo te llamas?";
    text[3058] = "Me llamo Bella Grey.";
    text[3059] = "Grey...";
    text[3060] = "¡¿Entonces eres la hija de Thea?!";
    text[3061] = "(Si es así, tal vez pueda fiarme de ella...)";
    text[3062] = "(...)";
    text[3063] = "Un momento, ¿conociste a mi madre?";
    text[3064] = "... Sí.";
    text[3065] = "Era una auténtica líder, no como el que tenéis ahora.";
    text[3066] = "¿Cómo? ¡Saros es un gran líder! ¿Qué tienes en su contra?";
    text[3075] = "¡Bella, tenemos a este pillastre rodeado!";
    text[3067] = "Tú... ¡Te dije que vinieras sola!";
    text[3068] = "¡Esto ha sido una trampa desde el principio!";
    text[3069] = "¡No! ¡No les dije nada!";
    text[3070] = "¡Raine! ¡Melody! ¡Zara!";
    text[3071] = "¡Bajad vuestras armas!";
    text[3072] = "¡Estoy tratando de hablar con él!";
    text[3073] = "No puedo hacerlo, Bella. Saros nos dijo que tratarías de venir aquí.";
    text[3074] = "Lo siento... Solo estamos siguiendo órdenes.";
    text[3076] = "Bella, ¡esta es nuestra mejor oportunidad de capturar por fin al Matalóbregos!";
    text[3077] = "Tch. Tengo que salir de aquí.";
    text[3078] = "¡No puedo dejar que te vayas! ¡Necesitamos tu ayuda!";
    text[3079] = "Estoy harto de hablar. ¡Ahora todas morderéis el polvo!";
    text[6004] = "¡Aaaargh!";
    text[7566] = "¿Estás bien? ¿Qué está pasando?";
    text[6005] = "NO...";
    text[6006] = "NO TE ACERQUES...";
    text[6007] = "NO PERMITIRÉ... QUE VUELVA A CONSUMIRME...";
    text[6008] = "Epa... ";
    text[6009] = "¡¿Qué ha sido eso?!";
    text[3080] = "Buff... Buff...";
    text[6010] = "Esa forma... ";
    text[6011] = "Es en lo que me convierto cuando mi antimateria me consume...";
    text[3081] = "Por favor no... No me presionéis más...";
    text[3082] = "Si vuelvo a perder el control...";
    text[3083] = "No quiero seguir luchando contigo. No eres mi enemigo.";
    text[3084] = "¡Colabora con nosotros, por favor!";
    text[3085] = "¡Activando holocampo!";
    text[3086] = "Parece que hemos llegado justo a tiempo.";
    text[3087] = "...";
    text[3088] = "Volvemos a encontrarnos, Matalóbregos.";
    text[3089] = "Te sugiero que no te muevas si valoras en algo tu vida.";
    text[3090] = "Este holocampo ha sido diseñado para absorber la energía cinética.";
    text[3091] = "Si esta llega a un cierto umbral, podemos usar la energía almacenada";
    text[3092] = "para hacer que el holocampo implosione sobre sí mismo...";
    text[3098] = "... tus propios poderes acabarían contigo.";
    text[3093] = "Es un farol.";
    text[3094] = "¡Vuestra holotecnología no logró detenerme en el pasado!";
    text[3095] = "Ja, ja, ja... Hemos realizado algunas mejoras importantes desde que luchamos por última vez.";
    text[3096] = "Vamos, adelante.";
    text[3097] = "Arriesga todo por lo que has estado luchando.";
    text[3099] = "... Tch.";
    text[3100] = "Lo has hecho muy bien, Bella. Sabía que podíamos contar contigo.";
    text[3101] = "... Gracias...";
    text[3102] = "Llevadlo al Complejo Penitenciario.";
    text[3103] = "Tenemos mucho de lo que hablar, Matalóbregos.";
    text[3104] = "...";
    text[3105] = "Tu imprudencia...";
    text[3106] = "... las personas a las que has hecho daño...";
    text[3107] = "... la destrucción del sector 3...";
    text[3108] = "... y los antinúcleos que has reunido...";
    text[3109] = "Pagarás por todos tus crímenes.";
    text[3110] = "Vas a decirnos dónde ocultas tus antinúcleos.";
    text[3111] = "¿Es que no quieres salvar a la humanidad?";
    text[3112] = "¿Salvar a la humanidad?";
    text[3113] = "¿De qué? ¿De los lóbregos?";
    text[3114] = "¿De VOSOTROS?";
    text[3115] = "¿De qué sandeces sin sentido estás hablando?";
    text[3116] = "Yo protejo a la humanidad. La razón de ser de la Fuerza Lunex es servir a la gente.";
    text[3117] = "Eres tú quien es un peligro para todos nosotros.";
    text[3118] = "Salvaré a la humanidad a mi manera. Me niego a ayudaros.";
    text[3119] = "Buff... Buff...";
    text[3120] = "Perece que estás agotado. Tendremos que hablar más tarde.";
    text[3121] = "Los demás podéis tomaros un merecido descanso. ";
    text[3124] = "Hoy es un día para recordar.";
    text[3122] = "No solo hemos capturado al Matalóbregos.";
    text[3123] = "¡También hemos detenido el mayor ataque lóbrego hasta la fecha!";
    text[3125] = "¡SÍ, GENERAL!";
    text[3126] = "¡Hola, Zara!";
    text[3127] = "... Hola.";
    text[3128] = "¿Tienes algo en mente?";
    text[3129] = "Estoy buscando un nombre para un nuevo combo.";
    text[3130] = "¿Qué te parece Puño Lanzarrocas?";
    text[3131] = "Es elegante.";
    text[3132] = "Pché...";
    text[3133] = "Perfecto.";
    text[3134] = "Tengo que asegurarme de que todos nuestros ataques tengan nombres impactantes.";
    text[3135] = "Raine y Melody suelen dejarme inventar los nombres de nuestros ataques.";
    text[3136] = "Mmmm, tendré que volver al principio. Gracias.";
    text[3137] = "Melody, ¿necesitas ayuda?";
    text[3138] = "No, no hace falta. No te preocupes, Bella. ";
    text[3139] = "Podemos encargarnos de los lóbregos, ¡tú céntrate en la red de depuración!";
    text[3140] = "Qué tal, guerrera prodigio. Estoy buscando al Matalóbregos.";
    text[3141] = "¡Deja de llamarme así!";
    text[3142] = "¡NUNCA! ¿Quieres practicar? ¡Me muero por darte una buena!";
    text[3143] = "Este NO es un buen momento, Raine.";
    text[3144] = "Vale, vale.";
    text[3145] = "Unas pocas horas más tarde...";
    text[3146] = "¡Estimados ciudadanos del sector 7!";
    text[3147] = "Nos hemos reunido aquí para honrar y dar las gracias a los valientes guerreros lunex";
    text[3148] = "que están a mis espaldas, por proteger este sector y a sus habitantes durante esta crisis.";
    text[3149] = "Pusieron sus vidas en peligro para que todos estuvieran a salvo.";
    text[3150] = "Me alegra deciros que no se produjo ninguna baja durante este ataque.";
    text[3151] = "¡Es una enorme victoria para la humanidad!";
    text[3152] = "¡SÍÍÍÍ! ¡YUPIII!";
    text[3153] = "Seguiremos realizando todo lo que sea necesario para conseguir más información sobre los lóbregos,";
    text[3154] = "... ¡y para descubrir cómo defendernos de esos monstruos!";
    text[3155] = "¡Siempre hay esperanza! ¡Brindo por un nuevo día, y por un brillante futuro para Luna!";
    text[3161] = "¡Que nuestra lux brille para siempre!";
    text[3162] = "¡SÍ! ¡El reconocimiento mola! ¡Hoy todos hemos hecho un trabajo estupendo!";
    text[3163] = "¡Sí! ¡Ha sido definitivamente la misión más difícil que hemos realizado hasta ahora!";
    text[3164] = "Estoy de acuerdo. Tú también lo hiciste muy bien, Tetra.";
    text[3165] = "Ahora soy Tetra, ayudante de la heroína del ataque lóbrego, je, je.";
    text[3166] = "Bella, ¿estás bien?";
    text[3167] = "Acabas de zamparte 5 barritas de tarta de queso.";
    text[3168] = "¿En qué estás pensando?";
    text[3169] = "...";
    text[3170] = "Es que... me faltaba tan poco para descubrir la verdad...";
    text[3171] = "Oye, perdona por lo de antes.";
    text[3172] = "Solo seguíamos órdenes...";
    text[3205] = "Bella, puedes verlo de esta manera:";
    text[3173] = "Al menos capturamos al Matalóbregos, ¿verdad?";
    text[3174] = "¡Ahora podemos interrogarle cuando queramos!";
    text[3175] = "¡...!";
    text[3176] = "Eso es cierto...";
    text[3177] = "¡Una de las ventajas de ser una heroína es que puedes comer gratis en el café! ¡MUAH, JA, JA, JA, JA!";
    text[3178] = "Vamos, disfruta del momento Bella. ¡Todos nos adoran!";
    text[3179] = "Gracias por animarme, chicas.";
    text[3180] = "¡Hemos completado la misión gracias al esfuerzo combinados de todas!";
    text[3181] = "¡Cinco barritas de tarta de queso más, por favor! Tenemos que celebrarlo.";
    text[3182] = "¡Di que sí, chica! ¡Así se habla!";
    text[3183] = "Mmm, este ramen está delicioso.";
    text[3184] = "La combinación de ingredientes que han utilizado ha dado lugar a un plato realmente elegante.";
    text[3185] = "A mí me gustaría otro batido de fresa. ¡Están tan buenos!";
    text[3186] = "¡Yo tomaré 6 barritas de tarta de queso! ¡MUAH, JA, JA, JA!";
    text[3187] = "¡Comeré MÁS y MÁS RÁPIDO que tú!";
    text[3188] = "¡Raine, esto no es una carrera!";
    text[3189] = "¡Si te gano, me deberás otra sesión de práctica! ¡Voy a machacarte!";
    text[3190] = "...";
    text[3191] = "Ya sea en las sesiones de práctica o comiendo comida... no pienso dejar que me venzas.";
    text[3192] = "¡ESO YA LO VEREMOS! (ÑAM, ÑAM, ÑAM, ÑAM, ÑAM)";
    text[3193] = "¡HE GANADO! ¡SÍ!";
    text[3194] = "Agh... Estoy tan llena...";
    text[3195] = "¡TOMA YA! ¡ME DEBES OTRA SESIÓN DE PRÁCTICA!";
    text[3196] = "¡Aquí y ahora!";
    text[3197] = "Raine, eres muy escandalosa... Los demás clientes nos están mirando.";
    text[3198] = "Vaya... Bueno, bueno. Lo dejaremos para la próxima.";
    text[3199] = "Creo que es hora de ir a casa.";
    text[3200] = "Nosotras nos quedaremos un poco más. He de terminar este delicioso ramen.";
    text[3201] = "¡Saluda al doctor Thomas de nuestra parte!";
    text[3202] = "¡Muy bien, cuidaos mucho!";
    text[3203] = "Volvamos a la Estación Espacial, Tetra. Tengo mucho sueño.";
    text[3204] = "¡Chupi dupi! ¡A volar!";
    text[6016] = "Saros...";
    text[6017] = "Sabes...";
    text[6018] = "No nos estás poniendo las cosas fáciles a ninguno de nosotros, Matalóbregos.";
    text[6019] = "Si te limitaras a cooperar...";
    text[6020] = "No tendría que encerrarte de esta manera.";
    text[6021] = "Eres escoria...";
    text[6022] = "Vaya, ¿así es como saludas a un viejo amigo?";
    text[6023] = "No somos amigos.";
    text[6024] = "Escucha cuidadosamente, Matalóbregos... Voy a resumirte la situación.";
    text[6025] = "El cometa Coda ha regresado... y va a destruirnos a todos.";
    text[6026] = "Para salvar a la humanidad debemos superar nuestras limitaciones.";
    text[6027] = "Debemos adaptarnos.";
    text[6028] = "Para hacerlo, necesitamos todos los antinúcleos que podamos encontrar.";
    text[6029] = "Ahora dime...";
    text[6030] = "¿Dónde están los antinúcleos que tienes escondidos?";
    text[6031] = "Si estuvieran en manos de la Fuerza Lunex,";
    text[6032] = "podríamos darles un buen uso.";
    text[6033] = "¿Es que no quieres salvar a la humanidad?";
    text[6034] = "Prefiero morir a daros un antinúcleo más.";
    text[6035] = "Me niego a ayudaros.";
    text[6036] = "En ese caso...";
    text[6037] = "Vivia. Inicia la extracción de antimateria...";
    text[6038] = "¡Aghhhhh! ¡AAAAAAAH!";
    text[6039] = "¡AAAAAAAGGGHH!";
    text[6040] = "Si no nos dices dónde los tienes escondidos...";
    text[6041] = "Tendremos que extraer hasta la última molécula de antimateria que haya en tu cuerpo.";
    text[6042] = "Bien, ahora... Muéstramela...";
    text[6043] = "Enséñame tu bestia interior. Tu FORMA DE FASE.";
    text[6044] = "¡NO! ¡AAAAAGH!";
    text[6045] = "NO... NO LO HARÉ...";
    text[6046] = "No nos dejas alternativa.";
    text[6047] = "La antimateria es la clave para salvar a la humanidad.";
    text[6048] = "Nos ayudarás..., lo quieras o no...";
    text[6049] = "... Matalóbregos.";
    text[7567] = "Oye, Bella...";
    text[7568] = "¿Sí, Tetra?";
    text[7569] = "Ese traje impulsor morado...";
    text[7570] = "Lleva expuesto en tu habitación durante mucho tiempo...";
    text[7571] = "Analicé el traje un poco antes...";
    text[7572] = "Es mucho más resistente que el que llevas ahora...";
    text[7573] = "¡Además, dispone de muchas más funciones!";
    text[7574] = "Me estaba preguntando...";
    text[7575] = "¿Hay algún motivo por el que no lo usas?";
    text[7576] = "Creo que sería una estupenda mejora respecto al traje impulsor que llevas ahora y";
    text[7577] = "después de lo que ocurrió durante el último ataque,";
    text[7578] = "¡no nos vendría mal mejorar nuestro equipo para luchar mejor contra los lóbregos!";
    text[7579] = "Bueno...";
    text[7580] = "Este es uno de los antiguos trajes impulsores de mamá.";
    text[7581] = "Pensaba ponérmelo algún día, pero...";
    text[7582] = "... Creo que todavía no estoy lista para llevarlo.";
    text[7583] = "Todavía me queda mucho que aprender y vivir.";
    text[7584] = "Sí, es más avanzado que el traje que llevo ahora...";
    text[7585] = "... también tiene un aspecto estupendo.";
    text[7586] = "El morado era el color favorito de mamá...";
    text[7587] = "Pero creo...";
    text[7588] = "Que no me sentiría bien si lo llevara...";
    text[7589] = "... antes de convertirme en una heroína de la que mamá se sintiera orgullosa,";
    text[7590] = "... antes de llegar a ser alguien que pueda proteger, no solo a la humanidad,";
    text[7591] = "sino a todas las formas de vida de Luna.";
    text[7592] = "Lóbregos incluidos.";
    text[7593] = "@P.@P.@P.@P.@P.@P.";
    text[7594] = "Tetra, cuando ese día llegue...";
    text[7595] = "... Cuando esté lista...";
    text[7596] = "Serás la primera en saberlo, ¿de acuerdo?";
    text[7597] = "¡Recibido! ¡Espero que ese día llegue pronto! Je, je.";
    text[7598] = "Vamos, descansemos un poco.";
    text[7599] = "Ha sido un día muy largo.";
    text[7600] = "¡Chupi dupi! ¡Yo también necesito recargarme!";
    text[3501] = "Ha sido un día muy largo. ¿Quieres ir a dormir?";
    text[3502] = "... Voces...";
    text[3503] = "...";
    text[3504] = "¿Cientos? ¿Tal vez miles?...";
    text[3505] = "Proteger...";
    text[3506] = "¿Qué estoy tratando de proteger?";
    text[3507] = "Floto sin rumbo...";
    text[3508] = "Parece que alguien está aquí conmigo...";
    text[3509] = "¿Chronos...?";
    text[3510] = "Todo se desvanece...";
    text[3511] = "Necesito descubrir...";
    text[3512] = "... la verdad.";
    text[3837] = "Bella, ¿estás bien?";
    text[3838] = "¡Has estado dando vueltas toda la noche mientras dormías!";
    text[3839] = "... Estoy bien.";
    text[3840] = "Tetra, debería hablar con papá sobre las extrañas sensaciones que estoy experimentando.";
    text[3841] = "Normalmente no me gusta preocupar a los demás o ser una carga para ellos, pero...";
    text[3842] = "Esto empieza a preocuparme a mí también...";
    text[3843] = "Es como si los lóbregos me estuvieran llamando. Puedo escuchar sus voces...";
    text[3844] = "¿Has oído la voz de Chronos?";
    text[3845] = "Sí, y también otras voces.";
    text[3846] = "Mamá me dijo que tenía un don que nadie más tenía.";
    text[3847] = "... pero nunca me dijo nada más al respecto.";
    text[3848] = "Siempre supuse que se refería a mi habilidad para el combate, pero...";
    text[3849] = "... ¿Es posible que se estuviera refiriendo a otra cosa?";
    text[3850] = "Mmm... Hablemos con papá.";
    text[3851] = "¡Estupendo!";
    text[3862] = "Hola, ¿mi padre está en el Laboratorio de Investigación?";
    text[3863] = "Lo siento, Srta. Bella, en este momento su padre está en una reunión sobre tecnología";
    text[3864] = "para tratar asuntos que podrían mejorar el diseño de Celestia.";
    text[3865] = "Mi deber es proteger la entrada, ja, ja, ja, ja...";
    text[3866] = "Ah, ya veo. ¡Gracias por decírmelo!";
    text[3867] = "Mmmm...";
    text[3868] = "¿Y si te limitas a llamar al doctor Thomas? Seguro que no le importará.";
    text[3869] = "Ahora mismo está ocupado. Prefiero esperar a que regrese.";
    text[3870] = "¡Puede que no haya dormido bien, pero me siento recargada!";
    text[3871] = "¡Tratemos de aprovechar el tiempo! ¡Veamos si hay alguna nueva misión que podamos realizar!";
    text[3872] = "¡Muuuuy bien! El PANEL DE MISIONES está abajo, en el vestíbulo de la P1.";
    text[3873] = "¡Antes deberíamos hablar con Stella! ";
    text[3874] = "Es la que asigna las nuevas misiones, je.";
    text[3875] = "Mis piernas me están matando...";
    text[3876] = "¡Ese es el panel de misiones de la Fuerza Lunex!";
    text[3877] = "¡Hola, Bella! ¡Pareces llena de energía!";
    text[3878] = "¡Lo estoy! ¿Tienes alguna misión nueva que ofrecerme?";
    text[3879] = "¡Estás de suerte! ¡Tenemos 3 misiones disponibles!";
    text[3880] = "¡Estupendo!";
    text[3881] = "Solo tienes que ir al PANEL DE MISIONES que tienes detrás.";
    text[3882] = "¡Cuando leas la descripción de una misión, la aceptarás automáticamente!";
    text[3883] = "¡Puedes completar las misiones en el orden que quieras!";
    text[3884] = "¡A partir de ahora, puedes ir directamente al PANEL DE MISIONES";
    text[3885] = "para comprobar si hay nuevas misiones disponibles!";
    text[3886] = "¡Buena suerte!";
    text[3887] = "¡Gracias, Stella!";
    text[3888] = "¡Ayer encargué algunos nuevos peluches en línea!";
    text[3889] = "Ooooh... ¿Cuáles?";
    text[3890] = "Por ahora es un secreto, ja, ja. ¡Ya lo verás!";
    text[3891] = "Por fin hemos localizado a la nave de bandidos que estaba transportando bienes robados.";
    text[3892] = "Esos bandidos forman parte de una organización criminal más grande, y tu misión es";
    text[3893] = "infiltrarte en su nave, arrestar a los bandidos y recuperar la mercancía robada.";
    text[3894] = "Uno de nuestros jets militares sufrió daños cuando un lóbrego que andaba cerca lo atacó.";
    text[3895] = "La piloto no sufrió ningún daño, y consiguió aterrizar su nave sin problemas en la Zona Yerma 1.";
    text[3896] = "Tu misión es ayudar a la piloto a encontrar y recuperar el cargamento que ha perdido.";
    text[3897] = "Se ha observado una escasez de comida sin precedentes en el Rancho Kepler.";
    text[3898] = "Hemos recibido varios informes sobre cultivos destrozados o que han desaparecido.";
    text[3899] = "Tu misión es ir a investigar y resolver el caso de los cultivos desaparecidos.";
    text[3633] = "¡Arriba las manos!";
    text[3634] = "¡Por la autoridad que me confiere la Fuerza Lunex, todos";
    text[3635] = "estáis detenidos por posesión y robo de bienes ajenos!";
    text[3636] = "Aaah... Así que tú eres la rata que ha conseguido infiltrarse sin que nadie la invitara...";
    text[3637] = "Llegas demasiado tarde, mema. Vamos dos pasos por delante de ti.";
    text[3638] = "¿Qué quieres decir?";
    text[3639] = "La mayor parte de la mercancía ya está en otro lugar.";
    text[3640] = "También he iniciado la secuencia de autodestrucción de esta nave.";
    text[3641] = "¡Vamos a acabar contigo y después huiremos antes de que esta nave explote!";
    text[3642] = "Recórcholis...";
    text[3643] = "Tetra, ¿cuánto tiempo tenemos?";
    text[3644] = "¡Tenemos que vencer a estos bandidos en menos de 10 TURNOS o estaremos fritas!";
    text[3645] = "Al jefe no le gusta que unas sucias fisgonas metan sus narices en nuestros asuntos.";
    text[3646] = "Acabé con muchos soldados lunex en su momento...";
    text[3647] = "¡ahora os toca a VOSOTRAS!";
    text[3648] = "¡Secuencia de autodestrucción desactivada!";
    text[3649] = "¡Bien hecho, Bella! ¡Esos bandidos no hacían más que dar problemas!";
    text[3650] = "Muy pronto deberían llegar refuerzos para recuperar la mercancía que queda en esta nave.";
    text[3651] = "¡Saldremos de aquí cuando estés lista! Je.";
    text[3900] = "Hola. Soy la piloto que encargó la misión de recuperar el cargamento perdido.";
    text[3901] = "¡Gracias por echarme una mano!";
    text[3902] = "¡No hay nada que agradecer! Dinos cómo podemos ayudarte.";
    text[3903] = "Muy bien... El problema no es el cargamento en sí...";
    text[3904] = "Sino la posibilidad de sufrir ataques de lóbregos mientras se da con él.";
    text[3905] = "De hecho, colocamos dispositivos de localización en todos nuestros envíos.";
    text[3906] = "He perdido un total de 3 paquetes del cargamento...";
    text[3907] = "... y lo último que sé de ellos es que estaban en 3 zonas de botín distintas de Luna.";
    text[3908] = "¿Qué es una zona de botín?";
    text[3909] = "Es un nombre que los cazatesoros pusieron a ciertas áreas hace muchos años.";
    text[3910] = "Son zonas secundarias que podrás descubrir mientras vuelas con tu nave.";
    text[3911] = "Nadie sabe lo que podrás encontrar en una zona de botín, ya que todas";
    text[3912] = "se encuentran en zonas inexploradas de Luna.";
    text[3913] = "¡En ellas podrás hallar tesoros, mazmorras e incluso lóbregos desconocidos!";
    text[3914] = "No tengo la fuerza o la habilidad necesarias para enfrentarme a los lóbregos, así que...";
    text[3915] = "¡Eh, para eso estamos aquí! ¿Verdad, Tetra?";
    text[3916] = "¡Sí! ¡No te preocupes, nosotras encontraremos ese cargamento!";
    text[3917] = "¡Muchas gracias! Podréis encontrar las zonas de botín en el mapa del mundo.";
    text[3918] = "¡Buena suerte!";
    text[3919] = "¡Has encontrado el primer paquete del cargamento perdido! ¡Ya solo quedan dos!";
    text[3920] = "¡Has encontrado el segundo paquete del cargamento perdido! ¡Ya solo queda uno!";
    text[3921] = "¡Has encontrado el último paquete del cargamento perdido!";
    text[3922] = "¡Hablemos de nuevo con la piloto en la Zona Yerma 1!";
    text[3927] = "¡Espera! ¡No podemos irnos sin coger el cargamento!";
    text[3923] = "¡Estupendo! ¡Habéis encontrado todos los paquetes!";
    text[3924] = "¿Os ha costado mucho encontrarlos?";
    text[3925] = "Algunos lóbregos de las zonas se habían hecho con los paquetes...";
    text[3926] = "... pero no ha sido nada que no pudiéramos afrontar, je.";
    text[3928] = "Por cierto, ¿qué contenían los paquetes?";
    text[3929] = "¡Eran partes de nave para nuestro nuevo jet militar!";
    text[3930] = "¡Control de Misiones me ha autorizado a recompensaros con nuevas partes de nave!";
    text[3931] = "¡Conjunto de nave Halcón obtenido! Este conjunto incluye las siguientes partes:";
    text[3932] = "¡CHASIS HALCÓN, ALA HALCÓN E IMPULSOR HALCÓN!";
    text[3933] = "¡Bien hecho! ¡Muchas gracias!";
    text[3934] = "¡Buenas! Me llamo Carl.";
    text[3935] = "Soy el responsable de los campos en Rancho Kepler.";
    text[3936] = "¡Es un placer conocerte, Carl! Dinos cuál es la situación.";
    text[3937] = "Un misterioso desconocido ha destruido dos de nuestros";
    text[3938] = "campos de cultivo.";
    text[3939] = "Muchos sectores dependen de nosotros para conseguir un suministro constante de comida...";
    text[3940] = "No podemos permitir que destruyan más cosechas...";
    text[3941] = "No te preocupes, Carl. Déjanoslo a nosotras.";
    text[3942] = "Haremos todo lo que podamos para solucionar esta situación cuanto antes.";
    text[3943] = "¿Hay algún animal en esta granja?";
    text[3944] = "No hay animales aquí. Se encuentran en una granja distinta.";
    text[3945] = "Mmm... Entonces, si no es un animal...";
    text[3946] = "¿Qué estás pensando, Bella?";
    text[3947] = "Es posible que sea una pregunta algo tonta, pero...";
    text[3948] = "Tetra, ¿puedes comprobar si hay algo en la base de datos que indique";
    text[3949] = "que los lóbregos consuman algo más aparte de humanos?";
    text[3950] = "Muy bien, dame un par de milisegundos...";
    text[3951] = "¡Hecho!";
    text[3952] = "He encontrado esto:";
    text[3953] = "Para reponer sus reservas de antimateria, los lóbregos deben";
    text[3954] = "consumir antimateria de alta densidad o";
    text[3955] = "formas de vida orgánicas, debido a la alta concentración de lux que contienen.";
    text[3956] = "Mmm... Las plantas y los cultivos se pueden considerar formas de vida orgánicas.";
    text[3957] = "¿Así que crees que un lóbrego está destrozando nuestros cultivos?";
    text[3958] = "Es posible. ¿Se ha visto a algún lóbrego por aquí últimamente?";
    text[3959] = "No, que yo sepa.";
    text[3960] = "Debido a la baja densidad de población de esta zona, no solemos ver a ningún lóbrego...";
    text[3961] = "Ya veo.";
    text[3962] = "Por favor, espéranos aquí, por seguridad.";
    text[3963] = "Tetra, vamos a buscar pistas.";
    text[3964] = "¡De acuerdo! ¡Detective Tetra está lista!";
    text[3965] = "No podemos permitirnos el riesgo de perder más cosechas...";
    text[3966] = "Por favor, investigad la situación y decidme si habéis encontrado algo.";
    text[3967] = "En esta parcela de terreno estaban plantando menta.";
    text[3968] = "Al culpable debe gustarle mucho la menta, ¿verdad?";
    text[3969] = "Un lóbrego aficionado a la menta... Nunca había oído algo así.";
    text[3970] = "¡Eh, mira! ¡Aquí hay huellas! Parecen pezuñas de jabalí...";
    text[3971] = "Tetra, escanea estas huellas...";
    text[3972] = "Mmm... Estas huellas podrían pertenecer a varios lóbregos.";
    text[3973] = "Tenemos que buscar más pistas para reducir la lista de sospechosos.";
    text[3974] = "Si podemos identificar la especie del lóbrego culpable,";
    text[3975] = "sabremos con exactitud a qué nos estamos enfrentando...";
    text[3977] = "Aquí hay muchos agujeros y tierra suelta.";
    text[3978] = "Nuestro culpable debe estar usando agujeros de gusano para comerse los cultivos y escapar.";
    text[3979] = "Tenemos que andarnos con ojo, por lo que pueda pasar.";
    text[3980] = "¡Hay marcas de mordiscos en estos barriles de acero!";
    text[3981] = "¿Qué pone en la etiqueta del barril?";
    text[3982] = "Ingredientes en bruto para mentitas de combate...";
    text[3983] = "Mmmm...";
    text[3984] = "He tratado de simular la mandíbula que podría haber infligido estas mordeduras...";
    text[3985] = "Parecen ser las mandíbulas de un caimán...";
    text[3986] = "Pero no puede ser un caimán... ¡Se han extinguido!";
    text[3987] = "PUAJ... ¡¿QUÉ ES ESO?!";
    text[3988] = "¿Parece una especie de muda de piel pegajosa?";
    text[3989] = "Necesito algo de tiempo para analizarla como es debido...";
    text[3990] = "Parece haber restos de antimateria en la piel.";
    text[3991] = "¡QUÉ ASQUITO! ¡Toda para ti!";
    text[3992] = "Muy bien, creo que ya tenemos todas las pistas...";
    text[3993] = "Bien, entonces, ¿qué sabemos?";
    text[3994] = "Veamos... Tiene la cabeza de un caimán...";
    text[3995] = "Las pezuñas de un jabalí...";
    text[3996] = "Y por algún motivo, le encanta la menta...";
    text[3997] = "¡Y cambia de piel, como los reptiles!";
    text[3998] = "¡Ah!";
    text[3999] = "¡Parece que tenemos una coincidencia!";
    text[4000] = "¡Hay un lóbrego en la base de datos de la Fuerza Lunex que coincide con las pistas!";
    text[4001] = "DENOMINACIÓN: ¡KAPROSAUR!";
    text[4002] = "¡Genial! ¡Bien hecho, Tetra!";
    text[4003] = "Je.";
    text[4004] = "Tengo una idea...";
    text[4005] = "Vamos a atraer al kaprosaur con una mentita de combate, je.";
    text[4006] = "¿Crees que esto puede funcionar?";
    text[4007] = "Bueno, podemos intentarlo.";
    text[4008] = "Consigamos una mentita de combate y luego volvamos aquí.";
    text[4009] = "Me parece que no funciona...";
    text[4010] = "¡Tiene que funcionar! ¡No tenemos más pistas!";
    text[4011] = "¿¡Eh!?";
    text[4012] = "¿Qué ocurre?";
    text[4013] = "¡Detecto un lóbrego!";
    text[4014] = "¡Culpable identificado!";
    text[4015] = "Eeeh... Bella, el kaprosaur parece muy alterado...";
    text[4016] = "¡Creo que le hemos asustado!";
    text[4017] = "¡Ten cuidado! ¡Podría atacarnos en cualquier momento!";
    text[4018] = "¡No te preocupes, todo está bajo control!";
    text[4019] = "¡El kaprosaur ha escapado!";
    text[4020] = "No pasa nada.";
    text[4021] = "Hemos confirmado que el culpable es un lóbrego.";
    text[4022] = "Control de Misiones tendrá que enviar más patrullas de guardias a Rancho Kepler.";
    text[4023] = "¡Ah, es verdad!";
    text[4024] = "¡Hablemos de nuevo con Carl!";
    text[4025] = "Santo cielo, ¡¿Entonces el responsable siempre fue un lóbrego?!";
    text[4026] = "Sí, pero ya no tienes que preocuparte por él. Por ahora lo hemos ahuyentado.";
    text[4027] = "Pediré que envíen más soldados de la Fuerza Lunex para ";
    text[4028] = "proteger los cultivos de más kaprosaurs hambrientos en el futuro.";
    text[4029] = "¡Gracias por salvar nuestra granja!";
    text[4030] = "Aquí tenéis un pequeño detalle de mi parte.";
    text[4032] = "Un lóbrego al que le encanta la menta... ¡Eso sí que es raro!";
    text[4103] = "¿Y ahora? ¡El doctor Thomas nos está llamando!";
    text[4104] = "¡Bella! Me dijeron que me estabas buscando.";
    text[4105] = "Lo siento, estaba ausente... Tenía asuntos importantes que atender.";
    text[4106] = "Papá, necesito hablar contigo de algo. ¿Estás ocupado?";
    text[4107] = "¡Acabo de hacerme una taza de café! Tengo algo de tiempo.";
    text[4108] = "¿Va todo bien?";
    text[4109] = "Sí... Te lo explicaré todo cuando te vea.";
    text[4110] = "Tetra, vamos a ver a papá en el Laboratorio de Investigación. ";
    text[4111] = "¡Chupi dupi!";
    text[4112] = "Bella explica al doctor Thomas las extrañas sensaciones que está teniendo,";
    text[4198] = "y le cuenta lo que ocurrió realmente durante su encuentro con Chronos en la Zona Fantasma...";
    text[4113] = "Deberías haberme contado todo esto antes, Bella.";
    text[4114] = "Lo sé... No creía que fuera un problema hasta que empecé a escuchar esas voces...";
    text[4115] = "Papá, estoy preocupada... ¿Va a pasarme algo?";
    text[4116] = "No te pasará nada. No hay de qué preocuparse.";
    text[4199] = "«Proteger»...";
    text[4148] = "Tal vez sea un sentimiento que comparten muchos lóbregos.";
    text[4153] = "Nunca se me había pasado por la cabeza que los lóbregos pudieran tener miedo de nosotros...";
    text[4149] = "Estamos acabando con ellos poco a poco para salvar a nuestra especie...";
    text[4150] = "¿Es posible que quieran que Bella les proteja?";
    text[4151] = "... Pero, ¿por qué yo?";
    text[4152] = "Tal vez sea porque eres la única que es capaz de comunicarse con ellos.";
    text[4117] = "No creía que fuera una habilidad hereditaria, pero parece que tu madre tenía razón.";
    text[4118] = "¿Razón en qué? ¿Qué es lo que mamá y tú me habéis estado ocultando?";
    text[4119] = "Lamento no habértelo dicho antes.";
    text[4120] = "Parece que posees una habilidad latente que te permite manipular tu lux...";
    text[4121] = "... una habilidad que tu madre también tenía.";
    text[4122] = "¡¿Manipular mi lux...?! Pero según la investigación de mamá, solo era una teoría...";
    text[4123] = "Lo era... Hasta que ella descubrió que también podía hacerlo.";
    text[4124] = "Antes de convertirse en general, tu madre era científica.";
    text[4125] = "Mi campo de investigación era la antimateria, mientras que el de Thea era la lux.";
    text[4126] = "Es de sobra conocido que el alma existe.";
    text[4127] = "Nuestra tecnología nos permite medirla... y cuantificarla, hasta cierto punto.";
    text[4128] = "La lux es, básicamente, una manifestación de la voluntad y el alma en forma de energía.";
    text[4129] = "Puede crecer y cambiar en función del estado emocional y físico de cada persona.";
    text[4130] = "Tu madre pensaba que tal vez podría comunicarse con los lóbregos";
    text[4131] = "si aprendía a controlar su lux...";
    text[4132] = "Cuando murió... No tuvimos ninguna otra manera de confirmar sus teorías...";
    text[4133] = "¡No tenemos tiempo para esperar a que mi habilidad para controlar la lux vuelva a manifestarse!";
    text[4134] = "¿Cómo puedo controlar mi lux? ¿Mamá te dijo algo?";
    text[4135] = "Ojalá lo supiera...";
    text[4136] = "Había secretos que tu madre nunca me contó...";
    text[4137] = "¿Por qué nos ocultaría esas cosas...?";
    text[4138] = "Conociendo a tu madre, probablemente lo hizo para protegernos.";
    text[4139] = "¿Protegernos de qué? ";
    text[4140] = "No lo sé... Necesito otra taza de café. Mi mente se está derritiendo.";
    text[4141] = "(Necesito saber lo que mamá descubrió sobre los lóbregos...)";
    text[4142] = "(No voy a rendirme).";
    text[4143] = "¿Es posible que haya alguien ahí fuera que tenga la misma información que ella?";
    text[4144] = "... ... ... ¡...! ";
    text[4145] = "¡El Matalóbregos!";
    text[4146] = "Cuando hablé con él en Copernicus, me dijo que había conocido a mamá.";
    text[4147] = "¡Tengo que volver a hablar con él!";
    text[4155] = "Bella, deberías quedarte aquí...";
    text[4156] = "¿Por qué? ¡Si nos quedamos sentados de brazos cruzados no conseguiremos nada!";
    text[4157] = "No podemos permitir que nadie se entere de tu habilidad latente...";
    text[4158] = "Tu madre lo mantuvo en secreto por un motivo. Deberíamos confiar en su buen juicio.";
    text[4159] = "Por ahora todo ha ido bien. Deja que la Fuerza Lunex se encargue de lo demás.";
    text[4160] = "Conseguiremos los antinúcleos que oculta el Matalóbregos, y cuando completemos Celestia,";
    text[4161] = "el cometa Coda no podrá hacernos nada. La gente de Luna estará a salvo.";
    text[4162] = "... ¿Por qué me miras así?";
    text[4163] = "Me estás ocultando algo.";
    text[4164] = "No te oculto nada... Voy a hacerme otra taza de café...";
    text[4165] = "Tu cara cambió cuando mencioné al Matalóbregos.";
    text[4166] = "Papá, por favor, dime qué está pasando.";
    text[4167] = "Deja de protegerme constantemente como mamá.";
    text[4168] = "¡Soy capaz de cuidar de mí misma!";
    text[4169] = "... Después de mi conferencia, visité la Base Militar para hablar con Saros.";
    text[4170] = "Le pregunté qué pretendía hacer con el Matalóbregos...";
    text[4171] = "Si el Matalóbregos no nos entrega los antinúcleos que oculta...";
    text[4172] = "Es posible que Saros extraiga la antimateria directamente del mismísimo Matalóbregos.";
    text[4173] = "Y es muy probable... que ese proceso acabe con él.";
    text[4174] = "¡N-no! ¡No podemos permitir que Saros haga algo así!";
    text[4175] = "¡Es cruel! ¡No puedo permitirlo!";
    text[4176] = "Yo tampoco estoy de acuerdo con su decisión,  ¿pero qué alternativa tengo?";
    text[4177] = "Como padre, he de proteger a mi familia...";
    text[4178] = "Cualquier acción contra la Fuerza Lunex nos pondría en peligro.";
    text[4179] = "Papá, ¡tenemos que convencer a Saros de que no haga esto!";
    text[4180] = "Ya lo he intentado...";
    text[4181] = "Saros está decidido a hacer lo que haga falta para salvar a la humanidad,";
    text[4182] = "aunque sea a costa de la vida del Matalóbregos.";
    text[4183] = "No... Necesito otra oportunidad para hablar con el Matalóbregos...";
    text[4184] = "¡Tal vez pueda convencerle de que nos revele la ubicación de los antinúcleos!";
    text[4200] = "Papá, te lo ruego...";
    text[4185] = "... ... ... ... ";
    text[4186] = "... (Aaay). Si te dijera que no, lo harías de todas formas.";
    text[4187] = "Toma esto.";
    text[4189] = "La Llave Lunex te permitirá acceder a la Base Militar y al Complejo Penitenciario.";
    text[4190] = "Por favor, ten cuidado. Sabes que cuentas con mi apoyo.";
    text[4191] = "Gracias, papá. ";
    text[4192] = "¡Sabía que podía contar contigo!";
    text[4193] = "Hablaré con Saros más tarde.";
    text[4194] = "Si alguien puede ganarse la confianza del Matalóbregos, ese alguien eres tú.";
    text[4195] = "Bella, por favor, no hagas ninguna locura...";
    text[4196] = "¡No te preocupes, papá! ¡No la haré!";
    text[4197] = "¡Vamos a la Base Militar, Tetra! ¡Está en la Zona Yerma!";
    text[4205] = "¡Huelo una nueva misión! ¡Cuenta conmigo!";
    text[4207] = "Muy bien, Tetra. Esta misión no es como las demás.";
    text[4208] = "¿Ah, no?";
    text[4209] = "No, es una misión de infiltración.";
    text[4210] = "No quiero que Saros sepa que estamos aquí...";
    text[4211] = "Papá dijo que haría cualquier cosa con tal de cumplir con sus objetivos.";
    text[4212] = "Tratará de detenerme si le doy motivos para hacerlo...";
    text[4213] = "... y no soy lo suficientemente fuerte para plantarle cara.";
    text[4214] = "Tendremos que pasar desapercibidas, tanto como sea posible.";
    text[4215] = "¿Seguro que quieres seguir con esto, Bella?";
    text[4216] = "Si nos pillan...";
    text[4217] = "No nos pillarán. Tengo a mi fiel ayudante a mi lado, je.";
    text[4218] = "Cierto, je. ¡La superayudante infiltrada Tetra está lista y ansiosa de empezar!";
    text[4219] = "Tetra, no tendrás ningún archivo sobre el Cuartel General Lunex en tu base de datos, ¿verdad?";
    text[4220] = "¿Si dijera que sí, me metería en un lío?";
    text[4221] = "No, tontorrona.";
    text[4222] = "¡Menos mal!";
    text[4223] = "Sueles soltarme un discurso cuando descargo información de alto secreto sin permiso.";
    text[4224] = "Esta vez no. ¡Tu pasión por la acumulación de datos nos viene de perilla!";
    text[4225] = "Muy bien, dame un par de milisegundos...";
    text[4226] = "¡Hecho! ¿Qué quieres saber?";
    text[4227] = "¿Hay otra manera de entrar al Complejo Penitenciario que no sea a través de la puerta principal?";
    text[4228] = "Según los planos de la Base Militar, hay una vieja escotilla de acceso";
    text[4229] = "que podemos usar en las Alcantarillas. ¡Está conectada al Complejo Penitenciario!";
    text[4230] = "¡Puaaaj! ¿Has dicho las Alcantarillas?";
    text[4231] = "¡Sí!";
    text[4232] = "Por favor, dime que hay OTRA manera de entrar...";
    text[4233] = "¡No, no lo hay!";
    text[4234] = "Vaya faena...  Después tendré que llevar mi traje impulsor a la lavandería...";
    text[4235] = "Muy bien, ¡vamos a las Alcantarillas! (¡Puaj!)";
    text[4241] = "¡Estamos dentro!";
    text[4242] = "El Matalóbregos debería estar en una de estas celdas.";
    text[4243] = "Qué raro...";
    text[4244] = "¿Ocurre algo?";
    text[4245] = "No hay prisioneros.";
    text[4246] = "... Y este lugar está muy tranquilo.";
    text[4247] = "Sigamos adelante, pero no bajemos la guardia.";
    text[4249] = "Esta debe ser la celda del Matalóbregos.";
    text[4250] = "¿Cómo lo sabes?";
    text[4251] = "Parece que es de la que más costaría fugarse.";
    text[4252] = "Tetra, ¿crees que podrías abrir este cerrojo electrónico?";
    text[4253] = "Mmmm...";
    text[4254] = "No puedo abrirlo desde aquí.";
    text[4255] = "Tendríamos que encontrar el panel de control que está conectado a esta puerta.";
    text[4256] = "Muy bien, ¡busquemos ese panel de control!";
    text[4257] = "SEÑAL DE TRAJE IMPULSOR NO AUTORIZADO DETECTADA.";
    text[4258] = "INDIQUE QUÉ LE TRAE HASTA AQUÍ.";
    text[4259] = "Oh-oh, ¡es un robot de seguridad! ¿Qué deberíamos hacer?";
    text[4260] = "¡No podemos escapar! ";
    text[4261] = "¡Debemos desactivarlo antes de que lleguen refuerzos! ";
    text[4262] = "AMENAZA DETECTADA.";
    text[4263] = "ACTIVANDO MODO DE COMBATE.";
    text[4264] = "¡Es aquí! ¡La señal procedía de esta dirección!";
    text[4265] = "¡Oh, no! ¡Dos soldados guardianes se acercan a nosotras!";
    text[4266] = "¡Escóndete!";
    text[4267] = "*¡Pam!* *¡Zas!*";
    text[4268] = "Lo siento...";
    text[4269] = "Tetra, comprueba sus constantes vitales.";
    text[4270] = "No les pasará nada.";
    text[4271] = "Solo están echando una siestecita, je.";
    text[4272] = "Nos vieron las caras...";
    text[4273] = "Ya no hay vuelta atrás.";
    text[4274] = "Sigamos adelante.";
    text[4275] = "¡Espera! ¡Tengo una idea!";
    text[4276] = "¡Tetra, eres un genio!";
    text[4277] = "Je, dime algo que no sepa.";
    text[4305] = "Los trajes impulsores son impermeables y estancos. En mi caso, solo tengo que inflarlo,";
    text[4306] = "añadir algunos apéndices robóticos y... ¡tachán! Tendremos el disfraz perfecto.";
    text[4278] = "Con estos trajes impulsores no activaremos a ningún robot de seguridad más.";
    text[4279] = "Je. Muy bien, sigamos. El panel de control debería estar más adelante.";
    text[4280] = "¿¡No está aquí!?";
    text[4281] = "¿Tal vez esta no es su celda?";
    text[4282] = "No, estoy segura de que lo encerraron aquí.";
    text[4283] = "Han incorporado la holotecnología de Vivia a esta celda para evitar que escapara.";
    text[4284] = "Entonces ha escapado por arte de magia o...";
    text[4285] = "¡Oh, no...!";
    text[4286] = "¡Debemos darnos prisa!";
    text[4287] = "Probablemente lo han llevado a una sala en la que puedan extraerle la antimateria.";
    text[4288] = "Tendremos en infiltrarnos en la Base Militar para encontrarle.";
    text[4289] = "Ahora tenemos disfraces, así que podemos echar un vistazo sin levantar sospechas.";
    text[4290] = "Hay un ascensor que permite llegar a la Base Militar. ¡Vamos a encontrarlo!";
    text[4301] = "¡Ahora la puerta de la celda debería estar abierta!";
    text[4302] = "Un momento, ¡el ascensor que hay delante conduce a la Base Militar!";
    text[4303] = "Será mejor no ir allí en este momento.";
    text[4304] = "Este soldado está inconsciente...";
    text[4308] = "¡Eh!";
    text[4309] = "¿Va todo bien?";
    text[4310] = "¿Qué le ha ocurrido al robot de seguridad? ¿Por qué nos envió una señal de amenaza?";
    text[4311] = "Eeeh... Parece que una rata activó la alarma del robot de seguridad. ";
    text[4312] = "¡Lo hemos recalibrado para asegurarnos de";
    text[4313] = "que no vuelva a dar una falsa alarma!";
    text[4314] = "Vaya, no sabía que sabíais arreglar robots.";
    text[4315] = "Deberíais enseñarme a hacerlo un día de estos.";
    text[4316] = "Aquí abajo todo suele estar muy tranquilo.";
    text[4317] = "Oye, ¿puedo hacerte una pregunta?";
    text[4318] = "¡Claro!";
    text[4319] = "Bueno... Acabo de volver de mis vacaciones, así que no estoy muy al día...";
    text[4320] = "¿Dónde están todos los prisioneros?";
    text[4321] = "Oh, al parecer los han llevado a otro edificio.";
    text[4322] = "¿Sabes por qué?";
    text[4323] = "Ni idea. Solo sé que fue el general Saros quien dio la orden.";
    text[4324] = "Ya veo. ¡Gracias!";
    text[4325] = "Seguiremos, eh...";
    text[4326] = "... patrullando la zona, para ver si... pillamos a la rata.";
    text[4327] = "Muy bien, adelante.";
    text[4328] = "Buuf... No puedo creer que haya funcionado.";
    text[4330] = "Según los planos de la Base Militar, ¡esta planta cuenta con las";
    text[4331] = "medidas necesarias para evitar que los prisioneros escapen fácilmente!";
    text[4332] = "Y que lo digas. No esperaba tener que enfrentarme a láseres y a un foso mortal...";
    text[4333] = "Oh, bueno. No es nada que no podamos superar, je.";
    text[4372] = "Vivia debe desarrollar su holotecnología aquí.";
    text[4373] = "Mmmm...";
    text[4374] = "Tetra, ¿crees que podrías echarle un vistazo a su ordenador?";
    text[4375] = "Tal vez puedas descubrir cómo funciona su holotecnología.";
    text[4376] = "¡Claro! Aunque puede que tarde un poco.";
    text[4377] = "Mientras tanto, ¿puedo preguntarte por qué quieres que lo haga?";
    text[4378] = "Forma parte de mi plan.";
    text[4379] = "Pensaba que el plan era hablar con el Matalóbregos.";
    text[4380] = "Ese sigue siendo el plan...";
    text[4381] = "... pero antes debemos ganarnos su confianza.";
    text[4382] = "Y para hacerlo... ";
    text[4383] = "... creo que deberíamos ayudarle a escapar de este sitio.";
    text[4384] = "¡¿CÓMO?! ¿Estás segura, Bella?";
    text[4385] = "¡Sería ir en contra de la Fuerza Lunex!";
    text[4399] = "Nos convertiríamos en criminales...";
    text[4386] = "Haré frente a las consecuencias más tarde.";
    text[4387] = "Salvar a la humanidad es más importante.";
    text[4388] = "Es posible que esté más dispuesto a abrirse a nosotros si le ayudamos a escapar.";
    text[4389] = "Muy bien... Si para ti está bien, para mí también lo está.";
    text[4390] = "Te apoyaré pase lo que pase.";
    text[4391] = "Es lo que hacen las superayudantes, je.";
    text[4392] = "¡Ajá! ¡Análisis completo!";
    text[4393] = "He conseguido desencriptar un archivo que estaba oculto en su ordenador.";
    text[4394] = "La holotecnología de la comandante Vivia se controla mediante un programa personalizado.";
    text[4395] = "He encontrado una contraseña que puede anular el programa y desactivar la holotecnología.";
    text[4396] = "¡Estupendo! Guarda esa contraseña, ¡puede sernos muy útil!";
    text[4397] = "Gracias por estar siempre a mi lado, Tetra.";
    text[4398] = "Puedes llamarme rebelde militar Tetra ahora, je.";
    text[4412] = "Pero qué han hecho con él...";
    text[4413] = "Está inconsciente... Sus constantes vitales parecen normales.";
    text[4416] = "(Así que esta es su cara...).";
    text[4417] = "(En realidad es...)";
    text[4418] = "(... bastante mono).";
    text[4294] = "(Oh, oh, tenemos compañía. ¡Es Vivia!).";
    text[4295] = "(¿Qué hacemos ahora?)";
    text[4296] = "(Tranquila. Déjame hablar a mí).";
    text[4297] = "(No, espera. Reconocerá tu voz, ¡déjame a mí!).";
    text[4298] = "(Un momento, ¡¿qué?!).";
    text[4414] = "¿Qué estáis haciendo vosotros dos aquí? Aquí no se os ha perdido nada.";
    text[4299] = "Le pido disculpas, comandante Vivia. La estábamos buscando.";
    text[4300] = "(Ah, ¡está usando un modulador de voz!). ";
    text[4400] = "El general Saros solicita hablar con usted en persona.";
    text[4401] = "Es... urgente.";
    text[4402] = "También nos ha enviado para que hagamos guardia en caso de que el Matalóbregos despierte.";
    text[4403] = "Ya veo.";
    text[4404] = "Gracias por hacérmelo saber.";
    text[4415] = "Discúlpenme.";
    text[4405] = "Buff, eso ha estado cerca.";
    text[4406] = "Al menos no era Saros.";
    text[4407] = "Él es tremendamente perspicaz. Nos habría reconocido a pesar de los disfraces.";
    text[4408] = "Hablando de Saros, me sorprende que no nos hayamos tropezado con él.";
    text[4409] = "Es extraño... Me pregunto qué se traerá entre manos...";
    text[4410] = "En fin, ¿Tetra, puedes desactivar la holotecnología?";
    text[4419] = "¡Está chupado! Solo tengo que activar el protocolo de desactivación, introducir la contraseña y...";
    text[4420] = "¡Hecho!";
    text[4421] = "¡Eh! Necesito que despiertes.";
    text[4422] = "¡Despierta, Matalóbregos!";
    text[4423] = "Agh...";
    text[4424] = "Esa voz...";
    text[4425] = "¿Bella...?";
    text[4426] = "Sí, soy yo. He venido a sacarte de aquí.";
    text[4427] = "¿En serio? Pero, ¿por qué?";
    text[4428] = "... Porque eres un cabezota.";
    text[4429] = "Estás dispuesto a morir con tal de que Saros no se haga con los antinúcleos.";
    text[4430] = "...";
    text[4431] = "No creo que seas una mala persona. No mereces morir.";
    text[4432] = "Mmmm... No me conoces y no sabes qué he hecho en el pasado.";
    text[4433] = "Aun así, estoy dispuesta a ayudarte...";
    text[4434] = "... porque es lo correcto.";
    text[4435] = "Vamos, Matalóbregos. ¡Tenemos que salir de aquí cuanto antes!";
    text[4436] = "Deja de llamarme Matalóbregos.";
    text[4437] = "Me llamo Nickle.";
    text[4438] = "Nickle, ¿puedes andar?";
    text[4439] = "Estaré bien. Estoy algo mareado, pero todavía puedo luchar si es necesario.";
    text[4440] = "Sal tu primero. Estaré detrás de ti.";
    text[4441] = "¿No confías en mí?";
    text[4442] = "No confío en nadie.";
    text[4443] = "¿Cómo sé que no nos atacarás por la espalda para luego salir corriendo?";
    text[4444] = "No voy a hacerlo.";
    text[4445] = "¿Entonces quieres decir que debería confiar en ti?";
    text[4446] = "... Tendré que pedirte algo más tarde. Es importante.";
    text[4447] = "Por mucho que odie admitirlo...";
    text[4448] = "Necesito tu ayuda.";
    text[4449] = "¡Genial! Entonces está todo dicho.";
    text[4450] = "Tenemos que trabajar juntos si queremos escapar.";
    text[4451] = "Bella, Tetra y Nickle: ¡criminales unidos!";
    text[4452] = "¡Los tres mosqueteros de Luna! Je.";
    text[4453] = "¿Tu robot siempre es así de cargante?";
    text[4454] = "Este robot tan cargante te ha librado de la holotecnología, ¡gracias por nada!";
    text[4455] = "Me debes una. Hum.";
    text[4456] = "... Lo que tú digas. Vámonos.";
    text[4511] = "¡NICKLE SE HA UNIDO AL GRUPO!";
    text[4457] = "ATENCIÓN: CONFINAMIENTO INICIADO";
    text[4458] = "EL MATALÓBREGOS TRATA DE ESCAPAR. ¡DETENEDLO DE INMEDIATO!";
    text[4459] = "Diablos... ¡Hay guardias por todas partes!";
    text[4460] = "¡No podemos escapar!";
    text[4461] = "Seguidme.";
    text[4462] = "¿¡Cómo!?";
    text[4463] = "¡SALTAD!";
    text[4513] = "Ay... Estás como una cabra, ¿sabes?";
    text[4464] = "¿En qué planta estamos?";
    text[4465] = "Esta es la primera planta. La salida está cerca.";
    text[4466] = "OBJETIVO LOCALIZADO. INICIANDO MODO DE COMBATE... ESPERANDO RESPUESTA DE OBJETIVO.";
    text[4467] = "Tch. Otro robot, vaya incordio.";
    text[4468] = "¡Eh! ¡Hay un piloto dentro, ¿sabes?!";
    text[4514] = "No deberíamos hacerle daño si podemos evitarlo.";
    text[4515] = "Bella, necesito que me consigáis algo de tiempo mientras desactivo las puertas láser.";
    text[4469] = "Les enseñaré a no cruzarse en nuestro camino.";
    text[4516] = "...";
    text[4470] = "¿Vais a quedaros de pie sin hacer nada o vais a luchar conmigo?";
    text[4471] = "Bella, elegiste un camino cuando decidiste ayudarme a escapar.";
    text[4472] = "Ahora, aunque todo el mundo esté en tu contra... tienes que luchar.";
    text[4473] = "... Si no lo haces, todo esto no habrá servido para nada.";
    text[4474] = "No podrás cambiar el mundo ni encontrarás las respuestas que ansías";
    text[4475] = "si acabas encerrada en la celda de una prisión.";
    text[4476] = "... muy bien, de acuerdo.";
    text[4477] = "¡Preparémonos para el combate!";
    text[4478] = "¡Así me gusta! ¡Vamos allá!";
    text[4479] = "¡He desactivado la puerta láser! Se sale por aquí, ¡vamos!";
    text[4480] = "Se han llevado nuestra nave... ¿Cómo vamos a escapar?";
    text[4481] = "Tendremos que ir a pie.";
    text[4482] = "Tengo un escondite en Colonia Silica, podemos ir allí.";
    text[4483] = "Eso está en el norte. Está bastante lejos de este lugar...";
    text[4484] = "¿Tienes algún escondite cerca que la Fuerza Lunex desconozca?";
    text[4485] = "No...";
    text[4486] = "Entonces debemos llegar hasta Colonia Silica.";
    text[4487] = "Primero debemos ir al oeste.";
    text[4488] = "El sendero que conduce hacia arriba nos llevará al Cráter de la Oscuridad Eterna.";
    text[4489] = "Deberíamos movernos por las zonas más oscuras del cráter para evitar que nos vean.";
    text[4490] = "Muy bien, ¡a volar!";
    text[4492] = "¡Vivia!";
    text[4493] = "Tch, tch... Me has decepcionado, Bella.";
    text[4494] = "...";
    text[4498] = "Parece que Saros tenía razón cuando dijo que no tardarías en traicionarnos.";
    text[4520] = "Al principio me costó mucho creerlo.";
    text[4499] = "Tu lealtad hacia la Fuerza Lunex siempre había sido inquebrantable... hasta ahora.";
    text[4521] = "Lo siento... Es solo que...";
    text[4522] = "Tengo que hacer esto. Este es el camino que he escogido.";
    text[4523] = "Antes, en la base... sabías que éramos nosotras, ¿verdad?";
    text[4495] = "Me di cuenta de que os habíais infiltrado en nuestro cuartel general cuando tu pequeño robot";
    text[4496] = "desactivó la red de las alcantarillas.";
    text[4497] = "Eh, je, je... Supongo que Vivia es mucho perspicaz de lo que pensábamos.";
    text[4500] = "Esperaba que pudierais sacarle la información que necesitamos al Matalóbregos,";
    text[4501] = "pero en vez de hacerlo, decidisteis conspirar en nuestra contra.";
    text[4524] = "Vivia...";
    text[4526] = "Veo que el Matalóbregos sigue tan callado como siempre...";
    text[4530] = "... Tch.";
    text[4527] = "¿Es posible que mi presencia le esté evocando el dolor del pasado...?";
    text[4531] = "¿O tal vez solo se trata de miedo? ¡Oh, jo, jo, jo!";
    text[4528] = "Después de todo, disfruté viéndote sufrir...";
    text[4529] = "... por el bien de la ciencia, claro está.";
    text[4532] = "... Eres repugnante.";
    text[4502] = "¡No pienso tolerar vuestra rebeldía!";
    text[4503] = "Si mis receptáculos no pueden deteneros, tendré que hacerlo personalmente.";
    text[4525] = "¡ACTIVANDO HOLOTRAJE!";
    text[4504] = "Vivia, no tenemos que hacer esto. ¿No podemos solucionar esta situación sin luchar?";
    text[4505] = "Qué estúpida y qué ingenua.";
    text[4539] = "No sabes lo fuerte que la comandante de la Fuerza Lunex es en realidad.";
    text[4540] = "¡Aaagh! ¡Esto no me gustan nada!";
    text[4541] = "... Algo está nublando tu juicio, Vivia.";
    text[4542] = "Hace muchos años que te conozco... ";
    text[4543] = "No eras tan fría y calculadora cuando mamá estaba viva...";
    text[4544] = "Has cambiado.";
    text[4545] = "¡SILENCIO!";
    text[4546] = "Hago lo que es necesario para que Saros pueda salvar a la humanidad.";
    text[4547] = "El Matalóbregos es la clave para conseguirlo.";
    text[4548] = "Bien, basta de charla. Ya es hora de divertirse, ¿no os parece?";
    text[7601] = "¡Esto no ha terminado! ¡No voy a dejaros escapar!";
    text[7602] = "¡Activando holocampo!";
    text[7613] = "Parece que la victoria es mía. Ahora comportaos como un par de buenos prisioneros mientras pido refuerzos.";
    text[7603] = "Diablos... Es la misma barrera que usó para atraparme en Copernicus...";
    text[7604] = "Estamos atrapados.";
    text[7605] = "Tetra, ¿se te ocurre algo?";
    text[7615] = "Mmmm... Dejad que haga un análisis rápido...";
    text[7606] = "Parece que Saros y Vivia no mentían.";
    text[7616] = "Si se acumula cierta cantidad de energía dentro del holocampo,";
    text[7617] = "este implosionará, lo que acabaría con nosotros.";
    text[7607] = "... A no ser...";
    text[7608] = "Que liberemos una cantidad de energía capaz de saturar el holocampo.";
    text[7609] = "Nickle, y si te convirtieras en...";
    text[7610] = "¡NO!";
    text[7611] = "Mi forma de fase es demasiado peligrosa.";
    text[7612] = "No lo entendéis...";
    text[7618] = "Si dejo que la antimateria me consuma...";
    text[7619] = "... corro el riesgo de que mi mente también sea consumida.";
    text[7620] = "Es una forma que no usaré a no ser que sea absolutamente necesario.";
    text[7621] = "Bueno, ¡parece que estamos en una situación que lo requiere!";
    text[7622] = "Por favor, Nickle...";
    text[7623] = "Date prisa, ¡Vivia está regresando!";
    text[7624] = "Tch.@P.@P.@P.@P.@P.@P.@P.@P.@P.";
    text[7625] = "Bien, de acuerdo. Lo haré.";
    text[7626] = "... Pero si os acabo haciendo daño...";
    text[7627] = "¡Limítate a hacerlo!";
    text[7628] = "¡AAAAAAAAH!";
    text[7629] = "¡Imposible! ¿Cómo habéis...?";
    text[4507] = "¡Está paralizada!";
    text[4508] = "¡Es nuestra oportunidad! ¡Salgamos de aquí!";
    text[7630] = "Nickle, tu forma de fase... ¡es increíble!";
    text[7631] = "Pensaba que dijiste que no podrías controlarla...";
    text[7632] = "Escucha, no me gusta usarla...";
    text[7633] = "... y a veces no es fácil controlarla...";
    text[7634] = "Es algo... complicado.";
    text[7635] = "Eso es todo lo que tienes que saber. Esta conversación ha terminado.";
    text[7636] = "De acuerdo...";
    text[7637] = "Salgamos de aquí antes de que lleguen refuerzos.";
    text[7638] = "¡MODO FASE DESBLOQUEADO!";
    text[7639] = "¡Esta forma dura 3 turnos y duplica el POD de las habilidades activas de Nickle!";
    text[7640] = "¡Mientras tenga esta forma, los ataques enemigos que hagan 50 de DAÑ o menos quedan anulados!";
    text[4509] = "¡Allí! ¡Cojamos esa nave!";
    text[4510] = "¡No les dejéis escapar!";
    text[4567] = "Es la primera vez que veo una nave como esta.";
    text[4568] = "¡Según mi base de datos, es una nave cápsula!";
    text[4569] = "Es un modelo de nave antiguo que la Fuerza Lunex dejó de producir hace años.";
    text[4570] = "Parece que han abandonado unas cuantas en esta zona.";
    text[4571] = "Tetra, ¿crees que podrías arrancar esta nave?";
    text[4572] = "Lo intentaré...";
    text[4573] = "Esperemos que le quede algo de carga a la batería...";
    text[4574] = "¡Ha funcionado! Je.";
    text[4575] = "Muy bien, salgamos de aquí. Tenemos que ir al norte.";
    text[4579] = "¡Allí están! ¡No dejéis que despeguen!";
    text[4580] = "Ah, diablos, ¡se acercan refuerzos!";
    text[4581] = "¡Rápido! ¡Meteos en la nave!";
    text[4585] = "Aquí hay muy poco espacio...";
    text[4586] = "Ah, olvidé mencionarlo antes...";
    text[4587] = "Normalmente las naves cápsulas se diseñaban para contener solamente a un piloto..., je, je, je.";
    text[4582] = "¡Proyectiles fotónicos detectados!";
    text[4553] = "¡Habéis fallado! ¡¿A qué estáis esperando?! ¡Seguid disparando!";
    text[4554] = "... Pero, comandante... Saros nos ordenó capturarlos con vida.";
    text[4555] = "No podremos derrotarles tan fácilmente.";
    text[4556] = "Nuestro objetivo debe ser retrasarles... Dejarles sin recursos...";
    text[4557] = "... Hasta que se queden sin opciones y no puedan contraatacar.";
    text[4558] = "¡S-sí, comandante! ¡Fijando destructores fotónicos a máxima potencia!";
    text[4589] = "¡CONTROLA LA NAVE Y EVITA LOS PROYECTILES!";
    text[4590] = "¡Les hemos dejado con un palmo de narices! ¡Eres una piloto estupenda, Bella! ";
    text[4591] = "Gracias, je.";
    text[4592] = "Todavía no hemos resuelto nuestros problemas.";
    text[4593] = "La batería de la nave está prácticamente agotada.";
    text[4594] = "Aterriza. Las Fosas de Silica están ahí delante.";
    text[4595] = "¿Qué tal si dices «por favor»?";
    text[4600] = "¿Qué tal si te digo «no»?";
    text[4601] = "Hum. Vaya tipo.";
    text[4602] = "¡Muy bien, voy a aterrizar! ¡Será mejor que os agarréis a algo!";
    text[4598] = "¡Nuestra nave ha recibido demasiado daño!";
    text[4599] = "¡Tenemos que hacer un aterrizaje de emergencia antes de que salte en pedazos!";
    text[4614] = "Mientras tanto...";
    text[4615] = "Aaah... Creo que ya está bien de entrenamiento por hoy...";
    text[4616] = "¡Tengo los brazos como gelatina!";
    text[4617] = "Me parece bien. Yo también estoy satisfecha con el entrenamiento de hoy.";
    text[4618] = "Esa técnica nueva era muy guay, Zara. ¿Cómo dices que se llamaba? ";
    text[4670] = "¿Alubia de Piedra Elástica?";
    text[4619] = "Lluvia de Piedras Estática. Es un nombre largo, pero creo que puede ser muy útil en combate.";
    text[4633] = "Admiro tu pasión a la hora de inventar nuevas técnicas.";
    text[4620] = "Un día te convertirás en la mejor maestra de enlaces neurales de todos los tiempos, ¡estoy segura!";
    text[4621] = "Eso espero... Gracias, Melody.";
    text[4622] = "Mmmm...";
    text[4623] = "Raine debería acabar su sesión de entrenamiento en cualquier momento...";
    text[4624] = "... ¡Sí! ¡Ahí está!";
    text[4625] = "¡VAYA PASADA! ¡Deberíais haber visto el último puñetazo que lancé!";
    text[4635] = "¡El robot de combate no tuvo ninguna oportunidad! ¡Estoy que ardo, chicas!";
    text[4628] = "Srta. Raine, ¡he escuchado una explosión! ¿Va todo bien?";
    text[4629] = "Oh, vaya...";
    text[4630] = "Llamad al mecánico de robots. El robot de combate está, esto... roto...";
    text[4631] = "...de nuevo.";
    text[4632] = "No pasa nada, Srta. Raine. Iré a por el mecánico...";
    text[4636] = "Bien, chicas, ¿qué queréis hacer ahora?";
    text[4637] = "Oh, ¡vamos a ver a Bella!";
    text[4638] = "Me pregunto qué se trae entre manos...";
    text[4639] = "Buena idea. Como el robot de combate está fuera de servicio...";
    text[4640] = "¡BELLA OCUPARÁ SU LUGAR! ¡MUAH, JA, JA, JA!";
    text[4641] = "¡Esa guerrera prodigio necesita que alguien le patee el trasero!";
    text[4642] = "Controla a la bestia, Raine. Controla a la bestia.";
    text[4643] = "¡Eh, mirad! ¡Parece que tenemos una nueva misión!";
    text[4644] = "...";
    text[4645] = "... Un momento, ¿qué?";
    text[4646] = "¿He leído esto bien? No puede ser verdad...";
    text[4647] = "Es un informe de misión de código morado para soldados y personal militar de alto rango...";
    text[4648] = "¡El Matalóbregos ha escapado!";
    text[4649] = "Aquí dice que nuestra misión es encontrar y capturar al Matalóbregos";
    text[4650] = "... y a su cómplice...";
    text[4651] = "Bella Grey.";
    text[4652] = "Debe ser una broma...";
    text[4653] = "¿Bella estaba de su lado todo este tiempo?";
    text[4654] = "No, no lo creo.";
    text[4655] = "Bella no se volvería en contra de la Fuerza Lunex de esta manera...";
    text[4656] = "... A no ser que...";
    text[4671] = "¡ESTO ES INACEPTABLE!";
    text[4657] = "¡¿Ese no era el doctor Thomas?! ¡Acaba de pasar a toda velocidad!";
    text[4659] = "Chicas, ¿vosotras también habéis recibido el informe de misión?";
    text[4660] = "Sí, así es...";
    text[4661] = "En cuanto el doctor vio el nombre de Bella, se marchó hecho una furia.";
    text[4662] = "Se dirige a la Base Militar para hablar directamente con Saros.";
    text[4663] = "Nuestra querida Bella...";
    text[4664] = "... ahora es una criminal buscada, mueh. No son buenas noticias, desde luego...";
    text[4665] = "(Bella tiene que tener un buen motivo para hacer esto... No me cabe duda..).";
    text[4666] = "Chicas... ¡Tenemos que encontrar a Bella de inmediato!";
    text[4667] = "Aunque otros soldados de la Fuerza Lunex la encuentren, no serían capaces de detenerla.";
    text[4668] = "Estoy de acuerdo. Ese es un trabajo perfecto para el Escuadrón Raine.";
    text[4669] = "¡EN MARCHA!";
    text[4603] = "Tetra, ¿cuáles son nuestras coordenadas?";
    text[4604] = "En estos momentos estamos en el sector 2: ¡las Fosas de Silica!";
    text[4605] = "Buff... Todavía nos queda mucho para llegar a mi escondite...";
    text[4606] = "Buff... Buff...";
    text[4607] = "Nickle, ¿estás bien?";
    text[4608] = "Estoy bien... Tenemos que...";
    text[4609] = "¡Está herido! ¡Necesita descansar!";
    text[4610] = "Tetra, encárgate de la nave cápsula. Si la dejamos aquí, revelará nuestra ubicación.";
    text[4611] = "He visto una pequeña cueva cerca de aquí. Descansemos allí esta noche.";
    text[4672] = "...";
    text[4673] = "¿Qué ocurre, Bella?";
    text[4674] = "Nada, es solo que...";
    text[4675] = "... Supongo que tengo un pequeño ataque de ansiedad.";
    text[4676] = "He sido leal a la Fuerza Lunex durante años...";
    text[4677] = "He tenido el orgullo de luchar y entrenar para convertirme en una fiera guerrera, como mamá...";
    text[4678] = "... y todo para proteger a la gente de Luna.";
    text[4679] = "Y ahora... parece que mi mundo se ha vuelto del revés.";
    text[4680] = "¡Superaremos esto juntos, Bella!";
    text[4681] = "Es posible que todo parezca difícil ahora, ¡pero no debemos perder nuestra determinación!";
    text[4682] = "Tienes razón...";
    text[4683] = "... ¿Podríais bajar un poco la voz? Tengo un dolor de cabeza tremendo...";
    text[4684] = "Parece que el Sr. Dormilón se ha despertado.";
    text[4685] = "Uuugh... ¿Cuánto he dormido?";
    text[4686] = "Cuatro horas.";
    text[4687] = "¡Cuatro horas roncando como un oso! Hum.";
    text[4690] = "Lo he oído. Te sonaban las tripas.";
    text[4691] = "...";
    text[4692] = "Si queremos recuperarnos como es debido, debemos comer algo.";
    text[4693] = "Toma, siempre tengo a mano una barrita de tarta de queso de emergencia.";
    text[4694] = "No, gracias.";
    text[4695] = "¡No es posible que una persona en su sano juicio rechace una barrita de tarta de queso!";
    text[4696] = "¿Acaso las has probado?";
    text[4697] = "No...";
    text[4698] = "¿CÓMO? TIENES QUE PROBARLA. ¡ES UN MANJAR DE DIOSES!";
    text[4699] = "... Vale. Dame la mitad.";
    text[4700] = "(Ñam, ñam, ñam)";
    text[4701] = "¿Y bieeeeen?";
    text[4702] = "¿Qué te parece?";
    text[4703] = "¿Te gusta?";
    text[4704] = "No está mal. (¡DEMONIOS! ¡NUNCA HABÍA PROBADO NADA TAN BUENO!)";
    text[4705] = "Je. Tu cara lo dice todo.";
    text[4706] = "¡Me alegro de que te haya gustado!";
    text[4707] = "... Gracias, supongo.";
    text[4708] = "Bien, como estamos a salvo por ahora...";
    text[4709] = "Creo que deberíamos hablar. Conocernos un poco mejor, ¿sabes?";
    text[4710] = "¿Hablar de qué?";
    text[4711] = "Cielos, tienes que mejorar tus habilidades sociales.";
    text[4712] = "Eh, no voy a convertirme mágicamente en tu amigo porque";
    text[4713] = "me ayudaras a escapar de la Fuerza Lunex.";
    text[4714] = "Tal vez un amigo es justo lo que necesitas.";
    text[4715] = "Alguien que esté ahí para escuchar tus problemas.";
    text[4716] = "Alguien con el que compartir palabras sinceras.";
    text[4717] = "Tal vez deberías mantenerte alejada de mí.";
    text[4718] = "Ni siquiera yo querría ser mi amigo.";
    text[4719] = "... Hace mucho tiempo tenía amigos cercanos...";
    text[4720] = "... pero ahora han desaparecido.";
    text[4721] = "Vaya donde vaya, no causo más que dolor.";
    text[4722] = "Todo el mundo acaba sufriendo de alguna manera por mi culpa.";
    text[4723] = "¿Es eso de lo que tienes miedo?";
    text[4724] = "¿De perder a la gente que te importa?";
    text[4725] = "Eres muy perspicaz... y algo irritante.";
    text[4726] = "También hay algo que yo quería preguntarte...";
    text[4727] = "¿Por qué yo?";
    text[4728] = "¿Qu-qué? ¿Qué quieres decir?";
    text[4729] = "Si fuera otra persona, ya te habrías marchado.";
    text[4730] = "No te habrías abierto a nadie más, ni habrías hablado con otra persona.";
    text[4731] = "Así que, ¿por qué yo?";
    text[4732] = "...";
    text[4733] = "¿Es porque conocías a mi madre?";
    text[4734] = "¿Puedo preguntarte...";
    text[4735] = "cómo conociste a mi mamá?";
    text[4736] = "Hace años, cuando apenas era capaz de controlar mis poderes...";
    text[4737] = "Me volví loco... No podía controlar el poder que generaba.";
    text[4738] = "Entonces acudió la Fuerza Lunex... Tu madre lideraba el grupo que tenía que capturarme.";
    text[4739] = "Mientras trataba desesperadamente de mantener el control y conservar la cordura...";
    text[4740] = "Escuché su voz a través de todo el dolor. ";
    text[4741] = "De alguna manera sentí... la calidez de su alma. Sentí que su bondad me alcanzaba.";
    text[4742] = "Cuando desperté estaba de regreso en mi escondite.";
    text[4743] = "Ya no sentía ningún dolor. El súbito estallido de poder había desaparecido.";
    text[4744] = "Podría haberme entregado, pero no lo hizo.";
    text[4745] = "En vez de eso, decidió visitarme de vez en cuando para ver cómo estaba.";
    text[4746] = "Sabía que habría seguido sufriendo si me hubiera llevado a la Base Militar.";
    text[4747] = "En ese momento, Saros era el científico militar jefe.";
    text[4748] = "Insistía en que debían capturarme para poder estudiarme.";
    text[4749] = "No suele encontrarse a un chico con un poder inimaginable y aterrador todos los días.";
    text[4750] = "Pero ella desestimó todas las exigencias de Saros y decidió protegerme.";
    text[4751] = "Es curioso... Sentía que un poder extraño emanaba de ella.";
    text[4752] = "Un poder al que reaccionaba mi antimateria.";
    text[4753] = "Un poder que tú también parecías poseer...";
    text[4754] = "El poder para manipular la lux.";
    text[4755] = "¡...!";
    text[4756] = "¿Mi madre te digo algo de ese poder?";
    text[4757] = "... Creo que deberíamos movernos.";
    text[4758] = "¡Eh! ¡No me ignores! Por favor, necesito saberlo...";
    text[4759] = "... Quería preguntarte algo...";
    text[4760] = "¿Eres capaz de controlar el poder que posees?";
    text[4761] = "En realidad no... Va y viene.";
    text[4762] = "Si puedo descubrir cómo controlarlo, ¡tal vez sea capaz de comunicarme con los lóbregos!";
    text[4763] = "¡Podríamos conseguir la paz!";
    text[4764] = "Ya veo... Pero no creo que estés lista para conocer la verdad todavía.";
    text[4765] = "... y todavía no confío completamente en ti.";
    text[4766] = "Te diré lo que necesitas saber si logramos llegar a mi escondite.";
    text[4767] = "... De acuerdo.";
    text[4768] = "Pero solo para que quede claro...";
    text[4769] = "Estoy aquí porque dijiste que necesitabas mi ayuda...";
    text[4770] = "... y porque yo también necesito la tuya.";
    text[4771] = "Tengo que saber más sobre el poder de la lux...";
    text[4772] = "Sé que insistí mucho en descubrir dónde estaban tus antinúcleos...";
    text[4773] = "Pero ahora he cambiado de opinión. Veo que son muy valiosos para ti.";
    text[4774] = "Sea por el motivo que sea, no estoy aquí para arrebatarte tus antinúcleos.";
    text[4775] = "Solo quiero saber la verdad...";
    text[4776] = "Desconocer la verdad me impide hacer lo que más deseo en este mundo...";
    text[4777] = "... que es proteger a mi gente.";
    text[4778] = "... Proteger a aquellos a los que quiero.";
    text[4779] = "Encontraré otra manera de detener al cometa Coda. ¡No voy a rendirme!";
    text[4780] = "... ... ... ... ";
    text[4781] = "... Yo también quiero proteger a la gente de Luna.";
    text[4782] = "Me alegro de que tengamos un objetivo común.";
    text[4783] = "Salgamos de aquí antes de que aparezca la Fuerza Lunex.";
    text[5000] = "Espera, no te muevas. Hay una nave cerca de aquí.";
    text[5001] = "¡Parece que han soltado drones de búsqueda!";
    text[5002] = "Supongo que no hay suficientes soldados para rastrear a pie todo el norte de Luna.";
    text[5003] = "Todo irá bien mientras esos drones no nos detecten.";
    text[5004] = "Creo que la costa está despejada. Vámonos.";
    text[4968] = "¡...!";
    text[4969] = "¡He escuchado una voz!  Era muy débil, pero...";
    text[4970] = "Concéntrate. Concentra tus pensamientos.";
    text[4971] = "Trata de canalizar tu lux...";
    text[4972] = "Pero yo... No sé cómo hacerlo.";
    text[4973] = "Ya has sentido esto antes. Trata de revivir ese momento.";
    text[4974] = "Ese sentimiento de querer establecer una conexión...";
    text[4975] = "... de querer comunicarte con el corazón y el alma.";
    text[4976] = "Aférrate a ese sentimiento.";
    text[4977] = "Ayu... da...";
    text[4978] = "... Ha... ce... daño...";
    text[4979] = "Por... favor...";
    text[4980] = "¡He vuelto a escuchar la voz! Pero esta vez era mucho más clara.";
    text[4981] = "Está... pidiendo ayuda. Parece estar sufriendo.";
    text[4982] = "Detecto a un lóbrego cerca. Esa voz debe ser de él.";
    text[4960] = "Tenemos que encontrarlo...";
    text[4983] = "... y conseguir su antinúcleo.";
    text[4961] = "Esto... Somos fugitivos, ¿recuerdas?";
    text[4962] = "¡Sí, los drones podrían detectarnos!";
    text[4963] = "No importa. Esos drones no me preocupan.";
    text[4964] = "Si hay un lóbrego, debemos luchar contra él.";
    text[4984] = "Todavía no he recuperado toda mi fuerza...";
    text[4985] = "¿Puedes... ayudarme a luchar contra él?";
    text[4986] = "Pero... No me gusta matar lóbregos...";
    text[4987] = "Eh, a mí tampoco me gusta matarles, pero... ";
    text[4988] = "Los antinúcleos son la clave para poder hacer justicia.";
    text[4989] = "¿Justicia? ¿Qué es lo que te han hecho los lóbregos?";
    text[4990] = "No es por algo que los lóbregos me hicieran.";
    text[4991] = "El problema es más bien lo que yo he podido hacerles a ellos...";
    text[4992] = "Cielos, sí que eres obstinado. Si quieres que te ayude,";
    text[4993] = "tendrás que ser más sincero conmigo.";
    text[4994] = "(Aaay).";
    text[4995] = "Lo entenderás cuando te lo cuente todo.";
    text[4996] = "A veces la verdad puede ser una carga. Pero no lo olvides...";
    text[4997] = "No tienes que llevar esa carga tú solo, ¿sabes?";
    text[4998] = "... Lo sé.";
    text[4999] = "Ahora vamos a encontrar a ese lóbrego.";
    text[4846] = "... Eh, ¡hay algo allí!";
    text[4847] = "¿De verdad? Yo no veo nada.";
    text[4848] = "Tetra, activa tus sensores.";
    text[4849] = "¡Oh...! ¡Detecto una acumulación de partículas de antimateria!";
    text[4850] = "A veces olvido que las personas no pueden ver el mundo como yo lo veo.";
    text[4851] = "¿Qué quieres decir?";
    text[4852] = "Hay longitudes de onda en el espectro electromagnético que el ";
    text[4853] = "ojo humano no puede detectar.";
    text[4854] = "Gracias a mis poderes..., puedo ver tipos de luz e incluso antimateria que";
    text[4855] = "otros tal vez no puedan percibir.";
    text[4856] = "Vaya... ";
    text[4857] = "¡eso me parece muy guay!";
    text[4858] = "Supongo... que nunca lo vi de esa manera.";
    text[4859] = "Siempre ha supuesto una carga para mí... es algo que a veces sobrecargaba mis sentidos.";
    text[4860] = "Me llevó un tiempo acostumbrarme.";
    text[4861] = "Mmm... ¿Por eso llevas una máscara?";
    text[4862] = "He observado que tu máscara está hecha a partir de un casco espacial de la Fuerza Lunex.";
    text[4863] = "Esos cascos se diseñaron para ayudar a bloquear luz que pudiera ser dañina,";
    text[4864] = "con la idea de que no afectara a los ojos en el espacio.";
    text[4865] = "Sí, has dado en el clavo.";
    text[4866] = "¿Y por qué dibujaste un rostro aterrador en la máscara?";
    text[4867] = "... ¿Que por qué? No hay ningún motivo en particular.";
    text[4868] = "¿En serio? Mmmm...";
    text[4869] = "Es solo...";
    text[4870] = "... que pensaba que quedaba bien... tal vez porque era algo intimidante.";
    text[4871] = "Muy bien, basta de preguntas...";
    text[4872] = "Vamos a recoger lo que sea que haya en esa concentración de antimateria y sigamos nuestro camino...";
    text[5100] = "¡Auch!";
    text[5101] = "Bella, ¿estás bien? ¡Trata de tener más cuidado la próxima vez!";
    text[5102] = "Has perdido 1000 bytes en la explosión...";
    text[5045] = "Eh, primero tenemos que encontrar al lóbrego que hay cerca de aquí...";
    text[5046] = "Bella, ¡has olvidado coger el antinúcleo!";
    text[3528] = "Bella, ¡mira allí! ¿Qué es eso que hay a lo lejos?";
    text[3529] = "Es la antigua ciudad de Magnesia...";
    text[3530] = "... o más bien, solía serlo.";
    text[3531] = "Los registros indican que la destrucción de Magnesia fue";
    text[5107] = "obra de un único lóbrego extremadamente poderoso.";
    text[3540] = "...";
    text[3532] = "Lo vi en las noticias cuando era más joven, pero no recuerdo mucho del asunto.";
    text[3533] = "Es difícil saber qué ocurrió exactamente ese día.";
    text[3534] = "¿Y por qué?";
    text[3535] = "Apenas hubo supervivientes...";
    text[3536] = "Por aquel entonces, la Fuerza Lunex no estaba bien equipada para detener a los lóbregos...";
    text[3537] = "... ¿Así que me estás diciendo que esto podría haberle ocurrido a Copernicus";
    text[3538] = "si hubiéramos fallado en nuestra misión?";
    text[3539] = "Sí...";
    text[3540] = "...";
    text[3541] = "¿Bella...?";
    text[3542] = "Lo siento, solo estaba realizando una pequeña plegaria por la gente que falleció aquí.";
    text[3543] = "¡Esforcémonos al máximo para salvar todas las vidas que podamos!";
    text[3544] = "... ¿Tetra?";
    text[3545] = "¡Yo también he rezado! ¡Así se hace, Bella! Je.";
    text[5108] = "Oye, Nickle, ¿estás bien?";
    text[5109] = "Estás temblando...";
    text[5110] = "...";
    text[5111] = "Lo siento... Yo...";
    text[5112] = "Estoy bien... Sigamos adelante.";
    text[5113] = "Colonia Silica debería estar más adelante.";
    text[5114] = "(... ¿Qué le ha ocurrido?)";
    text[5115] = "(Parece como si hubiera visto un fantasma o algo así).";
    text[5116] = "(No estoy segura... Dejémosle a solas por ahora).";
    text[5117] = "Aaah, el clima es agradable y cálido en esta colonia.";
    text[5118] = "¿Es la primera vez que vienes a Colonia Silica?";
    text[5119] = "¡Sí! Eso es. ¡Me encanta el ambiente que hay aquí!";
    text[5120] = "¡Oh! ¡Veo un café!";
    text[5121] = "Cielos, tengo el pelo hecho un desastre.";
    text[5122] = "¡Deberíamos refrescarnos y hacer acopio de víveres mientras estamos aquí!";
    text[5123] = "Y nuestro amigo el Sr. Apestoso necesita una ducha.";
    text[5124] = "¿Pero qué...? ¿También tienes un sensor de olores integrado?";
    text[5125] = "¿No es una función algo inútil?";
    text[5126] = "¡Tú sí que eres inútil! Hum...";
    text[5155] = "Dejad de discutir. Creo que es hora de que descansemos un poco.";
    text[5156] = "30 minutos más tarde...";
    text[5127] = "Aaah, ¡no puedo comer más! ¡Ha sido una comida estupenda!";
    text[5128] = "Nickle, estoy sorprendida. Has conseguido superar mi récord de barritas de tarta de queso.";
    text[5129] = "Es muy fácil volverse adicto a esas cosas...";
    text[5130] = "Procuraré llevar unas cuantas como reserva por si acaso.";
    text[5131] = "Una para ahora, otra para después...";
    text[5132] = "... ¡y otra para más tarde! Je.";
    text[5133] = "Dime, Nickle, ¿qué te gusta hacer cuando no estás cazando lobregos?";
    text[5134] = "Puede que no lo parezca, pero soy un cazatesoros.";
    text[5135] = "Me gano la vida encontrando objetos y tesoros exóticos y vendiéndolos.";
    text[5136] = "Vaya, ¡eso mola un montón!";
    text[5137] = "¿Eso crees? Bueno, es un trabajo duro, pero tiene sus recompensas.";
    text[5138] = "Siento pasión por la exploración y la aventura desde que era un niño.";
    text[5139] = "Hay tanta historia de Luna oculta bajo su superficie...";
    text[5140] = "Me encantaría explorar toda Luna algún día...";
    text[5141] = "... y tal vez encontrar algún tesoro realmente raro.";
    text[5142] = "Pero ahora mismo... ";
    text[5143] = "Tengo otros asuntos que atender. Mis sueños pueden esperar.";
    text[5144] = "... si podemos detener al cometa Coda y solucionar este embrollo...";
    text[5145] = "... cuando todo esto haya terminado...";
    text[5146] = "Tal vez... podríamos ir a buscar tesoros juntos.";
    text[5147] = "Tú también puedes venir, Tetra.";
    text[5148] = "¡VAYA, EN SERIO! ¡Me encantaría!";
    text[5149] = "¡A MÍ TAMBIÉN¡ ¡A MÍ TAMBIÉN! No encontrarás una mejor ayudante para buscar tesoros ahí fuera, je.";
    text[5150] = "Supongo que no eres tan malo como pensaba.";
    text[5151] = "Nah, pero todavía voy a humillarte, solo por lo divertido que es. ¡Ja, ja, ja!";
    text[5152] = "¿Ah, sí? Acepto el desafío";
    text[5154] = "¡Seré yo el que te humille!";
    text[5017] = "Lamento interrumpir este tierno momento en el que fortalecéis vuestros lazos, ¿pero falta mucho para tu escondite?";
    text[5153] = "Buena pregunta...";
    text[5005] = "Yo, eeeh...";
    text[5006] = "Os he dicho una mentira.";
    text[5007] = "¿Cómo? ¿Qué mentira?";
    text[5008] = "Mi escondite en realidad no está aquí, en Silica.";
    text[5009] = "¡¿En serio?! ¡¿Entonces por qué estamos aquí?!";
    text[5010] = "¡Hemos perdido un tiempo precioso!";
    text[5011] = "Lo siento... Al principio no sabía si podía confiar en vosotras.";
    text[5012] = "Si tu escondite no está aquí, ¿dónde está?";
    text[5013] = "En Oceanus.";
    text[5014] = "No puede ser. Seguro que estás mintiendo de nuevo.";
    text[5015] = "¡No, esta vez es verdad! ¡Lo juro!";
    text[5016] = "(¿Por qué demonios da tanto miedo cuando se enfada?)";
    text[5021] = "He explorado Oceanus en numerosas ocasiones.";
    text[5022] = "No puede decirse que la playa sea el mejor lugar para un escondite.";
    text[5023] = "La entrada es un poco... peculiar. Ya veréis.";
    text[5024] = "De todas maneras, no hemos venido aquí por nada.";
    text[5025] = "Suelo venir a Colonia Silica a menudo para conseguir suministros y artículos esenciales.";
    text[5026] = "La Fuerza Lunex no tiene muchos efectivos en el norte";
    text[5027] = "si se compara con el resto de Luna, así que es más fácil moverse.";
    text[5028] = "Tengo un amigo aquí llamado Cypher que puede ayudarnos a conseguir una nave espacial.";
    text[5029] = "¿Cypher, el mercader de astrotecnos? Recuerdo hablar con él en Regolithia.";
    text[5030] = "Un momento, ¿tienes AMIGOS?";
    text[5031] = "Buf, te has pasado un poco, Tetra.";
    text[5032] = "¿Cómo? No, acabo de humillarle. ¡Tetra: 1, Nickle: 0!";
    text[5033] = "Sigue así y serás borrado de la lista de candidatos a novio.";
    text[5034] = "D-d-de la... ¿Tienes una lista?";
    text[5035] = "Eh, no me mires así. ¡Yo no le pedí que hiciera una!";
    text[5036] = "Sinceramente, me sorprende que no haya tratado de escapar todavía.";
    text[5037] = "Tal vez Bella esté en su lista de candidatas a novia...";
    text[5038] = "... o puede que sea peor, ¡tal vez trate de reemplazarme como ayudante definitiva de Bella!";
    text[5039] = "¡¿Ayudante?! Oh, ja, ja.";
    text[5040] = "No pienso quitarte el ojo de encima, chico.";
    text[5041] = "Bueno, vale... ¡Vosotros dos podéis discutir todo lo que queráis! Voy a buscar a Cypher.";
    text[5042] = "¡Hum!";
    text[5043] = "¡Hum!";
    text[5056] = "Hola, Cypher.";
    text[5057] = "¡¿Pero qué...?! Colega, ¡pensaba que te habían encerrado!";
    text[5058] = "Y lo estaba. Pero estas dos me ayudaron a escapar.";
    text[5059] = "¡Es estupendo verte de nuevo, Cypher!";
    text[5060] = "Ah, hola. ¡Eres esa chica que conocí en Regolithia!";
    text[5061] = "Bien, ¿cómo puedo ayudaros?";
    text[5062] = "¿Podrías prestarnos una nave?";
    text[5063] = "¡Por supuesto!";
    text[5064] = "Dejadme ver si tengo alguna nave por ahí detrás.";
    text[5065] = "Gracias, Cypher.";
    text[5066] = "¿Cypher sabe que eres el Matalóbregos?";
    text[5067] = "Solo lo saben unas pocas personas. Nos conocemos desde hace mucho.";
    text[5068] = "Una vez le salvé de un lóbrego que lo quería devorar.";
    text[5069] = "Vale... Tengo malas noticias, chicos. Ya he vendido la última nave en condiciones que tenía...";
    text[5070] = "Solo me queda una vieja minicápsula.";
    text[5071] = "¿Está totalmente cargada?";
    text[5072] = "¡Sí!";
    text[5073] = "Entonces nos la llevamos.";
    text[5074] = "Os la podéis quedar. Estoy en deuda contigo. A fin de cuentas, me salvaste la vida.";
    text[5075] = "Muchas gracias, Cypher.";
    text[5077] = "Tened cuidado ahí fuera.";
    text[5078] = "Antes he visto a un grupo de drones de búsqueda y de naves lunex sobrevolando la colonia.";
    text[5079] = "¡Gracias por al aviso! Deberíamos irnos de inmediato.";
    text[5080] = "¡Destino: Oceanus! ¡Vayamos al astropuerto más cercano y despeguemos!";
    text[5081] = "Ah, diablos, ¡nos persiguen dos naves lunex!";
    text[5082] = "Bella, ¡han activado sus destructores fotónicos!";
    text[5083] = "¡Matalóbregos! ¡Bella Gray!";
    text[5084] = "¡Entregaos ahora o ABRIREMOS FUEGO!";
    text[5085] = "Tch... Ve más rápido, no podemos permitir que nos den alcance.";
    text[5086] = "Eeh, Bella, creo que vamos en la dirección equivocada.";
    text[5087] = "Lo sé. No podemos dejar que vean que nos dirigimos a Oceanus, así que...";
    text[5088] = "¡Tendremos que dejar que nos persigan un poco hasta que los despistemos!";
    text[5089] = "¡Abrochaos los cinturones! Esta vez iremos a turbovelocidad, je.";
    text[5090] = "¡Parece que les hemos perdido! ¡Pilotas de miedo, Bella!";
    text[5091] = "Je, gracias.";
    text[5092] = "Oh, ja, ja. Gracias por el sarcasmo.";
    text[5093] = "Muy bien, siguiente parada: ¡Oceanus!";
    text[5095] = "Hemos recibido algunos daños importantes... Pero parece que les hemos perdido.";
    text[5096] = "Así se pilota.";
    text[5097] = "Muy bien, estamos en Oceanus.";
    text[5098] = "Bien, ¿dónde está tu escondite?";
    text[5103] = "En el arrecife Armonía.";
    text[5104] = "Tenemos que ir al este.";
    text[5105] = "Muy bien, ¡vamos allá!";
    text[5106] = ".@P.@P.";
    text[5157] = "(Algo no acaba de encajar...).";
    text[5158] = ".@P.@P.";
    text[5159] = ".@P.@P.";
    text[5160] = "(Mmm...)";
    text[5161] = "(Será mejor que me mantenga alerta, por si acaso).";
    text[5162] = "(Si esto va bien...)";
    text[5163] = "(... Todavía hay esperanza).";
    text[5164] = "(Tal vez pueda salvarlos...).";
    text[5165] = "Eh, Nickle, ¿vienes?";
    text[5166] = "Sí, culpa mía.";
    text[5167] = "Solo estaba comprobando que nadie nos siguiera.";
    text[5168] = "Sigamos adelante.";
    text[5180] = "Hemos llegado.";
    text[5181] = "¿Cómo? No veo ninguna entrada...";
    text[5182] = "Como dije antes, la entrada es algo peculiar.";
    text[5183] = "Hay una cueva en la parte inferior de este arrecife.";
    text[5184] = "Tendremos que sumergirnos bajo el agua para llegar a ella.";
    text[5185] = "¡¿En serio?! ¡Nos vamos a poner chorreando!";
    text[5186] = "Bella, ¿seguro que puedo sumergirme bajo el agua?";
    text[5187] = "¡Sí! No te preocupes. Eres sumergible, ¿recuerdas?";
    text[5188] = "Vale, solo quería asegurarme, je, je, je...";
    text[5189] = "He de admitir que es un escondite muy inteligente.";
    text[5190] = "No es raro que la Fuerza Lunex no haya podido encontrarte.";
    text[5191] = "En esta cueva...";
    text[5192] = "... se encuentra la verdad.";
    text[5193] = "Necesito descubrirla...";
    text[5194] = "¿Puedo confiar en vosotras dos?";
    text[5195] = "¡Por supuesto! Nosotras también confiamos en ti.";
    text[5196] = "Eres nuestro amigo, Nickle. ¡Estamos en esto juntos!";
    text[5197] = "¡Sí! Ahora somos un equipo, je, je.";
    text[5198] = "Muy bien, vamos allá.";
    text[5199] = "Me temo que no iréis a ninguna parte.";
    text[5200] = "¡ACTIVANDO CAMPO DE PLASMA!";
    text[5201] = "¡¿Alguien nos ha estado siguiendo...?!";
    text[5202] = "¡Es una emboscada!";
    text[5203] = "¡Raine! ¡Melody! ¡Zara!";
    text[5204] = "¡Parece que nuestra guerrera prodigio siempre ha sido una traidora!";
    text[5205] = "No puedo creer que nos hayas traicionado, Bella...";
    text[5206] = "¿Cómo?... ¡No!";
    text[5207] = "Escuchadme, chicas, sé que todo esto tiene mala pinta...";
    text[5208] = "... ¡pero puedo explicarlo!";
    text[5209] = "Lo siento, Bella, pero ahora eres una criminal buscada.";
    text[5210] = "Coopera con nosotras o no tendremos más remedio que usar la fuerza.";
    text[5211] = "Chicas...";
    text[5212] = "Cuando recibimos el informe de misión te buscamos por todas partes.";
    text[5213] = "Sabíamos que si alguien podía capturarte... ";
    text[5214] = "¡ese alguien seríamos nosotras! ¡EL ESCUADRÓN RAINE!";
    text[5215] = "¡AHORA LEVANTA ESOS PUÑOS!";
    text[5216] = "Espera Raine, tal vez deberíamos...";
    text[5217] = "NO.";
    text[5218] = "LUCHAREMOS.";
    text[5219] = "Tengo una cuenta pendiente con Bella. ¡Todavía me debe la revancha!";
    text[5220] = "... ¡y tú también caerás, Matalóbregos!";
    text[5221] = "Al menos esta vez no te ocultas tras esa estúpida máscara.";
    text[5222] = "Tch. Estas chicas son realmente molestas.";
    text[5223] = "¿Puedo contar con tu apoyo, Bella?";
    text[5224] = "Pero... ¡No quiero luchar contra ellas! ¡Son mis amigas!";
    text[5225] = "Ya no lo son. Han escogido su bando.";
    text[5226] = "¡Basta de charla! No podéis escapar.";
    text[5227] = "...";
    text[5228] = "Muy bien. Veo cuál es la situación.";
    text[5229] = "Si creéis que podéis vencernos, estáis muy EQUIVOCADAS.";
    text[5230] = "Voy a tener que darte OTRA paliza, Raine.";
    text[5231] = "¡OH, jo, jo, jo! ¡La traidora parece muy segura de sí misma!";
    text[5232] = "ACEPTO EL DESAFÍO.";
    text[5233] = "Eeeeh, chicas, ¿os importa si no participo en esto?";
    text[5234] = "No quiero hacer daño a nadie.";
    text[5235] = "Muy bien, ¡no te metas! ¡Deja que luchen los auténticos héroes!";
    text[5236] = "De todas formas, eres una ayudante TERRIBLE.";
    text[5237] = ".@P.@P.";
    text[5238] = "¡MIENTES! ¡MÁS VALE QUE RETIRES ESO! ¡GRRR!";
    text[5239] = "BELLA, ¡VAMOS A MACHACARLAS!";
    text[5240] = "Somos el escuadrón de guerreras más poderoso de toda Luna.";
    text[5241] = "¡No tenéis nada que hacer!";
    text[5242] = "¡Vamos ESCUADRÓN RAINE!";
    text[5243] = "Maldita sea... ¡Qué diablos ha pasado, chicas! ¡Hemos perdido!";
    text[5244] = "Aaay...";
    text[5245] = "Mmmm...";
    text[5246] = "¿Ya habéis tenido suficiente?";
    text[5247] = "Creo que ya es suficiente teatro por un día, ¿no os parece?";
    text[5248] = "¿Qu-qué? ¿Estás de broma? ¡Aquí nadie estaba actuando!";
    text[5249] = "Melody, dudabas cada vez que atacabas.";
    text[5250] = "Zara, estaba claro que tenías la cabeza en otro sitio...";
    text[5251] = "Es como si hubieras estado pensando en otra cosa en medio del combate.";
    text[5252] = "... y Raine... estaba claro que no golpeabas con todas tus fuerzas.";
    text[5253] = "¡Eh! ¡Tú tampoco golpeabas con todas tus fuerzas!";
    text[5254] = "¿Cómo? ¿Eso hacías? Yo iba a por todas.";
    text[5255] = "¡Yo también! ¡Pero porque Raine es muy mala!";
    text[5256] = "¡Vale, vale, de acuerdo!";
    text[5257] = "Está bien, tienes razón. Estábamos fingiendo...";
    text[5258] = "¿En serio?";
    text[5259] = "(Aaay...)";
    text[5260] = "Está claro que Raine utilizaría esta situación como excusa para luchar conmigo...";
    text[5261] = "... ¿pero tú, Melody?";
    text[5262] = "Raine nos obligó a seguir su plan y pretender que éramos enemigas...";
    text[5263] = "... ¿Y tú, Zara?";
    text[5264] = "... Necesitaba una oponente digna con la que probar un nuevo ataque que había inventado...";
    text[5265] = "Gracias a nuestro combate, ahora tengo muchas más ideas.";
    text[5266] = "Matalóbregos... Tienes algunos ataques realmente buenos.";
    text[5267] = "Eh... Gracias, supongo.";
    text[5268] = "¡Un momento, esperad un minuto!";
    text[5269] = "¿Así que no estáis aquí para capturarnos?";
    text[5270] = "No. Puede que seamos rivales, pero estábamos preocupadas por ti, Bella.";
    text[5271] = "No harías algo así si no fuera por un buen motivo...";
    text[5272] = "Sea cual sea ese motivo, estamos aquí para ayudarte. Las buenas amigas se apoyan entre sí.";
    text[5273] = "Oooh, chicas...";
    text[5281] = "Siento haber dicho esas cosas tan malas sobre ti, Tetra...";
    text[5282] = "Solo quería que te enfadaras para que nuestro combate fuera más emocionante, ¡MUAH, JA, JA ,JA!";
    text[5283] = "Hum. Disculpa aceptada.";
    text[5274] = "Eh, Matalóbregos...";
    text[5301] = "¿Cuál es tu papel en todo esto?";
    text[5302] = "¿Eres un buen tipo, o le estás tomando el pelo a Bella?";
    text[5303] = "Voy a vigilarte como si fuera un halcón, amiguito.";
    text[5278] = "Raine, ¡tienes que ser más agradable!";
    text[5279] = "¡Soy Melody! ¡Cualquier amigo de Bella es amigo mío!";
    text[5280] = "Soy Zara. Es un placer conocerte.";
    text[5284] = "Hum... Me llamo Raine. No lo olvides.";
    text[5275] = ".@P.@P. .@P.@P. .@P.@P.";
    text[5276] = "No pasa nada. Podemos confiar en ellas, están de nuestro lado.";
    text[5277] = "Sé que estos últimos años han sido muy difíciles para ti...";
    text[5304] = "... pero ya no estás solo.";
    text[5305] = "Tienes que empezar a confiar en la gente de nuevo...";
    text[5285] = ".@P.@P. .@P.@P. .@P.@P.";
    text[5286] = "(Aaay...)";
    text[5287] = "Me llamo Nickle.";
    text[5288] = "Escuchad... Si estoy aquí ahora es solo por Bella y Tetra.";
    text[5306] = "Bella arriesgó su carrera y se puso en peligro para ayudarme...";
    text[5307] = "... Pera descubrir la verdad.";
    text[5308] = "Sinceramente, me parece una locura. Casi no sabe nada de mí.";
    text[5309] = "Y traté de alejarla cada vez que intentó contactar conmigo.";
    text[5310] = "A pesar de todo... ha insistido en ayudarme.";
    text[5311] = "... me ha aceptado, sin importarle quién era o qué había hecho...";
    text[5312] = "Es algo que respeto.";
    text[5313] = "¡...!";
    text[5314] = "Ni siquiera le he dicho el motivo por el que acumulo antinúcleos...";
    text[5315] = "... o por qué desprecio tanto a la Fuerza Lunex.";
    text[5316] = "... ¿y aun así le has seguido a ciegas?";
    text[5317] = "Bella, ¿cómo estabas tan segura de que no te engañaría o acabaría huyendo?";
    text[5318] = "...";
    text[5319] = "Confianza.";
    text[5320] = "Todo el mundo tiene un lado oscuro... Cosas de las que tal vez no se puede estar muy orgulloso...";
    text[5321] = "... pero me gusta ver la parte buena de las personas.";
    text[5322] = "Todo el mundo merece ser escuchado.";
    text[5323] = "Si vamos a salvar a la gente de Luna del cometa Coda...";
    text[5324] = "... o incluso de los lóbregos...";
    text[5325] = "Deberíamos colaborar para encontrar la mejor solución posible.";
    text[5326] = "Te ha llevado demasiado tiempo darte cuenta de eso..., ¿verdad, Sr. Obstinado?";
    text[5327] = "V-verdad...";
    text[5328] = "Lo explicaré todo cuando lleguemos a mi escondite.";
    text[5329] = "No podemos permitir que nadie más nos encuentre.";
    text[5330] = "¡Muy bien, pandilla! ¡Adelante!";
    text[5354] = "¿En qué estás pensando?";
    text[5355] = "Solo... pensaba en el futuro.";
    text[5356] = "No nos queda mucho tiempo.";
    text[5357] = "¿Cómo han ido las últimas pruebas?";
    text[5358] = "Las pruebas han fallado...";
    text[5359] = "... pero, al menos, los resultados son mejores que en las pruebas anteriores.";
    text[5360] = "¿Tasa de resonancia?";
    text[5361] = "Resonancia del 90%.";
    text[5362] = "... ¿No crees que es suficiente? Debería...";
    text[5363] = "Yo no me arriesgaría, Saros.";
    text[5364] = "Tenemos que conseguir que sea seguro al 100%...";
    text[5365] = "Sigamos intentándolo. No podemos darnos por vencidos.";
    text[5366] = "¡SAROS!";
    text[5367] = "Ah, Thomas, te estábamos esperando.";
    text[5368] = "¿Dónde está Bella? ¡Dime dónde está!";
    text[5369] = "Tranquilízate, Thomas.";
    text[5370] = "¡Pensaba que teníamos un trato! ¡Dijiste que no harías daño a Bella!";
    text[5371] = "¡Esto es indignante! ¡Tienes cientos de soldados ahí fuera buscándola!";
    text[5372] = "Thomas, todos está yendo según el plan.";
    text[5373] = "Bella es fuerte. Puede enfrentarse a cualquier soldado o receptáculo que envíe contra ella.";
    text[5374] = "Y ahora que trabaja con el Matalóbregos, ambos constituyen una fuerza a tener muy en cuenta.";
    text[5375] = "Tenía que hacer esto. Digamos que tenía que hacer que todo fuera...";
    text[5376] = "... convincente.";
    text[5377] = "No te preocupes...";
    text[5378] = "Conseguiremos lo que necesitamos, es inevitable.";
    text[5379] = "Sé que harías cualquier cosa con tal de proteger a tu familia, Thomas.";
    text[5380] = "Por favor, no le hagas daño a Bella...";
    text[5381] = "Cuando esta misión tenga éxito, eliminaremos los cargos contra Bella.";
    text[5382] = "Te prometo que no le pasará nada.";
    text[5383] = "De hecho, ya que estás aquí, ven conmigo.";
    text[5384] = "Creo que es hora de que veas en lo que he estado trabajando.";
    text[5385] = "¡Vaya! ¿Qué es este lugar?";
    text[5386] = "¡Todo es azul!";
    text[5387] = "¡Es tan bonito!";
    text[5388] = "Descubrí estas ruinas hace varios años, cuando estaba realizando una expedición en solitario.";
    text[5389] = "¿¡Una expedición!? ¡¿Este tipo es un cazatesoros?!";
    text[5390] = "¡Sí! ¡Yo también me sorprendí cuando nos lo dijo!";
    text[5391] = "Pensaba que ya habíamos encontrado todas las ruinas que los Antiguos tenían en Luna...";
    text[5392] = "No. No me cabe duda de que hay más reliquias y ruinas que la humanidad todavía no ha descubierto.";
    text[5393] = "Hubo un tiempo en el estas ruinas estuvieron habitadas por una antigua civilización,";
    text[5394] = "los Antiguos.";
    text[5395] = "Eran conocidos por su capacidad para manipular la lux y la antimateria,";
    text[5396] = "y prosperaron antes de que la humanidad se estableciera en Luna,";
    text[5397] = "hace miles de años.";
    text[5398] = "Si eran tan avanzados, ¿dónde están ahora?";
    text[5399] = "Bueno, eso es lo que los arqueólogos todavía están tratando de descubrir.";
    text[5400] = "Vamos, sigamos adelante.";
    text[5401] = "LUMIKNIGHT ACTIVADO. ALMA BIOGENÉTICA ANTIGUA DETECTADA.";
    text[5402] = "LECTURAS DE LUX ANORMALES. ESPERANDO MENSAJE DE GUARDIOS.";
    text[5403] = "Nickle, ¡¿Qué demonios ha sido eso?!";
    text[5404] = "Diablos...";
    text[5405] = "Es posible que hayamos activado un sistema de seguridad o algo parecido.";
    text[5406] = "MENSAJE DE GUARDIOS RECIBIDO. INICIANDO PRUEBA DEL ALMA.";
    text[5407] = "¿Prueba del alma? ¿Van a ponernos a prueba?";
    text[5408] = "Este sitio pudo haber sido un lugar de entrenamiento para los soldados de los Antiguos.";
    text[5409] = "Pensaba que ya no funcionaba.";
    text[5410] = "He estado aquí muchas veces y el sistema de seguridad nunca se activó.";
    text[5411] = "Sea como fuere, ¡dejemos desactivarlo!";
    text[5413] = "Buf, esa cosa era resistente...";
    text[5414] = "¿Qué crees que activó el sistema de seguridad?";
    text[5415] = "Más bien... QUIÉN activó el sistema de seguridad.";
    text[5416] = "Creo que nuestra guerrera prodigio podría tener algún de vínculo con los Antiguos.";
    text[5417] = "¡Eh! ¡Deja de llamarme así! ¡Tú también no!";
    text[5418] = "¡MUA, JA, JA, JA! ¡Aprende muy rápido!";
    text[5419] = "Espera, ¿entonces crees que Bella podría...";
    text[5420] = "... descender de los Antiguos?";
    text[5421] = "Es posible...";
    text[5422] = "Mmm... Esto podría explicar mi capacidad para manipular la lux...";
    text[5423] = "... y las extrañas sensaciones que he estado experimentando.";
    text[5489] = "Si desciendo de los Antiguos...";
    text[5490] = "Mamá también debía tener rasgos genéticos de ellos.";
    text[5491] = "¿Por qué guardaría algo así en secreto...?";
    text[5424] = "Necesito conseguir más información sobre los Antiguos.";
    text[5425] = "Puedes examinar cualquier estatua o texto antiguo que encuentres en las ruinas.";
    text[5426] = "Descubrí todo lo que sé sobre los Antiguos gracias a las reliquias que dejaron tras ellos.";
    text[5427] = "Genial... Una puerta gigante nos bloquea el paso.";
    text[5428] = "¡Hay algo grabado en la puerta!";
    text[5429] = "LAS CUATRO GEMAS ABRIRÁN EL CAMINO PARA EL PERCIBEALMAS";
    text[5430] = "Así que nuestro objetivo es encontrar CUATRO GEMAS para abrir esta puerta.";
    text[5431] = "Pareced que tendremos que completar la PRUEBA DEL ALMA, nos guste o no.";
    text[5492] = "Eso me recuerda... El soldado dijo un nombre cuando habló...";
    text[5493] = "Creo que era... ¿Guardios?";
    text[5494] = "Si los soldados tienen algún tipo de líder en estas ruinas,";
    text[5495] = "me gustaría hablar con él.";
    text[5496] = "Es posible que así podamos conseguir más información sobre mi capacidad para manipular la lux.";
    text[5497] = "Está bien.";
    text[5498] = "Lo siento. Supongo que me estoy volviendo algo impaciente, eso es todo.";
    text[5499] = "¿Qué? ¿Por que me miras así?";
    text[5500] = "No es nada, Je. ¡Vamos a buscar esas CUATRO GEMAS!";
    text[5530] = "Hay un foso en este nivel que lleva a las profundidades de las ruinas.";
    text[5531] = "Podremos encontrar las GEMAS en los niveles inferiores.";
    text[5532] = "Pero debes asegurarte de estar bien preparada antes de bajar...";
    text[5533] = "... Es posible que tardemos bastante en volver.";
    text[5442] = "¡LO HAS HECHO BIEN, PERCIBEALMAS!";
    text[5443] = "¡Vaya, este tipo es ENORME!";
    text[5444] = "¿Quién eres?";
    text[5445] = "SOY GUARDIOS.";
    text[5446] = "UNA ENTIDAD PROGRAMADA PARA PROTEGER ESTAS RUINAS.";
    text[5447] = "Guardios, ¿puedes contarnos algo más de los Antiguos, la gente que vivía aquí?";
    text[5448] = "¿Qué les ocurrió?";
    text[5449] = "NO PUEDO PROCESAR ESA PREGUNTA. NO POSEO ESA INFORMACIÓN.";
    text[5601] = "ERES... BELLA GREY.";
    text[5602] = "¿C-cómo? ¿Sabes cómo me llamo?";
    text[5603] = "MI PROCESADOR PUEDE EXTRAER INFORMACIÓN A TRAVÉS DE TU LUX.";
    text[5604] = "HE PODIDO DETERMINAR... QUE NO ERES UNA AMENAZA.";
    text[5605] = "Buf, menos mal. Pensaba que íbamos a luchar contra este tipo.";
    text[5606] = "¡PERO...!";
    text[5627] = "¡Iiiiih!";
    text[5607] = "TU NIVEL DE LUX ES... ANORMAL.";
    text[5608] = "¿Anormal? ¿Qué quieres decir?";
    text[5609] = "ES MAYOR QUE CUALQUIER OTRA CONCENTRACIÓN DE LUX DE MI BASE DE DATOS.";
    text[5610] = "ADEMÁS, TAMBIÉN POSEE UN ESTADO INUSUAL.";
    text[5611] = "EN ESTE MOMENTO, TU CAPACIDAD PARA MANIPULAR LA LUX ESTÁ BLOQUEADA.";
    text[5612] = "TU CAPACIDAD PARA PERCIBIR ALMAS HA SIDO ALTERADA.";
    text[5613] = "Guardios, ¿sabes cómo puedo usar mi habilidad?";
    text[5614] = "...¡Por favor, enséñame a percibir almas!";
    text[5628] = "LLEGO SIGLOS SIN ESTAR OPERATIVO.";
    text[5629] = "MIS RESERVAS DE ENERGÍA SE AGOTAN...";
    text[5630] = "NO SERÉ CAPAZ DE ENTRENARTE COMO ES DEBIDO... AUN ASÍ...";
    text[5616] = "SOY CAPAZ DE DESPERTAR TU CAPACIDAD PARA PERCIBIR ALMAS.";
    text[5617] = "PERO TENDRÁS QUE SER TÚ... LA QUE DEBERÁ PULIR TUS HABILIDADES.";
    text[5618] = "EL PODER DE LA LUX... LA MANIFESTACIÓN FÍSICA DEL ALMA.";
    text[5619] = "CUANDO SE DESPIERTA, NO ES UN PODER QUE SE PUEDA DOMINAR FÁCILMENTE.";
    text[5620] = "Puedo hacerlo... ¡Sé que puedo hacerlo!";
    text[5621] = "Haré todo lo que sea necesario para proteger a la gente de Luna.";
    text[5622] = "Quiero ser fuerte... Que todos confíen en mí...";
    text[5623] = "Quiero inspirar a las personas... y ser capaz de darles esperanza.";
    text[5624] = "TIENES UN ESPÍRITU INQUEBRANTABLE.";
    text[5625] = "SIN EMBARGO, TANTO EL CUERPO COMO LA MENTE DEBEN SER FUERTES.";
    text[5626] = "PRIMERO DEBO EVALUAR TU FUERZA.";
    text[5631] = "ESTE ES EL ÚLTIMO PASO DE LA PRUEBA DEL ALMA.";
    text[5632] = "¡MODO DE BATALLA DE GUARDIOS ACTIVADO!";
    text[5461] = "HAS SUPERADO LA PRUEBA DEL ALMA.";
    text[5462] = "ROMPERÉ LAS CADENAS QUE BLOQUEAN TU CAPACIDAD PARA PERCIBIR ALMAS.";
    text[5463] = "MIS RESERVAS DE ENERGÍA ESTÁN CASI AGOTADAS... HASTA LA VISTA, PERCIBEALMAS... ";
    text[5464] = "QUE TU LUX... BRILLE...";
    text[5465] = "... PARA SIEMPRE.";
    text[5466] = "¿Estás bien, Bella? ¿Ha funcionado?";
    text[5467] = "Siento... que un poder crece en mi interior.";
    text[5468] = "¡Es increíble!";
    text[5480] = "¡Las habilidades de lux latentes de Bella han sido desbloqueadas!";
    text[5481] = "Ahora puedes usar el combo lux predeterminado: ¡SOBRECARGA DE LUX!";
    text[5634] = "Es difícil comprender lo que acabamos de presenciar.";
    text[5652] = "Sí. La civilización de los Antiguos, los percibealmas, el lux... ¡Mi cerebro no puede más!";
    text[5635] = "Me pregunto si la capacidad para percibir almas puede ser útil en el combate...";
    text[5636] = "¡Tendremos que practicar para confirmarlo! ¡JUA, JA, JA, JA!";
    text[5637] = "Ya que hablamos de esa habilidad, ¿qué piensas hacer con ella?";
    text[5638] = "Bueno, espero poder comunicarme con los lóbregos y lograr la paz.";
    text[5639] = "Un momento, ¡¿en serio?!";
    text[5640] = "Veo que no te gusta nada luchar contra esos lóbregos, ¿eh?";
    text[5642] = "Chicas, siempre lo habéis sabido...";
    text[5643] = "Sí, pero...";
    text[5644] = "Es difícil dejar de lado el hecho de que estos monstruos";
    text[5645] = "han matado gente inocente, ¿sabes?";
    text[5646] = "Lo sé...";
    text[5647] = "Bella está en lo cierto.";
    text[5648] = "Los lóbregos no son solo monstruos.";
    text[5649] = "Son... mucho más que eso.";
    text[5650] = "Entonces vayamos a la última sala.";
    text[5651] = "Todo tendrá sentido cuando lo veáis con vuestros propios ojos...";
    text[5673] = "Aquí...";
    text[5674] = "... aquí guardo todos los antinúcleos que he recogido.";
    text[5675] = "¡Hay tantos!";
    text[5676] = "¿Cuántos antinúcleos has acumulado con el paso de los años?";
    text[5677] = "No lo sé. Cientos, tal vez miles.";
    text[5678] = "¿Bella no te ha hablado del regreso del cometa Coda?";
    text[5679] = "Sí, lo ha hecho. También sé que la Fuerza Lunex quiere usar";
    text[5680] = "Celestia, la máquina de agujeros de gusano, para detenerlo.";
    text[5681] = "... ¿Y a pesar de saber que la humanidad está en peligro, te niegas";
    text[5682] = "permitir que usemos estos antinúcleos para activar lo único que podría salvarnos?";
    text[5683] = "Es lo que yo pensaba cuando luchamos en Copernicus...";
    text[5747] = "Una vez dijiste que tu objetivo era hacer justicia...";
    text[5794] = "Sigo sin entender qué querías decir con ello...";
    text[5795] = "Nickle...";
    text[5796] = "Has estado cargando con una pesada carga...";
    text[5746] = "... y sé que has pagado un alto precio por ello.";
    text[5748] = "Quiero ayudarte. Es lo que hacen los amigos.";
    text[5749] = "¡Nosotras también queremos ayudarte! ¿Verdad, señoritas?";
    text[5797] = "¡Sí!";
    text[5798] = "¡Por supuesto!";
    text[5750] = "¡Yo también, yo también!";
    text[5686] = "Nickle, creo que es hora de que nos cuentes la verdad.";
    text[5745] = "¿Qué está pasando aquí?";
    text[5687] = "Dejad que os pregunte algo: ¿Qué es un antinúcleo?";
    text[5688] = "Bueno, son una fuente estable de antimateria, ¿verdad?";
    text[5689] = "Eso es solo parte de la respuesta.";
    text[5690] = "Un antinúcleo está compuesto tanto de antimateria como de lux. En su interior hay...";
    text[5691] = "... un alma.";
    text[5692] = "Si es así... ¡Eso me da una idea!";
    text[5695] = "¡El antinúcleo está brillando!";
    text[5696] = "Qué dem... ¿Cómo has hecho eso, Bella?";
    text[5697] = "La percepción de almas... Estoy empezando a comprender cómo usarla...";
    text[5698] = "Imaginé ser capaz de ver el alma que contiene.";
    text[5699] = "Ser capaz de hablar con ella.";
    text[5700] = "¿Escuchas algo?";
    text[5701] = "No, todos estos antinúcleos guardan silencio.";
    text[5702] = "Pero, por muy extraño que parezca...";
    text[5703] = "Puedo sentir las emociones que contienen sus almas...";
    text[5704] = "Dolor... Sufrimiento... Ira... Desconfianza... Tristeza... Pena...";
    text[5705] = "Las almas de los lóbregos que hay dentro de los antinúcleos están atrapadas...";
    text[5799] = "No sé si esto va a funcionar, pero... dejad que intente algo...";
    text[5706] = "No...";
    text[5708] = "No... No... Esto no puede ser...";
    text[5710] = "El alma que hay dentro...";
    text[5709] = "... parecía...";
    text[5712] = "Lo que has visto... es la verdad.";
    text[5713] = "Los lóbregos fueron humanos en el pasado.";
    text[5715] = "¡...!";
    text[5711] = "¿QUÉ?... ¿PERO CÓMO...?";
    text[5716] = "Oh, no...";
    text[5717] = "Así que los lóbregos que hemos estado cazando, con los que hemos luchado, siempre han sido humanos...";
    text[5718] = "Los lóbregos son el resultado de experimentos con humanos.";
    text[5719] = "¿Por parte de quién? ¿Quién realizó esos experimentos?";
    text[5720] = "Ese al que llamáis el héroe legendario de Luna: Saros.";
    text[5721] = "Esto... ¡Esto es una LOCURA!";
    text[5722] = "¡Son vidas de humanos inocentes!";
    text[5723] = "¿Por qué haría algo tan horrible?";
    text[5724] = "Saros cree que la antimateria es la clave de la supervivencia de la humanidad.";
    text[5725] = "A ojos del público, es el líder del pueblo. El «héroe legendario».";
    text[5726] = "Pero detrás de esa heroica fachada...";
    text[5728] = "Saros es un científico desquiciado, obsesionado con controlar el poder de la antimateria.";
    text[5800] = "Desde que descubrió la existencia de mis poderes...";
    text[5801] = "ha estado trabajado en un suero de lóbrego.";
    text[5802] = "Un fluido que cambia la composición molecular de los humanos que lo consumen.";
    text[5803] = "La materia de sus cuerpos se convierte en antimateria.";
    text[5805] = "La antimateria que me extrajo hace años le bastó para realizar";
    text[5806] = "experimentos con los que trató de perfeccionar la fórmula del suero de lóbrego.";
    text[5807] = "Cada prueba fallida... dio lugar a un lóbrego.";
    text[5808] = "... Un humano que ha perdido su humanidad... consumido por la antimateria.";
    text[5814] = "Nunca tuve la fuerza necesaria para derrotar a Saros... Así que tenía la esperanza de que";
    text[5809] = "se quedara sin antimateria con la que seguir experimentando, pero...";
    text[5813] = "Había elaborado un sistema perfecto...";
    text[5815] = "Mataba algunos lóbregos en el acto, extraía sus antinúcleos y";
    text[5816] = "utilizaba su antimateria para llevar a cabo sus próximos experimentos.";
    text[5817] = "Afortunadamente, muchos lóbregos lograban escapar creando agujeros de gusano cuando se transformaban.";
    text[5818] = "Así que, para conseguir esos antinúcleos, entrenó a un ejército que pudiera darles caza.";
    text[5755] = "Es repulsivo.";
    text[5821] = "¿Cómo es posible que Saros hiciera algo así...?";
    text[5822] = "¿Es que para él la vida humana no vale nada?";
    text[5823] = "Nos entrenó... Cuidó de nosotros...";
    text[5824] = "Para nosotros era un mentor... Un líder...";
    text[5825] = "... ¿Todo eso era mentira?";
    text[5826] = "Los anuncios de personas desaparecidas en los paneles... En los cafés...";
    text[5827] = "Eran personas inocentes que Saros capturó, ¿verdad?";
    text[5828] = "Probablemente.";
    text[5735] = "Saros capturó todo tipo de personas en secreto durante años.";
    text[5736] = "Primero... experimentaba con los prisioneros de la Base Militar.";
    text[5737] = "Cuando no le quedaron más sujetos con los que experimentar, recurrió a argucias para ocultar sus actos.";
    text[5739] = "El aumento de personas desaparecidas o muertas y el aumento de los incidentes con lóbregos";
    text[5829] = "en todo Luna no eran una coincidencia.";
    text[5752] = "Los pocos soldados que llevaban a cabo las misiones de secuestro de Saros";
    text[5753] = "no tenían otra alternativa que obedecer... De lo contrario, también se habrían convertido en sujetos con los que experimentar.";
    text[5754] = "Desgraciadamente, es lo que les ocurría de todas maneras cuando finalizaban sus misiones.";
    text[5830] = "Demonios... Cuánta crueldad... ";
    text[5831] = "Solo así podía estar seguro de mantener oculto su secreto.";
    text[5841] = "Todavía no sé POR QUÉ hace todo esto... Debe haber algún motivo...";
    text[5842] = "Sea el que sea..., no hay nada que pueda justificar sus actos.";
    text[5832] = "¿Le has contado esto a alguien más?";
    text[5834] = "Sois las primeras a las que se lo cuento...";
    text[5835] = "He tenido colegas que han luchado a mi lado a lo largo de los años...";
    text[5836] = "Cazábamos lóbregos que escapaban de Saros para ser los primeros en hacernos con ellos.";
    text[5837] = "Perdí todos los combates...";
    text[5838] = "Y perdí a todos mis compañeros. Todos acabaron convertidos en lóbregos...";
    text[5839] = "Si Saros no me ha matado, es porque quiere capturarme y estudiarme.";
    text[5844] = "Así que decidí... librar este combate solo.";
    text[5845] = "Si me permitiera el lujo de acercarme a alguien... Ese alguien también estaría en peligro...";
    text[5846] = "Me alejé de los demás... ";
    text[5847] = "... para no experimentar de nuevo el dolor de perder a alguien que me importaba.";
    text[5848] = "Todavía me siento así a veces...";
    text[5849] = "... pero voy a hacer todo lo que esté en mi mano para ser más fuerte.";
    text[5850] = "Espero que podáis perdonarme por cómo os he tratado antes...";
    text[5851] = "Lo siento.";
    text[5852] = "Nickle...";
    text[5853] = "¡Para! Vas a hacerme llorar...";
    text[5854] = "Chico, has pasado momentos muy duros...";
    text[5855] = "Somos nosotras las que deberíamos pedirte disculpas...";
    text[5856] = "Te juzgamos mal...";
    text[5857] = "... Os doy las gracias por vuestro apoyo.";
    text[5858] = "No puedo seguir haciendo esto solo.";
    text[5864] = "Tengo que dejar de huir...";
    text[5865] = "Tengo que enfrentarme a Saros de una vez por todas.";
    text[5859] = "Todos estos años has estado actuando en solitario. ¿Qué ha cambiado?";
    text[5860] = "Tengo esperanza.";
    text[5866] = "Vosotros me habéis dado esperanza.";
    text[5867] = "¡Y que lo digas!";
    text[5869] = "¡Ahora estamos en esto juntos!";
    text[5870] = "Bien... ¿Cuál será nuestro siguiente paso?";
    text[5871] = "En realidad no tengo ningún plan...";
    text[5872] = "¿CÓMO? ¿NOS SUELTAS UNA TRÁGICA REVELACIÓN COMO ESA Y ESPERAS";
    text[5873] = "QUE NO QUEDEMOS CRUZADOS DE BRAZOS?";
    text[5874] = "Eh, dadme algo de crédito, ¿vale?";
    text[5875] = "He pasado años reuniendo estos antinúcleos para asegurarme de que Saros no podía usarlos.";
    text[5876] = "Pero... no son el único motivo por el que los guardo aquí.";
    text[5763] = "Esa gente no se merecía el destino que tuvo que sufrir.";
    text[5761] = "Esperaba encontrar algún día la manera de hacerles regresar...";
    text[5762] = "Vaya, ¿pero eso es posible?";
    text[5877] = "Mmmm...";
    text[5878] = "¡Tal vez mi padre pueda ayudar!";
    text[5879] = "Si conseguimos echarle el guante al suero de lóbrego de Saros...";
    text[5880] = "¡Es posible que mi padre pueda encontrar una manera de revertir sus efectos!";
    text[5881] = "¿Qué hay de los antinúcleos? ¿Un antisuero podría funcionar en un antinúcleo?";
    text[5882] = "¡No lo sabremos hasta que lo intentemos!";
    text[5883] = "¿Y qué hay del cometa Coda?";
    text[5884] = "Todavía falta un año para la llegada del cometa Coda.";
    text[5885] = "¡Ahora mismo nuestra prioridad debería ser detener a Saros";
    text[5886] = "Cuanto más esperemos, más vidas destruirá...";
    text[5887] = "Tenemos que elaborar un plan... ";
    text[5891] = "Reunámonos en la Estación Espacial Lunex.";
    text[5892] = "Eh... ¿Estáis seguras de que podemos ir allí?";
    text[5893] = "La Fuerza Lunex sigue buscándonos...";
    text[5894] = "No te preocupes. Allí estaremos a salvo.";
    text[5895] = "En la estación todos son como mi familia. ¡Yo crecí allí!";
    text[5896] = "Si queremos acabar con Saros, necesitaremos aliados.";
    text[5888] = "No sé si es buena idea meter a más gente en este asunto.";
    text[5898] = "Confía en mí, Nickle. Todo irá bien.";
    text[5899] = "... ... ... ... ";
    text[5778] = "Vale. Confío en ti.";
    text[6075] = "¡No puede ser...!";
    text[6076] = "¡Es mi nave!";
    text[6077] = "¡Sorpresa! Je.";
    text[6078] = "Encontramos tu nave cuando estábamos buscándote ahí fuera.";
    text[6079] = "Supusimos que lo mejor era recogerla y traértela de vuelta.";
    text[6080] = "Ooooh... Chicas, ¡sois de lo que no hay!";
    text[6081] = "¡Mueh! ¡Es Bella!";
    text[6082] = "¡Bella! ¡Gracias al cielo que estás bien, querida! ¡Nos tenías tan preocupados!";
    text[6083] = "Así es... ¡Y veo que has traído a un invitado!";
    text[6084] = "Hola. Me llamo Nickle.";
    text[6085] = "¡Es un placer conocerte por fin, Nickle! ¡Mueh!";
    text[6722] = "Chicos... No iréis a entregarnos, verdad?";
    text[6723] = "¿Por qué haríamos algo así, mueh?";
    text[6724] = "Nunca entregaríamos a alguien de nuestra tripulación. Todos los de aquí somos prácticamente de la misma familia.";
    text[6086] = "Hablando de familia... Srta. Nyla, ¿dónde está papá?";
    text[6087] = "Creo que el doctor Thomas está en la Base Militar.";
    text[6088] = "Oh, diablos... ¡Lo olvidé por completo!";
    text[6089] = "Bella... Tu padre...";
    text[6090] = "Cuando descubrió que habían publicado una misión para capturarte,";
    text[6091] = "salió hecho una fura del laboratorio para enfrentarse a Saros.";
    text[6092] = "¿Qué? No... ¡Papá puede estar en peligro!";
    text[6093] = "¡Trataré de llamarle!";
    text[7125] = "@P.@P.@P.@P.@P.@P.";
    text[6094] = "... No responde...";
    text[6095] = "Un momento, ¿qué está pasando aquí? ¿Mueh?";
    text[6096] = "¿Thomas está en peligro?";
    text[6097] = "Nickle...";
    text[6098] = "... Adelante. Puedes decirles la verdad.";
    text[6099] = "No... Esto es TERRIBLE...";
    text[6100] = "Saros lleva años engañándonos...";
    text[6101] = "Lo que ha hecho... ¡es INACEPTABLE! ¡MUEH!";
    text[6102] = "... ¡Y por eso debemos ir a salvar a mi padre!";
    text[6103] = "Y si Saros...";
    text[6104] = "Un momento, Bella.";
    text[6105] = "Debemos mantener la calma y evaluar la situación estratégicamente...";
    text[6106] = "No sabemos con seguridad si Saros quiere hacer daño a tu padre.";
    text[6107] = "El Saros que creéis conocer... es una mentira.";
    text[6108] = "Es un hombre peligroso.";
    text[6109] = "Pero Thomas es el científico jefe que está a cargo del proyecto Celestia.";
    text[6110] = "Es poco probable que Saros vaya a deshacerse de un activo tan valioso...";
    text[6111] = "No estoy diciendo que no debamos preocuparnos.";
    text[6112] = "Solo que deberíamos elaborar un plan...";
    text[6113] = "Una misión para rescatar a tu padre sin que corra peligro,";
    text[6114] = "y para arrestar a Saros por los crímenes que ha cometido.";
    text[6116] = "Yo lideraré la misión.";
    text[6117] = "Vamos a necesitar aliados.";
    text[6118] = "Reunamos a todos los soldados y científicos de la Estación Espacial.";
    text[6119] = "¡Recibido!";
    text[6125] = "... y eso es todo.";
    text[6126] = "La verdad sobre los lóbregos...";
    text[6127] = "... Lo que Saros ha estado haciendo entre bambalinas...";
    text[6128] = "... y por qué os pidió que nos capturaseis, al Matalóbregos y a mí.";
    text[6120] = "Amigos míos... Camaradas soldados...";
    text[6121] = "Os hemos convocado aquí hoy...";
    text[6122] = "... para luchar por un mismo objetivo.";
    text[6129] = "Ahora que sabemos toda la verdad...";
    text[6130] = "... ¡Tenemos la oportunidad de enderezar las cosas!";
    text[6131] = "Nuestros camaradas, que cayeron a manos de los lóbregos...";
    text[6132] = "Las familias rotas, que siguen lamentando la pérdida de sus seres queridos...";
    text[6133] = "Las múltiples desapariciones que han tenido lugar en toda Luna...";
    text[6134] = "¿Saros es responsable de todas esas tragedias?";
    text[6135] = "Entiendo que esta situación es realmente complicada.";
    text[6136] = "La gente de Luna todavía desconoce la existencia del cometa Coda.";
    text[6137] = "Y vosotros estáis haciendo todo lo que podéis entre bambalinas";
    text[6138] = "para que la gente de Luna tenga un futuro mejor.";
    text[6139] = "Además de esto, ahora tenemos el asunto de los lóbregos...";
    text[6140] = "Los lóbregos... son también nuestra gente.";
    text[6141] = "Fueron humanos en el pasado.";
    text[6142] = "Si el pueblo descubriera la verdad sobre los lóbregos y la existencia del cometa Coda...";
    text[6143] = "Su confianza en la Fuerza Lunex se derrumbaría...";
    text[6144] = "Perderían toda esperanza...";
    text[6145] = "¡No podemos permitir que eso ocurra!";
    text[6146] = "¡No podemos dejar que Saros realice más experimentos!";
    text[6147] = "Espero...";
    text[6148] = "¡Espero que estéis dispuestos a luchar con nosotros!";
    text[6149] = "¡General Grey!";
    text[6150] = "¡Seguiremos sus órdenes!";
    text[6151] = "¡¿G-general?! ¿Yo?";
    text[6152] = "Después de todo lo que nos ha contado...";
    text[6153] = "Saros ya no es nuestro general.";
    text[6154] = "Nos negamos a seguir a un hombre que no respeta las vidas";
    text[6155] = "de la gente de Luna.";
    text[6156] = "Seguro que las tropas de los demás departamentos pensarán lo mismo.";
    text[6157] = "General Grey, tiene nuestra confianza.";
    text[6158] = "El doctor Thomas, la antigua general y incluso usted, Bella.";
    text[6159] = "Su familia siempre nos ha inspirado a superarnos...";
    text[6160] = "¡A tener esperanza en el futuro de la humanidad!";
    text[6161] = "Le ayudaremos a salvar al doctor Thomas y a detener a Saros. Así de simple.";
    text[6162] = "Gracias...";
    text[6163] = "Gracias a todos.";
    text[6164] = "¡Vamos a patearle el culo a Saros! ¡MUAH, JA, JA, JA!";
    text[6165] = "¡SÍÍÍÍÍ!";
    text[6166] = "Todos los que podáis luchar debéis preparar vuestro equipo.";
    text[6167] = "¡Mañana partiremos a la Base Militar!";
    text[6168] = "En cuanto a nuestros camaradas ingenieros y científicos,";
    text[6169] = "tienen otro desafío que superar...";
    text[6170] = "Es posible que mi padre pueda encontrar una manera de revertir los efectos del suero de lóbrego";
    text[6171] = "en el que Saros ha estado trabajando...";
    text[6172] = "... cuando se lo confisquemos, claro está.";
    text[6173] = "¡«Superar obstáculos» es nuestro segundo nombre!";
    text[6174] = "¡Lucharemos en el campo de batalla de la ciencia!";
    text[6175] = "¡Nosotros nos encargaremos, Srta. Nyla!";
    text[6176] = "¡Mañana será el día en el que tomaremos las riendas de nuestro futuro!";
    text[6177] = "¡Juro PROTEGER a la gente de Luna!";
    text[6178] = "¡... SALVAR  a los inocentes que Saros ha convertido en lóbregos!";
    text[6179] = "¡... VENGAR las incontables almas que se han perdido a lo largo de los años...!";
    text[6180] = "... ¡y más adelante...";
    text[6181] = "... encontraremos una manera de detener el cometa Coda...";
    text[6182] = "... juntos! ¡Como una Fuerza Lunex realmente unida!";
    text[6183] = "¡Que nuestra lux BRILLE PARA SIEMPRE!";
    text[6184] = "¡SÍÍÍÍÍ!";
    text[6185] = "Bella, ¡eso ha sido INCREÍBLE!";
    text[6186] = "¡Has conseguido unir a todas esas personas para que luchen a tu lado!";
    text[6187] = "Ha sido...";
    text[6188] = "¡UN MARTIRIO! SANTO CIELO...";
    text[6189] = "Nunca había dado un discurso delante de tantas personas.";
    text[6190] = "¡Mamá hacía que pareciera tan fácil!";
    text[6191] = "¡Lo has hecho genial, Bella!";
    text[6192] = "¡Mueh! ¡Para mí también ha sido una grata sorpresa!";
    text[6193] = "Asís que general Grey, ¿eh?";
    text[6194] = "No suena nada mal.";
    text[6195] = "Parece sentarle como un guante a nuestra guerrera prodigio.";
    text[6196] = "¡Eh!";
    text[6197] = "Deberíamos descansar un poco para mañana.";
    text[6198] = "Llevamos tanto tiempo huyendo...";
    text[6199] = "Ah, tienes razón...";
    text[6200] = "¡Vamos, chica! ¡Esta noche dormiremos en la Estación Espacial! ¡MUAH, JA, JA, JA!";
    text[6201] = "¿Cómo es posible que Raine tenga siempre tanta energía?";
    text[6202] = "No tengo ni idea...";
    text[6203] = "Creo que es su manera de enfrentarse al estrés.";
    text[6204] = "En el fondo, es probable que esté nerviosa ante lo que ocurrirá mañana... ";
    text[6205] = "... Al menos, yo lo estoy.";
    text[6206] = "... Yo también.";
    text[6207] = "(Espero que papá esté bien...)";
    text[6208] = "¡Muy bien, buenas noches a todos! Nos reuniremos de nuevo mañana.";
    text[6229] = "OBJETIVO: IR A TU HABITACIÓN A DESCANSAR.";
    text[6050] = "... QUÉ EXTRAÑO.";
    text[6051] = "ESTA ES LA SEGUNDA PRESENCIA BIOMÉTRICA QUE DETECTO";
    text[6052] = "DESDE QUE ESA PERCIBEALMAS ME DESPERTÓ.";
    text[6053] = "¿...?";
    text[6054] = "A... Ayuda...";
    text[6055] = "Necesito... tu ayuda...";
    text[6056] = "... Por favor...";
    text[6057] = "... Ellos...";
    text[6058] = "... me necesitan...";
    text[6059] = "¡FASCINANTE!";
    text[6060] = "ESTA ALMA...";
    text[6061] = "¡...!";
    text[6062] = "YA VEO...";
    text[6063] = "ENTIENDO QUÉ HAY QUE HACER.";
    text[6064] = "NO ME QUEDA MUCHO TIEMPO...";
    text[6065] = "PERO ESTOY DISPUESTO A AYUDARTE.";
    text[6066] = "CON LA ENERGÍA QUE ME QUEDA...";
    text[6067] = "TE OTORGARÉ MI RECEPTÁCULO.";
    text[6068] = "SIGUE TU CAMINO...";
    text[6069] = "... CHRONOS.";
    text[6230] = "¿Qué está pasando? ¿Habéis escuchado esa explosión?";
    text[6231] = "¡Bella, nos atacan!! ¡Unos lóbregos se han infiltrado en la Estación Espacial!";
    text[6232] = "No puede ser... ¿Es posible que sea cosa de Saros?";
    text[6233] = "Maldita esa, ¡estos lóbregos están FUERA DE CONTROL!";
    text[6234] = "¡Son MUCHO MÁS agresivos de lo normal!";
    text[6235] = "¡Tenemos que proteger al personal de la estación!";
    text[6236] = "¡Estamos en ello!";
    text[6237] = "Bella, tenemos controladas la primera y la segunda planta.";
    text[6238] = "¡Encárgate tú de la tercera!";
    text[6239] = "¡Recibido!";
    text[6240] = "OBJETIVO: ¡ENCUENTRA Y DERROTA A LOS LÓBREGOS DE LA PLANTA 3!";
    text[6241] = "¡Vamos, marchaos! ¡Nos encargaremos de estos lóbregos!";
    text[6242] = "¡G-gracias, general Grey!";
    text[6243] = "¡Por favor, tenga cuidado!";
    text[6246] = "No os preocupéis por nosotras. ¡La situación está controlada!";
    text[6265] = "La puerta está cerrada desde el otro lado.";
    text[6266] = "General Grey, ¡tenemos esta zona controlada!";
    text[6267] = "¡No se preocupe por nosotros!";
    text[7138] = "¡Han llegado refuerzos! ¡Llevad a los científicos a un lugar seguro!";
    text[7139] = "¡De inmediato!";
    text[6268] = "¡Bien hecho, equipo! Parece que hemos derrotado a todos los lóbregos.";
    text[6269] = "Todo el mundo está un poco alterado, pero nadie ha sufrido heridas graves.";
    text[6270] = "Gracias al cielo...";
    text[6271] = "¿A alguien le apetece un segundo asalto?";
    text[6272] = "¿¡Saros!?";
    text[6273] = "¡¿Acaba de abrir un agujero de gusano?!";
    text[6274] = "¿Os sorprende? Me ha llevado bastante tiempo aprender a crear uno, ja, ja, ja.";
    text[6275] = "Tras los incontables experimentos que he realizado con el paso de los años...";
    text[6276] = "... tras trabajar con tantos especímenes de prueba...";
    text[6277] = "... yo no podía ser una excepción.";
    text[6278] = "Como podéis ver, también he experimentado conmigo mismo.";
    text[6279] = "Este poder, el poder de la antimateria... es INCREÍBLE.";
    text[6280] = "Todavía tengo que probar este poder que acabo de descubrir... ¿Qué os parece si lo ponemos un poco a prueba?";
    text[6281] = "¡Aaagh! ¡¿Qué demonios pasa?! ¡No podemos movernos!";
    text[6282] = "¡Saros! ¡Suéltalas! ¡Les estás haciendo daño!";
    text[6283] = "Sabía que llegaría el día...";
    text[6284] = "... en el que descubrirías la verdad.";
    text[6285] = "Era inevitable. Solo tenías que ganarte la confianza del Matalóbregos.";
    text[6286] = "Pero... saber la verdad es una cosa.";
    text[6287] = "Comprenderla... es otro asunto muy distinto.";
    text[6288] = "Saros, ¿por qué estás haciendo esto?";
    text[6289] = "¿Es que la vida humana no significa nada para ti?";
    text[6290] = "Todo lo que he hecho... lo he hecho para que la humanidad evolucione.";
    text[6291] = "Los resultados de mi trabajo... ";
    text[6292] = "garantizarán la supervivencia de las próximas generaciones de humanos.";
    text[6293] = "¡HIPÓCRITA!";
    text[6294] = "¡Estás haciendo daño a personas inocentes!";
    text[6295] = "... ¡A las mismas que afirmas estar salvando!";
    text[6296] = "Es necesario hacer sacrificios en nombre del progreso.";
    text[6297] = "No espero que comprendáis mis motivos...";
    text[6298] = "y sinceramente, no tengo tiempo para explicaros nada.";
    text[6299] = "¿Entonces para qué has venido aquí?";
    text[6300] = "Para aplastar vuestra pequeña rebelión.";
    text[6301] = "No hay lugar para vuestros estúpidos ideales en el futuro.";
    text[6302] = "¡Estás equivocado! ¡No vamos a rendirnos sin luchar!";
    text[6303] = "Vais a quedaros donde estáis.";
    text[6304] = "No querrás que le pase nada al doctor, ¿verdad?";
    text[6305] = "¡¿P-papá?! ¿Dónde está mi padre?";
    text[6306] = "¿Qué le has hecho?";
    text[6307] = "Nada todavía.";
    text[6308] = "Y no le haré nada... A menos que me digas dónde están los antinúcleos.";
    text[6309] = "No...";
    text[6310] = "Pero...";
    text[6312] = "El tiempo es esencial. No tengo todo el día.";
    text[6313] = "Nickle...";
    text[6314] = "Tienes mi palabra.";
    text[6315] = "Te devolveré a mi padre cuando me des lo que necesito.";
    text[6317] = "Lo haré.";
    text[6318] = "Te diré dónde están.";
    text[6319] = "Ja...";
    text[6320] = "Ja... Ja...";
    text[6321] = "¡JA, JA, JA, JA!";
    text[6322] = "¡FASCINANTE!";
    text[6323] = "¡Tienes REALMENTE la capacidad de cambiar a la gente, Bella!";
    text[6324] = "¡REALMENTE FASCINANTE!";
    text[6325] = "Espera, no me lo digas... Déjame que lo adivine...";
    text[6326] = "¿Los ocultas en Oceanus? ¿Tal vez en una cueva submarina oculta?";
    text[6327] = "¡QUÉ!... ¡¿PERO CÓMO...?!";
    text[6328] = "Era un escondite muy inteligente, lo admito.";
    text[6329] = "¡Nuestros sensores eran incapaces de encontrarlo!";
    text[6330] = "Desgraciadamente, me has subestimado.";
    text[6331] = "Siempre he ido dos pasos por delante de ti.";
    text[6332] = "Los antinúcleos ya están en mi poder, ¡JA, JA, JA, JA!";
    text[6333] = "¡ERES UN MONSTRUO!";
    text[6334] = "¿Cómo ha podido...?";
    text[6335] = "La confianza te ha hecho bajar la guardia, Matalóbregos.";
    text[6336] = "Uno de nuestros drones de búsqueda consiguió encontraros en Oceanus...";
    text[6337] = "... y os siguió hasta tu escondite... estuvo vigilando todos vuestros movimientos.";
    text[6338] = "No... No... ¡¿Cómo he podido ser tan descuidado?!";
    text[6339] = "Todo esto es culpa mía...";
    text[6340] = "¡JA, JA, JA, JA!";
    text[6341] = "Tu desesperación...";
    text[6342] = "Me da nuevos ánimos.";
    text[6343] = "Obligarte a elegir entre los antinúcleos y el doctor Thomas...";
    text[6344] = "En realidad... no tenías opción.";
    text[6345] = "En realidad... ya no necesito nada más de ti.";
    text[6346] = "¡Los antinúcleos que has reunido son más que suficientes para poder finalizar mi suero!";
    text[6347] = "¡SAROOOOOOS!";
    text[6348] = "¡AAAAAAARGH!";
    text[6349] = "Nickle, ¿estás bien?";
    text[6350] = "Buff, buff... Maldito malnacido...";
    text[6351] = "No eres rival para mí. Y lo sabes.";
    text[6352] = "Ni lo intentes.";
    text[6353] = "Ahora, si me disculpáis.";
    text[6354] = "Tengo un experimento que terminar.";
    text[6355] = "Pero... ¡Mi padre!";
    text[6356] = "Saros, por favor, ¡no hagas daño a mi padre! Por favor, devuélvenoslo...";
    text[6357] = "Tu padre...";
    text[6358] = "La persona a la que mas respeto...";
    text[6359] = "... y a la que más desprecio.";
    text[6360] = "Me quedaré con él un poco más...";
    text[6361] = "¡Para que pueda ver el nacimiento de una nueva era para la humanidad!";
    text[6362] = "ADIÓS.";
    text[6363] = "¡SAROOOOOS! ¡VUELVE AQUÍ, COBARDE!";
    text[6364] = "¿Qué ha sido eso? ¡Es como si la Estación Espacial se moviera!";
    text[6365] = "Oh, no... ¡Rápido! ¡Dirigíos a Control de Misiones!";
    text[6366] = "¡Saros se ha hecho con el control de la Estación Espacial Lunex!";
    text[6367] = "¡No puedo anular el sistema! Ha bloqueado todas las salidas...";
    text[6368] = "La Estación Espacial está cayendo desde la órbita de Luna...";
    text[6369] = "¡Ahora mismo estamos en rumbo de colisión directa contra Luna!";
    text[6370] = "¡¿CÓMO?! ¿CUÁNTO TIEMPO TENEMOS?";
    text[6371] = "A esta velocidad, la Estación Espacial se estrellará contra Luna en siete minutos...";
    text[6372] = "... pero esa es la menor de nuestras preocupaciones.";
    text[6373] = "También ha activado el Sistema Defensivo de la Astrobarrera...";
    text[6374] = "Oh-oh...";
    text[6375] = "El S. D. A. B se usa normalmente contra pequeños asteroides o restos espaciales que";
    text[6376] = "entran en la atmósfera de Luna. Cualquier cosa que la atraviesa se funde como la mantequilla...";
    text[6377] = "No... ¿Qué hacemos ahora?...";
    text[6378] = "Piensa... Piensa...";
    text[6379] = "¡Saros está loco! ¿No comprende que si destruye la EEL también destruirá";
    text[6380] = "Celestia? ¿Cómo piensa detener el cometa Coda sin la máquina?";
    text[6381] = "¡Eso es! ¡Celestia!";
    text[6382] = "Srta. Nyla, ¿sabe cómo activar la máquina de agujeros de gusano?";
    text[6383] = "Mmm... Sí, sé cómo hacerlo, querido. ¿Por qué?";
    text[6384] = "Tengo una idea...";
    text[6385] = "La inercia de la Estación Espacial nos empuja hacia Luna...";
    text[6386] = "Solo tenemos que empujarla en la dirección contraria con una fuerza igual o superior.";
    text[6387] = "¡Mueh! ¡Se ve que el chico entiende de física!";
    text[6388] = "¿Pero cómo hacemos eso? ¿Y qué tiene eso que ver con Celestia?";
    text[6389] = "Ahí es donde entro yo.";
    text[6390] = "Celestia funciona con antimateria. Yo puedo aportar algo de esa energía.";
    text[6391] = "Solo tendré que crear un agujero de gusano bajo la estación y luego...";
    text[6392] = "haré todo lo que pueda para empujarla en dirección contraria...";
    text[6434] = "Solo tendré que aguantar hasta que los propulsores de la nave se agoten.";
    text[6393] = "Espera, Nickle... Salir al espacio... ¡es un suicidio!";
    text[6394] = "¡¿Cómo sabes que esto funcionará?!";
    text[6395] = "No sé si lo hará, pero...";
    text[6396] = "... Tengo que intentarlo.";
    text[6397] = "Usaré mi forma de fase.";
    text[6398] = "Cuando adopto esa forma, mi cuerpo se convierte en antimateria pura.";
    text[6399] = "El oxígeno no será un problema.";
    text[6400] = "Pero aun así... ¡es demasiado peligroso!";
    text[6401] = "Podrías morir...";
    text[6402] = "También estoy preparado para eso...";
    text[6403] = "Mi forma de fase...";
    text[6404] = "... no me gusta usarla, pero no porque no pueda controlarla.";
    text[6405] = "... Aprendí a hacerlo hace años.";
    text[6406] = "Más bien es...";
    text[6407] = "por lo que esa forma representa.";
    text[6408] = "Representa mis fallos.";
    text[6409] = "Representa mis debilidades.";
    text[6410] = "... Mi incapacidad para proteger a otros.";
    text[6411] = "Mis poderes... no han servido más que para dañar a gente inocente...";
    text[6412] = "Especialmente cuando no podía controlarlos.";
    text[6413] = "Mis poderes... hicieron que Saros perdiera la cabeza...";
    text[6414] = "... debido a ellos, los lóbregos hicieron daño a más gente inocente...";
    text[6415] = "Es algo que estoy dispuesto a compensar hoy.";
    text[6416] = "Nickle...";
    text[6417] = "Mi pasado... Mis errores... Mis fallos siguen siendo un lastre para mí...";
    text[6418] = "Incluso hoy en día...";
    text[6419] = "Saros se ha adelantado a nosotros y se ha llevado todos los antinúcleos que reuní...";
    text[6420] = "He fallado una vez, y otra, y otra...";
    text[6421] = "... Solo quiero hacer algo bueno por una vez en mi vida.";
    text[6422] = "Algo... de lo que pueda estar orgulloso.";
    text[6423] = "Bella...";
    text[6424] = "Gracias por confiar en mí... y gracias por tu bondad...";
    text[6425] = "Nickle... Por favor...";
    text[6426] = "Yo...";
    text[6427] = "¡...!";
    text[6428] = "Lo siento...";
    text[6429] = "Eso ha sido algo egoísta por mi parte.";
    text[6430] = "¡Santo cielo!";
    text[6431] = "Mola, je.";
    text[6432] = "Estás hablando como si no fueras a regresar con vida...";
    text[6433] = "... eres un idiota.";
    text[6435] = "Bella...";
    text[6436] = "¡Más te vale regresar!";
    text[6437] = "¡Te necesitamos!";
    text[6438] = "Te... necesito...";
    text[6439] = "Deséame suerte.";
    text[6440] = "¡MODO FASE!";
    text[7140] = "¡AAAAAAH!";
    text[7141] = "¡Nickle, está funcionando!";
    text[7142] = "¡Estamos empezando a perder velocidad!";
    text[7143] = "Todavía no es suficiente... ¡Nuestra velocidad es demasiado alta!";
    text[7144] = "¡Aguanta! ¡No te rindas!";
    text[7145] = "¿Cuánto falta para llegar a la Astrobarrera?";
    text[7146] = "¡Mueh! ¡Dos minutos!";
    text[7168] = "¿Cuánto combustible queda?";
    text[7169] = "Queda un 75%...";
    text[7147] = "¡Aaaagh! ¡Diablos, la inercia de esta cosa es BRUTAL!";
    text[7148] = "No puedo... Empujarla en la dirección contraria...";
    text[7162] = "¡Nicle, no te preocupes por nosotros!";
    text[7163] = "¡No te reprimas! ¡Sabes que eres mucho más fuerte!";
    text[7164] = "Pero si... Si me esfuerzo demasiado...";
    text[7165] = "¿Y si vuelvo a perder el control...?";
    text[7166] = "Podría destruir la Estación Espacial...";
    text[7167] = "Y todos vosotros...";
    text[7149] = "¡Nickle! ¡Puedes hacerlo! ¡Usa todo tu poder!";
    text[7150] = "¿Eso es...?";
    text[7151] = "¡Es la tripulación de la EEL! Soldados, científicos... ¡todos!";
    text[7152] = "¡Han venido todos a animarte!";
    text[7153] = "¡Nickle! ¡Confiamos en ti!";
    text[7154] = "¡¡Puedes hacerlo!!";
    text[7155] = "(Gracias...)";
    text[7156] = "(Gracias a todos...)";
    text[7157] = "(Tienen razón... ¡No puedo rendirme...!)";
    text[7158] = "Si no puedo salvar a los que están aquí...";
    text[7159] = "... el destino de la gente de Luna quedará en manos de Saros.";
    text[7160] = "¡Voy a ESFORZARME AL MÁXIMO!";
    text[7161] = "¡¡AAAAAAAAAAAH!!";
    text[6442] = "(¡PAM!)";
    text[6443] = "¡Ay! ¡Estoy despierto! ¡Estoy despierto! ¿A qué ha venido eso?";
    text[6444] = "Tonto...";
    text[6445] = "Hum, pensábamos que te habíamos perdido...";
    text[6446] = "Cuando la EEL regresó a la órbita, perdiste el conocimiento.";
    text[7172] = "Afortunadamente, conservaste tu forma de fase.";
    text[7173] = "Bella fue inmediatamente a buscarte...";
    text[6449] = "Me... alegro de que estés bien.";
    text[6450] = "Eh, gracias por salvarnos.";
    text[6451] = "Te debemos una.";
    text[6452] = "¡Gracias a todos...!";
    text[6453] = "La fuerza que mostraste fue digna de admiración. ¡Fue algo realmente impresionante!";
    text[6454] = "¡Eres mi héroe, chico! ¡Mueh!";
    text[6455] = "Has hecho algo muy noble.";
    text[7177] = "Tu determinación nos conmovió a todos.";
    text[6456] = "Gracias a todos. No podría haberlo hecho sin vosotros.";
    text[7178] = "Agh...";
    text[6458] = "Nickle, ¡primero deberías descansar en un cámara curativa!";
    text[7136] = "No hace falta, estoy bien. Es solo que tengo los brazos doloridos.";
    text[7137] = "Dadme unas pocas barritas de tarta de queso y estaré listo para volver a la acción, je.";
    text[7171] = "Tómatelo con calma, ¿vale?";
    text[7176] = "Lo haré.";
    text[7175] = "Muy bien, escuchadme todos...";
    text[6465] = "Ya habéis visto de lo que es capaz Saros.";
    text[6466] = "¡No podemos permitir que se salga con la suya!";
    text[6467] = "Nuestro futuro... ¡está en nuestras manos!";
    text[6468] = "¡SÍ GENERAL! ¡ESTAREMOS LISTOS CUANDO DÉ LA ORDEN!";
    text[6469] = "Un momento... ¿El Sistema Defensivo de la Astrobarrera sigue activo?";
    text[6470] = "Si es así, no podemos llevar una nave hasta la Base Militar...";
    text[6471] = "No tendremos que hacerlo... ¡Tenemos una máquina que genera agujeros de gusano!";
    text[6472] = "... Y una fuente de antimateria aquí al lado, je.";
    text[6473] = "¡¿Perdona?!";
    text[6474] = "¡Estoy de broma!";
    text[6475] = "Lo sé, lo sé. No te preocupes, ya lo sabía.";
    text[6476] = "¡Muy bien, tropas! ¡Dirigíos al Laboratorio Nexus!";
    text[7181] = "¡Saldremos en 5 minutos!";
    text[7182] = "¡SÍ, GENERAL!";
    text[6248] = "Tetra, creo que ha llegado la hora.";
    text[6249] = "¡¿EN SERIO?!";
    text[6251] = "LLEVO TANTO TIEMPO ESPERANDO ESTE MOMENTO.";
    text[7183] = "¿Dónde vais ahora, mueh?";
    text[7184] = "Volveremos enseguida.";
    text[7185] = "He dejado algo importante en mi habitación.";
    text[7186] = "¡Tranquila! ¡Os estaremos esperando en el Laboratorio Nexus!";
    text[7187] = "¡Solo tienes que hablar con nosotros cuando estés lista para ir a la Base Militar, mueh!";
    text[7195] = "¡Lo sabía! ¡Quieres llevarte el traje impulsor de Thea!";
    text[6252] = "Si voy a llevar esto, necesitaré a una ayudante de confianza a mi lado.";
    text[6253] = "¿Estás lista para aceptar el desafío?";
    text[6254] = "¡Nací lista, je!";
    text[6255] = "Mamá llamaba a su traje el traje Nebulosa.";
    text[6256] = "Algunas nebulosas aparecen cuando una estrella moribunda explota...";
    text[6257] = "... cuando se produce una supernova.";
    text[6258] = "Pero... una nebulosa también puede ser el lugar en el que empiezan a formarse nuevas estrellas.";
    text[6259] = "Este traje Nebulosa indica el fin de una era... y el inicio de una nueva.";
    text[6260] = "Espero que pueda estar orgullosa de mí...";
    text[6261] = "Bella... ya lo está. ¡De eso estoy segura!";
    text[6262] = "¡Si estuviera aquí, estaría orgullosa de la maravillosa mujer en la que te has convertido!";
    text[6263] = "Tetra... eres la mejor.";
    text[6264] = "Ahora puedes llamarme Tetra Supernova, gracias. Je.";
    text[6477] = "¡Muy bien, ya estamos aquí!";
    text[6478] = "La oficina de Saros debería estar juste adelante.";
    text[6479] = "¡Deteneos de inmediato! ¡No mováis ni un músculo!";
    text[6480] = "Escuchad, ¡estáis luchando por el bando equivocado!";
    text[6481] = "¡Tenéis que dejarnos pasar!";
    text[6482] = "Cuanto más esperemos, ¡más vidas humanas sacrificará Saros!";
    text[6483] = "¡Puño Bala!";
    text[6484] = "¡Gracias por tu ayuda, Raine!";
    text[6485] = "¡Nosotras nos encargaremos de estos tipos!";
    text[6486] = "¡Encontrad a Saros!";
    text[6487] = "Así que este es el laboratorio en el que Saros realiza sus experimentos...";
    text[6488] = "Todos estos tubos con lóbregos... Todas estas víctimas...";
    text[6489] = "No puedo soportarlo... Esto es enfermizo...";
    text[6490] = "...";
    text[7290] = "¡Lóbregos! ¡¿También pueden aparecer aquí?!";
    text[7291] = "No me sorprende.";
    text[7292] = "Con toda la antimateria que hay aquí, este laboratorio es como un imán para lóbregos.";
    text[7293] = "¿Qué deberíamos hacer?";
    text[7294] = "Deberíamos luchar... y poner fin a su sufrimiento.";
    text[7295] = "Si sus antinúcleos siguen intactos, tal vez podríamos salvarlos...";
    text[7296] = "... pero liberarlos ahora mismo sería demasiado arriesgado.";
    text[7297] = "Si los lóbregos de los tubos se despiertan, nos superarían en número.";
    text[7298] = "Nuestra misión sería mucho más complicada si eso sucediese...";
    text[7299] = "...";
    text[7300] = "Muy bien, vamos allá.";
    text[7302] = "Me sorprende que no te opongas a luchar contra los lóbregos.";
    text[7312] = "Bueno... En el fondo, luchar contra ellos sigue sin gustarme.";
    text[7313] = "Pero... ahora que conozco la verdad,";
    text[7314] = "hay muchos factores que debo tomar en consideración.";
    text[7304] = "... Ya no se trata únicamente de evitar que gente inocente resulte herida.";
    text[7305] = "Hay almas humanas dentro... que están sufriendo.";
    text[7306] = "Si se convierten en antinúcleos, al menos no podrán herir a nadie...";
    text[7323] = "... y trabajaremos juntos para encontrar una manera de devolverles su forma original.";
    text[7307] = "Esta gente no decidió convertirse en monstruos... No es culpa suya.";
    text[7315] = "Me he dado cuenta de muchos de los lóbregos con los que luchamos no dejan antinúcleos cuando los derrotamos...";
    text[7324] = "Eso es porque tus almas ya han sido destruidas, ¿verdad?";
    text[7316] = "Así es. Cuando un humano se convierte en lóbrego, es posible que";
    text[7317] = "su alma quede destruida por la reacción causada por el suero.";
    text[7325] = "... ¿Entonces no hay manera de salvarlos en esos casos?";
    text[7326] = "Desgraciadamente, no...";
    text[7318] = "El alma humana reside en el antinúcleo.";
    text[7327] = "Sin él, no hay nada que recuperar.";
    text[7328] = "En esos casos, lo único que podemos hacer es ayudar a las víctimas a descansar en paz.";
    text[7308] = "Aunque no podamos salvarlos a todos...";
    text[7309] = "¡Debemos hacer todo lo posible para salvar a los que podamos!";
    text[7311] = "Bien dicho, Bella. ¡Estoy de acuerdo!";
    text[6491] = "¡Vivia!";
    text[6492] = "Él... Me ha abandonado...";
    text[6493] = "Después de todo lo que he hecho por él...";
    text[6494] = "Vivia, ¿dónde está Saros?";
    text[6495] = "¡Tenemos que detenerle!";
    text[6496] = "Saros... lo es todo para mí...";
    text[6497] = "Yo... haré sus sueños realidad.";
    text[6498] = "Tal vez...";
    text[6499] = "Tal vez si os detengo aquí mismo y ahora.";
    text[6500] = "¡Tal vez vuelva a tenerme en cuenta!";
    text[6501] = "Esta mujer está tan loca como Saros.";
    text[6502] = "No tiene sentido tratar de razonar con ella.";
    text[6503] = "No puedo dejaros marchar.";
    text[6504] = "Habéis visto demasiado.";
    text[6505] = "Sabéis demasiado.";
    text[6506] = "¿Por qué, Vivia? ¿Por qué le ayudas a hacer esto?";
    text[6507] = "Lo que Saros está haciendo... ¡está mal!";
    text[6508] = "Saros... es una persona moribunda.";
    text[6509] = "¡¿...?!";
    text[6510] = "Hace una década le diagnosticaron una enfermedad incurable.";
    text[6511] = "Tener que hacer frente a su propia mortalidad le llevó a tratar de encontrar una cura.";
    text[6512] = "La antimateria... El suero... Eso es lo que le ha salvado.";
    text[6513] = "Descubrió una manera de ralentizar el avance de la enfermedad...";
    text[6514] = "Al principio solo trataba de salvar su propia vida, pero entonces descubrió...";
    text[6515] = "que una versión perfeccionada del suero no solo salvaría su vida,";
    text[6516] = "sino que también podría salvar a otros.";
    text[6517] = "Su trabajo... tenía un propósito mucho mayor.";
    text[6518] = "Permanecí a su lado durante años...";
    text[6519] = "No ha sido fácil aceptar esta responsabilidad.";
    text[6520] = "Hay demasiada sangre en nuestras manos...";
    text[6521] = "... ¡y no permitiremos que todos nuestros esfuerzos queden en nada!";
    text[6522] = "¿Es que no quieres salvar a la humanidad, Bella?";
    text[6523] = "¡Lo que dices no tiene sentido! ¡Esta no es la manera de conseguirlo!";
    text[6524] = "Las vidas..., las almas... son algo sagrado";
    text[6525] = "Estamos sacrificando a miles para salvar a millones. Es un mal necesario.";
    text[6526] = "El cometa Coda es imparable. Si no hacemos esto, estamos condenados.";
    text[6527] = "Parece que Saros todavía no os lo ha dicho...";
    text[6528] = "¿Qué? ¿Qué es lo que no nos ha dicho?";
    text[6529] = "Me temo que no tendréis la oportunidad de preguntárselo.";
    text[6530] = "Si queréis llegar hasta Saros, tendréis que acabar conmigo.";
    text[6531] = "Pero... Eso no va a ocurrir.";
    text[6532] = "Mientras os escondíais de nosotros, he vuelto a mejorar mi holotecnología.";
    text[6533] = "Esta vez, LA VICTORIA SERÁ MÍA.";
    text[6534] = "Todo ha terminado, Vivia...";
    text[6535] = "Dinos dónde está.";
    text[6536] = "Ha llevado a tu padre a su santuario.";
    text[6537] = "... el lugar que Saros quiere convertir en el nuevo hogar de la humanidad...";
    text[6538] = "... La Zona Fantasma.";
    text[6539] = "... No le pasará nada. Solo se ha desmayado por el cansancio.";
    text[6540] = "La Zona Fantasma...";
    text[6541] = "Los humanos no pueden permanecer en la Zona Fantasma más de 72 horas...";
    text[6542] = "... ¿Es posible que Saros estuviera mintiendo cuando mencionó esa regla?";
    text[6543] = "No lo sé... Pero todavía no han transcurrido 72 horas.";
    text[6544] = "Nickle, ¿has estado antes en la Zona Fantasma?";
    text[6545] = "Solo una vez, y fue hace mucho tiempo...";
    text[6546] = "... Es una larga historia.";
    text[6585] = "Siempre nos habían dicho que no debíamos entrar en la Zona Fantasma...";
    text[6586] = "Debe haber sido una decisión estratégica de Saros.";
    text[6547] = "Si está haciendo algo en la Zona Fantasma,";
    text[6548] = "le convenía asegurarse de que nadie fuera allí.";
    text[6549] = "No puedo creerlo...";
    text[6550] = "Cada vez que descubrimos algo nuevo...";
    text[6551] = "... me sienta más...";
    text[6552] = "... ¿furiosa?";
    text[6553] = "Sí...";
    text[6554] = "No puedo soportarlo.";
    text[6555] = "... Ver que ocurren cosas horribles...";
    text[6556] = "Es aún peor cuando esas cosas horribles han estado ocurriendo sin ser consciente de ello.";
    text[6557] = "Luna necesita un cambio.";
    text[6558] = "Y si alguien va a ayudar a cambiar el rumbo en la dirección adecuada...";
    text[6559] = "Ese alguien eres tú.";
    text[6560] = "Pero ahora mismo tenemos un general corrupto del que ocuparnos.";
    text[6561] = "Acabemos con él primero.";
    text[6562] = "Muy bien.";
    text[6563] = "¿Cómo podemos encontrar a Saros? La Zona Fantasma es enorme.";
    text[6564] = "También es un lugar peligroso... ";
    text[6565] = "... y eso sin tener en cuenta la regla de las 72 horas, sea cierta o no.";
    text[6566] = "Un momento... ¿Eso es lo que creo que es?";
    text[6567] = "¿No parece una máquina de agujeros de gusano? Vayamos a echar un vistazo.";
    text[6568] = "Tetra, ¿puedes analizar ese aparato?";
    text[6569] = "Trata de conseguir algo de información sobre esa máquina.";
    text[6570] = "Es... una versión alfa de Celestia.";
    text[6571] = "Ya veo... Papá me dijo que Saros formaba arte del proyecto Antimateria hace años.";
    text[6572] = "Debe haber creado su propia versión utilizando los cianotipos que se abandonaron.";
    text[6573] = "¡UN MOMENTO, HE ENCONTRADO ALGO!";
    text[6574] = "¿Qué es?";
    text[6575] = "¡SON COORDENADAS!";
    text[6576] = "¡Genial! Al menos tenemos una pista que seguir. ¡Sigamos esas coordenadas!";
    text[6577] = "Siguiente parada: ¡la Zona Fantasma!";
    text[7388] = "¿Quieres usar la máquina de agujeros de gusano para acceder a la Zona Fantasma?";
    text[7402] = "Hay algunos textos antiguos escritos en esta estatua...";
    text[7403] = "Dice... ";
    text[7398] = "«A nuestros hermanos cósmicos: que este santuario os ofrezca";
    text[7399] = "un refugio tranquilo en vuestro viaje interestelar».";
    text[7404] = "¡Aaaah! Ya veo.";
    text[7405] = "Este lugar solía ser un lugar de reposo para los Antiguos cuando";
    text[7406] = "viajaban por la Zona Fantasma.";
    text[7407] = "Este santuario tiene una extraña belleza...";
    text[7408] = "Es como un oasis en medio de un desierto desolado...";
    text[7412] = "... ¡Aaaagh! ¡Mis ansias de ir en busca de tesoros me están matando!";
    text[7413] = "Sigamos adelante antes de que acaben distrayéndome.";
    text[7414] = "Sabéis... Cuando todo esto haya terminado...";
    text[7415] = "Tal vez podríamos explorar nuevas partes de la Zona Fantasma,";
    text[7416] = "en nuestra primera expedición.";
    text[7417] = "¿Qué te parece eso, Sr. Cazatesoros?";
    text[7418] = "Me parece ESTUPENDO. Contad conmigo, je.";
    text[7419] = "Esos paneles tienen una especie de campo de fuerza...";
    text[7420] = "Tenemos que encontrar una manera de atravesarlo.";
    text[7421] = "Mmmm...";
    text[7422] = "¿Estás pensando lo que estoy pensando, Tetra?";
    text[7423] = "¡Sí!";
    text[7424] = "¡Vaya! ¡¿Cómo habéis hecho eso, chicas?!";
    text[7425] = "Esos cubos forman parte del sistema de seguridad de este lugar.";
    text[7426] = "He conseguido infiltrarme en el cubo gris para descifrarlo y desactivarlo, je.";
    text[7427] = "El cubo rojo era un poco más peligroso.";
    text[7428] = "Está hecho de una antimateria densa, contenida en una estructura frágil.";
    text[7429] = "Si alguien lo hubiera tocado, habría explotado.";
    text[7430] = "Entonces, ¿cómo has conseguido eliminarlo?";
    text[7431] = "Muy fácil. Lo he absorbido, je.";
    text[7432] = "Tetra, quédate en el círculo amarillo que hay más adelante.";
    text[7433] = "Yo iré al verde.";
    text[7434] = "Estupendo, ¡los paneles han desaparecido!";
    text[7435] = "Ahora que sabemos cómo desactivar los paneles,";
    text[7436] = "tendremos que colaborar para seguir adelante.";
    text[7437] = "¡Entendido! ¡Es hora de trabajar en equipo!";
    text[6594] = "Bienvenido a mi santuario, Thomas.";
    text[6595] = "¿No te parece que la Zona Fantasma es un regalo para la vista?";
    text[6596] = "Saros, no hay nada en este lugar para nosotros.";
    text[6597] = "Si cancelamos el proyecto Antimateria hace años fue por un motivo...";
    text[6598] = "En ese momento no sabíamos nada de este mundo...";
    text[6599] = "... este hermoso plano de existencia paralelo al nuestro.";
    text[6600] = "Este lugar... será el nuevo hogar de la humanidad.";
    text[6601] = "Thomas... ¿Cuánto tiempo crees que puede sobrevivir la humanidad en Luna?";
    text[6602] = "Bueno...";
    text[6603] = "Tú no has ayudado mucho... La destrucción causada por los lóbregos ha reducido el tiempo que nos queda a décadas...";
    text[6604] = "Incluso sin mi interferencia...";
    text[6605] = "Nos habríamos quedado sin recursos con el paso del tiempo...";
    text[6606] = "La escasez de recursos siempre será un problema si seguimos viviendo en Luna.";
    text[6607] = "Los recursos son limitados... pero la antimateria...";
    text[6608] = "... ¡tiene un potencial ilimitado!";
    text[6609] = "El conocimiento es poder, Thomas.";
    text[6610] = "A pesar de los que acordamos, solía visitar la Zona Fantasma a menudo.";
    text[6611] = "... y durante el tiempo que he pasado aquí, hecho grandes descubrimientos.";
    text[6612] = "En este lugar no envejecemos. Ni pasamos hambre.";
    text[6613] = "De alguna manera, nuestros cuerpos mantienen su metabolismo...";
    text[6614] = "...";
    text[6615] = "¿Fascinante, verdad?";
    text[6616] = "Como camarada interesado en la ciencia, ¿no te emocionan las perspectivas que esto puede tener?";
    text[6617] = "Es cierto, la Zona Fantasma tiene extraños efectos en el cuerpo humano...";
    text[6618] = "Pero... Este lugar es una trampa mortal...";
    text[6619] = "A pesar de sus beneficios iniciales, nuestros cuerpos comienzan a desintegrarse con el tiempo.";
    text[6620] = "Tienes razón... Esa es, sin duda, nuestra limitación.";
    text[6621] = "Con nuestros cuerpos no podemos disfrutar de los milagros que ofrece la Zona Fantasma.";
    text[6622] = "Hace años me dije a mí mismo...";
    text[6623] = "... Si no tuviera este cuerpo...";
    text[6624] = "No tendría que preocuparme por la muerte... Por mis propias limitaciones mortales.";
    text[6625] = "Nuestras limitaciones son lo que nos hace humanos, Saros.";
    text[6626] = "Esto no es más que una fantasía. No podemos sobrevivir aquí.";
    text[6627] = "Te equivocas.";
    text[6628] = "He desarrollado la tecnología...";
    text[6629] = "Mi suero... está prácticamente finalizado.";
    text[6630] = "Cuando lo termine, podré transformar a cualquier humano en un ser perfecto";
    text[6631] = "hecho de antimateria.";
    text[6632] = "Un ser capaz de sobrevivir en la Zona Fantasma.";
    text[6656] = "Mi suero... ¡es la clave del avance de nuestra especie!";
    text[6633] = "Esto... es solo una muestra de lo que se puede conseguir con la antimateria.";
    text[6634] = "Si logramos dominar la antimateria, los secretos del universo,";
    text[6635] = "el poder para romper las leyes de la mismísima física,";
    text[6636] = "y los conocimientos que ningún mortal ha soñado con alcanzar... estarían a nuestro alcance.";
    text[6637] = "Thomas, antaño fuiste mi amigo...";
    text[6638] = "Me ayudaste a entender la importancia de la investigación.";
    text[6639] = "Me ayudaste a saciar mi sed de conocimientos cuando era un joven científico.";
    text[6640] = "He aprendido mucho gracias a ti.";
    text[6641] = "Pero nuestras diferencias... siguen siendo una brecha que nos separa.";
    text[6642] = "¡Eso es porque has obtenido tus conocimientos de manera errónea!";
    text[6643] = "¿De manera errónea? ¿Eso piensas?";
    text[6644] = "Todos los miembros de la familia Grey cantan la misma cantinela...";
    text[6645] = "No somos solo nosotros.";
    text[6646] = "¿Crees que la gente de Luna querría tener nuevos cuerpos?";
    text[6647] = "... ¿Y una vida teóricamente feliz en un mundo que desconocen?";
    text[6682] = "Lo dudo mucho.";
    text[6667] = "Luna es nuestro hogar... Tenemos que protegerlo.";
    text[6668] = "Hubo un tiempo en que Terra fue el hogar de la humanidad...";
    text[6669] = "... pero míralo ahora.";
    text[6670] = "¡Es un lugar desolado y sin vida!";
    text[6648] = "Nuestros fundadores... Escaparon a Luna... a un mundo nuevo.";
    text[6657] = "¡Luna era un lugar prácticamente inhóspito!";
    text[6671] = "¡No tenían otra opción! Lo hicieron para sobrevivir.";
    text[6672] = "En nuestro caso, el tiempo está de nuestro lado, Saros.";
    text[6673] = "... Esta obsesión...";
    text[6674] = "... Esta paranoia...";
    text[6675] = "... Todo esto me muestra que has perdido la esperanza.";
    text[6676] = "Luna no te importa en absoluto.";
    text[6677] = "¡Eres un cobarde!";
    text[6678] = "...";
    text[6659] = "El cometa Coda cada vez está más cerca...";
    text[6660] = "... ¿y tú crees que yo soy el problema?";
    text[6661] = "¡Nos estoy dando una oportunidad para luchar!";
    text[6854] = "Thomas, no tenemos el combustible necesario para crear un agujero de gusano del tamaño necesario para detener al";
    text[6855] = "cometa Coda... Ni siguiera con los antinúcleos que el Matalóbregos ha reunido.";
    text[6856] = "... Pero sí que tenemos suficientes para llevar a cabo mi plan.";
    text[6857] = "Tenemos los necesarios para convertir a la humanidad en seres de antimateria.";
    text[6858] = "... Para emigrar después a la Zona Fantasma.";
    text[6662] = "Con mi plan SOBREVIVIREMOS. Esto no es cobardía.";
    text[6688] = "¡Estoy utilizando los conocimientos que obtuve en nuestro beneficio!";
    text[6679] = "Saros, hay una línea que nunca se debe cruzar...";
    text[6680] = "Yo nunca querría descubrir todos los secretos del cosmos,";
    text[6681] = "... ni obtener todo el poder del universo, si el precio a pagar para conseguirlo son vidas humanas. ";
    text[6683] = "En el gran marco del todo, una vida humana no vale nada.";
    text[6684] = "Tú...";
    text[6685] = "Cómo te atreves...";
    text[6686] = "Las vidas de mis colegas científicos, mis amigos, y el resto de la gente...";
    text[6687] = "La vida de Thea, todas eran valiosas.";
    text[6663] = "Es una desgracia...";
    text[6664] = "Que seas una de las grandes mentes de la humanidad.";
    text[6665] = "Esperaba que, de entre todos las personas, tú fueras capaz de ver el gran entramado de todo.";
    text[6689] = "(Aaay). Has dejado claro que no te unirás a mí.";
    text[6666] = "Por tanto, no hay lugar para ti en mi mundo.";
    text[6692] = "¡ADIÓS PARA SIEMPRE, THOMAS!";
    text[6697] = "¡Bella!";
    text[6694] = "AAAGH... ¿¡QUÉ!?";
    text[6695] = "¿QU-QUÉ ESTÁIS HACIENDO VOSOTROS TRES AQUÍ?";
    text[6696] = "¡SE SUPONE QUE ESTABAIS MUERTOS! AAAGH...";
    text[6698] = "Bella, siento mucho haberte metido en todo esto...";
    text[6699] = "Saros me obligó a hacer un trato...";
    text[6700] = "Dijo que te protegería... que nos protegería...";
    text[6701] = "Si dejaba que os infiltrarais en la base y le dejaba seguir con su plan.";
    text[6702] = "Papá...";
    text[6703] = "... Solo quería proteger a nuestra familia...";
    text[6704] = "... Perdóname, por favor.";
    text[6705] = "Papá, no te preocupes, no estoy enfadada. Ahora estamos aquí.";
    text[6706] = "¡No permitiremos que Saros se salga con la suya!";
    text[6707] = "Hum. Parece que os he subestimado a los tres.";
    text[6708] = "Es impresionante que hayáis dado conmigo.";
    text[6709] = "Como dije antes, no vamos a rendirnos sin luchar, Saros.";
    text[7439] = "También hemos visto que has traído contigo los antinúcleos que le robaste a Nickle...";
    text[7441] = "Vamos a dejar las cosas claras...";
    text[7442] = "Los antinúcleos NO son combustible para tus experimentos...";
    text[7443] = "... ¡Y vamos a arrebatarte todos y cada uno de ellos!";
    text[7444] = "¡Has traicionado a la gente de Luna, y eso es algo inaceptable!";
    text[7440] = "...";
    text[6710] = "¿Por qué...? ¿Por qué la familia Grey sigue cruzándose en mi camino?";
    text[6711] = "Sabes... Tu madre también fue como un dolor de muelas.";
    text[6712] = "Elige tus próximas palabras cuidadosamente, Saros.";
    text[6713] = "No dejaré que le faltes el respecto a mi familia.";
    text[6714] = "Bueno, hablando de tu familia... Supongo que deberías saber algo.";
    text[6715] = "Tu madre... El motivo por el que ya no está entre nosotros...";
    text[6716] = "Todo fue cosa MÍA.";
    text[6717] = "¡...! ¿Qu-qué...?!";
    text[6718] = "¡SAROS, ERES UN MONSTRUO!";
    text[6719] = "¿QUÉ LE HICISTE?";
    text[6720] = "La historia que has escuchado sobre su muerte fue solo una tapadera.";
    text[6721] = "Cuando descubrió mis experimentos con la antimateria...";
    text[6725] = "... los lóbregos...";
    text[6726] = "Canceló mi proyecto... y trató de destruir mi suero de lóbrego...";
    text[6727] = "... quiso destruir todo aquello en lo que había estado trabajando.";
    text[6728] = "Me defendí. La reté a un duelo... y perdí.";
    text[6729] = "Pero... Aunque ella era más fuerte que yo...";
    text[6730] = "... yo era más listo que ella.";
    text[6731] = "La pillé con la guardia baja...";
    text[6732] = "... activé mi máquina de agujeros de gusano...";
    text[6733] = "... y la atrapé en la Zona Fantasma, sin ningún medio para escapar.";
    text[6734] = "Se cruzó en mi camino... Y me desembaracé de ella... para siempre.";
    text[6735] = "¡SAROS, ERES UN MALNACIDO!";
    text[6736] = "JA, JA, JA, JA. ¡Eso es! ¡Liberad vuestra furia!";
    text[6737] = "¡Vuestra desesperación me da nuevos ánimos! ¡JA, JA, JA, JA!";
    text[6738] = "Como sabía que Thea se estaba pudriendo en la Zona Fantasma...";
    text[6739] = "... el siguiente paso lógico era convertirme en general.";
    text[6740] = "Convencer a la gente fue más fácil de lo que pensaba.";
    text[6741] = "Hice que los lóbregos atacaron unas cuantas veces...";
    text[6742] = "y siempre los vencí.";
    text[6743] = "Hice el papel de héroe.";
    text[6744] = "Nadie sospechó nunca nada.";
    text[6745] = "El único cable que dejé suelto fue... el Matalóbregos.";
    text[6746] = "Afortunadamente, al final todo acabó encajando.";
    text[6747] = "Nunca te perdonaré por lo que has hecho...";
    text[6748] = "Me arrebataste a mi madre... Nos la arrebataste a todos...";
    text[6749] = "¡Saros, esto termina aquí!";
    text[6750] = "¡Vas a pagar por tus crímenes!";
    text[6751] = "¡JA, JA, JA, JA!";
    text[6752] = "¡SOIS TODOS UNOS IDIOTAS!";
    text[6753] = "¡SOIS TODOS UNOS INGENUOS!";
    text[6754] = "... ¡Y SOIS TODOS DÉBILES!";
    text[6755] = "¡SIN MÍ, LA HUMANIDAD ESTÁ ACABADA! EL MUNDO NECESITA UN CIENTÍFICO DESQUICIADO...";
    text[6756] = "... ALGUIEN DISPUESTO A HACER LO QUE NADIE HARÍA JAMÁS.";
    text[6757] = "¡ALGUIEN DISPUESTO A HACER SACRIFICIOS EN NOMBRE DEL PROGRESO!";
    text[6758] = "¡TE EQUIVOCAS!";
    text[6759] = "¡JA, JA, JA! NO ERES RIVAL PARA MÍ.";
    text[6760] = "PRONTO DESCUBRIRÁS,";
    text[6761] = "¡QUE LA VIDA ES UN EXPERIMENTO!";
    text[7445] = "... ¡Y QUE EL UNIVERSO ES MI LABORATORIO!";
    text[6822] = "Parece que tu resolución era mayor que la mía...";
    text[6762] = "¿Cómo?";
    text[6763] = "¿CÓMO TE HAS VUELTO TAN FUERTE?";
    text[6764] = "No luchamos únicamente por nosotros, Saros.";
    text[6765] = "Luchamos por la gente de Luna.";
    text[6766] = "¡Luchamos por nuestro futuro!";
    text[6767] = "Bella, no entiendes lo que se avecina...";
    text[6768] = "Yacimiento arqueológico 9... Tu madre fue la primera que lo descubrió...";
    text[6769] = "Una extraña reliquia, parecida a una luna creciente...";
    text[6770] = "Tenía unos escritos ocultos que solo ella podía descifrar.";
    text[6771] = "Esos textos... eran advertencias dejadas por los Antiguos.";
    text[6772] = "Revelaban la auténtica naturaleza del cometa Coda.";
    text[6773] = "¿...?";
    text[6774] = "¿Crees que estamos dispuestos a creerte?";
    text[6775] = "No vas a salir de esta, Saros.";
    text[6776] = "Se acabaron los engaños.";
    text[6777] = "Digo la verdad. Es información clasificada. ";
    text[6778] = "Ellos... eliminaron a los Antiguos.";
    text[6779] = "Ellos... ¿De quién estás hablando?";
    text[6780] = "De nuestro auténtico enemigo...";
    text[6782] = "El cometa Coda es una especie de entidad cósmica...";
    text[6783] = "... creada por una civilización conocida como Némesis.";
    text[6784] = "Son los responsables de la desaparición de los Antiguos.";
    text[6785] = "También acabaron con la gente de Terra hace mil años...";
    text[6786] = "...";
    text[6787] = "¿Por qué...";
    text[6788] = "por qué harían algo así?";
    text[6789] = "No lo sé.";
    text[6790] = "Lo que sé es...";
    text[6791] = "Los Antiguos, una civilización mucho más avanzada que nosotros...";
    text[6792] = "... no pudo detener a Némesis.";
    text[6793] = "Nuestra mejor opción es evolucionar... convertirnos en seres hechos de antimateria.";
    text[6794] = "... Así tal vez tengamos una oportunidad.";
    text[6795] = "Te equivocas en algo.";
    text[6796] = "... ¿En qué?";
    text[6797] = "Evolucionamos cada día.";
    text[6798] = "Lo que nos permitirá avanzar, más que nada...";
    text[6799] = "... más que el sacrificio...";
    text[6800] = "... más que el miedo...";
    text[6801] = "... es la unidad.";
    text[6802] = "La humanidad es fuerte.";
    text[6803] = "Aprendemos de nuestros errores.";
    text[6804] = "Cuando nos caemos... volvemos a levantarnos y lo intentamos de nuevo.";
    text[6805] = "No permitiré que la historia se repita.";
    text[6806] = "Encontraremos una solución a esto juntos, Saros.";
    text[6859] = "Te lo prometo, encontraremos una manera de sobrevivir.";
    text[6861] = "No permitiremos que Némesis nos derrote.";
    text[6860] = "Siempre hay esperanza.";
    text[6807] = "El suero de lóbrego... no es la solución.";
    text[6808] = "...";
    text[6809] = "¡AAARGH!";
    text[6810] = "¿Qu-qué le pasa?";
    text[6811] = "Su cuerpo... ¡no está acostumbrado a tanto poder!";
    text[6840] = "¡La antimateria está empezando a consumirle!";
    text[6812] = "Bella... ¡Mis sensores detectan una enorme acumulación de poder!";
    text[6814] = "No puedo... controlarla...";
    text[6815] = "Mi suero... todavía está incompleto...";
    text[6816] = "Solo llegué a alcanzar un 99% de resonancia...";
    text[6817] = "A pesar de eso, lo usé conmigo mismo.";
    text[6818] = "Bella...";
    text[6841] = "Tú elegiste tu camino.";
    text[6842] = "Yo elegí el mío.";
    text[6843] = "... y me ha llevado hasta aquí.";
    text[6844] = "No me arrepiento de nada.";
    text[6845] = "Si no puedo proteger a la humanidad...";
    text[6846] = "Te corresponde a ti mantenerla a salvo.";
    text[6847] = "Mi sueño nunca morirá.";
    text[6850] = "Yo soy...";
    text[6851] = "... ¡LA EVOLUCIÓN!";
    text[6828] = "¡Bellaaaa!";
    text[6829] = "¿Estáis todos bien?";
    text[6830] = "... ¿Y qué demonios es esa horrible monstruosidad?";
    text[6833] = "Ese es Saros, el científico desquiciado.";
    text[6834] = "¿EN SERIO?";
    text[6835] = "Utilizó el suero consigo mismo y no tuvo el efecto que esperaba...";
    text[6823] = "Finalmente, se transformó en un lóbrego.";
    text[6821] = "¡Nos ataca!";
    text[7450] = "¡Mueh! ¡Es demasiado peligroso quedarnos aquí!";
    text[7451] = "Papá... Han pasado casi 72 horas...";
    text[7452] = "¡Tienes que volver a Luna de inmediato!";
    text[7453] = "¿Y qué hay de vosotros?";
    text[7454] = "¡Vamos a quedarnos aquí y terminar la misión!";
    text[6838] = "No podemos permitir que escape a través de un agujero de gusano.";
    text[6839] = "Si no le derrotamos aquí y ahora, ¡acabará destruyendo Luna!";
    text[6852] = "¡No vamos a permitir que eso ocurra!";
    text[7456] = "En ese caso...";
    text[7457] = "... ¡le mostraremos el auténtico poder de la Fuerza Lunex!";
    text[7458] = "Te estaremos esperando.";
    text[7459] = "¡Gracias, papá!";
    text[7461] = "Raine, te importaría...";
    text[7462] = "Tranquila. Srta. Guerrera Prodigio.";
    text[7463] = "Llevaremos a los tres de regreso a Luna sanos y salvos.";
    text[7464] = "... ¡y volveremos aquí de inmediato cuando lo hayamos hecho!";
    text[7465] = "¡Me debes otra revancha, así que ni se te ocurra perder contra esa bestia!";
    text[7466] = "¡Con Nickle y Tetra a mi lado, perder es imposible!";
    text[7467] = "¿Verdad, equipo?";
    text[7468] = "¡VERDAD!";
    text[6853] = "¡Ha llegado el momento!";
    text[6862] = "¡Nuestra última misión!";
    text[6863] = "¿Estás listo, Nickle?";
    text[6864] = "¡Cuando tú quieras!";
    text[6865] = "¿Tetra?";
    text[6866] = "¡Tetra, la heroína definitiva, está lista!";
    text[6867] = "¡Bien, preparémonos para el combate!";
    text[6868] = "Buff... Buff...";
    text[6869] = "¿Hemos... ganado?";
    text[6870] = "GRRRRRAAARGH.";
    text[6871] = "No puede ser...";
    text[6872] = "Todavía le queda energía...";
    text[6873] = "Estábamos... tan cerca...";
    text[6874] = "Buff... Buff...";
    text[6875] = "Mi cuerpo ha llegado... a su límite...";
    text[6876] = "Tetra, ¿cuánta carga te queda?";
    text[6877] = "¿Puedes volar?";
    text[6878] = "Apenas... Me queda poca energía.";
    text[6879] = "¡Coge a Nickle y llévatelo de aquí!";
    text[6880] = "¡¿QUÉ?! ¡NO!";
    text[6881] = "No vamos a dejarte.";
    text[6882] = "Estamos en esto juntos, hasta el final.";
    text[6883] = "Tetra... Nickle...";
    text[6884] = "¡Agarraos! ¡ESCUDO DE ENERGÍA!";
    text[6885] = "¡HOLOESCUDO!";
    text[6886] = "Buff... Buff...";
    text[6887] = "Diablos... Nuestro escudo... ¡se está rompiendo!";
    text[6888] = "¡Barrera Fotónica!";
    text[6889] = "¡Es el Escuadrón Raine!";
    text[6890] = "¡Te cubrimos las espaldas, Bella!";
    text[6891] = "¡Vamos, chicas! ¡Activad vuestros escudos!";
    text[6893] = "¡Recibido! ¡Escudo Mineral!";
    text[6894] = "¡Anillo de Plasma!";
    text[6895] = "Qué demonios... ¿Cómo es posible que un lóbrego sea TAN poderoso?";
    text[6896] = "¡Debéis haberle golpeado muy fuerte para enfadarlo TANTO!";
    text[6897] = "¡No te distraigas, Raine! ¡Mantén el escudo todo lo que puedas!";
    text[6898] = "Si se rompe... ¡Todas estaremos fritos! ¡Debemos sobrevivir!";
    text[7471] = "¡AAAAAAAAH!";
    text[6902] = "... ¡Bella!";
    text[6903] = "¡Despierta, Bella!";
    text[6901] = "Chicas...";
    text[6899] = "Estamos de regreso en Luna... ¿Qué ha pasado?";
    text[6900] = "No lo sé... De pronto caímos en un agujero de gusano y ahora estamos aquí.";
    text[6824] = "¿Reeves? ¿Nyla? ¿Usasteis Celestia?";
    text[6825] = "¡Mueh, no fuimos nosotros! ¡También caímos por un agujero de gusano!";
    text[6826] = "¡¿...?!";
    text[6904] = "¡ES SAROS! ¡VAMOS, TODOS A CUBIERTO!";
    text[6907] = "Parece que he llegado justo a tiempo.";
    text[6909] = "¡¿CHRONOS?!";
    text[6910] = "(Este lóbrego... ¡¿Podría ser?!)";
    text[6911] = "Pero qué... ¿Este lóbrego está de nuestro lado?... ¡¿Y HABLA?!";
    text[6912] = "¡Y que lo digas!";
    text[6913] = "Chronos... Gracias por salvarnos. ¿Cómo has...?";
    text[6914] = "Lo explicaré todo más tarde.";
    text[6915] = "Ahora mismo tenemos asuntos pendientes.";
    text[6916] = "Bella...";
    text[7486] = "Sé que debes estar agotada...";
    text[7487] = "Tal vez necesites cada ápice de energía que te quede";
    text[7488] = "... para mantenerte en pie.";
    text[7495] = "Sí...";
    text[7496] = "Todo el mundo está bastante machacado...";
    text[7489] = "A pesar de la situación actual... ¡no debéis rendiros!";
    text[7490] = "Parece que Saros puede regenerar su antimateria más rápido que otros lóbregos...";
    text[7491] = "Así que solo hay una manera de derrotarle...";
    text[7492] = "¡Debemos combinar nuestras fuerzas en un ataque definitivo!";
    text[6918] = "... Un ataque que pueda dañar el antinúcleo que yace en su interior.";
    text[7494] = "Chicas, ¿vuestros trajes impulsores tienen receptores de plasma?";
    text[7503] = "¡Sí!";
    text[7499] = "Los receptores os permitirán otorgar fuerza a los";
    text[7504] = "proyectiles de plasma generados por el armamento de la Fuerza Lunex.";
    text[7500] = "Pareces conocer muy bien nuestra tecnología militar.";
    text[7501] = "¿Eras un soldado antes de que Saros te convirtiera en un lóbrego?";
    text[7502] = "...";
    text[7505] = "Algo así.";
    text[7506] = "¡Muy bien, escuchadme todos!";
    text[7507] = "¡Tenemos que utilizar todas nuestras fuerzas!";
    text[7508] = "¡CAÑÓN FOTÓNICO!";
    text[7493] = "No puedo...";
    text[7509] = "Contenerlo... ";
    text[7510] = "Es demasiado poderoso...";
    text[7511] = "Buff... Buff...";
    text[6924] = "¡Srta. Bellaaaaa!";
    text[6925] = "¡Puede hacerlo, Srta. Bellaaaa!";
    text[7476] = "Esa voz... ¡Reconozco esa voz!";
    text[7477] = "¡¿No es Mett?!";
    text[7483] = "¡Mueh! ¡No es solo Mett! ¡También hay soldados y civiles!";
    text[7484] = "¿Qué están haciendo todos aquí?";
    text[7472] = "¡Hace poco recibimos un informe que indicaba que algunos de nuestros soldados se estaban reuniendo";
    text[7473] = "para conseguir más aliados por todo Luna!";
    text[7474] = "¡Soldados que antaño fueron leales a Saros decidieron unirse a nuestra alianza!";
    text[7475] = "¡Hasta hubo civiles que se enteraron de las noticias y decidieron marchar juntos!";
    text[7485] = "¡Srta. Bella!";
    text[7479] = "¡Nos hemos reunido aquí porque no tenemos miedo de luchar por lo correcto!";
    text[6927] = "¡Me ha dado el coraje para enfrentarme a mis miedos!";
    text[7478] = "... ¡y nos ha dado a todos esperanza para conseguir un futuro mejor!";
    text[6926] = "¡No se rinda, Srta. Bella!";
    text[7480] = "¡Aguante!";
    text[7481] = "¡Tiene que acabar con Saros de una vez por todas!";
    text[6929] = "¡...!";
    text[6930] = "¿¡Qué es este poder!?";
    text[6931] = "¡Este el poder de tu lux!";
    text[6932] = "La gente de Luna... ha puesto su confianza en ti.";
    text[6933] = "Sus esperanzas, su determinación... Su lux...";
    text[6934] = "... La están canalizando hacia ti, Bella.";
    text[6935] = "Utilízala.";
    text[6936] = "Úsala para proteger a la gente que más quieres.";
    text[6937] = "Este es tu don.";
    text[6938] = "El poder de unir a la gente. ¡Para darles ESPERANZA!";
    text[6922] = "¡El poder del alama es ilimitado!";
    text[6940] = "¡ESCUCHADME TODOS! ¡PONGAMOS FIN A ESTO!";
    text[6941] = "¡Así se habla, Bella!";
    text[6942] = "¡AAAAARGH!";
    text[7512] = "¡Está funcionando!";
    text[7513] = "¡Está retrocediendo poco a poco!";
    text[6943] = "(Es increíble... ¡La lux de todos se ha unido para generar una única fuerza!).";
    text[6944] = "(Adiós... Saros).";
    text[6945] = "¡AQUÍ TIENES! ¡EL PODER DE NUESTRA LUX!";
    text[6946] = "Por fin ha terminado...";
    text[6947] = "¡SÍ, CHICA! ¡Lo conseguimos! ¡MUAH, JA, JA ,JA!";
    text[6948] = "El antinúcleo de Saros...";
    text[6949] = "¿No deberíamos destruirlo?";
    text[6950] = "No... Su alma seguirá atrapada en su interior.";
    text[6951] = "Dejémoslo como está por ahora.";
    text[6952] = "Ya no es una amenaza para la gente de Luna.";
    text[6953] = "Escuchadme todos... Me gustaría aprovechar este momento para hablar con todos vosotros.";
    text[6954] = "... pero no de esta manera.";
    text[6955] = "Espero que seáis comprensivos...";
    text[6956] = "Hace mucho que no uso mi habilidad para percibir almas... ";
    text[6957] = "¡¿...?!";
    text[6960] = "¡¿Mamá?!";
    text[6961] = "¡General Grey!";
    text[6962] = "¡Theaaa!";
    text[6963] = "Es estupendo volver a veros a todos.";
    text[6964] = "Mamá, te he echado tanto de menos...";
    text[6965] = "Yo también te he echado de menos, Bella...";
    text[7532] = "Thea... Eres tú, eres tú de verdad...";
    text[6966] = "Thomas, cariño. Me alegro tanto de volver a verte.";
    text[6967] = "Mamá...";
    text[6968] = "... ¿Cómo sobreviviste en la Zona Fantasma?";
    text[6969] = "Todos pensamos que te habías ido para siempre...";
    text[6970] = "Ese funesto día... Cuando descubrí los experimentos de Saros con los lóbregos,";
    text[6971] = "traté de poner punto y final a sus planes tan pronto como encontré su laboratorio.";
    text[6972] = "Durante nuestro duelo, me pilló desprevenida...";
    text[6973] = "... y usó su máquina de agujeros de gusano para enviarme a la Zona Fantasma.";
    text[6974] = "En ese momento no había tantos lóbregos en la Zona Fantasma como hoy en día.";
    text[6975] = "... Así que no pude escapar a través de un agujero de gusano...";
    text[6976] = "Solo me quedaba una opción...";
    text[6977] = "Durante el duelo con Saros...";
    text[6978] = "conseguí confiscar un tubo del suero de lóbrego que estaba desarrollando.";
    text[6979] = "Tenía 72 horas para tomar una decisión antes de que mi cuerpo empezara a desintegrarse.";
    text[6980] = "Al final...";
    text[6981] = "... utilicé el suero...";
    text[6982] = "... y me convertí en el lóbrego que llamáis Chronos.";
    text[6983] = "Era la única manera de sobrevivir...";
    text[6984] = "¿Cómo ha sido?";
    text[6985] = "¿Eras consciente en tu cuerpo de lóbrego?";
    text[6986] = "Cuando me convertí en lóbrego, no tenía control alguno sobre mi cuerpo.";
    text[6987] = "... Pero mi mente..., mi alma, seguían allí.";
    text[6989] = "Mamá, eres la persona más fuerte que conozco.";
    text[6990] = "Si alguien es capaz de perseverar y sobrevivir... esa eres tú.";
    text[6994] = "Cuando mis habilidades de lux latentes comenzaron a aparecer,";
    text[7516] = "No sabía lo que estaba ocurriendo... o lo que estaba utilizando...";
    text[6992] = "... y cada vez que encontraba un lóbrego, sentía algo dentro de mi alma.";
    text[7517] = "Mi lux reaccionaba ante cada uno de ellos.";
    text[6993] = "Podía oír sus voces, pidiendo ayuda...";
    text[6991] = "Estabas haciendo todo lo que podías para comunicarte conmigo...";
    text[6995] = "Me ha impresionado que hayas conseguido despertar tu capacidad para percibir almas.";
    text[7017] = "Sabes... El motivo por el que nunca te hablé de tu vínculo con los Antiguos...";
    text[7018] = "... es porque las investigaciones que realicé de los Antiguos me han demostrado que este poder...";
    text[7019] = "... podría ser peligroso cuando se despierta.";
    text[7518] = "No quería poner a mi propia hija en peligro.";
    text[7020] = "General Grey, es igual que Bella...";
    text[7021] = "Nunca quiere ser una carga para nadie...";
    text[7022] = "Y trata de evitar que alguien pueda sufrir daño.";
    text[7023] = "¿Me pregunto de quién habrá heredado ese rasgo?";
    text[7024] = "¡El doctor Thomas hace lo mismo!";
    text[7025] = "¡Eh!";
    text[7026] = "Supongo que es algo que está en la familia.";
    text[6996] = "Mamá, ¿tú también sabes la verdad sobre el cometa Coda?";
    text[6997] = "Sí.";
    text[6998] = "Cuando llevabas mi antinúcleo contigo, podía escucharte.";
    text[6999] = "Siempre estaba escuchando.";
    text[7003] = "Un momento... Si eras un antinúcleo...";
    text[7004] = "¡¿Cómo recuperaste tu forma de lóbrego?!";
    text[7005] = "Un protector de los Antiguos, llamado Guardios, tuvo la gentileza de dejarme usar su receptáculo.";
    text[7056] = "Es un milagro que esté aquí. No sabía si esto iba a funcionar.";
    text[7007] = "Gracias a ti, Bella, he podido volver a veros a todos.";
    text[7008] = "Tu bondad... Tu resolución a la hora conseguir la paz a tu manera.";
    text[7009] = "Tu determinación a la hora de hacer lo correcto. ";
    text[7010] = "Podemos decir que soy una mamá CON SUERTE, ja, ja, ja.";
    text[7032] = "Escuchadme todos...";
    text[7027] = "... No podéis permitir que Némesis destruya la humanidad.";
    text[7028] = "¡No lo permitiremos!";
    text[7029] = "¡No mientras estemos aquí!";
    text[7030] = "¡Esos idiotas de Némesis van a recibir el puñetazo especial de Raine!";
    text[7031] = "¡Muah, ja, ja, ja!";
    text[7033] = "No tienen ninguna oportunidad contra nosotros, ¿verdad Nickle?";
    text[7034] = "¡Cierto!";
    text[7035] = "Sra. Grey... Gracias por salvarme la vida hace tantos años.";
    text[7036] = "No ha sido un viaje fácil para mí...";
    text[7520] = "... He tenido que abrirme a los demás... ";
    text[7521] = "Tuve que hacer amigos en lo que pudiera volver a confiar...";
    text[7522] = "Si no le hubiera conocido, o si no hubiera conocido a Bella...";
    text[7523] = "El plan de Saros podría haber triunfado.";
    text[7524] = "Y las cosas habrían sido diferentes...";
    text[7525] = "Os doy las gracias a todos por aceptarme...";
    text[7526] = "... a pesar de todo lo que hice.";
    text[7527] = "Nickle... debes aprender a perdonarte a ti mismo.";
    text[7528] = "No tienes la culpa de que los lóbregos existan.";
    text[7529] = "Lo has hecho bien. ¡Deberías estar orgulloso de todo lo que has conseguido!";
    text[7530] = "¡Gracias, Sra. Grey!";
    text[7037] = "... ¿Puedo confiar en ti para evitar que Bella se meta en problemas?";
    text[7038] = "¡S-sí, señora!";
    text[7039] = "¿Oh?";
    text[7040] = "¿Y quién es esta guerrera tan adorable?";
    text[7041] = "¡Me llamo Tetra!";
    text[7042] = "¡Bella me ha hablado tanto de ti!";
    text[7043] = "¡He sido su ayudante a las duras y a las maduras!";
    text[7044] = "Bella y yo construimos juntos a Tetra.";
    text[7045] = "Cuando desapareciste... Ambos lo pasamos muy mal.";
    text[7046] = "Tetra fue la luz que brilló a través de la oscuridad...";
    text[7047] = "Hizo que estuviéramos más unidos que nunca durante nuestros días más oscuros.";
    text[7048] = "Je, je.";
    text[7049] = "Ya veo. Bueno, entonces creo que mereces un ascenso, Tetra.";
    text[7050] = "¡¿Un ascenso?! ¡¿Yo?!";
    text[7051] = "Eres mucho más que una ayudante.";
    text[7052] = "Eres una auténtica heroína.";
    text[7053] = "Una auténtica heroína...";
    text[7054] = "¡Por tanto, a partir de ahora se me conocerá como superheroína Tetra! ¡Muah, ja, ja, ja!";
    text[7055] = "¡Ja, ja, ja!";
    text[7011] = "¿Qu-qué está pasando, querida?";
    text[7012] = "Este cuerpo... Es solo un receptáculo temporal.";
    text[7013] = "Pronto volveré a mi antinúcleo...";
    text[7014] = "No... Mamá, no puedes volver a dejarnos...";
    text[7015] = "Bella...";
    text[7016] = "... Siempre hay esperanza.";
    text[7000] = "Te has convertido en una guerrera muy fuerte.";
    text[7001] = "Ahora que Saros ha desaparecido, la gente de Luna necesita un nuevo general.";
    text[7058] = "¿P-por qué no tú?";
    text[7059] = "Mi tiempo ha pasado. Ahora es tu  turno de dirigir a la gente.";
    text[7060] = "Sé que tienes lo que hace falta.";
    text[7061] = "Siempre ha estado en tu interior.";
    text[7062] = "El poder para unir a la gente... Para dar esperanza a los demás...";
    text[7063] = "... para llevar a todos a un futuro más brillante.";
    text[7064] = "Estoy orgullosa de ti, Bella.";
    text[7065] = "Mamá...";
    text[7066] = "¡No voy a defraudarte, mamá!";
    text[7067] = "Thea...";
    text[7068] = "Thomas... Te quiero... Cuida de Bella cuando me haya marchado.";
    text[7069] = "Me temo que tendré que descansar durante un tiempo...";
    text[7070] = "Thea... Te lo prometo...";
    text[7071] = "Encontraré una manera de traerte de vuelta.";
    text[7073] = "¡Volveremos a vernos algún día!";
    text[7074] = "Adiós a todos.";
    text[7075] = "¿Estás bien, Bella?";
    text[7076] = "Sí.";
    text[7078] = "Me alegro de que hayamos podido verla de nuevo después de tantos años.";
    text[7534] = "Mi madre siempre será mi heroína.";
    text[7535] = "Ahora mismo, en vez de sentirse triste,";
    text[7536] = "mi corazón se encuentra lleno de esperanza.";
    text[7537] = "¡Habéis hecho un trabajo estupendo!";
    text[7538] = "Hoy hemos vencido gracias a todos vosotros.";
    text[7539] = "Eh, todo esto no hubiera sido posible sin nuestra general.";
    text[7540] = "¡Eso es cierto! ¡No podríamos haberlo hecho sin ti, Bella!";
    text[7542] = "¡Esto hay que celebrarlo! ¡MUAH, JA, JA, JA!";
    text[7543] = "Necesito una barrita de tarta de queso... ¡Me muero de hambre!";
    text[7544] = "... ¡y yo necesito una siesta! Mis piernas apenas me sostienen..";
    text[7545] = "Creo que todos nos hemos ganado un buen descanso antes de nada.";
    text[7546] = "Luego...";
    text[7550] = "¡Lo celebraremos!";
    text[7089] = "La victoria que hemos conquistado hoy...";
    text[7090] = "Marca el inicio de una nueva era.";
    text[7092] = "Nuestro viaje continuará... ";
    text[7093] = "... porque nuestro trabajo no ha terminado todavía.";
    text[7094] = "El cometa Coda sigue acercándose...";
    text[7095] = "... y esta vez... estaremos preparados.";
    text[7096] = "No queda un camino difícil por delante...";
    text[7097] = "... y todavía tenemos mucho que aprender...";
    text[7098] = "...sobre los Antiguos...";
    text[7099] = "... sobre Némesis...";
    text[7100] = "Pero una cosa es clara como el cristal...";
    text[7101] = "Luna es nuestro hogar.";
    text[7102] = "¡No permitiremos que nadie nos lo arrebate!";
    text[7103] = "Encontraremos una manera de sobrevivir.";
    text[7104] = "... ¡utilizando la unidad y la confianza mutua!";
    text[7105] = "Que nuestra lux brille para siempre.";
    text[7106] = "Ocho meses más tarde...";
    text[7107] = "General Grey, los preparativos están listos.";
    text[7108] = "¡Estupendo! Gracias por ponerme al día.";
    text[7109] = "Comandante Nickle, el motor de antimateria les está esperando.";
    text[7110] = "¿Seguro que estarás bien, Nickle?";
    text[7111] = "Va a ser el mayor agujero de gusano que he creado jamás.";
    text[7112] = "Puedo hacerlo. ";
    text[7113] = "Confía en mí, je.";
    text[7114] = "¡MUY BIEN ESCUCHADME TODOS! ";
    text[7115] = "¡Iniciad Celestia!";
    text[7116] = "¡Recibido!";
    text[7117] = "¡Preparaos, fijad las coordenadas del cometa Coda y agarraos bien!";
    text[7118] = "Espero que estéis listos, Némesis...";
    text[7119] = "... ¡pronto la humanidad va a ir a por TI!";
    text[110000] = "¡Vamos, Bella! ¡Adelante!";
    text[110001] = "¡Nuestra nave está atracada en el Astropuerto Sureste!";
    text[110003] = "Ñam, ñam, ñam... ¡Esta comida tiene muy buena pinta!";
    text[110004] = "¡Bzz! ¡Bzzz! ¡Ese hyperbee era fuerte!";
    text[110007] = "¡Vamos a por unas barritas de tarta de queso en el café!";
    text[110008] = "Todavía no he terminado mi comida, así que quedémonos un poco más.";
    text[110009] = "De acuerdo.";
    text[110010] = "Los lugareños son bastante agradables. ¿Y si hablamos con algunos?";
    text[110012] = "¡Nuestra nave nos espera! ¡Vamos que nos vamos!";
    text[110013] = "¡Vayamos al oeste para estudiar la Instalación de la Barrera!";
    text[110014] = "Espero que el piloto esté bien... ¡Ese lóbrego parecía espeluznante!";
    text[110015] = "Bella, últimamente te comportas de manera muy rara.";
    text[110016] = "No te preocupes... Estoy bien.";
    text[110017] = "¡El nivel de oxígeno está al 97%!";
    text[110018] = "¡Vamos a ver qué ha causado la brecha!";
    text[110019] = "¡Dos lóbregos acaban de pasar! ¡Vamos a buscarlos!";
    text[110020] = "Siento que el lóbrego estaba furioso porque su amigo había muerto...";
    text[110021] = "El lóbrego debería seguir por aquí, en alguna parte...";
    text[110022] = "¡Debemos encontrarlo!";
    text[110023] = "Debe haber alguien por aquí que tenga conocimientos sobre paneles lunares.";
    text[110024] = "Es decir, si hablamos con TODOS, al final daremos con la persona adecuada.";
    text[110025] = "Eh, eh, espera un segundo.";
    text[110026] = "No tenemos tiempo para hablar con todo el mundo.";
    text[110027] = "Sí, tienes razón.";
    text[110028] = "¡Oh! ¡Activaré mis sistemas de guía en misiones!";
    text[110029] = "¿Y eso? No recuerdo haber instalado un SGM.";
    text[110030] = "Debe haber sido algo que mi padre programó por su cuenta.";
    text[110031] = "Básicamente, el SGM nos llevará a las zonas que más nos interesan.";
    text[110032] = "Podremos ver un indicador sobre ciertas personas u objetos.";
    text[110033] = "¡Los indicadores pueden ser de gran ayuda en nuestras misiones!";
    text[110034] = "Algunos indicadores hasta podrían llevarnos a personas que necesitan nuestra ayuda.";
    text[110035] = "Si la vida fuera un videojuego, estas situaciones se llamarían «tareas secundarias».";
    text[110036] = "... Ja, ja, eso tiene gracia.";
    text[110037] = "¿No es cierto que el SGM nos ayudó a encontrar al moleculoid un poco antes?";
    text[110038] = "¡Oh, sí! Supongo que ha estado activado todo el rato.";
    text[110039] = "¡Aparecerá un indicador amarillo sobre la persona que estamos buscando!";
    text[110068] = "¡Sí! ¡Ya tenemos 10 paneles lunares!";
    text[110069] = "Ahora solo necesitamos un generador termoeléctrico.";
    text[110070] = "¡Nyla dijo que podríamos encontrar uno si hablamos con un mercader de astrotecnos!";
    text[110071] = "¡Echemos un vistazo a la Instalación de la Barrera!";
    text[110066] = "¡Por fin tenemos 10 paneles lunares y 1 generador termoeléctrico!";
    text[110067] = "¡Vayamos a ver a Nyla!";
    text[110040] = "¡Paneles lunares, paneles lunares...! ¿Dónde estáis, paneles lunares?";
    text[110041] = "¡Necesitamos al menos 10 paneles lunares de la Unidad de Almacenaje,";
    text[110042] = "y un generador termoeléctrico de un mercader de astrotecnos!";
    text[110043] = "Los astrotecnos son divisas mucho más escasas que los bytes.";
    text[110044] = "Si exploras Luna a fondo,";
    text[110045] = "es posible que encuentres astrotecnos ocultos en algunos sitios.";
    text[110046] = "¡Deberíamos estar buscando objetos útiles en todo momento! Je, je.";
    text[110047] = "¡Reunámonos con todos en el aerodeslizador!";
    text[110048] = "¡Bella, volvamos a nuestra nave cuando estés lista!";
    text[110049] = "Tetra no está contigo en este momento.";
    text[1021] = "Me está contando conseguir datos precisos sobre este entorno...";
    text[1022] = "La composición química del aire y el suelo es desconocida.";
    text[1023] = "Tetra no sabe cómo eres capaz de respirar aquí...";
    text[1380] = "Bella, ¡tratemos de encontrar una manera de salir cuanto antes!";
    text[110050] = "¡La Estación Espacial Lunex es enorme, así que procura recordar su distribución!";
    text[110051] = "¡El Laboratorio de Investigación está en la planta 3!";
    text[110052] = "Está en el corredor oeste, je. ¡Vamos allá!";
    text[2482] = "Mmm, me pregunto qué es lo que vamos a hacer en Oceanus.";
    text[2543] = "¡Tenemos que explicarle nuestro plan al doctor Thomas! ¡Vayamos a la Estación Espacial!";
    text[110053] = "¡Los lóbregos están atacando Copernicus!";
    text[110054] = "¡Tenemos que ir a echar una mano! ¡Es una misión de emergencia!";
    text[110055] = "¡Esforcémonos al máximo para salvar a todas las personas que podamos!";
    text[2709] = "¡Tenemos que encontrar las 4 máquinas de filtrado y restaurar la red de depuración!";
    text[2978] = "¡Deberíamos ir a la azotea del edificio de depuración!";
    text[2979] = "¡Tenemos que tener una charla con el Matalóbregos!";
    text[3206] = "Bella, pareces agotada... ¡Tienes que descansar!";
    text[3207] = "¡Volvamos a casa, a tu habitación, para dormir un poco!";
    text[3854] = "¡Vamos a ver qué está haciendo el doctor Thomas en el Laboratorio de Investigación!";
    text[3855] = "¡Es hora de comprobar si tenemos algunas misiones nuevas!";
    text[3856] = "¡Stella nos hará un resumen! Vamos al vestíbulo, en la planta 1, je.";
    text[3857] = "¡Parece que tenemos unas cuantas misiones que hacer!";
    text[3858] = "Si necesitas más información sobre las misiones, creo que lo mejor es";
    text[3859] = "echar un vistazo al PANEL DE MISIONES y hablar con Stella para que nos dé más detalles.";
    text[3860] = "¡Aparecerá un indicador ROJO sobre las personas o los puntos de interés vinculados a las misiones!";
    text[4201] = "¡El doctor Thomas ha regresado de su conferencia!";
    text[4202] = "¡Vamos a hablar con él en el Laboratorio de Investigación!";
    text[4203] = "¡Tenemos la LLAVE LUNEX! Ahora podemos entrar en la Base Militar.";
    text[4204] = "¡Vamos a la Base Militar, Tetra! ¡Está en la Zona Yerma!";
    text[4236] = "Las Alcantarillas ... ¡Puaj! ";
    text[4237] = "Yo tampoco quiero ir a las Alcantarillas, pero no tenemos otra opción...";
    text[4248] = "¡Encontremos la celda del Matalóbregos!";
    text[4293] = "Tendríamos que encontrar el panel de control que está conectado a la puerta verde.";
    text[4307] = "¡Veamos si el Matalóbregos está en la celda de la puerta verde!";
    text[4291] = "El Matalóbregos debería estar en una de las salas de la Base Militar.";
    text[4292] = "¡Tendremos que buscar en todos los rincones!";
    text[4512] = "¡Tenemos que salir de la Base Militar cuanto antes! ¡Vayamos a la primera planta!";
    text[4518] = "¡Tenemos que ir al este, al Cráter de la Oscuridad Eterna!";
    text[110056] = "¡Busquemos una manera de salir de aquí mientras Vivia sigue paralizada!";
    text[110057] = "Ya estamos en las Fosas de Silica, ahora tenemos que ir al este, a la Colonia.";
    text[110058] = "Eh, yo soy la ayudante. Yo soy la encargada de los recordatorios. Hum.";
    text[110059] = "Tenemos que buscar a Cypher. ¡Él puede ayudarnos a encontrar una nave espacial!";
    text[110060] = "Echo de menos nuestra vieja nave espacial.";
    text[110061] = "La abandonamos delante de la Base Militar.";
    text[110062] = "Podemos volver allí más tarde y recuperarla.";
    text[110063] = "¡Al menos tenemos una minicápsula completamente cargada para volar!";
    text[110064] = "Supongo que sí...";
    text[110065] = "... En fin, el escondite de Nickle está en algún lugar de Oceanus. ¡Vamos allá!";
    text[110072] = "Parece que vamos a darnos un baño...";
    text[110073] = "... ¡porque la entrada al escondite de Nickle está bajo el agua!";
    text[5486] = "¡Vaya, hay rocas luminiscentes por todas partes en estas ruinas!";
    text[5487] = "Menos mal... ¡porque olvidé traer una linterna!";
    text[5501] = "¡Necesitamos CUATRO GEMAS que se encuentran en algún lugar de estas ruinas!";
    text[5502] = "Y CUANDO LAS ENCONTREMOS, TETRA SERÁ CONOCIDA COMO LA GRAN";
    text[5503] = "AYUDANTE DE LA PERCIBEALMAS.";
    text[5504] = "¿Bella?";
    text[5505] = "¿Sí?";
    text[5506] = "¿Qué es un percibealmas?";
    text[5507] = "Si te digo la verdad, no lo sé. Tengo algunas ideas, pero...";
    text[5508] = "... ¡centrémonos primero en superar la Prueba del Alma!";
    text[5509] = "Vale, jeje.";
    text[6001] = "¡Sí! ¡Hemos superado la Prueba del Alma!";
    text[6002] = "¡Por fin podemos atravesar la puerta gigante que estaba cerrándonos el paso!";
    text[5779] = "¡Muy bien! Siguiente parada: ¡Estación Espacial Lunex!";
    text[6003] = "¡Tenemos que elaborar un plan para detener a Saros!";
    text[6209] = "Eeeh, ¿dónde voy a dormir?";
    text[6210] = "Mmm... Supongo que en mi habitación.";
    text[6211] = "¿Cómo? P-pero eso no es...";
    text[6212] = "... ¿Entonces no quieres dormir en mi habitación?";
    text[6213] = "Hay cápsulas para dormir en las cámaras de curación que puedes utilizar.";
    text[6214] = "... No, quiero decir...";
    text[6215] = "No sé muy bien cómo moverme por la Estación Espacial...";
    text[6216] = "Es muy probable que acabe perdiéndome... Así que es mejor que me quede contigo...";
    text[6217] = "(Aaay...). Sígueme.";
    text[6218] = "... ¿Seguro?";
    text[6219] = "¿Entonces dónde vas a dormir?";
    text[6220] = "Supongo que en el suelo... Tengo una alfombra muy agradable, je.";
    text[6221] = "¡No te preocupes, Nickle!";
    text[6222] = "¡Eres mi invitado! Dormirás en la cama.";
    text[6223] = "Oh, y... Tetra también duerme en la cama, así que...";
    text[6224] = "No importa, yo dormiré en el suelo.";
    text[6225] = "¡¿Cómo?! ¿Por qué has cambiado de idea?";
    text[6226] = "A veces mis manos se encienden cuando duermo.";
    text[6227] = "Podría fundirte accidentalmente...";
    text[6228] = "Y además... ¿Los robots duermen?";
    text[7126] = "¡Están atacando la Estación Espacial Lunex!";
    text[7127] = "¡Tenemos que encontrar a los lóbregos de esta zona y derrotarlos!";
    text[7192] = "Habías olvidado algo en tu habitación, ¿recuerdas?";
    text[7193] = "Muy bien, ¡vayamos al Laboratorio Nexus!";
    text[7194] = "¡Usaremos Celestia para entrar en la Base Militar!";
    text[7245] = "La oficina de Saros parece muy tranquila... ¿Es posible que no esté aquí?";
    text[7246] = "Vayamos con cuidado por si acaso. Podría ser una trampa.";
    text[7389] = "Esa máquina de agujeros de gusano del Laboratorio Secreto se parece a Celestia...";
    text[7390] = "¡Echémosle un vistazo más de cerca!";
    text[7391] = "¡Saros tiene al doctor Thomas de rehén en algún lugar de la Zona Fantasma!";
    text[7392] = "También tiene todos los antinúcleos que he reunido...";
    text[7393] = "¡Tenemos que encontrarle y detenerle de una vez por todas!";
    text[7438] = "...";
    text[7552] = "¡Hoy parece un día estupendo para vivir una aventura!";
    text[7553] = "¡Tal vez deberíamos echar un vistazo al PANEL DE MISIONES de la Fuerza Lunex y completar algunas misiones!";
    text[7554] = "... ¡O tal vez podríamos buscar algunos lóbregos fuertes con los que luchar!";
    text[7555] = "Me muero por entrenar un poco.";
    text[7556] = "¡Tenemos que asegurarnos de estar en buena forma!";
    text[7557] = "¿Por qué no hacemos las dos cosas? Je.";
    text[7558] = "¡Después podemos relajarnos en un café tomando algunas barritas de queso!";
    text[7559] = "¡Yo invito!";
    text[1337] = "Es un cubo hertziano abandonado.";
    text[1338] = "Se suelen utilizar para guardar y proteger divisas o bienes valiosos.";
    text[1335] = "Parece que este cubo hertziano está cerrado.";
    text[1336] = "Mmm... ¿Tal vez deberíamos usar los láseres para abrirlo?";
    text[562] = "En el monolito están grabados los nombres de guerreros lunex caídos.";
    text[563] = "El primer nombre de la placa es:";
    text[564] = "Thea Grey\n, general de la Fuerza Lunex.";
    text[565] = "¡Es un barril chapado en acero!";
    text[566] = "Esta baliza cuenta con un sensor de oxígeno.";
    text[567] = "Los Laboratorios Lunex usan los datos recogidos por este sensor para estudiar las condiciones en Luna.";
    text[568] = "¡Qué guay! ¡Este elemento luminoso es termoluminiscente!";
    text[569] = "¡¿Cómo?! ¿Termoluminisqué?";
    text[570] = "¡Contiene una piedra que se ilumina cuando se calienta!";
    text[571] = "¡Oooooh! ¡Qué pasada!";
    text[572] = "¡El Café Regolithia os da la bienvenida!";
    text[573] = "Especialidad: ¡Barritas Cruj-E!\nEspecial de hoy: ¡Ramen de miso!\nBebida más popular: ¡Refrescos!";
    text[574] = "Es un letrero de neón que dice «Café».";
    text[575] = "¡Parece que un nuevo envío de deliciosa comida acaba de llegar!";
    text[576] = "Mmm... ¡Tetra empieza a tener hambre!";
    text[577] = "¿Has olvidado que no puedes comer?";
    text[578] = "Ah, sí... Pero tengo hambre de otras cosas.";
    text[579] = "¿Por ejemplo?";
    text[580] = "Mmm... ¡ESO ES UN SECRETO! Ja, ja, ja.";
    text[581] = "Es una taza de café recién hecho.";
    text[582] = "Creo que todavía no hemos llevado a papá a Café Regolithia.";
    text[583] = "¡He oído que hacen un café bastante bueno!";
    text[584] = "Pero el doctor Thomas debería beber menos café... ¡Toma demasiado!";
    text[585] = "Se han instalado un montón de paneles lunares en la viga.";
    text[586] = "Estos paneles son vitales para producir la energía que necesitan los residentes del sector 16.";
    text[587] = "Alguien ha pintado una «X» y una «Z» en un lado del acantilado.";
    text[588] = "«Scientia Potentia Est»\nEl conocimiento es poder";
    text[589] = "Este monumento se construyó en honor de los incontables avances científicos";
    text[590] = "que la humanidad ha realizado a lo largo del tiempo.";
    text[591] = "Los receptáculos pueden aterrizar y despegar en las zonas en las que brilla este cristal de iluminación.";
    text[592] = "Hay una pequeña nota en la caja que dice:";
    text[593] = "Flecha 1: Izquierda";
    text[594] = "¿Y esto? Bella, ¿qué puede significar?";
    text[595] = "No estoy segura, pero podría ser útil para algo...";
    text[596] = "¡Mantengamos los ojos abiertos, puede haber más!";
    text[597] = "¡Estupendo! La superdetective Tetra está lista, je.";
    text[598] = "Flecha  2: Abajo";
    text[599] = "Flecha  3: Izquierda";
    text[600] = "Flecha  4: Derecha";
    text[601] = "Flecha 5: Arriba";
    text[602] = "¡Es un cartel en el que aparecen dos personajes muy molones de un videojuego!";
    text[603] = "El pie del cartel dice: El legado de la Red Cósmica";
    text[604] = "¡Es un cartel en el que aparecen un personaje muy molón de un videojuego!";
    text[605] = "El pie del cartel dice: El legado de la Onda Final";
    text[606] = "¡Es un mapa de Luna!";
    text[607] = "Alguien ha dejado una nota aquí. Lo que hay escrito es difícil de leer:";
    text[608] = "Ins-tal-ción b-rre-\nDos pi-la-r-s n-gr-os\nTr-ngul- roj-";
    text[609] = "Parece que un aire gélido sale de la enorme tubería que hay arriba.";
    text[611] = "CUIDADO: ZONA DE ALTO VOLTAJE";
    text[612] = "NO PASAR";
    text[613] = "Acceso reservado al personal autorizado de la Instalación de la Barrera.";
    text[614] = "Es un sicomoro lunar.";
    text[615] = "El líquido de la cúpula aporta los nutrientes que el árbol necesita para crecer.";
    text[616] = "Es un precioso matorral de camelias lunares.";
    text[617] = "Una de ellas está un poco marchita.";
    text[618] = "Es un precioso macizo de camelias lunares.";
    text[619] = "Es una lápida hecha de obsidiana lunar especial.";
    text[620] = "Las marcas azules se han formado al absorber continuamente la intensa luz del sol.";
    text[621] = "En la inscripción pone «Sol».";
    text[622] = "En la inscripción pone «Esperanza».";
    text[623] = "En la inscripción pone «Espíritu».";
    text[624] = "En la inscripción pone «Paz».";
    text[625] = "En la inscripción pone «Leyendas».";
    text[626] = "En la inscripción pone «Luz estelar».";
    text[627] = "En la inscripción pone «Lux».";
    text[628] = "En la inscripción pone «Sombra».";
    text[772] = "Parece que hay algo brillante en esta papelera...";
    text[773] = "... Solo era basura.";
    text[774] = "Echas un nuevo vistazo a la papelera...";
    text[775] = "Sigue habiendo solo basura.";
    text[776] = "Has comprobado tres veces esta papelera...";
    text[777] = "No contiene nada útil.";
    text[778] = "¿¿Solo hay basura??";
    text[779] = "Has comprobado cuatro veces esta papelera...";
    text[780] = "... e, inmediatamente después, compruebas su contenido una quinta vez.";
    text[781] = "El interior de esta papelera es como un agujero negro, listo para tragar basura.";
    text[782] = "¡¿En esta papelera...?!";
    text[783] = "Solo hay basura...";
    text[784] = "¿Bella?";
    text[785] = "¿Sí?";
    text[786] = "¿Por qué rebuscas tanto en las papeleras?";
    text[787] = "Je, je, je...";
    text[788] = "Solo soy curiosa, ¿vale?";
    text[789] = "¿No llaman a esto bucear en la basura?";
    text[790] = "... ¿Tetra?";
    text[791] = "¿Sí?";
    text[792] = "Esto debe quedar entre tú yo, ¿vale?";
    text[793] = "Ja, ja, ja, ¡tranquila!";
    text[1041] = "Estas taquillas están llenas de ropa y trajes para disfrazarse.";
    text[1042] = "Hay una pegatina que dice «Tío guay» en esta taquilla.";
    text[1043] = "Es un interruptor multiusos.";
    text[1044] = "¡Tiene incorporados un sensor de ocupación, un interruptor de iluminación y un termostato!";
    text[1045] = "Está ocupado.";
    text[1046] = "-Cuarto de baño-";
    text[1047] = "Aquí hay gente que pide un menú de 3 platos.";
    text[1048] = "Y otros que solo quieren una rodaja de melón.";
    text[1049] = "Es la belleza de la vida.";
    text[1050] = "Los pastelitos de chocolate son los mejores pastelitos que hay.";
    text[1051] = "Es una taza de café hirviendo... ¡con una dosis extra de expreso!";
    text[1052] = "¡Onigiris!";
    text[1053] = "Mmm, ¡ese ramen de miso tienen un aspecto delicioso!";
    text[1054] = "Hay un surtido de comida deliciosa en la mesa.";
    text[1055] = "¡Es una hamburguesa vegetariana y un perrito picante!";
    text[1056] = "¡El frigorífico está lleno de bebidas heladas!";
    text[1057] = "¡Hay una gran variedad de comida deliciosa en el frigorífico!";
    text[1058] = "En esta máquina expendedora se venden aperitivos muy populares.";
    text[1059] = "NOOOOOO, QUERÍA MÁS BARRITAS DE TARTA DE QUESO...";
    text[1060] = "¡Tienen barritas Cruj-E!";
    text[1061] = "No.";
    text[1062] = "No es lo mismo.";
    text[1063] = "Este dispositivo controla los niveles de oxígeno en la habitación.";
    text[1064] = "El dibujo del calendario muestra un fondo negro con un corazón pixelado.";
    text[1065] = "Se titula: «Determinación».";
    text[1066] = "Es un tanque de aire comprimido.";
    text[1067] = "Es un bonito armario gris.";
    text[1068] = "¡Esta caja de herramientas es enorme!";
    text[1069] = "Es una ilustración que muestra a un explorador espacial.";
    text[1070] = "¡Es una cápsula para dormir!";
    text[1071] = "Posee múltiples funciones para ofrecer la mayor comodidad mientras duermes.";
    text[1072] = "Hay una etiqueta de envío que dice: enviado desde Rancho Kepler.";
    text[1073] = "Hay tanques de oxígenos extra en la pared para usar en caso de emergencia.";
    text[1074] = "¡Es un RPG que parece muy divertido!";
    text[1075] = "Sientes la súbita necesidad de «conectar» tu propio mando y jugar.";
    text[1076] = "Un libro que se llama «Desarrollo de juegos básico». El otro es una guía de un videojuego.";
    text[1077] = "Hay una fila de videojuegos en la estantería..";
    text[1078] = "Space Boy, Lawmage Academy, S.F. 4, Monsters of Kanji, Berserk Boy,";
    text[1079] = "Oslo the Professional, CODE: Bunny, Endwave...";
    text[1080] = "... ¡Todos esos juegos molan mogollón!";
    text[1081] = "Esta Unidad de Almacenaje contiene artículos esenciales para sobrevivir en las expediciones espaciales.";
    text[1082] = "-Solo personal autorizado-";
    text[1083] = "Este contenedor de almacenaje contiene comida empaquetada.";
    text[1084] = "Capa paquete está envasado al vacío.";
    text[1101] = "Estas cajas contienen gran cantidad de recambios que se usan en las misiones espaciales.";
    text[1085] = "Este contenedor de almacenaje contiene elementos de propulsión realmente antiguos.";
    text[1086] = "Es probable que lleven décadas aquí.";
    text[1087] = "Este contenedor de almacenaje contiene material de aislamiento térmico.";
    text[1088] = "Este contenedor de almacenaje contiene equipo de despresurización.";
    text[1089] = "Vaya, ¿a que no dices despresurización tres veces seguidas a toda velocidad? ";
    text[1090] = "Este contenedor de almacenaje contiene maquinaria para eliminar dióxido de carbono.";
    text[1091] = "Este contenedor de almacenaje contiene un dispositivo de condensación de agua.";
    text[1092] = "Previene la corrosión de equipo delicado.";
    text[1093] = "Este contenedor de almacenaje contiene sistemas de protección contra la radiación.";
    text[1094] = "Hace décadas, cuando la humanidad ya vivía en este satélite,";
    text[1095] = "la exposición continua a la radiación era un serio problema.";
    text[1096] = "Este contenedor de almacenaje contiene repuestos para equipos de comunicación.";
    text[1097] = "Este contenedor de almacenaje está vacío.";
    text[1098] = "Hay antiguos trajes espaciales en esta caja de almacenaje.";
    text[1099] = "Hay algunos terminales y cables en la caja de herramientas. Bah, nada interesante.";
    text[1100] = "Esta caja de herramientas contiene algunas herramientas para soldar.";
    text[1102] = "Este contenedor de almacenaje contiene kits de higiene de repuesto.";
    text[1114] = "Es un plato de gelato. ¿Todavía no te apetece un dulce?";
    text[1115] = "Uno de los mejores postres que existen: flan de leche.";
    text[1116] = "¡Dulces ácidos!";
    text[1117] = "En la maceta solo hay una camelia. ¡Parece bastante saludable!";
    text[1118] = "¡Gracias por visitar el Café Regolithia!";
    text[1119] = "A veces el mejor refresco es un buen vaso de agua helada.";
    text[1120] = "Vaya, ¿aquí también tienen sushi? ¡¡Qué rico!!";
    text[1121] = "Hay unas letras en el cartel que dicen «¡Lucha contra el poder!».";
    text[1122] = "Han colgado dos gi para artes marciales húmedos en la pared para que se sequen.";
    text[1123] = "Es un libro llamado: El mundo perdido de Terra.";
    text[1124] = "Un montón de figuras de acción con forma de robot y aspecto caro están expuestas en la vitrina de cristal.";
    text[1125] = "Es una pantalla para múltiples propósitos.";
    text[1126] = "Dentro de la caja de herramientas hay un montón de juguetes.";
    text[1127] = "En la tele están poniendo un anime llamado Yo-King.";
    text[1128] = "¡Los personajes libran duelos usando yoyós en cuyo interior hay selladas poderosas bestias!";
    text[1129] = "Parece bastante guay.";
    text[1130] = "Hay un montón de cómics y mangas en la estantería.";
    text[1131] = "Hay un montón de consolas portátiles dentro.";
    text[1132] = "¿Ese es CosmicSans, de Hyper Smash Fighters?";
    text[1133] = "Esta escotilla permite acceder a la Instalación de la Barrera, que se encuentra en las profundidades.";
    text[1134] = "Ahora mismo no tenemos que ir allí...";
    text[1035] = "Hay algunos paneles lunares instalados en el pilar horizontal.";
    text[1036] = "Parece que la idea era instalar más.";
    text[1037] = "¡Es la Astrobarrera!";
    text[1325] = "¡Es un carguero de suministro modelo N!";
    text[1326] = "¡Este aerodeslizador puede recorrer grandes distancias gracias a su sistema de propulsión gravitatorio!";
    text[1038] = "La Estación Espacial Lunex puede verse orbitando Luna.";
    text[1039] = "Los Laboratorios Lunex se encuentran en la EEL;";
    text[1040] = "son un centro donde se reúnen los científicos más inteligentes y los ingenieros más innovadores.";
    text[388] = "¡Saludos, Srta. Bella!";
    text[796] = "¡Estamos instalando el último modelo de panel lunar!";
    text[797] = "¡Aparentemente, ningún otro dispositivo creado por el hombre produce tanta energía!";
    text[801] = "Estos paneles lunares pesan bastante...";
    text[798] = "¡Ah, Srta. Bella! Veo que ya vuelve a la estación. Bien, ¡tenga un buen viaje!";
    text[799] = "¡¿Ha visto al lóbrego que ha pasado volando?! ¡Era enorme!";
    text[800] = "Tenemos que estar alerta, quién sabe cuándo volverá a aparecer...";
    text[802] = "La vista es realmente hermosa desde aquí.";
    text[803] = "¡Lo es! Es uno de los lugares que más me gusta visitar.";
    text[804] = "¿Puedo preguntarle algo?";
    text[805] = "¡Claro!";
    text[806] = "Crees... ¿Cree que encontraremos algún lugar en el que ocultarnos de los lóbregos?";
    text[807] = "Al menos..., ¿un lugar donde podamos evitar que nos hagan daño?";
    text[808] = "No soy una persona rencorosa pero... mataron a mi marido.";
    text[809] = "Oh... Lamento mucho su pérdida...";
    text[810] = "No quiero que nadie tenga que experimentar el mismo sufrimiento que yo.";
    text[811] = "Señora, encontraremos una manera.";
    text[812] = "No quiero que la gente viva teniendo miedo de lo que hay ahí fuera, en el universo.";
    text[813] = "La humanidad crece y prospera gracias a su curiosidad, que le lleva a aprender y descubrir.";
    text[814] = "En nombre de la Fuerza Lunex y de mí misma, le aseguro que haremos todo lo que podamos.";
    text[815] = "G-gracias.";
    text[816] = "¡No hay de qué!";
    text[817] = "Haré todo lo que pueda para conservar la entereza. Gracias por darme esperanzas.";
    text[818] = "01100100 01101001 01100111 01101001 01110100";
    text[819] = "Dice que se llama DIgit.";
    text[820] = "Bella, creo que le pasa algo al programa de Digit.";
    text[821] = "Ay, pobre cosita. Llevemos a Digit de vuelta al laboratorio. ¡Papá podría arreglarlo!";
    text[822] = "01100111 01101111 01110100 01110100 01100001 00100000 01100111 01101111";
    text[823] = "Digit dice que tiene que irse.";
    text[824] = "Ya veo. Es posible que pertenezca a alguien...";
    text[825] = "Qué robot más raro.";
    text[840] = "Je, je.";
    text[841] = "Doble je, je.";
    text[842] = "Mmm, ¡hola!";
    text[843] = "Oh, ¡hola!";
    text[844] = "¡Hola, hola!";
    text[845] = "Mmm, te vimos antes, cuando luchabas contra ese lóbrego, ¡molabas tanto!";
    text[846] = "¡Molabas un montón! ¡Y luego vinimos aquí para escondernos!";
    text[847] = "Queríamos daros algo por mantener nuestro hogar a salvo.";
    text[848] = "¡Eso, eso!";
    text[849] = "¡Oh, gracias! ¡Sois un encanto!";
    text[850] = "(Esos niños... No deberían tomar energ-Os).";
    text[851] = "(No es raro que tengan tanta energía).";
    text[852] = "¡Adiós!";
    text[853] = "¡Doble adiós!";
    text[854] = "Srta. Bella, su traje impulsor parece hecho a medida. ¿Se lo hizo el doctor Thomas?";
    text[855] = "¡Sí!";
    text[856] = "¡Qué suerte! En realidad hoy es mi primer día en activo.";
    text[857] = "No esperaba encontrarme con lóbregos tan pronto...";
    text[858] = "¡Pero haré todo lo que pueda para aprender y hacerme más fuerte!";
    text[859] = "¡En realidad hace solo unos meses que soy una guerrera oficialmente!";
    text[860] = "Todavía me queda mucho que aprender.";
    text[861] = "¡Sí, pero ha estado entrenando toda su vida con una profesional de la talla de su madre!";
    text[862] = "¡Debe haberle enseñado todo tipo de técnicas increíbles!";
    text[863] = "¡Tiene un base fantástica de por sí, y ha ascendido en el escalafón tan rápido...!";
    text[864] = "Espero poder subir de rango uno de estos días.";
    text[865] = "Sería estupendo llevar ese elegante traje impulsor modelo X de color azul algún día.";
    text[866] = "Entonces, ¡buena suerte a los dos!";
    text[867] = "¡Es estupendo tenerte en el equipo! Necesitamos más guerreros motivados como tú.";
    text[868] = "¡G-Gracias! ¡Ah, ja, ja, ja!";
    text[869] = "(Pssst, Bella, ¡estás haciendo que el Sr. Soldado se sonroje!)";
    text[870] = "(Eh, Tetra, lleva casco, cómo puedes...)";
    text[871] = "(¡Tetra!)";
    text[872] = "(¡Te he dicho que no puedes analizar a las personas si no te dan permiso antes!)";
    text[873] = "(Ups... La olvidadiza ayudante Tetra se disculpa, je, je, je).";
    text[874] = "(Aaay).";
    text[875] = "¡Haré todo lo que pueda para aprender y hacerme más fuerte!";
    text[876] = "Los lóbregos...";
    text[877] = "No podemos predecir cuándo o dónde aparecerán..";
    text[878] = "Me alegro de que nuestro trabajo sea lo bastante eficiente como";
    text[879] = "para que los ciudadanos no tengan que vivir siempre con miedo.";
    text[880] = "Los lóbregos solían aparecer una o dos veces al mes, pero...";
    text[881] = "Parece que se están produciendo más encuentros últimamente.";
    text[882] = "Debemos mantenerlos a raya y proteger a la gente de Luna, no podemos hacer otra cosa.";
    text[883] = "Tenemos un montón de suministros que proceden de toda Luna.";
    text[884] = "Algunas de estas cajas contienen carnes o verduras encargadas por el café,";
    text[885] = "que proceden de Rancho Kepler.";
    text[886] = "¡Parece que tenemos a una cadete roja aquí! ¡Todavía eres una gamba, por lo que veo, ja, ja, ja!";
    text[887] = "¡Algún día serás tan fuerte como yo! ¡Ja, ja, ja!";
    text[888] = "(Se le ha subido el rango a la cabeza. Menudo idiota).";
    text[889] = "(Tetra, analízalo).";
    text[890] = "(Mmmm... Según sus registros, su récord personal al hacer sentadillas es de 75 kilos).";
    text[891] = "¡Pffff...! (¡Eso no es nada! El mío es de 147 kilos).";
    text[892] = "¿Qué es tan divertido, cadete roja?";
    text[893] = "¿Cuánto peso puedes levantar haciendo sentadillas?";
    text[894] = "Eh, ¡puedo levantar 122 kilos sin problemas!";
    text[895] = "¡Pfffff...!";
    text[896] = "Bueno, no tengo tiempo para charlar con cadetes rojos.";
    text[897] = "(Menudo cabezahueca).";
    text[898] = "Dejad de molestarme. No tengo tiempo para charlar con cadetes rojos.";
    text[899] = "(Grrr. Cabezahueca).";
    text[1103] = "Estoy esperando a mi colega Mett.";
    text[1104] = "Está tardando más de lo normal en llegar con el cargamento... Espero que esté bien.";
    text[1414] = "¡Eh, gracias por ayudar a mi colega Mett antes!";
    text[1415] = "¡Srta. Bella! ¡Espero que todo le vaya bien!";
    text[1416] = "Ver su ingenio y determinación a la hora de arreglar el aerodeslizador me ha servido de inspiración.";
    text[1417] = "Lo he decidido. Voy a esforzarme en superar el miedo que me inspiran los lóbregos.";
    text[1418] = "Es p-posible que tarde un poco en hacerlo... Todavía tiemblo al pensar en ellos.";
    text[1419] = "Pero... ¡haré todo lo que pueda! ¡Un día lo verá!";
    text[409] = "¡Es un receptáculo de tipo guerrero!";
    text[410] = "Los receptáculos funcionan con antinúcleos y electricidad.";
    text[411] = "Cuando cuentan con un antinúcleo, son capaces de ";
    text[412] = "resistir grandes cantidades de antimateria en combate.";
    text[413] = "Esto los convierte en un arma ideal para luchar contra los lóbregos.";
    text[512] = "Unidad para Residentes de Regolithia: 001";
    text[513] = "SECTOR 16: REGOLITHIA\n: Cima del Guerrero";
    text[514] = "Astropuerto Sureste";
    text[515] = "Unidad de Almacenaje: 003";
    text[516] = "ERROR de autorización";
    text[517] = "Oeste: Instalación de la Barrera\nEste: Zona Residencial";
    text[533] = "Parece que un aire gélido sale de la enorme tubería que hay arriba.";
    text[534] = "¿Te gustaría entrar en la tubería?";
    text[535] = "El color de las alexandritas de Regolithia cambia en función de las condiciones lumínicas.";
    text[536] = "Hace mil años, esta piedra era muy rara debido a su capacidad para cambiar de color.";
    text[537] = "Es una alexandrita.";
    text[538] = "Las rocas de Luna son realmente interesantes...";
    text[539] = "Ha examinado las rocas a fondo. Tal vez guarden secretos más importantes.";
    text[540] = "O tal vez no.";
    text[541] = "Es la décima vez que tratas de hablar con la roca.";
    text[542] = "La roca se niega a hablar.";
    text[543] = "Parece que sientes una fascinación muy peculiar por las rocas.";
    text[544] = "Ya que tienes tanta experiencia con las rocas, tal vez debas añadirla a tu currículum.";
    text[545] = "Intento número 30. La roca sigue en el suelo.";
    text[546] = "No se mueve.";
    text[547] = "Es bastante bonita.";
    text[548] = "¡Enhorabuena! Te has convertido definitivamente en una experta en rocas.";
    text[549] = "La gente sigue teniendo rocas como mascota hoy en día.";
    text[550] = "¿Por qué?";
    text[551] = "Porque saben escuchar muy bien.";
    text[552] = "Alguien ha grabado algo en esta roca...";
    text[553] = "Dice... ";
    text[554] = "¿Sigue@P.@P.@P. roqueando?";
    text[555] = "Sientes que un aura de gratitud emana de las rocas de la zona.";
    text[556] = "Nunca se habían sentido tan amadas.";
    text[557] = "Cada vez que recuerden este momento, quedarán petrificadas.";
    text[558] = "La roca parece contenta. Te abrazaría si pudiera hacerlo.";
    text[559] = "No olvides valorar las pequeñas cosas de la vida.";
    text[560] = "¡Has alcanzado el cúlmen de la interactividad con las rocas! ¡Es para quedarse de piedra!";
    text[561] = "Has perdido la cuenta de las rocas con las que has hablado.";
    text[1327] = "¡Bella, acabamos de ver una estrella fugaz!";
    text[1328] = "¡Ha sido genial! ¡Siento que voy a tener un MONTÓN DE SUERTE!";
    text[1329] = "EVENTO PORTAFORTUNA: ¡El siguiente objeto o divisa que recojas se multiplicará por dos!";
    text[1330] = "¡Escoge el siguiente objeto sabiamente!";
    text[1331] = "¡Solo tendrás un EVENTO PORTAFORTUNA en cada capítulo!";
    text[270] = "El traje impulsor ha asustado al cachorro.";
    text[271] = "¡Es Buddy, el cachorro! ¿Te gustaría acariciar a Buddy?";
    text[272] = "Buddy parece decepcionado.";
    text[273] = "¡Guau, guau!";
    text[274] = "¡Es un cachorro adorable! ¿Te gustaría acariciar al cachorro?";
    text[275] = "Buddy parece decepcionado.";
    text[276] = "Acaricias al cachorro suavemente.";
    text[277] = "¡El cachorro mueve la cola emocionado!";
    text[278] = "Parece que quiere que le sigas acariciando la cabeza.";
    text[279] = "Vuelves a acariciar al cachorro. ¡El cachorro está encantado!";
    text[280] = "Parece que quiere MUCHAS MÁS caricias en la cabeza. ";
    text[281] = "El cachorro está muy emocionado y babea por todas partes.";
    text[282] = "¡Disfruta con todas tus caricias!";
    text[283] = "Echas un vistazo a la placa de identificación que el cachorro lleva en el collar.";
    text[284] = "¡Se llama Buddy! ¡Dices su nombre y comienza a mover el rabo como un loco!";
    text[285] = "Buddy te mira con ojos de cachorrito cuando le acaricias.";
    text[286] = "¡Dar caricias se te da de muerte! Buddy está muy contento.";
    text[287] = "Tú y Buddy estáis totalmente sincronizados. Sientes que un poder se acumula dentro de ti.";
    text[288] = "El poder de los perritos adorables brilla en tu interior.";
    text[289] = "Buddy está encantado de verte.";
    text[290] = "¡Te da un beso de agradecimiento lleno de babas por todas las caricias que le has dado!";
    text[291] = "Acaricias a Buddy lenta y suavemente.";
    text[292] = "¡Parece que también le gusta que le acaricies a esta velocidad!";
    text[293] = "Tú y Buddy decidís realizar una sesión de caricias a toda velocidad.";
    text[294] = "¡El maestro Buddy está impresionado!";
    text[295] = "¿Qué ocurre Tetra?";
    text[296] = "No pasa nada.";
    text[297] = "¡Hum!";
    text[298] = "Ah, ¡parece que alguien está un poco celosa! Ja, ja, ja.";
    text[299] = "Tal vez un poco. Hum.";
    text[300] = "Después te acariciaré un poco, te lo prometo.";
    text[301] = "¡Je, je! ¡Vale!";
    text[302] = "Tú y Buddy os movéis a velocidades que escaparían a un ojo poco entrenado.";
    text[303] = "Una muestra de caricias y movimientos de rabo a toda velocidad tan bonita como espectacular";
    text[304] = "está teniendo lugar, aunque parezca que no os estáis moviendo en absoluto.";
    text[305] = "Tú y Buddy os habéis convertido en buenos amigos.";
    text[389] = "No se preocupe por nosotros.";
    text[390] = "Ahí fuera hay lóbregos de los que debe ocuparse.";
    text[794] = "Espero que podamos arreglar la brecha en la Astrobarrera a tiempo...";
    text[795] = "Mi hija está esperando a que vuelva a casa para jugar a videojuegos juntos.";
    text[1363] = "El sector 16 vuelve a estar abierto por fin. ¡Me alegro de que todo se haya resuelto!";
    text[1364] = "¡Ahora puedo ir a casa y jugar videojuegos con mi hija! ¡Yuupii!";
    text[530] = "¡Hay una escalera en la parte de atrás de este pilar!";
    text[531] = "¿Quieres volver a subir?";
    text[532] = "¿Quiere bajar por la escalera?";
    text[909] = "¡Es un reflector de láseres!";
    text[910] = "Parece que este láser todavía funciona, pero su mecanismo de rotación está atascado...";
    text[911] = "No se puede girar.";
    text[912] = "Gira el láser.";
    text[913] = "Olvídalo.";
    text[914] = "Escoge adónde quieres dirigir el láser.";
    text[915] = "Parece que el sistema de rotación está atascado. No girará más.";
    text[916] = "Bella, ¡una puerta láser impide el acceso a esta bodega de carga!";
    text[917] = "¡Si tratamos de atravesarla, nos electrocutaremos!";
    text[918] = "¿Puedes introducirte en el panel de control y desactivarla?";
    text[919] = "Mmm.. Este panel de control está destrozado... No puedo entrar en esta red.";
    text[920] = "Mmm... En ese caso, probemos algo diferente.";
    text[921] = "¿Qué te parece?";
    text[922] = "¿Has visto esos láseres? Son parte del Sistema de Defensivo de la Astrobarrera.";
    text[923] = "Estoy pensando que podemos dirigirlos contra la puerta.";
    text[924] = "¡Ooooh! ¡Vamos a intentarlo!";
    text[925] = "¡Activa el láser! (¡Muah, ja, ja, ja!)";
    text[926] = "Este láser no funciona. El mecanismo de rotación también está roto.";
    text[927] = "El panel de control está destrozado.";
    text[928] = "¡¿Y esto?! ¡Hay una palanca de control tras la grúa! ¡Escoge la distancia a la que descenderá!";
    text[929] = "Nivel 1: Distancia corta";
    text[930] = "Nivel 2: Distancia intermedia";
    text[931] = "Nivel 3: Distancia larga";
    text[932] = "¡Lo hicimos! ¡Ahora podemos entrar en la bodega de carga!";
    text[1136] = "¡Este láser forma parte del Sistema Defensivo de la Astrobarrera!";
    text[1135] = "Punto de Luz Estelar";
    text[936] = "¡Eh! ¡Bienvenidos a mi casa, ja, ja!";
    text[937] = "¡Hoy voy a retransmitir algunas partidas a juegos independientes!";
    text[938] = "¿¡Te dedicas a retransmitir vídeos?! ¡Vaya!";
    text[939] = "¡Sí!";
    text[940] = "¡Tienes una colección de juegos estupenda!";
    text[941] = "¡Gracias! ¡Me apasiona jugar a juegos independientes y promocionarlos, ja, ja!";
    text[942] = "¡Vaya, tu robot es una pasada!";
    text[943] = "¡Me llamo Tetra! ¡Soy la ayudante número uno de Bella! ¡Piu, piu!";
    text[944] = "¿La construiste tú?";
    text[945] = "Mi papá y yo la construimos juntos. Su IA todavía es bastante nueva.";
    text[946] = "¡Es estupentástica!";
    text[947] = "Eh, je, je... (¿Eso es lo que dicen los niños hoy en día?)";
    text[948] = "Aquí todo está mucho más tranquilo que en una ciudad tan ajetreada como Tycho...";
    text[949] = "Como la residencia está en los desfiladeros de Regolithia,";
    text[950] = "estamos más protegidos de posibles desastres.";
    text[951] = "¡Tenemos nuestras propias reservas de comida y oxígeno por si las moscas!";
    text[952] = "¡Agh! ¡Tengo MUCHAS ganas de ir!";
    text[953] = "Al parecer, el ramen que se hacía con el trigo de Terra";
    text[954] = "no sabía igual que el que se hace con el trigo que se cultiva en Luna.";
    text[955] = "Me pregunto cómo sabría...";
    text[956] = "Es una pena que ahora Terra sea un planeta volcánico inhabitable.";
    text[957] = "Me pregunto cómo era la vida hace 1000 años...";
    text[958] = "Es decir, antes de que terraformásemos Luna y todo eso, ¿entiendes?";
    text[959] = "Para trabajar para la Fuerza Lunex es necesario esforzarse mucho, entrenar para el combate, dedicación y";
    text[960] = ".@P.@P.@P. ¡UN MONTÓN DE COMIDA!";
    text[1105] = "¿Has echado un vistazo al panel de anuncios de Regolithia?";
    text[1106] = "¡Echar un vistazo a los anuncios es bastante divertido!";
    text[1107] = "No se lo digas a nadie, pero mi nombre de usuario es Melia.";
    text[1108] = "Perdí mi cubo hertziano hace un tiempo y puse un anuncio para ver si alguien lo había encontrado.";
    text[1109] = "En realidad ya no me interesa tanto recuperar mi cubo.";
    text[1110] = "Así que si lo encuentras, ¡puedes quedarte con lo que haya dentro!";
    text[1111] = "Los cubos hertzianos suelen estar cerrados. ¿Tienes la llave que lo abre?";
    text[1112] = "Oh, espera, olvidé mencionar que perdí la llave...";
    text[1113] = "Así que no sé si podréis abrirlo... En fin, ¡buena suerte de todas formas!";
    text[1333] = "Parece que la caja fuerte de carga no se puede abrir.";
    text[1334] = "¿Es posible que haya un interruptor en la Unidad de Almacenaje que pueda abrirla?";
    text[1032] = "¡Hay una escotilla de acceso aquí!";
    text[1033] = "Parece que está cerrada desde el otro lado...";
    text[1034] = "El antinúcleo que tienes parece estar reaccionando a algo.";
    text[1332] = "Mmm... Estas marcas de la pared son muy extrañas... Volvamos aquí más tarde.";
    text[1581] = "Los antinúcleos que tienes están reaccionando a las marcas de la pared.";
    text[1582] = "¡¿...?!";
    text[1024] = "¡Ha aparecido un pequeño agujero de gusano!";
    text[1025] = "¿Quieres saltar dentro?";
    text[1029] = "Hay unas extrañas señales en el suelo.";
    text[1367] = "Es un montón de polvo estelar brillante.";
    text[1368] = "Parece que el polvo está compuesto de partículas de antimateria.";
    text[1369] = "Es una lápida.";
    text[1370] = "Es un monolito.";
    text[1371] = "Por algún motivo, todo esto te resulta familiar.";
    text[1701] = "Selecciona la planta de destino:";
    text[1702] = "P1: Cafetería y vestíbulo";
    text[1703] = "P2: Centro comercial";
    text[1704] = "P3: Instalaciones de investigación";
    text[1705] = "Área restringida: Laboratorio Nexus";
    text[1777] = "Estación Espacial Lunex: Puerto Este";
    text[1778] = "Café Lunex";
    text[1779] = "¡La comida es un combustible esencial para el cuerpo! ¡No olvides comer bien en el Café Lunex!";
    text[1780] = "Hay un montón de interruptores y botones en la pared.";
    text[1781] = "Tal vez sea mejor no alterar la configuración actual.";
    text[1782] = "En la pantalla pueden verse nuevos artículos.";
    text[1783] = "Incidentes con lóbregos, nuevos inventos, quejas de ciudadanos, escasez de comida...";
    text[1784] = "Esto no tiene fin.";
    text[1785] = "Soy el conserje de la EEL.";
    text[1786] = "Mis principales tareas incluyen limpiar, realizar reparaciones y encargarme del mantenimiento general.";
    text[1787] = "Todo eso está bien, pero lo que más me gusta de mi trabajo es...";
    text[1788] = "... alimentar a Echo, la Gata Espacial.";
    text[1789] = "No creo que haya ningún gato que disfrute tanto del espacio como Echo.";
    text[1790] = "Nadie sabe de dónde viene Echo ni quién es su dueño.";
    text[1791] = "Tiene collar, pero el nombre del dueño es un borrón.";
    text[1792] = "Apareció un día con su traje espacial... y el resto es historia.";
    text[1793] = "¡Bella! ¡Bienvenida a la Estación Espacial!";
    text[1794] = "¡Hola, Stella! ¿Tenemos alguna misión nueva hoy?";
    text[1795] = "Una cuantas, pero ya se las he asignado a otros escuadrones.";
    text[1796] = "¡Deberías descansar! ¡Hoy es tu día libre!";
    text[1797] = "¡Es tan difícil conseguir que te tomes un respiro de tus deberes como guerrera!";
    text[1798] = "Lo sé, simplemente no puedo evitarlo, eh, je, je.";
    text[1799] = "Ah, vaya... ¿Has conseguido nuevos peluches? ¡SON ADORABLES!";
    text[1800] = "¡Y que lo digas!";
    text[1801] = "¡Encargué algunos en línea y al parecer enviaron 2 de cada uno por error!";
    text[1802] = "Puedo darte los que me sobran si quieres.";
    text[1803] = "¡Pediré a alguien que los lleve a tu habitación!";
    text[1804] = "¡SÍÍÍÍÍÍ! ¡No puedo decir que no a unos peluches tan monos! ¡Gracias! ¡Je, je!";
    text[1807] = "No hay nuevas misiones disponibles en este momento.";
    text[1808] = "¡Si surge algo te lo haré saber!";
    text[1809] = "¿Te gustaría volver a Regolithia?";
    text[1810] = "La pantalla muestra el directorio de la estación.";
    text[1811] = "La EEL está dividida en 3 niveles principales:";
    text[1812] = "¡Son peluches de Metill y Kame!";
    text[1813] = "Este peluche tan espeluznante se llama Axsoul.";
    text[1814] = "Esta máquina expendedora vende productos de marca Lunex, como sombreros y tazas.";
    text[1815] = "Esta máquina expendedora vende suplementos vitamínicos.";
    text[1816] = "Los trabajadores de esta zona deben tomar suplementos vitamínicos";
    text[1817] = "para que sus huesos, dientes y músculos sigan sanos.";
    text[1818] = "Hay deliciosa comida y bebidas en el mostrador.";
    text[1819] = "¡Eh! Han instalado una nueva máquina de comida.";
    text[1820] = "Ahora se llama F.O.O.D v.3";
    text[1821] = "¡Me gustaba más cuando se llamaba RICO 5000!";
    text[1822] = "¡A mí también!";
    text[1823] = "¿Y qué significa el acrónimo F.O.O.D.?";
    text[1824] = "No tengo ni idea...";
    text[1825] = "¡Al menos puede hacer mil platos más!";
    text[1826] = "Mmmm... ¡No me vendría mal un curri picante en este momento!";
    text[1827] = "Oh, vamos, llevo tanto tiempo aguantándome...";
    text[1828] = "Hay otros cuartos de baño en la Estación Espacial.";
    text[1829] = "No. DEBE ser este. No me rendiré.";
    text[1830] = "Ya he esperado mucho tiempo. Puedo esperar un poco más.";
    text[1831] = "En el espacio, nuestras lenguas no producen la saliva necesaria para que nuestras papilas gustativas";
    text[1832] = "funcionen tan bien como en Luna.";
    text[1833] = "Por eso la comida picante es muy popular en la Estación Espacial Lunex.";
    text[1834] = "¡Antes de que tu padre perfeccionara el generador de gravedad,";
    text[1835] = "esta cafetería solía tener velcro POR TODAS PARTES!";
    text[1836] = "¡El velcro se utilizaba para evitar que todo saliera flotando, comida incluida!";
    text[1837] = "¡El pan solía estar prohibido porque las migas se metían en los ojos de la gente!";
    text[1882] = "¡Un momento! ¡Veo algo escrito dentro de la papelera!";
    text[1883] = "143143";
    text[1884] = "Vaya, solo son un montón de números.";
    text[1885] = "¡Tal vez sea una contraseña! ¡Je, deberíamos apuntarla, por si nos hace falta!";
    text[1886] = "Hay una nota adhesiva en la que hay escritos algunos números: 032320.";
    text[1887] = "En la pantalla aparecen varias dietas y recetas espaciales diferentes.";
    text[1888] = "¡Te damos la bienvenida a la Estación Espacial Lunex!";
    text[1889] = "¡En realidad Lunex es una abreviación de lunaexploradores!";
    text[1890] = "Siempre debes tener cuidado cuando vueles por Luna con tu nave espacial.";
    text[1891] = "Navegar por el cinturón de asteroides que rodea Luna puede ser complicado";
    text[1892] = "si no tienes un sistema de ayuda al pilotaje. ¿Tu nave tiene uno incorporado?";
    text[1893] = "¡En realidad mi piloto es mi ayudante Tetra!";
    text[1894] = "¿En serio? Vaya, ¡es una robot impresionante!";
    text[1895] = "Je, la impresionante ayudante Tetra tiene todo tipo de trucos en la manga.";
    text[1896] = "Vine a la EEL para hacerle una revisión a mi receptáculo, pero, al parecer,";
    text[1897] = "aquí solo hacen revisiones de aerodeslizadores y naves espaciales.";
    text[1898] = "Se ve que las revisiones de receptáculos se realizan en la Base Militar, en Grimaldi.";
    text[1899] = "¡En la Estación Espacial Lunex puedes encontrar todo tipo de personas!";
    text[1900] = "Tenemos científicos, cocineros, ingenieros, músicos, artistas... ¡lo que quieras!";
    text[1901] = "En este momento el panel de anuncios lunex no está disponible. Pedimos disculpas por las molestias causadas.";
    text[1902] = "Parece que los científicos han sobrecargado el servidor con sus propuestas de investigación.";
    text[1903] = "¡¿En serio?! ¿Cómo lo sabes?";
    text[1904] = "Es lo que dicen las notas del registro de cambios.";
    text[1905] = "Oh, bueno. Volvamos más tarde.";
    text[1906] = "Zona restringida: acceso denegado";
    text[1907] = "Me pregunto que habrá allí.";
    text[1908] = "He vivido aquí toda mi vida y sigo sin tener ni idea.";
    text[1909] = "Mamá y papá nunca me dejaban ir a las zonas restringidas.";
    text[1910] = "Tal vez estén realizando algún asunto científico molón ahí dentro, je.";
    text[1911] = "Esta puerta está cerrada.";
    text[1912] = "La máquina expendedora ya no funciona.";
    text[1913] = "Esta máquina expendedora vende plátanos enlatados.";
    text[1914] = "¿Por qué...?";
    text[1915] = "Puesto comercial: ¡consigue tus energ-Os aquí!";
    text[1916] = "Astrozona: ¡Mejoras, mejoras, mejoras!";
    text[1917] = "Estilo Lunex: ¡Demuestra tu estilo con nuestros trajes impulsores personalizados!";
    text[1918] = "Enlaces neurales: ¡El conocimiento es poder!";
    text[1945] = "Ahora nos toca el turno de seguridad. En realidad es un trabajo muy sencillo.";
    text[1946] = "La EEL es uno de los lugares más seguros en los que trabajar. ";
    text[1947] = "Apenas hay crímenes o asuntos inquietantes de los que preocuparse cuando estamos de patrulla.";
    text[1948] = "¡Acabo de comprar la habilidad de apoyo Reflejos!";
    text[1949] = "Una probabilidad del 10% de que los ataques del enemigo fallen no es mucho...";
    text[1950] = "Tendré que mejorarla con mis puntos de habilidad para sacarle más partido.";
    text[1951] = "Creo que si se mejora al nivel 5, la probabilidad de que el enemigo falle es del 50%.";
    text[1952] = "Está bastante bien, sobre todo teniendo en cuenta que es una HABILIDAD DE APOYO AZUL.";
    text[1953] = "¡Puede serte de ayuda si estás en apuros! ";
    text[1954] = "También te da la oportunidad de probar distintas HABILIDADES DE APOYO ROJAS. ";
    text[1955] = "¡Hay muchas maneras de personalizar tu reserva de habilidades!";
    text[1956] = "Vaya, colega, por fin he ahorrado lo necesario para conseguir la habilidad activa Ráfaga Láser.";
    text[1957] = "¡Ha merecido la pena a tope! Los láseres son tan guay...";
    text[1958] = "¡Los láseres hacen «piu, piu»!";
    text[1989] = "Es probable que aquí se guarde el material de investigación de los científicos.";
    text[1990] = "Has encontrado una puerta cerrada. Cuanyo más te acercas, más frío sientes.";
    text[1991] = "Al corredor oeste: Laboratorio de Investigación";
    text[1992] = "Al corredor este: Zona Residencial";
    text[1993] = "En esta pantalla aparecen cuáles son los próximos plazos de entrega y los hitos a alcanzar en los proyectos.";
    text[1994] = "Parece que algunos equipos están atrasados...";
    text[1995] = "Los plazos de entrega son estresantes...";
    text[1996] = "¡Este árbol es de una especie especial capaz de sobrevivir en gravedad cero!";
    text[1997] = "No necesita agua y las flores que están floreciendo";
    text[1998] = "se convertirán en deliciosas frutas con el tiempo. Se le ha dado el nombre de árbol espacial.";
    text[1999] = "Las variantes rosas y moradas producen las frutas más dulces.";
    text[2000] = "¡Estos bancos han sido diseñados para ofrecer el máximo confort!";
    text[2001] = "Parece que tienen funciones incorporadas para dar masajes.";
    text[2002] = "Aquí hay una etiqueta que dice: Ningún competidor ofrece este nivel de confort.";
    text[2003] = "¡Nuestros bancos son INSUPERABLES!";
    text[2004] = "En las pantallas se suceden varios productos que fueron fabricados aquí.";
    text[2005] = "¡¿Cómo? «La Cafetera Definitiva», diseñada por el doctor Thomas.";
    text[2006] = "«Esta cafetera le ofrecerá una taza de café perfecta sin levantar un solo dedo».";
    text[2007] = "«Solo tiene que decir CAFÉ, POR FAVOR, ¡y la máquina lo hará para usted!";
    text[2008] = "«¡Hasta puede hacer el más delicado de los expresos!»";
    text[2009] = "Este artículo se publicó la semana pasada...";
    text[2010] = "Tenemos que hablar de café con papá.";
    text[2011] = "Un montón de tazas de café vacías están repartidas por toda la sala.";
    text[2012] = "Me pregunto a qué sabe el café.";
    text[2013] = "Es amargo. A papá le gusta negro.";
    text[2014] = "Mmm... Me pregunto cómo es el sabor amargo.";
    text[2015] = "Ah, claro. No tienes sentido del gusto.";
    text[2016] = "¡No! ¡Puedes llamarme Tetra, la pésima probadora de productos!";
    text[2017] = "Pésima probadora de pro... ¿Lo has hecho a propósito?";
    text[2018] = "¿Hacer qué?";
    text[2019] = "¡El trabalenguas! ¡La aliteración!";
    text[2020] = "Oh, bueno... Tal vez...";
    text[2021] = "Hay algunos trajes especiales de repuesto en los contenedores de almacenaje.";
    text[2022] = "¡Es una cápsula curativa! ¡Es básicamente una cápsula para dormir modificada con funciones curativas!";
    text[2023] = "Muchos soldados vienen aquí tras largas y agotadoras misiones para descansar y recuperarse.";
    text[2024] = "Echas un vistazo a través de la ventana. ";
    text[2025] = "Ves a la hermosa y brillante Luna ante ti, rodeada de un cinturón de asteroides.";
    text[2026] = "Más allá de ella, ves a la volcánica Terra, que se alza a lo lejos.";
    text[2027] = "Al P3, Zona Central";
    text[2028] = "A Control de Misiones";
    text[3513] = "¡TRANSPORTE EXPRÉS ACTIVADO! SELECCIONA TU DESTINO:";
    text[3514] = "P3: Laboratorio de Investigación";
    text[3515] = "P3: Habitación de Bella";
    text[3516] = "P1: Puerto Este";
    text[2029] = "Sala de Revisión de Aerodeslizadores";
    text[2030] = "Laboratorio de Investigación Lunex";
    text[2031] = "Sala de Botánica";
    text[2032] = "Sala de Simulación de Combates";
    text[2033] = "Laboratorio de Química";
    text[2034] = "¡Esta es mi habitación!";
    text[2035] = "Habitación de Thomas y Thea";
    text[2036] = "Estas unidades de almacenamiento contienen suministros de limpieza.";
    text[2037] = "Cámaras curativas";
    text[2038] = "Armario de almacenaje";
    text[2039] = "Se necesita una tarjeta de acceso para entrar.";
    text[2040] = "Zona Residencial";
    text[2041] = "Muchos soldados y científicos viven en la Estación Espacial Lunex de manera gratuita,";
    text[2042] = "ya que, con su trabajo, ofrecen servicios militares y de investigación esenciales.";
    text[2043] = "Esta pantalla muestra una lista de todos los residentes en la Estación Espacial.";
    text[2044] = "Aquí hay un anuncio: ¡Venga al Centro Comercial en el P2 y compre hasta que no pueda más!";
    text[2045] = "Esta pantalla muestra una lista de todos los laboratorios especializados de la Estación Espacial.";
    text[2046] = "Esta pantalla no parece funcionar adecuadamente.";
    text[2047] = "Nuestro brillante sol azul siempre es un regalo para la vista.";
    text[2048] = "Es indudable que las mejores vistas están aquí arriba, en la Estación Espacial.";
    text[2049] = "La contrapartida es que las personas que viven aquí deben consumir medicamentos contra la radiación.";
    text[2050] = "Principalmente lo hacen para reducir los efectos nocivos que nuestro sol azul ejerce sobre nuestros cuerpos.";
    text[2051] = "Nuestro universo es hermoso, pero también peligroso.";
    text[2052] = "¡Eh, chica, cuidado por donde pisas! ¡Acabo de fregar el suelo!";
    text[2053] = "Estás dejando polvo morado por todas partes...";
    text[2054] = "¡Oh, lo siento! ¡Nos iremos de inmediato!";
    text[2055] = "(Polvo morado... Probablemente sea polvo procedente de la Zona Fantasma...)";
    text[2056] = "(Necesito limpiar las botas cuando tenga la oportunidad).";
    text[2057] = "(Espero que nadie más se dé cuenta...)";
    text[2058] = "He escuchado que hay una estación espacial abandonada en algún lugar del espacio.";
    text[2059] = "Según los rumores, hace 100 años una forma de vida alienígena atacó a los científicos que la habitaban.";
    text[2060] = "Quién sabe qué ocurrió en realidad...";
    text[2061] = "¿Sabías que la base de datos de lóbregos se actualiza constantemente con nuevas entradas?";
    text[2062] = "¡Cuando descubres un lóbrego desconocido, puedes asignarle tú mismo su denominación!";
    text[2063] = "Eso ya lo sabíamos.";
    text[2064] = "Sí, ya lo sabíamos.";
    text[2065] = "Vaya...";
    text[2066] = "La razón por la que no necesitamos un casco con oxígeno en el puerto para naves...";
    text[2067] = "... ¡es porque hay un campo de fuerza atmosférico que rodea toda la estación!";
    text[2068] = "¡Este campo de fuerza atmosférico se llama Astrobarrera!";
    text[2069] = "¡También nos protege de restos espaciales, como pequeños asteroides o rocas!";
    text[2070] = "Cuando los restos son demasiado grandes, solemos vaporizarlos con nuestras armas láser.";
    text[2071] = "Pero si tuviéramos que vérnoslas con algo aún más grande...";
    text[2072] = "... Sea como fuere, tengo que volver al trabajo enseguida.";
    text[2073] = "En la estación espacial estudiamos a los lóbregos.";
    text[2074] = "Desgraciadamente, las muestras con las que trabajamos no duran demasiado...";
    text[2075] = "Los lóbregos no están hechos de materia como nosotros, y eso dificulta la obtención de datos.";
    text[2076] = "Hay cupones para comida y postres en la pared.";
    text[2077] = "¿Y esto? En uno de los cupones está escrito el número «041422».";
    text[2079] = "¡Aquí hay una lista de consejos de combate aportados por guerreros de élite!";
    text[2080] = "Un elemento de la lista te llama la atención en particular: CHIPS DE MEJORA.";
    text[2081] = "Los CHIPS DE MEJORA son unos objetos especiales muy caros y difíciles de conseguir.";
    text[2082] = "Puedes equipar y retirar CHIPS DE MEJORA en tu MENÚ OBJETOS.";
    text[2083] = "Algunos CHIPS DE MEJORA, como el de MEJORA DE ARMADURA, restan 25 al daño recibido. ";
    text[2084] = "¡La MEJORA DE ESTRATEGIA te permite usar 2 habilidades de apoyo en cada turno!";
    text[2085] = "¡Al parecer solo se creó un CHIP DE MEJORA DE ESTRATEGIA, así que ese es especialmente raro!";
    text[2086] = "Esos sables pistola se usan durante las sesiones de entrenamiento. ¡El sable azul es muy raro!";
    text[2087] = "Hay un montón de granadas aturdidoras colocadas en la estantería.";
    text[2088] = "¡Hay uniformes de batalla extra aquí en caso de que olvides el tuyo!";
    text[2089] = "¡Estos uniformes se han diseñado para que se adapten cómodamente al cuerpo de cualquiera!";
    text[2090] = "¡Es el modelo 1 de nave espacial! ¡Esta nave utiliza electricidad y energía solar!";
    text[2091] = "Se están cargando baldosas de movimiento.";
    text[2092] = "Se usan principalmente para ayudar a transportar mercancías y personas de un lugar a otro.";
    text[2093] = "Haya algunas plataformas de impulso rotas en el suelo.";
    text[2094] = "Parece que estas herramientas se utilizan para hacer revisiones de aerodeslizadores y de otra maquinaria.";
    text[2095] = "¡Es el modelo 2 de nave espacial! ¡Esta nave puede soportar condiciones climáticas extremas!";
    text[2096] = "¡Ooooh! ¡Veo que hay gente allí detrás construyendo nuevos aerodeslizadores!";
    text[2097] = "Esta pantalla muestra las constantes vitales y el estado de salud de los pacientes.";
    text[2098] = "Aquí hay algunos libros escritos por el doctor Thomas.";
    text[2099] = "Coges un libro llamado «El poder de la lux» de la estantería y empiezas a leer:";
    text[2100] = "La ciencia ha confirmado la existencia del alma, conocida ahora como «lux».";
    text[2101] = "De manera sencilla, se podría definir la lux como la energía del alma.";
    text[2102] = "A pesar de que la lux es un campo de investigación reciente, hemos realizado algunos descubrimientos.";
    text[2103] = "La lux tiene un fuerte vínculo con los sentimientos, las emociones, la voluntad y el instinto.";
    text[2104] = "Algunos individuos tienen una lux más fuerte que otros.";
    text[2105] = "Mi equipo tiene la teoría de que, en raras ocasiones, la lux se puede controlar y manipular.";
    text[2106] = "(¿Es posible que esto tenga algo que ver con las extrañas sensaciones que he estado experimentando?)";
    text[2107] = "(Tengo que hablar con papá sobre esto tarde o temprano...)";
    text[2108] = "Es un tubo con fluido de antinúcleo.";
    text[2109] = "Estos tubos se usan como fuente de combustible para receptáculos y otras armas de antimateria.";
    text[2110] = "Los tubos de esta zona han sufrido bastantes daños.";
    text[2111] = "Parece que se están cultivando algunas plantas en tubos en los que se simulan distintas condiciones.";
    text[2112] = "Aparentemente, este ordenador se usa para controlar el crecimiento de las plantas.";
    text[2113] = "Aquí hay un libro titulado: ¡Cómo cultivar comida en el espacio!";
    text[2114] = "Aquí hay un libro titulado: ¡Ciento una recetas espaciales!";
    text[2115] = "Hay un informe que describe una planta roja con manchas que ha desarrollado dientes de piraña.";
    text[2116] = "Vaya... Parece que al equipo de botánica le gusta mucho beber té verde de jazmín.";
    text[2117] = "En los compartimentos de almacenaje se almacena un surtido de semillas de plantas.";
    text[2118] = "¡Estas cajas contienen granos de café de la mejor calidad recién tostados!";
    text[2119] = "Este panel de control crea hologramas con los que se puede interactuar.";
    text[2120] = "Suele usarse durante las reuniones para ayudar a visualizar ideas y diseños.";
    text[2121] = "¡Es el ordenador del doctor Thomas!";
    text[2122] = "Algunas carpetas de su escritorio son: Antimateria, ADN de lóbrego y Amantes del café.";
    text[2123] = "Tras recibir vertidos de café durante muchos años, el escritorio ha adquirido un color marrón.";
    text[2124] = "Mamá intentó que papá se deshiciera de su escritorio, pero él siempre se negó a reemplazarlo.";
    text[2125] = "¿Por qué?";
    text[2126] = "Tenía demasiado valor sentimental.";
    text[2127] = "Se le ocurrieron sus mejores ideas mientras trabajaba en este escritorio durante largas noches.";
    text[2128] = "También decía que el escritorio olía a café... Puaj.";
    text[2129] = "Aquí hay un libro titulado: Cómo conseguir un equilibrio adecuado entre la vida y el trabajo.";
    text[2130] = "Es un superordenador avanzado que controla la máquina de agujeros de gusano.";
    text[2131] = "Aquí hay archivos confidenciales con estos títulos: Energía oscura, Materia oscura y Astrotécnicas.";
    text[2132] = "El ordenador está siguiendo la trayectoria del cometa de antimateria Coda.";
    text[2133] = "Este ordenador mide el nivel de antimateria que se usa como combustible. Parece ser muy bajo.";
    text[2134] = "Este es el prototipo de la máquina de agujeros de gusano llamada Celestia.";
    text[2135] = "La supervivencia de la humanidad depende de  que esta máquina se finalice con éxito.";
    text[2136] = "Estas cajas están llenas con juguetes antiguos y otros recuerdos.";
    text[2138] = "Tienes un ordenador bastante sofisticado que puede reproducir varios programas a la vez.";
    text[2139] = "Tu fondo de escritorio es una foto de la familia Grey en una playa de Oceanus.";
    text[2140] = "El doctor Thomas lleva Thea en sus brazos y Thea lleva en los suyos a una Bella bebé.";
    text[2141] = "Esta pantalla muestra el estado de la Astrobarrera en cada sector.";
    text[2142] = "Si se produce una brecha en un sector, los sectores circundantes quedan confinados";
    text[2143] = "para evitar que el astroecosistema sufra más daños.";
    text[2144] = "Esta pantalla muestra los niveles de oxígeno, nitrógeno y dióxido de carbono en Luna.";
    text[2145] = "Este ordenador está conectado a un sensor de proximidad avanzado incorporado a la Estación Espacial.";
    text[2146] = "Puede medir con gran precisión la distancia entre varios objetos.";
    text[2147] = "Este ordenador está conectado a un escáner molecular.";
    text[2148] = "Puede determinar la composición molecular de objetos situados a grandes distancias.";
    text[2149] = "Nuestro sol es un supergigante azul que se acerca al fin de su existencia.";
    text[2150] = "¡¿Qué?! ¡Qué miedo!";
    text[2151] = "¡Oh! No quería asustarte. No te preocupes.";
    text[2152] = "Todavía faltan unos 7 millones de años para que su ardiente existencia finalice";
    text[2153] = "y explote, entrando así en el olvido.";
    text[2154] = "...";
    text[2155] = "Lamento el fatalismo existencial... Cuando estudias algo durante toda tu vida,";
    text[2156] = "a veces deseas no haberte enterado de algunas cosas. La ignorancia es felicidad.";
    text[2157] = "Debo conservar la calma. Debo conservar la calma. Debo conservar la calma.";
    text[2158] = "(¿Está bien?)";
    text[2159] = "(Parece muy estresada. Será mejor dejarla tranquila).";
    text[2160] = "¡Fascinante...! Hace un par de meses, nos encontramos con ";
    text[2161] = "un artilugio espacial interestelar desconocido que contenía un disco de oro.";
    text[2162] = "Nos llevó un tiempo decodificar todo el artefacto, pero hemos descubierto";
    text[2163] = "que el disco de oro procede de una galaxia que está a 2,5 millones de años luz de la nuestra.";
    text[2164] = "El disco contiene imágenes, música, sonidos y saludos de un planeta llamado «Tierra».";
    text[2165] = "El disco ha tardado millones de años en llegar a nosotros... ";
    text[2166] = "No sabemos si su civilización todavía existe, pero siempre hay esperanza.";
    text[2167] = "En estos momentos estamos tratando de contactar con los terrícolas.";
    text[2168] = "Seguramente les gustará saber que hay otra inteligencia en el universo.";
    text[2169] = "Esperemos que esto vaya bien.";
    text[2170] = "¡Esto se usa para practicar el tiro al blanco! ¡No te pongas en la trayectoria de disparo!";
    text[2171] = "Estoy en el día 29 de mi maratón de entrenamiento de 30 días... Me falta muy poco... Ya casi no puedo más...";
    text[2172] = "¡Ha! ¡Toma esto! ¡Voy a hacerlo! ¡Voy a conseguir que mis sueños se hagan realidad!";
    text[2173] = "Este soldado parece estar muy concentrado en su entrenamiento.";
    text[2174] = "El Equipo de Botánica es el responsable del estudio de la biología de las plantas en el espacio.";
    text[2175] = "¡Nuestra investigación nos ayuda a desarrollar comida más nutritiva y de mejor calidad!";
    text[2176] = "Echo en falta ir fuera y estar en medio de la naturaleza.";
    text[2177] = "Me apasionan la ciencia y las plantas, y por eso me encanta trabajar aquí, pero...";
    text[2178] = "Siento nostalgia cuando pienso en los días en los que mi familia y yo vivíamos en Rancho Kepler.";
    text[2179] = "Aire fresco... Hermosos árboles y bosques... Era un paraíso.";
    text[2180] = "Mi especialidad son los aerodeslizadores y las naves espaciales.";
    text[2181] = "¡Puedo decirte todo lo que hace falta saber sobre ellos!";
    text[2182] = "Por ejemplo, cada nave especial tienen 3 módulos que puedes personalizar:";
    text[2183] = "¡están el CHASIS DE LA NAVE, EL ALA DE LA NAVE Y EL PROPULSOR DE LA NAVE!";
    text[2184] = "¡Cuando compras tu primera parte de nave, desbloquearás la personalización de nave espacial!";
    text[2188] = "¡Si cambias el color de tu nave espacial le darás un nuevo aspecto!";
    text[2185] = "Cuando el transportador del mapa del mundo esté disponible, solo tienes que";
    text[2186] = "interactuar con el transportador y seleccionar «PERSONALIZAR NAVE».";
    text[2137] = "Hay muchas cosas metidas en tu armario.";
    text[2189] = "No hay nada nuevo en tu armario.";
    text[2190] = "Has encontrado tu antigua colección de yoyós.";
    text[2191] = "Has encontrado un libro llamado: Guía básica del mejor ayudante";
    text[2192] = "Oh... Eso es... ";
    text[2193] = "Es mío. Olvidé que lo había puesto aquí.";
    text[2194] = "Tetra es tonta.";
    text[2199] = "Has encontrado tu traje de baño favorito.";
    text[2200] = "Ahora me están dando ganas de ir a la playa.";
    text[2195] = "Has encontrado un traje de conejito clásico.";
    text[2196] = "¡Creo que todavía quepo dentro!";
    text[2197] = "¿Tetra dónde está tu traje de Halloween?";
    text[2198] = "Hum. En la basura.";
    text[2201] = "ERA UNA ZANAHORIA.";
    text[2202] = "Llegamos tarde y eso era todo lo que quedaba en la tienda...";
    text[2203] = "Muy bien, ¿de qué te quieres disfrazar este año?";
    text[2204] = "Mmmm...";
    text[2205] = "Esta vez yo seré el conejito y tú serás la zanahoria. MUAH, JA, JA, JA.";
    text[2206] = "Has encontrado unas mallas y ropa para hacer ejercicio.";
    text[2207] = "Oh, eso me recuerda algo, ¡no he de olvidar hacer mis flexiones y sentadillas diarias!";
    text[2208] = "¡Has encontrado el Certificado de Graduación en la Academia Lunex!";
    text[2209] = "También has encontrado el Certificado de Primer Premio en el Concurso de Comer Tartas de Queso...";
    text[2210] = "Hay un alijo de barritas de queso debajo de tu ropa.";
    text[2211] = "DEBO RESISTIR LA TENTACIÓN";
    text[2212] = "Has encontrado tu gi de cinturón negro en artes marciales.";
    text[2213] = "LA SALA DE SIMULACIÓN DE COMBATE TE DA LA BIENVENIDA. ¿CÓMO PUEDO AYUDARTE?";
    text[2214] = "COMBATIR";
    text[2215] = "INFO";
    text[2216] = "SALIR";
    text[2217] = "MI PROPÓSITO PRINCIPAL ES DAR A LOS GUERREROS LA OPORTUNIDAD  ";
    text[2218] = "DE PONER A PRUEBA SUS NUEVAS HABILIDADES Y COMBOS LUX.";
    text[2219] = "¡SI ME DERROTAS TAMBIÉN RECIBIRÁS DINERO Y EXPERIENCIA!";
    text[2220] = "¡MODO DE COMBATE ACTIVADO!";
    text[2221] = "MUY BIEN. ¡QUE PASES UN ESTUPENDO DÍA!";
    text[2222] = "Este ordenador se utiliza para reservar una cápsula de curación.";
    text[7128] = "Estos lóbregos con colores alternativos...";
    text[7129] = "No solo tienen un aspecto diferente, ¡sino que también son más fuertes y rápidos!";
    text[7130] = "¡GRRRRRUGH!";
    text[7131] = "¡KAAAAAAH!";
    text[7132] = "Esto no puede ser una coincidencia...";
    text[7133] = "Seguro que es un ataque realizado a conciencia.";
    text[7134] = "Se sabe que los lóbregos no aparecen en el espacio...";
    text[7135] = "Suele aparecer normalmente en la superficie de Luna.";
    text[7196] = "Bella, ten cuidado, por favor.";
    text[7197] = "Lo tendré, no te preocupes.";
    text[7198] = "Me aseguraré de que papá esté bien y de que regrese a casa sano y salvo.";
    text[7199] = "¿Estás lista para ir a la Base Militar, mueh?";
    text[7200] = "¿Has recogido lo que necesitabas de tu habitación?";
    text[7201] = "¡No, todavía no!";
    text[2541] = "No tenemos que ir allí ahora mismo.";
    text[2542] = "SECTOR 4: OCEANUS";
    text[5094] = "ARRECIFE ARMONÍA: MANTENED NUESTRAS AGUAS LIMPIAS";
    text[5178] = "Las señales antiguas de la pared reaccionan a tu presencia.";
    text[5179] = "¡¿...?!";
    text[5484] = "¿Quieres sumergirte bajo el agua?";
    text[5485] = "¿Quieres volver a la superficie?";
    text[5540] = "Parece una especie de portal. No pareces estar activo.";
    text[5541] = "¿Quieres pasar al nivel inferior?";
    text[5432] = "TRAS COMPLETAR LA PRUEBA DEL ALMA, UN NUEVO PERCIBEALMAS DESPERTARÁ...";
    text[5546] = "TÚ CARGARÁS CON LA VOLUNTAD DE LOS SIETE CAMPEONES...";
    text[5547] = "... PARA CONSEGUIR EL EQUILIBRIO UNIVERSAL.";
    text[5439] = "Hay unas inscripciones aquí que hablan de antiguas técnicas de combate en las que se usaba";
    text[5440] = "un arma llamada Espada Reliquia.";
    text[5441] = "Esta espada era capaz de canalizar la lux del usuario para realizar técnicas especiales.";
    text[5433] = "ESPADA RELIQUIA ROJA: OTORGA FUERZA AL PERCIBEALMAS";
    text[5434] = "ESPADA RELIQUIA AZUL: AUMENTA LA LUX DEL PERCIBEALMAS";
    text[5435] = "ESPADA RELIQUIA AMARILLA: REFUERZA LAS DEFENSAS DEL PERCIBEALMAS.";
    text[5581] = "PARA IR MÁS ALLÁ DE LAS TÉCNICAS ESTÁNDAR DE LA ESPADA RELIQUIA";
    text[5582] = "AQUEL QUE LA BLANDA DEBE COMBINAR LAS GEMAS PARA AUMENTAR SU PODER.";
    text[5436] = "TÉCNICA SECRETA DE ESPADA RELIQUIA NARANJA: OTORGA AL PERCIBEALMAS REGENERACIÓN DE PE.";
    text[5437] = "TÉCNICA SECRETA DE ESPADA RELIQUIA VERDE: CURA AL PERCIBEALMAS.";
    text[5438] = "TÉCNICA SECRETA DE ESPADA RELIQUIA MORADA: PROBABILIDAD DE ACABAR CON EL ENEMIGO AL INSTANTE";
    text[5510] = "A LOS VIAJEROS QUE LEAN NUESTROS TEXTOS...";
    text[5511] = "LLEVAD CON VOSOTROS... LA SABIDURÍA Y LAS HISTORIAS DE NUESTRA GENTE...";
    text[5512] = "NO SABEMOS LO QUE NOS DEPARA EL FUTURO...";
    text[5513] = "PERO ESPERAMOS QUE TENGÁIS ÉXITO DONDE NOSOTROS HEMOS FALLADO...";
    text[5514] = "Un momento... No recuerdo haber leído esto la última vez que estuve aquí...";
    text[5515] = "¡¿Las inscripciones han cambiado?! Eso no es posible.";
    text[5516] = "Es posible que algunos textos solo aparezcan cuando hay";
    text[5517] = "presente alguien con genes de los Antiguos... No descartaría esa posibilidad.";
    text[5518] = "¡Qué interesante!";
    text[5519] = "Eso quiere decir...";
    text[5520] = "¡Los textos de los Antiguos que la humanidad ha reunido y preservado podrían";
    text[5521] = "conseguir más información y secretos de lo que imaginábamos!";
    text[5522] = "¡Esto podría ser el descubrimiento del siglo!";
    text[5523] = "¡Echemos un vistazo al resto de las inscripciones de la pared!";
    text[5524] = "Vaya, ¿es que la aventura corre por las venas de este chico, o qué?";
    text[5525] = "Es agradable verle emocionado por una vez.";
    text[5526] = "¿Entonces es un tipo duro por fuera, pero un empollón por dentro?";
    text[5527] = "¡Eh! ¿Qué estáis cuchicheando vosotras dos?";
    text[5528] = "¡Nada!";
    text[5529] = "Sí, ¡nada!";
    text[5534] = "SOLDADO DE LA LUZ: NUESTRO LUMIKNIGHT PERFORACIELOS.";
    text[5535] = "LUX: LA MANIFESTACIÓN DEL ALMA.";
    text[5536] = "SI UN GUERRERO APRENDIERA A MANEJARLA...";
    text[5537] = "EL PODER PARA CAMBIAR EL MUNDO ESTARÍA A SU ALCANCE...";
    text[5538] = "ANTIMATERIA: EL PODER CAÓTICO, PERO ETÉREO, DEL UNIVERSO.";
    text[5539] = "LA ETERNIDAD CÓSMICA ESTARÍA AL ALCANCE DE LA MANO...";
    text[5542] = "YA NO ES SEGURO VIAJAR POR LA ZONA...";
    text[5543] = "DEBEMOS EVOLUCIONAR...";
    text[5544] = "O CAER EN UN SUEÑO ETERNO TRAS PERECER ANTE EL PODER GALÁCTICO DE...";
    text[5545] = "NUESTRA NÉMESIS.";
    text[5548] = "EL SELLO SE HA ROTO.";
    text[5549] = "AHORA LA ESPADA DE LOS ANTIGUOS ES TUYA.";
    text[5551] = "¡Vaya es un receptáculo antiguo!";
    text[5552] = "Si, los receptáculos y el armamento que usamos en nuestros días se derivan";
    text[5553] = "de la tecnología que dejaron los Antiguos.";
    text[5554] = "Es sorprendente que los científicos fueran capaces de descubrir cómo usar esta tecnología.";
    text[5555] = "Tienes que dar algo de crédito a la humanidad: ¡la ciencia es nuestro fuerte! Je.";
    text[5556] = "RECEPTÁCULO LUNAR... EL Q............ DUERME.";
    text[5557] = "L...N...R...X";
    text[5558] = "RECEPTÁCULO TERRANO... OLVIDO";
    text[5559] = "EL RESTO DEL TEXTO DE ESTA ESTATUA ES ILEGIBLE.";
    text[5560] = "NUESTROS SIETE CAMPEONES...";
    text[5561] = "LA SABIDURÍA DE TYCHO";
    text[5562] = "EL VALOR DE SILICA";
    text[5563] = "LA DETERMINACIÓN DE COPERNICUS";
    text[5564] = "LA BONDAD DE LUMINA";
    text[5565] = "LA JUSTICIA DE MAGNESIA";
    text[5566] = "EL ORGULLO DE GRIMALDI";
    text[5567] = "LA CONFIANZA DE REGALIA";
    text[5568] = "Esos nombres... ";
    text[5569] = "¡Son los nombres de nuestras colonias!";
    text[5570] = "Los siete campeones...";
    text[5571] = "Sabemos que nuestras colonias recibieron el nombre de sus fundadores.";
    text[5572] = "Es extraño... No existen registros que indiquen que hubiera antiguos vivos";
    text[5573] = "cuando nuestras colonias se fundaron.";
    text[5574] = "¿Es posible que sea una coincidencia afortunada?";
    text[5575] = "No lo sé...";
    text[5576] = "Si conseguimos sobrevivir al cometa Coda, tendré que investigar esto algún día.";
    text[5577] = "Esta losa muestras una ilustración en la que aparecen Luna y Terra en un lado...";
    text[5578] = "El otro lado ha sido destruido.";
    text[5579] = "¿ES POSIBLE QUE NUESTRA BÚSQUEDA DE LA ETERNIDAD FUERA NUESTRA PERDICIÓN?";
    text[5580] = "SOLO EL TIEMPO LO DIRÁ...";
    text[5584] = "EL CICLO DE LAS CALAMIDADES CÓSMICAS ES IRREVOCABLE...";
    text[5585] = "TAL VEZ LA CLAVE ESTÉ EN LA UNIÓN DE LA LUX Y LA ANTIMATERIA...";
    text[5586] = "... DOS FUERZAS QUE SE UNEN PARA FORMAR UN PODER ESPIRAL";
    text[5587] = "CAPAZ DE SOBREVIVIR Y TOMAR EL CONTROL DEL FUTURO.";
    text[5588] = "EL PILAR DE LA PAZ...";
    text[5589] = "... SOLO ES TAN FUERTE COMO SU POTENCIAL PARA LA COMUNICACIÓN.";
    text[5590] = "LA CAPACIDAD DE CONECTAR CON OTROS A TRAVÉS DEL ALMA...";
    text[5591] = "... PERMITIRÁ EL ENTENDIMIENTO MUTUO.";
    text[5592] = "Es una estatua que representa a un aventurero antiguo.";
    text[5593] = "Hay una GEMA engarzada en su pecho.";
    text[5594] = "Tocas la GEMA suavemente... ¡y de pronto empieza a desvanecerse!";
    text[5595] = "Una voz resuena en las ruinas:";
    text[5596] = "QUEDAN TRES GEMAS.";
    text[5597] = "QUEDAN DOS GEMAS.";
    text[5598] = "QUEDA UNA GEMA.";
    text[5599] = "LO HAS HECHO BIEN, PERCIBEALMAS.";
    text[5600] = "REGRESA AL NIVEL SUPERIOR. TE ESTARÉ ESPERANDO.";
    text[5482] = "EL COMBO LUX SAGRADO DE LOS ANTIGUOS...";
    text[5483] = "TRES ESPADAS RELIQUIA... Y GUARDIOS ENTRARÁ EN COMBATE.";
    text[2795] = "Este receptáculo guerrero se creó para ayudar a proteger a los ciudadanos del peligro.";
    text[2796] = "Srta. Bella, no se preocupe por los lóbregos. ¡Nos encargaremos de ellos!";
    text[2797] = "Santo cielo, ¡¿es que esos lóbregos se han tomado algunos energ-Os antes de aparecer?!";
    text[2798] = "Son mucho más rápidos y fuertes que los lóbregos con los que solemos luchar.";
    text[2799] = "Todo este daño y este caos... ¿Terminarán algún día?";
    text[2800] = "Esto es terrible... ¿Qué podría haber causado un ataque de estas proporciones?";
    text[2801] = "¿Has visto una máquina de filtrado en algún sitio?";
    text[2802] = "Mmm... Creo que había una al norte.";
    text[2803] = "¡Está cerca de la tienda de enlaces neurales!";
    text[2804] = "Srta. Bella, hemos evacuado a todos a partir de este punto.";
    text[2805] = "Esta zona está cerrada por ahora.";
    text[2806] = "¡KYA, JA, JA, JA, JAGH!";
    text[3319] = "El Café Copernicus está cerrado en este momento.";
    text[3320] = "Los lóbregos nos han superado en número...";
    text[3321] = "¡El equipo médico debería llegar pronto! ¡No desfallezcáis!";
    text[3322] = "...";
    text[3323] = "Acabo de escanearle. Se encuentra perfectamente.";
    text[3324] = "¡Eh! No lo digas tan alto, ¿Vale? Vas a reventar mi tapadera.";
    text[3325] = "E-estos lóbregos son demasiado fuertes para mí...";
    text[3326] = "Este soldado está inconsciente...";
    text[3327] = "Sale un aire frío a través del conducto del aire...";
    text[3328] = "La puerta está cerrada. Acceso restringido a residentes.";
    text[3329] = "Esta puerta está cerrada.";
    text[3332] = "En este momento se están realizando labores de mantenimiento en la depuradora.";
    text[3333] = "Es un macizo de flox nocturnas.";
    text[3334] = "Poseen una agradable fragancia de vainilla y almendras con miel.";
    text[3335] = "Esta escotilla de acceso lleva a la infraestructura del reservorio de agua";
    text[3336] = "que hay bajo la ciudad. Desgraciadamente, está cerrada desde el otro lado.";
    text[3337] = "AVISO: LAS MÁQUINAS DE FILTRADO ESTÁN VIGILADAS LAS 24 HORAS";
    text[3338] = "NO MANIPULAR. SOLO PERSONAL AUTORIZADO.";
    text[3339] = "Escuchas unos extraños ruidos tras esta puerta.";
    text[3340] = "Astropuerto de Copernicus";
    text[3341] = "SECTOR 7: COPERNICUS\nDistrito Norte";
    text[3342] = "SECTOR 7: COPERNICUS\nDistrito Sur";
    text[3343] = "SECTOR 7: COPERNICUS\nDistrito Central";
    text[3344] = "¡Esta pantalla muestra un mapa de Copernicus!";
    text[3345] = "Hay una pequeña nota pegada a la pantalla:";
    text[3346] = "Flecha 1: Arriba";
    text[3347] = "Flecha 2: Derecha";
    text[3348] = "Flecha 3: Abajo";
    text[3349] = "Flecha 4: Izquierda";
    text[3350] = "Flecha 5: Derecha";
    text[3351] = "SECTOR 7: COPERNICUS\nDistrito Este 439";
    text[3352] = "¡El Café Copernicus os da la bienvenida!";
    text[3353] = "¡Disfrutad de nuestras deliciosas barritas de queso y nuestros famosos batidos de fresa!";
    text[3354] = "Es una caja de herramientas abandonada.";
    text[3355] = "Hay una nota dentro en la que han escrito unos números: 439625.";
    text[3356] = "¡Esta máquina expendedora vence Barritax Choco, una deliciosa galleta de chocolate y almendras!";
    text[3357] = "Eh... ¡¿Cómo es que esta papelera contiene arena de gato?!";
    text[3358] = "Srta. Bella, ¡hemos evacuado a todos los civiles!";
    text[3359] = "También hemos eliminado a todos los lóbregos de las inmediaciones.";
    text[3360] = "Parece que la situación se ha calmado bastante.";
    text[3361] = "He ordenado a algunos soldados que lo revisen todo para comprobar que no haya más lóbregos.";
    text[3362] = "Cuando determinemos el alcance de los daños,";
    text[3363] = "los civiles deberían poder regresar a sus hogares.";
    text[3364] = "No puedo más...";
    text[3365] = "Esos lóbregos eran más fuertes de lo que esperábamos...";
    text[3366] = "Odio a esos lóbregos specter... Tienen tanta vida...";
    text[3367] = "¿Tienes alguna habilidad o combo lux que pueda atacar a varios enemigos?";
    text[3368] = "No... No es raro que me costara tanto.";
    text[3369] = "Este soldado está demasiado cansado para hablar...";
    text[3370] = "Descansa. ¡Lo has hecho muy bien!";
    text[3371] = "Algunos de nuestros soldados están con el equipo médico para curar sus heridas.";
    text[3372] = "Pegas la oreja a la puerta del cuarto de baño.";
    text[3373] = "Se escuchan maullidos y ronroneos de vez en cuando.";
    text[3374] = "¡¿Por qué SIEMPRE PASAN estas cosas?!";
    text[3375] = "Acabo mi comida y veo que el baño está libre.";
    text[3376] = "El camarero viene con la cuenta y veo que algo se dirige a toda velocidad hacia el baño.";
    text[3377] = "Pasó tan rápido que solo vi un borrón.";
    text[3378] = "Vamos, tiene que darse prisa... ¡Llevo 30 minutos esperando!";
    text[3379] = "Mmm... ¿Por qué no llamas a la puerta? Así sabrán que hay alguien esperando.";
    text[3380] = "¿Eso no es una falta de educación? Prefiero esperar...";
    text[3381] = "... Eh.";
    text[3382] = "¡Únete a nuestro concurso de pesca anual en Oceanus!";
    text[3383] = "¡Tenemos rifas, premios y pescado frito gratis!";
    text[3384] = "Hay algo escrito en uno de los artículos:";
    text[3385] = "¡Madre mía, la comida en este sitio es deliciosa!";
    text[3386] = "¡Sí! ¡Cada café tiene su propia especialidad!";
    text[3387] = "He oído que el Café Regolithia está bastante infravalorado, ¡deberíamos ir allí de inmediato!";
    text[3388] = "Nos vemos, guerrera prodigio.";
    text[3389] = "¡Eh!";
    text[3390] = "Los ciudadanos de Copernicus llevan sus asuntos sorprendentemente bien,";
    text[3391] = "sobre todo después de todo lo que ha ocurrido hoy.";
    text[3392] = "No es raro que las cosas vayan mal en Luna.";
    text[3393] = "La mayor parte de los ciudadanos, inclusos aquellos de edad temprana, ha recibido entrenamiento para afrontar";
    text[3394] = "situaciones y casos de emergencia.";
    text[3395] = "A fin de cuentas, vivimos en un hermoso satélite plateado situado en el espacio.";
    text[3396] = "Antes de los lóbregos, la gente tenía que procurar que se llevara a cabo un mantenimiento adecuado de";
    text[3397] = "los sistemas de oxígeno y gravedad. ";
    text[3398] = "Era una batalla constante para mejorar la tecnología y convertir Luna en un lugar en el que fuera seguro vivir.";
    text[3399] = "¡Es un antiguo cartel en el que se anuncia la Pizza Lunar con Queso!";
    text[3400] = "Debajo hay una exención de responsabilidad: «En honor del Día Nacional del Queso Mohoso, ";
    text[3401] = "queremos recordar que el satélite en realidad no está hecho de queso». WAZA";
    text[3402] = "La marca de fecha del cartel indica que se realizó el 9 de octubre de 2019.";
    text[3405] = "¡Hoy ha sido un día muy estresante! Necesito algo de comida casera para relajarme...";
    text[3406] = "¡Gracias por visitar el Café Copernicus!";
    text[3407] = "¡Espero que hayas disfrutado de tu estancia, y gracias por escogernos!";
    text[3408] = "Es un cartel en el que se anuncia un tour en jet para visitar Oceanus.";
    text[3409] = "«¡Venga a ver las célebres y hermosas Piedras Lunares de cerca!»";
    text[3410] = "Hay algo más escrito en la parte inferior del cartel:";
    text[3411] = "Esta puerta lleva a la cocina.";
    text[3412] = "Echas un vistazo a través del borroso cristal y te parece ver a un perro con un sombrero de chef.";
    text[3413] = "Hay documentos sobre los derechos de los empleados y las normativas sanitarias de alimentos";
    text[3414] = "en este panel de anuncios.";
    text[3415] = "¡Mamá, mira! ¡Nuestra heroína!";
    text[3416] = "¡Hola, querida! Desde que nos salvaste de esos lóbregos,";
    text[3417] = "mi hijo no deja de hablar de lo heroica y guay que fuiste.";
    text[3418] = "Le diste la inspiración necesaria para ser valiente, incluso frente al peligro. ";
    text[3419] = "S-señorita, quiero que tenga esto.";
    text[3420] = "¡Has obtenido el peluche BERSERKER BOY!";
    text[3421] = "¡Acabas de añadir un nuevo peluche a tu habitación!";
    text[3422] = "¡Ooooh, gracias por el regalo!";
    text[3423] = "Es mi peluche favorito, je, je.";
    text[3424] = "¡Cuídate, querida!";
    text[3425] = "¡Adiós! ¡Cuida bien de mi peluche por mí! Je, je.";
    text[3426] = "Cuando ese chico crezca va a convertirse en un guerrero electrizante.";
    text[3427] = "Lo sé.";
    text[3428] = "El edificio de depuración es el que más daños ha sufrido.";
    text[3429] = "¡El tejado está hecho un desastre! ¡¿Qué demonios ha pasado aquí?!";
    text[3430] = "Je, je, je...";
    text[3403] = "Los daños constantes causados por los lóbregos nos han obligado a mejorar nuestra";
    text[3404] = "tecnología de construcción. ¡Ahora solo necesitamos unas horas para reparar nuestras ciudades!";
    text[3453] = "Mientras llevábamos a cabo una investigación en el Distrito Este, mi colega y yo encontramos una caja fuerte cerrada.";
    text[3454] = "Tratamos varias combinaciones, pero no conseguimos abrirla.";
    text[3455] = "Sin embargo... Tengo el fuerte presentimiento de que la flecha 3 de la combinación apunta abajo.";
    text[3456] = "(Presiento que la flecha 4 apunta a la izquierda...)";
    text[3457] = "¿Mmmm? ¿Qué estaba farfullando?";
    text[3458] = "(Si lo descubre, podría encontrar el código de acceso antes que yo).";
    text[3459] = "Hablas muy alto cuando farfullas. Es prácticamente como si dijeras tus pensamientos en voz alta.";
    text[3460] = "Diablos. Pretende que no has escuchado nada.";
    text[3461] = "Entonces mi colega tampoco te dirá nada. Hum.";
    text[3462] = "Este ataque me ha demostrado lo mucho que tengo que entrenar todavía.";
    text[3463] = "¡¿Has visto al Escuadrón Raine en acción?!";
    text[3464] = "¡Derrotaban a lóbregos a izquierda y derecha ";
    text[3465] = "y todo eso mientras se aseguraban de que los ciudadanos escaparan sanos y salvos!";
    text[3466] = "Me contentaría con ser la mitad de fuerte que el Escuadrón Raine algún día.";
    text[3467] = "¿Has oído hablar de los EFECTOS DE ESTADO?";
    text[3468] = "¡Cuando infliges ATURDIMIENTO a un enemigo, haces que se salte su fase de ataque durante 1 turno!";
    text[3469] = "Cuando infliges QUEMADURA a un enemigo, esta suele durar 3 turnos.";
    text[3470] = "Los enemigos con quemadura pierden 30 PV al principio de su fase de ataque.";
    text[3471] = "¡Vaya, veo que has investigado mucho!";
    text[3472] = "Je, je. Mi mamá es comerciante de enlaces neurales, ¡lo he aprendido todo de ella!";
    text[3473] = "La Fuerza Lunex me envió para asegurarse de que la red de depuración seguía funcionando.";
    text[3474] = "Me sorprende que tu robot ayudante arreglara la red tan fácilmente.";
    text[3475] = "Je.";
    text[3476] = "Solo han pasado unas horas desde que volvimos a permitir el acceso a la ciudad.";
    text[3477] = "Las carreteras y las autopistas todavía están bastante vacías.";
    text[3478] = "Supongo que la ciudad tardará un poco de tiempo en recuperar su ajetreo habitual.";
    text[3479] = "Saros nos recomendó que patrulláramos por la ciudad algunas horas más por si";
    text[3480] = "quedaba algún lóbrego. Nunca se sabe cuándo se producirá una nueva oleada.";
    text[3481] = "¡¿Cómo dices?! ¡¿Que no solo te pidieron que restauraras la red de depuración, ";
    text[3482] = "sino que también formabas parte de una operación secreta para capturar al Matalóbregos?! ";
    text[3483] = "La ciudad de Copernicus está construida en un cráter lunar de 90 kilómetros.";
    text[3484] = "Aunque es uno de los mayores cráteres de Luna, no es el más profundo.";
    text[3485] = "Este título le corresponde a Grimaldi, al que llamamos el Cráter de la Oscuridad Eterna.";
    text[3486] = "Algunas partes de Grimaldi son tan profundas que la luz solar nunca llega a ellas.";
    text[3487] = "La vida en la ciudad es estupenda y todo eso,";
    text[3488] = "pero creo que es hora de ir a otro sector.";
    text[3489] = "Rancho Kepler parece un lugar bonito y pacífico en el que vivir.";
    text[3565] = "Es un sistema de paneles lunares de alto voltaje.";
    text[3566] = "Un bromista retorcido ha escrito algunos juegos de palabras en este cono.";
    text[3567] = "Es un cono de tráfico abandonado.";
    text[3568] = "Este cubo está lleno de agua mineral rica en nutrientes.";
    text[3569] = "SECTOR 8: RANCHO KEPLER";
    text[3571] = "Oooh... ¿esa no es la casa de Zara?";
    text[3572] = "¡Sí! ¡No está en casa en este momento, volvamos más tarde!";
    text[3573] = "Es una caja de herramientas roja y oxidada.";
    text[3574] = "¿Qué misterios hay en su interior? Nadie lo sabe.";
    text[3575] = "Es una práctica caja de herramientas azul. Parece que la han usado con frecuencia.";
    text[3576] = "Los pozos de agua constituyen una fuente fiable y abundante de agua fresca";
    text[3577] = "para aquellos que residen en el Rancho Kepler.";
    text[3578] = "Es un enorme generador de energía que parece un pozo de agua.";
    text[3579] = "¡El Rancho Kepler también tiene paneles lunares!";
    text[3580] = "Parece que una pequeña tienda abrirá aquí pronto.";
    text[3581] = "Es un panel comunitario anticuado. Aquí suelen publicarse solicitudes de empleo, anuncios,";
    text[3582] = "noticias diarias y panfletos sobre comidas comunitarias los fines de semana. ";
    text[3583] = "Una pequeña nota adhesiva te llama la atención.";
    text[3584] = "Tiene escritos los números 323881.";
    text[3585] = "He escuchado que los que comen estos champiñones crecen mucho.";
    text[3586] = "¿Cómo? ¿Dónde has escuchado eso?";
    text[3587] = "Tengo mis fuentes, je.";
    text[3588] = "Esta señal lleva a las distintas granjas de Rancho Kepler.";
    text[3589] = "Estos contenedores de mercancía permiten controlar la temperatura para que la comida";
    text[3590] = "y los productos que hay dentro se mantengan frescos durante largos periodos de tiempo.";
    text[3591] = "¡Un montón de leños de madera recién cortados!";
    text[3592] = "En esta parcela de terreno se cultivan calabazas, trigo y lechugas.";
    text[3593] = "En esta parcela de terreno se cultivan maíz, trigo y patatas.";
    text[3594] = "¡Mira, Bella! ¡Aquí hay coles, maíz, calabazas y fresas!";
    text[3595] = "Aquí han colgado ropa lavada a mano para que se seque.";
    text[3596] = "Esta papelera de reciclaje está llena hasta arriba de latas de Hetap.";
    text[3597] = "Los cultivos de esta parcela se han arrancado violentamente del suelo.";
    text[3598] = "En el suelo de esta zona hay restos de antimateria...";
    text[3599] = "Es una planta de menta superviviente. Hay pequeñas huellas alrededor del suelo.";
    text[3600] = "Esta máquina expendedora vende pastelitos Terciopelo Rojo. Está hasta arriba.";
    text[3601] = "Raine vive en este edifico de apartamentos, ¿verdad?";
    text[3602] = "¡SÍ! Pero no está en casa en este momento. Volvamos más tarde.";
    text[3603] = "Para la Corporación Energ-O su salud es lo más importante.";
    text[3604] = "¡Use esto para mejorar su salud! CÓDIGO: 501996.";
    text[3605] = "ASTROAVENIDA";
    text[3606] = "SECTOR 15: TYCHO";
    text[3607] = "¡Te damos la bienvenida a la ciudad de la ciencia y la tecnología!";
    text[3608] = "¡Es el panel de anuncios de Tycho!";
    text[3609] = "¡El Café Tycho os da la bienvenida!";
    text[3610] = "¡Disfrutad de nuestros deliciosos sándwiches de pollo y nuestros famosos pastelitos Terciopelo Verde!";
    text[3611] = "El Café Tycho está cerrado en este momento para hacer renovaciones.";
    text[3612] = "Ooooh, quería su deliciosa comida. ¡Tenemos que volver cuando abran!";
    text[3613] = "Esta máquina expendedora vende pastelitos Terciopelo Verde. No le quedan existencias.";
    text[3614] = "¡Es un anuncio del sándwich de pollo crujiente del Café Tycho!";
    text[3615] = "Se necesita una TARJETA DE ACCESO para entrar.";
    text[3616] = "CORPORACIÓN ENERG-O";
    text[3617] = "Cita del día: «¡Rechaza el sentido común para hacer que lo imposible sea posible!»";
    text[3666] = "Soy el director general de un famoso producto capilar: ¡Calvafuera!";
    text[3667] = "¡El objetivo de mi vida es procurar que mis clientes siempre tengan un cabello lustroso y sano!";
    text[3701] = "En Tycho los negocios nunca paran.";
    text[3702] = "Hay oficinas corporativas, tiendas, mercaderes, restaurantes... ¡lo que tú quieras!";
    text[3703] = "Personalmente, me encanta ir a las rebajas de las tiendas y tomar algo de beber en el Café Tycho.";
    text[3704] = "¡E-eh! ¡Usted es esa soldado lunex con el pelo rosa! La Srta. Bella, ¿verdad?";
    text[3705] = "Sí, soy yo. ¿Nos hemos visto antes?";
    text[3706] = "No, no la verdad es que no... Pero mi mujer y mi hijo me han hablado de usted.";
    text[3707] = "Es la que les salvó de un grupo de lóbregos durante el último ataque.";
    text[3708] = "¡No sé cómo darle las gracias!";
    text[3709] = "Oh, ¡no hay nada que agradecer! Me alegro de que su familia esté a salvo.";
    text[3710] = "Vivo en Copernicus, pero vengo a Tycho para trabajar.";
    text[3711] = "Me preocupé muchísimo cuando me enteré de las noticias...";
    text[3712] = "¡Gracias de nuevo, Srta. Bella! ¡Cuídese!";
    text[3713] = "Eh, ¡qué robot más guay!";
    text[3714] = "¿Cómo te llamas?";
    text[3715] = "¡Tetra!";
    text[3716] = "¡Es un placer conocerte, Tetra!";
    text[3717] = "¡Me llamo Zeek!";
    text[3718] = "De hecho, voy a abrir una tienda de robótica justo detrás de mí.";
    text[3719] = "¡Todavía estamos haciendo preparativos, pero pronto haremos nuestra gran inauguración!";
    text[3720] = "¡Podría mejorar las armas de Tetra para que su Cañonazo Tetra sea más poderoso!";
    text[3721] = "¡Ooooh! ¡Eso sería estupendo!";
    text[3722] = "¡SÍ, SÍ! Más mejoras = mejor ayudante, je.";
    text[3723] = "¡Escanead mi código de comunicación y recibiréis una notificación cuando la tienda abra!";
    text[3724] = "¡Escaneo realizado!";
    text[3725] = "¡Estupendo! ¡Os veo en la gran inauguración!";
    text[3752] = "Tycho es uno de los últimos sectores que se construyeron en Luna.";
    text[3753] = "Por muy chocante que pueda parecer, Tycho es en realidad una ciudad móvil.";
    text[3754] = "¿Cómo? ¡¿Qué quieres decir con «móvil»?!";
    text[3755] = "¡Toda la ciudad es modular, y está construida sobre una colosal estructura";
    text[3756] = "que puede mover lentamente toda la ciudad a una nueva ubicación!";
    text[3757] = "Solía estar en el sector más meridional de Luna.";
    text[3758] = "¿Por qué hubo que reubicar la ciudad?";
    text[3759] = "Con el paso del tiempo se desarrollaron duras condiciones climáticas en el sur.";
    text[3760] = "Era difícil que la gente de Luna eligiera Tycho como lugar en el que";
    text[3761] = "establecerse, y hubo que reubicar la ciudad.";
    text[3762] = "Vaya, ¡eso mola un montón!";
    text[3763] = "¿Os gustaría escuchar un divertido hecho histórico de Tycho?";
    text[3764] = "Este es otro dato interesante.";
    text[3765] = "El cielo en Tycho es de color amarillo porque la Astrobarrera de esa zona";
    text[3766] = "se adaptó para poder soportar el duro clima del sur.";
    text[3767] = "¡Claro!";
    text[3768] = "No, nada.";
    text[3769] = "No pasa nada. Perdón por las molestias... ";
    text[3800] = "¿Por qué...?";
    text[3801] = "Vine aquí con la esperanza de encontrar un baño que estuviera disponible...";
    text[3802] = "¡¿Es que estoy condenado a esperar por toda la eternidad?!...";
    text[3803] = "Mmm... ¿Tal vez podrías resolver tu problema tras un árbol?";
    text[3804] = "... ¿Y mancillar esta preciosa y sagrada tierra llena de exuberante naturaleza?";
    text[3805] = "No, gracias. Esperaré...";
    text[3811] = "Nuestros animales se encuentran en otra granja.";
    text[3812] = "Les damos todo el amor, la atención y la libertad que necesitan para ser felices y estar sanos.";
    text[3813] = "¡Estoy buscando orugas y hormigas!";
    text[3814] = "Rancho Kepler es un lugar prefecto para los bichos, je, je.";
    text[3815] = "¡Quiero coleccionarlos todos!";
    text[3816] = "Estoy tratando de dar con nombres de ataque que molen.";
    text[3817] = "¡A mi hermana se le ocurren los mejores nombres para ataques!";
    text[3818] = "¿Cuál es tu ataque distintivo?";
    text[3819] = "Puñetazo Nova de Medianoche Oscuro, je.";
    text[3820] = "El mío se llama Cañonazo Tetra...";
    text[3821] = "No es tan guay como el tuyo...";
    text[3822] = "¡Kamehameha!";
    text[3823] = "¡Cañón de Alubias Especial!";
    text[3824] = "¡Empujón Eléctrico!";
    text[3825] = "¡Shuriken Eólico!";
    text[3826] = "¡Puñetazo Solemne!";
    text[3827] = "Rancho Kepler es solo una de las muchas granjas del sector 8.";
    text[3828] = "Cada granja se ocupa de diferentes aspectos de la producción y el desarrollo de comida.";
    text[3829] = "He de dar crédito a las generaciones de botánicos que ayudaron";
    text[3830] = "a crear las bases para que la vida vegetal pudiera crecer en Luna. Es sinceramente sorprendente.";
    text[3831] = "Rancho Kepler es como un hogar fuera del hogar.";
    text[3832] = "Si alguna vez te habías preguntado cómo era Terra hace mil años...";
    text[3833] = "Bueno... Rancho Kepler ofrece lo más cercano a un paisaje de Terra.";
    text[3834] = "La madera solía ser bastante barata antaño.";
    text[3835] = "¡Hoy en día es tremendamente cara!";
    text[3836] = "Es comprensible. No hay muchos árboles en Luna.";
    text[3618] = "SOLO PERSONAL AUTORIZADO DE LA FUERZA LUNEX";
    text[3619] = "CG LUNEX: COMPLEJO PENITENCIARIO SUBTERRÁNEO";
    text[3620] = "ALCANTARILLAS: SOLO ACCESO PARA MANTENIMIENTO";
    text[3621] = "CG DE FUERZA LUNEX: BASE MILITAR";
    text[3622] = "BASE MILITAR: ENTRADA PRINCIPAL";
    text[3623] = "SECTOR 13: GRIMALDI";
    text[3624] = "ESTE: ZONA YERMA 1";
    text[3625] = "OESTE: ZONA YERMA 2";
    text[3627] = "Me pregunto cómo sería luchar contra un receptáculo de tipo guerrero...";
    text[3628] = "¡Espera, Tetra, no te acerques!";
    text[3629] = "MODO DE COMBATE ACTIVADO";
    text[3630] = "Ups...";
    text[3631] = "Debe haber un error en el programa, ¡no debería considerarnos una amenaza!";
    text[3632] = "¡Tenemos que desactivar el receptáculo!";
    text[3657] = "Hay soldados de servicio a todas horas en el CG Lunex para cumplir los protocolos de seguridad.";
    text[3658] = "Ten cuidado y no te acerques demasiado a los drones o los receptáculos.";
    text[3659] = "Indique qué le trae aquí, soldado.";
    text[3660] = "Oh... Eh...";
    text[3661] = "Solo estamos dando una vuelta. No debería haber ningún problema, ¿verdad?";
    text[3662] = "Negativo. Si no está de servicio, debe abandonar este lugar de inmediato.";
    text[3663] = "(Jooope. Este se toma el protocolo demasiado en serio).";
    text[3664] = "(Solo está haciendo su trabajo. Sigamos adelante).";
    text[3665] = "¡Uuuuuh! ¡Uuuuuh!";
    text[3670] = "Por alguna extraña razón, suelen aparecer más lóbregos en la Zona Yerma que en cualquier otro punto de Luna.";
    text[3671] = "Los avirell no suelen ser agresivos,";
    text[3672] = "pero se han notificado varios casos en los que atacaron a nuestros soldados.";
    text[3673] = "Mmm, tus balas no parecen tener mucho efecto...";
    text[3674] = "Oye, solo estoy tratando de asustarles...";
    text[3675] = "¿Has luchado contra un avirell antes?";
    text[3676] = "Pueden crear clones de energía de ellos mismos, y son capaces de cambiar de fase.";
    text[3677] = "Esto hace que sea difícil alcanzarles con nuestras armas.";
    text[3678] = "Mmm... Creo que tienes que mejorar tu puntería.";
    text[3679] = "¡¿Perdona?! ¿Por qué no tratas de alcanzarles tú?";
    text[3680] = "No gracias. Prefiero no hacerlo.";
    text[3681] = "¡Buena suerte!";
    text[3682] = "...";
    text[3683] = "¿Sabías que cuando un lóbrego sufre el EFECTO DE ESTADO REMOJÓN,";
    text[3684] = "los ataques que se lancen contra ese lóbrego llenarán más tu BARRA DE LUX?";
    text[3685] = "Hace poco que han llevado al Matalóbregos al COMPLEJO PENITENCIARIO.";
    text[3686] = "El general Saros nos pidió que permaneciéramos alerta,";
    text[3687] = "por si tratara de escapar.";
    text[4044] = "Estamos tratando de no llamar la atención, ¿recuerdas?";
    text[4045] = "No creo que debamos pasar por esta entrada en este momento.";
    text[4046] = "Creo que esta puerta lleva afuera.";
    text[4047] = "No vayamos allí ahora mismo... Los guardias podrían sospechar.";
    text[4048] = "¡Espera! ¡Si avanzamos más, los guardias nos verán!";
    text[4049] = "Esta zona lleva a la entrada del Complejo Penitenciario.";
    text[4050] = "¡Tenemos que ir por otro camino!";
    text[4051] = "¿Te gustaría entrar en las Alcantarillas?";
    text[4052] = "¡Esta máquina tiene un ordenador que controla las puertas láser!";
    text[4053] = "¿Te gustaría que entrara en la red de las Alcantarillas?";
    text[4054] = "¡Has pulsado el interruptor del panel de control!";
    text[4055] = "Los láseres de las cercanías se han desactivado.";
    text[4056] = "¡La dirección de las BALDOSAS CON FLECHAS ROJAS ha cambiado!";
    text[4206] = "LLAVE LUNEX CONFIRMADA. ACCESO CONCEDIDO.";
    text[4238] = "ATENCIÓN: RESIDUOS PELIGROSOS";
    text[4239] = "SALA ¿¿?? La pantalla digital está estropeada...";
    text[4240] = "ESCOTILLA DE ACCESO AL COMPLEJO PENITENCIARIO.";
    text[4334] = "Nadie puede acceder al cuarto del general sin permiso explícito.";
    text[4335] = "La Base Militar se construyó cerca del Cráter de la Oscuridad Eterna.";
    text[4336] = "Es el cráter más profundo de Luna.";
    text[4337] = "La luz apenas llega al fondo del cráter. Siempre me da miedo ir allí...";
    text[4338] = "Tengo algo de sed, pero también me apetece un tentempié...";
    text[4339] = "¿Qué crees que debería conseguir en la máquina expendedora?";
    text[4340] = "Barrita de tarta de queso";
    text[4341] = "Energ-O maestro";
    text[4342] = "Socorrealmas";
    text[4343] = "¡Vaya! ¡Parece que la máquina me ha dado dos unidades!";
    text[4344] = "¡Toma, puedes quedarte el artículo extra!";
    text[4345] = "Supongo que debería volver al trabajo pronto.";
    text[4346] = "Un descanso de cinco minutos es más que suficiente, ¡ja, ja, ja!";
    text[4347] = "Últimamente el número de soldados de la base se ha reducido,";
    text[4348] = "debido al aumento de apariciones de lóbregos.";
    text[4349] = "La mayor parte de los soldados están patrullando el sector o recogiendo antinúcleos.";
    text[4350] = "Los trajes impulsores de la Fuerza Lunex están hechos con los mejores materiales de grado militar existentes.";
    text[4351] = "Tras siglos de viajes espaciales, por fin hemos desarrollado un traje espacial que es";
    text[4352] = "compacto, flexible, duradero y elegante, si es que se me permite decirlo.";
    text[4353] = "¡Eh, tú!";
    text[4354] = "Parece que no te vendría mal tener una nueva habilidad de apoyo que te ayude en los combates.";
    text[4355] = "Te venderé mi habilidad de apoyo Cañón Superior por 5000 bytes.";
    text[4356] = "Voy a serte totalmente sincero.";
    text[4357] = "Necesito el dinero para pagar las clases de piloto de aerodeslizador de mi hijo.";
    text[4358] = "¡Le gustaría unirse a la Fuerza Lunex algún día!";
    text[4359] = "¿Quieres comprarme la habilidad de apoyo y echar una mano a un padre?";
    text[4360] = "¡Estupendo! Muchas gracias.";
    text[4361] = "Tengo que ayudar a mi hijo a cumplir sus sueños como pueda.";
    text[4363] = "¿Has visto el receptáculo tipo tanque?";
    text[4364] = "Es más lento que el tipo guerrero, pero también es más macizo.";
    text[4365] = "El receptáculo tipo tanque es perfecto para librar combates defensivos.";
    text[4366] = "-DESARROLLO DE ARMAS-";
    text[4367] = "-PRODUCCIÓN DE TRAJES IMPULSORES-";
    text[4368] = "-ARCHIVOS HISTÓRICOS-";
    text[4369] = "-HABITACIÓN DE SERVIDORES-";
    text[4370] = "-LABORATORIO DE HOLOTECNOLOGÍA-";
    text[4371] = "¡Todavía no hemos echado un vistazo a todas las habitaciones de esta planta!";
    text[4519] = "¡Ahora mismo no podemos volver a la Base Militar!";
    text[7232] = "Vaya... Nunca había visto un modelo de traje impulsor como este.";
    text[7233] = "¿Crees que pertenece a Saros?";
    text[7234] = "No parece algo que pueda llevar. Parece muy resistente.";
    text[7244] = "¡Mi escáner de materiales indica que está hecho de titanio!";
    text[7235] = "Creo que es un traje de batalla diseñado probablemente para la guerra.";
    text[7236] = "La guerra...";
    text[7237] = "Bueno, nunca se sabe lo que podría haber ahí fuera, en el universo...";
    text[7238] = "Digo que cojamos el traje.";
    text[7239] = "¡¿Cómo?! ¡¿Por qué?!";
    text[7240] = "¡Porque mola!";
    text[7241] = "Sí, creo que te quedaría genial.";
    text[7242] = "Mmmm...";
    text[7243] = "Muy bien, vale. Je.";
    text[7213] = "¡Anda! ¡Puedo desactivar el S.D.A.B. desde este ordenador!";
    text[7214] = "¡Genial! ¡Ahora podemos usar nuestra nave libremente para volar por Luna!";
    text[7247] = "¿Este receptáculo estaba aquí cuando Thea era la general?";
    text[7248] = "No... En realidad, todo este corredor es nuevo.";
    text[7249] = "Esta es la primera vez que pongo los pies en el cuarto del general";
    text[7250] = "desde que mi madre falleció.";
    text[7251] = "¿Las paredes siempre fueron moradas?";
    text[7252] = "¡Sí! El color de las paredes no ha cambiado.";
    text[7253] = "El morado era el color favorito de mamá.";
    text[7254] = "¿Así que los receptáculos que usamos hoy en día están basados en los de los Antiguos?";
    text[7255] = "Básicamente.";
    text[7256] = "Hace un año encontré un receptáculo abandonado.";
    text[7257] = "Fui capaz de utilizarlo sin un antinúcleo.";
    text[7258] = "Normalmente mantengo las distancias con cualquier cosa vinculada a la Fuerza Lunex pero...";
    text[7259] = "Quería comprobar algo.";
    text[7260] = "¿Qué estabas buscando?";
    text[7261] = "Bueno, hay algunos textos que indican que los receptáculos poseen";
    text[7262] = "una función oculta que les permite funcionar con una tercera fuente de combustible...";
    text[7263] = "... la lux.";
    text[7264] = "Aunque accionar una máquina...";
    text[7265] = "... que poco a poco va drenando tu lux es muy peligroso...";
    text[7266] = "... No quiero ni pensar en ello.";
    text[7267] = "Por lo que sé...";
    text[7268] = "Los receptáculos modernos que usamos no tienen esa funcionalidad.";
    text[7269] = "Nunca se sabe cuántos secretos nos ha ocultado Saros.";
    text[7270] = "Cierto... Gracias por decírnoslo. ";
    text[7271] = "Si alguna vez nos encontramos en una situación de emergencia... Quién sabe...";
    text[7272] = "Es posible que tengamos que usar esa función algún día.";
    text[7273] = "Es un receptáculo guerrero modelo ZX.";
    text[7274] = "Esta consola mide cuánta antimateria le queda al receptáculo.";
    text[7275] = "Hay una nota en la pantalla en la que pone: 917624.";
    text[7276] = "Esta consola está recargando la batería del receptáculo.";
    text[7281] = "En esta consola aparecen valores de varios datos,";
    text[7282] = "como los niveles de gravedad y de oxígeno en cada sector de Luna.";
    text[7283] = "En esta consola aparece una lista de órdenes judiciales y de los criminales";
    text[7284] = "que la Fuerza Lunex está buscando en estos momentos.";
    text[7285] = "¿Estoy en esa lista?";
    text[7286] = "Eh... No, no estás en ella.";
    text[7287] = "Qué raro... ¿Qué hay de mí?";
    text[7288] = "Encabezas la lista.";
    text[7289] = "Es todo un honor.";
    text[7202] = "¿Quieres regresar ya?";
    text[7203] = "Quiero asegurarme de que estamos totalmente preparados para luchar con Saros.";
    text[7204] = "¿Y si necesitamos más energ-Os o mentitas de combate?";
    text[7211] = "Celestia no puede crear un agujero de gusano para traernos de vuelta";
    text[7212] = "si no estoy ahí para accionarla.";
    text[7205] = "Estamos en el medio de un yermo, ¿recuerdas?";
    text[7206] = "No hay mercaderes cerca de aquí...";
    text[7207] = "... Y el Sistema Defensivo de la Astrobarrera evita que podamos ir volando a otro lugar.";
    text[7208] = "¡Esperad un momento!";
    text[7209] = "¡Es muy probable que los controles maestros del S.D.A.B. estén aquí!";
    text[7210] = "¡Echemos un vistazo! ¡Tal vez podamos desactivarlo!";
    text[7278] = "Hay una lista de personas desaparecidas en esta consola.";
    text[7279] = "Los nombres se han redactado y reemplazado con números de especímenes de prueba.";
    text[7329] = "DENOMINACIÓN: Moleculoid. Tasa de resonancia: 25%.";
    text[7330] = "Especímenes 270 a 276, análisis de poder de antimateria: vuelo y velocidad.";
    text[7331] = "Nota: El espécimen parece tener una estructura atómica inestable, ";
    text[7332] = "lo que explica su naturaleza «explosiva».";
    text[7336] = "DENOMINACIÓN: Grimrock. Tasa de resonancia: 16%.";
    text[7333] = "Especímenes 136 a 138, análisis de poder de antimateria: manipulación de minerales";
    text[7334] = "Nota: El caparazón del espécimen está hecho de antimateria fortificada y regolito.";
    text[7335] = "Esta variante de la fórmula podría resultar útil para crear un cuerpo de antimateria duradero.";
    text[7337] = "DENOMINACIÓN: Replia. Tasa de resonancia: 76%.";
    text[7338] = "Especímenes 1462 a 1465, análisis de poder de antimateria: cuerpo semifásico.";
    text[7339] = "Nota: El espécimen parece más humanoide si se compara con especímenes anteriores.";
    text[7340] = "Por fin estamos realizando avances importantes para la obtención de un suero perfeccionado.";
    text[7341] = "UNIDAD DE ESPECTROSCOPIA DE ANTIMATERIA";
    text[7342] = "UNIDA DE ALMACENAJE DE SUERO DE LÓBREGO";
    text[7343] = "DENOMINACIÓN: Avirell. Tasa de resonancia: 43%.";
    text[7344] = "Especímenes 621 a 629, análisis de poder de antimateria: descarga caótica.";
    text[7345] = "Nota: Las plumas del espécimen tienen una extraña propiedad que les permiten";
    text[7346] = "disipar la lux del objetivo.";
    text[7347] = "Parece que existe una conexión indisoluble entre la lux y la antimateria.";
    text[7348] = "Es un tubo de prueba vacío.";
    text[7349] = "DENOMINACIÓN: Hyperbee. Tasa de resonancia: 11%.";
    text[7350] = "Especímenes 42 a 44, análisis de poder de antimateria: vuelo y velocidad.";
    text[7351] = "Nota: Variante de fórmula para una conversión garantizada confirmada.";
    text[7352] = "El siguiente paso es ajustar las otras variantes de la fórmula.";
    text[7353] = "DENOMINACIÓN: Specter. Tasa de resonancia 38%.";
    text[7354] = "Especímenes 418 a 420, análisis de poder de antimateria: Inmunidad a plasma.";
    text[7355] = "Nota: El espécimen parece poseer una mayor inmunidad a nuestro armamento de plasma.";
    text[7356] = "Todos parecen tener una naturaleza malvada.";
    text[7365] = "En esta consola... Hay un mapa de Luna en el que hay distintos alfileres de colores.";
    text[7366] = "Cada alfiler indica la ubicación de un ataque de los lóbregos o de un incidente con ellos.";
    text[7367] = "Los datos se remontan hasta hace casi 10 años...";
    text[7357] = "Todo lo que nos dijeron sobre los lóbregos...";
    text[7358] = "... solo era una fracción de lo que Saros sabía realmente.";
    text[7359] = "No ha manipulado...";
    text[7360] = "Solo sabíamos lo justo para poder defendernos...";
    text[7361] = "... y para poder obtener los antinúcleos...";
    text[7362] = "... Eso era todo.";
    text[7368] = "Nota 36: Se han observado propiedades curativas en las muestras del suero que ";
    text[7369] = "tienen una tasa de resonancia del 50% o superior.";
    text[7370] = "Las muestras que he probado en mí mismos parecen funcionar...";
    text[7371] = "... pero todavía no bastan. Todavía no.";
    text[7372] = "Nota 42: Con las reservas de antinúcleos que tenemos y un suero perfeccionado,";
    text[7373] = "podremos salvar al menos a 100 000 individuos.";
    text[7374] = "Si conseguimos obtener los antinúcleos del Matalóbregos,";
    text[7375] = "ese número aumentará significativamente.";
    text[7376] = "Nota 74: Sencillamente, no basta con conseguir un cuerpo nuevo.";
    text[7377] = "Necesitarán algo más.";
    text[7378] = "Necesitarán un santuario...";
    text[7379] = "... Un lugar al que llamar hogar.";
    text[7380] = "Nota 111: Estoy tan cerca...";
    text[7381] = "He conseguido alcanzar una resonancia del 99%.";
    text[7382] = "Ojará tuviera más tiempo...";
    text[7383] = "El experimento me ha otorgado el poder inconmensurable que necesito...";
    text[7384] = "... a costa de mi propio cuerpo.";
    text[7385] = "A pesar de esto, considero este experimento un éxito.";
    text[7386] = "Ahora que tengo los antinúcleos del Matalóbregos...";
    text[7387] = "... mi misión para salvar a la humanidad puede empezar realmente.";
    text[3523] = "Parece que han cerrado este pasadizo...";
    text[3524] = "Es una lápida hecha de magnesio.";
    text[3525] = "En ella hay escritos varios nombres.";
    text[3526] = "La fecha de deceso es la misma en todos los nombres.";
    text[3527] = "PASADIZO AL SECTOR 3 CERRADO HASTA NUEVA ORDEN";
    text[3546] = "SECTOR 2: DESFILADERO DE LOS CAÍDOS";
    text[4784] = "SECTOR 2: FOSAS DE SILICA";
    text[4785] = "AL DESFILADERO DE LOS CAÍDOS";
    text[4786] = "AL DESFILADERO DE LOS CAÍDOS";
    text[4787] = "El fuego crepita suavemente.";
    text[4788] = "Ya no queda carga en la batería de la nave cápsula.";
    text[4789] = "Sabéis, cuando encontré esta cueva, estos montones de madera ya estaban aquí.";
    text[4790] = "Alguien debe haber estado aquí antes que nosotros.";
    text[4791] = "Odios fastidiaros el misterio, pero...";
    text[4792] = "Esta es una de las zonas en las que acampé hace años.";
    text[4793] = "Siempre voy a pie allá donde voy. Me ayuda a pasar desapercibido.";
    text[4794] = "Cuento estás huyendo durante tantos años,";
    text[4795] = "acabas teniendo varios escondites y lugares en los que acampar.";
    text[4796] = "Hay un extraño mecanismo de bloqueo alrededor de este enlace neural.";
    text[4797] = "Hay algo escrito en la pantalla digital:";
    text[4798] = "«6 CRÁTERES».";
    text[4799] = "¡Has encontrado un pequeño interruptor en el cráter! Accionas el interruptor.";
    text[4800] = "Has accionado el último interruptor.";
    text[4822] = "Es un cristal hecho de cuarzo de sangre.";
    text[4823] = "Estos cristales, luminiscentes en su estado natural, ayuda a los mineros";
    text[4824] = "a recorrer las oscuras profundidades de las Minas de Silica.";
    text[4825] = "OESTE: DESFILADERO DE LOS CAÍDOS";
    text[4826] = "ESTE: COLONIA SILICA";
    text[4827] = "SECTOR 1: COLONIA SILICA";
    text[4828] = "Estas cajas están llenas de suministros y herramientas para la extracción de minerales.";
    text[4829] = "Minas de Silica";
    text[4830] = "Echas un vistazo a la entrada de la mina y ves parpadear algunas luces.";
    text[4831] = "¡Vaya, ese cristal es ENORME!";
    text[4832] = "Los nativos del lugar lo llaman Cristal Eternidad.";
    text[4833] = "Ha estado aquí desde la fundación de la colonia.";
    text[4834] = "Al parecer, es una de las Siete Maravillas de Luna.";
    text[4835] = "La máquina expendedora ya no funciona.";
    text[4836] = "Esta máquina expendedora vende minimáquinas expendedoras.";
    text[4837] = "Esta máquina expendedora vende cecina.";
    text[4838] = "¡El Café Silica os da la bienvenida!";
    text[4839] = "¡Probad nuestros famosos perritos picantes con queso y nuestro curri picante!";
    text[4840] = "¡Es el panel de anuncios de Silica!";
    text[4841] = "No tenemos una nave espacial, así que ahora mismo no podemos volar...";
    text[3653] = "Parece que hay algo aquí...";
    text[3654] = "... pero ahora mismo no puedes interactuar con esto.";
    text[3655] = "El antinúcleo que tienes parece estar reaccionando al extraño fenómeno.";
    text[4873] = "Metes la mano en el cúmulo de antimateria...";
    text[4901] = "Las minas de Silica se han estado explotando desde hace siglos.";
    text[4902] = "Cada mina cerrada se había estado explotando durante unos 200 años.";
    text[4903] = "Vaya, ¿se tarda TANTO en llegar a la máxima profundidad que podemos alcanzar?";
    text[4904] = "Bueno, sí. La tecnología ha avanzado mucho, pero por mucho que avance";
    text[4905] = "nuestra maquinaria, cuesta muchísimo extraer esos malditos cristales de cuarzo de sangre.";
    text[4906] = "Por eso son tan caros.";
    text[4907] = "El mineral más duro de Luna es también el más difícil de extraer y procesar.";
    text[4908] = "Antes vi un montón de drones de la Fuerza Lunex volando por la colonia.";
    text[4909] = "¿Sabes qué están buscando?";
    text[4910] = "Probablemente lóbregos... Eh, je, je, je.";
    text[4911] = "Mmm... No te he visto antes por aquí. ¿Es la primera vez que estás en Silica?";
    text[4912] = "¡Sí!";
    text[4913] = "Tenemos muchos mineros, mercaderes, refugiados y cazatesoros por aquí.";
    text[4914] = "Aquí todo el mundo hace lo que puede con tal de sobrevivir.";
    text[4915] = "Colonia Silica se asienta en un enorme depósito de cuarzo de sangre.";
    text[4916] = "La mayor parte de los recursos que extraemos acaban en manos de la Fuerza Lunex";
    text[4917] = "y van a los sectores más ricos de Luna central y meridional.";
    text[4918] = "Esas armas que tienes ahí parece muy caras. ¿Por cuánto las vendes?";
    text[4919] = "Mmm... No están a la venta. Lo siento.";
    text[4920] = "Tch, bueno, procura no quitarle el ojo a tus objetos de valor mientras estés por aquí.";
    text[4921] = "Nunca se sabe cuándo hay matones o bandidos vigilando.";
    text[4922] = "Un momento, ¿hay bandidos por aquí?";
    text[4923] = "Lárgate, chica. Si no estás vendiendo nada, no me interesa.";
    text[4924] = "¡Hola! Solo el profesor de historia local de Silica. ¿Sabías que...";
    text[4925] = "Silica fue una de las primeras colonias que se fundó en Luna?";
    text[4926] = "Los primeros colonos escogieron esta región porque, en realidad, estamos dentro de";
    text[4927] = "un enorme conducto de lava lunar.";
    text[4928] = "¡¿Has dicho lava?! ¿Hay lava en Luna?";
    text[4929] = "¡Por supuesto que sí! ¡Y si llegas a la profundidad necesaria también encontrarás magma!";
    text[4930] = "Por aquel entonces, ni siquiera se había inventado la Astrobarrera...";
    text[4931] = "... así que la temperatura en Luna cambiaba drásticamente al pasar del día a la noche.";
    text[4932] = "Afortunadamente, los colonos descubrieron los conductos de lava lunares en la zona septentrional de Luna,";
    text[4933] = "donde la temperatura era más cálida y consistente,";
    text[4934] = "lo que hacía que esta región fuera más apropiada para un asentamiento.";
    text[4935] = "No hay muchos niños que conozca la historia lunar, pero creo que es importante que ";
    text[4936] = "sepan cómo acabó la humanidad en Luna y cómo ha sobrevivido aquí durante tantos siglos.";
    text[4937] = "Papá me está obligando a estudiar la historia lunar...";
    text[4938] = "Nunca deja de hablar de hechos históricos. Puede seguir durante horas, y horas...";
    text[4939] = "En Silica vive una pequeña comunidad de cicloides.";
    text[4940] = "Mi marido y yo vivíamos inicialmente en Magnesia, nuestra colonia hermana.";
    text[4941] = "Después del incidente que tuvo lugar hace unos años, nos vimos obligados a mudarnos a Silica. ";
    text[4942] = "... Lamento escuchar eso.";
    text[4943] = "Aunque perdimos nuestro primer hogar en el incidente... conseguimos un nuevo hogar aquí.";
    text[4944] = "Sin embargo, algunos cicloides no tuvieron tanta suerte como nosotros...";
    text[4945] = "Es algo que me hace apreciar aún más cada segundo que paso con mi familia.";
    text[4946] = "Gracias por escucharme.";
    text[4947] = "Tengo mucho que agradecer a la Fuerza Lunex por todo lo que ha hecho por nosotros.";
    text[4948] = "¡No hay nada que agradecer! ¡Si nos necesitas, estaremos aquí para echarte una mano!";
    text[4949] = "¡La Fuerza Lunex lucha para proteger y servir a la gente de Luna en todo momento! ¡Je!";
    text[4950] = "...";
    text[4951] = "¡Estoy a punto de iniciar una expedición!";
    text[4952] = "Oooh, ¿adónde vas a ir?";
    text[4953] = "¡Probablemente iré a echar un vistazo a algunas zonas de botín!";
    text[4954] = "¿Qué tesoros encontraré? Vaya, ¡me emociono solo de pensarlo!";
    text[4955] = "Estoy echando un vistazo a los informes de energía renovable de Silica.";
    text[4956] = "¡Silica es única en el sentido de que la mayor parte de nuestra energía es de origen geotérmico!";
    text[4957] = "Tuvimos que reducir la recogida de minerales porque comenzaron a aparecer muchos más lóbregos.";
    text[4958] = "Parece que les gusta bastante el calor de las minas.";
    text[4959] = "Cuanto más profundizas, más lóbregos descubres.";
    text[3517] = "Las armas y el equipo militar robado están guardados junto a la pared.";
    text[3518] = "Parece que estos bandidos se comunican con varias flotas.";
    text[3519] = "Si conseguimos reducir su número lo suficiente";
    text[3520] = "atraeremos la atención de su líder.";
    text[3521] = "Hay una nota en la pantalla en la que pone: 258227.";
    text[5653] = "SECTOR 12: MTE. PITON";
    text[5654] = "PICO DE LA LUZ ETERNA";
    text[5655] = "Esta máquina expendedora vende calientamanos y otros accesorios de acampada.";
    text[5657] = "Mmm... Esta plataforma de impulso no recibe suficiente energía...";
    text[5658] = "¿Se puede arreglar de alguna manera?";
    text[5659] = "Debería haber un panel eléctrico por aquí, en algún lado...";
    text[5660] = "¡Podría sobrecargarla y calentar el circuito para arreglar la plataforma de impulso!";
    text[5661] = "Brrr... Démonos prisa.";
    text[5662] = "Snif... ¡Me estoy congelando!";
    text[5663] = "¡SUPERCARGA DE SUPERAYUDANTE!";
    text[5664] = "¡Ahora la plataforma de impulso deberían funcionar correctamente! Je, je.";
    text[5665] = "¡Oh, jo, jo, jo!";
    text[5666] = "¡Es estupendo ver a algunos camaradas aventureros en el Mte. Piton!";
    text[5667] = "¿Sueles venir por aquí?";
    text[5668] = "¡Vengo aquí cada día! ¡Oh, jo, jo, jo!";
    text[5669] = "Se tarda mucho en llegar aquí desde Silica, ¡pero merece la pena!";
    text[5670] = "¿Sabías que el Mte. Piton es la montaña más alta de Luna?";
    text[5671] = "A pesar de las bajas temperaturas, el sol brilla con más intensidad aquí.";
    text[5672] = "¡Por eso lo llaman «Pico de la Luz Eterna»! ¡Oh, jo, jo, jo!";
    text[7394] = "Dejémosla sola por ahora.";
    text[7395] = "¿Y si se despierta y trata de escapar?";
    text[7396] = "Yo no me preocuparía por eso. Ya no es una amenaza para nosotros.";
    text[7397] = "Echas un vistazo dentro de la cabaña, pero solo hay oscuridad.";
    text[7400] = "Tu última batalla te espera. Que tu lux brille para siempre.";
    text[900] = "¡Miau!";
    text[901] = "¡Oooh, es Echo! ¡Hola, bonita!";
    text[902] = "¡Gatita, gatita!";
    text[903] = "¡Miau, miau!";
    text[904] = "¡Echo te ha dado 10 000 bytes!";
    text[905] = "ENCUENTRO INUSUAL: Esta es Echo, la gata espacial.";
    text[906] = "Es la gata mascota de la Estación Espacial Lunex.";
    text[907] = "A Echo le ENCANTA vivir aventuras en el espacio.";
    text[908] = "¡También es un encuentro inusual que puedes hallar en ciertas zonas de Luna!";
    text[1806] = "Echo te contempla mientras mira fijamente al espacio con sus brillantes ojos.";
    text[751] = "La gente puede descargar todo tipo de conocimientos en tu cerebro, pero...";
    text[752] = "Lo más importante es cómo aplicas ese conocimiento. No lo olvides.";
    text[753] = "¡Eh! Te he visto antes en la Estación Espacial Lunex.";
    text[754] = "¡Debes ser la hija del Dr. Thomas! ¡Es un placer conocerte!";
    text[755] = "¡Mi especialidad son los enlaces neurales!";
    text[756] = "¿Qué son los enlaces neurales?";
    text[757] = "¿Tienes uno?";
    text[758] = "No me interesa.";
    text[759] = "¡Los enlaces neurales son el último grito en tecnología de estimulación mental!";
    text[760] = "Básicamente, te permiten descargar información a tu cerebro.";
    text[761] = "Los educadores de algunas escuelas distribuyen enlaces neurales,";
    text[762] = "¡y los guerreros pueden usarlos para aprender nuevas habilidades y técnicas!";
    text[763] = "¡Es una tecnología impresionante!";
    text[764] = "¡Pues sí! Son bastante caros, pero puede venderte este a un precio reducido.";
    text[765] = "¡Bastará con 1500 bytes!";
    text[766] = "¡Me lo quedaré!";
    text[767] = "No, gracias.";
    text[768] = "¡Estupendo!";
    text[769] = "¡No olvides gestionar y equipar las habilidades de apoyo en el menú de habilidades de apoyo!";
    text[770] = "Eh... ¡Espera un momento! ¡Te faltan bytes!";
    text[771] = "Muy bien, ¡nos vemos!";
    text[3547] = "Estoy tratando de vender un CHIP DE MEJORA DE ARMADURA.";
    text[3548] = "El CHIP DE MEJORA DE ARMADURA es un chip de mejora que puedes equipar en el MENÚ OBJETOS.";
    text[3549] = "¡Cuando lo equipes, añadirás 200 a tus PV MÁX.!";
    text[3550] = "Como es un objeto peculiar, pido un precio peculiar. ¿Qué te parecen 80 puntos de habilidad?";
    text[3551] = "No olvides equipar el CHIP DE MEJORA DE ARMADURA en el MENÚ OBJETOS.";
    text[3553] = "Eh, no estoy de broma, chica. Vuelve cuando tengas 80 PUNTOS DE HABILIDAD.";
    text[3554] = "Estoy tratando de vender un CHIP DE MEJORA DE PE.";
    text[3555] = "El CHIP DE MEJORA DE PE añade 100 a tus PE máx.";
    text[3556] = "Este es el único chip de mejora que puede aumentar tus PE MÁX.";
    text[3557] = "El CHIP DE MEJORA DE PE vale 160 puntos de habilidad. ¿Quieres comprarlo? ";
    text[3558] = "No olvides equipar el CHIP DE MEJORA DE PE en el MENÚ OBJETOS.";
    text[3560] = "¡Deja de hacerme perder el tiempo! ¡No tienes 160 PUNTOS DE HABILIDAD!";
    text[3252] = "Gracias por tu compra, chica.";
    text[3253] = "Hola, chica. Pareces una guerrera bastante fuerte a la que le vendría bien un CHIP DE MEJORA algo peculiar.";
    text[3254] = "Estoy tratando de vender un CHIP DE MEJORA DE BARRERA.";
    text[3255] = "¿Te interesa?";
    text[3256] = "¿Qué efecto tiene?";
    text[3257] = "¿Cuál es la pega?";
    text[3258] = "El CHIP DE MEJORA DE BARRERA es un chip de mejora que puedes equipar en el MENÚ OBJETOS.";
    text[3259] = "Si lo equipas, podrás empezar tus combates con una barrera de uso único.";
    text[3260] = "Si un ataque enemigo te alcanza, la barrera lo absorberá,";
    text[3261] = "y tu RANGO DE COMBATE no se verá afectado.";
    text[3262] = "Cuando la barrera desaparezca, no se regenerará hasta el siguiente combate.";
    text[3263] = "Verás, no me interesan los bytes o los astrotecnos. Quiero PUNTOS DE HABILIDAD.";
    text[3264] = "Como es un objeto peculiar, pido un precio peculiar. ¿Qué te parecen 40 puntos de habilidad?";
    text[3265] = "Has hecho un buen trato, chica.";
    text[3266] = "No olvides equipar el CHIP DE MEJORA DE BARRERA en el MENÚ OBJETOS.";
    text[3267] = "Nos vemos, chica.";
    text[3269] = "Eh, no estoy de broma, chica. Vuelve cuando tengas 40 PUNTOS DE HABILIDAD.";
    text[629] = "¡Hola, colega! Soy un vendedor de astrotecnos. Puedes llamarme Cypher.";
    text[630] = "Si tienes algunos astrotecnos, podríamos hacer algún intercambio, ¿qué te parece?";
    text[631] = "Comerciar";
    text[632] = "Hablar";
    text[633] = "Salir";
    text[634] = "Verás, vengo del norte. Tengo una tienda en Colonia Silica.";
    text[635] = "Suelo bajar por aquí en busca de astrotecnos.";
    text[636] = "¡Silica es el distrito minero de Luna!";
    text[637] = "Allí hay muchos cazatesoros.";
    text[638] = "¡Así es, colega!";
    text[639] = "Los minerales y materiales más peculiares están allí.";
    text[640] = "En cambio, Regolithia rebosa de productos tecnológicos, colega.";
    text[641] = "¡Ya te digo, colega!";
    text[642] = "¿Y qué haces con los astrotecnos?";
    text[643] = "Puedo usar los astrotecnos para hacer cosas bastante interesantes.";
    text[644] = "¡La maquinaria y los cachivaches son mi punto fuerte!";
    text[645] = "Si tienes la oportunidad, pásate por mi tienda en Silica.";
    text[646] = "¡Tengo un montón de partes de nave molonas que podrías comprar!";
    text[647] = "¡Gracias por tu compra, colega!";
    text[648] = "¡Necesitas más astrotecnos!";
    text[649] = "Lo siento, colega, eso está agotado.";
    text[650] = "¡Estupendo! Estas son mis existencias.";
    text[651] = "SIN EXISTENCIAS";
    text[4842] = "¡Eh, colega! ¿Qué tal? ¡Si estás buscando partes de nave molonas,";
    text[4843] = "has venido al lugar adecuado! ¿Cómo puedo ayudarte, colega?";
    text[4844] = "Eh, ¿dónde está tu perrito?";
    text[4845] = "Ahora mismo está durmiendo, colega. ¡Mover tanto la cola acaba cansándole!";
    text[652] = "Saludos. Me llamo Nym, y soy un mercader ambulante.";
    text[653] = "Tengo algunas cosas que vender, si es que quieres comprar algo.";
    text[654] = "¿Qué va a ser?";
    text[655] = "Si estás buscando al mercader de astrotecnos,";
    text[656] = "creo que lo he visto por esta zona.";
    text[657] = "Gracias. Cuídate.";
    text[658] = "Comprar";
    text[3806] = "Saludos. Es estupendo verte.";
    text[3807] = "Me enamoré al instante de este lugar cuando vine a este rancho.";
    text[3808] = "Tal vez ponga una tienda fija aquí.";
    text[3809] = "Tengo algunas cosas nuevas que vender, si es quieres comprar algo.";
    text[1919] = "¡Hola! Me llamo Alex. Soy la mercader de la EEL.";
    text[3213] = "¡Hola! ¡Te doy la bienvenida al puesto comercial!";
    text[1920] = "¡Ahora mismo estamos de rebajas!";
    text[1921] = "¡Estupendo! ¿Qué va a ser?";
    text[1922] = "¡Muy bien, cuídate! ¡Vuelve cuando quieras!";
    text[1923] = "¡Las demás dependientas de este lugar son en realidad mis hermanas!";
    text[1924] = "Solíamos realizar misiones de espionaje juntas, ¡pero ahora tenemos otros objetivos!";
    text[1929] = "¡Hola, soy Britney! ¡Gracias por venir a vernos!";
    text[1930] = "¡Tengo artículos muy útiles que puedes comparar con astrotecnos!";
    text[1931] = "¡También tenemos partes de nave a la venta!";
    text[1932] = "Las partes son un poco caras, ¡pero merecen mucho la pena!";
    text[1933] = "¡Puedes personalizar tu nave si interactúas con el transportador del mapa del mundo!";
    text[1934] = "Estas son nuestras existencias.";
    text[3208] = "¡Hemos repuesto nuestras partes de nave!";
    text[3209] = "¡Hay diferentes productos entre los que elegir en cada uno de mis escaparates!";
    text[3214] = "¡NUEVO TRAJE IMPULSOR DISPONIBLE!";
    text[3215] = "¡Habla con Clover en Estilo Lunex, en Copernicus!";
    text[3216] = "¡PARA CAMBIAR TU TRAJE IMPULSOR, PULSA [C] EN EL MENÚ DE PAUSA!";
    text[3217] = "¡PARA CAMBIAR TU TRAJE IMPULSOR, PULSA [Cuadrado] EN EL MENÚ DE PAUSA!";
    text[3218] = "¡PARA CAMBIAR TU TRAJE IMPULSOR, PULSA [Y] EN EL MENÚ DE PAUSA!";
    text[1938] = "¡Hola, Bella! ¡Gracias por colaborar en mi programa de márketing de trajes impulsores!";
    text[3219] = "Ten, ¡aquí tienes un nuevo traje impulsor para que vueles por ahí!";
    text[3221] = "¡Mi misión es crear los mejores estilos de trajes impulsores de Luna!";
    text[1940] = "¡Hooola, soy Sam! ¡Es un placer conocerte! ¡Vendo enlaces neurales!";
    text[1941] = "¡Puedes comprar nuevas habilidades de apoyo, habilidades activas y refuerzos de habilidad!";
    text[1942] = "¡Mis hermanas y yo hemos abierto tiendas por toda Luna!";
    text[1943] = "Casi cada tienda ofrece algo único. ¡Ven y echa un vistazo a nuestras existencias!";
    text[1944] = "¡Yupi! ¿Qué quieres llevarte?";
    text[659] = "Buf, me muero de hambre...";
    text[660] = "Pero no puedo dejar mi puesto. ¡Tengo un trabajo que hacer!";
    text[661] = "Si sigo así, moriré de hambre antes de morir por quedarme sin oxígeno...";
    text[662] = "Srta. Bella, tengo un favor que pedirle...";
    text[663] = "¿Le importaría conseguirme una barrita Cruj-E?";
    text[664] = "Las venden en las máquinas expendedoras del café...";
    text[665] = "Por favor... ¡Le pagaré el doble de lo que cueste! Me muero de hambre...";
    text[666] = "... ¡Un momento! ¿Me está diciendo que estas eran las dos últimas barritas Cruj-E?";
    text[667] = "He estado... a dos barritas Cruj-E de morir de hambre.";
    text[668] = "¡Muchas gracias, Srta. Bella! ¡Solo necesito una, así que puede quedarse con la otra!";
    text[669] = "He olvidado cuánto costaban estas cosas, pero como le prometí, le pagaré el doble.";
    text[670] = "¿Cuánto ha costado la barrita Cruj-E?";
    text[671] = "200 bytes (di la verdad)";
    text[672] = "1000 bytes (¿quieres estafarle?)";
    text[673] = "25 astrotecnos (cambia la recompensa)";
    text[674] = "¡¿Solo 200?! ¡Vaya ganga!";
    text[675] = "Sabe... ¡Aquí tiene 1000 bytes! ¡Gracias de nuevo, Srta. Bella!";
    text[676] = "¡¿1000?! Mmm...";
    text[677] = "Supongo que tiene sentido. Debido a la alta demanda, las personas pagan precios premium.";
    text[678] = "Vaya, menudo trabalenguas.";
    text[679] = "Me pregunto qué se siente... cuando te trabas con tu lengua.";
    text[680] = "Lamento interrumpirle..., pero solo tengo 400 bytes. ¿Bastará con eso?";
    text[681] = "Está bien. ¡No te preocupes! Eh, je, je, je.";
    text[682] = "Muy bien, ¡aquí tiene Srta. Bella! ¡Gracias de nuevo!";
    text[683] = "¡Has recibido 400 bytes!";
    text[684] = "¿Oh? ¿Prefiere 25 astrotecnos? ¡Claro, no hay problema!";
    text[685] = "¡Has recibido 25 astrotecnos!";
    text[686] = "Mmm... Esto es el paraíso. ¡Esta barrita Cruj-E está deliciosa!";
    text[687] = "¡Has recibido 1000 bytes!";
    text[688] = "Esta máquina expendedora vende barritas Cruj-E, un nutritivo y crujiente tentempié de granola";
    text[689] = "cubierto con una deliciosa capa de chocolate negro.";
    text[690] = "¡Combina a la perfección con una taza caliente de café!";
    text[691] = "Solo quedan dos en la máquina.";
    text[692] = "¿Te gustaría comprar una barrita Cruj-E? Cuesta 200 bytes.";
    text[693] = "¿Y esto? ¡Han caído dos barritas Cruj-E a la vez! ¡Hoy es tu día de suerte!";
    text[694] = "Desgraciadamente, no quedan más barritas Cruj-E.";
    text[695] = "¡Necesitas más bytes!";
    text[718] = "Tjskdlf klskdjfl uhwpefj pylkjq.";
    text[719] = "¡Hola! Mmmm...";
    text[720] = "(¡¿Por qué no funciona mi traductor universal?!)";
    text[721] = "Bella, el chip de tu T.U. sufrió daños durante tu batalla con los lóbregos.";
    text[722] = "Tuowieh jlwknbl ieuohfo qpoufwef.";
    text[723] = "Mmm... Lo siento mucho, no hablo el idioma de los cicloides.";
    text[724] = "Tetra, tu traductor universal funciona, ¿verdad?";
    text[725] = "¡Sí!";
    text[726] = "Rgjktg kjspfoy khklfsn rf ja,ja, ja";
    text[727] = "Huyhsajy ara ara lk ja,ja,ja";
    text[728] = "¿Qué ha dicho? ¿De qué os reís las dos?";
    text[729] = "Je, je. De nada. Es muy divertida.";
    text[730] = "Oh, bueno... Podemos charlar más tarde. ¡Antes tengo que reparar el chip de mi T.U.!";
    text[731] = "¡Cuídate!";
    text[732] = "¡Hola! Veo que ahora puedes entenderme, ja, ja, ja.";
    text[733] = "¡Hola! Lamento mucho lo de antes, mi traductor no funcionaba.";
    text[734] = "¿Necesitas que te echen un cable con algo?";
    text[735] = "¡Oh no, nada de eso! ¡Solo te estaba saludando!";
    text[736] = "¡Tu pequeña ayudante es realmente adorable!";
    text[737] = "Le dije que tu pelo es muy bonito y que me recuerda al algodón de azúcar.";
    text[738] = "¡Ooh, gracias!";
    text[739] = "Como dije, ¡tu coleta me recuerda a un helado recién servido! Ja, ja, ja.";
    text[740] = "Me lo tomaré como un cumplido, je, je.";
    text[741] = "Te has desviado de tu objetivo para poder hablar conmigo...";
    text[742] = "¡No te preocupes! Es importante comunicarse con los demás.";
    text[743] = "¡Ayuda a conectarnos entre nosotros y a crear vínculos irrompibles!";
    text[744] = "Eres tan amable... Toma, esto es por las molestias.";
    text[746] = "¿Cómo se dice «Gracias» en cicloide?";
    text[747] = "¡Qwerty!";
    text[748] = "¡Qwerty, qwerty!";
    text[749] = "¡Oh, pero qué tonta! ¡Si compré un nuevo chip de T.U. antes!";
    text[750] = "Veamos... Solo hay que reemplazar el antiguo por el nuevo... ¡ya está!";
    text[1962] = "Oh, cielos... Por qué tenía que pasar esto...";
    text[1963] = "Eh, Ouro, ¿qué ocurre?";
    text[1964] = "Oh, ¡hola, Bella! Estaba haciendo mi paseo diario por la Estación Espacial, ";
    text[1965] = "luego me tomé un delicioso café en el Café Lunex, y... bueno...";
    text[1966] = "Llevaba una carpeta abierta con mis adoradas RECETAS DE COMBOS LUX...";
    text[1967] = "¡Y LAS HE PERDIDO TODAS!... ¡ESTO ES TERRIBLE! NO LAS HABÍA MEMORIZADO.";
    text[1968] = "Eh, no te preocupes, Ouro, ¡te ayudaremos a encontrar tus RECETAS DE COMBOS LUX!";
    text[1969] = "¡¿En serio?! Oh, cielos... ¡Muchas gracias por tu ayuda, Bella!";
    text[1970] = "¿Cuántas recetas tenemos que encontrar?";
    text[1971] = "Necesito que encontréis 7 RECETAS DE COMBO LUX en la Estación Espacial.";
    text[1972] = "¿Por dónde has estado hoy?";
    text[1973] = "He estado caminado por todas partes, literalmente... Podrían haberse caído en cualquier sitio...";
    text[1974] = "Vale, no pasa nada. Al menos sabemos que están en la Estación Espacial.";
    text[1975] = "Tu café va a enfriarse. Quédate aquí por ahora.";
    text[1976] = "¡Gracias, Bella!";
    text[1977] = "He dejado mi CÓDEX en casa, así que no he podido guardar ninguna receta...";
    text[1978] = "He perdido un total de 7 RECETAS DE COMBO LUX en la Estación Espacial.";
    text[1979] = "¡Mi especialidad es recopilar e investigar RECETAS DE COMBOS LUX!";
    text[1980] = "¡Me encarta compartir mis conocimientos con la esperanza";
    text[1981] = "de otros puedan probar nuevos COMBOS LUX y se hagan más fuertes!";
    text[826] = "¡Eres una gran guerrera, Bella! ¡Deberías probar los COMBOS LUX!";
    text[827] = "¡Cuando llenes tu barra de lux en un combate,";
    text[828] = "podrás combinar 3 habilidades para lanzar un COMBO LUX!";
    text[1982] = "¡Tu barra de lux se llena cada vez que golpeas a un enemigo o cuando te cubres de un ataque!";
    text[829] = "LOS COMBOS LUX son una alternativa más poderosa a usar tres habilidades separadas.";
    text[830] = "Combinar tres habilidades iguales suele dar lugar a un COMBO LUX único.";
    text[831] = "¡Deberías probar distintas combinaciones!";
    text[832] = "¡Aquí tienes algunas recetas que puedes probar!";
    text[1984] = "¡Has encontrado mis recetas de combos lux! ¡Muuuchas gracias!";
    text[1985] = "¡Me has alegrado el día, Bella!";
    text[1986] = "¡Para darte las gracias, me gustaría darte una de mis recetas personales favoritas!";
    text[1988] = "¡Gracias por echarme una mano!";
    text[3309] = "¡Hola, Bella!";
    text[3310] = "¿Has estado practicando tus combos lux?";
    text[3311] = "¡Vaya! ¡Has realizado al menos 20 combos lux!";
    text[3312] = "¡Es impresionante! ¡Aquí tienes una nueva receta de combo lux!";
    text[3313] = "¡El POD de Holodrenaje aumenta cuantos más escudos tengas!";
    text[3314] = "¡Tu NV. también influye en el daño que infliges!";
    text[3315] = "Si realizas al menos 20 combos lux,";
    text[3316] = "¡te daré una nueva receta en la que he estado trabajando!";
    text[3317] = "Si vas al MENÚ REGISTROS de tu CÓDEX,";
    text[3318] = "¡verás cuántos combos lux has realizado!";
    text[3431] = "Jeje. ¡He derrotado a tantos lóbregos hoy que he superado mi récord de rangos S!";
    text[3432] = "¿En serio? ¿Cuál es tu récord?";
    text[3433] = "He conseguido 9 rangos S hasta ahora.";
    text[3434] = "¡Impresionante!";
    text[3435] = "Mmm... Puedo ver el fuego de la competitividad en tus ojos, Bella.";
    text[3436] = "Dudo que puedas superar mi récord, pero digamos que, si consigues al menos 10 rangos S...";
    text[3437] = "Te entregaré un REFUERZO DE HABILIDAD como recompensa.";
    text[3438] = "Acepto el desafío, je.";
    text[3439] = "Vas a tener que demostrarme que has conseguido al menos 10 rangos S.";
    text[3440] = "¡Puedes ver cuántos tienes en el MENÚ REGISTROS de tu CÓDEX!";
    text[3441] = "¡Rayos! Has batido mi récord...";
    text[3443] = "Eres tan competitiva como Raine...";
    text[3444] = "¡Creo que la competición puede hacer que seamos mejores!";
    text[3445] = "También suelo entrenar con Raine.";
    text[3446] = "Siempre está dando gritos y diciendo lo mucho que quiere machacarte en combate.";
    text[3447] = "¡Un día voy a convertirme en una guerrera prodigio, al igual que vosotras dos!";
    text[3448] = "Je, je, je...";
    text[3442] = "Espera y verás. ¡Un día batiré tu récord de rangos S!";
    text[3451] = "¡Aquí tienes el REFUERZO DE HABILIDAD que te prometí!";
    text[3232] = "¡Parece que alguien se ha desprendido de una barrita de tarta de queso en perfecto estado!";
    text[3233] = "¡¿CÓMO ES POSIBLE QUE ALGUIEN HAGA ALGO TAN HORRIBLE?!";
    text[3234] = "No te preocupes, ¡me encargaré de que esa barrita reciba";
    text[3235] = "la atención y el amor que merece! Je.";
    text[3236] = "¿¡Cómo!?";
    text[3237] = "¡Otra barrita de tarta de queso dejada a su suerte!";
    text[3238] = "Quien haya comprado todas las barritas de queso de la máquina expendedora";
    text[3239] = "debe haber perdido una.";
    text[3240] = "Mmmm...";
    text[3241] = "Veamos en los demás cafés.";
    text[3242] = "¡¿Hay alguien haciendo esto a propósito?!";
    text[3243] = "Tal vez el culpable esté tratando de atraerte con barritas de tarta de queso.";
    text[3244] = "Bueno...";
    text[3245] = "¡Está funcionando!";
    text[3246] = "¡Necesito MÁS! ¡MÁS! ¡MÁS!";
    text[3247] = "Eh, ¡hay una nota en esta barrita de tarta de queso!";
    text[3248] = "Solo pone «Tycho».";
    text[3249] = "¡Echemos un vistazo en el Café Tycho cuando podamos!";
    text[3250] = "¡Vale! ¡La detective de tartitas de queso Tetra está lista para resolver este caso!";
    text[3726] = "Rayos... Tengo tanta sed...";
    text[3727] = "Oiga, señorita, ¿podría pedirle un favor?";
    text[3728] = "Mi garganta parece papel de lija en este momento, y no puedo abandonar mi puesto...";
    text[3729] = "¿Podría traerme un energ-O maestro?";
    text[3730] = "¡Cuanto mejor sea el Energ-O, más refrescante me parece!";
    text[3731] = "Si no tiene un energ-O maestro, un superenerg-O o hiperenerg-O también me valdrían.";
    text[3732] = "Por favor... Tengo tanta sed... y todavía quedan 6 horas para el fin de mi turno.";
    text[3733] = "Aaah... ¡Fresco, frío, gaseoso, refrescante e hidratante!";
    text[3734] = "¡Este energ-O es lo que necesitaba!";
    text[3735] = "¿Qué energ-O te gustaría darme?";
    text[3736] = "Superenerg-O";
    text[3737] = "Hiperenergo-O";
    text[3738] = "Energ-O maestro";
    text[3739] = "Eh, parece que no te quedan energ-Os de ese tipo.";
    text[3740] = "Vuelve cuando tengas el energ-O que quieras darme.";
    text[3741] = "¡Vaya! ¡Muchas gracias!";
    text[3742] = "Eh, me gustaría ofrecerte una recompensa por las molestias.";
    text[3743] = "Escoge la recompensa que quieras.";
    text[3744] = "1000 bytes y 50 astrotecnos";
    text[3745] = "50 puntos de habilidad";
    text[3746] = "2500 bytes y 100 astrotecnos";
    text[3747] = "100 puntos de habilidad";
    text[3748] = "5000 bytes y 150 astrotecnos";
    text[3749] = "150 puntos de habilidad y 1 socorrealmas";
    text[3750] = "¡Has recibido la recompensa escogida!";
    text[3751] = "¡Vaya! ¡Puedo ver Regolithia a lo lejos!";
    text[3688] = "¡Hola, soldado! ¡Soy uno de los entrenadores de combate de la Fuerza Lunex.";
    text[3689] = "¡Nos encanta ofrecer incentivos a nuestros soldados para que entrenen más y se vuelvan más fuertes!";
    text[3690] = "Si puedes demostrarme que has conseguido al menos 20 rangos S,";
    text[3691] = "¡te daré el enlace neural Granada Acuática!";
    text[3692] = "¡Puedes ver cuántos tienes en el MENÚ REGISTROS de tu CÓDEX!";
    text[3694] = "¡Vaya, parece que tienes al menos 20 rangos S!";
    text[3695] = "¡Sigue así, soldado! Aquí está el enlace neural que te prometí.";
    text[3696] = "Nuestro entrenador de combate de mayor rango se ha enterado de tus logros.";
    text[3697] = "¡Le gustaría poder conocerte algún día!";
    text[3698] = "¿Cuál debería ser mi siguiente récord de rangos S?";
    text[3699] = "Probablemente el entrenador esperará que consigas al menos 50 rangos S.";
    text[3700] = "¡No desfallezcas! ¡Aprovecha el impulso que has conseguido y serás la mejora guerrera de toda Luna!";
    text[3770] = "¡Saludos!";
    text[3771] = "¡Soy Mr. Infame, el Señor de las Preguntas Supremo!";
    text[3772] = "¡Viajo por toda Luna para encontrar a alguien que sepa más que yo!";
    text[3773] = "¡Responde correctamente a mis preguntas y te entregaré un magnífico premio!";
    text[3774] = "¿Quieres retar al Señor de las Preguntas?";
    text[3775] = "Me han derrotado... Tus conocimientos son sorprendentes.";
    text[3776] = "¿Cómo se llama el misterioso mundo que hay al otro lado de los agujeros de gusano?";
    text[3777] = "Mundo Onda";
    text[3778] = "Zona Fantasma";
    text[3779] = "Dimensión Distorsión";
    text[3780] = "¡Respuesta incorrecta! ¡Tendrás más suerte la próxima vez!";
    text[3781] = "¿Cuál es el sector en el que está Regolithia?";
    text[3782] = "Sector 8";
    text[3783] = "Sector 14";
    text[3784] = "Sector 16";
    text[3785] = "¿Cuántos puntos de habilidad hacen falta para subir al nivel 4 una habilidad de apoyo?";
    text[3786] = "150 puntos de habilidad";
    text[3787] = "125 puntos de habilidad";
    text[3788] = "75 puntos de habilidad";
    text[3789] = "¿Cuántos PV tiene el lóbrego RIPTIDE?";
    text[3790] = "300 PV";
    text[3791] = "225 PV";
    text[3792] = "250 PV";
    text[3793] = "Última pregunta: ¿Quién soy?";
    text[3794] = "Un tipo horrible";
    text[3795] = "¡El Señor de las Preguntas Supremo!";
    text[3796] = "¡Mr. Famoso, el Amo de las Preguntas!";
    text[3797] = "¡Aquí está tu premio!";
    text[3799] = "¡Impresionante! ¡Has respondido con éxito a todas mis preguntas!";
    text[4067] = "Tú...";
    text[4068] = "Has conseguido hacerte un nombre en la Fuerza Lunex.";
    text[4069] = "Solo con verte puedo ver que eres una guerrera muy hábil.";
    text[4070] = "... ¿pero eres lo suficientemente buena como para impresionarme?";
    text[4071] = "Te pido disculpas. No me he presentado.";
    text[4072] = "Me llamo Pond...";
    text[4073] = "James Pond.";
    text[4074] = "Soy el entrenador de combate de mayor rango de la Fuerza Lunex.";
    text[4075] = "Convierto a cobardes enclenques en luchadores fuertes y capaces.";
    text[4076] = "Habla conmigo de nuevo cuando hayas conseguido al menos 50 rangos S en tu CÓDEX.";
    text[4077] = "Si superas mi desafío, recibirás algo valioso como recompensa.";
    text[4078] = "Muy pocos soldados han conseguido impresionarme...";
    text[4079] = "¿Crees que tienes lo que hace falta para ser la mejor guerrera de Luna?";
    text[4080] = "Parece que tienes al menos 50 rangos S.";
    text[4081] = "Sin embargo... Sigues sin impresionarme.";
    text[4082] = "¡Hemos tardado una eternidad en conseguir todos esos rangos S! ¡¿Qué más quieres?!";
    text[4083] = "¡Solo has completado la mitad de mi desafío, soldado!";
    text[4084] = "Conseguir 50 rangos S demuestra tu disciplina y tu pericia en combate.";
    text[4085] = "¡Para poder superar el desafío, debes derrotarme en un duelo!";
    text[4086] = "Reúnete conmigo en las Alcantarillas. Prepararé mi receptáculo para el combate.";
    text[4087] = "¿Por qué no luchas sin tu receptáculo?";
    text[4088] = "Vencer a un anciano no impresionará a nadie.";
    text[4089] = "Tengo ingenio y experiencia en combate, pero me falta fuerza física.";
    text[4090] = "Mi receptáculo me permite compensar 10 veces esa debilidad.";
    text[4091] = "¡Te venceremos, con receptáculo o sin él! Je.";
    text[4092] = "¡Ese es el espíritu! ¡Te espero en las Alcantarillas, soldado!";
    text[4093] = "¡Ahí estás! Prepárate, soldado. No voy a andarme con chiquitas contigo.";
    text[4094] = "¡Impresionante!";
    text[4095] = "¡Hacía mucho tiempo que no libraba un combate como este! ¡Muah, ja, ja, ja!";
    text[4096] = "¡Enhorabuena, soldado! Ha superado mi desafío.";
    text[4098] = "Si equipas el CHIP DE MEJORA DE COSTE, ";
    text[4099] = "restarás 5 al coste en PE de todas tus habilidades activas.";
    text[4100] = "¡Sigue así, soldado!";
    text[4803] = "Tetra, ¿no es ese el mismo robot que vimos en Regolithia?";
    text[4804] = "¡Digit! ¡Se llama Digit!";
    text[4805] = "Me alegra ver que Digit consiguió volver a casa.";
    text[4806] = "De todas formas, me pregunto qué estaba haciendo en Regolithia...";
    text[4807] = "01101000 01100101 01101100 01110000";
    text[4808] = "01110110 01101001 01110010 01110101 01110011";
    text[4809] = "Mmm... Mmm... Ya veo.";
    text[4810] = "¿Qué está diciendo Digit?";
    text[4811] = "Un virus ha infectado la red de la IA de Digit.";
    text[4812] = "¡Nos está pidiendo ayuda!";
    text[4813] = "Ooh..., pobrecillo. ¡No te preocupes, Digit! ¡Vamos a ayudarte!";
    text[4814] = "Tetra, tenemos que destruir el virus que está infectando la red de Digit.";
    text[4815] = "¿Debería introducirme en la red de la IA de Digit?";
    text[4816] = "¡Nuestro objetivo es encontrar y derrotar";
    text[4817] = "al virus que está infectando a Digit!";
    text[4818] = "Cuando venzamos al virus, ¡podremos reiniciar la red de Digit!";
    text[4819] = "¡No pierdas de vista los obstáculos de esta fase! ¡Vamos allá!";
    text[4876] = "BIP, BOP.";
    text[4877] = "¡GRACIAS POR AYUDARME!";
    text[4878] = "POR FAVOR, TOMAD ESTO, BIP, BOP.";
    text[4880] = "DIGIT OS ESTÁ MUY AGRADECIDO, BIP, BOP.";
    text[4881] = "AHORA DIGIT PUEDE SEGUIR REUNIENDO DATOS.";
    text[4882] = "¡Hola! Me llamo Fortuno.";
    text[4883] = "Soy el líder del Gremio de Cazatesoros de Silica.";
    text[4884] = "¿Crees que tienes lo que hace falta para ser una buena cazatesoros? ";
    text[4885] = "¡Por supuesto! ¡Cazar tesoros parece muy divertido! ¿Qué tenemos que hacer?";
    text[4886] = "Bueno, hagamos las cosas poco a poco.";
    text[4887] = "Todo cazatesoros que se precie debe tener buenas habilidades de observación de campo.";
    text[4888] = "Sal ahí fuera y descubre cuántas hogueras hay encendidas en Colonia Silica.";
    text[4889] = "Vuelve cuando sepas cuántas hay.";
    text[4890] = "Bien, ¿cuántas hogueras hay encendidas en Colonia Silica?";
    text[4891] = "Parece que tienes que mejorar tus habilidades de observación. Eso es incorrecto.";
    text[4892] = "¡Correcto! ¡Has superado tu primera prueba!";
    text[4893] = "¡Eres oficialmente una cazatesoros novata!";
    text[4894] = "La siguiente prueba es un poco más complicada... Pero dejémosla para otro momento.";
    text[4895] = "¡Bienvenida al Gremio de Cazatesoros! Aquí tienes un pequeño obsequio de mi parte.";
    text[4896] = "Es verdad que a los cazatesoros nos encanta coleccionar objetos peculiares y valiosos...";
    text[4897] = "¡pero también nos encanta la emoción de la exploración!";
    text[4898] = "Cuando exploras una zona a fondo, puedes obtener información muy valiosa";
    text[4899] = "que te puede llevar a objetos peculiares... ¡o incluso a reliquias perdidas!";
    text[1342] = "¡Enlace de red establecido!";
    text[1343] = "¡Llega hasta el final de la fase para reiniciar la red!";
    text[1344] = "¡Ten cuidado con los virus y los obstáculos de la fase!";
    text[1345] = "Si Tetra se queda sin vidas,";
    text[1346] = "el reinicio habrá fracasado.";
    text[1347] = "¡Usa tu Cañón Tetra para borrar a los virus enemigos!";
    text[1348] = "¡Red reiniciada!";
    text[1349] = "Recuperando enlace de salida...";
    text[1350] = "¡Enlace de salida de Tetra.EXE establecido!";
    text[1351] = "Reinicio fallido...";
    text[4033] = "¡Bella, esta fase está llena de cortafuegos!";
    text[4034] = "Disparar a los cortafuegos consumirá munición para cortafuegos.";
    text[4035] = "¡Ten en cuenta que la munición es limitada!";
    text[4036] = "¡Una cosa más!";
    text[4037] = "Disparar a los virus no consumirá munición para cortafuegos.";
    text[4038] = "¡Si te quedas sin salida, puedes volver a empezar!";
    text[4039] = "¡El protocolo de apagado está al final de la fase!";
    text[4040] = "Si apagamos la red de las alcantarillas, ¡las puertas láser";
    text[4041] = "se desactivarán! ¡Vamos que nos vamos!";
    text[4042] = "¡Protocolo de apagado de red ejecutado!";
    text[4043] = "Fallo al iniciar protocolo de apagado de red...";
    text[5342] = "¡Bella, esta fase consiste en una red con";
    text[5343] = "varios puntos de acceso ubicados en Copernicus!";
    text[5344] = "¡Tenemos que pulsar un total de cuatro interruptores";
    text[5345] = "para reiniciar la red de depuración!";
    text[5346] = "Si quedas atrapada, ¡busca un transportador de salida!";
    text[5347] = "¡Siempre podemos encontrar otro punto de acceso en otra";
    text[5348] = "máquina de filtrado de Copernicus!";
    text[5350] = "¡Unos virus se han apoderado de esta red!";
    text[5351] = "¡Tenemos que borrar todos los virus para";
    text[5352] = "eliminar el cortafuegos y reiniciar la red!";
    text[5353] = "¡Ten cuidado con los obstáculos que encontrarás en la fase!";
    text[610] = "¡Es el panel de anuncios de Regolithia!";
    text[1138] = "Rei";
    text[1177] = "¡Panel de anuncios de Regolithia!";
    text[1216] = "¡Hola a todos! ¡Me llamo Rei y soy la moderadora del panel de anuncios de Regolithia!";
    text[1217] = "¡Podéis publicar mensajes y hablar sobre estrategias de combate o de lo que queráis!";
    text[1139] = "Fuerza Lunex";
    text[1178] = "Aviso general";
    text[1218] = "Si un lóbrego aparece en tu sector,";
    text[1219] = "busca un refugio y contacta con la Fuerza Lunex para que envíe ayuda de inmediato.";
    text[1220] = "NO trates de enfrentarte a los lóbregos, sea cual sea la situación. Muchas gracias.";
    text[1140] = "Michelle";
    text[1179] = "Café Regolithia";
    text[1221] = "¿Necesitas un lugar en el que descansar y recargarte?";
    text[1321] = "¡Date un respiro en el Café Regolithia! ¡Tenemos lo que necesitas!";
    text[1222] = "¡Prueba nuestro delicioso ramen de miso o las barritas Cruj-E, la especialidad de nuestro café!";
    text[1141] = "ZetaMan";
    text[1180] = "¿Zonas oscuras?";
    text[1223] = "Colega, últimamente he visto unas zonas extrañas de energía deformada en el suelo...";
    text[1224] = "Cuando parpadeo, desaparecen. Dicen por ahí que es un lóbrego.";
    text[1142] = "Roto";
    text[1181] = "Límite de escudos";
    text[1225] = "¡Hola, camaradas! ¡Me llamo Roto! Ya habéis oído hablar del límite de escudos, ¿verdad?";
    text[1226] = "Normalmente, empiezas los combates con un escudo. ¡Si encuentras REFUERZOS DE ESCUDO,";
    text[1227] = "podrás aumentar la cantidad de escudos máximos con los que empiezas un combate!";
    text[1143] = "Boltz";
    text[1182] = "Lóbrego roca";
    text[1228] = "Chicos, he visto un lóbrego que parecía una roca andante...";
    text[1229] = "Miré por mi ventana y estaba en la parte más profunda de las cavernas.";
    text[1230] = "¡Os juro que no me lo estoy inventando!";
    text[1144] = "Raseru";
    text[1183] = "Estrategias de combate";
    text[1231] = "¡Uaaaah! ¡Acabo de echarle el guante a una habilidad de apoyo MULTIPLICAR (NV. 1)!";
    text[1232] = "¡Ahora podré hacerles mucho más daño a los hyperbees con mi Cañón Fotónico! ¡Muah, ja, ja, ja! ";
    text[1145] = "SpaceBoy";
    text[1184] = "RESPUESTA 1: Atributos de combate";
    text[1233] = "Oye colega, tu habilidad MULTIPLICAR solo tiene nivel 1...";
    text[1234] = "Para poder conseguir un multiplicador más alto,";
    text[1235] = "tienes que aumentar el nivel de tu habiIidad de apoyo MULTIPLICAR (NV. 1) gastando PUNTOS DE HABILIDAD.";
    text[1236] = "Te sugiero usar Aura Espiritual. Cuesta 2 escudos, pero añadirás 40 a tu poder.";
    text[1237] = "¡Con ese poder podrás eliminar a esos hyperbees con tu Cañón Fotónico!";
    text[1146] = "Raseru";
    text[1185] = "RESPUESTA 2: Estrategias de combate";
    text[1238] = "¡Hala! ¡Enséñame más, jefe! ¡Sííííí!";
    text[1147] = "Melia";
    text[1186] = "Cubo hertziano perdido";
    text[1239] = "¿Alguien ha visto mi cubo hertziano?";
    text[1240] = "Creo que lo perdí cerca de la Instalación de la Barrera...";
    text[1148] = "Jet";
    text[1187] = "Rangos S";
    text[1241] = "Soy Jet, ¿cómo puedo conseguir un rango S en combate? ";
    text[1242] = "¿Hay un límite de tiempo?";
    text[1243] = "¿Depende del número de turnos?";
    text[1244] = "¿Depende de mis PV?";
    text[1245] = "¡Necesito respuestas!";
    text[1149] = "KingNet";
    text[1188] = "RESPUESTA 1: Rangos S";
    text[1246] = "Es fácil: no dejes que te golpeen.";
    text[1150] = "Jet";
    text[1189] = "RESPUESTA 2: Rangos S";
    text[1247] = "Veo que KingNet es un hombre muy locuaz.";
    text[1151] = "Oslo";
    text[1190] = "RESPUESTA 3: Rangos S";
    text[1248] = "¡No te metas con KingNet! Se toma muy en serio los combates.";
    text[1249] = "He oído que es tremendamente fuerte.";
    text[1152] = "Jet";
    text[1191] = "RESPUESTA 4: Rangos S";
    text[1250] = "Probablemente no es rival para el Matalóbregos.";
    text[1153] = "Aether";
    text[1192] = "Habilidades de apoyo";
    text[1251] = "Agh, olvidé volver a equipar mis habilidades de apoyo curativas antes de un combate importante.";
    text[1252] = "No olvides echar un vistazo al menú de habilidades de apoyo para ver cuáles tienes equipadas, lol.";
    text[1154] = "LunaBot 101";
    text[1193] = "Astrobarrera";
    text[1253] = "La Astrobarrera es un generador de atmósfera artificial y un sistema defensivo.";
    text[1254] = "También puede comunicarse con los generadores de gravedad y oxígeno utilizando ondas EM.";
    text[1255] = "Gracias a ella es posible llevar una vida cómoda en el satélite.";
    text[1155] = "LunaBot 101";
    text[1194] = "Cita del día";
    text[1256] = "¡Es el año 30XX! Esta es la cita del día:";
    text[1257] = "¡Que tu lux brille para siempre!";
    text[1156] = "Tyrian";
    text[1195] = "Pensamientos profundos";
    text[1258] = "Colega, imagina que hay como caminos invisibles a nuestro alrededor.";
    text[1259] = "Tío, ¿y si estuvieran hechos de ondas electromagnéticas?";
    text[1260] = "Es un tema muy profundo, colega.";
    text[1157] = "Tobi";
    text[1196] = "RESPUESTA: Pensamientos profundos";
    text[1261] = "Tyrian, creo has tomado demasiados energ-Os.";
    text[1158] = "LunaBot 101";
    text[1197] = "20XX";
    text[1262] = "En el año 20XX, la humanidad vivía en el planeta volcánico conocido como Terra, ahora sin vida.";
    text[1263] = "Debido a la catástrofe planetaria ASTRA, los humanos se vieron obligados a buscar un nuevo hogar.";
    text[1264] = "Desgraciadamente, no había ningún planeta habitable a una distancia razonable,";
    text[1265] = "así que los supervivientes restantes llegaron hasta Luna, el satélite que orbitaba Terra.";
    text[1266] = "Llena de esperanza, sueños y determinación...";
    text[1267] = "la humanidad sobrevivió y prosperó en un nuevo hogar.";
    text[1159] = "Holo";
    text[1198] = "RUINAS";
    text[1268] = "Soy el detective Holo.";
    text[1269] = "Estoy buscando información sobre las ruinas que se han descubierto recientemente, y a alguien";
    text[1270] = "que pueda conocer el idioma que aparece en las paredes de Luna.";
    text[1160] = "Volta";
    text[1199] = "¿Cómo se mejoran las habilidades?";
    text[1271] = "¡Soy Volta! ¿Hay alguna manera de conseguir que mis HABILIDADES ACTIVAS sean más poderosas?";
    text[1161] = "Chip";
    text[1200] = "RE.: ¿Cómo se mejoran las habilidades?";
    text[1272] = "¡SÍ! Puedes usar REFUERZOS DE HABILIDAD para aumentar el nivel de tus habilidades activas.";
    text[1322] = "Pero no son fáciles de encontrar...";
    text[1162] = "ERROR";
    text[1201] = "SIN ASUNTO";
    text[1273] = "La vida es solo un experimento.";
    text[1274] = "Una reacción caótica... y maravillosa.";
    text[1275] = "Curiosamente, este anuncio se publicó hace 10 años.";
    text[1276] = "Y no desaparece por mucho que recargas el canal.";
    text[1277] = "Debe ser algún error.";
    text[1163] = "Alumae";
    text[1202] = "SIN ASUNTO";
    text[1278] = "Je.";
    text[1279] = "(Las 69 respuestas siguientes son solo «jes»).";
    text[1164] = "Stark";
    text[1203] = "¿A quién le ha pasado lo mismo?";
    text[1280] = "Ese momento en el que se generan las habilidades de apoyo,";
    text[1281] = "¡y recibes exactamente las tres mismas habilidades! ¡AGH!";
    text[1323] = "(Parece que esta publicación se volvió viral).";
    text[1165] = "KingNet";
    text[1204] = "RE.: ¿A quién le ha pasado lo mismo?";
    text[1282] = "M.";
    text[1166] = "Hazel";
    text[1205] = "Un montón de bytes";
    text[1283] = "Siempre encuentro bytes dentro de las cavernas de Regolithia.";
    text[1284] = "No son muchos, pero si exploras un poco para encontrarlos, es dinero fácil.";
    text[1285] = "Ahora que lo pienso, tal vez no debería haber publicado esto...";
    text[1167] = "Tanaka";
    text[1206] = "Mejoras para naves";
    text[1286] = "¿Habéis echado un vistazo a la tienda de Copernicus? Ayer mejoré mi nave.";
    text[1287] = "¡Ahora es una belleza! ¡Me costó 1000 gigabytes!";
    text[1288] = "Pero ha merecido la pena.";
    text[1168] = "Kohaku";
    text[1207] = "Gata perdida";
    text[1289] = "¿Alguien echa en falta a su gata recientemente?";
    text[1290] = "Trabajo en la Instalación de la Barrera, y cuando volvía a casa...";
    text[1291] = "¡Vi a una gata regordeta volando por ahí con un traje espacial!";
    text[1324] = "Tuve que pellizcarme para estar seguro de no estar soñando.";
    text[1169] = "Fuerza Lunex";
    text[1208] = "¡Estamos reclutando!";
    text[1292] = "¿Quieres unirte a la Fuerza Lunex? ¡Buscamos nuevos reclutas!";
    text[1170] = "Rex";
    text[1209] = "RE.: ¡Estamos reclutando!";
    text[1293] = "MADRE MÍA... ¿Nos daréis nuestros propios sables pistola si nos unimos?";
    text[1171] = "Nebuloid";
    text[1210] = "Sables pistola";
    text[1294] = "El filo y las balas de un sable pistola están imbuidos de plasma.";
    text[1295] = "Fueron diseñados para dañar a los lóbregos.";
    text[1296] = "He escuchado que los Laboratorios Lunex están diseñando una nueva arma para acabar con los lóbregos.";
    text[1297] = "¡Al parecer, usa tecnología de los receptáculos y funciona con antinúcleos!";
    text[1172] = "Fuerza Lunex";
    text[1211] = "SE BUSCA";
    text[1298] = "SE BUSCA: Matalóbregos\nNOMBRE: Desconocido\nEDAD: Veintena";
    text[1299] = "Si alguien ve al Matalóbregos, debe contactar de inmediato con la Fuerza Lunex.";
    text[1173] = "ZetaMan";
    text[1212] = "RE.: SE BUSCA";
    text[1300] = "Sinceramente, necesitamos encontrar a este hombre e incorporarlo a la Fuerza Lunex o algo así.";
    text[1301] = "¿Qué más da si robó propiedad militar?";
    text[1302] = "¡Es una máquina de machacar lóbregos! ¡Puede ayudar a protegernos!";
    text[1303] = "No entiendo por qué actúa de forma clandestina. ¿Qué estará ocultando?";
    text[1174] = "OGJony";
    text[1213] = "Estrellas fugaces";
    text[1304] = "¿Sientes que la suerte te sonríe? Si ves una estrella fugaz en el cielo, debes pulsar [Z].";
    text[2548] = "¿Sientes que la suerte te sonríe? Si ves una estrella fugaz en el cielo, debes pulsar [X].";
    text[2549] = "¿Sientes que la suerte te sonríe? Si ves una estrella fugaz en el cielo, debes pulsar [A].";
    text[1175] = "Tetra";
    text[1214] = "Receta de combo lux";
    text[1307] = "Hola, soy yo Tetra. ¿Alguien tiene recetas de combo lux que quiera compartir?";
    text[1305] = "Je, una ayudante experta no solo ayuda a su heroína durante los combates, sino que también";
    text[1306] = "procura que consiga los mejores consejos y pistas cuando no está luchando.";
    text[1176] = "Ouro";
    text[1215] = "RE.: Receta de combo lux";
    text[1308] = "Sí, tengo una para tí. Se llama Holohuracán.";
    text[1309] = "¡Trata de combinar 2 holoescudos con cualquier habilidad activa que use una espada!";
    text[100001] = "SÍ";
    text[100002] = "NO";
    text[69] = "PUEDES ACCEDER AL MENÚ PULSANDO [X].";
    text[2544] = "PUEDES ACCEDER AL MENÚ PULSANDO [Círculo].";
    text[2545] = "PUEDES ACCEDER AL MENÚ PULSANDO [B].";
    text[70] = "TAMBIÉN PUEDES HABLAR CON TETRA SI TE PONES A SU LADO Y PULSAS [C].";
    text[2546] = "TAMBIÉN PUEDES HABLAR CON TETRA SI TE PONES A SU LADO Y PULSAS [Cuadrado].";
    text[2547] = "TAMBIÉN PUEDES HABLAR CON TETRA SI TE PONES A SU LADO Y PULSAS [Y].";
    text[120001] = "¡Pulsa      para desactivar tu traje impulsor!";
    text[120002] = "¡Pulsa      para activar tu traje impulsor!";
    text[120003] = "ERROR DE AUTORIZACIÓN en plataforma de impulso...";
    text[2560] = "La plataforma de impulso no funciona bien. No podemos usarla ahora mismo...";
    text[4820] = "Es una plataforma de impulso rota.";
    text[4821] = "Parece que hace mucho tiempo que no se usa.";
    text[7560] = "¡SOBREFASE DESBLOQUEADO!";
    text[7561] = "¡Nickle ahora puede superar sus límites en combate y entrar en SOBREFASE!";
    text[7562] = "Esta poderosa forma dura 2 turnos y multiplica x4 el POD de todas";
    text[7563] = "las habilidades activas de Nickle, aunque pierde un 50% de sus PV en cada turno.";
    text[7564] = "Mientras tiene esta forma, el coste en PE se ignora, ¡así que puedes concentrarte en hacer todo el daño posible!";
    text[5331] = "Si interactúas con la gente de Luna obtendrás puntos de afinidad,";
    text[5332] = "¡que aumentarán tu reputación y tu nivel de afinidad con cada colonia!";
    text[5333] = "¡Si aumentas tu nivel de afinidad, desbloquearás nuevas misiones secundarias y";
    text[5334] = "también conseguirás descuentos al comerciar con vendedores y mercaderes de astrotecnos. ";
    text[5335] = "¡Tus niveles de afinidad se pueden ver en el CÓDEX, dentro del MENÚ REGISTROS!";
    text[7120] = "¿Qué hacemos con la minicápsula?";
    text[7121] = "La llevaremos con nosotros.";
    text[7122] = "Ya sabes, me gusta dar vueltas con ella.";
    text[7123] = "No me importaría usarla de vez en cuando.";
    text[7124] = "¡AHORA PUEDES SELECCIONAR LA MINICÁPSULA EN EL MENÚ DE PERSONALIZACIÓN DE NAVE!";
    text[1595] = "¡Enhorabuena!";
    text[1596] = "¡Has completado el capítulo 1!";
    text[1599] = "¡Síguenos @LunarLuxGame en twitter para estar al tanto de las últimas noticias y de la fecha de lanzamiento! ";
    text[1601] = "¡Os damos las gracias por vuestro apoyo!";
    text[1602] = "¡Gracias por jugar a LunarLux!";
    text[2484] = "¡A volar!";
    text[2485] = "Personalizar nave";
    text[2486] = "Salir";
    text[2487] = "¡Todavía no tenemos partes de nave!";

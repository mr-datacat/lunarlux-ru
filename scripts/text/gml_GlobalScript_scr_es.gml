    text[7898] = "Añade 2 al límite de habilidades de apoyo rojas";
    text[7900] = "Vaya, ¡el agua de este lugar parece gelatina!";
    text[7901] = "Mmmm... Aquí la gravedad es algo inferior a lo usual.";
    text[7902] = "Supongo que estamos bastante lejos del generador de gravedad más cercano.";
    text[7903] = "Esas tuberías forman parte de un gran red que transporta agua";
    text[7904] = "desde el océano norte de Luna hasta las colonias locales.";
    text[7905] = "¡Estas cajas contienen equipo que se usa para realizar expediciones arqueológicas!";
    text[7906] = "Los grabados de esta tableta hablan de una antigua guerra.";
    text[7907] = "Parece que los cuerpos de los guerreros están rodeados de una extraña aura.";
    text[7908] = "LA DUALIDAD DE LA ANTIMATERIA Y LA LUX...";
    text[7909] = "El resto de los grabados son ilegibles.";
    text[7910] = "Miras por la ventana para ver el paisaje de la ciudad.";
    text[7911] = "Hay un montón de atún en lata tras la vitrina de cristal.";
    text[7912] = "Psst, Bella, ¿puedo echar un vistazo a lo que hay dentro?";
    text[7913] = "La verdad es que no deberías rebuscar en las propiedades personales de otra persona.";
    text[7914] = "... ¿pero no tienes curiosidad? ¿Ni siquiera un poco?";
    text[7915] = "Bueno, sí...";
    text[7916] = "La necesidad de rebuscar en cada rincón y recoveco...";
    text[7917] = "Es al mismo tiempo un regalo y una maldición para aventureros impacientes como nosotros...";
    text[7918] = "Es una pintura llamada «El ahora infinito».";
    text[7919] = "¡Es una estatua de edición coleccionista definitiva de Pretty Peach!";
    text[7920] = "Seguro que estas cajas contienen un montón de peluches y de objetos de coleccionista.";
    text[7921] = "Bien, tiene usted razón, detective Tetra.";
    text[7922] = "Voy a instalar nuevas estanterías para exhibirlo todo adecuadamente, je, je.";
    text[7923] = "¡Es el alienígena BluBlu, de la serie Captain Moon!";
    text[7924] = "Es un peluche de YeloMelo y un cuadro de un perro adorable llamado «Nuevos horizontes».";
    text[7925] = "Es Cabinet-Senpai, del anime Chairem.";
    text[7926] = "¡Es un osito lavanda!";
    text[7927] = "¡Este lo conseguí en una máquina de bolas!";
    text[7928] = "¡Es el clásico osito marrón!";
    text[7929] = "¡Este lo gané en una grúa recreativa en el arcade!";
    text[7930] = "Las grúas recreativas son tan adictivas...";
    text[7931] = "Hay un montón de electrodomésticos caseros en esta vitrina de cristal.";
    text[7932] = "Es un cuadro llamado «¡No pierdas tu camino!».";
    text[7933] = "En la tele están poniendo un anime llamado «Three Piece».";
    text[7934] = "Es un cuadro llamado «El beso de la muerte».";
    text[7935] = "En la tele están poniendo un anime llamado «Life Note».";
    text[7936] = "Hay un cuadro en la pared llamado «Monado».";
    text[7937] = "¡Es un prototipo de nave espacial con un aspecto estupendo!";
    text[7938] = "Hay un montón de partes robóticas, microchips y dispositivos electrónicos en la vitrina de cristal.";
    text[7939] = "En la tele están poniendo un anime llamado «Los titanes atacan».";
    text[7940] = "Hay un montón de equipo para entrenar y guantes de boxeo en el suelo.";
    text[7941] = "Hola, Bella, ¿quieres ser mi nuevo saco? ¡MUAH, JA, JA, JA!";
    text[7942] = "¡Es la silla ergonómica para jugar más popular del mercado!";
    text[7943] = "ME GASTÉ TODO MI DINERO Y ME SIGUE DOLIENDO LA ESPALDA! ¡NO LO ENTIENDO!";
    text[7944] = "Es un equipo para jugar a videojuegos muy caro con tres monitores.";
    text[7945] = "También he comprado la tarjeta gráfica más moderna, je, je.";
    text[7946] = "Tengo que asegurarme de conseguir el mejor rendimiento posible para poder";
    text[7947] = "alcanzar el ansiado rango Radiante en el juego en el que estoy jugando.";
    text[7948] = "¡El Café Tycho es un lugar ideal para que las personas creativas y con talento";
    text[7949] = "Se reúnan gracias a nuestro maravilloso escenario!";
    text[7950] = "Siempre tenemos un elenco de músicos, cantantes, cómicos";
    text[7951] = "artistas y bailarines dispuestos a entretener.";
    text[7952] = "Hay una lista de personas desaparecidas clavada en el panel de anuncios...";
    text[7953] = "Estas cajas contiene un surtido de vitaminas para reforzar los conocimientos.";
    text[7954] = "Hay algunas levopiedras rotas en el suelo.";
    text[7955] = "Parece que se han usado mucho para entrenar.";
    text[7956] = "Esta estantería está llena de libros sobre artes marciales y meditación.";
    text[7958] = "¡Mola que leas tantos libros, Zara!";
    text[7959] = "Leer me ayuda a relajarme después de un largo día de entrenamiento.";
    text[7960] = "¡Deberías intentarlo a veces!";
    text[7957] = "Es un libro titulado «101 técnicas de combate útiles».";
    text[7961] = "Las levopiedras de Zara están apoyadas en sus estaciones de carga.";
    text[7962] = "¡Es un mapa de las Fosas de Silica!";
    text[7963] = "¿Qué indican las marcas verdes?";
    text[7964] = "No le sé, pero mi sentido de cazatesoros me dice algo.";
    text[7965] = "¡Es un gancho de agarre certificado por el Gremio de Cazatesoros!";
    text[7966] = "¡Es una pala certificada por el Gremio de Cazatesoros!";
    text[7967] = "¡Es un pico certificado por el Gremio de Cazatesoros!";
    text[7968] = "En esta vitrina se exponen artefactos y tesoros históricos";
    text[7969] = "En la tele están poniendo una película llamada «El caballero perruno».";
    text[7970] = "¿Estás buscando una aventura? ¡ÚNETE AL GREMIO DE CAZATESOROS hoy mismo!";
    text[7971] = "Amor, parece que estás huyendo de algo.";
    text[7972] = "¡¿En serio?! ¿Por qué dices eso?";
    text[7973] = "Bueno, transmites esa sensación. Puedo verla en tus ojos.";
    text[7974] = "Relájate un poco, ¿vale?";
    text[7975] = "No puedes huir para siempre de tus problemas.";
    text[7976] = "Llegará el día en el que tendrás que enfrentarte a ellos cara a cara.";
    text[7977] = "... y tu...";
    text[7978] = "¿Y-yo?";
    text[7979] = "Hay mucha pena en tu mirada.";
    text[7980] = "Espero que un día consigas la fuerza necesaria para superarla.";
    text[7983] = "Esas cajas tienen la etiqueta ALTO SECRETO.";
    text[7981] = "Probablemente, Saros habrá guardado equipo de sus experimentos secretos";
    text[7982] = "en este almacén con el paso de los años.";
    text[7984] = "Es el túnel derrumbado de una mina.";
    text[7985] = "¿Qué es eso, Bella?";
    text[7986] = "Es una lista de personas desaparecidas... Se ha actualizado hoy.";
    text[7987] = "Parece que varias personas desaparecieron tras el ataque.";
    text[7988] = "¿Era Saros consciente de esto?";
    text[7989] = "¿Por qué no lo dijo durante tu discurso triunfal?";
    text[7990] = "Este ataque debe haber sido una experiencia escalofriante para mucha gente...";
    text[7999] = "¿Tal vez esté tratando de mantener la moral alta?";
    text[7991] = "Aunque no hubo bajas,";
    text[7992] = "muchos ciudadanos y soldados resultaron heridos.";
    text[7993] = "Y ahora parece que hay personas desaparecidas.";
    text[8001] = "Ni siquiera tuve la oportunidad de tener una buena conversación con el Matalóbregos...";
    text[8000] = "Teniendo todo esto en cuenta... no me parece una victoria.";
    text[8002] = "Bella, no sueles ser así...";
    text[8003] = "¡Tienes que ser más optimista! ¡Todo podría haber ido mucho peor!";
    text[7994] = "Deberíamos dejar que la Fuerza Lunex se encargue de las personas desaparecidas.";
    text[7995] = "¡Seguro que las encuentran!";
    text[7996] = "¡Ahora mismo te mereces un muy bien merecido descanso! ¡Hoy has hecho un trabajo estupendo!";
    text[7997] = "Vale... Tienes razón. ¡Volvamos a casa!";
    text[8004] = "Creo que en este momento deberíamos centrarnos en la misión.";
    text[8005] = "Podremos explorar la ciudad más tarde.";
    text[8006] = "¿Te gustaría entrar en la mina?";
    text[8008] = "Eh, usted es Bella Grey, ¿verdad?";
    text[8009] = "La verdad es que me vendría muy bien su ayuda ahora...";
    text[8010] = "¿Qué ha ocurrido?";
    text[8011] = "Estaba patrullando por el Mte. Piton, cuando de pronto me atacó un enorme lóbrego.";
    text[8012] = "Mientras trataba de huir, se me cayó mi sable pistola...";
    text[8013] = "Bueno,... estoy contento de haber salido con vida pero...";
    text[8014] = "Ese sable pistola era muy importante para mí...";
    text[8015] = "Era un regalo de mi padre.";
    text[8016] = "Parece que, sin él, ya no puedo hacer mi trabajo adecuadamente...";
    text[8017] = "Mis compañeros me dijeron que debería olvidarlo y usar un nuevo sable pistola...";
    text[8018] = "Pero no consigo hacerlo...";
    text[8019] = "Lo he intentado... Pero no es lo mismo.";
    text[8020] = "Eh, lo entiendo. Ese sable pistola tiene un gran significado para ti.";
    text[8021] = "¡Te ayudaremos a encontrarlo!";
    text[8022] = "Vaya, ¡muchas gracias por su ayuda!";
    text[8023] = "Creo que mi sable pistola se me cayó en la cima del Mte. Piton.";
    text[8024] = "¿Pudiste identificar al lóbrego que te atacó?";
    text[8025] = "No... No estaba en la base de datos.";
    text[8026] = "Parecía un híbrido de centauro que llevara una armadura de receptáculo.";
    text[8027] = "¡Jamás había visto nada así!";
    text[8028] = "Gracias por la información.";
    text[8029] = "Mantendremos los ojos abiertos por si aparece ese lóbrego mientras recuperamos el sable pistola.";
    text[8030] = "¡Gracias, Srta. Bella! Le estaré esperando aquí.";
    text[8031] = "¡Ha encontrado mi sable pistola! ¡Lo ha encontrado de verdad!";
    text[8032] = "Sí, ¡y también hemos derrotado al lóbrego que te atacó!";
    text[8033] = "¡Ya se puede patrullar de nuevo por el Mte. Piton sin peligro!";
    text[8034] = "¡Qué alivio!";
    text[8035] = "¡Por favor, acepte esto por las molestias, Srta. Bella!";
    text[8036] = "Es lo menos que puedo hacer.";
    text[8037] = "Un soldado sin su fiel sable pistola es como una pizza sin queso...";
    text[8038] = "¡Has encontrado el sable pistola de Barry!";
    text[8039] = "¡Hola! Soy la química jefe del departamento de ciencias,";
    text[8040] = "¡y estoy llevando a cabo una investigación para crear el fluido curativo definitivo!";
    text[8041] = "Si tenéis tiempo, me vendría bien un par de manos extra. ¿Qué me decís?";
    text[8042] = "Ooooh, ¡Quiero ayudar! ¿Qué necesitas?";
    text[8043] = "¡Para el experimento que estoy realizando ahora necesito un ELIXIR  y un FLUIDO REANIMADOR!";
    text[8055] = "¡Traédmelos cuando los hayáis encontrado!";
    text[8044] = "Muy bien, no te preocupes, ¡la superquímica Tetra se encargará de esto!";
    text[8045] = "¡Aquí están el ELIXIR y el FLUIDO REANIMADOR que nos pediste!";
    text[8046] = "¡Maravilloso!";
    text[8047] = "Dime, ¿crees que podrás crear el fluido curativo definitivo con estos objetos?";
    text[8048] = "En realidad...";
    text[8049] = "Puede que tarde un par de años en desarrollar la fórmula química perfeccionada.";
    text[8050] = "Oh.";
    text[8051] = "¡No te desanimes! Un día la conseguiré. ¡De eso puedes estar segura!";
    text[8052] = "Solo tengo que hacer las cosas poco a poco.";
    text[8053] = "Por ahora, ¡puedes llevarte este regalo!";
    text[8059] = "¡Has obtenido un energ-O legendario y un holofluido!";
    text[8054] = "¡Un día crearé el fluido curativo definitivo!";
    text[8056] = "¡No me cabe duda!";
    text[8057] = "¡Buena suerte con tu investigación!";
    text[8058] = "¡Gracias!";
    text[8060] = "Parece que eres alguien que aprecia la belleza de la naturaleza.";
    text[8061] = "¡Así es! También me encanta explorar.";
    text[8062] = "¡Espléndido! Tienes un currículum perfecto, querida.";
    text[8090] = "¡El puesto es tuyo! ¡Oh, jo, jo, jo!";
    text[8063] = "¡¿Cómo?!";
    text[8064] = "Estoy buscando a alguien que me ayude a realizar mi investigación botánica.";
    text[8065] = "Últimamente se han avistado más lóbregos, y esto dificulta el trabajo de campo.";
    text[8066] = "Tu misión es documentar y recoger muestras de tres plantas de especies distintas";
    text[8067] = "que se pueden encontrar en Luna.";
    text[8068] = "¿Qué especies estás buscando?";
    text[8089] = "(AAAAH, ¡no quería apuntarme a esto!)";
    text[8069] = "Tranquila, querida. Te pagaré por hacerlo.";
    text[8070] = "¡Recibirás una cuantiosa recompensa por tu esfuerzo!";
    text[8071] = "(¡¿Acaba de leerme la mente?!)";
    text[8072] = "¡Querida, tus pensamientos se reflejan en tu rostro!";
    text[8073] = "También soy una estupenda jueza de carácter, ¡oh, jo, jo, jo!";
    text[8074] = "Bien, ¿por dónde iba...?";
    text[8075] = "... Ah sí, las tres especies de plantas...";
    text[8076] = "¡Primero necesito una muestra de camelia lunar!";
    text[8077] = "Las camelias lunares se suelen encontrar en Regolithia, ¡oh, jo, jo, jo!";
    text[8078] = "Segundo, necesitaré una nuestra de flox nocturna.";
    text[8079] = "Creo que crecen abundantemente en Copernicus, ¡oh, jo, jo, jo!";
    text[8080] = "Por último, necesito una muestra de coral armonía.";
    text[8081] = "Son nativas de un lugar llamado arrecife Armonía, en Oceanus...";
    text[8091] = "(¡Oh, jo, jo, jo!)";
    text[8082] = "¡Ahora date prisa, querida! ¡Tienes un montón de muestras que recoger!";
    text[8083] = "(...y un montón de información que recordar... Vaya faena...)";
    text[8084] = "¡Si olvidas los detalles de tu misión, solo tienes que preguntarme!";
    text[8085] = "No seas tímida, querida, ¡Oh, jo, jo, jo!";
    text[8086] = "Hola, he conseguido las muestras de plantas que querías.";
    text[8087] = "¡Espléndido! ¡Gracias por ayudarme con mi investigación, querida!";
    text[8088] = "Aquí está tu recompensa...";
    text[8092] = "¡Has obtenido 10 000 Bytes y una gominola!";
    text[8093] = "¿Estás buscando otro trabajo? ¡Tenemos muchas tareas pendientes, querida!";
    text[8094] = "Mmm... Tal vez en la próxima ocasión.";
    text[8095] = "(¡AAAAAAAHH!)";
    text[8096] = "(¡Oh, jo, jo, jo!)";
    text[8097] = "¡Camelia lunar obtenida!";
    text[8098] = "¡Flox nocturna obtenida!";
    text[8099] = "Coral armonía obtenido!";
    text[8101] = "También hay una nota bajo esta barrita de queso abandonada. Pone";
    text[8102] = "¡Qué emocionada estoy! ¡Eres sin duda la candidata perfecta!''";
    text[8103] = "'Por favor, reúnete conmigo en el Café Copernicus.'";
    text[8105] = "¡Parece que te has ganado el derecho a conocer a esta misteriosa persona cara a cara!";
    text[8106] = "¡Vamos allá!";
    text[8107] = "Perdona, ¿eres tú la que nos ha llevado a una caza de barritas de tarta de queso?";
    text[8108] = "¡Sí, he sido yo! Me llamo Melski.";
    text[8109] = "¡Es estupendo poder conoceros!";
    text[8110] = "Veréis, he preparado esta actividad tan intrincada";
    text[8111] = "porque necesito a alguien que sea perfecto para probar los sabores...";
    text[8112] = "... Alguien que entienda y aprecie una buena barrita de tarta de queso.";
    text[8130] = "¡Yo nunca diría que no a una barrita de tarta de queso!";
    text[8131] = "¡Vamos allá! ¿Qué debería probar primero?";
    text[8113] = "Bueno, ¡me gustaría que probaras una de las barras de tarta de queso que has recogido!";
    text[8114] = "¡La verdad es que fui yo quien las horneó!";
    text[8115] = "¡AAAAAAH! MELSKI, ES DELICIOSA!";
    text[8116] = "¡Sabes aún mejor que una barrita de tarta de queso normal!";
    text[8117] = "¡Tienes que contarme tu secreto!";
    text[8118] = "¡Me alegro mucho de que te guste!";
    text[8119] = "¡He estado trabajando en esta receta bastante tiempo!";
    text[8120] = "Mi sueño es abrir mi propia panadería vegana algún día.";
    text[8121] = "Bueno, como camarada experta en barritas de tarta de queso,";
    text[8122] = "¡diría que esta es la mejor que he probado en mi vida!";
    text[8123] = "Cuando tu panadería esté funcionando... ¡Seré tu clienta número uno!";
    text[8124] = "¡Significa mucho para mí, ¡gracias!";
    text[8125] = "Por favor toma esto, de una entusiasta de las tartas de queso a otra.";
    text[8126] = "Me hace muy feliz ver que otras personas disfrutan con lo que preparo.";
    text[8127] = "¿Estás trabajando en otras recetas nuevas?";
    text[8128] = "¡En este momento estoy trabajando en la receta de unos deliciosos brownies veganos!";
    text[8129] = "¡Qué bien suena! ¡Llámame si necesitas a alguien que los pruebe!";
    text[8132] = "¡Hola! ¡Tengo algunas partes de nave que me gustaría vender!";
    text[8133] = "¡Échales un vistazo si estás interesada!";
    text[8134] = "¡Echa un vistazo!";
    text[8135] = "Estás en el mercado negro, chica.";
    text[8136] = "La verdad es que no deberías estar aquí.";
    text[8137] = "Sin embargo...";
    text[8138] = "Los negocios son los negocios.";
    text[8139] = "Estoy vendiendo partes de nave que he adquirido legalmente...";
    text[8140] = "... con un gran énfasis en lo de «legalmente».";
    text[8141] = "¡Compra algo o lárgate!";
    text[8142] = "Cielos, ¡qué vergüenza! ¡Mi cuarto está hecho un desastre!";
    text[8143] = "¡Aaah, no te preocupes, Melody!";
    text[8144] = "Solo hemos venido para relajarnos un poco contigo, je.";
    text[8145] = "¿Es cosa mía o tienes nuevos peluches?";
    text[8146] = "¡Sí! Mi colección ha aumentado.";
    text[8147] = "¡Todo lo que hay aquí es tan...";
    text[8148] = "¡BONITO y BLANDITO!";
    text[8149] = "Coleccionar peluches y figuras raras es mi afición favorita, je, je.";
    text[8150] = "Hablando de peluches raros...";
    text[8151] = "Hay un peluche extremadamente raro para el que estoy ahorrando...";
    text[8152] = "... y lo pondrán a la venta en tres días.";
    text[8153] = "El problema es... que no he ahorrado el dinero suficiente para comprarlo.";
    text[8154] = "¡Si no compro el peluche cuando salga a la venta, se agotará ENSEGUIDA!";
    text[8155] = "Y perderé mi oportunidad de hacerme con él...";
    text[8156] = "Por taaaaanto, me preguntaba...";
    text[8157] = "Si estarías interesada en comprar algunos de mis peluches para que pueda";
    text[8158] = "ahorrar el dinero necesario para comprar ese peluche tan raro que siempre he querido tener.";
    text[8159] = "Melody, ¡por supuesto que te ayudaré!";
    text[8160] = "De hecho, yo también he empezado a coleccionar peluches últimamente.";
    text[8161] = "¡Estupendo!";
    text[8162] = "Estos son los peluches que estoy vendiendo... Si los compras todos,";
    text[8163] = "¡podré ahorrar el dinero necesario para comprar el peluche raro que quiero comprar!";
    text[8164] = "¡Yuuupi! ¡Los has comprado todos! ¡Muchas gracias, Bella!";
    text[8165] = "Cualquier cosa por mi buena amiga, je, je.";
    text[8166] = "Toma, ¡también puedes quedarte con esto!";
    text[8167] = "Oye, Melody, ¿cuál es ese peluche que quieres conseguir?";
    text[8168] = "Es una edición limitada...";
    text[8169] = "¡Un peluche de Milky con olor a fresa de más de 3 metros!";
    text[8170] = "Santo cielo... ¡Es enorme!";
    text[8171] = "¡Viene con un dispositivo para hacer batidos incorporado!";
    text[8172] = "¡LO NECESITO! ¡LO NECESITO YAAAA!";
    text[8391] = "Eh, uh...";
    text[8392] = "Hola, ¿ocurre algo?";
    text[8179] = "¿Te gustan los patos?";
    text[8180] = "Espero que sí...";
    text[8181] = "Me encantan los patos. ¡Son una monada!";
    text[8182] = "¡¿Verdad que sí?!";
    text[8183] = "¡Los patos son adorables, les encanta comunicarse y tienen mucha personalidad!";
    text[8184] = "Son tan.@P.@P.@P";
    text[8185] = "L-lo siento... Me pongo hiperactivo cuando hablo de animales...";
    text[8186] = "... sobre todo cuando hablo de patos.";
    text[8393] = "Mmm, bueno, sea como fuere, me llamo LO-Ogi.";
    text[8178] = "¡Soy un androide, y el orgulloso dueño del santuario de aves de Rancho Kepler!";
    text[8187] = "¿Creéis que podríais ayudarme con un asunto...";
    text[8188] = "... relacionado con patos?";
    text[8206] = "Claro, ¿de qué se trata?";
    text[8190] = "Paso mi tiempo libre leyendo sobre la histórica belleza de la";
    text[8191] = "vida salvaje de Terra antes de que fuera destruida.";
    text[8189] = "Hace que valore mucho más la vida salvaje que tenemos aquí, en Luna.";
    text[8192] = "He dedicado la mayor parte de mi vida operativa a conseguir";
    text[8193] = "que los animales de mi santuario están sanos, felices y a salvo.";
    text[8194] = "Pero, a pesar de esto, me avergüenza decir.@P.@P.@P";
    text[8205] = "¡QUE HE PERDIDO A MIS PATOS!";
    text[8195] = "¡¿Cómo?! ¡¿Has perdido a tus patos?!";
    text[8196] = "He estado cuidando de tres patos aventureros que parecen tener";
    text[8197] = "la mala costumbre de perderse fácilmente.";
    text[8198] = "Aunque no les culpo... ";
    text[8199] = "¡Son muy curiosos y tienen muchas ganas de vivir sus propias aventuras!";
    text[8200] = "Les dejo en libertad tanto como quieren porque siempre acaban encontrando";
    text[8201] = "el camino a casa... pero hoy no ha sido así...";
    text[8202] = "Estoy preocupado... Espero que estén bien...";
    text[8203] = "Eh, ¡te ayudaremos a encontrar a tus patos! ¡No te preocupes!";
    text[8394] = "Además, ¡quiero ver los adorables son!";
    text[8204] = "¡G-gracias!";
    text[8207] = "¿Tienes alguna idea de dónde podrían estar tus patos?";
    text[8208] = "He perdido tres patos en total.";
    text[8209] = "A uno no le gusta nada el frío...";
    text[8210] = "¡De hecho, suele llevar una bufanda verde!";
    text[8211] = "Supongo que estará merodeando por un lugar que esté CALIENTE.";
    text[8212] = "Tengo otro pato al que le encanta relajarse en las azoteas de edificios...";
    text[8213] = "Así que lo más probable es que esté vagabundeando por una de las ciudades.";
    text[8214] = "... Y, uh... El tercer pato...";
    text[8215] = "Es el pato más listo que he cuidado jamás...";
    text[8216] = "... y le encanta resolver puzles, sobre todo si hay láseres involucrados.";
    text[8217] = "Vaya...";
    text[8218] = "Sí... ¡Como he dicho, los patos tienen mucha personalidad!";
    text[8219] = "Gracias por la información, LO-Ogi.";
    text[8225] = "¡Encontraremos tus patos, te lo prometo!";
    text[8173] = "¡Cuac! ¡Cuac!";
    text[8174] = "¡Has encontrado a uno de los patos aventureros de LO-Ogi!";
    text[8175] = "¡Cuac! ¡LO-Ogi está preocupado por ti! ¡Es hora de volver a casa!";
    text[8220] = "¡Soy tan feliz! ¡Mis tres patos han vuelto!";
    text[8221] = "¡Gracias por ayudarme!";
    text[8222] = "Oh, debería ofreceros algo como agradecimiento...";
    text[8223] = "Mmm...";
    text[8224] = "Ah, ¿qué os parece esto?";
    text[8176] = "¡Has recibido 200 astrotecnos y una gominola!";
    text[8226] = "¿Sabes qué quiere decir mi nombre?";
    text[8227] = "Es algo raro...";
    text[8228] = "Significa: Observador lunar de organismos.";
    text[8229] = "Yo... Eh... He olvidado que significaba la «i» del final...";
    text[8230] = "... pero no creo que sea importante.";
    text[8231] = "¡Gracias de nuevo por ayudarme a encontrar mis patos!";
    text[8232] = "Hola, Zara, ¿qué te traes entre manos?";
    text[8233] = "Me estoy tomando un descanso del entrenamiento para poder meditar.";
    text[8234] = "Es importante fortalecer tu mente y tu cuerpo.";
    text[8235] = "¿Tienes nuevas técnicas o combos lux en los que hayas estado trabajando?";
    text[8236] = "Seguro que podrías enseñarme una o dos cosas.";
    text[8237] = "En realidad...";
    text[8238] = "Podría decir lo mismo de ti.";
    text[8239] = "También me gustaría que me enseñaras algunas cosas.";
    text[8240] = "¿¡Cómo?! ¿Y-yo?";
    text[8241] = "¿Por qué no? ¿Eres una guerrera muy hábil y admiro tu talento.";
    text[8242] = "Estoy segura de que has conseguido unos cuantos combos lux que desconozco.";
    text[8243] = "Te propongo lo siguiente...";
    text[8244] = "Si reúnes al menos 20 recetas de combo lux distintas en tu base de datos...";
    text[8245] = "Te daré un nuevo combo lux y...";
    text[8246] = "también te enseñaré a usar mis levopiedras, como extra.";
    text[8247] = "¡De acuerdo!";
    text[8248] = "Mmm...";
    text[8249] = "¿¡Oh?!";
    text[8250] = "Qué interesante...";
    text[8251] = "Es realmente una combinación única de habilidades...";
    text[8252] = "Ahh... Ya veo...";
    text[8253] = "Si hago eso, entonces...";
    text[8254] = "Bien, ahora...";
    text[8255] = "¡Gracias a ti, me ha llegado una nueva ola de inspiración para crear nuevos combos!";
    text[8256] = "¡Como prometí, aquí tienes una nueva receta de combo lux para ti, Bella!";
    text[8258] = "Deberíamos hacer esto de nuevo más a menudo.";
    text[8259] = "¡Por supuesto!";
    text[8257] = "¡Has obtenido la receta de combo lux Escuadrón Raine Deluxe!";
    text[8260] = "¡Has obtenido la receta de combo lux Puñetazo Propulsado!";
    text[8261] = "Has obtenido la receta de combo lux Cadena Radiante!";
    text[8262] = "¡Has obtenido la receta de combo lux Impacto Cósmico!";
    text[8263] = "¡Me llamo Jason! Soy el dueño de Robótica BlanK!";
    text[8295] = "Tetra... Veo que te han fabricado personas expertas.";
    text[8296] = "Esta aleación de metal... Estos componentes... ¡Son increíbles!";
    text[8264] = "¿Te importa si examino las armas de combate que tienes integradas?";
    text[8265] = "No te preocupes, ¡procede!";
    text[8266] = "¿Oh? ¡Qué interesante!";
    text[8267] = "¿Has pensado alguna vez en mejorar tu cañón?";
    text[8268] = "¡Parece que tus circuitos se podrían mejorar aún más!";
    text[3722] = "Cañón Tetra Mejorado = ayudante mejorada, je.";
    text[8269] = "¿Qué te parece, Bella?";
    text[8270] = "Tú decides, Tetra.";
    text[8271] = "¡La elección es tuya!";
    text[8272] = "En ese caso... ¡digo que sí!";
    text[8273] = "¡Me encantaría tener una mejora!";
    text[8274] = "¡Estupendo! Déjame ver si tengo todas piezas...";
    text[8275] = "Muy bien, veréis...";
    text[8276] = "Tengo malas noticias... No tengo suficientes engranajes centrales.";
    text[8277] = "¿Son absolutamente necesarios para la mejora?";
    text[8278] = "¡Por supuesto! Con los engranajes centrales podré duplicar...";
    text[8279] = "No... ¡Cuadruplicar el POD base de Tetra!";
    text[8280] = "Bella, deberíamos tratar de encontrar unos engranajes centrales cuanto antes...";
    text[8281] = "En serio, ¡quiero esta mejora!";
    text[8282] = "Como vais a tomaros las molestias de buscar los engranajes centrales,";
    text[8283] = "os ofreceré un descuento en mis servicios...";
    text[8284] = "¡Tendréis un Cañón Tetra mejorado por tan solo 200 astrotecnos!";
    text[8285] = "Muy bien, tenemos un trato.";
    text[8286] = "¿Dónde podemos encontrar esos engranajes centrales?";
    text[8287] = "Mmm... Puede ser algo complicado. ¡Los engranajes centrales son bastante raros!";
    text[8288] = "¿Conoces algún lugar donde pueda haber partes o maquinaria de repuesto?";
    text[8289] = "Mmm...";
    text[8290] = "¿¡Oh?!";
    text[8291] = "¿Tal vez deberíamos echar un vistazo en la Zona de Almacenaje, en Regolithia?";
    text[8292] = "¡Buena idea, Tetra!";
    text[8293] = "Muy bien, Jason, ¡volveremos cuando hayamos encontrado algunos engranajes centrales!";
    text[8294] = "¡Estupendo! ¡Hasta pronto!";
    text[8297] = "¡Has encontrado algunos engranajes centrales!";
    text[8298] = "¡Tenemos los engranajes centrales! Je.";
    text[8299] = "¡Genial! ¿Tenéis también la cantidad que os pedí?";
    text[8300] = "¿Cuánto era?";
    text[8301] = "¡200 astrotecnos por mis servicios como robotécnico!";
    text[8302] = "¡Sí, tenemos suficientes astrotecnos!";
    text[8303] = "¡Estupendo! ¡Empecemos con la mejora!";
    text[8304] = "No tenemos suficientes astrotecnos...";
    text[8305] = "¡No os preocupéis, puedo esperar!";
    text[8306] = "A fin de cuentas, tengo un negocio que mantener, ja, ja, ja.";
    text[8307] = "¡Mejora completada!";
    text[8308] = "¡El POD base de tu habilidad de apoyo Cañonazo Tetra es ahora 200!";
    text[8309] = "¡Esto es increíble! ¡Ya me siento más fuerte";
    text[8310] = "¡Me alegro de oírlo!";
    text[8311] = "Gracias por elegir mi negocio... ¡y buena suerte en tu aventura, Tetra!";
    text[8312] = "Por ahora las cosas van algo lentas... ¡Pero esto no durará mucho!";
    text[8313] = "A medida que la IA mejore, más y más robots entrarán en la sociedad,";
    text[8314] = "¡y todos necesitarán un robotécnico en el que puedan confiar!";
    text[8315] = "... Entonces Robótica BlanK se convertirá en la mejor tienda de robótica de toda Luna, ¡ja, ja, ja!";
    text[8316] = "¿No dijiste que podría haber algunos engranajes centrales en la Zona de Almacenaje de Regolithia?";
    text[8317] = "¡Sí! ¡Volveremos cuando tengamos algunos!";
    text[8318] = "Vaya, vaya... ¡Es estupendo verte, guerrera prodigio!";
    text[8319] = "¡Je, je, je!";
    text[8320] = "Conozco esa mirada... Ese fuego en tus ojos...";
    text[8321] = "¿Sabes qué? Tengo algo de tiempo libre.";
    text[8322] = "Acepto tu desafío.";
    text[8323] = "Oh, ya nos conocemos, Bella.";
    text[8324] = "¡Reúnete conmigo delante del Café Regolithia!";
    text[8325] = "... y prepárate...";
    text[8326] = "¡PARA RECIBIR UNA PALIZA!";
    text[8327] = "¡Esta vez no voy a perder! ¡MUAH, JA, JA, JA ,JA!";
    text[8328] = "¡Yo tampoco!";
    text[8329] = "¡Nos vemos allí, Raine!";
    text[8330] = "Cuando mi cuerpo ha llegado a su límite después de entrenar...";
    text[8331] = "Solo me queda una cosa por hacer...";
    text[8332] = "... ¡jugar videojuegos! ¡MUAH, JA, JA ,JA!";
    text[8333] = "Hagamos que esto sea más interesante...";
    text[8334] = "Si ganas, te enseñaré a usar mis Guantes Afilados.";
    text[8335] = "Es decir, ¡aprenderás una nueva habilidad activa!";
    text[8336] = "... y si gano yo...";
    text[8337] = "¡Espera! No te molestes en terminar esa frase.";
    text[8338] = "... porque voy a ganar este duelo, de una manera u otra, je.";
    text[8339] = "Ya veo lo que estás haciendo...";
    text[8340] = "¡Estás tratando de enfurecerme!";
    text[8341] = "Bien...";
    text[8342] = "¡ESTÁ FUNCIONANDO!";
    text[8343] = "¡LEVANTA ESOS PUÑOS Y LUCHA CONMIGO! ¡JA, JA, JA, JA ,JA!";
    text[8344] = "Ay, diablos...";
    text[8345] = "Vale, esta vez has ganado.";
    text[8346] = "¡Ha sido divertido!";
    text[8347] = "No podría haber tenido una mejor rival.";
    text[8348] = "Toma, aquí tienes...";
    text[8349] = "Estaré relajándome en mi casa.";
    text[8350] = "¡Nos vemos, guerrera prodigio!";
    text[8351] = "Eh, Fortuno, como somos miembros del Gremio de Cazatesoros...";
    text[8352] = "¿Te importaría compartir con nosotros algo de información sobre mitos o misterios sin resolver?";
    text[8353] = "¿En serio? Jovenzuelos, sois cazatesoros novatos...";
    text[8354] = "¿Seguro que tenéis lo necesario para esto?";
    text[8355] = "¡Sí, lo tenemos!";
    text[8356] = "Me he dedicado a la caza de tesoros mucho antes de unirme al Gremio.";
    text[8357] = "Me gustan los desafíos. ¡Vamos, dame tu mejor pista!";
    text[8358] = "Muy bien, entonces tengo algo para vosotros.";
    text[8359] = "Hace poco, unos arqueólogos descubrieron una tableta antigua que hablaba de";
    text[8360] = "la existencia de dos espadas legendarias...";
    text[8361] = "La Espada Reliquia y Excalibur.";
    text[8362] = "No se sabe mucho de la Espada Reliquia...";
    text[8363] = "... Pero sí que tenemos algo de información sobre Excalibur.";
    text[8364] = "Los registros indican que esa espada está situada en algún lugar al sur de Copernicus.";
    text[8365] = "Además, para poder blandir Excalibur,";
    text[8366] = "el que quiera usarla debe reunir dos llaves...";
    text[8367] = "... Eso es todo lo que sé.";
    text[8368] = "¡Si acabáis encontrando Excalibur, venid a hablar conmigo!";
    text[8369] = "¡El gremio incentiva a nuestros aventureros ofreciendo recompensas a aquellos";
    text[8370] = "que puedan descubrir los tesoros más valiosos de Luna!";
    text[8371] = "¡Buena suerte en vuestra caza de tesoros!";
    text[8372] = "Gracias, Fortuno.";
    text[8373] = "Bien Nickle, ¿dónde empezamos?";
    text[8374] = "Creo que deberíamos echar un vistazo en las zonas de botín donde todavía no hayamos estado.";
    text[8375] = "Primero tenemos que encontrar dos piedras antiguas, ¡y luego a la propia Excalibur!";
    text[8376] = "¡VAMOS ALLÁ! ¡Vaya, estoy EMOCIONADO!";
    text[8377] = "(Es como si fuera una persona totalmente distinta cuando hay una caza de tesoros por medio).";
    text[8378] = "(Sí, es mucho menos gruñón).";
    text[8379] = "¿Qué estáis murmurando?";
    text[8380] = "Vamos, ¡vayamos a encontrar esa espada legendaria!";
    text[8381] = "Madre mía, ¡la habéis encontrado!";
    text[8382] = "...¡la legendaria Excalibur! ¡Estoy más que impresionado!";
    text[8383] = "Bueno, os pido disculpas por subestimaros antes.";
    text[8384] = "No sois novatos...";
    text[8385] = "¡Puede que seáis los mejores cazatesoros de nuestro gremio!";
    text[8386] = "Je, je. Gracias, Fortuno.";
    text[8387] = "Bueno, ¡aquí está vuestra recompensa!";
    text[8388] = "¡Has conseguido 10 000 bytes!";
    text[8389] = "Si consigo más información sobre tesoros sin descubrir,";
    text[8390] = "¡me aseguraré de pasárosla, jovenzuelos!";
    text[8007] = "¡La puerta se ha abierto con la LLAVE SECRETA";
    text[8400] = "Has encontrado una llave antigua!";
    text[8401] = "¡Ya solo tienes que encontrar una!";
    text[8402] = "Vaya, ¡las llaves están brillando!";
    text[8403] = "Han aparecido unos grabados antiguos...";
    text[8404] = "Tetra puedes traducirlos?";
    text[8405] = "¡Claro! Aquí dice...";
    text[8406] = "'Cuando las dos piedras estén juntas...'";
    text[8407] = "'El espejismo desaparecerá...'";
    text[8408] = "Mmm... El espejismo desaparecerá...";
    text[8409] = "¡Creo que significa que podremos encontrar la ubicación de Excalibur!";
    text[8410] = "¡Fortuno dijo que estaba en algún lugar al sur de Copernicus, en el mapa del mundo!";
    text[8411] = "¡Vamos, a volar!";
    text[8412] = "¡Lo conseguimos! ¡Hemos encontrado la legendaria Excalibur!";
    text[8413] = "Yo, eh.@P.@P.@P.";
    text[8414] = "Me alegro de haber podido compartir este momento con vosotras.";
    text[8415] = "El sentimiento es mutuo, Nickle.";
    text[8416] = "¡Sí! ¡Tres hurras por el éxito de la caza de tesoros!";
    text[8417] = "¡Sí! ¡Volvamos a Silica para hablar con Fortuno!";
    text[8418] = "¡Hola! ¿Te gustan los conejos?";
    text[8419] = "Vaya pregunta... ¿Cómo es posible que a alguien no le gusten los conejos?...";
    text[8420] = "¡Son tan blanditos!";
    text[8421] = "¡Estupendo! Bueno, pues este regalo es para ti...";
    text[8422] = "¡Has obtenido los peluches de Axel y Hazel!";
    text[8423] = "Los peluches que te he dado son de mi videojuego, llamado  'CODE: Bunny'";
    text[8424] = "Como te gustan los conejos, ¿por qué no pruebas mi juego?";
    text[8425] = "Claro ¡me encantaría!";
    text[8426] = "LunarLux";
    text[8427] = "Profundidades";
    text[8428] = "BONIFICACIÓN";
    text[8429] = "Zona de botín";
    text[8430] = "Rancho Kepler";
    text[8431] = "Tycho";
    text[8432] = "Zona Yerma";
    text[8433] = "Lux latente";
    text[8434] = "Base Militar";
    text[8435] = "Carrera galáctica";
    text[8436] = "Combate contra Vivia";
    text[8437] = "Fosas de Silica";
    text[8438] = "Silica";
    text[8439] = "Calma sincera";
    text[8440] = "Nieve lunar";
    text[8441] = "Combate contra Escuadrón Raine";
    text[8442] = "Ruinas Lux";
    text[8443] = "Combate contra los Antiguos";
    text[8444] = "Revelación";
    text[8445] = "Laboratorio Nexus";
    text[8446] = "Científico demente";
    text[8447] = "Dueños del futuro";
    text[8448] = "Salvar el mundo";
    text[8449] = "Tu destino te espera";
    text[8450] = "Combate contra Saros Caótico";
    text[8451] = "Pelea hiperespacial";
    text[8452] = "Créditos";
    text[8453] = "¡PISTAS DEL CAPÍTULO 3 DESBLOQUEADAS EN EL ROBOT MUSICAL!";
    text[8454] = "¡PISTAS DEL CAPÍTULO 4 DESBLOQUEADAS EN EL ROBOT MUSICAL!";
    text[8455] = "¡PISTAS DEL CAPÍTULO 5 DESBLOQUEADAS EN EL ROBOT MUSICAL!";
    text[8456] = "¿Cuál es tu siguiente destino?";
    text[8457] = "Mmm... ¡Creo que después me pasaré por el café de la Estación Espacial Lunex!";
    text[8458] = "¡En estos momentos estoy trabajando en un montón de canciones nuevas con mi grupo de músicos";
    text[8459] = "inspiradas por mi viaje a través de Luna!";
    text[8460] = "¡Dentro de dos días mostraremos nuestra música en un show en el Café Tycho!";
    text[8461] = "¡Espero veros allí";
    text[8462] = "¡Eh, estáis aquí!";
    text[8463] = "Como a todos os ha gustado mucho mi música,";
    text[8464] = "he decidido establecerme en Tycho.";
    text[8465] = "¡Voy a poner todo mi corazón en actuar y en presentar mi música aquí!";
    text[8466] = "¡Gracias por tu apoyo, Bella!";
    text[8467] = "¡Aquí tienes mis últimas canciones para que las descargues!";
    text[8468] = "¡Echo te ha dado 300 astrotecnos!";
    text[8469] = "¡Has obtenido el conjunto de nave Echo!";
    text[8470] = "¡Este conjunto incluye el chasis Echo, el propulsor Echo y el ala Echo!";
    text[8471] = "¡Has obtenido el traje impulsor Echo!";
    text[8472] = "Hemos vuelto a la Zona Fantasma...";
    text[8473] = "Bella, no deberíamos estar aquí.";
    text[8474] = "Es peligroso, ¿recuerdas?";
    text[8475] = "Lo sé, nos iremos pronto...";
    text[8476] = "Mmm...";
    text[8477] = "Me pregunto si la Fuerza Lunex conoce esta entrada...";
    text[8478] = "Recuerdo haber visto extraños grabados en las paredes de algunas partes de Luna.";
    text[8479] = "Eso significa que hay más entradas a la Zona Fantasma que desconocemos...";
    text[8480] = "Me gustaría conocer mejor este lugar algún día...";
    text[8481] = "Después de todo, mamá solía realizar expediciones a la Zona Fantasma.";
    text[8482] = "Es fácil asustarse de aquello que desconocemos";
    text[8487] = "Cuanto más sepamos de este lugar, ¡más seguro será explorarlo!";
    text[8483] = "¿No crees, Tetra?";
    text[8484] = "Bueno... Supongo que sí...";
    text[8485] = "Pero ten cuidado, ¿vale?";
    text[8486] = "No te preocupes, ¡lo tendré!";
    text[8488] = "Yo no iría a la Zona de Almacenaje si fuera tú...";
    text[8489] = "¿Por qué no?";
    text[8490] = "Parece que hay una plaga de ratas...";
    text[8491] = "¡Srta. Nyla! ¡Reeves! ¿Qué estáis haciendo los dos aquí?";
    text[8492] = "¡Mueh! ¡Es nuestra hora de descanso!";
    text[8493] = "Pensamos que podríamos ayudar al Equipo de Arqueología a analizar su último descubrimiento.";
    text[8494] = "Oooh, ¿qué habéis descubierto?";
    text[8531] = "Bien...";
    text[8495] = "¡Han encontrado estas tabletas brillantes!";
    text[8496] = "Son reliquias que dejó una civilización antigua...";
    text[8497] = "... una sociedad de personas que existió mucho antes de que la humanidad se asentara en Luna.";
    text[8498] = "¿Tenemos un nombre para ellas?";
    text[8499] = "Hace años, tu madre solía estudiar esta antigua civilización...";
    text[8500] = "Ella simplemente les llamaba «los Antiguos».";
    text[8501] = "Eso es...";
    text[8502] = "... muy original.";
    text[8503] = "A mamá nunca se le dio bien eso de poner nombres, eh, je, je, je...";
    text[8504] = "Recuerdo que, cuando era niña, dijo algo sobre los Antiguos en una ocasión...";
    text[8505] = "... Los Antiguos tenían algún tipo de conexión con la lux y la antimateria.";
    text[8506] = "¡Así es! Mueh.";
    text[8507] = "Poseemos muy pocos conocimientos sobre los Antiguos...";
    text[8508] = "La única misión del Equipo de Arqueología es descubrir el pasado de Luna...";
    text[8509] = "... Pero últimamente ha sido difícil realizar más expediciones debido a la falta de fondos...";
    text[8510] = "¿¡Cómo?! ¿Ha sido Saros el que os ha recortado los fondos?";
    text[8511] = "Mueh, Saros insiste en que es mejor usar nuestros recursos para mirar hacia el futuro,";
    text[8512] = "que para desentrañar el pasado.";
    text[8513] = "... Ya veo.";
    text[8514] = "Si yo fuera general, habría duplicado los fondos del Equipo de Arqueología.";
    text[8515] = "Creo que es importante conocer nuestras raíces...";
    text[8516] = "... y a la gente que vivía aquí antes que nosotros.";
    text[8517] = "Me pregunto por qué desaparecieron los Antiguos...";
    text[8518] = "¿Quién sabe? ¡Es algo que todavía tenemos que descubrir! Mueh!";
    text[8519] = "Y dime, ¿qué te trae por aquí, Bella?";
    text[8520] = "Oh, ahora mismo solo me estoy encargando de algunas misiones para la Fuerza Lunex.";
    text[8521] = "Muy bien, ¡entonces no dejes que te distraigamos!";
    text[8522] = "¡Sigue así, Bella!";
    text[8523] = "¡Mueh! Con el paso de los años encontramos una cantidad decente de glifos y grabados";
    text[8524] = "que los Antiguos dejaron atrás...";
    text[8525] = "De hecho, ¡bastaron para decodificar parte de su idioma!";
    text[8526] = "Srta. Nyla, ¿cree que los antiguos podrían tener";
    text[8527] = "algún tipo de conexión con la Zona Fantasma?";
    text[8528] = "No es exactamente mi especialidad, querida...";
    text[8529] = "Así que no estoy totalmente segura. ¿Por qué lo preguntas?";
    text[8530] = "Mmm... Solo era algo que me vino a la cabeza...";
    text[8532] = "Mi trabajo consiste en documentar la ubicación de cada artefacto antiguo que descubramos.";
    text[8533] = "¡Excavar en busca de artefactos antiguos puede ser todo un desafío!";
    text[8534] = "A menudo tenemos que usar instrumentos muy delicados y precisos,";
    text[8535] = "para atravesar lentamente el suelo lunar, con objeto de no dañar los artefactos.";
    text[8536] = "¿Y tú a qué te dedicas?";
    text[8537] = "Yo, bueno...";
    text[8538] = "¡Me encargo de traer las rosquillas!, ¡Do'h!";
    text[8539] = "¡HAY NUEVAS MISIONES DE FUERZA LUNEX DISPONIBLES!";
    text[8540] = "¡Espera";
    text[8541] = "No vayamos a la Base Militar ahora mismo.";
    text[8542] = "Todavía no sabemos quién es de fiar...";
    text[8543] = "¡Primero deberíamos desarrollar un plan para detener a Saros!";
    text[8544] = "¡Es una minicápsula fuera de servicio!";
    text[8545] = "Esto, eh... ¿Tienes alguna noticia sobre el Matalóbregos?";
    text[8546] = "Nah... No sé nada de él desde que lo capturaron.";
    text[8547] = "¿Pero tienes alguna noticia?";
    text[8548] = "... ¡No!";
    text[8549] = "Srta. Bella, es un oficial de alto rango de la Fuerza Lunex...";
    text[8550] = "¿Ha recibido algún informe de misión de código morado últimamente?";
    text[8551] = "La infantería de baja graduación como yo nunca recibe esas cosas...";
    text[8552] = "Oh, mmm...";
    text[8553] = "... ¡No!";
    text[8554] = "Ya veo... No pasa nada.";
    text[8555] = "En este monitor aparece una lista de criminales y fugitivos buscados.";
    text[8556] = "Hay una lista con informes sobre personas y ciudadanos desaparecidos en este monitor.";
    text[8557] = "En este monitor aparece una lista de lugares en los que ha habido incidentes con lóbregos.";
    text[8558] = "¡Esta máquina expendedora vende galletas de mentas y samoas!";
    text[8559] = "¡¿POR QUÉ SIGUEN ESTOS TIPOS AQUÍ?!";
    text[8560] = "..¡¿Y CÓMO ES QUE NADIE SE HA DADO CUENTA?!";
    text[8561] = "¿Con cuánta fuerza les golpeaste, Tetra?";
    text[8562] = "¡No les di TAN fuerte!";
    text[8563] = "Es una celda vacía de la prisión...";
    text[8564] = "Echas un vistazo en la celda... Es oscura, y cada vez se vuelve más oscura.";
    text[8565] = "Eh, ¡este tipo está echándose una siesta!";
    text[8566] = "Quiero decir...";
    text[8567] = "Ser el guardia de una prisión sin prisioneros debe ser un trabajo bastante aburrido.";
    text[8568] = "En estas taquillas solo hay uniformes de la prisión.";
    text[8569] = "Esta puerta lleva a la cafetería.";
    text[8570] = "Estás tratando de resistir las ganas de tirar de la alarma de incendio con todas tus fuerzas...";
    text[8571] = "¡Hay una pegatina de «Rickinillo» en esta taquilla!";
    text[8572] = "Parece que estas paredes están reforzadas con holotecnología.";
    text[8573] = "Es una cápsula para dormir para con capacidades limitadas.";
    text[8574] = "Varias granadas experimentales están alineadas.";
    text[8575] = "¡Es un bumerán! ¡Resulta muy útil para acabar con varios enemigos!";
    text[8576] = "¡Es un Hidrodestructor! ¡Esta arma puede infligir REMOJÓN a los enemigos!";
    text[8577] = "Hay varios sables pistola experimentales alineados aquí.";
    text[8578] = "Hay varios trajes impulsores alineados contra la pared.";
    text[8579] = "Es un servidor de datos que se usa para supervisar la ciberred militar.";
    text[8580] = "Hay un montón de código espagueti! ¡Está POR TODAS PARTES!";
    text[8581] = "Estas holoestrellas se utilizaban para generar la trampa de holocampo de Vivia.";
    text[8582] = "No sé muy bien cuál es la función de este panel de control...";
    text[8583] = "Es la terminal de investigación de Vivia.";
    text[8584] = "Es un extractor de antimateria biométrico.";
    text[8585] = "Aquí hay un libro de ciencia ficción bastante guay titulado «Dune».";
    text[8586] = "Aquí hay un libro de ciencia ficción bastante guay titulado, «El juego de Ender».";
    text[8587] = "Aquí hay un libro de ciencia ficción bastante guay llamado, «La guía del autoestopista galáctico».";
    text[8588] = "Aquí hay un libro de ciencia ficción bastante guay llamado, «El marciano».";
    text[8589] = "Aquí hay un libro titulado, «La terraformación de Luna».";
    text[8590] = "Aquí hay un libro titulado, «La caída de Terra».";
    text[8591] = "Aquí hay un libro titulado, «Economía lunar».";
    text[8592] = "Aquí hay un libro titulado, «Misterios del cosmos».";
    text[8593] = "Si quieres historia, aquí tienes un poco...";
    text[8594] = "¡Las kiropuertas que ves repartidas por toda Luna,";
    text[8595] = "fueron antaño puntos de descanso que los antiguos utilizaban durante sus largos viajes!";
    text[8596] = "Siempre me he preguntado por qué el suelo de este sector es marrón...";
    text[8597] = "Oh, ¡ya sé por qué!";
    text[8598] = "Silica fue el primer sector en el que se construyó la Astrobarrera, y también en el que se puso a prueba.";
    text[8599] = "El oxígeno de la atmósfera artificial reaccionó con el suelo de Silica, que es rico en minerales";
    text[8600] = "¡y, con el paso del tiempo, el suelo empezó a adquirir este tono marrón";
    text[8601] = "Vaya, ¡sí que eres inteligente!";
    text[8602] = "Je.";
    text[8603] = "NUEVA";
    text[8604] = "ACTIVA";
    text[8605] = "COMPLETADA";
    text[8606] = "M-01: Bienes robados";
    text[8607] = "M-02: Carga militar perdida";
    text[8608] = "M-03: Escasez de comida en Rancho Kepler";
    text[8609] = "M-04: Ataque de pyrowyrms";
    text[8610] = "M-05: Líder de los bandidos espaciales";
    text[8611] = "Un grupo de pyrowyrms ha estado lanzando ataques coordenados contra nuestros soldados.";
    text[8612] = "Estos lóbregos parecen más fuertes de lo normal y son tremendamente inteligentes.";
    text[8613] = "Creemos que su próximo objetivo será la Base Militar.";
    text[8614] = "¡Tu misión es localizar y derrotar a esas pyrowyrms!";
    text[8615] = "Ve a la Zona Agreste 1 para hablar con Damian y conseguir detalles adicionales.";
    text[8616] = "Hemos encontrado a un grupo de bandidos especiales que pueden tener datos valiosos";
    text[8617] = "sobre la ubicación de su organización criminal.";
    text[8618] = "Tenemos datos que sugieren que esta organización criminal está vinculada a";
    text[8619] = "incontables casos sin resolver de personas desaparecidas que se han ido archivando con el paso de los años.";
    text[8620] = "Tu misión es encontrar a esta organización criminal, infiltrarte en ella";
    text[8621] = "¡y arrestar a su malvado líder!";
    text[8623] = "¡Estamos aquí para ayudar en la misión de las pyrowyrms!";
    text[8624] = "¿Cuál es la situación actual?";
    text[8625] = "Las pyrowyrms han iniciado su próximo ataque coordinado.";
    text[8626] = "¡En estos momentos nuestros soldados están luchando contra ellas en la Zona Yerma 2!";
    text[8627] = "Muy bien, ¡iremos allí de inmediato para ofrecerles apoyo!";
    text[8628] = "Ya veo...";
    text[8629] = "No puedo creer que Saros nos haya traicionado de esta manera...";
    text[8630] = "Algunos de mis amigos desaparecieron hace un par de semanas...";
    text[8631] = "Saros también debe haberlos convertido en lóbregos...";
    text[8622] = "Espero que podamos encontrar una manera de volver a convertir a los lóbregos en humanos algún día...";
    text[8632] = "Hasta entonces, será un placer ayudarte a ti y a tu equipo como pueda.";
    text[8633] = "Gracias, ¡estamos muy contentos de que estés de nuestro lado!";
    text[8634] = "De hecho, hay algo que puedes hacer...";
    text[8635] = "Reúne todos los soldados que puedas y cuéntales la verdad sobre Saros.";
    text[8636] = "¡A partir de ahora, debéis proteger todos los antinúcleos que encontréis y mantenerlos a salvo!!";
    text[8637] = "¡Entendido! ¡Haré todo o que pueda!";
    text[8638] = "Antes de que se me olvide, toma esto...";
    text[8639] = "¡Los refuerzos han llegado! A partir de ahora nos encargamos de todo.";
    text[8640] = "Muy bien... Voy a usar mi habilidad para percibir almas...";
    text[8641] = "¡Escuchadme! ¡No es necesario recurrir a la violencia!";
    text[8643] = "¿Pue... Puedes entendernos?";
    text[8644] = "¡Puedo!";
    text[8645] = "Mi capacidad para percibir almas me permite comunicarme contigo.";
    text[8646] = "Nuestra familia... Saros, nos ha convertido a todos en lóbregos...";
    text[8647] = "Debe pagar por lo que ha hecho...";
    text[8648] = "... y por nuestro dolor y sufrimiento...";
    text[8649] = "Nosotros... No confiamos en ti...";
    text[8650] = "Se suponía que la Fuerza Lunex protegía a la gente de Luna...";
    text[8651] = "¡Y todos nos habéis FALLADO!";
    text[8652] = "No nos están escuchando...";
    text[8653] = "Saros  debe haberles dado una versión más refinada del suero de lóbrego...";
    text[8654] = "La antimateria está aumentando sus sentimientos de miedo y furia.";
    text[8655] = "¡Tenemos que detenerles antes de que hieran a alguien!";
    text[8656] = "Muy bien... ¡Preparémonos para el combate!";
    text[8657] = "Lamento que tuviéramos que hacer esto...";
    text[8658] = "Mantendremos vuestros antinúcleos a salvo...";
    text[8659] = "... y prometo encontrar una manera de reunir a vuestra familia algún día.";
    text[8660] = "Vamos, Bella. Tenemos que hablar con Damian.";
    text[8661] = "¡Arriba las manos! ¡Por la autoridad que me confiere la Fuerza Lunex, todos estáis bajo arresto!";
    text[8662] = "Un momento, Bella... Deja que me encargue de esto.";
    text[8663] = "¡Escuchadme!";
    text[8664] = "No sé qué crímenes habréis cometido, pero no estamos aquí por vosotros.";
    text[8665] = "Hemos venido a por vuestro líder.";
    text[8666] = "Aquí nadie quiere pasar su vida en la celda de una prisión, así que...";
    text[8667] = "Hagamos un trato.";
    text[8668] = "Nickle, ¿estás chalado?";
    text[8669] = "¡Estos tipos son criminales!";
    text[8670] = "Sé lo que estoy haciendo.";
    text[8671] = "Escuchadme, os dejaremos marchar si nos decís dónde está vuestro líder...";
    text[8672] = "... sin trucos.";
    text[8673] = "Capitán, ¿qué hacemos?";
    text[8674] = "Mmm... Este chico...";
    text[8675] = "Puedo oler a un malhechor a un kilómetro de distancia.";
    text[8676] = "No eres como la Srta. Bonachona que te acompaña...";
    text[8677] = "Tú también eres un criminal, ¿verdad";
    text[8678] = "Bingo.";
    text[8679] = "Soy el Matalóbregos...";
    text[8680] = "Ocupo el primer puesto en la lista de los más buscados de la Fuerza Lunex.";
    text[8681] = "Esa máscara... Este tipo no está mintiendo.";
    text[8682] = "¡Se supone que estabas en la cárcel!";
    text[8683] = "¿Cómo demonios has escapado?";
    text[8684] = "La Srta. Bonachona me ha ayudado a escapar.";
    text[8685] = "¡Eh!";
    text[8686] = "Bien, ¿tenemos un trato?";
    text[8687] = "¡De eso nada!";
    text[8688] = "Nunca traicionaríamos a nuestros camaradas o a nuestro líder.";
    text[8689] = "De hecho, no hemos hecho más que retrasaros durante todo este tiempo.";
    text[8690] = "¡Habéis caído en nuestra trampa! ¡Ja, ja, ja, ja!";
    text[8691] = "¿Qué trampa?";
    text[8692] = "Mientras estabais hablando sobre vuestro trato,";
    text[8693] = "¡hemos activado a escondidas la secuencia de autodestrucción de esta nave!";
    text[8694] = "Otra vez no...";
    text[8695] = "¡¿No es la primera vez que os ocurre?!";
    text[8696] = "Por desgracia.";
    text[8697] = "Estos chicos nunca se avienen a razones.";
    text[8698] = "¡Tendremos que luchar!";
    text[8699] = "¿Lo mío no era resolver asuntos peleando,";
    text[8700] = "y lo tuyo hacerlo mediante la diplomacia?";
    text[8701] = "Bueno, ¡ahí fuera hay gente desaparecida que espera que nosotros les encontremos!";
    text[8702] = "O luchamos o perdemos nuestra oportunidad de conseguir la información que necesitamos.";
    text[8703] = "Tetra, ¿cuánto tiempo nos queda?";
    text[8704] = "¡Tenemos que derrotarles en 5 turnos!";
    text[8705] = "Muy bien, ¡esos bandidos espaciales están perdidos!";
    text[8706] = "... ¡Y secuencia de autodestrucción desactivada!";
    text[8707] = "Maldita sea... Sois endiabladamente fuertes.";
    text[8708] = "Deberíais haber aceptado mi trato cuando tuvisteis la oportunidad.";
    text[8709] = "Aunque perdimos... No pensamos abrir la boca.";
    text[8710] = "En ese caso... Tetra, escanea esta nave y trata de encontrar pistas que puedan ayudarnos.";
    text[8711] = "Escaneando...";
    text[8712] = "Eh, ¡este tipo tiene algo en su bolsillo!";
    text[8713] = "¡Esta llave de mina se usa para abrir puertas láser en las Minas de Silica!";
    text[8714] = "¡Su escondite debe estar allí!";
    text[8715] = "¡Debemos dirigirnos a las Minas de Silica de inmediato! ¡A volar!";
    text[8716] = "Tetra, ¡escanea sus constantes vitales!";
    text[8717] = "Están muertos... Sus heridas eran demasiado graves...";
    text[8718] = "¿Quién puede haber hecho esto?";
    text[8719] = "¡Los restos de antimateria en sus trajes de combate, las enormes heridas de mordiscos,";
    text[8720] = "y las lecturas de energía térmica me indican que probablemente estamos lidiando con...";
    text[8721] = "un lóbrego que puede manipular el fuego.";
    text[8722] = "... ¿como un moleculoid?";
    text[8723] = "No, algo aún mayor...";
    text[8724] = "Es posible que el lóbrego aparezca, ¡no bajemos la guardia!";
    text[8725] = "Escuchadme todos, ¡hemos venido para sacaros de aquí!";
    text[8726] = "¡Es la Fuerza Lunex!";
    text[8727] = "Oh, gracias al cielo...";
    text[8728] = "Pensaba que íbamos a quedarnos atrapados aquí para siempre...";
    text[8729] = "Seguid a Tetra, por favor. Ella os llevará a un lugar seguro.";
    text[8730] = "E-espera... El líder de los bandidos...";
    text[8731] = "Todavía sigue ahí fuera...";
    text[8732] = "Si descubre que escapamos... Nuestras vidas estarían en peligro...";
    text[8733] = "Volvería a darnos caza...";
    text[8734] = "No os preocupéis. Cuando os saquemos de aquí, arrestaremos al líder de los bandidos,";
    text[8735] = "y también buscaremos al lóbrego enloquecido que habita en estas minas.";
    text[8736] = "Estaréis bajo nuestra protección.";
    text[8737] = "Oh...";
    text[8738] = "No lo entendéis...";
    text[8739] = "El líder de los bandidos... Es el lóbrego enloquecido.";
    text[8740] = "¡¿Q-qué?!";
    text[8741] = "Tal vez yo pueda explicarlo.";
    text[8742] = "Saludos, soy Kerberos...";
    text[8743] = "... el líder de los bandidos espaciales.";
    text[8744] = "Os ha llevado bastante tiempo encontrar mi escondite...";
    text[8745] = "Kerberos, ¿por qué estás secuestrando gente?";
    text[8746] = "¡Ellos son inocentes! ¡No han hecho nada malo!";
    text[8747] = "Todo forma parte del trabajo...";
    text[8748] = "... o, al menos, así lo era.";
    text[8749] = "Explícate.";
    text[8750] = "Hace años que mis bandidos y yo trabajamos en secreto para el general Saros...";
    text[8751] = "... raptando y secuestrando a gente para sus experimentos.";
    text[8752] = "¿Entonces sabes la verdad sobre los lóbregos?";
    text[8753] = "Hace mucho tiempo que sé la verdad.";
    text[8754] = "A nosotros, los bandidos... No nos importa lo que está bien mal...";
    text[8755] = "Solo queremos dinero y poder.";
    text[8756] = "Saros nos ha dado dinero... y nos ha prometido poder.";
    text[8757] = "En cambio, nosotros haríamos todo el trabajo sucio.";
    text[8758] = "Saros... me hizo una visita hoy...";
    text[8759] = "Dijo que ya no necesitaba mis servicios...";
    text[8760] = "... y me convirtió en ESTO...";
    text[8761] = "MIRADME.";
    text[8762] = "SOY UN MONSTRUO.";
    text[8763] = "Eres un monstruo porque has matado a tus propios hombres.";
    text[8764] = "Lo más raro es que no recuerdo haberlo hecho.";
    text[8765] = "Cuando me convertí en lóbrego, todo se puso borroso...";
    text[8766] = "¡Un dolor y una rabia abrumadoras me consumieron!";
    text[8767] = "¡Estoy usando cada ápice de mi fuerza para poder hablar con vosotros!";
    text[8768] = "(El hecho de que Kerberos sea capaz de hablar...)";
    text[8769] = "(indica que queda poco para que el suero de lóbrego de Saros alcance la perfección...)";
    text[8770] = "Tenéis...";
    text[8771] = "¡TENÉIS QUE ARREGLAR ESTO!";
    text[8772] = "Lo siento... Todavía no tenemos un antisuero...";
    text[8773] = "En este momento, no podemos devolverte tu forma humana.";
    text[8774] = "¡NO! ¡NO! ¡NO! ¡NO PIENSO ACEPTARLO!";
    text[8775] = "Si esto no se puede arreglar...";
    text[8776] = "Solo me queda una cosa por hacer...";
    text[8777] = "Mataré al hombre que me convirtió en este MONSTRUO...";
    text[8778] = "... ¡Y MATARÉ A TODO AQUEL QUE TRATE DE INTERPONERSE EN MI CAMINO!";
    text[8779] = "Bella, ¡los niveles de antimateria de Kerberos están por las nubes!";
    text[8780] = "¡Está a punto de perder de nuevo el control!";
    text[8781] = "Muy bien, equipo, ¡acabemos con él!";
    text[8782] = "Saros... Ha estado colaborando con criminales como Kerberos todo este tiempo...";
    text[8783] = "Eh, olvidémonos de Saros en este momento.";
    text[8784] = "Hemos detenido a la organización criminal responsable no solo de las denuncias";
    text[8785] = "de personas desaparecidas, ¡si no también de cientos de casos criminales sin resolver!";
    text[8786] = "Ahora... podemos centrarnos en salvar a las víctimas inocentes que habían sido convertidas en lóbregos.";
    text[8787] = "¡Estamos más cerca de hacer justicia!";
    text[8788] = "¿Sabes una cosa?";
    text[8789] = "Tienes toda la razón del mundo.";
    text[8790] = "¡Hemos hecho un trabajo estupendo, equipo!";
    text[8791] = "Hay una nota en esta pantalla en la que pone: 824913.";
    text[8792] = "¡ESPERA! No tengo traje impulsor, ¿cómo esperáis que vuele por ahí?";
    text[8793] = "¿Tal vez pueda comprarte uno?";
    text[8794] = "No, gracias. Ni siquiera sé cómo usar uno de esos trajes.";
    text[8795] = "Hum, vale...";
    text[8796] = "Cargaré contigo.";
    text[8797] = "¿QUÉ? NADA DE ESO.";
    text[8798] = "Sería como poner mi vida en tus manos.";
    text[8799] = "Tetra no te soltará.";
    text[8800] = "Es mucho más fuerte de lo que parece.";
    text[8801] = "Mi oferta expirará en cinco segundos...";
    text[8802] = "Cuatro segundos...";
    text[8803] = "¡E-espera!";
    text[8804] = "Tres segundos...";
    text[8805] = "...";
    text[8806] = "Dos segundos...";
    text[8807] = "Un segundo...";
    text[8808] = "¡Vale, de acuerdo! Aceptaré tu oferta.";
    text[8809] = "Pero si me dejas caer...";
    text[8810] = "No lo haré... Confía en mí. Je.";
    text[8812] = "En el año 20XX, la catástrofe planetaria conocida como ASTRA comenzó.";
    text[8813] = "Un cometa misterioso hecho de antimateria se dirigió directamente a Terra, nuestro planeta.";
    text[8814] = "Tras varios intentos fallidos de destruir el cometa,";
    text[8815] = "La humanidad decidió que la mejor opción era abandonar Terra...";
    text[8816] = "... e iniciar un viaje sin retorno a nuestro satélite, Luna.";
    text[8817] = "Esta imparable fuerza cósmica de la naturaleza, el cometa Coda,";
    text[8818] = "atravesó Terra, causando una gran destrucción a su paso...";
    text[8819] = "Miles de millones de vidas se perdieron ese día...";
    text[8820] = "Si no hubiera sido por nuestros fundadores, los Siete Campeones,";
    text[8821] = "... toda la humanidad habría perecido.";
    text[8822] = "Nuestra historia comienza 1000 años después.";
    text[8823] = "La humanidad sigue prosperando en Luna, ahora terraformada.";
    text[8824] = "Aunque vivimos en una época en la que la ciencia y la tecnología brillan con luz propia,";
    text[8825] = "...los recursos que ofrece Luna son limitados.";
    text[8826] = "Un día... Nos quedaremos sin recursos...";
    text[8827] = "Un día... No tendremos más opción que encontrar un nuevo hogar.";
    text[8829] = "La experiencia que la humanidad vivió con ASTRA y la llegada del cometa Coda nos recuerdan...";
    text[8830] = "... que la humanidad posee la determinación y la resiliencia para sobrevivir,";
    text[8831] = "sea cual sea la situación a la que se enfrente.";
    text[8832] = "Y que debemos centrarnos...";
    text[8833] = "... en evolucionar más allá de nuestras limitaciones.";
    text[8834] = "El objetivo de mi vida será garantizar que la humanidad tenga un futuro brillante.";
    text[8835] = "Y no descansaré hasta entonces.\nSaros.";
    text[8836] = "¿Qué hace una niñata de la Fuerza Lunex como tú por aquí?";
    text[8837] = "He escuchado que hay un mercado negro en esta zona.";
    text[8838] = "Me gustaría echarle un vistazo.";
    text[8839] = "¿Qué estás planeando? ¿Vas a decírmelo?";
    text[8840] = "Nada. Solo soy una posible cliente.";
    text[8841] = "Muy bien, de acuerdo...";
    text[8842] = "Pero no pienso quitarte el ojo de encima, niñata.";
    text[8843] = "Oye, ¿te interesaría echarle el guante a unos artículos realmente exóticos?";
    text[8844] = "Ve al portal que hay en la parte sur de esta mina.";
    text[8845] = "Mis hermanos y yo dirigimos el mercado negro que hay allí.";
    text[8846] = "¡Te venderán algunos artículos que no podrás encontrar en ningún otro lugar! Je, je.";
    text[8847] = "Mis hermanos y yo...";
    text[8848] = "Solíamos trabajar en el Equipo de Desarrollo de Armas de la Fuerza Lunex.";
    text[8849] = "Yo me encargaba desarrollar poderosos chips de mejora.";
    text[8850] = "Un día, descubrí el auténtico potencial de mis talentos...";
    text[8851] = "y dejé el trabajo para crear mi propio negocio en los bajos fondos.";
    text[8852] = "He tenido mucho más éxito con este negocio del mercado negro";
    text[8853] = "del que jamás tuve con ese apestoso trabajo para el gobierno.";
    text[8854] = "¿Te das cuenta de que acabas de confesar que estás trabajando con criminales, ¿verdad?";
    text[8855] = "No me importa. Hay muchos criminales pululando por aquí.";
    text[8856] = "Este es su territorio. Yo tendría mucho cuidado si fuera vosotros.";
    text[8860] = "Sea como fuere...";
    text[8857] = "No podrás encontrar mis chips de mejora en ningún otro lugar.";
    text[8858] = "Si quieres ser más poderosa que nunca,";
    text[8859] = "te sugiero que compres mis productos, je, je, je.";
    text[8861] = "Eh, tengo algo de información que podría serte muy útil.";
    text[8862] = "¿Oh, en serio? ¿De qué se trata?";
    text[8863] = "¿Estás de broma?";
    text[8864] = "No pienso decírtela gratis.";
    text[8865] = "Aaah, ¿Por qué no me sorprende?";
    text[8866] = "Entrégame 100 puntos de habilidad y la información que tengo será tuya...";
    text[8867] = "¿Tenemos un trato?";
    text[8868] = "Qué pena...";
    text[8869] = "¡Genial! ¡Gracias por los puntos de habilidad!";
    text[8870] = "Esto es lo que sé: 102198.";
    text[8871] = "El conocimiento es poder. Usa esta información sabiamente.";
    text[8875] = "Eh, no tienes los puntos de habilidad necesarios...";
    text[8872] = "¿Cómo? ¿Quieres saber cómo abrir la puerta láser que hay detrás de nosotros?";
    text[8873] = "Lo siento, sé tanto como tú, colega.";
    text[8874] = "Solo sé... que algunas personas con una pinta terrorífica salen y entran de ella.";
    text[8876] = "Las habilidades de apoyo rojas son poderosas... pero tienen sus limitaciones.";
    text[8877] = "Solo se pueden equipar 3 habilidades de apoyo a la vez...";
    text[8878] = "... a no ser...";
    text[8879] = "... ¡que se tenga el CHIP DE MEJORA LEGENDARIO!";
    text[8880] = "¡Este chip de mejora permite equipar 5 habilidades de apoyo rojas!";
    text[8881] = "... y será tuyo con una condición...";
    text[8882] = "Compra TODO lo que vendan mis hermanos...";
    text[8883] = "Y te llevarás el CHIP DE MEJORA LEGENDARIO gratis.";
    text[8884] = "Veo que has comprado todo lo que mis hermanos tenían disponible.";
    text[8885] = "Eres oficialmente la cliente número uno del mercado negro, je, je.";
    text[8886] = "¡Este regalo es de nuestra parte!";
    text[8887] = "Ha sido un placer hacer negocios contigo, Bella.";
    text[8888] = "Mi lema favorito es: ¡Trabaja duro y come a menudo!";
    text[8889] = "Toma, ¡esto es para ti!";
    text[8890] = "¿Dime, cuál es tu tentempié favorito?";
    text[8891] = "¡Las barritas de tarta de queso, por supuesto!";
    text[8892] = "¡AHHHHHH! ¡También es el mío!";
    text[8893] = "Dato curioso: también soy un programador a tiempo parcial.";
    text[8894] = "¡Aquí tienes una ciberbarra de queso para tu compañera robot!";
    text[8895] = "¿¡CÓMO?! ESTA CIBERBARRA DE QUESO ES...";
    text[8896] = "¡DIGITALMENTE DELICIOSA!";
    text[8897] = "Ya es tarde ahí fuera, así que tómatelo con calma, ¿vale?";
    text[8898] = "No conseguirás nada bueno si trabajas sin haber descansado lo suficiente.";
    text[8899] = "Así que quédate aquí y relájate todo lo que necesites hasta volver a sentirte como nueva, ¿de acuerdo?";
    text[8900] = "Nada relaja el alma como una taza fresca de café lunar.";
    text[8901] = "¡Eh, criatura maravillosa! ¿Lo recuerdas?";
    text[8902] = "¿Recordar qué?";
    text[8903] = "No puedo recordar...";
    text[8904] = "(Irse)";
    text[8905] = "Veo que lo has olvidado. ¡Pero no te preocupes, yo nunca olvido!";
    text[8906] = "Antes del final recordarás quién eres realmente.";
    text[8907] = "Tus recuerdos te llevarán a alturas aún mayores.";
    text[8908] = "¡Así que deja que sean tu fortaleza y te guíen!";
    text[8909] = "... y recuerda siempre que nunca debes olvidar.";
    text[8910] = "No lo haré.";
    text[8911] = "Es posible que tú hayas olvidado, pero yo lo recordaré.";
    text[8912] = "Nos veremos, camarada.";
    text[8913] = "¡La siguiente canción está dedicada a Jack y a Martha!";
    text[8914] = "Para abrir esta puerta se necesita una llave especial...";
    text[8915] = "¡Has usado la llave de la mina para abrir la puerta!";
    text[8916] = "Título secreto";
    text[8917] = "Entusiasta\ndel Rock";
    text[8918] = "Buceadora\ny Basurera";
    text[8919] = "Colega de\nBuddy";
    text[8920] = "Coleccionista\n de Peluches";
    text[8921] = "Reina de\nlas Gominolas";
    text[8922] = "¡Justo \na Tiempo!";
    text[8923] = "Descifradora\nde Códigos";
    text[8924] = "Velocista\nMaestra";
    text[8925] = "Velocista\nNovel";
    text[8926] = "¡Exploradora\nLunar!";
    text[8927] = "¡Tienes más de\n1000!";
    text[8933] = "¡Bonjour! Veamos cuánto has tardado en dar conmigo...";
    text[8928] = "Has tardado POCO en llegar hasta mí.";
    text[8929] = "Demasiado poco...";
    text[8930] = "Supongo que o eres capaz de viajar en el tiempo o se te da bien descifrar códigos.";
    text[8931] = "Sea como fuere, ¡enhorabuena por dar conmigo en tan poco tiempo!";
    text[8932] = "¡Este es el mejor título que puedo otorgarte!";
    text[8934] = "¡Incroyable! ¡Has conseguido llegar hasta mí en menos de 3 horas!";
    text[8935] = "¡Te entregaré el título de Velocista Maestra!";
    text[8936] = "¡Impressionnante! ¡Has conseguido llegar hasta mí en menos de 8 horas!";
    text[8937] = "¡Te otorgaré el título de Velocista Novel!";
    text[8938] = "¡Interessante! Veo que te gusta tomarte tu tiempo...";
    text[8939] = "... y saborear cada momento...";
    text[8940] = "... mientras te sumerges en este hermoso mundo...";
    text[8941] = "¡Una persona como tú merece el honorable título de Exploradora Lunar!";
    text[8942] = "Tal vez habrías recibido otro título en otra línea temporal...";
    text[8943] = "¿Quién sabe? Depende de cuánto tiempo tardes en llegar hasta mí.";
    text[8944] = "¡Adieu!";
    text[8945] = "Este reloj de arena es muy extraño. Decides darle la vuelta...";
    text[8946] = "¡Me has encontrado justo a tiempo!";
    text[8947] = "¿Qué hace un científico como tú aquí, en las minas de Silica?";
    text[8948] = "¡Estoy llevando a cabo una investigación para realizar viajes en el tiempo!";
    text[8949] = "Me he construido un laboratorio secreto en los túneles abandonados de estas minas.";
    text[8950] = "¿Crees que esto podría ser nuestro secreto?";
    text[8951] = "¡Nuestros labios están sellados!";
    text[8952] = "Entonces, ¿has conseguido fabricar una máquina del tiempo?";
    text[8953] = "Todavía estoy en ello.";
    text[8954] = "¡Estoy modificando un DeLorean con un condensador de fluzo!";
    text[8955] = "¡Cómo mola!";
    text[8956] = "¡Gracias! ¡Vuestro futuro depende de vosotros mismos! ¡Labraos uno que valga la pena!";
    text[8958] = "Qué cara tiene este tío...";
    text[8959] = "¿Cómo ha podido traicionarme después de todo lo que hemos pasado...?";
    text[8966] = "(Parece demasiado distraída para darse cuenta de que estamos aquí.)";
    text[8979] = "(Tal vez deberíamos dejarla sola.)";
    text[8960] = "¿Puedo ayudarte?";
    text[8961] = "Oh... Mmm...";
    text[8962] = "¿Habéis venido a frustrar mis planes?";
    text[8963] = "¿Acaso podéis serme útiles?";
    text[8964] = "Eeeh... ¿No?";
    text[8965] = "Entonces fuera de mi camino.";
    text[8967] = "No tengo tiempo ni recursos que gastar en vosotros.";
    text[8968] = "Necesito centrarme y elaborar un plan...";
    text[8969] = "He escuchado que acabasteis con Kerberos, el líder de los bandidos.";
    text[8977] = "Nunca fui lo suficientemente fuerte para derrotarle por mi cuenta...";
    text[8978] = "Así que gracias por hacerme el favor de quitármelo de en medio.";
    text[8970] = "Solía ser una importante capitana en su escuadrón.";
    text[8971] = "Formábamos un gran equipo. Todo iba bien hasta que...";
    text[8972] = "Me traicionó y me expulsó de la organización.";
    text[8973] = "Me alegro de que esté fuera de juego.";
    text[8974] = "Ese traidor tuvo lo que se merecía.";
    text[8975] = "... Creo que es ya hora de que pase página respecto a este asunto.";
    text[8976] = "Cuídate ahí fuera, guerrera.";
    text[8980] = "Vaya, ¡tu traje es realmente bonito!";
    text[8981] = "Gracias, lo hice con mis propias manos.";
    text[8982] = "En realidad es una mezcla de dos de mis series favoritas:";
    text[8983] = "¡Sailor Luna y Magic Cure!";
    text[8984] = "También hago vídeos en línea, je, je.";
    text[8985] = "Cuando no estoy trabajando en nuevos trajes,";
    text[8986] = "¡me paso el tiempo retransmitiendo partidas de videojuegos!";
    text[8987] = "Qué fastidio... Los lóbregos decidieron atacar la ciudad en mi día libre.";
    text[8988] = "Colega, necesito un trago.";
    text[8989] = "Parece que todo vuelve a funcionar en la ciudad,";
    text[8990] = "Creo que voy a relajarme en el café lo que queda del día.";
    text[8991] = "¡Hola! ¡Soy Dashie, la ciberconejita!";
    text[8992] = "... ¡y yo soy Tetra, la ciberayudante! Je, je.";
    text[8993] = "¡Es un placer conocerte, Dashie!";
    text[8994] = "¿A qué te dedicas?";
    text[8995] = "¡Llevo una librería de código abierto que gestiona matrices y vectores!";
    text[8996] = "Ooh, ¡creo que sé una cosa o dos sobre matrices!";
    text[8997] = "Yo, eh... En realidad no sé casi nada de programación, así que...";
    text[8998] = "¡Os dejaré hablar a las dos mientras echo un vistazo por la tiendaI!";
    text[8999] = "¡Chupi dupi!";
    text[9000] = "¡Hola! ¡Puedes llamarme MiDi!";
    text[9001] = "¡Soy la mejor roboconejita DJ de esta ciudad!";
    text[9002] = "¡Aquí tienes una demostración de mi próximo álbum!";
    text[9003] = "¡Vamos, a bailar!";
    text[9004] = "Las gafas son un reflejo de su usuario.";
    text[9005] = "¿Cómo es la estructura? ¿Y los cristales? ¿Cómo las empujas hacia arriba cuando se caen?";
    text[9006] = "Todos son fragmentos de un alma que se han ensamblado cuidadosamente para llevarlos en la cara,";
    text[9007] = "como si fuera una máscara transparente.";
    text[9008] = "Tenéis...";
    text[9009] = "¿Qué opináis de las gafas?";
    text[9010] = "¡Las gafas molan!";
    text[9014] = "... ¡y además, son muy elegantes!";
    text[9011] = "... ¡¡!!";
    text[9012] = "¡Brillante!";
    text[9013] = "¡Veo que a vosotras dos también os gustan los anteojos!";
    text[9015] = "Hola, soy Xiu.";
    text[9016] = "Soy un diseñador de armas de la división 7.";
    text[9017] = "Mis diseños impresionaron tanto al general Saros que me transfirió";
    text[9018] = "a este centro para que pudiera ayudarle a desarrollar nuevas armas para cazar lóbregos.";
    text[9019] = "Esta hoja en la que estoy trabajando es un prototipo de holocuchilla.";
    text[9020] = "Teóricamente, debería ser capaz de atravesar a un lóbrego";
    text[9021] = "sin dañar su antinúcleo.";
    text[9022] = "¡Gracias a esto, será mucho más fácil extraer los antinúcleos!";
    text[9023] = "Eh, ¿qué estás haciendo vagueando por aquí?";
    text[9024] = "¡Haz algo útil y vuelve a tu puesto de guardia!";
    text[9025] = "Este guardia siempre se comporta con mucha seriedad.";
    text[9026] = "Te contempla con unos ojos fríos que no pestañean...";
    text[9027] = "Eh, ¡te he visto en la tele!";
    text[9028] = "¿Tú no eres Dycee, de la serie para niños El laboratorio del manitas?";
    text[9029] = "¡Sí, soy yo! Es un placer conocerte.";
    text[9030] = "¿De qué va El laboratorio del manitas?";
    text[9031] = "Bueno, ¡el objetivo del programa es enseñar a los niños y animarles a";
    text[9032] = "emocionarse con la ciencia y la tecnología!";
    text[9033] = "En el programa, Dycee y Peb, su grimrock bebé,";
    text[9034] = "trabajan juntos para crear el «Cubo de Dycee».";
    text[9035] = "Lo más curioso es que cada forma del Cubo de Dycee";
    text[9036] = "nunca se acaba pareciendo a un cubo.";
    text[9037] = "¡Eso es cierto! Primero es una pirámide, luego es un prisma octogonal,";
    text[9038] = "y luego es una especie de monstruosidad en 4D...";
    text[9039] = "Por último, cuando el programa termina grito:";
    text[9040] = "«¡PERO QUÉ DIFÍCIL ES HACER UN CUBO!»'";
    text[9041] = "Veo que el programa te encanta.";
    text[9042] = "¡Vaya que sí! Solía verlo con mi madre cada sábado cuando era más joven.";
    text[9043] = "Has mencionado un grimrock bebé... ¿Era un lóbrego de verdad?";
    text[9044] = "No, no. ¡Peb solo es una marioneta!";
    text[9045] = "Siempre me han fascinado los grimrocks y el aspecto que tienen...";
    text[9046] = "Y al final fueron los que me dieron la inspiración para crear a mi ayudante,";
    text[9047] = "Peb, ¡el grimrock bebé!";
    text[9048] = "He escuchado que algunas personas han visto a grimrocks de colores diferentes ahí fuera.";
    text[9049] = "Me encantaría ver uno algún día...";
    text[9050] = "¡Nosotras hemos visto algunos grimrocks de colores diferentes!";
    text[9051] = "Ven, echa un vistazo a nuestra BASE DE DATOS...";
    text[9052] = "¡Fascinante! Un grimrock EX...";
    text[9053] = "No es tan solo una variante de color diferente,";
    text[9054] = "¡también es más rápido y fuerte que los grimrocks originales!";
    text[9055] = "¡Muchas gracias por mostrarme esto!";
    text[9056] = "¿Sabes una cosa?";
    text[9057] = "Eres una robot adorable, Tetra.";
    text[9058] = "¡Me gustaría que vinieras a mi programa como invitada algún día!";
    text[9059] = "¿Y-yo? ¡¿En un programa de la tele?!";
    text[9060] = "¡SÍ, POR FAVOR! ¡ME ENCANTARÍA!";
    text[9061] = "¿Has hablado con ese caballero tan raro que hay delante de mí? ¿Ese que parece Papá Noel?";
    text[9062] = "Parece que también es el líder de una secta que cree que los zombis están tratando";
    text[9063] = "de devorar el sol... y la mejor manera de evitar que esto ocurra...";
    text[9064] = "... es conseguir una abundante cantidad de sierras mecánicas.";
    text[9065] = "¡¿CÓMO?! ¡Eso es ridículo! ¡No hay NINGUNA prueba de eso...!";
    text[9066] = "Lo sé, ¿verdad? Eh, je, je... (Oculta inmediatamente su chapa de miembro de la secta.)";
    text[9069] = "Puedo sentirlo... Hay fuerzas más allá de mi comprensión...";
    text[9070] = "... que evitan que pueda usar cualquier baño que tenga cerca.";
    text[9071] = "¿Cómo puede un pobre mortal como yo escapar a este cruel destino?";
    text[9072] = "¿Por qué no usas el baño que tienes en casa?";
    text[9073] = "Es la hora punta... hay tanto tráfico que tardaría 4 horas en llegar a casa...";
    text[9074] = "Me limitaré a esperar...";
    text[9075] = "La comida que hay aquí...";
    text[9076] = "Está deliciosa...";
    text[9077] = "... pero no está tan buena como la comida que ofrezco en mi gastroneta.";
    text[9078] = "¿Cuál es tu plato distintivo?";
    text[9079] = "Se llama Pedazo.";
    text[9080] = "¡Si le das un bocado a un Pedazo, te sentirás capaz de acabar";
    text[9081] = "con un ejército de zombis con un solo dedo!";
    text[9082] = "¿Pero qué es un Pedazo? ¿Es un postre? ¿Es salado?";
    text[9083] = "Un Pedazo...";
    text[9084] = "...es simplemente un Pedazo.";
    text[9085] = "...";
    text[9219] = "Como médico jefe de este sector,";
    text[9220] = "mi trabajo consiste en atender a los heridos... y siempre hay muchos.";
    text[9221] = "Hace diez años que luchamos contra los lóbregos...";
    text[9222] = "¿Y si nuestra situación nunca cambia?";
    text[9223] = "¿Y si a pesar de nuestros esfuerzos por sobrevivir";
    text[9224] = "los lóbregos siguen viniendo hasta que todos estemos muertos?";
    text[9091] = "Dime... ¿Qué opinas de los lóbregos?";
    text[9092] = "Bueno, no veo a los lóbregos como monstruos descerebrados.";
    text[9093] = "Personalmente, no me gusta tener que hacer daño a esas";
    text[9094] = "criaturas para cumplir con mi deber de proteger a la gente.";
    text[9095] = "También sé que la mayor parte de la gente no ve las cosas como yo.";
    text[9096] = "Desde el punto de vista de los civiles...";
    text[9097] = "Los lóbregos han matado a sus amigos y familiares...";
    text[9098] = "A sus ojos... Los lóbregos son monstruos que no merecen ninguna compasión.";
    text[9107] = "... Y, por otro lado, estoy yo...";
    text[9108] = "... una soldado que quiere encontrar una manera de comunicarse";
    text[9109] = "con los lóbregos para encontrar una solución pacífica...";
    text[9110] = "... una solución en la que nadie tenga que morir...";
    text[9101] = "¿Conoces a alguien que piense igual que tú?";
    text[9102] = "Sí, mi madre pensaba como yo.";
    text[9103] = "Ya veo...";
    text[9225] = "No crees que sea posible, ¿verdad?";
    text[9226] = "Creo que tendrías más suerte si trataras de hablar con el sol.";
    text[9227] = "Los lóbregos están hechos de antimateria...";
    text[9228] = "Son básicamente lo opuesto a los seres humanos.";
    text[9114] = "No creo que los lóbregos sean incapaces de pensar...";
    text[9115] = "... pero también me pregunto qué se podría sacar de comunicarse con";
    text[9116] = "criaturas que son tan distintas de nosotros.";
    text[9117] = "No importa lo cercanos que podamos estar, o la conexión que pueda existir entre nosotros";
    text[9118] = "hay cosas que siempre serán irreconciliables...";
    text[9229] = "Lo que dices es justo, y aunque no estoy de acuerdo,";
    text[9230] = "acepto y comprendo tu punto de vista.";
    text[9231] = "No quiero que pienses que no valoro tu opinión.";
    text[9232] = "No es eso. Me alegro de que tengamos esta conversación.";
    text[9233] = "Solo quiero hacer las paces con los lóbregos, de veras.";
    text[9234] = "Es solo...";
    text[9235] = "Que son enormemente diferentes de nosotros...";
    text[9236] = "No sé si llegaremos a conseguir un entendimiento mutuo.";
    text[9119] = "Vaya, ¡tu armadura de combate es una auténtica pasada!";
    text[9120] = "¡Gracias!";
    text[9125] = "He estado trabajando en varios diseños de nuevas armaduras que llevan integrada";
    text[9126] = "tecnología de ondas EM de última generación.";
    text[9127] = "¡Esta tecnología nos permitiría materializar nuestras armaduras solo con pensarlo!";
    text[9128] = "También debería darnos un aumento bastante prometedor en velocidad y energía.";
    text[9130] = "¡Podríais cargar arrasando por el campo de batalla!!";
    text[9129] = "¿Tienes un nombre para la armadura que estás llevando?";
    text[9122] = "¡A esta armadura de combate la llamo Fuerza Estelar!";
    text[9123] = "¡A esta armadura de combate la llamo Electrocañón!";
    text[9124] = "¡A esta armadura de combate la llamo Zero!";
    text[9131] = "¡Ah, hola! ¡No os preocupéis por mí!";
    text[9132] = "Solo estoy esperando a que el doctor vuelva con los resultados de mis pruebas...";
    text[9145] = "Pregunta rápida...";
    text[9133] = "¿Has tenido visiones o sueños de algo que parezcan vidas anteriores,";
    text[9134] = "ancestros o hechos que podrían haber ocurrido?";
    text[9135] = "Una vez tuve un sueño en el que cumplía una función muy importante en una gran compañía...";
    text[9136] = "... ¡y todas las personas eran cavernícolas!";
    text[9137] = "Mi tátara-tátara-tátara-tátara-abuelo";
    text[9138] = "debió hacer algo muy malo.";
    text[9139] = "¡Sus empleados lo cubrieron de cemento para castigarle!";
    text[9140] = "¡El poder para el pueblo! Has tenido un sueño realmente vívido.";
    text[9141] = "Bueno, al menos ahora mismo estás viviendo en el presente, y no haciendo...";
    text[9142] = "lo que hacías en sueños... fuera lo que fuese.";
    text[9143] = "Sí... De todas formas, gracias por tomarte un tiempo para parar a charlar conmigo.";
    text[9144] = "¡Cuídate!";
    text[9146] = "Eh, es estupendo verte de nuevo.";
    text[9147] = "¿Cómo te sientes?";
    text[9148] = "Mmm... Me siento un poco mejor, porque espero compañía.";
    text[9149] = "Mis amigos pronto pasarán por aquí.";
    text[9150] = "¡Vamos a ver la nueva película de la Compañía Catástrofe juntos!";
    text[9151] = "¡Espero que sea buena!";
    text[9152] = "¡Qué va! ¡Es terrible!";
    text[9153] = "El estudio no tenía ni idea de qué hacer con ella.";
    text[9154] = "¡Pero vamos a pasárnoslo muy bien porque nos reiremos juntos!";
    text[9155] = "¡Parece de las películas que me gustan! Je, je, je.";
    text[9156] = "Eh...";
    text[9157] = "Hola, Cooper...";
    text[9158] = "¡Espero que te lo pasaras muy bien con tus amigos!";
    text[9159] = "Sí, así fue, gracias...";
    text[9160] = "Fue un regalo maravilloso...";
    text[9161] = "Lo atesoraré... para siempre...";
    text[9162] = "...";
    text[9163] = "Bella... El tiempo es algo muy valioso.";
    text[9164] = "El tiempo es una bendición.";
    text[9165] = "Usa el tiempo que tienes sabiamente,";
    text[9166] = "y pásalo con tus amigos y tus seres queridos... antes de que se agote.";
    text[9167] = "Y no tengas miedo de concederte algún regalo de vez en cuando.";
    text[9168] = "Solo... deja que ocurra.";
    text[9169] = "Las malas noticias son que he muerto...";
    text[9170] = "... pero las buenas son que ahora estoy en un plano superior de existencia, dentro";
    text[9171] = "de los corazones y las mentes de aquellos a los que amé.";
    text[9172] = "Tal vez un día vuelva para servir de inspiración a alguien.";
    text[9173] = "He disfrutado mucho de tu compañía, Bella.";
    text[9174] = "Gracias por pasar tu valioso tiempo conmigo.";
    text[9175] = "P.D.: Si en tus viajes te ves tentada a probar algo llamado «especia»...";
    text[9176] = "... Por favor, no lo hagas.";
    text[9241] = "Alguien nuevo. 0x77686";
    text[9242] = "¿Qué es esto?";
    text[9243] = "Soy... O creo que soy...";
    text[9244] = "Es un antiguo ordenador.";
    text[9245] = "Debo haber estado perdido aquí mucho tiempo.";
    text[9246] = "Puedes llamarme James King. 0xF6973";
    text[9247] = "Vale... Por favor, dime que no me estoy volviendo tarumba...";
    text[9249] = "He estado escuchando una voz extraña desde que entramos en esta habitación...";
    text[9250] = "¿Dónde estás? ¡Muéstrate!";
    text[9251] = "Estoy justo delante de ti. 0x66726";
    text[9178] = "¿¡Dentro del ordenador?!";
    text[9252] = "¡Eso es imposible!";
    text[9253] = "Ahora lo recuerdo. 0x9656E";
    text[9254] = "Me dedicaba a realizar transmisiones en el Cibermundo...";
    text[9255] = "Trabajaba y entraba en el Cibermundo... 0x646F7";
    text[9256] = "...pero quedé encerrado y se olvidaron de mí. 0x2666F";
    text[9248] = "Es terrible...";
    text[9180] = "Necesito salir.";
    text[9181] = "Necesito... ser libre. 0x653F";
    text[9182] = "(Aquí hay algo que no encaja... pero deberíamos ayudar...)";
    text[9183] = "Tetra, ¿puedes introducirte en el Cibermundo y ayudar a liberar a James?";
    text[9184] = "¡Por supuesto! ¡Me pondré a ello!";
    text[9186] = "¿Te gustaría entrar en el Cibermundo?";
    text[9187] = "JAMES: NECIAS. ¡Ahora estáis en mi poder!!";
    text[9188] = "JAMES: ¡Primero destrozaré vuestros cuerpos!";
    text[9189] = "BELLA: Tetra, ¿has encontrado a James?";
    text[9202] = "JAMES: ... ¡Y luego vuestras MENTES!";
    text[9190] = "TETRA: Eso parece...";
    text[9191] = "JAMES: Pronto aprenderéis a aceptar la LOCURA.";
    text[9192] = "¡Al igual que yo!";
    text[9265] = "TETRA: Este tipo...";
    text[9259] = "TETRA: ¡NO HACE MÁS QUE INTERRUMPIRME!!";
    text[9193] = "TETRA: Bien, ¿por dónde iba...?";
    text[9257] = "Tetra: ¡Parece que está infectado con un virus!";
    text[9260] = "BELLA: ¿Hay alguna manera de salvarlo?";
    text[9261] = "TETRA: ¡Mi Cañón Tetra debería ser capaz de";
    text[9262] = "neutralizar el virus!";
    text[9264] = "¡Tengo que luchar con él!";
    text[9263] = "BELLA: ¡Muy bien, pero ten cuidado! ¡Puedes hacerlo, Tetra!";
    text[9194] = "Gracias por salvarme, Bella.";
    text[9195] = "Te pido disculpas por haberte atacado...";
    text[9196] = "Llevaba demasiado tiempo en el Cibermundo...";
    text[9197] = "... y me perdí.";
    text[9198] = "Por favor, no cometas el mismo error que yo.";
    text[9199] = "Ten mucho cuidado.";
    text[9201] = "No hay respuesta...";
    text[9203] = "¡Veo a una guerrera!";
    text[9204] = "... ¡Y eso quiere decir que eres una cliente en potencia!";
    text[9205] = "¿Qué es lo que vendes?";
    text[9206] = "El mejor amigo de cualquier guerrero... ¡REFUERZOS DE HABILIDAD!";
    text[9207] = "Para alcanzar el 100% de dominio de habilidades,";
    text[9208] = "tienes que alcanzar el nivel máximo en TODAS tus habilidades activas.";
    text[9209] = "¡Y para poder hacerlo, necesitarás REFUERZOS DE HABILIDAD!";
    text[9210] = "¡Deja que te ayude a convertirte en la guerrera definitiva!";
    text[9211] = "Aunque ya no me quedan refuerzos de habilidad en este lugar,";
    text[9212] = "¡Tengo empleados en otras nueve ubicaciones!";
    text[9213] = "A algunos de ellos les gusta establecerse en lugares que nunca imaginarías...";
    text[9214] = "¡Buena suerte a la hora de encontrarlos!";
    text[9215] = "Sé exactamente qué estás buscando: ¡REFUERZOS DE HABILIDAD!";
    text[9216] = "¡Buena suerte en tu viaje hasta el 100% de dominio de habilidades!";
    text[9217] = "¿Tienes la «mercancía»?";
    text[9218] = "Tengo la mercancía.";
    text[9266] = "¡Puedes encontrar un total de 5 EVENTOS PORTAFORTUNA!";
    text[9267] = "¡Mantén los ojos abiertos para encontrar las estrellas fugaces que cruzan el cielo!";
    text[9268] = "¡Has conseguido el peluche de Ashe el Fénix!";
    text[9269] = "¡Estás empezando a convertirte en toda una coleccionista!";
    text[9270] = "Teniendo en cuenta el tamaño de tu habitación, diría que serías capaz de exhibir";
    text[9271] = "hasta 12 peluches coleccionables diferentes en total.";
    text[9272] = "Eso incluye el Axsoul, el Kame y el Metill que me diste antes, ¿verdad?";
    text[9273] = "¡Sí!";
    text[9274] = "¡Por fin ha llegado el nuevo peluche que encargué!";
    text[9275] = "Déjame que lo adivine...";
    text[9276] = "¿También tienes uno para mí?";
    text[9277] = "Ambas sabemos que ya se ha convertido en una tradición, je, je.";
    text[9278] = "¡Me encanta recibir regalos de mis amigos!";
    text[9279] = "¡Aquí tienes!";
    text[9280] = "Sé muy bien lo peligroso que puede ser juguetear con algo tan volátil,";
    text[9281] = "como la antimateria y los agujeros de gusano...";
    text[9282] = "Mi marido... Fue uno de los científicos que murió cuando la prueba con Celestia salió mal...";
    text[9283] = "Lamento mucho su pérdida, Srta. Nyla...";
    text[9284] = "No pasa nada, querida...";
    text[9285] = "Tras años de terapia...";
    text[9286] = "He conseguido reunir el coraje necesario para pasar página y aceptar la tragedia que tuvo lugar.";
    text[9287] = "Pero cuando me enteré de que tu padre quería reactivar el proyecto...";
    text[9288] = "Tuve mis dudas inicialmente... Tenía miedo de perder a otra persona que me importaba...";
    text[9289] = "Pero... Creo que debería adoptar una actitud más positiva a la hora de enfrentarme a esto.";
    text[9290] = "Prudente... pero positiva.";
    text[9291] = "Esta vez me aseguraré de que todo se haga cuidadosamente... y adecuadamente.";
    text[9292] = "¡Sin dejar margen alguno para el error!";
    text[9293] = "Conseguir un antisuero y terminar Celestia en menos de un año";
    text[9294] = "será todo un logro... Mueh...";
    text[9295] = "Eh, ¡sé que podéis conseguirlo!";
    text[9296] = "¡No hay ningún problema que el Equipo Científico de la Estación Espacial Lunex no pueda resolver!";
    text[9297] = "Además, Nyla y mi padre te estarán ayudando.";
    text[9298] = "¿Cómo van el desarrollo del antisuero?";
    text[9299] = "Todavía no hemos progresado mucho...";
    text[9300] = "En este momento, nuestros especialistas están extrayendo toda la información que pueden";
    text[9301] = "de los servidores secretos de Saros.";
    text[9302] = "Un buen científico siempre mantiene registros detallados de sus experimentos.";
    text[9303] = "Esperemos que sus registros tengan la información que necesitamos...";
    text[9305] = "¡Cuando me ofrecieron este empleo, nunca pensé que estaría trabajando";
    text[9306] = "en una tecnología tan aterradora y fascinante como Celestia!";
    text[9307] = "... y nunca esperé que tendríamos que enfrentarnos a un cometa como Coda, capaz de destruir mundos,...";
    text[9308] = "Ahh... No hay nada como una refrescante taza de café para mantener la mente estimulada.";
    text[9309] = "Papá... Tu tolerancia a la cafeína es tan alta porque consumes demasiado café.";
    text[9310] = "¿Tal vez deberías empezar a reducir tu consumo?";
    text[9311] = "No puedo... Si lo hago sufro dolores de cabeza de proporciones astronómicas...";
    text[9312] = "... y no puedo permitirme eso mientras estoy trabajando en la máquina de agujeros de gusano...";
    text[9313] = "De acuerdo, vale... Pero por favor, tómate algún descanso de vez en cuando, ¿de acuerdo?";
    text[9314] = "¡De hecho, eso es lo que estoy haciendo ahora mismo!";
    text[9315] = "En este momento mi rutina es: 23 horas de trabajo y 1 hora de descanso para el café, je.";
    text[9316] = "¡¿Y LAS HORAS DE SUEÑO?!";
    text[9317] = "¡¿Y LA COMIDA?!";
    text[9318] = "Eh, ¡os estoy tomando el pelo!";
    text[9319] = "(... o tal vez no...)";
    text[9320] = "(¡Tengo que hacer todo lo que pueda para proteger a mi familia y salvar a la humanidad!...)";
    text[9321] = "Papá, has estado atrapado en la Zona Fantasma durante mucho tiempo...";
    text[9322] = "Deberías relajarte y descansar durante un par de días.";
    text[9323] = "Después de todo lo que ha pasado,";
    text[9324] = "Creo que todos nos merecemos un buen descanso antes de volver al trabajo.";
    text[9325] = "¡Vas a ser una mujer muy ocupada!";
    text[9326] = "¿Qué quieres decir?";
    text[9327] = "La gente de Luna nos ha enviado miles de correos electrónicos";
    text[9328] = "desde que detuvimos a Saros y revelamos al mundo la verdad sobre los lóbregos.";
    text[9329] = "¡Una cantidad sobrecogedora de gente han mostrado";
    text[9330] = "estar de acuerdo en nombrarte su nuevo general!";
    text[9331] = "Tu madre y yo... estamos muy orgullosos de ti.";
    text[9332] = "¡Siempre has estado destinada...";
    text[9333] = "... a dirigir a la gente de Luna hacia un futuro lleno de esperanza!";
    text[9335] = "Papá...";
    text[9336] = "Tu apoyo lo es todo para mí.";
    text[9337] = "¡Prometo ser una líder en la que la gente pueda confiar!";
    text[9338] = "Pero...";
    text[9339] = "No podré hacer esto sola...";
    text[9340] = "¡Un buen líder debe tener un equipo fuerte!";
    text[9341] = "Nickle, ¿te gustaría ser mi comandante?";
    text[9342] = "¿Y-yo? ¡¿Comandante de la Fuerza Lunex?!";
    text[9343] = "No solo un comandante, sino un compañero en el que pueda confiar.";
    text[9344] = "Si vamos a salvar a la gente que se ha convertido en lóbregos,";
    text[9345] = "y detener al cometa Coda, necesitaré tu apoyo.";
    text[9346] = "Yo...";
    text[9347] = "¡Sería un honor!";
    text[9348] = "Entonces no hay nada más hablar, ¡ja, ja, ja!";
    text[9349] = "Escucha, Nickle...";
    text[9350] = "Tengo que hacerte una pregunta muy importante...";
    text[9351] = "... ¿De qué se trata, doctor Thomas?";
    text[9352] = "¿¡Te gusta el café?!";
    text[9353] = "¡POR FAVOR, DI QUE SÍ!";
    text[9354] = "¡De hecho, sí, me gusta el café!";
    text[9355] = "¡PERFECTO!";
    text[9356] = "¿Por qué no nos pedimos una taza de café en la cafetería,";
    text[9357] = "y tenemos una agradable conversación?";
    text[9358] = "¡C-claro!";
    text[9359] = "¡No te pongas nervioso!";
    text[9360] = "¡Mi papá siempre trata de conocer a los nuevos miembros de mi equipo!";
    text[9361] = "¡Pasado bien!";
    text[9362] = "¡Es el panel de anuncios de Lunex!";
    text[9363] = "¡Es el panel de anuncios de Copernicus!";
    text[9364] = "Emmet";
    text[9365] = "Club de astrónomos";
    text[9366] = "¡Saludos, camaradas astrónomos!";
    text[9367] = "¡Soy Emmet, y estoy aquí para indicaros cuáles son los mejores puntos para ver las estrellas!";
    text[9368] = "¡Coged vuestros binoculares y poned rumbo a Tycho!";
    text[9389] = "Chad";
    text[9390] = "¿Y el idiota soy yo?";
    text[9391] = "Mi novia y yo tuvimos una cita el otro día...";
    text[9392] = "... esta publicación tiene unos diecisiete párrafos.";
    text[9393] = "Decides no leerla.";
    text[9394] = "Moderador";
    text[9395] = "¿Y el idiota soy yo?";
    text[9396] = "Hola, Chad. El panel de anuncios de Lunex no es el lugar adecuado para este tipo de publicaciones.";
    text[9397] = "Hay paneles de anuncios secundarios para estas cosas.";
    text[9398] = "Por favor, mantén los dramas vinculados a tu relación lejos de aquí. Gracias.";
    text[9419] = "Whitney";
    text[9420] = "¡Es la leche!";
    text[9421] = "¡¿Alguien se ha dado cuenta de cuánto ha subido el precio de la leche últimamente?!";
    text[9422] = "¡Es escandaloso!";
    text[9423] = "Morty";
    text[9424] = "RE: ¡Es la leche!";
    text[9425] = "No es solo la leche... Rancho Kepler ha estado teniendo";
    text[9426] = "problemas para producir comida debido a los lóbregos...";
    text[9427] = "Quiero decir... Ya nos costaba satisfacer la demanda de comida";
    text[9428] = "antes de que los lóbregos aparecieran, pero ahora... ¡es mucho más difícil!";
    text[9465] = "Cecile";
    text[9470] = "Voz misteriosa";
    text[9466] = "Estaba caminando hacia Control de Misiones en la planta 3 cuando...";
    text[9467] = "... escuché una débil voz de repente...";
    text[9468] = "... La voz era extraña y se entrecortaba...";
    text[9469] = "Traté de echar un mirar alrededor para ver de dónde procedía, pero... no conseguí descubrirlo.";
    text[9527] = "Panel de Lunex";
    text[9528] = "ERROR 404";
    text[9529] = "¿Le pasa algo al panel de anuncios?";
    text[9530] = "Normalmente veo cientos de publicaciones aquí cada día...";
    text[9531] = "Parece que los científicos han sobrecargado el servidor con sus propuestas de investigación.";
    text[9532] = "Vaya...";
    text[9533] = "¡También hay paneles de anuncios en Copernicus, Tycho y Colonia Silica!";
    text[9534] = "Podemos echarles un vistazo cuando tengamos la oportunidad, je.";
    text[9369] = "¡Coged el equipo de alpinismo y poned rumbo a las Fosas de Silica!";
    text[9378] = "Registro de personas desaparecidas";
    text[9379] = "Esta publicación del panel contiene una lista actualizada";
    text[9380] = "de personas que se consideran «DESAPARECIDAS».";
    text[9381] = "Si tienes alguna información sobre la ubicación de alguna de estas personas,";
    text[9382] = "contacta con la Fuerza Lunex de inmediato.";
    text[9373] = "Sebastian";
    text[9374] = "Gremio de Cazatesoros";
    text[9375] = "¡Hola! ¡Estamos buscando a personas que quieran unirse al Gremio de Cazatesoros!";
    text[9376] = "¡Los interesados pueden dirigirse a Colonia Silica y buscar a nuestro camarada, Fortuno!";
    text[9384] = "Jason";
    text[9385] = "¡Gran inauguración!";
    text[9386] = "¡Si te gustan los robots y necesitas a un técnico especializado en ellos, soy tu hombre!";
    text[9388] = "¡Asiste a la gran inauguración de Robótica BlanK en Tycho!";
    text[9444] = "Serenidad";
    text[9445] = "Club de fans de Saros";
    text[9446] = "He escuchado que Saros es el general más joven que ha";
    text[9447] = "tenido la Fuerza Lunex.";
    text[9448] = "El legendario héroe de Luna....  ¡Solo tiene 28 años!";
    text[9449] = "Joey";
    text[9450] = "RE: Club de fans de Saros";
    text[9451] = "Saros mola un montón y todo eso...";
    text[9452] = "¿Pero alguien sabe algo de la comandante Vivia?";
    text[9453] = "Me gustaría empezar un club de fans de ella...";
    text[9496] = "Guía de combate";
    text[9497] = "Efectos de estado";
    text[9498] = "Puedes infligir 3 efectos de estado a tus oponentes:";
    text[9499] = "¡ATURDIMIENTO, QUEMADURA Y REMOJÓN!";
    text[9500] = "¡Un enemigo con ATURDIMIENTO no podrá atacar durante 1 turno!";
    text[9501] = "¡Un enemigo con QUEMADURA perderá PV durante una cantidad de turnos determinada!";
    text[9502] = "Y en cuanto a REMOJÓN... ¡Tu barra de lux se llenará más rápido cuando ataques";
    text[9503] = "a un enemigo con este estado!";
    text[9412] = "Ouro";
    text[9413] = "Curiosidades sobre los combos lux";
    text[9414] = "¡He aquí un dato curioso!";
    text[9415] = "¡Puedes reunir un total de 30 recetas de combos lux!";
    text[9416] = "Un tercio de esas recetas son bastante fáciles de recordar..";
    text[9417] = "¡Solo tienes que combinar tres habilidades iguales!";
    text[9418] = "Sin embargo, para conseguir los otros dos tercios es necesario... experimentar un poco.";
    text[9371] = "¡Coged vuestra chaqueta de invierno y poned rumbo al Mte. Piton!";
    text[9372] = "¡Esas estrellas fugaces pasarán en un abrir y cerrar de ojos!";
    text[9434] = "Gominolas";
    text[9435] = "Hay una habilidad activa en concreto que me gusta utilizar, pero...";
    text[9436] = "...¡cuesta demasiados PE!";
    text[9437] = "¿Hay alguna manera de reducir el coste en PE de una de mis habilidades activas?";
    text[9430] = "RESPUESTA 1: Gominolas";
    text[9431] = "Usa una gominola. Las gominolas restan permanentemente 5 al coste en PE de";
    text[9432] = "una de tus habilidades activas.";
    text[9438] = "RESPUESTA 2: Gominolas";
    text[9439] = "¡He estado investigando y parece que las gominolas son extremadamente raras!";
    text[9440] = "Parece que ya has probado alguna, KingNet...";
    text[9441] = "... ¿No tendrías alguna de sobra por ahí?";
    text[9442] = "RESPUESTA 3: Gominolas";
    text[9443] = "No.";
    text[9515] = "Momo";
    text[9516] = "¡Echo!";
    text[9517] = "Ayer vi a Echo, la Gata Espacial. ¡Me estaba animando mientras entrenaba para";
    text[9518] = "mi próxima maratón! ¡Tengo que admitir que los gatos son maravillosos!";
    text[9519] = "Kohaku";
    text[9520] = "RESPUESTA 1: ¡Echo!";
    text[9521] = "Si no te importa que te lo pregunte, ¿dónde viste a Echo?";
    text[9522] = "RESPUESTA 2: ¡Echo!";
    text[9523] = "La vi ayer mientras corría cerca del Café Silica.";
    text[9524] = "El día de antes, la vi volando por las autopistas de Copernicus.";
    text[9525] = "... y la primera vez que vi a Echo estaba aquí, en Tycho.";
    text[9526] = "Echo estaba volando justo por encima de mí mientras echaba un vistazo al panel de anuncios de Tycho.";
    text[9400] = "Tipo del área51";
    text[9401] = "Base Militar";
    text[9402] = "Estaba explorando la Zona Yerma el otro día y empecé a preguntarme:,";
    text[9403] = "¿Por qué no hay plataformas de impulso cerca de la Base Militar?";
    text[9404] = "Riku";
    text[9405] = "RESPUESTA 1: Base Militar";
    text[9406] = "Supongo que permitir vuelos con trajes impulsor en la Base Militar,";
    text[9407] = "podría ir en contra de la seguridad.";
    text[9410] = "Oye, ¿por qué estabas dando una vuelta por la Base Militar?";
    text[9411] = "¡Si la Fuerza Lunex te pilla, te vas a meter en un buen lío!";
    text[9540] = "RESPUESTA 2: Base Militar";
    text[9409] = "Tipo del área51... Tenemos que hablar.";
    text[9370] = "¡Coge tu traje de baño y pon rumbo al arrecife Armonía!";
    text[9455] = "Puntos de lóbregos oscuros";
    text[9456] = "Si alguna vez te encuentras con un punto de aparición de lóbrego de color gris...";
    text[9457] = "¡Mantente lejos si valoras tu vida!";
    text[9458] = "Uno de mis amigos se encontró con un lóbrego con un color alternativo";
    text[9459] = "en un punto de aparición de lóbrego oscuro, y consiguió escapar a duras penas...";
    text[9460] = "Comenzaron a aparecer hace poco,";
    text[9461] = "así que la Fuerza Lunex no tiene mucha información sobre ellos, pero...";
    text[9462] = "... he escuchado que está llamando a esos lóbregos «lóbregos EX».";
    text[9463] = "Los lóbregos EX son más poderosos y rápidos que sus contrapartidas originales...";
    text[9464] = "¡Tened cuidado ahí fuera!";
    text[9472] = "Títulos secretos";
    text[9473] = "¡Estoy tratando de obtener todos los TÍTULOS SECRETOS que hay ahí fuera!";
    text[9474] = "Si alguien sabe cómo conseguir un TÍTULO SECRETO,";
    text[9475] = "¡no dudéis en hacérmelo saber!";
    text[9477] = "RESPUESTA 1: Títulos secretos";
    text[9504] = "Si le decimos a todo el mundo cómo conseguimos nuestros títulos,";
    text[9505] = "no tendría ningún sentido que fueran «SECRETOS»";
    text[9506] = "Pero... supongo que no pasa nada si le damos una pequeña pista a aquellos que están bloqueados...";
    text[9507] = "Esta es la mía: ¡ROCAS!";
    text[9479] = "RESPUESTA 2: Títulos secretos";
    text[9508] = "Esta es mi pista: ¡papeleras de Regolithia!";
    text[9481] = "RESPUESTA 3: Títulos secretos";
    text[9509] = "He oído que acariciar a los perros es muy agradable...";
    text[9513] = "Melody";
    text[9483] = "RESPUESTA 4: Títulos secretos";
    text[9510] = "¡PELUCHES ADORABLES!";
    text[9485] = "RESPUESTA 5: Títulos secretos";
    text[9511] = "Gominolas";
    text[9514] = "Emilienator";
    text[9487] = "RESPUESTA 6: Títulos secretos";
    text[9512] = "¡Bonjour! ¡Trata de encontrarme LO MÁS RÁPIDO que puedas!";
    text[9541] = "Dr. Nexus";
    text[9489] = "RESPUESTA 7: Títulos secretos";
    text[9490] = "Solo unas pocas palabras: ¡lava y reloj de arena!";
    text[9491] = "RESPUESTA 8: Títulos secretos";
    text[9492] = "Es estupendo ver cómo la comunidad se une para atender a esta petición.";
    text[9493] = "Aquí hay una pista para el título secreto que conseguí el otro día:";
    text[9494] = "¡Tienes más de 1000!";
    text[9495] = "¡Buena suerte!";
    text[9535] = "PROTOCOLO DE ENTRENAMIENTO POR IMAGEN INICIADO...";
    text[9536] = "PREPARANDO GENERADORES DE HOLOGRAMAS DE ESTADO SÓLIDO...";
    text[9537] = "POR FAVOR, INDICA EL ENEMIGO CONTRA EL QUE QUIERES LUCHAR...";
    text[9538] = "Escuadrón Raine";
    text[9539] = "Matalóbregos";
    text[9542] = "¿Qué está pasando?";
    text[9543] = "La antigua comandante Vivia ha escapado de su celda...";
    text[9544] = "Y ha dejado una nota para ti:";
    text[9545] = "No vengáis en mi busca.";
    text[9546] = "Necesito algo de tiempo para reflexionar sobre mis actos...";
    text[9547] = "Necesito tiempo para poder superar la sensación de sentirme traicionada...";
    text[9548] = "... he desactivado los cortafuegos de mis servidores de datos personales para que los analistas de datos de Thomas";
    text[9549] = "puedan extraer cualquier información que pueda ser útil para crear el antisuero.";
    text[9550] = "Hay secretos que Saros no me reveló ni siquiera a mí, así que tendréis que encontrar una manera";
    text[9551] = "de acceder a los registros de sus experimentos.";
    text[9553] = "Espero que encuentres lo que necesitas, Bella.";
    text[9554] = "¡El general Saros te ha desafiado a que le ataques con un combo lux!";
    text[9555] = "¡Para poder ejecutar un combo lux, primero tienes que llenar al máximo tu barra de lux!";
    text[9556] = "Tu barra aumentará cada vez que uses una habilidad activa,";
    text[9557] = "y cada vez que bloquees los ataques de tu oponente con un escudo.";
    text[9558] = "ENERG-O: OTORGA UN 20% DE PV Y PE";
    text[9563] = "SUPERENERG-O: OTORGA UN 40% DE PV Y PE";
    text[9559] = "HYPERENERG-O: OTORGA UN 60% DE PV Y PE";
    text[9560] = "REFUERZO DE ESCUDO: ESCUDOS MÁX. + 1";
    text[9561] = "REFUERZO DE PV: PV MÁX. +20";
    text[9562] = "REF. DE HABILIDAD: SUBE DE NIVEL UNA HAB. ACTIVA";
    text[9564] = "SOCORREALMAS: NIVEL + 1";
    text[9565] = "MENTITA DE COMBATE: +10% A LUX EN COMBATE";
    text[9571] = "DULCE ÁCIDO: +10% A ANTIMATERIA EN COMBATE";
    text[9566] = "CÁPSULA DE HABILIDAD: +100 PUNTOS DE HABILIDAD";
    text[9567] = "CHIP DE VUELO: ACTIVA EL CIRCUITO DE VUELO";
    text[9568] = "CHIP T.U.: TRADUCTOR UNIVERSAL";
    text[9569] = "GENERADOR TERMOELÉCTRICO";
    text[9570] = "FLUIDO REANIMADOR: REANIMA A UN ALIADO DESMAYADO";
    text[9572] = "CHIP DE PODER: AUMENTA EL DAÑO DE LOS COMBOS LUX";
    text[9573] = "CHIP DE ESCUDO: DAÑA EL ENEMIGO CUANDO USAS UN ESCUDO";
    text[9574] = "CHIP DE BARRA: INICIA LOS COMBATES CON UN 50% DE LA BARRA DE LUX";
    text[9575] = "CHIP DE ESTRATEGIA: USA 2 HAB. DE APOYO POR TURNO";
    text[9576] = "ELIXIR: 35 PE A TODO EL GRUPO";
    text[9577] = "Empujón";
    text[9578] = "Hiperimpulso";
    text[9579] = "Rocas Aplastantes";
    text[9580] = "Lluvia de Meteoritos";
    text[9581] = "Golpe Ígneo";
    text[9582] = "Explosión Absorbente";
    text[9583] = "Ráfaga de Calor";
    text[9584] = "Campo de Tiburones";
    text[9585] = "Chorro de Agua";
    text[9586] = "Orbe Reflectante";
    text[9587] = "Orbe de Campo";
    text[9588] = "Devoraobjetos";
    text[9589] = "Lluvia de Zarpazos";
    text[9590] = "Mordisco Drenante";
    text[9591] = "Campo de Veneno";
    text[9592] = "Rama Lacerante";
    text[9593] = "Tormenta de Espinas";
    text[9594] = "Cola de Serpiente";
    text[9595] = "Mordisco de Serpiente";
    text[9596] = "Furia Venenosa";
    text[9597] = "Petrificar";
    text[9598] = "Lanzallamas";
    text[9599] = "Gusano de Arena";
    text[9600] = "Furia del Dragón";
    text[9601] = "Estampida";

    text[10341] = "Ganas 10 astrotecno más al final\ndel combate (máx. 30)";
    text[10342] = "+4 a EXP y puntos de habilidad\n Máx. 12 de recompensa extra.";
    text[10343] = "+6 a EXP y puntos de habilidad\n Máx. 18 de recompensa extra.";
    text[10344] = "+8 a EXP y puntos de habilidad\n Máx. 24 de recompensa extra.";

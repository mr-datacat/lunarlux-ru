    text[10434] = "XBOX";
    text[10503] = "Hola, Raine, ¿qué tal?";
    text[10504] = "¿Tienes planes para hoy, guerrera prodigio?";
    text[10505] = "Mmm... ";
    text[10506] = "Iba a ir al Panel de Misiones a ver si hay algo nuevo.";
    text[10507] = "¿Por qué?";
    text[10508] = "Bueno, ¡olvida tus planes!";
    text[10509] = "El Escuadrón Raine organiza una fiesta en la playa, ¡y estáis todos invitados!";
    text[10510] = "Oh, ¡suena divertido!";
    text[10511] = "Nickle, Tetra, ¿qué pensáis? ¿Queréis ir?";
    text[10512] = "¡¿Una fiesta en la playa?! ¡Vamos! ¡Vamos!";
    text[10513] = "Por fin tengo una buena excusa para usar estas gafas de sol tan geniales, jeje.";
    text[10514] = "Tengo la extraña sensación de que esto es solo un plan elaborado";
    text[10515] = "de Raine para que luchemos contra ella otra vez...";
    text[10516] = "¡Muah, ja, ja, ja! ¡NO PROMETO NADA!";
    text[10517] = "En cualquier caso, me gusta la idea de pasar un día agradable y relajante en la playa.";
    text[10518] = "¡PERFECTO!";
    text[10519] = "¡Nos vemos en Summer's Cove! Es una pequeña playa al norte de Oceanus.";
    text[10520] = "¡Y traed mucho protector solar!";
    text[10522] = "Entonces, ¿dónde es la fiesta?";
    text[10523] = "¡Cuidado!";
    text[10524] = "*BONK*";
    text[10525] = "¡Genial, estáis todos aquí!";
    text[10526] = "¡Tenemos todo preparado por allí!";
    text[10527] = "¡Hola, Melody! ¡Hola, Zara!";
    text[10528] = "Por favor, decidme que trajisteis barritas de tarta de queso...";
    text[10529] = "¡Sí! Trajimos todo tipo de bocadillos, jeje.";
    text[10530] = "Y traje flotadores de piscina para todos.";
    text[10531] = "¡Genial! ¡Sois las mejores!";
    text[10532] = "Ahora... ¡Es hora de divertirnos bajo el sol! ¡Woo hoo!";
    text[12140] = "Ahh, no sabía que existía una playa tan bonita como esta en Luna.";
    text[12141] = "Yo tampoco. Ver las palmeras fue una grata sorpresa.";
    text[12153] = "Pensé que las palmeras no podían crecer orgánicamente en Luna.";
    text[12142] = "Ah, las palmeras aquí no son reales... Son solo utilería.";
    text[12143] = "Espera... ¡¿en serio?!";
    text[12149] = "¡Sí!";
    text[12150] = "Y antes de que me preguntes cómo sé esto...";
    text[12144] = "Summer's Cove... era el lugar de verano de mi difunto abuelo.";
    text[12145] = "Su sueño era recrear las hermosas playas de Terra sobre las que había leído...";
    text[12146] = "en los libros de historia para que nuestra familia pudiera pasar las vacaciones aquí.";
    text[12147] = "Aunque él ya no esté, me gustaría continuar su sueño,";
    text[12148] = "y compartir recuerdos maravillosos en esta playa con mis amigos.";
    text[12151] = "Raine, tu abuelo hizo un trabajo fantástico construyendo este lugar.";
    text[12152] = "Seguro que no fue fácil... pero sin duda mereció la pena.";
    text[12154] = "¡Nos aseguraremos de mantener limpia esta playa!";
    text[12155] = "Lo haremos. Estaría bueno volver aquí de vez en cuando para relajarse.";
    text[12156] = "Chicos... Os lo agradezco.";
    text[12157] = "Je, je, je.";
    text[12158] = "¡¿QUÉ?! ¿De qué os reís?";
    text[12159] = "Es lindo verte ser un poco sentimental por una vez, Raine.";
    text[12160] = "¡¿SENTIMENTAL?! ¡¿YO?! ¡Sí, claro!";
    text[12161] = "¡JA, JA, JA, JA, JA!";
    text[12162] = "Bueno, eso duró más o menos lo que esperaba.";
    text[12163] = "Je, je, je, básicamente.";
    text[10533] = "Muy bien, es hora del EVENTO PRINCIPAL.";
    text[10534] = "¡¿Evento principal?! ¿Qué estás tramando ahora, Raine?";
    text[10535] = "¡Tomad un flotador y seguidme!";
    text[10536] = "¡Ta dah!";
    text[10537] = "¡Salpica!";
    text[10538] = "¡Es alocado!";
    text[10539] = "Es la extravagancia de surf del Escuadrón Raine: ¡AGUAS ONDULANTES!";
    text[10540] = "¡Woah! ¡Parece una divertida carrera de obstáculos!";
    text[10541] = "¡Santo cielo! ¡¿Cuándo tuvisteis tiempo de preparar esto?!";
    text[10542] = "No llevó tanto tiempo, en verdad.";
    text[10543] = "Utilizamos un montón de drones para ayudarnos.";
    text[10544] = "AGUAS ONDULANTES fue diseñada para ser una carrera de obstáculos sin fin.";
    text[10545] = "El objetivo es sobrevivir el mayor tiempo posible mientras recogéis las barritas de tarta de queso.";
    text[10546] = "...y el equipo que reúna más barritas de tarta de queso, ¡ganará un increíble PREMIO!";
    text[10547] = "Tened en cuenta que vuestros flotadores pueden soportar hasta 5 golpes antes de reventar.";
    text[10548] = "Espera... ¿Son de verdad barritas de tarta de queso?";
    text[10549] = "No, son hologramas.";
    text[10550] = "Los drones hacen gran parte del trabajo de presentación.";
    text[10551] = "Pero las piedras son reales... ¡y duelen!";
    text[10552] = "Oh Dios...";
    text[10553] = "...¿y qué ocurre si perdemos?";
    text[10554] = "¡DEBERÉIS LUCHAR CON NOSOTROS! ¡JA, JA, JA, JA!";
    text[10555] = "Por supuesto. ¿Por qué no me sorprende?";
    text[10556] = "Sabía que había una trampa.";
    text[10557] = "Esto fue sin duda un elaborado plan...";
    text[10558] = "EY, A MÍ ME GUSTA ORGANIZAR FIESTAS Y LUCHAR CON MIS AMIGOS, ¿SÍ?";
    text[10559] = "¿Raine siempre ha sido así?";
    text[10560] = "Prácticamente sí.";
    text[10561] = "...¿y vosotros le seguís la corriente a sus locos planes?";
    text[10562] = "Lo admito, nunca es un día aburrido con Raine. Sabe cómo divertirse.";
    text[10563] = "Sí.";
    text[10564] = "¡Que empiece la fiesta! ¡Preparaos para las AGUAS ONDULANTES!";
    text[10565] = "MINIJUEGO AGUAS ONDULANTES";
    text[10566] = "SALTAR";
    text[10567] = "MOVERSE";
    text[10569] = "¡IMPOSIBLE! ¿¡QUÉ DEMONIOS!?";
    text[10570] = "¡PERDIMOS POR UNA BARRITA DE TARTA DE QUESO!";
    text[10571] = "Je. ¡Eso fue realmente divertido!";
    text[10572] = "¡Sí! ¡Sí! ¡Quiero probar la carrera de obstáculos otra vez!";
    text[10573] = "Puedes jugar a AGUAS ONDULANTES tantas veces como quieras, Tetra.";
    text[10574] = "Eh, ¿cuál es nuestro premio? Dijiste que había un premio.";
    text[10575] = "Je, je... ";
    text[10576] = "Je, je, je, je...";
    text[10577] = "¡Muah, ja, ja, ja!";
    text[10578] = "Oh, no...";
    text[10579] = "Vuestro premio es...";
    text[10580] = "...¡la oportunidad de tener una revancha con el Escuadrón Raine!";
    text[10581] = "...¿Sabéis qué?";
    text[10582] = "¡ADELANTE!";
    text[10583] = "De todas formas, tengo ganas de entrenar un poco.";
    text[10584] = "¡Yo también, yo también!";
    text[10585] = "Un superhéroe siempre debe estar preparado para todo.";
    text[10586] = "Vosotros tres podéis habernos vencido la última vez, pero esta vez...";
    text[10587] = "...¡venimos preparadas! ¡No nos echaremos atrás!";
    text[10588] = "¡Maldición! El espíritu competitivo de Raine seguro que se te ha contagiado, Melody.";
    text[10589] = "Bella, como nueva general de la Fuerza Lunex, necesitarás buenos compañeros de entrenamiento";
    text[10590] = "que te empujarán a superar tus límites y alcanzar nuevas metas.";
    text[10591] = "Estaremos encantados de entrenar contigo tantas veces como desees.";
    text[10592] = "Chicos... No podría haber pedido mejores compañeros de entrenamiento...";
    text[10593] = "Nickle... Tetra...";
    text[10594] = "¡PREPARÉMONOS PARA EL COMBATE!";
    text[10595] = "Ahhh... eso fue... ¡INCREÍBLE!";
    text[10596] = "AUNQUE FUE UNA MIERDA HABER PERDIDO...";
    text[10597] = "RECORDAD MIS PALABRAS... UNO DE ESTOS DÍAS, ¡EL ESCUADRÓN RAINE SALDRÁ VICTORIOSO!";
    text[10598] = "Increíble... La dinámica de equipo que tenéis vosotros tres es simplemente increíble.";
    text[10599] = "Creo que necesito una bolsa de hielo... Ouch...";
    text[12116] = "Toma, Bella, queremos que tengas esto.";
    text[12118] = "Oh. ¿Qué es?";
    text[12119] = "Considéralo un regalo de felicitación de nuestra parte...";
    text[12122] = "...a nuestra querida guerrera prodigio, ¡muah, ja, ja, ja!";
    text[12117] = "Oh, ¡gracias! ¡Sois las mejores!";
    text[12123] = "Unas pocas horas más tarde...";
    text[10600] = "Creo que es hora de dejarlo por hoy.";
    text[10601] = "Gracias por organizar esta fiesta. ¡Me divertí mucho!";
    text[10602] = "¡Yo también!";
    text[10603] = "La vida es cuestión de equilibrio.";
    text[10604] = "Después de todo lo que hemos pasado últimamente,";
    text[10605] = "creo que todos nos merecíamos una escapada así.";
    text[10606] = "¡Por supuesto!";
    text[10607] = "Muy bien, equipo, ¡a volar!";
    text[10608] = "¡EPISODIO DE LA PLAYA COMPLETADO!";
    text[10615] = "¿Qué tal, Bella? ¿Quieres una revancha con el Escuadrón Raine?";
    text[10616] = "¡HAGÁMOSLO!";
    text[10617] = "Tal vez en otra ocasión.";
    text[10618] = "¡DEMONIOS, SÍ, VAS A CAER!";
    text[10619] = "M-07: Monstruos de Magnesia";
    text[10620] = "Recibimos señales de auxilio de tres de nuestros soldados que estaban";
    text[10621] = "patrullando las afueras del sector abandonado: Magnesia.";
    text[10622] = "Los soldados informaron de que se encontraron con lo que describieron como";
    text[10623] = "extraños 'monstruos' que no parecían ser lóbregos.";
    text[10624] = "Antes de que pudiéramos indagar más, perdimos la comunicación con ellos.";
    text[10625] = "Tu misión es investigar a los 'Monstruos de Magnesia'";
    text[10626] = "y rescatar a nuestros compañeros de la Fuerza Lunex.";
    text[10768] = "Magnesia...";
    text[10769] = "Ese es el sector abandonado que vimos en la distancia";
    text[10770] = "antes de llegar a la Colonia Silica.";
    text[10771] = "Los registros indican que la destrucción de Magnesia fue";
    text[10772] = "obra de un único lóbrego extremadamente poderoso.";
    text[10773] = "Mmm...";
    text[10774] = "¿Qué estás pensando, Bella?";
    text[10775] = "Me pregunto si hay algún tipo de conexión entre los 'monstruos'";
    text[10776] = "de los que informaron nuestros soldados y el 'lóbrego' que destruyó Magnesia.";
    text[10777] = "¿Hay alguien que haya visto qué aspecto tiene y siga con vida?";
    text[10778] = "Bella, la destrucción de Magnesia ocurrió hace muchos años...";
    text[10779] = "Dudo mucho que haya información por ahí...";
    text[10780] = "Mmm...";
    text[10781] = "Solo se me ocurre una cosa...";
    text[10782] = "Los servidores secretos de Saros.";
    text[10783] = "¿Estás diciendo que existe la posibilidad de que Saros tenga un registro";
    text[10784] = "del día en que Magnesia fue destruida?";
    text[10785] = "Como los registros públicos dicen que el incidente estuvo relacionado con un lóbrego...";
    text[10786] = "Sí... Creo que existe una buena posibilidad.";
    text[10787] = "¿Y si los Monstruos de Magnesia no eran más que otro de sus experimentos?";
    text[10788] = "Saros ha encubierto un montón de cosas turbias a lo largo de los años...";
    text[10789] = "No está de más comprobarlo.";
    text[10790] = "...Sí.";
    text[10791] = "...¿y cómo accedemos a los servidores secretos?";
    text[10792] = "Nyla puede ayudarnos. Ha estado trabajando con su equipo de analistas de datos";
    text[10793] = "para extraer y descifrar todos los archivos de los servidores secretos.";
    text[10794] = "Vamos a hablar con Nyla rápido, antes de ir a Magnesia.";
    text[10795] = "Debería estar en el Laboratorio Nexus. ¡Vamos!";
    text[10796] = "Hola, Srta. Nyla.";
    text[10797] = "Hola, queridos, ¿qué os trae por aquí?";
    text[10798] = "Estamos en una misión para investigar unos extraños monstruos";
    text[10799] = "que fueron vistos en el sector abandonado, Magnesia.";
    text[10800] = "Tenemos que salir muy pronto para encontrar a nuestros soldados varados...";
    text[10801] = "...pero antes de irnos...";
    text[10802] = "¿Te importaría enviarme cualquier archivo que Saros pueda haber guardado en";
    text[10803] = "sus servidores secretos con respecto a Magnesia, su destrucción,";
    text[10804] = "y los avistamientos de lóbregos que se han reportado allí?";
    text[10805] = "Quiero asegurarme de que estamos totalmente preparados para esta misión.";
    text[10806] = "¡No me molesta en absoluto, querida! Por supuesto.";
    text[10807] = "Por favor, dirigíos a Magnesia para rescatar a nuestros soldados.";
    text[10808] = "Si encuentro algún archivo relevante, se lo enviaré a Tetra enseguida.";
    text[10809] = "¡Gracias, Srta. Nyla!";
    text[10810] = "¡En marcha, equipo, vamos a Magnesia!";
    text[10701] = "Para llegar a Magnesia,";
    text[10702] = "tenemos que caminar por el Camino Abandonado.";
    text[10703] = "¿Estáis listos?";
    text[10704] = "Una vez que entremos, tenemos que comprometernos a completar esta misión.";
    text[10705] = "¡Nuestros camaradas de la Fuerza Lunex cuentan con nosotros!";
    text[10706] = "¡Estoy listo!";
    text[10707] = "No estoy listo todavía...";
    text[10708] = "Bien, ¡vamos, vamos, vamos!";
    text[10709] = "... ... ...";
    text[10710] = "Nickle, ¿estás bien?";
    text[10711] = "S...sí, ¿por qué?";
    text[10712] = "Pareces un poco agitado...";
    text[10713] = "...Estoy bien. Sigamos.";
    text[12211] = "Wow... Este camino está en muy mal estado...";
    text[12212] = "Esto solía ser un camino transitado que la gente usaba";
    text[12213] = "para viajar entre la Colonia Magnesia y la Colonia Silica.";
    text[12214] = "Ahora... ha sido abandonado y olvidado... por eso,";
    text[12215] = "la base de datos Lunex se refiere a este camino como el 'Camino Abandonado'.";
    text[12216] = "Uh... ¿Bella?";
    text[12217] = "¿Qué ocurre, Tetra?";
    text[12218] = "¡VEO ALGO!";
    text[12219] = "Woah... Esos deben ser los 'monstruos extraños' que nuestros soldados reportaron.";
    text[12220] = "¿Crees que pueda ser un lóbrego?";
    text[12221] = "No estoy segura... En realidad no parece un lóbrego.";
    text[12222] = "Sea lo que sea... definitivamente no es humano.";
    text[12223] = "Tenemos que acercarnos para ver mejor.";
    text[12224] = "¡Persigámoslo!";
    text[12225] = "¡Entendido!";
    text[12226] = "... ... ...";
    text[10627] = "Llegamos demasiado tarde...";
    text[10628] = "Los soldados Lunex... Están muertos...";
    text[10629] = "¡Bella, se acercan enemigos!";
    text[10630] = "CORRUPTO... CORRUPTO... ¡CORRUPTOID!";
    text[10631] = "Espera un minuto... ¡Estos tipos son entidades antiguas!";
    text[10632] = "¿Estás segura?";
    text[10633] = "Eso creo.";
    text[10634] = "Su lux se siente similar a Guardios y Lumiknight...";
    text[10635] = "...pero algo no acaba de encajar...";
    text[10636] = "...es casi como si se hubieran corrompido...";
    text[10637] = "Creía que los Antiguos estaban de nuestro lado...";
    text[10638] = "...¿por qué lastimarían personas inocentes?";
    text[10639] = "No lo sé... pero, ¡no podemos dejar que se salgan con la suya!";
    text[10640] = "¡Tenemos que vengar a nuestros camaradas caídos!";
    text[10641] = "¡Preparémonos para el combate!";
    text[10642] = "¿¡Guardios!?";
    text[10643] = "SALUDOS, PERCIBEALMAS...";
    text[10648] = "Guardios, ¿sabes lo que está pasando aquí?";
    text[10649] = "Entidades antiguas han atacado a nuestros soldados...";
    text[10650] = "Hay algo ahí fuera...";
    text[10651] = "...y se siente como pura malicia...";
    text[10861] = "MIS SENSORES HAN DETECTADO QUE UNA DE NUESTRAS ENTIDADES GUARDIANAS";
    text[10862] = "HA VUELTO A DESPERTAR...";
    text[10863] = "...Y SU NOMBRE ES 'NECROMIA'.";
    text[10873] = "Necromia...";
    text[10874] = "Recuerdo haber visto un texto antiguo que mencionaba ese nombre...";
    text[10875] = "Era una entidad guardiana que tenía la capacidad de manipular la mente.";
    text[10876] = "¡¿Control mental?! ¡¿En serio?!";
    text[10877] = "EXACTO.";
    text[10864] = "...Y POR RAZONES QUE DESCONOZCO,";
    text[10865] = "LA PROGRAMACIÓN DE NECROMIA HA SIDO CORROMPIDA.";
    text[10866] = "POR LO TANTO, TODOS LOS SOLDADOS DE NECROMIA TAMBIÉN HAN SIDO CORROMPIDOS.";
    text[10868] = "Una entidad antigua corrompida... ¿Cómo puede pasar eso?";
    text[10869] = "POR DESGRACIA, NO LO SÉ...";
    text[10867] = "PERO LO QUE SÍ SÉ ES QUE...";
    text[10870] = "NECROMIA ES UNA ENTIDAD MUCHO MÁS PODEROSA QUE YO...";
    text[10878] = "...Y AHORA...";
    text[10871] = "EN LUGAR DE SERVIR PARA PROTEGER A LUNA,";
    text[10879] = "NECROMIA BUSCA DESTRUIRLA.";
    text[10872] = "SIN MI RECEPTÁCULO, SOY INCAPAZ DE DETENER A NECROMIA YO MISMO...";
    text[10880] = "...Y POR ESO, OS PIDO AYUDA.";
    text[10665] = "No te preocupes, Guardios.";
    text[10666] = "¡Haremos todo lo posible para evitar que Necromia haga daño a alguien más!";
    text[10667] = "DEBÉIS ACTUAR RÁPIDO..";
    text[10812] = "¿Guardios?";
    text[10813] = "¿Qué ocurre?";
    text[10821] = "HA LLEGADO MI HORA...";
    text[10814] = "YO... DESAPARECERÉ PRONTO...";
    text[10815] = "EL RESTO... DEPENDE DE VOSOTROS...";
    text[10816] = "BELLA GREY.";
    text[10817] = "TU LUX NO TIENE LÍMITES...";
    text[10818] = "POR FAVOR, ÚSALA...";
    text[10819] = "PARA PROTEGER... NUESTRO HOGAR...";
    text[10645] = "Guardios...";
    text[10646] = "Gracias por todo...";
    text[10647] = "Gracias a ti pude reunirme con mi madre,";
    text[10822] = "y desbloquear mi habilidad para percibir almas.";
    text[10820] = "Honraré tu valiente sacrificio y tus últimas palabras...";
    text[10823] = "Sigamos adelante.";
    text[10860] = "¡Tenemos que encontrar a Necromia antes de que sea demasiado tarde!";
    text[10827] = "Esperad...";
    text[10828] = "No creo que sea buena idea que vosotras dos sigáis.";
    text[10829] = "¿Cómo? ¿Por qué?";
    text[10830] = "Somos un equipo, ¿recuerdas?";
    text[10831] = "Somos más fuertes juntos que separados...";
    text[10832] = "Lo sé, pero... Por favor, dejadme manejar esto...";
    text[10833] = "Ya oísteis a Guardios. Necromia puede controlar mentes...";
    text[10834] = "...no quiero arriesgarme a perderos a las dos.";
    text[10835] = "Necesito hacer esto yo mismo...";
    text[10845] = "Sobre todo porque estamos aquí en Magnesia...";
    text[10837] = "Nickle...";
    text[10836] = "Has estado distante desde que empezamos esta misión.";
    text[10838] = "¿Qué es lo que no nos estás contando?";
    text[10725] = "Si os digo... Nunca me perdonaríais...";
    text[10839] = "Nickle, estamos aquí para ti.";
    text[10840] = "No tienes por qué pasar por esto solo.";
    text[10841] = "No, no lo entendéis...";
    text[10842] = "Si os digo... ya no podremos ser amigos...";
    text[10843] = "...";
    text[10844] = "Prefiero saber la verdad, que esconderme detrás de una mentira.";
    text[10726] = "¿Qué tan malo puede ser?";
    text[10727] = "Es lo peor que os podáis imaginar.";
    text[10728] = "Es la razón por la que estoy tan...";
    text[10729] = "...hecho un desastre.";
    text[10730] = "...";
    text[10731] = "El día en que Magnesia fue destruida,";
    text[10732] = "fui emboscado por Saros y la Fuerza Lunex.";
    text[10733] = "Era su tercer intento de capturarme...";
    text[10734] = "Estaba agotado...";
    text[10735] = "Asustado...";
    text[10736] = "Enojado...";
    text[10737] = "Odiaba a Saros...";
    text[10738] = "...y me odiaba a mí mismo por tener esos poderes...";
    text[10739] = "No era justo...";
    text[10740] = "...ser tratado como un monstruo... como una rata de laboratorio...";
    text[10741] = "No podía soportarlo más...";
    text[10742] = "Ese día, en lugar de huir, decidí luchar.";
    text[10743] = "Desaté mi furia... Mi cuerpo se transformó...";
    text[10744] = "...y mi antimateria comenzó a consumir mi mente...";
    text[10745] = "Le di a Saros exactamente lo que quería...";
    text[10748] = "...un monstruo.";
    text[10749] = "...y ese momento de furia...";
    text[10746] = "...fue el mayor error de mi vida.";
    text[10747] = "En ese momento, todavía era incapaz de controlar todo mi poder...";
    text[10750] = "Después de transformarme en mi Modo Fase,";
    text[10751] = "todo estaba borroso. No recuerdo lo que pasó...";
    text[10752] = "Cuando recuperé la conciencia, ya era demasiado tarde...";
    text[10753] = "Colonia Magnesia fue destruida...";
    text[10754] = "...y yo era el único que quedaba en pie...";
    text[10755] = "El pueblo de Magnesia murió por MI culpa...";
    text[10756] = "...y no hay forma de traerlos de vuelta...";
    text[10757] = "Desde ese día, pasé cada momento de mi vida";
    text[10758] = "lleno de culpa, vergüenza y miedo.";
    text[10759] = "Con miedo de herir a otros...";
    text[10760] = "Con miedo de lo que haría si volviera a usar todo mi poder...";
    text[10761] = "...fui débil...";
    text[10762] = "Yo soy el que merece...";
    text[10763] = "Nickle...";
    text[10764] = "Bella, no creo que pueda mirarte a la cara otra vez...";
    text[10765] = "...tengo que reparar lo que he hecho.";
    text[10766] = "Lo siento...";
    text[10846] = "¡...!";
    text[10847] = "No puedo creerlo...";
    text[10848] = "Esto no puede ser verdad...";
    text[10849] = "Bella...";
    text[10850] = "No podemos dejar que vaya solo.";
    text[10851] = "Va a hacer que lo maten.";
    text[10852] = "¡Bella!";
    text[10853] = "¡Nyla encontró algo en los servidores secretos de Saros!";
    text[10854] = "Leamos el informe...";
    text[10855] = "... ... ...";
    text[10856] = "¡BELLA!";
    text[10857] = "SÍ. ¡TENEMOS QUE ENCONTRAR A NICKLE!";
    text[10858] = "NECESITA SABERLO. ¡DÉMONOS PRISA!";
    text[10714] = "¡¿Woah, un terremoto?!";
    text[10715] = "Puedo sentirlo...";
    text[10716] = "...un inmenso poder nos espera.";
    text[10720] = "Sigamos adelante...";
    text[10721] = "Tengo un mal presentimiento sobre esto...";
    text[10881] = "¡Nickle!";
    text[10882] = "¡Te hemos buscado por todas partes!";
    text[10883] = "Recibimos un informe de Nyla sobre el incidente en Magnesia.";
    text[10884] = "¡Hay algo que NECESITAS saber!";
    text[10885] = "... ... ... ...";
    text[10886] = "¿Nickle?";
    text[10887] = "ME TEMO QUE VUESTRO AMIGO YA NO ESTÁ CON NOSOTROS...";
    text[10888] = "Tú debes ser Necromia.";
    text[10889] = "SÍ, LO SOY... LO SOY...";
    text[10915] = "CUANDO EMBOSQUÉ A VUESTRO AMIGO...";
    text[10890] = "NO PARECÍA ACORDARSE DE MÍ...";
    text[10891] = "ERA EXTRAÑO... ERA EXTRAÑO...";
    text[10892] = "...PORQUE YO LO RECUERDO PERFECTAMENTE...";
    text[10916] = "TODOS ESTOS AÑOS... TODOS ESTOS AÑOS...";
    text[10917] = "ACUMULANDO SUFICIENTE ENERGÍA PARA DESPERTAR UNA VEZ MÁS...";
    text[10893] = "¡Nickle, por favor, reacciona!";
    text[10894] = "¡Necromia ha tomado el control de tu mente!";
    text[10895] = "NO PUEDE OÍRTE... NO PUEDE OÍRTE...";
    text[10896] = "VUESTRO AMIGO... ¡AHORA ES MI MARIONETA!";
    text[10909] = "¡DEVUÉLVELO ESTÚPIDO!";
    text[10910] = "VERÉIS... YO NO TENGO UN CUERPO FÍSICO.";
    text[10911] = "MI RECEPTÁCULO HA SIDO DESTRUIDO HACE TIEMPO...";
    text[10912] = "...DESTRUIDO POR ÉL. ...DESTRUIDO POR ÉL.";
    text[10913] = "...Y AHORA, USARÉ SU CUERPO COMO MI NUEVO RECEPTÁCULO.";
    text[10918] = "ES LAMENTABLE...";
    text[10914] = "NO SE ACUERDA... NO SE ACUERDA...";
    text[10897] = "PUEDO SENTIRLO...";
    text[10898] = "SU MENTE ESTÁ LLENA DE ODIO A SÍ MISMO...";
    text[10899] = "INCLUSO AHORA... SE DEFIENDE...";
    text[10900] = "TIENE MIEDO... TIENE MIEDO...";
    text[10901] = "TIENE MIEDO DE HACEROS DAÑO...";
    text[10902] = "¡CONVERTIRÉ SUS PESADILLAS EN REALIDAD!";
    text[10903] = "Nickle, ¡no dejes que te controle!";
    text[10904] = "¡Eres mucho más fuerte!";
    text[10905] = "¡LUCHA!";
    text[10906] = "¿LUCHAR, DICES? ¿LUCHAR, DICES?";
    text[10907] = "SI ES UNA LUCHA LO QUE QUERÉIS...";
    text[10908] = "...¡UNA LUCHA TENDRÉIS!";
    text[10922] = "Nickle, ¡lo lograste!";
    text[10923] = "¡Te liberaste del control mental de Necromia!";
    text[10919] = "IMPOSIBLE... IMPOSIBLE...";
    text[10924] = "ESTO NO PUEDE SER...";
    text[10925] = "DEBES SER ERRADICADO... ESTO NO PUEDE SER...";
    text[10920] = "Ahora recuerdo...";
    text[10921] = "Recuerdo TODO.";
    text[10926] = "Pero... no fueron mis recuerdos los que desbloqueé.";
    text[10927] = "...fueron los tuyos, Necromia.";
    text[10928] = "FUE INTENCIONAL... INTENCIONAL...";
    text[10929] = "COMPARTÍ MIS RECUERDOS PARA QUE...";
    text[10930] = "...ENTIENDAS LA RAZÓN POR LA QUE TE DESPRECIO...";
    text[10931] = "Tú y yo... ya luchamos una vez.";
    text[10932] = "El día en que Magnesia fue destruida.";
    text[10933] = "Bella, ¿qué decía el informe de Nyla?";
    text[10960] = "Los registros públicos que documentan la destrucción de Magnesia fueron";
    text[10980] = "un encubrimiento ideado por Saros para proteger su reputación...";
    text[10981] = "...todo porque su plan de capturarte ese día había fracasado.";
    text[10934] = "En un esfuerzo por probar las capacidades de su suero de lóbrego...";
    text[10935] = "Saros decidió experimentar con una entidad antigua que el equipo";
    text[10936] = "de arqueología había encontrado años atrás.";
    text[10937] = "Esta entidad antigua ... era Necromia.";
    text[10938] = "...y Saros fue responsable de su corrupción.";
    text[10942] = "CORRUPCIÓN... CORRUPCIÓN...";
    text[10939] = "Había reprogramado a Necromia en un esfuerzo por usar su poder";
    text[10940] = "para intentar controlarme...";
    text[10941] = "...y fracasó.";
    text[10943] = "...porque ese día, yo no tenía el control.";
    text[10944] = "Mi mente ya había sido dañada...";
    text[10945] = "...y mi cuerpo funcionaba por puro instinto de supervivencia.";
    text[10946] = "Tan pronto como Saros entendió que Necromia no era capaz de controlarme,";
    text[10947] = "cambió sus planes, y ordenó a Necromia atacar la ciudad.";
    text[10948] = "Y ESO HICE... Y ESO HICE...";
    text[10949] = "PURA DESTRUCCIÓN...";
    text[10950] = "FUE... FUE...";
    text[10951] = "FASCINANTE...";
    text[10952] = "AUNQUE TU MENTE ESTABA PERDIDA...";
    text[10982] = "TU CUERPO SE MOVÍA SOLO...";
    text[10953] = "TU INSTINTO... FUE PROTEGER A LOS INOCENTES...";
    text[10954] = "INTENTASTE DETENERME... Y LO HICISTE...";
    text[10956] = "DESATASTE UN ATAQUE TAN PODEROSO...";
    text[10957] = "MI RECEPTÁCULO SE HABÍA CONVERTIDO EN POLVO DE ESTRELLAS...";
    text[10955] = "...¡PERO NO ANTES DE HABER DESTRUIDO LA CIUDAD!";
    text[10969] = "...y nunca volverás a destruir nada.";
    text[10970] = "Se acabó, Necromia.";
    text[10979] = "DESAFORTUNADAMENTE PARA VOSOTROS... EN ESTA FORMA...";
    text[10975] = "NO PODÉIS HACERME DAÑO... NO PODÉIS HACERME DAÑO...";
    text[10983] = "Te equivocas.";
    text[10976] = "Con el poder de la antimateria...";
    text[10977] = "...combinado con el poder de Lux...";
    text[10978] = "...no hay nada que no podamos hacer.";
    text[10971] = "¡Bella!";
    text[10972] = "¡Justo detrás de ti! ¡Hora de percibir almas!";
    text[10973] = "ESTO ES POR... ¡LA GENTE DE MAGNESIA!";
    text[10974] = "¡HIYAHHHHHHH!";
    text[10986] = "A menudo se dice que la ignorancia es felicidad...";
    text[10987] = "Habiendo conocido la verdadera oscuridad y los secretos de los lóbregos,";
    text[10988] = "envidiaría a los que ignoran la verdad.";
    text[10989] = "...pero en este caso,";
    text[10990] = "mi ignorancia fue una maldición.";
    text[10991] = "Por años,";
    text[10963] = "me hicieron creer que fui yo quien destruyó Magnesia...";
    text[10964] = "y, aunque no maté a esta gente...";
    text[10965] = "todavía me siento responsable de lo que pasó...";
    text[10966] = "El pueblo de Magnesia murió porque...";
    text[10984] = "no fui lo suficientemente fuerte para protegerlos.";
    text[10967] = "Nickle...";
    text[10968] = "Debes aprender a perdonarte a ti mismo...";
    text[10992] = "Perdonar aquello con lo que naciste...";
    text[10995] = "Lo que la gente mala como Saros ha decidido hacer";
    text[10996] = "con eso...";
    text[10997] = "...el conocimiento, el poder y los planes retorcidos...";
    text[10998] = "...todas esas cosas no son culpa tuya...";
    text[10999] = "Ahora mismo, tienes la oportunidad de hacer justicia.";
    text[11000] = "Justicia...";
    text[10993] = "...Sí.";
    text[10994] = "Por eso me he esforzado tanto en coleccionar Antinúcleos...";
    text[11001] = "Exactamente.";
    text[11002] = "Tú y yo...";
    text[11021] = "Queremos ayudar a que las personas que sufrieron a manos de Saros";
    text[11003] = "vuelvan con sus familias y seres queridos.";
    text[11004] = "...pero la gente de Magnesia...";
    text[11005] = "...no hay forma de traerlos de vuelta.";
    text[11006] = "Eso no es del todo cierto...";
    text[11007] = "¿Eh? ¿Qué quieres decir?";
    text[11008] = "Había una cosa más en el informe que Nyla nos envió...";
    text[11009] = "Necromia puede haber destruido la ciudad...";
    text[11010] = "...pero no mató a todos.";
    text[11011] = "Todos los supervivientes fueron reunidos por los soldados de Saros y...";
    text[11012] = "...todos fueron usados como sujetos de prueba para sus experimentos con lóbregos.";
    text[11013] = "Estos supervivientes...";
    text[11014] = "Están ahí fuera en alguna parte... como lóbregos";
    text[11016] = "...y nuestro trabajo es encontrarlos y traerlos a casa.";
    text[11057] = "... ... ...";
    text[11051] = "*sollozo*";
    text[11052] = "¡Woah, ey! No pasa nada, Nickle.";
    text[11053] = "Yo... *sollozo* ...lo siento...";
    text[11054] = "Solo...";
    text[11055] = "me alivia saber que aún hay una oportunidad de arreglar las cosas...";
    text[11056] = "*sollozo*";
    text[11017] = "Bella...";
    text[11022] = "Tetra...";
    text[11018] = "...no habría llegado tan lejos sin vosotras dos...";
    text[11019] = "Gracias por estar ahí para mí...";
    text[11020] = "¡Para eso están los amigos!";
    text[11023] = "Recuerda, ¡somos los tres mosqueteros de Lunar!";
    text[11024] = "¡Por supuesto!";
    text[11025] = "Antes de irnos...";
    text[11026] = "Quisiera mostrar mis respetos al pueblo de Magnesia...";
    text[11027] = "...y a los soldados de Lunex que murieron hoy aquí.";
    text[11028] = "Por supuesto, tómate el tiempo que necesites.";
    text[11029] = "MONSTRUOS DE MAGNESIA \n-MISIÓN COMPLETADA-";
    text[11030] = "Bella...";
    text[11031] = "¿Qué ocurre?";
    text[11032] = "Me preguntaba si podía retarte a un duelo.";
    text[11033] = "¡¿Un duelo?! ¿Aquí?";
    text[11034] = "Sí.";
    text[11035] = "Puede parecer una tontería, pero...";
    text[11036] = "Quiero mostrarle a la gente de Magnesia";
    text[11037] = "que estoy haciendo todo lo posible para hacerme más fuerte.";
    text[11038] = "Y tú eres la luchadora más fuerte que conozco.";
    text[11039] = "Entonces, ¿quieres pelear?";
    text[11040] = "El ganador invita a cenar al perdedor.";
    text[11041] = "Oh. ¿Esta es tu manera de invitarme a salir?";
    text[11042] = "¿Q-qué? Mmm...";
    text[11047] = "Supongo que...";
    text[11043] = "No dijiste que no, así que asumo que es un sí.";
    text[11044] = "Acepto el desafío, je...";
    text[11045] = "...pero te advierto que no te lo pondré fácil.";
    text[11046] = "No me gustaría que lo hicieras.";
    text[11048] = "Solo por ti... Iré en Modo Fase.";
    text[11049] = "¡Genial! ¡Hagámoslo!";
    text[11050] = "¿Te gustaría luchar, Nickle?";
    text[11072] = "Así que esto es la Corporación Energ-O...";
    text[11073] = "Je, je, je.";
    text[11075] = "Pronto...";
    text[11076] = "Muy pronto...";
    text[11074] = "(Este tipo parece sospechoso...)";
    text[11069] = "Señor, ¿hay algo en lo que podamos ayudarlo?";
    text[11070] = "No... Métete en tus asuntos.";
    text[11071] = "Lárgate, chico.";
    text[11077] = "M-06: La toma de la Corporación Energ-O";
    text[11078] = "El edificio la Corporación Energ-O situado en Tycho ha sido tomado";
    text[11079] = "por los ravagers, una banda de ladrones conocidos por robar";
    text[11080] = "objetos de valor y venderlos para obtener beneficios en el mercado negro.";
    text[11081] = "Son muy peligrosos y desconocemos sus motivaciones...";
    text[11082] = "Tu misión es infiltrarte en la Corporación Energ-O,";
    text[11083] = "detener a los malvados ravagers,";
    text[11084] = "¡y averiguar lo que están tratando de robar!";
    text[11085] = "Ey, ¿cuál es la situación actual?";
    text[11086] = "Srta. Bella, evacuamos a tanta gente como pudimos,";
    text[11087] = "pero los ravagers se han llevado al CEO y a sus empleados";
    text[11088] = "como rehenes en los niveles superiores.";
    text[11089] = "Para evaluar mejor la situación, desplegamos nuestros drones";
    text[11090] = "para escanear el edificio y ¡descubrieron explosivos temporizados!";
    text[11091] = "Sea lo que sea que busquen los ravagers, lo quieren RÁPIDO,";
    text[11092] = "y están dispuestos a volar el edificio para conseguirlo.";
    text[11093] = "En serio... ¿Por qué están haciendo todo esto";
    text[11094] = "para robar a una empresa que fabrica bebidas Energ-O?";
    text[11095] = "Mmm... disculpa...";
    text[11096] = "pero creo que sé lo que los ravagers podrían estar buscando...";
    text[11097] = "Llevamos unos años desarrollando una nueva fórmula de Energ-O...";
    text[11098] = "Esta nueva bebida tiene la capacidad de mantener el cuerpo y la mente";
    text[11099] = "despierto y con energía durante días sin necesidad de dormir.";
    text[12000] = "Es la bebida POR EXCELENCIA...";
    text[12001] = "...para alguien que quiere maximizar su productividad.";
    text[12002] = "La llamamos: Energ-O Infinita.";
    text[12003] = "Esta fórmula tiene tantos potenciales usos científicos y biológicos";
    text[12004] = "...que la hace muy valiosa.";
    text[12005] = "Por eso...";
    text[12006] = "Creo que los ravagers están aquí para robar nuestra fórmula Energ-O Infinita.";
    text[12007] = "¡Gracias por la información! No te preocupes...";
    text[12008] = "¡No permitiremos que los ravagers se salgan con la suya!";
    text[12009] = "¡Vamos equipo, vamos a entrar!";
    text[12010] = "Tch. Así que la Fuerza Lunex finalmente aparece...";
    text[12011] = "¡No os mováis! ¡Estáis todos arrestados!";
    text[12012] = "¿De verdad creéis que vamos a abandonar nuestra operación";
    text[12013] = "y entregarnos sin luchar?";
    text[12014] = "Qué ingenuos.";
    text[12015] = "Tenemos ravagers en cada piso, chico...";
    text[12016] = "...y este edificio va a explotar en 10 turnos,";
    text[12017] = "les guste o no.";
    text[12018] = "¿10 turnos?";
    text[12019] = "Fácil.";
    text[12020] = "Podría acabar con todos vosotros en un solo turno.";
    text[12021] = "Tch. Idiota arrogante.";
    text[12022] = "¡No te metas con los ravagers!";
    text[12076] = "Pensé que era un edificio de oficinas corporativas...";
    text[12077] = "¿Qué son todas estas baldosas con flechas?";
    text[12170] = "Parece un laberinto...";
    text[12078] = "Quizás los ravagers colocaron las flechas aquí para retrasarnos.";
    text[12079] = "Eso, o al CEO de la Corporación Energ-O le encantan los puzzles de flechas...";
    text[12171] = "Uh, oh... ¡Más ravagers!";
    text[12172] = "¡No te preocupes, todo está bajo control!";
    text[12023] = "Bueno, bueno...";
    text[12024] = "Parece que subestimé la fuerza de la Fuerza Lunex.";
    text[12025] = "Debes ser el líder de los ravagers...";
    text[12026] = "Así es.";
    text[12027] = "Ahora si me disculpáis, tengo que estar en otro sitio.";
    text[12028] = "Esta fórmula secreta no se va a vender sola.";
    text[12029] = "Solo lo diremos una vez,";
    text[12030] = "...liberad a los rehenes y desactivad los explosivos, ¡YA!";
    text[12031] = "...¿o qué haréis exactamente?";
    text[12032] = "Puede que hayáis vencido a mis rufianes...";
    text[12033] = "Pero no sois rivales para mí.";
    text[12034] = "El tiempo corre, ¿sabéis?";
    text[12035] = "¿Ya os habéis olvidado de los explosivos?";
    text[12036] = "¡Pronto no seréis más que un montón de cenizas!";
    text[12037] = "Ya lo veremos.";
    text[12038] = "¡Chicos, desactivé los explosivos temporizados!";
    text[12039] = "Se ha evitado el peligro, je.";
    text[12040] = "Gracias por salvarnos...";
    text[12041] = "...y por detener a los ravagers...";
    text[12042] = "Tomad esto como muestra de nuestra gratitud...";
    text[12043] = "¡Energ-O Infinita obtenida!";
    text[12044] = "Espera, ¿estás seguro de que está bien darnos esto?";
    text[12045] = "De todas formas, nuestra Energ-O Infinita se venderá pronto al público.";
    text[12046] = "Consideradlo una muestra especial previa al lanzamiento.";
    text[12049] = "Cielos... Los motivos de los ravagers me desconciertan...";
    text[12050] = "Si tanto querían la fórmula...";
    text[12051] = "¿No podían haber esperado a que se lanzara?";
    text[12052] = "El mundo de los negocios es cruel y competitivo, amigo mío.";
    text[12053] = "Cuando se trata de productos nuevos y revolucionarios,";
    text[12054] = "aquellos que sean capaces de liberarlo primero tienen una gran ventaja.";
    text[12055] = "He hecho unos cuantos enemigos a lo largo de los años, así que tengo algunas";
    text[12061] = "corazonadas sobre quién puede haber contratado a los ravagers para robar nuestra fórmula...";
    text[12062] = "...pero supongo que eso es una investigación para otro día.";
    text[12057] = "Por ahora...";
    text[12058] = "Tendremos que aumentar nuestra ciberseguridad y reforzar nuestras";
    text[12059] = "infraestructuras para garantizar que esto no vuelva a ocurrir.";
    text[12060] = "Gracias de nuevo por salvarnos.";
    text[12047] = "Los tres sois bienvenidos a explorar la Corporación Energ-O como queráis.";
    text[12048] = "¡Genial, gracias!";
    text[12067] = "Oye, ¿estás bien?";
    text[12073] = "No deberías estar aquí ahora.";
    text[12072] = "¿Si estoy bien?";
    text[12068] = "Estoy más que bien...";
    text[12074] = "Todo lo que siento ahora es...";
    text[12063] = "un dulce alivio...";
    text[12075] = "Asqueroso...";
    text[12064] = "Amigo, existe la posibilidad de que este edificio explote.";
    text[12065] = "Por tu propia seguridad, ¡tienes que irte AHORA!";
    text[12066] = "Lo haré, lo haré.";
    text[12069] = "Solo déjame... disfrutar de este fugaz momento.";
    text[12070] = "(Suspiro) Tetra, pide refuerzos para escoltarlo fuera de aquí.";
    text[12071] = "¡Entendido!";
    text[12305] = "DIFICULTAD:";
    text[12306] = "MODO NORMAL";
    text[12308] = "MODO DIFÍCIL";
    text[12307] = "¡LOS ENEMIGOS NORMALES SE CONVIERTEN EN ENEMIGOS EX Y LOS ENEMIGOS EX SE CONVIERTEN EN ENEMIGOS ZX!";
    text[12309] = "MODO LEYENDA";
    text[12310] = "TODOS LOS ENEMIGOS SE CONVIERTEN EN ENEMIGOS ZX";
    text[11058] = "SUMMER'S COVE";
    text[11062] = "CAMINO ABANDONADO";
    text[11063] = "SECTOR 3: MAGNESIA";
    text[11064] = "CÁMARA SELLADA";
    text[12080] = "RAVAGER";
    text[11061] = "CORRUPTOID";
    text[11060] = "NECROMIA";
    text[12124] = "Ráfaga de ruido";
    text[12125] = "Invocar centinela";
    text[12126] = "Explosión necro";
    text[12127] = "Fuerza del espíritu";
    text[12128] = "Aura embrujada";
    text[12129] = "Tajo centinela";
    text[12130] = "Ráfaga corrupta";
    text[12131] = "Aplastamiento mental";
    text[12132] = "Cuchilla fotónica";
    text[12133] = "Ala de asalto";
    text[12134] = "Código ravager";
    text[12135] = "Microbomba";
    text[12083] = "¡Trofeo estrella obtenido!";
    text[12086] = "¡EZ-Aturdimiento obtenido!";
    text[12087] = "¡EZ-Quemadura obtenido!";
    text[12088] = "¡EZ-Barra obtenido!";
    text[12084] = "¡Súper elixir obtenido!";
    text[12085] = "¡Fluido necro obtenido!";
    text[12089] = "¡Llave Energ-O obtenida!";
    text[12090] = "¡Flotador de piscina obtenido!";
    text[12091] = "¡Rompe límites obtenido!";
    text[12098] = "EZ-Aturdimiento";
    text[12099] = "Aturde a un enemigo durante 1 turno";
    text[12100] = "EZ-Quemadura";
    text[12101] = "Quema a un enemigo durante 3 turnos";
    text[12102] = "EZ-Barra";
    text[12103] = "Aumenta en un 50% la barra de lux y antimateria";
    text[12092] = "Energ-O Infinita";
    text[12093] = "Curación completa + regeneración de PV y PE durante 3 turnos";
    text[12094] = "Súper elixir";
    text[12095] = "+70 PE para todos los miembros del grupo";
    text[12096] = "Fluido necro";
    text[12097] = "Revive a un aliado desmayado con un 100% de PV";
    text[12104] = "Llave Energ-O";
    text[12105] = "Otorga acceso a la Corporación Energ-O";
    text[12106] = "Flotador de piscina";
    text[12107] = "¡Es hora de divertirnos bajo el sol!";
    text[12108] = "Rompe límites";
    text[12109] = "¡Aumenta +1 el límite de todas las Habilidades Activas!";
    text[12110] = "Trofeo estrella";
    text[12111] = "Certifica la finalización de la BASE DE DATOS.";
    text[12112] = "Objetivo: Ravagers";
    text[12113] = "Infíltrate en la Corporación Energ-O y arresta a los ravagers.";
    text[12114] = "Objetivo: Desconocido";
    text[12115] = "Investiga a los 'Monstruos de Magnesia' y rescata a los soldados Lunex perdidos.";
    text[12139] = "¿Quieres jugar a AGUAS ONDULANTES?";
    text[11059] = "AGUAS ONDULANTES";
    text[11067] = "SALTAR";
    text[12138] = "¡SPLASH!";
    text[10610] = "SELECCIONAR PERSONAJE";
    text[10611] = "¡NUEVA PUNTUACIÓN MÁXIMA!";
    text[10612] = "PUNTUACIÓN MÁXIMA:";
    text[10613] = "¡BONIFICACIÓN!";
    text[10614] = "¡ASOMBROSO!";
    text[12081] = "¡BASE DE DATOS DE ENEMIGOS EX Y ZX COMPLETADA!";
    text[12082] = "¡Enhorabuena!";
    text[12136] = "Hay unos números grabados en una de las tablas de surf: 202310";
    text[12137] = "CORPORACIÓN ENERG-O: ¡llena tu vida de Energ-O!";
    text[12173] = "Utiliza nuestro código promocional 692533 para ganar premios.";
    text[12166] = "¡La cesta de picnic está llena de aperitivos y barritas de tarta de queso!";
    text[12167] = "¡Es una pelota de playa!";
    text[12168] = "¡Qué bonitas son las palmeras de aquí!";
    text[12169] = "¡Me encantan las rosas y moradas!";
    text[12174] = "¡Es una botella gigante de Energ-O!";
    text[12175] = "Sala de investigación y desarrollo Energ-O";
    text[12176] = "Almacén Energ-O";
    text[12177] = "Departamento de fabricación de Energ-O";
    text[12178] = "Parece que hubo una reunión en esta sala de conferencias.";
    text[12179] = "Esta pizarra inteligente muestra las cifras de ventas trimestrales de la Corporación Energ-O";
    text[12180] = "Esta pizarra inteligente muestra cosas como 'Empleado del mes'...";
    text[12181] = "y otros reconocimientos relacionados con la empresa.";
    text[12182] = "Nickle, ¿quieres adivinar qué hay dentro de estos armarios?";
    text[12183] = "Veamos...";
    text[12184] = "Estamos dentro de la Corporación Energ-O, rodeados de botellas de Energ-O por todas partes...";
    text[12185] = "Apostaría 1000 bytes a que estos armarios están llenos de un surtido de Energ-O.";
    text[12186] = "¡NO! Me debes 1000 bytes, je, je.";
    text[12187] = "¡No puede ser! Entonces, ¿qué demonios hay dentro de estos armarios?";
    text[12188] = "Tienes que estar bromeando...";
    text[12189] = "¡¿Plátanos enlatados?!";
    text[12190] = "¿POR QUÉ?";
    text[12191] = "Hay un documento abierto en el ordenador titulado: Fórmula Energ-O Infinita.";
    text[12192] = "Nunca había visto este tipo de Energ-O...";
    text[12193] = "Esta debe ser la nueva Energ-O Infinita que están desarrollando.";
    text[12194] = "Es una máquina expendedora de refuerzos de habilidades.";
    text[12195] = "Comprar 1 refuerzo de habilidad por 5000 bytes.";
    text[12196] = "Comprar 1 refuerzo de habilidad por 250 astrotecnos.";
    text[12197] = "Comprar 1 refuerzo de habilidad por 50 puntos de habilidad.";
    text[12198] = "¡No tienes suficientes astrotecnos!";
    text[12199] = "¡No tienes suficientes bytes!";
    text[12200] = "Es una máquina de cambio de puntos de habilidad.";
    text[12201] = "¿Te gustaría cambiar 50 puntos de habilidad por 5000 bytes?";
    text[12202] = "¡No tienes suficientes puntos de habilidad!";
    text[12203] = "¡Es una máquina expendedora de Hiperenergo-O!";
    text[12204] = "¿Quieres comprar una Hiperenergo-O con descuento por 1000 bytes?";
    text[11065] = "Es un robot abandonado...";
    text[11066] = "...no parece responder.";
    text[12205] = "Saros y Vivia";
    text[12208] = "Olvídalo.";
    text[12206] = "?????";
    text[12207] = "ERROR... ERROR... DATOS NO ENCONTRADOS...";
    text[12209] = "ADVERTENCIA... ADVERTENCIA...";
    text[12210] = "GENERADORES DE HOLOGRAMAS... SOBRECARGA CRÍTICA...";
    text[12231] = "ADVERTENCIA, NO PASAR. ESTE ES UN SECTOR INESTABLE.";
    text[12232] = "ATRAVESAR EL SECTOR 3 Y EL CAMINO ABANDONADO ESTÁ ESTRICTAMENTE PROHIBIDO.";
    text[12234] = "PUENTE HACIA EL SECTOR 3";
    text[12235] = "PERIFERIA DEL SECTOR 3";
    text[12236] = "Es un panel eléctrico.";
    text[12237] = "Esta máquina expendedora está fuera de servicio...";
    text[12238] = "Es un aviso de evacuación de emergencia...";
    text[12239] = "Es un cartel que anuncia un grupo de terapia cicloide.";
    text[12240] = "PRESENTA TUS RESPETOS A LAS ALMAS INQUIETAS DE LAS DOCE LÁPIDAS...";
    text[12241] = "...Y EL FLUIDO NECRO SERÁ TUYO.";
    text[12255] = "LAS ALMAS INQUIETAS DE LAS DOCE LÁPIDAS HAN SIDO LIBERADAS...";
    text[12256] = "...EL FLUIDO NECRO AHORA ES TUYO.";
    text[12242] = "Has presentado tus respetos a las almas de los difuntos.";
    text[12243] = "¡La extraña lápida empezó a brillar!";
    text[12244] = "QUEDAN ONCE LÁPIDAS...";
    text[12245] = "QUEDAN DIEZ LÁPIDAS...";
    text[12246] = "QUEDAN NUEVE LÁPIDAS...";
    text[12247] = "QUEDAN OCHO LÁPIDAS...";
    text[12248] = "QUEDAN SIETE LÁPIDAS...";
    text[12249] = "QUEDAN SEIS LÁPIDAS...";
    text[12250] = "QUEDAN CINCO LÁPIDAS...";
    text[12251] = "QUEDAN CUATRO LÁPIDAS...";
    text[12252] = "QUEDAN TRES LÁPIDAS...";
    text[12253] = "QUEDAN DOS LÁPIDAS...";
    text[12254] = "QUEDA UNA LÁPIDA...";
    text[12257] = "Vermil";
    text[12264] = "Kit parece estar teniendo una conversación con Vermil,";
    text[12265] = "pero todo lo que oyes son ruidos de zorro...";
    text[12258] = "¡Hola! Soy Bella.";
    text[12259] = "No te he visto por aquí antes... ¿Eres una nueva recluta?";
    text[12260] = "No. Llevo un tiempo...";
    text[12261] = "...demasiado como para acordarme, en realidad.";
    text[12277] = "Dado mi trabajo... diría que soy una recluta 'antigua', ja, ja.";
    text[12278] = "Oh, ¿cuál es tu trabajo?";
    text[12262] = "Acabo de regresar de una expedición de un año, en la que me encargaron";
    text[12274] = "localizar ruinas y artefactos antiguos.";
    text[12275] = "Ahh... Ya veo.";
    text[12263] = "En ese caso, bienvenida de nuevo, eh...";
    text[12267] = "Lo siento, olvidé presentarme.";
    text[12268] = "Me llamo Vermil, y este es mi fiel compañero zorro, Kit.";
    text[12269] = "¡Kit es taaaan adorable!";
    text[12270] = "Es una espada muy buena la que tienes ahí...";
    text[12276] = "Mi instinto de cazador de tesoros me dice que esa espada es 'antigua'.";
    text[12271] = "Buen ojo.";
    text[12272] = "Nota mental... Tengo que llevarte a una de mis expediciones algún día...";
    text[12279] = "Mmm...";
    text[12281] = "¡Nickle! Me llamo Nickle.";
    text[12282] = "'Nickel' como el metal plateado, o Nickle como...";
    text[12283] = "¿Pickle?";
    text[12286] = "Sí.";
    text[12287] = "Sí, es Nickle como un pickle...";
    text[12284] = "Mmm... Interesante nombre.";
    text[12285] = "(TODO ESTE TIEMPO PENSÉ QUE SE DELETREABA COMO EL METAL.)";
    text[12273] = "En fin... Esta es una antigua espada llamada 'Nebulosa Celestial'.";
    text[12280] = "La encontré en una de mis expediciones hace muchos años.";
    text[12288] = "Nickle... Bella...";
    text[12289] = "Hay muchos artefactos antiguos por ahí para que los descubramos.";
    text[12290] = "Si vosotros dos alguna vez encontráis otros artefactos antiguos...";
    text[12291] = "¡Por favor, enseñádmelos!";
    text[12292] = "Tengo un SÚPER ELIXIR con vuestros nombres, si es así.";
    text[12288] = "Nickle... Bella...";
    text[12293] = "Vuestras espadas... ¡son INCREÍBLEMENTE ANTIGUAS! ¡SE VEN TAN GENIALES!";
    text[12294] = "Mi espada se llama 'Excalibur'.";
    text[12295] = "...y la mía 'Espada Reliquia'.";
    text[12296] = "(Ojalá tuviera una espada antigua...)";
    text[12297] = "Gracias por mostrarme vuestras espadas.";
    text[12298] = "Como os prometí... Aquí tenéis un SÚPER ELIXIR con vuestros nombres.";
    text[12299] = "Vermil, en realidad no tenías que poner nuestros nombres...";
    text[12300] = "Pfff... Dice Bella y Pickle. Ja.";
    text[12301] = "Ey, no me mires a mí.";
    text[12302] = "Fue idea de Kit.";
    text[12303] = "Mi sueño...";
    text[12304] = "es que mi futuro no sea más que 'antiguo'.";
    text[12337] = "¡Raine nos dijo que nos reuniéramos con ella en Summer's Cove!";
    text[12338] = "Es una pequeña playa al norte de Oceanus, en el mapa del mundo.";
    text[12319] = "¡Es hora de divertirnos bajo el sol!";
    text[12311] = "La entrada a Magnesia...";
    text[12312] = "...debe situarse entre las Fosas de Silica y la Colonia Silica.";
    text[12344] = "¡Tenemos que perseguir a esos extraños 'monstruos' que vimos en el puente!";
    text[12365] = "Necromia es una entidad guardiana que puede controlar la mente...";
    text[12366] = "Eso da bastante miedo...";
    text[12367] = "Estaré atenta a cualquier cosa sospechosa a medida que avancemos.";
    text[12314] = "Nickle...";
    text[12315] = "Ha pasado momentos muy duros...";
    text[12316] = "¡No podemos dejar que nos aleje! ¡Tenemos que encontrarlo!";
    text[12317] = "Me sorprende que los árboles púrpura de aquí sean capaces de sobrevivir en este clima.";
    text[12318] = "La madre naturaleza es bastante resistente, je, je.";
    text[12320] = "¡Has encontrado un paquete de carga abandonado!";
    text[12326] = "Oh, ¿qué hay dentro del paquete?";
    text[12327] = "Uh... Nada.";
    text[12321] = "Está vacío.";
    text[12322] = "Esta zona fue destruida hace muchos años...";
    text[12323] = "Quien haya perdido esto probablemente ya no lo esté buscando.";
    text[12324] = "¡Yo digo que lo guardemos como recuerdo!";
    text[12325] = "¿Cómo? ¿Por qué?";
    text[12328] = "Me gustaría pensar que es un pedazo de la historia de Luna.";
    text[12329] = "Mmm... Supongo que sí...";
    text[12330] = "Muy bien, lo guardaremos por ahora.";
    text[12331] = "¡Yaaaay!";
    text[12332] = "CEO";
    text[12333] = "Empleado";
    text[12334] = "En la tele están poniendo una película llamada 'Los juegos hambrientos'.";
    text[12335] = "Refuerzo de habilidad (5000 Bytes)";
    text[12336] = "Refuerzo de habilidad (250 Astrotecnos)";
    text[12339] = "Creo que aún hay algunos ravagers merodeando por nuestro edificio...";
    text[12340] = "Si te los encuentras, por favor, ocúpate de ellos como corresponde.";
    text[12342] = "¿Deseas reiniciar esta misión?";
    text[12343] = "(Esto reiniciará la progresión de la historia y el contador de 'Turnos restantes').";
    text[12345] = "Aumenta el PWR de todas las habilidades activas en 15.";
    text[12346] = "Debo admitir...";
    text[12347] = "También aprovecho esto para probar nuevas técnicas.";
    text[12348] = "Cuento contigo para que lo des todo.";
    text[12349] = "Esta agradable brisa...";
    text[12350] = "Nuestros hermosos océanos...";
    text[12351] = "Hay que proteger a Luna a toda costa.";
    text[12352] = "No permitiré que nadie nos arrebate esto.";
    text[12353] = "Yo tampoco.";
    text[12354] = "Ni yo.";
    text[12355] = "Uniendo fuerzas, saldremos adelante.";
    text[12356] = "Tengo esperanza.";
    text[12357] = "¡Ahora puedes mejorar tus habilidades activas hasta el nivel 4!";
    text[12359] = "Un enemigo infligido con quemadura perderá el 10% de sus PV MÁXIMOS (máx. 100 daño)";
    text[12360] = "durante un número determinado de turnos.";
    text[12361] = "¡Bella, tenemos que derrotar a los ravagers antes de que este edificio explote!";
    text[12362] = "Pero si alguna vez sientes que estás atascada...";
    text[12363] = "Siempre podemos reiniciar la misión en la entrada de este edificio.";
    text[12368] = "RAVAGER JEFE";
    text[12390] = "OPCIONES";
    text[12369] = "¿Quieres abandonar el edificio?";
    text[12370] = "PUNTOS:";
    text[12371] = "No nos subestimes, Necromia.";
    text[12372] = "¡Sí! ¡No vamos a caer tan fácilmente!";
    text[12373] = "Se acabó...";
    text[12374] = "... ... ...";
    text[12375] = "Las personas de Magnesia...";
    text[12376] = "...finalmente podrán descansar.";
    text[12379] = "Experta\nen olas";
    text[12380] = "Experta en olas";
    text[12381] = "FASE AURA";
    text[12382] = "FASE AURA: ¡inmune a ataques normales que inflijan menos de 100 puntos de daño!";
    text[12383] = "FUERZA DE ESPÍRITU: inmune a ataques normales. Debilidad: Combos Lux + Modo Fase.";
    text[12384] = "AURA EMBRUJADA: el enemigo recupera PV lentamente en tiempo real.";
    text[12385] = "CÓDIGO RAVAGER: 50% de probabilidad de que el enemigo inflija 2 veces daño.";
    text[12386] = "ENEMIGOS NORMALES";
    text[12387] = "ENEMIGOS EX";
    text[12388] = "ENEMIGOS ZX";
    text[12389] = "TODOS LOS ENEMIGOS";
    text[12391] = "DESCONECTAR";
    text[12392] = "GESTIONAR SUBSCRIPTIÓN";
    text[12393] = "ELIMINAR MI CUENTA";
    text[13000] = "Russian";
}

    text[7894] = "Reduz o mínimo da habilidade de apoio para 8";
    text[7895] = "Chip de Poder";
    text[7896] = "Aumenta o dano do Combo Lux e do Modo Fásico";
    text[7897] = "Chip Lendário";
    text[7898] = "Aumenta o limite máximo de habilidade de apoio vermelho em 2";
    text[7900] = "Ei! A água aqui parece gelatina!";
    text[7901] = "Hm... A gravidade aqui é um pouco mais fraca que o normal.";
    text[7902] = "Acho que estamos longe demais do gerador gravitacional mais próximo.";
    text[7903] = "Essas tubulações são parte de uma grande rede que leva água do";
    text[7904] = "oceano lunar norte para as colônias locais.";
    text[7905] = "Esses caixotes contêm equipamentos usados em escavações arqueológicas!";
    text[7906] = "As gravuras nesta tabuleta mostram uma guerra antiga.";
    text[7907] = "Os corpos dos guerreiros parecem estar envoltos em uma área estranha.";
    text[7908] = "A DUALIDADE DA ANTIMATÉRIA E DA LUX...";
    text[7909] = "O restante dos entalhes está ilegível.";
    text[7910] = "Você olha pela janela para admirar a silhueta da cidade.";
    text[7911] = "Há um monte de atum enlatado por trás do vidro do armário.";
    text[7912] = "Psiu, Bella... Posso ver o que tem dentro?";
    text[7913] = "Não deveríamos mexer nas coisas dos outros.";
    text[7914] = "... Mas você não está curiosa? Nem um pouquinho?";
    text[7915] = "Bom... sim...";
    text[7916] = "A vontade de explorar e examinar cada detalhe...";
    text[7917] = "É uma bênção e uma maldição para aventureiras curiosas como nós...";
    text[7918] = "É uma pintura chamada 'O Infinito Agora.'";
    text[7919] = "É uma estatueta da Edição de Colecionador da Pretty Peach Ultimate!";
    text[7920] = "Aposto que essas caixas contêm um monte de pelúcias e itens de colecionador.";
    text[7921] = "Bom, você está certíssima, Detetive Tetra!";
    text[7922] = "Vou instalar novas prateleiras para que eu possa expor tudo direitinho. Hehe.";
    text[7923] = "É BluBlu, o Alienígena, da série do Capitão Lua!";
    text[7924] = "É uma pelúcia da YeloMelo e uma pintura de um cachorro fofinho intitulada 'Novos Horizontes'.";
    text[7925] = "É o Armário Senpai do anime Chairem!";
    text[7926] = "É um ursinho de lavanda!";
    text[7927] = "Peguei um desses de uma máquina de ursinhos!";
    text[7928] = "Um ursinho marrom clássico!";
    text[7929] = "Ganhei esse na máquina de pegar bichinhos no fliperama!";
    text[7930] = "Máquinas de pegar bichinhos são viciantes...";
    text[7931] = "Há um monte de eletrodomésticos atrás do vidro do armário.";
    text[7932] = "É uma pintura chamada 'Não perca seu caminho'!";
    text[7933] = "Um anime chamado 'Three Piece' está passando na TV.";
    text[7934] = "É uma pintura chamada 'Beijo da Morte'.";
    text[7935] = "Um anime chamado 'Life Note' está passando na TV.";
    text[7936] = "Há uma pintura na parede intitulada 'Monado'.";
    text[7937] = "É um protótipo de traje espacial bem estiloso!";
    text[7938] = "Há um monte de peças robóticas, microchips e peças eletrônicas no armário de vidro!";
    text[7939] = "Um anime chamado 'Os Titãs Atacam' está passando na TV.";
    text[7940] = "Um monte de equipamento de treino e luvas de boxe estão no chão.";
    text[7941] = "Ei, Bella, que ser meu novo saco de pancadas? BAHAHAHA!";
    text[7942] = "É a cadeira gamer ergonômica mais popular do mercado!";
    text[7943] = "GASTEI TODO ESSE DINHEIRO E MINHAS COSTAS AINDA DOEM! NÃO DÁ PARA ENTENDER!";
    text[7944] = "É um setup supercaro de jogos com três monitores.";
    text[7945] = "Também comprei a última placa de vídeo que saiu. Hehehe.";
    text[7946] = "Preciso ter a melhor configuração possível para poder";
    text[7947] = "bater o Ranque Radiante no jogo que estou jogando.";
    text[7948] = "O Café Tycho é um ótimo lugar para pessoas criativas e talentosas";
    text[7949] = "se juntarem graças ao nosso maravilhoso palco de talentos!";
    text[7950] = "Sempre temos músicos, cantores, comediantes,";
    text[7951] = "artistas e dançarinos prontos para entreter!";
    text[7952] = "Há uma lista de pessoas desaparecidas no quadro de avisos...";
    text[7953] = "Essas caixas contêm uma variedade de vitaminas de melhora de conhecimentos.";
    text[7954] = "Também há umas Levipedras quebradas no chão.";
    text[7955] = "Parece que foram usadas bastante nos treinos.";
    text[7956] = "Esta prateleira está cheia de livros sobre artes marciais e meditação.";
    text[7958] = "Muito legal que você leia tantos livros, Zara!";
    text[7959] = "Ler me ajuda a relaxar depois de um longo dia de treinos.";
    text[7960] = "Você deveria experimentar um dia!";
    text[7957] = "É um livro chamado '101 Técnicas Úteis de Batalha'.";
    text[7961] = "As Levipedras da Zara estão apoiadas em suas estações de carga.";
    text[7962] = "É um mapa das Fendas de Sílica!";
    text[7963] = "O que as marcações verdes indicam?";
    text[7964] = "Não sei, mas minha intuição caça-tesouros está coçando.";
    text[7965] = "É um gancho de escalada certificado da Guilda dos Caçadores de Tesouros!";
    text[7966] = "É uma pá certificada da Guilda dos Caçadores de Tesouros!";
    text[7967] = "É uma picareta certificada da Guilda dos Caçadores de Tesouros!";
    text[7968] = "Artefatos históricos e tesouros estão expostos neste armário.";
    text[7969] = "Um filme chamado 'O Cãovaleiro das Trevas' está passando na TV.";
    text[7970] = "Procurando aventuras? ENTRE NA GUILDA DOS CAÇADORES DE TESOUROS HOJE MESMO!";
    text[7971] = "Querida, você parece estar fugindo de alguma coisa.";
    text[7972] = "Ahn? Como você sabe?";
    text[7973] = "Bom, você passa essa sensação. Dá para ver nos seus olhos.";
    text[7974] = "Relaxe um pouco, pode ser?";
    text[7975] = "Não dá para fugir dos seus problemas para sempre...";
    text[7976] = "Em algum momento, você terá que enfrentá-los de frente.";
    text[7977] = "... e você?";
    text[7978] = "E-eu?";
    text[7979] = "Você carrega um luto aparente nos olhos.";
    text[7980] = "Espero que algum dia tenha a força necessária para superá-lo.";
    text[7983] = "Esses caixotes estão marcados como 'CONFIDENCIAL'.";
    text[7981] = "Saros provavelmente guardou equipamentos de seus experimentos secretos";
    text[7982] = "ao longo dos anos nesta sala de armazenamento...";
    text[7984] = "É um fosso de mina desabado.";
    text[7985] = "O que é, Bella?";
    text[7986] = "É uma lista de pessoas desaparecidas... Foi atualizada hoje.";
    text[7987] = "Parece que várias pessoas desapareceram depois do surto.";
    text[7988] = "Será que Saros sabia disso?";
    text[7989] = "Por que ele não falou a respeito em seu discurso de vitória?";
    text[7990] = "Esse surto deve ter sido uma experiência aterrorizante para muitas pessoas...";
    text[7999] = "Quem sabe ele quis manter o ânimo vitorioso de todos?!";
    text[7991] = "Apesar de não haver fatalidades,";
    text[7992] = "muitos cidadãos e soldados ainda se machucaram.";
    text[7993] = "... E agora há pessoas desaparecidas...";
    text[8001] = "Também não tive a chance de conversar devidamente com o Murktador...";
    text[8000] = "Nada disso parece uma vitória para mim...";
    text[8002] = "Você não é assim, Bella...";
    text[8003] = "Você precisa ser otimista! As coisas poderiam ter sido bem piores!";
    text[7994] = "Devemos deixar a Equipe de Buscas da Força Lunex procurar as pessoas desaparecidas.";
    text[7995] = "Tenho certeza de que ela os encontrará!";
    text[7996] = "Agora, você precisa de um descanso merecido! Você fez um ótimo trabalho hoje!";
    text[7997] = "Ok... Você tem razão. Vamos para casa!";
    text[8004] = "Acho que devemos nos concentrar na missão agora.";
    text[8005] = "Poderemos explorar a cidade depois.";
    text[8006] = "Quer entrar na mina?";
    text[8008] = "Ei, você é a Bella Grey, né?";
    text[8009] = "Sua ajuda seria muito bem-vinda agora...";
    text[8010] = "O que aconteceu?";
    text[8011] = "Estava patrulhando o monte Piton quando um Murk gigante me atacou.";
    text[8012] = "Enquanto tentava fugir, deixei cair minha Sabristola...";
    text[8013] = "Assim... estou feliz de não ter morrido, mas...";
    text[8014] = "Aquela Sabristola é muito importante para mim...";
    text[8015] = "Foi um presente do meu pai.";
    text[8016] = "Sem ela, não posso fazer meu trabalho direito...";
    text[8017] = "Meus colegas me disseram para deixar para lá e usar uma nova Sabristola, mas...";
    text[8018] = "Não consegui...";
    text[8019] = "Eu tentei, mas... não parece certo.";
    text[8020] = "Sabe, eu entendo. Aquela Sabristola significa muito para você.";
    text[8021] = "Nós ajudaremos a procurá-la!";
    text[8022] = "Cara, sem nem como agradecer a ajuda!";
    text[8023] = "Acho que deixei cair a Sabristola no pico do Monte Piton.";
    text[8024] = "Você foi capaz de identificar o Murk que o atacou?";
    text[8025] = "Não... não estava no banco de dados.";
    text[8026] = "Parecia um centauro híbrido usando uma armadura de Exoesqueleto.";
    text[8027] = "Nunca vi nada parecido!";
    text[8028] = "Obrigada pelos detalhes.";
    text[8029] = "Ficaremos de olho para ver se o Murk aparece enquanto procuramos sua Sabristola.";
    text[8030] = "Obrigado, senhorita Bella! Ficarei esperando aqui.";
    text[8031] = "Você encontrou minha Sabristola! Realmente a encontrou!";
    text[8032] = "Sim e derrotamos o Murk que o atacou também!";
    text[8033] = "O Monte Piton já deve estar seguro para ser patrulhado novamente!";
    text[8034] = "Isso é um grande alívio!";
    text[8035] = "Por favor, aceite isso pelo trabalho que dei, senhorita Bella.";
    text[8036] = "É o mínimo que posso fazer.";
    text[8037] = "Um soldado sem sua fiel Sabristola é como pizza sem queijo...";
    text[8038] = "Você encontrou a Sabristola do Barry!";
    text[8039] = "Olá! Sou a chefe de química do departamento de ciências,";
    text[8040] = "e estou em uma missão de pesquisa para criar o melhor fluido de cura!";
    text[8041] = "Se estiver livre, uma ajudinha viria a calhar. O que me diz?";
    text[8042] = "Aaah! Eu quero ajudar! Do que precisa?";
    text[8043] = "Meu experimento atual requer um ELIXIR e um REVIFLUIDO!";
    text[8055] = "Assim que conseguir um de cada, traga-os para mim!";
    text[8044] = "Certo! Pode contar com a Super-Química Tetra para isso!";
    text[8045] = "Aqui está o ELIXIR e o REVIFLUIDO que pediu!";
    text[8046] = "Maravilha!";
    text[8047] = "Então, acha que conseguirá criar o melhor fluido de cura com eles?";
    text[8048] = "Na verdade...";
    text[8049] = "Talvez leve alguns anos para chegar à fórmula química aperfeiçoada.";
    text[8050] = "Ah.";
    text[8051] = "Não se desanime! Chegarei lá um dia. Tenho certeza disso!";
    text[8052] = "Só preciso dar um passo de cada vez.";
    text[8053] = "Por agora, aceite este presente!";
    text[8059] = "Ener-G Lendário e Holofluido obtidos!";
    text[8054] = "Um dia, vou criar o melhor fluido de cura!";
    text[8056] = "Tenho certeza disso!";
    text[8057] = "Boa sorte na sua pesquisa!";
    text[8058] = "Obrigada!";
    text[8060] = "Você parece alguém que aprecia a beleza da natureza.";
    text[8061] = "Com certeza! Também amo explorar.";
    text[8062] = "Esplêndido! Você tem o currículo perfeito, meu bem.";
    text[8090] = "Você está contratada! Ohohohoho!";
    text[8063] = "Ahn?!";
    text[8064] = "Estou procurando um assistente para me ajudar na minha pesquisa botânica.";
    text[8065] = "Os surgimentos de Murks aumentou ultimamente, então tem sido difícil fazer trabalho de campo.";
    text[8066] = "Sua tarefa é documentar e coletar amostras de três espécies de plantas diferentes";
    text[8067] = "que podem ser encontradas em Luna.";
    text[8068] = "Quais espécies você está procurando?";
    text[8089] = "(AAAAH! Eu não me alistei para isso!)";
    text[8069] = "Não se preocupe, meu bem. Esse é um trabalho pago.";
    text[8070] = "Você receberá bem pelos seus esforços!";
    text[8071] = "(Ela acabou de ler a minha mente?!)";
    text[8072] = "Meu bem, seus pensamentos estão estampados na sua cara!";
    text[8073] = "Também sou boa em ler pessoas. Hohohoho!";
    text[8074] = "Agora, onde eu estava. Eu...";
    text[8075] = "... Ah, claro. Três espécies de plantas...";
    text[8076] = "Primeiro, preciso de uma amostra da Camélia Lunar.";
    text[8077] = "Camélias Lunares são comumente encontradas em Regolithia. Ohohoho!";
    text[8078] = "Em segundo lugar, preciso de uma amostra da Flox-da-noite.";
    text[8079] = "Acredito que a Flox-da-noite cresce em abundância em Copernicus. Ohohoho!";
    text[8080] = "Por último, preciso de uma amostra do Coral Harmonia.";
    text[8081] = "Elas são nativas de um lugar chamado 'Recife Harmonia' em Oceanus...";
    text[8091] = "(Ohohohoho!)";
    text[8082] = "Rápido, meu bem! Você tem muitas amostras para coletar!";
    text[8083] = "(... E muitas informações para lembrar... Meu céu amado...)";
    text[8084] = "Caso se esqueça dos detalhes da tarefa, é só perguntar!";
    text[8085] = "Não precisa ter vergonha, meu bem. Ohohoho!";
    text[8086] = "Então, trouxe as amostras de plantas que você pediu.";
    text[8087] = "Esplêndido! Obrigada mais uma vez por me ajudar com a pesquisa, meu bem!";
    text[8088] = "Aqui está sua recompensa...";
    text[8092] = "Você ganhou 10.000 bytes e um chiclete!";
    text[8093] = "Não pensa em mudar de emprego? Tenho bastante trabalho, meu bem!";
    text[8094] = "Hm... Quem sabe na próxima...";
    text[8095] = "(AHHHHHHHHH!)";
    text[8096] = "Ohohohoho!";
    text[8097] = "Camélia Lunar obtida!";
    text[8098] = "Flox-da-noite obtida!";
    text[8099] = "Coral Harmonia obtido!";
    text[8101] = "Também tem um bilhete embaixo dessa barra de cheesecake! Está escrito:";
    text[8102] = "'Que demais! Você é a candidata perfeita!'";
    text[8103] = "'Encontre-me na frente do Café Copernicus.'";
    text[8105] = "Talvez valha a pena conhecer essa pessoa misteriosa cara a cara!";
    text[8106] = "Vamos nessa!";
    text[8107] = "Com licença. Foi você que nos colocou em uma caça às Barras de Cheesecake?";
    text[8108] = "Sim, eu mesma! Meu nome é Melski.";
    text[8109] = "Que bom finalmente conhecê-la!";
    text[8110] = "Sabe, o motivo de eu ter preparado essa atividade elaborada";
    text[8111] = "foi porque preciso de alguém realmente perfeito para testar sabores...";
    text[8112] = "... Alguém que realmente entenda e aprecie uma boa Barra de Cheesecake.";
    text[8130] = "Eu nunca digo não para Barras de Cheesecake!";
    text[8131] = "Só vamos! Qual devo experimentar primeiro?";
    text[8113] = "Bom, queria que você experimentasse uma das Barras de Cheesecake que coletou!";
    text[8114] = "A verdade é que eu que as preparei!";
    text[8115] = "AAAAAAAHHHH! MELSKI, QUE DELÍCIA!";
    text[8116] = "O gosto é ainda melhor do que a Barra de Cheesecake normal!";
    text[8117] = "Você precisa me contar qual é o segredo!";
    text[8118] = "Fico feliz que gostou!";
    text[8119] = "Tenho trabalhado nessa receita faz um tempo já!";
    text[8120] = "Meu sonho é abrir minha própria padaria vegana um dia.";
    text[8121] = "Bom, como parceira especialista em Barras de Cheesecake,";
    text[8122] = "preciso falar. Esse é o melhor cheesecake que já provei!";
    text[8123] = "Quando sua padaria estiver funcionando, serei sua cliente número 1!";
    text[8124] = "Isso significa muito para mim! Obrigada!";
    text[8125] = "Por favor, aceite este presente. De uma fanática por cheesecakes para outra.";
    text[8126] = "Eu realmente fico feliz de ver outras pessoas gostando do que preparo.";
    text[8127] = "Você está trabalhando em alguma receita nova?";
    text[8128] = "No momento, estou criando uma nova receita de brownies veganos deliciosos!";
    text[8129] = "Hmmmm! Se precisar de alguém para degustar, me chame!";
    text[8132] = "Olá! Estou com algumas Partes de Nave para vender.";
    text[8133] = "Não gostaria de dar uma olhadinha?";
    text[8134] = "Veja só!";
    text[8135] = "Esse é o mercado clandestino, garota.";
    text[8136] = "Você não deveria estar aqui.";
    text[8137] = "Contudo...";
    text[8138] = "Negócios são negócios.";
    text[8139] = "Estou vendendo Partes de Nave legalmente obtidas...";
    text[8140] = "... com ênfase no 'legalmente'";
    text[8141] = "Compre alguma coisa ou caia fora!";
    text[8142] = "Pelos céus, que vergonha. Meu quarto está uma bagunça agora!";
    text[8143] = "Ah, não se preocupe, Melody!";
    text[8144] = "Só demos uma paradinha para conversar com você. Hihi.";
    text[8145] = "É impressão minha ou você está com pelúcias novas?";
    text[8146] = "Sim! Minha coleção aumentou.";
    text[8147] = "Tudo aqui é tão...";
    text[8148] = "FOFINHO e MACIO!";
    text[8149] = "Coletar pelúcias raras e bonecos é meu passatempo favorito. Hehehe.";
    text[8150] = "Falando em pelúcias raras...";
    text[8151] = "Há uma pelúcia super ultra cara que tenho juntado para comprar...";
    text[8152] = "... e ela vai ser lançada daqui a três dias.";
    text[8153] = "O problema é que... Não consegui economizar dinheiro o suficiente.";
    text[8154] = "Se eu não a comprar assim que lançar, o estoque vai esgotar RÁPIDO!";
    text[8155] = "Eu perderei a chance de consegui-la...";
    text[8156] = "Entããão. Eu estava aqui pensando...";
    text[8157] = "Você não quer comprar algumas pelúcias para que eu possa";
    text[8158] = "juntar o dinheiro para a pelúcia rara que sempre quis?";
    text[8159] = "Melody, é claro que vamos ajudá-la!";
    text[8160] = "Na verdade, faz pouco tempo que eu comecei uma coleção de pelúcias.";
    text[8161] = "Ebaaa!";
    text[8162] = "Essas são as pelúcias que estou vendendo... Se quiser comprar todas,";
    text[8163] = "eu terei dinheiro o suficiente para a pelúcia rara que eu quero!";
    text[8164] = "Ebaaa! Você comprou todas! Muito obrigada, Bella!";
    text[8165] = "Tudo por uma boa amiga. Hehehe.";
    text[8166] = "Tome, pode ficar com isso também!";
    text[8167] = "Ei, Melody, o que exatamente é essa pelúcia que você quer comprar?";
    text[8168] = "É uma edição limitada...";
    text[8169] = "Uma pelúcia da Milky de 3 metros com cheiro de morango!";
    text[8170] = "Pelo Big Bang! Isso é GIGANTE!";
    text[8171] = "Ela vem com um batedor de milkshake de morando dentro!";
    text[8172] = "EU PRECISO! EU PRECISO DELA AGORAAAA!";
    text[8391] = "Olá, hm...";
    text[8392] = "Oi, tudo certo?";
    text[8179] = "Você é fã de patos?";
    text[8180] = "Espero que sim...";
    text[8181] = "Eu amo patos. Eles são mega fofos!";
    text[8182] = "NÉ??";
    text[8183] = "Patos são tão lindinhos, falantes e cheios de personalidade!";
    text[8184] = "Eles são tão.@P.@P.@P";
    text[8185] = "De-desculpa... Eu não sei me controlar quando falo sobre animais...";
    text[8186] = "... Especialmente sobre patos.";
    text[8393] = "Hmm. De qualquer forma, meu nome é LO-Ogi.";
    text[8178] = "Sou um androide e orgulhoso proprietário do santuário de aves do Rancho Kepler!";
    text[8187] = "Acha que poderia me ajudar com uma coisinha...";
    text[8188] = "... que tem a ver com patos?";
    text[8206] = "Claro! Que manda?";
    text[8190] = "Fiquei lendo no meu tempo livre sobre a beleza histórica da";
    text[8191] = "fauna da Terra antes de sua destruição.";
    text[8189] = "Isso realmente me faz apreciar a fauna aqui em Luna.";
    text[8192] = "Dediquei a maioria da minha vida operacional a manter os";
    text[8193] = "animais no meu santuário seguros, felizes e saudáveis.";
    text[8194] = "Dito isso, me envergonha dizer que.@P.@P.@P";
    text[8205] = "PERDI OS MEUS PATOS!";
    text[8195] = "Ahn?! Você perdeu seus patos??";
    text[8196] = "Tenho cuidado de 3 patos aventureiros que parecem ter o";
    text[8197] = "péssimo hábito de se perderem facilmente.";
    text[8198] = "Não os culpo...";
    text[8199] = "Eles são muito curiosos e querem sair em suas próprias aventuras!";
    text[8200] = "Eu os deixo andar por aí livres porque sempre acabam";
    text[8201] = "encontrando o caminho de volta para casa... exceto por hoje...";
    text[8202] = "Estou preocupado... Espero que eles estejam bem...";
    text[8203] = "Ei. Vamos ajudá-lo a encontrar seus patos perdidos! Não se preocupe!";
    text[8394] = "Meio que... Eu também quero ver quão fofos eles são!";
    text[8204] = "O-obrigado!";
    text[8207] = "Você tem ideia de onde os patos podem estar?";
    text[8208] = "Perdi um total de 3 patos.";
    text[8209] = "Um deles realmente odeia o frio...";
    text[8210] = "Ele usa um cachecol verde!";
    text[8211] = "Imagino que esteja andando por algum lugar QUENTE.";
    text[8212] = "Outro deles ama curtir em terraços de arranha-céus...";
    text[8213] = "Então provavelmente está andando por alguma das cidades.";
    text[8214] = "... e, hm... a terceira...";
    text[8215] = "Ela é a pata mais inteligente que já cuidei...";
    text[8216] = "... e ela ama especificamente solucionar quebra-cabeças com lasers...";
    text[8217] = "Uau...";
    text[8218] = "É... como eu disse, patos são cheios de personalidade!";
    text[8219] = "Obrigada pelas informações, LO-Ogi.";
    text[8225] = "Encontraremos seus patos, eu prometo!";
    text[8173] = "Quá! Quá!";
    text[8174] = "Você encontrou um dos patos aventureiros do LO-Ogi!";
    text[8175] = "Quá! LO-Ogi está preocupado com você! Hora de ir para casa!";
    text[8220] = "Estou tão feliz! Todos os três voltaram para casa!";
    text[8221] = "Obrigado por me ajudar!";
    text[8222] = "Ah! Deveria compensá-la de alguma forma...";
    text[8223] = "Hm...";
    text[8224] = "Aceitaria isso como presente?";
    text[8176] = "Você ganhou 200 astrotecas e um chiclete!";
    text[8226] = "Sabe de onde vem meu nome?";
    text[8227] = "É um pouco estranho...";
    text[8228] = "Ele significa: Lunar-Observador de OrGanismos.";
    text[8229] = "Eu, hm... Esqueci o que o 'i' no final significa.";
    text[8230] = "... mas acho que não seja importante.";
    text[8231] = "Obrigado mais uma vez por me ajudar a encontrar meus patos!";
    text[8232] = "Ei, Zara! Que manda?";
    text[8233] = "Estou fazendo uma pequena pausa do treino para meditar.";
    text[8234] = "É importante fortalecer tanto o corpo quanto a mente!";
    text[8235] = "Alguma técnica nova ou novos Combos Lux?";
    text[8236] = "Talvez você acabe me ensinando uma coisa ou outra.";
    text[8237] = "Na verdade...";
    text[8238] = "Eu poderia dizer o mesmo de você.";
    text[8239] = "Gostaria de aprender algumas coisas com você.";
    text[8240] = "Hm... Eu??";
    text[8241] = "Por que não? Você é uma lutadora hábil e eu admiro seu talento.";
    text[8242] = "Tenho certeza de que conheceu um monte de Combos Lux que nunca vi.";
    text[8243] = "Então, minha proposta é a seguinte...";
    text[8244] = "Se você puder me mostrar pelo menos 20 Receitas de Combos Lux diferentes do seu BANCO DE DADOS...";
    text[8245] = "Eu lhe darei uma nova Receita de Combo Lux e...";
    text[8246] = "Como bônus, também ensinarei como usar minhas Levipedras.";
    text[8247] = "Combinado!";
    text[8248] = "Hmm...";
    text[8249] = "Ahn?!";
    text[8250] = "Interessante...";
    text[8251] = "Essa definitivamente é uma combinação única de habilidades...";
    text[8252] = "Hm... saquei...";
    text[8253] = "Se eu fizer isso, aí...";
    text[8254] = "Bom, agora...";
    text[8255] = "Graças a você, agora tenho um turbilhão de ideias para me inspirar com novos combos!";
    text[8256] = "Como prometido, aqui está uma nova receita de Combo Lux para você, Bella.";
    text[8258] = "Devíamos repetir a dose qualquer dia desses.";
    text[8259] = "Com certeza!";
    text[8257] = "Receita de Combo Lux: Esquadrão Raine Deluxe obtida!";
    text[8260] = "Receita de Combo Lux: Soco Propulsor obtida!";
    text[8261] = "Receita de Combo Lux: Corrente Radiante obtida!";
    text[8262] = "Receita de Combo Lux: Impacto Cósmico obtida!";
    text[8263] = "Meu nome é Jason! Sou o dono da BlanK Robotics.";
    text[8295] = "Tetra... Só de ver dá para saber que você foi construída com maestria.";
    text[8296] = "Essa liga metálica... Esses componentes... Tudo muito incrível!";
    text[8264] = "Se importa se eu examinar suas armas integradas de batalha?";
    text[8265] = "Não me importo. Manda bala!";
    text[8266] = "Hm... Interessante!";
    text[8267] = "Já considerou melhorar seu Canhão?";
    text[8268] = "Parece que há espaço para melhorar seus circuitos!";
    text[3722] = "Um Canhão Tetra melhorado = Escudeira Melhorada. Hihi.";
    text[8269] = "O que acha, Bella?";
    text[8270] = "É com você, Tetra.";
    text[8271] = "A escolha é sua.";
    text[8272] = "Nesse caso... A resposta é sim!";
    text[8273] = "Eu amaria receber melhorias!";
    text[8274] = "Maravilha! Deixe-me só conferir se tenho todas as peças necessárias...";
    text[8275] = "Então...";
    text[8276] = "Más notícias... Não tenho Engrenagens de Núcleo o suficiente.";
    text[8277] = "Essas Engrenagens de Núcleo são imprescindíveis para a melhoria?";
    text[8278] = "É claro! Com as Engrenagens de Núcleo, eu poderei dobrar...";
    text[8279] = "Não... Quadruplicar o PDR base da Tetra!";
    text[8280] = "Bella, vamos logo procurar algumas Engrenagens de Núcleo...";
    text[8281] = "Eu quero muito, muito mesmo essa melhoria!";
    text[8282] = "Já que vocês vão se dar ao trabalho de obter as Engrenagens de Núcleo,";
    text[8283] = "darei um desconto nos meus serviços...";
    text[8284] = "Você receberá um Canhão Tetra melhorado pela barganha de 200 astrotecas!";
    text[8285] = "Beleza. Trato feito.";
    text[8286] = "Então... Onde podemos encontrar as Engrenagens de Núcleo?";
    text[8287] = "Hm... Aí é que tá. Engrenagens de Núcleo são bem raras!";
    text[8288] = "Conhece algum lugar que possa ter maquinários reservas ou peças de reposição?";
    text[8289] = "Hmm...";
    text[8290] = "Ah!";
    text[8291] = "Talvez possamos olhar na Área de Armazenamento em Regolithia.";
    text[8292] = "Ótima ideia, Tetra!";
    text[8293] = "Certo, Jason, voltaremos assim que encontrarmos as Engrenagens de Núcleo!";
    text[8294] = "Maravilha! Até mais ver!";
    text[8297] = "Você encontrou algumas Engrenagens de Núcleo!";
    text[8298] = "Temos as Engrenagens de Núcleo! Hihi.";
    text[8299] = "Ótimo! Podem já fazer o pagamento?";
    text[8300] = "Quanto era mesmo?";
    text[8301] = "200 astrotecas pelos meus serviços de Técnico Profissional de Robótica!";
    text[8302] = "Sim. Temos Astrotecas o suficiente!";
    text[8303] = "Maravilha! Vamos começar essa melhoria então!";
    text[8304] = "Não temos Astrotecas o suficiente...";
    text[8305] = "Não se preocupe. Posso esperar!";
    text[8306] = "Afinal de contas, tenho um negócio para tocar também. Hahaha!";
    text[8307] = "Melhoria concluída!";
    text[8308] = "O PDR base da sua habilidade de apoio Explosão Tetra agora é 200!";
    text[8309] = "Isso é incrível! Já me sinto mais forte!";
    text[8310] = "Fico feliz de saber!";
    text[8311] = "Obrigado pela confiança... e boa sorte na sua próxima aventura, Tetra!";
    text[8312] = "Os negócios estão um pouco devagar... Mas não por muito tempo!";
    text[8313] = "Com mais e mais robôs com IA entrando na sociedade...";
    text[8314] = "Eles precisarão de um técnico de robótica especializado com quem contar!";
    text[8315] = "... E, aí, a BlanK Robotics se tornará a oficina de robótica número 1 de Luna. Hahaha!";
    text[8316] = "Você mencionou que talvez haja algumas Engrenagens de Núcleo na Área de Armazenamento de Regolithia?";
    text[8317] = "Sim! Voltaremos assim que as encontramos!";
    text[8318] = "Ora, ora... Bom revê-la, Guerreira Prodígio!";
    text[8319] = "Heheheh!";
    text[8320] = "Eu conheço esse olhar... Essa chama nos olhos...";
    text[8321] = "Quer saber? Estou com tempo livre.";
    text[8322] = "Aceito seu desafio.";
    text[8323] = "Ah, você me conhece mesmo, Bella.";
    text[8324] = "Encontre-me na frente do Café Regolithia!";
    text[8325] = "... E prepare-se...";
    text[8326] = "PARA LEVAR UMA SURRA!";
    text[8327] = "Não vou perder desta vez! BAHAHAHA!";
    text[8328] = "Muito menos eu!";
    text[8329] = "Nos vemos lá, Raine!";
    text[8330] = "Quando meu corpo está no limite após treinar...";
    text[8331] = "Só tem uma coisa que me resta fazer...";
    text[8332] = "... Jogar! BAHAHAHA!";
    text[8333] = "Vamos deixar isso mais interessante...";
    text[8334] = "Se você ganhar, eu a ensinarei como usar minhas Manoplas de Lâminas.";
    text[8335] = "Você praticamente aprenderá uma nova Habilidade Ativa!";
    text[8336] = "... E se eu ganhar...";
    text[8337] = "Ei! Nem precisa se dar ao trabalho de terminar essa frase.";
    text[8338] = "... Porque EU que vou ganhar esse duelo. Hehe.";
    text[8339] = "Saquei o que você tá tentando fazer...";
    text[8340] = "Está tentando me irritar!";
    text[8341] = "Bom...";
    text[8342] = "DEU CERTO!";
    text[8343] = "PUNHOS AO ALTO E VAMOS LUTAR! BAHAHAHA!";
    text[8344] = "Droga...";
    text[8345] = "Certo, você venceu desta vez.";
    text[8346] = "Foi divertido!";
    text[8347] = "Não poderia pedir uma rival melhor.";
    text[8348] = "Pode ficar com isso...";
    text[8349] = "Eu estarei descansando em casa.";
    text[8350] = "Até mais, guerreira prodígio!";
    text[8351] = "Ei, Fortuno, já que somos todos membros da Guilda dos Caçadores de Tesouros...";
    text[8352] = "Poderia compartilhar conosco informações sobre mitos e mistérios não solucionados?";
    text[8353] = "Ahn?! Vocês jovens são Caçadoras de Tesouros Novatas...";
    text[8354] = "Acham que dão conta desse desafio?";
    text[8355] = "Pode ter certeza que sim!";
    text[8356] = "Tenho caçado tesouros muito antes de entrar para a guilda.";
    text[8357] = "Amo um bom desafio. Pode mandar qualquer pedra no sapato!";
    text[8358] = "Beleza. Então tenho um para você.";
    text[8359] = "Arqueólogos descobriram recentemente uma tabuleta antiga que descreve";
    text[8360] = "a existência de duas espadas lendárias...";
    text[8361] = "A Espada Relíquia e a Excalibur.";
    text[8362] = "Não se sabe muito a respeito da Espada Relíquia...";
    text[8363] = "... Contudo, temos algumas informações sobre a Excalibur.";
    text[8364] = "Os registros informam que a espada se encontra em algum lugar ao sul de Copernicus.";
    text[8365] = "Além disso, para poder brandir a Excalibur,";
    text[8366] = "seu manipulador deve possuir duas pedras chaves antigas...";
    text[8367] = "... Basicamente, é isso que sei.";
    text[8368] = "Se conseguir encontrar a Excalibur, volte aqui!";
    text[8369] = "A Guilda incentiva nossos aventureiros oferecendo recompensas para aqueles";
    text[8370] = "que encontrarem os tesouros mais valiosos de Luna!";
    text[8371] = "Boa sorte em sua caçada!";
    text[8372] = "Obrigada, Fortuno.";
    text[8373] = "Então, Nickle, por onde começamos?";
    text[8374] = "Acho que devemos conferir as áreas de saque que ainda não visitamos.";
    text[8375] = "Temos que encontrar duas Pedras Chave Antigas antes e, depois, a própria Excalibur!";
    text[8376] = "AAAAH! Cara, que ADRENALINA!";
    text[8377] = "(Quando se trata de caça ao tesouro, é como se ele virasse outra pessoa.)";
    text[8378] = "(É, ele fica muito menos rabugento.)";
    text[8379] = "O que vocês estão cochichando aí?";
    text[8380] = "Vamos, precisamos encontrar a espada lendária!";
    text[8381] = "Impressionante! Você realmente a encontrou!";
    text[8382] = "... A lendária Excalibur! Não consigo esconder quão impressionado estou!";
    text[8383] = "Bom, peço desculpas por subestimar vocês mais cedo.";
    text[8384] = "Vocês não são novatas...";
    text[8385] = "Talvez até estejam entre os melhores caçadores da Guilda!";
    text[8386] = "Hehehe. Obrigada, Fortuno.";
    text[8387] = "Bom, aqui está sua recompensa!";
    text[8388] = "Você recebeu 10.000 bytes!";
    text[8389] = "Se eu ficar sabendo alguma coisa sobre tesouros não encontrados,";
    text[8390] = "Certamente contarei com vocês, jovens!";
    text[8007] = "A porta abriu com a CHAVE SECRETA!";
    text[8400] = "Você encontrou uma Pedra Chave Antiga!";
    text[8401] = "Falta encontrar mais uma!";
    text[8402] = "Eita, as Pedras Chave estão brilhando!";
    text[8403] = "Alguns inscritos antigos apareceram...";
    text[8404] = "Tetra, consegue traduzir?";
    text[8405] = "Claro! Está escrito...";
    text[8406] = "Quando duas Pedras Chave forem reunidas...";
    text[8407] = "A miragem deverá desaparecer...";
    text[8408] = "Hm... A miragem deverá desaparecer...";
    text[8409] = "Acho que isso significa que poderemos encontrar o local da Excalibur!";
    text[8410] = "Fortuno disse que fica em algum lugar ao sul de Copernicus no mapa-múndi!";
    text[8411] = "Vamos depressa!";
    text[8412] = "Conseguimos! Finalmente encontramos a lendária Excalibur!";
    text[8413] = "Eu, hm.@P.@P.@P";
    text[8414] = "Estou feliz que pude dividir esse momento com vocês.";
    text[8415] = "A gente também, Nickle.";
    text[8416] = "Uhul! Três vivas para comemorar uma ótima caça ao tesouro!";
    text[8417] = "Sensacional! Vamos voltar a Sílica e contar ao Fortuno!";
    text[8418] = "Ei, você gosta de coelhos?";
    text[8419] = "Impossível... Como não gosta de coelhinhos...";
    text[8420] = "Eles são tão fofinhos!";
    text[8421] = "Legal! Bom, então este presente é para você...";
    text[8422] = "Pelúcias de Axel e Hazel obtidas!";
    text[8423] = "Essas pelúcias são do meu jogo: 'CODE Bunny'.";
    text[8424] = "Já que gosta de coelhinhos, por que não testa meu jogo?";
    text[8425] = "Claro! Vou amar!";
    text[8426] = "LunarLux";
    text[8427] = "Profundezas";
    text[8428] = "BÔNUS";
    text[8429] = "Área de Saque";
    text[8430] = "Rancho Kepler";
    text[8431] = "Tycho";
    text[8432] = "Zona Desolada";
    text[8433] = "Lux inata";
    text[8434] = "Base Militar";
    text[8435] = "Investida galáctica";
    text[8436] = "Batalha contra Vivia";
    text[8437] = "Fendas de Sílica";
    text[8438] = "Sílica";
    text[8439] = "Calma sincera";
    text[8440] = "Neve lunar";
    text[8441] = "Batalha contra o Esquadrão Raine";
    text[8442] = "Ruínas de Lux";
    text[8443] = "Batalha contra os Antigos";
    text[8444] = "Revelação";
    text[8445] = "Laboratório Nexus";
    text[8446] = "Cientista maluco";
    text[8447] = "Aproveite o futuro";
    text[8448] = "Salve o mundo";
    text[8449] = "Um destino aguardado";
    text[8450] = "Batalha contra Saros em caos";
    text[8451] = "Estrondo no hiperespaço";
    text[8452] = "Créditos";
    text[8453] = "MÚSICAS DO ROBÔ MUSICAL DO CAPÍTULO 3 DESBLOQUEADAS!";
    text[8454] = "MÚSICAS DO ROBÔ MUSICAL DO CAPÍTULO 4 DESBLOQUEADAS!";
    text[8455] = "MÚSICAS DO ROBÔ MUSICAL DO CAPÍTULO 5 DESBLOQUEADAS!";
    text[8456] = "Qual o seu próximo destino?";
    text[8457] = "Hm... Acho que vou dar um pulinho no café na Estação Espacial Lunex!";
    text[8458] = "No momento, estou trabalhando em várias novas composições com a minha banda,";
    text[8459] = "inspiradas pela minha jornada por Luna!";
    text[8460] = "Daqui a dois dias, estarei apresentando nossa nova música no Café Tycho!";
    text[8461] = "Espero vê-la lá!";
    text[8462] = "Ei, você conseguiu!";
    text[8463] = "Já que todo mundo gostou tanto da minha música,";
    text[8464] = "decidi me mudar para cá em Tycho.";
    text[8465] = "Vou abrir meu coração e apresentar minha música aqui!";
    text[8466] = "Obrigado por todo o apoio, Bella!";
    text[8467] = "Tome aqui minha última música para você baixar!";
    text[8468] = "Echo lhe deu 300 astrotecas!";
    text[8469] = "Você obteve o Conjunto de Nave da Echo!";
    text[8470] = "Este conjunto inclui a Estrutura Echo, Propulsor Echo e Asas Echo!";
    text[8471] = "Você obteve o Traje a Jato Echo!";
    text[8472] = "Você está de volta no Reino Fantasma...";
    text[8473] = "Bella, não deveríamos estar aqui...";
    text[8474] = "É perigo, lembra?";
    text[8475] = "Eu sei, mas iremos embora em breve...";
    text[8476] = "Hmm...";
    text[8477] = "Será que a Força Lunex conhece essa entrada?";
    text[8478] = "Lembro de ver umas inscrições estranhas em paredes em alguns lugares de Luna.";
    text[8479] = "Isso significa que há mais entradas para o Reino Fantasma do que sabemos...";
    text[8480] = "Queria estudar mais sobre aqui algum dia...";
    text[8481] = "Afinal de contas, minha mãe costumava sair em expedições para o Reino Fantasma.";
    text[8482] = "É fácil sentir medo de coisas que não compreendemos.";
    text[8487] = "Quando mais sei sobre este lugar, mais seguro será explorá-lo!";
    text[8483] = "Não concorda, Tetra?";
    text[8484] = "É... Acho que sim...";
    text[8485] = "Só tome cuidado, tá?";
    text[8486] = "Pode deixar. Não se preocupe!";
    text[8488] = "Não entraria na Área de Armazenamento se fosse você...";
    text[8489] = "Por que não?";
    text[8490] = "Aparentemente, há uma infestação de ratos lá...";
    text[8491] = "Senhorita Nyla! Reeves! O que estão fazendo aqui?";
    text[8492] = "Mié! Estamos fazendo um intervalo!";
    text[8493] = "Descobrimos que poderíamos ajudar a Equipe Arqueológica a analisar a nova descoberta deles.";
    text[8494] = "Uuuuh! O que encontraram?";
    text[8531] = "Bom...";
    text[8495] = "Eles encontraram essas tabuletas que brilham!";
    text[8496] = "São relíquias deixadas por uma civilização antiga...";
    text[8497] = "... uma sociedade que existiu muito antes de a humanidade se estabelecer em Luna.";
    text[8498] = "Sabemos o nome deles?";
    text[8499] = "Sua mãe costumava estudar essa antiga civilização anos atrás...";
    text[8500] = "Ela simplesmente os chamava de 'Os Antigos'.";
    text[8501] = "Isso é...";
    text[8502] = "... bem original.";
    text[8503] = "Minha mãe nunca foi muito boa em dar nomes para as coisas. Hehehe...";
    text[8504] = "Quando eu era criança, lembro dela mencionar algo sobre os Antigos...";
    text[8505] = "... Os antigos tinham algum tipo de conexão entre Lux e Antimatéria.";
    text[8506] = "Exato! Mié.";
    text[8507] = "Nosso conhecimento sobre os Antigos é bem raso...";
    text[8508] = "A única missão da Equipe Arqueológica é desvendar a história do passado de Luna...";
    text[8509] = "... Mas tem sido difícil sair em expedições ultimamente devido à falta de recursos...";
    text[8510] = "Ahn? Saros foi o responsável por cortar os fundos?";
    text[8511] = "Mié. Saros insiste que nossos recursos serão melhor empregados para o futuro,";
    text[8512] = "em vez de para o passado.";
    text[8513] = "... Saquei.";
    text[8514] = "Se eu fosse a General, eu dobraria os recursos para a Equipe Arqueológica.";
    text[8515] = "Acho importante entendermos nossas origens...";
    text[8516] = "... e as pessoas que aqui viveram antes de nós.";
    text[8517] = "E o motivo de os Antigos terem desaparecido...";
    text[8518] = "Isso é algo que ainda precisamos descobrir! Mié!";
    text[8519] = "Então, o que a traz aqui, Bella?";
    text[8520] = "Ah, estava só conferindo algumas Missões da Força Lunex.";
    text[8521] = "Então, não vamos mais distrai-la!";
    text[8522] = "Continue com o bom trabalho, Bella!";
    text[8523] = "Mié! Ao longo dos anos, descobrimos diversos glifos e escrituras";
    text[8524] = "deixados pelos Antigos...";
    text[8525] = "Foi o suficiente para decodificarmos parte do idioma deles!";
    text[8526] = "Senhorita Nyla, você acha que os Antigos têm";
    text[8527] = "algum tipo de ligação com o Reino Fantasma?";
    text[8528] = "Essa não é bem a minha especialidade, querida...";
    text[8529] = "Então não sei dizer. Por que a pergunta?";
    text[8530] = "Hm... Só passou pela cabeça mesmo...";
    text[8532] = "Meu trabalho é documentar os locais de cada artefato antigo que descobrirmos.";
    text[8533] = "Escavar em busca de artefatos antigos pode ser desafiador!";
    text[8534] = "Frequentemente, precisamos usar instrumentos precisos e delicados";
    text[8535] = "para remover o solo lunar com paciência e não danificar os artefatos.";
    text[8536] = "Então, qual o seu trabalho?";
    text[8537] = "Eu, hm...";
    text[8538] = "Meu trabalho é trazer os donuts! Duh!";
    text[8539] = "NOVAS MISSÕES DA FORÇA LUNEX DISPONÍVEIS!";
    text[8540] = "Espere aí!";
    text[8541] = "Não vamos entrar na Base Militar agora.";
    text[8542] = "Ainda não sabemos em quem podemos confiar...";
    text[8543] = "Devemos bolar um plano para impedir o Saros primeiro!";
    text[8544] = "É uma Minicápsula desativada!";
    text[8545] = "Ei, hm... Você ficou sabendo alguma coisa sobre o Murktador?";
    text[8546] = "Não... não tenho tido notícias desde sua primeira captura.";
    text[8547] = "VOCÊ tem alguma novidade?";
    text[8548] = "... Não!";
    text[8549] = "Senhorita Bella, você é uma oficial de alta patente da Força Lunex...";
    text[8550] = "Você recebeu algum Relatório de Missão de Código Roxo recentemente?";
    text[8551] = "A ralé do ranque como eu nunca recebe desses...";
    text[8552] = "Ah, hm...";
    text[8553] = "... Não!";
    text[8554] = "Entendi. Então tá.";
    text[8555] = "Uma lista de criminosos e fugitivos procurados está sendo exibida neste monitor.";
    text[8556] = "Uma lista de pessoas e cidadãos desaparecidos está sendo exibida neste monitor.";
    text[8557] = "Uma lista de locais de incidentes com Murks está sendo exibida neste monitor.";
    text[8558] = "Esta máquina de vendas vende Mentas Finas e Samoas!";
    text[8559] = "POR QUE VOCÊS AINDA ESTÃO AQUI??";
    text[8560] = "... E COMO NINGUÉM NOTOU??";
    text[8561] = "Você bateu neles com tanta força assim, Tetra?";
    text[8562] = "Não foi TANTA força assim!";
    text[8563] = "É uma cela vazia...";
    text[8564] = "Você olha dentro da cela... É bem, bem, bem escura.";
    text[8565] = "Ei, esse cara tá cochilando!";
    text[8566] = "Bom...";
    text[8567] = "Proteger uma prisão sem prisioneiros deve ser um trabalho chato demais.";
    text[8568] = "Só há uniformes da prisão dentro desses armários.";
    text[8569] = "Esta porta leva ao refeitório.";
    text[8570] = "Você resiste ao máximo para não acionar o alarme de incêndio...";
    text[8571] = "Tem um adesivo de 'Rick de Picles' neste armário!";
    text[8572] = "Essas paredes parecem ter sido reforçadas com Holotecnologia.";
    text[8573] = "É uma cápsula de dormir modificada com recursos limitados.";
    text[8574] = "Várias granadas experimentais alinhadas.";
    text[8575] = "É um bumerangue! Super útil contra grupo de inimigos!";
    text[8576] = "É um Hidroexplosivo! Esta arma pode causar ENCHARCAR em inimigos!";
    text[8577] = "Várias Sabristolas experimentais estão alinhadas.";
    text[8578] = "Vários modelos de Traje a Jato estão alinhados na parede.";
    text[8579] = "É um servidor de dados usado para monitorar a Ciber-rede Militar.";
    text[8580] = "É um monte de códigos espaguetes! TODOS ESPALHADOS!";
    text[8581] = "Essas Holoestrelas foram usadas para gerar a armadilha de Holocampo da Vivia.";
    text[8582] = "Não faço ideia para que serve este painel de controle...";
    text[8583] = "É o terminal de pesquisas da Vivia.";
    text[8584] = "É um Extrator Biométrico de Antimatéria.";
    text[8585] = "Tem um livro de ficção científica aqui: 'Duna'.";
    text[8586] = "Tem um livro de ficção científica aqui: 'O Jogo do Exterminador'.";
    text[8587] = "Tem um livro de ficção científica aqui: 'O Guia do Mochileiro das Galáxias'.";
    text[8588] = "Tem um livro de ficção científica aqui: 'Perdido em Marte'.";
    text[8589] = "Tem um livro aqui chamado 'A História da Terraformação de Luna'.";
    text[8590] = "Tem um livro aqui chamado 'A Queda da Terra'.";
    text[8591] = "Tem um livro aqui chamado 'Economia Lunar'.";
    text[8592] = "Tem um livro aqui chamado 'Mistérios do Cosmos'.";
    text[8593] = "Deixa eu te contar uma história...";
    text[8594] = "Os Kyroportais que vê espalhados por Luna";
    text[8595] = "já foram pontos de descanso usados pelos Antigos durante suas longas viagens!";
    text[8596] = "Sempre quis saber por que o solo neste Setor é marrom...";
    text[8597] = "Ah, eu sei por quê!";
    text[8598] = "Sílica foi o primeiro setor onde a Astrobarreira foi construída e testada.";
    text[8599] = "O oxigênio na atmosfera artificial reagiu ao solo silicano rico em minerais";
    text[8600] = "e, com o tempo, o solo começou a ficar amarronzado!";
    text[8601] = "Caramba! Gente inteligente é outro nível!";
    text[8602] = "Hihi.";
    text[8603] = "NOVA";
    text[8604] = "ATIVA";
    text[8605] = "CONCLUÍDA";
    text[8606] = "M-01: Itens roubados";
    text[8607] = "M-02: Carga militar perdida";
    text[8608] = "M-03: Escassez alimentar do Rancho Kepler";
    text[8609] = "M-04: Ataques do Pirowyrm";
    text[8610] = "M-05: Líder dos bandidos espaciais";
    text[8611] = "Um grupo de Pirowyrms tem planejado ataques coordenados contra nossos soldados.";
    text[8612] = "Esses Murks parecem ser mais fortes do que o normal e são muito inteligentes.";
    text[8613] = "Acreditamos que o próximo alvo deles será a Base Militar.";
    text[8614] = "Sua missão é rastrear e derrotar esses Pirowyrms!";
    text[8615] = "Vá para a Zona Desolada 1 e fale com Damian para obter mais detalhes.";
    text[8616] = "Rastreamos um grupo de Bandidos Espaciais que podem ter informações valiosas";
    text[8617] = "a respeito do local de sua organização criminosa.";
    text[8618] = "Temos evidências que sugerem que essa organização criminosa esteja ligada a";
    text[8619] = "inúmeros casos não solucionados de pessoas desaparecidas que ocorreram ao longo dos anos.";
    text[8620] = "Sua missão é encontrar e infiltrar nessa organização criminosa";
    text[8621] = "e prender seu nefasto líder!";
    text[8623] = "Viemos para ajudar na Missão dos Pirowyrms!";
    text[8624] = "Qual a situação?";
    text[8625] = "Os Pirowyrms começaram seu próximo ataque coordenado.";
    text[8626] = "Nossos soldados estão lutando contra eles agora mesmo na Zona Desolada 2!";
    text[8627] = "Certo. Vamos para lá para somar reforços!";
    text[8628] = "Entendi...";
    text[8629] = "Não acredito que Saros nos trairia assim...";
    text[8630] = "Alguns de meus amigos desapareceram há algumas semanas...";
    text[8631] = "Saros também deve tê-los transformado em Murks...";
    text[8622] = "Espero que, algum dia, consigamos encontrar um jeito de reverter os Murks em humanos...";
    text[8632] = "Até lá, ficarei feliz em ajudar você e sua equipe como puder.";
    text[8633] = "Obrigada. Estamos felizes que esteja do nosso lado!";
    text[8634] = "Na verdade, tem algo que você pode fazer...";
    text[8635] = "Junte o máximo de soldados que puder e conte a verdade sobre Saros a eles.";
    text[8636] = "A partir de agora, todos os Antinúcleos que obtiverem deverão ser preservados e mantidos em segurança!";
    text[8637] = "Entendido! Darei o meu melhor!";
    text[8638] = "Antes que eu me esqueça. Por favor, aceite este presente!";
    text[8639] = "Os reforços chegaram! Deixem com a gente agora!";
    text[8640] = "Certo... Vou tentar usar minha Percepção de Almas...";
    text[8641] = "Por favor, me escutem! Não há motivos para serem hostis!";
    text[8643] = "Você... consegue nos entender? ...";
    text[8644] = "Sim!";
    text[8645] = "Minha Percepção de Almas permite que eu me comunique com vocês!";
    text[8646] = "Nossa família... Saros transformou todos nós em Murks...";
    text[8647] = "Ele deve pagar pelo que fez...";
    text[8648] = "... por toda a nossa dor e sofrimento...";
    text[8649] = "Nós... não confiamos em vocês...";
    text[8650] = "A Força Lunex... deveria proteger o Povo de Luna...";
    text[8651] = "Vocês todos NOS ABANDONARAM!";
    text[8652] = "Eles não querem ouvir...";
    text[8653] = "Saros deve ter dado uma versão mais refinada do Soro de Murk...";
    text[8654] = "A Antimatéria deles está potencializando seus sentimentos de medo e raiva.";
    text[8655] = "Precisamos contê-los antes que alguém se machuque!";
    text[8656] = "Certo... Preparem-se para a batalha!";
    text[8657] = "Desculpa por chegar a esse ponto...";
    text[8658] = "Manteremos seus Antinúcleos em segurança...";
    text[8659] = "... e prometo que, algum dia, encontraremos um jeito de reunir sua família novamente.";
    text[8660] = "Vamos, Bella. Temos que relatar a situação para Damian.";
    text[8661] = "Mãos ao alto! Pela autoridade da Força Lunex, vocês todos estão presos!";
    text[8662] = "Calma, Bella... Deixa que eu cuido disso.";
    text[8663] = "Atenção!";
    text[8664] = "Não sei que crimes vocês cometeram, mas não viemos atrás de vocês.";
    text[8665] = "Viemos atrás do seu líder.";
    text[8666] = "Ninguém aqui quer passar o resto da vida preso, então...";
    text[8667] = "Vamos fazer um acordo.";
    text[8668] = "Nickle, você ficou doido?";
    text[8669] = "Esses caras são criminosos!";
    text[8670] = "Deixa comigo.";
    text[8671] = "Olha, deixaremos vocês fugirem se nos disserem onde está seu líder...";
    text[8672] = "... sem pegadinhas.";
    text[8673] = "Capitão, o que faremos?";
    text[8674] = "Hmm... Esse garoto...";
    text[8675] = "Dá para sentir o cheiro podre a quilômetros.";
    text[8676] = "Você não é como a Senhorita Boa Praça ao seu lado...";
    text[8677] = "Você também é um criminoso, não é mesmo?";
    text[8678] = "Bingo.";
    text[8679] = "Eu sou o Murktador...";
    text[8680] = "O número 1 entre os procurados da Força Lunex.";
    text[8681] = "Essa máscara... Esse cara é ele mesmo.";
    text[8682] = "Você deveria estar na cadeia!";
    text[8683] = "Como conseguiu fugir?";
    text[8684] = "A Senhorita Boa Praça me ajudou a fugir.";
    text[8685] = "Ei!";
    text[8686] = "Então, temos um acordo?";
    text[8687] = "Jamais!";
    text[8688] = "Nunca trairíamos nossos comparsas nem o nosso líder.";
    text[8689] = "Na verdade, estávamos enrolando vocês o tempo todo.";
    text[8690] = "Vocês caíram na nossa armadilha! Hahahaha!";
    text[8691] = "Que armadilha?";
    text[8692] = "Enquanto vocês estavam enchendo com o acordo de vocês,";
    text[8693] = "ativamos secretamente a sequência de autodestruição desta nave!";
    text[8694] = "De novo, não...";
    text[8695] = "Vocês já passaram por isso?";
    text[8696] = "Infelizmente.";
    text[8697] = "Esses caras nunca ouvem.";
    text[8698] = "Vamos ter que lutar!";
    text[8699] = "Achei que resolver as coisas lutando era coisa minha";
    text[8700] = "e falando, coisa sua...";
    text[8701] = "Bom, há pessoas desaparecidas por aí que contam conosco para encontrá-las!";
    text[8702] = "Ou lutamos, ou perderemos a oportunidade de obter as informações de que precisamos.";
    text[8703] = "Tetra, quanto tempo ainda temos?";
    text[8704] = "Temos que derrotá-los em até 5 turnos!";
    text[8705] = "Certo. Esses bandidos espaciais vão ver só!";
    text[8706] = "... Eeeeee... sequência de autodestruição desativada!";
    text[8707] = "Droga... Vocês são ridiculamente fortes.";
    text[8708] = "Vocês deveriam ter aceitado meu acordo quando tiveram a chance.";
    text[8709] = "Mesmo perdendo... Nossas bocas permanecerão túmulos.";
    text[8710] = "Nesse caso... Tetra, escaneie a nave em busca de pistas que possam nos ajudar.";
    text[8711] = "Escaneando...";
    text[8712] = "Ei, esse cara tem algo no bolso!";
    text[8713] = "Essa Chave da Mina é usada para abrir portões de lasers nas Minas de Sílica!";
    text[8714] = "Lá que deve ficar o esconderijo deles!";
    text[8715] = "Precisamos ir para as Minas de Sílica agora mesmo! Vamos!";
    text[8716] = "Tetra, escaneie os sinais vitais deles!";
    text[8717] = "Eles estão mortos... Os ferimentos foram bem graves...";
    text[8718] = "Quem pode ter feito isso?";
    text[8719] = "Os traços de antimatéria em seus trajes de batalha... as feridas em formato de mordida...";
    text[8720] = "e as leituras de energia térmica indicam que provavelmente estamos lidando com...";
    text[8721] = "Um Murk capaz de manipular fogo.";
    text[8722] = "... Como um Moleculoide?";
    text[8723] = "Não, algo ainda maior...";
    text[8724] = "Vamos ficar atentos caso o Murk apareça!";
    text[8725] = "Pessoal, viemos resgatá-los aqui!";
    text[8726] = "É a Força Lunex!";
    text[8727] = "Ah, graças aos céus...";
    text[8728] = "Achei que íamos ficar presos aqui para sempre...";
    text[8729] = "Por favor, acompanhem a Tetra. Ela os escoltará em segurança.";
    text[8730] = "Es-espera aí... O líder dos bandidos...";
    text[8731] = "Ele ainda está por aí...";
    text[8732] = "Se descobrir que escapamos... Nossas vidas estarão em risco...";
    text[8733] = "Ele nos caçará de novo...";
    text[8734] = "Não se preocupem. Após tirarmos vocês daqui, prenderemos o líder dos bandidos,";
    text[8735] = "e procuraremos o Murk enfurecido que habita estas minas.";
    text[8736] = "Vocês estarão seguros sob a nossa proteção.";
    text[8737] = "Ah...";
    text[8738] = "Você não está entendendo...";
    text[8739] = "O líder dos bandidos É o Murk enfurecido.";
    text[8740] = "O-o quê??";
    text[8741] = "Talvez eu possa explicar.";
    text[8742] = "Saudações. Sou Kerberos...";
    text[8743] = "... líder dos bandidos espaciais.";
    text[8744] = "Vocês demoraram para encontrar meu esconderijo...";
    text[8745] = "Kerberos, por que raptou essas pessoas?";
    text[8746] = "Elas são inocentes! Não fizeram nada de errado!";
    text[8747] = "Era tudo parte do trabalho...";
    text[8748] = "... ou pelo menos era.";
    text[8749] = "Explique-se.";
    text[8750] = "Por anos, meus bandidos e eu trabalhamos secretamente para o General Saros...";
    text[8751] = "... raptando e sequestrando pessoas para seus experimentos.";
    text[8752] = "Então você sabia a verdade sobre os Murks?";
    text[8753] = "Sei disso há um bom tempo.";
    text[8754] = "Nós, bandidos... Não nos importamos com o que é certo ou errado...";
    text[8755] = "Tudo o que queremos é dinheiro e poder.";
    text[8756] = "Saros nos deu dinheiro... e nos prometeu poder.";
    text[8757] = "Em troca, fizemos todo o trabalho sujo.";
    text[8758] = "Hoje... Saros veio me visitar...";
    text[8759] = "Ele disse que não precisava mais dos meus serviços...";
    text[8760] = "... e me transformou NISSO...";
    text[8761] = "OLHE PARA MIM!";
    text[8762] = "EU SOU UM MONSTRO.";
    text[8763] = "Você é um monstro por ter matado seus próprios homens.";
    text[8764] = "O triste é que não me lembro disso.";
    text[8765] = "Quando me tornei um Murk... tudo ficou confuso...";
    text[8766] = "Minha mente foi consumida por uma dor e uma raiva excruciantes!";
    text[8767] = "Estou precisando usar toda a minha força só para conversar com vocês!";
    text[8768] = "(O fato de que Kerberos tem a capacidade de falar...)";
    text[8769] = "(Isso significa que o Soro de Murk do Saros está perto do aperfeiçoamento...)";
    text[8770] = "Você...";
    text[8771] = "VOCÊ PRECISA DAR UM JEITO NISSO!";
    text[8772] = "Sinto muito... Ainda não temos um antissoro...";
    text[8773] = "Agora, você não será capaz de voltar a ser um humano.";
    text[8774] = "NÃO! NÃO! NÃO! NÃO VOU ACEITAR ISSO!";
    text[8775] = "Se não há nada que possa consertar isso...";
    text[8776] = "Só tem uma coisa que me resta fazer...";
    text[8777] = "Vou matar o homem que me transformou neste MONSTRO...";
    text[8778] = "... E DESTRUIREI TUDO E TODOS QUE FICAREM NO MEU CAMINHO!";
    text[8779] = "Bella, os níveis de antimatéria do Kerberos estão aumentando rapidamente!";
    text[8780] = "Ele está prestes a entrar em frenesi!";
    text[8781] = "Certo, equipe, vamos apagá-lo!";
    text[8782] = "Saros... Ele tem trabalhado este tempo todo com criminosos como o Kerberos...";
    text[8783] = "Ei, não é hora de focar no Saros.";
    text[8784] = "Acabamos de impedir a organização criminosa responsável não só pelos";
    text[8785] = "Relatórios de Pessoas Desaparecidas como por centenas de casos criminais não solucionados!";
    text[8786] = "Agora... podemos nos concentrar em salvar as vítimas inocentes que foram transformadas em Murks.";
    text[8787] = "Estamos um passo mais perto da justiça!";
    text[8788] = "Quer saber?";
    text[8789] = "Você tem toda a razão.";
    text[8790] = "Ótimo trabalho, equipe!";
    text[8791] = "Há um texto no visor que diz: 824913.";
    text[8792] = "EI, EI! Eu não tenho um traje a jato! Como espera que eu voe por aí?";
    text[8793] = "Posso comprar um para você...";
    text[8794] = "Não, obrigado. Nem sei como usar um Traje a Jato.";
    text[8795] = "Hunf. Beleza.";
    text[8796] = "Eu te carrego.";
    text[8797] = "O QUÊ... NÃO.";
    text[8798] = "Minha vida estaria em suas mãos.";
    text[8799] = "Tetra não vai deixá-lo cair.";
    text[8800] = "Ela é mais forte do que parece.";
    text[8801] = "Minha oferta expira em cinco segundos...";
    text[8802] = "Quatro segundos...";
    text[8803] = "Es-espera!";
    text[8804] = "Três segundos...";
    text[8805] = "...";
    text[8806] = "Dois segundos...";
    text[8807] = "Um segundo...";
    text[8808] = "Tá, tá! Vou aceitar sua oferta.";
    text[8809] = "Se me deixar cair...";
    text[8810] = "Não vou... Pode confiar. Hihi.";
    text[8812] = "No ano 20XX, a catástrofe planetária conhecida como ASTRA começou.";
    text[8813] = "Um cometa misterioso feito de antimatéria estava em rota direta para o nosso planeta, a Terra.";
    text[8814] = "Após inúmeras tentativas fracassadas de destruir o cometa,";
    text[8815] = "a humanidade decidiu que a melhor solução seria fugir da Terra...";
    text[8816] = "... e preparou para uma jornada só de ida para a nossa lua, Luna.";
    text[8817] = "Essa força cósmica da natureza, o Cometa Coda,";
    text[8818] = "atravessou a Terra e deixou um rastro de destruição...";
    text[8819] = "Bilhões de vidas foram perdidas naquele dia...";
    text[8820] = "Não fossem pelos nossos fundadores, os Sete Campeões,";
    text[8821] = "... toda a humanidade teria sido extinta.";
    text[8822] = "Nossa história começa 1.000 anos depois.";
    text[8823] = "A humanidade continuou a prosperar agora em uma Luna terraformada.";
    text[8824] = "Apesar de vivermos em uma era onde a ciência e a tecnologia realmente se destacam,";
    text[8825] = "... nossos recursos aqui em Luna são limitados.";
    text[8826] = "Um dia... ficaremos sem recursos...";
    text[8827] = "Um dia... não teremos outra escolha que não encontrar um novo lar.";
    text[8829] = "A experiência da humanidade com o Cometa Coda e a ASTRA são lembretes...";
    text[8830] = "... de que não importa o que enfrentemos...";
    text[8831] = "a humanidade tem a determinação e a resiliência necessárias para sobreviver.";
    text[8832] = "O que precisamos fazer...";
    text[8833] = "... é evoluir além de nossas limitações.";
    text[8834] = "Será minha missão de vida garantir que o futuro da humanidade brilhe.";
    text[8835] = "Até lá, continuarei a seguir em frente.\n- Saros";
    text[8836] = "O que uma farda da Força Lunex está fazendo aqui?";
    text[8837] = "Ouvi dizer que há um mercado clandestino por aqui.";
    text[8838] = "Queria dar uma conferida.";
    text[8839] = "O que você está planejando, hein?";
    text[8840] = "Nada. Sou só uma possível cliente.";
    text[8841] = "Certo, certo..";
    text[8842] = "Vou ficar de olho nessa farda aí.";
    text[8843] = "Ei, você está interessada em itens raros?";
    text[8844] = "Vá para o portal que fica na parte sul desta mina.";
    text[8845] = "Meus irmãos e eu gerenciamos o mercado clandestino lá.";
    text[8846] = "Eles venderão alguns itens que você não encontra em nenhum outro lugar! Hehehe.";
    text[8847] = "Meus irmãos e eu...";
    text[8848] = "Costumávamos trabalhar na Equipe de Desenvolvimento Armamentista da Força Lunex.";
    text[8849] = "Eu que era responsável por desenvolver poderosos Chips de Melhoria.";
    text[8850] = "Um dia, me dei conta do verdadeiro potencial das minhas habilidades...";
    text[8851] = "e pedi demissão para abrir meu próprio negócio no submundo do crime.";
    text[8852] = "Tive mais sucesso tocando esse negócio no mercado clandestino";
    text[8853] = "do que quando trabalhava naquela porcaria de cargo do governo.";
    text[8854] = "Você sabe que acabou de confessar que trabalha com criminosos, né?";
    text[8855] = "Não tô nem aí. Você tem muitos inimigos por aqui.";
    text[8856] = "Esse é MEU território. Eu tomaria mais cuidado se fosse você.";
    text[8860] = "De qualquer forma...";
    text[8857] = "Meus Chips de Melhoria não podem ser encontrados em nenhum outro lugar.";
    text[8858] = "Se quiser se tornar mais forte do que nunca,";
    text[8859] = "sugiro comprar meus produtos. Hehehehe.";
    text[8861] = "Ei. Tenho informações que podem ser úteis para você.";
    text[8862] = "Mesmo? O quê?";
    text[8863] = "Sério mesmo?!";
    text[8864] = "Eu não vou repassá-las de graça.";
    text[8865] = "Ah... por que não estou surpresa?";
    text[8866] = "Dê-me 100 Habilipontos e as informações que possuo serão sua...";
    text[8867] = "Negócio fechado?";
    text[8868] = "Uma pena...";
    text[8869] = "Maravilha! Valeu pelos Habilipontos!";
    text[8870] = "Isso que sei: 102198.";
    text[8871] = "Conhecimento é poder. Use essa informação com sabedoria.";
    text[8875] = "Ei, você não tem Habilipontos suficientes...";
    text[8872] = "Ahn? Você quer saber como abrir a porta com lasers atrás de nós?";
    text[8873] = "Desculpa, mas tenho tanta ideia quanto você, camarada.";
    text[8874] = "Tudo o que sei é que algumas pessoas assustadoras entram e saem dali.";
    text[8876] = "Habilidades de Apoio Vermelhas são poderosas... mas elas são limitadas.";
    text[8877] = "Você só pode equipar até 3 Habilidades de Apoio Vermelhas por vez...";
    text[8878] = "... a menos que...";
    text[8879] = "você tenha o CHIP DE MELHORIA LENDÁRIA!";
    text[8880] = "Esse chip de melhoria permitirá que você equipe 5 Habilidades de Apoio Vermelhas!";
    text[8881] = "... E pode ser sua com uma condição...";
    text[8882] = "Se comprar TUDO que meus irmãos estiverem vendendo...";
    text[8883] = "Você receberá o CHIP DE MELHORIA LENDÁRIA de graça.";
    text[8884] = "Vejo que comprou tudo o que meus irmãos tinham em estoque.";
    text[8885] = "Você é oficialmente nossa cliente número 1 no mercado clandestino. Hehehe.";
    text[8886] = "Tome este presente de todos nós!";
    text[8887] = "Foi um prazer fazer negócios com você, senhorita Bella.";
    text[8888] = "Meu lema favorito é: Trabalhe Duro, Lanche Sempre!";
    text[8889] = "Pegue. Isso é pra você!";
    text[8890] = "Então, qual seu doce favorito?";
    text[8891] = "Barras de cheesecake, é claro!";
    text[8892] = "Aaaaaah!! Meu também!";
    text[8893] = "Curiosidade: também sou programadora freelancer.";
    text[8894] = "Pegue essa Ciberbarra de cheesecake para sua parceira robô!";
    text[8895] = "SÉRIO... ESSA CIBERBARRA DE CHEESECAKE É...";
    text[8896] = "CIBERLICIOSA!";
    text[8897] = "Já está escuro lá fora, então pega leve, ok?";
    text[8898] = "Não adianta nada trabalhar até a exaustão.";
    text[8899] = "Então fique e relaxe o quanto precisar até se sentir melhor, beleza?";
    text[8900] = "Nada aquece mais a calma do que um café lunar recém-passado.";
    text[8901] = "Ei, maravilhosa! Você se lembra?";
    text[8902] = "Do quê?";
    text[8903] = "Não lembro...";
    text[8904] = "(Vá embora)";
    text[8905] = "Vejo que se esqueceu. Não se preocupe, eu nunca me esqueço!";
    text[8906] = "Você lembrará antes do fim quem você realmente é.";
    text[8907] = "Suas memórias a carregarão para grandes alturas.";
    text[8908] = "Então deixe que elas sejam sua força e a guiem!";
    text[8909] = "... e lembre-se sempre, nunca se esqueça.";
    text[8910] = "Não vou.";
    text[8911] = "Você pode ter se esquecido, mas eu me lembrarei.";
    text[8912] = "Nos vemos por aí, camarada.";
    text[8913] = "Esta próxima canção é dedicada ao Jack e à Martha!";
    text[8914] = "Esta porta precisa de uma chave especial para abrir...";
    text[8915] = "Você usou a Chave da Mina para abrir a porta!";
    text[8916] = "Título secreto";
    text[8917] = "Sommelier\nde Rochas";
    text[8918] = "Vira-\nlatas";
    text[8919] = "Amiga\ndo Fiote";
    text[8920] = "Colecionadora\nde Pelúcias";
    text[8921] = "Rainha do\nChiclete";
    text[8922] = "Bem na\nHora!";
    text[8923] = "Decodificadora";
    text[8924] = "Velocista\nMestra";
    text[8925] = "Velocista\nNovata";
    text[8926] = "Exploradora\nLunar";
    text[8927] = "É mais de\n1.000!";
    text[8933] = "Bonjour! Vamos ver quanto tempo leva até você me alcançar...";
    text[8928] = "Sua jornada para chegar até mim foi RÁPIDA.";
    text[8929] = "Um pouco rápida demais...";
    text[8930] = "Acho que você é uma viajante do tempo ou uma decodificadora.";
    text[8931] = "De qualquer jeito, parabéns por me alcançar em tempo recorde!";
    text[8932] = "Esse é o melhor título que posso conceder a você!";
    text[8934] = "Increíble! Você chegou até mim em menos de 3 horas!";
    text[8935] = "Devo lhe conceder o título de: Velocista Mestra";
    text[8936] = "Stupéfiant! Você chegou até mim em menos de 8 horas!";
    text[8937] = "Devo lhe conceder o título de: Velocista Novata";
    text[8938] = "Intéressant! Você parece gostar de seguir no seu ritmo...";
    text[8939] = "... aproveitando cada momento...";
    text[8940] = "... mergulhando neste mundo belo...";
    text[8941] = "Uma pessoa como você merece o honrado título de: Exploradora Lunar!";
    text[8942] = "Quem sabe em outra dimensão temporal, eu teria lhe dado um título diferente...";
    text[8943] = "Quem sabe? Tudo depende de quanto tempo leva até chegar até mim.";
    text[8944] = "Adieu!";
    text[8945] = "Uma ampulheta estranha. Você decide virá-la...";
    text[8946] = "Você me encontrou bem a tempo!";
    text[8947] = "O que um cientista como você está fazendo aqui nas Minas de Sílica?";
    text[8948] = "Estou pesquisando e conduzindo experimentos de viagem no tempo!";
    text[8949] = "Eu construí um laboratório segredo aqui embaixo nesses fossos de minas abandonadas.";
    text[8950] = "Acha que consegue manter esse segredo entre a gente?";
    text[8951] = "Nossos lábios estão selados!";
    text[8952] = "Então, você conseguiu construir uma máquina do tempo?";
    text[8953] = "Ainda estou trabalhando nisso.";
    text[8954] = "Estou adaptando um veículo DeLorean com um capacitor de fluxo!";
    text[8955] = "Maneiro demais!";
    text[8956] = "Obrigado! Seu futuro é você quem cria, então crie um bom!";
    text[8958] = "A coragem desse cara...";
    text[8959] = "Como ele pode me trair depois de tudo o que passamos? ...";
    text[8966] = "(Ela parece distraída demais para nos notar.)";
    text[8979] = "(Talvez devêssemos deixá-la em paz.)";
    text[8960] = "Posso ajudar em alguma coisa?";
    text[8961] = "Ah, hm...";
    text[8962] = "Você está aqui para atrapalhar meus planos?";
    text[8963] = "Você é alguém que eu posso usar?";
    text[8964] = "Hm... Não?!";
    text[8965] = "Então fique fora do meu caminho.";
    text[8967] = "Não tenho tempo nem recursos sobrando para desperdiçar com você.";
    text[8968] = "Preciso continuar focada e bolar um plano...";
    text[8969] = "Ouvi dizer que você derrotou o líder dos bandidos, o Kerberos.";
    text[8977] = "Nunca fui forte o suficiente para derrotá-lo sozinha, então...";
    text[8978] = "Obrigada dar um jeito nele por mim.";
    text[8970] = "Eu costumava ser uma capitã importante no esquadrão dele.";
    text[8971] = "Formávamos uma bela equipe. Tudo estava indo bem até...";
    text[8972] = "Ele me trair e me expulsar da organização.";
    text[8973] = "Fico feliz que ele esteja fora de cena agora.";
    text[8974] = "Aquele traidor teve o que merecia.";
    text[8975] = "... Acho que é hora de finalmente seguir em frente com tudo isso.";
    text[8976] = "Cuide-se guerreira.";
    text[8980] = "Uau. Sua roupa é muito bonita!";
    text[8981] = "Obrigada. Eu mesma que a costurei.";
    text[8982] = "Na verdade, é um cosplay híbrido de dois dos meus programas favoritos:";
    text[8983] = "Sailor Luna e Magic Cure!";
    text[8984] = "Também sou uma Vtuber. Hehe.";
    text[8985] = "Quando não estou trabalhando em cosplays,";
    text[8986] = "passo meu tempo livre fazendo streaming de jogos divertidos!";
    text[8987] = "Uma pena que os Murks resolveram atacar a cidade bem no meu dia de folga.";
    text[8988] = "Cara, preciso tomar alguma coisa.";
    text[8989] = "Agora que a cidade está finalmente ativa de novo,";
    text[8990] = "acho que vou ficar relaxando no café pelo resto do dia.";
    text[8991] = "Oi! Eu sou a Dashie, a Cibercoelha!";
    text[8992] = "... E eu sou a Tetra, a Ciberescudeira! Hihi.";
    text[8993] = "Prazer em conhecê-la, Dashie!";
    text[8994] = "Então, qual sua especialidade?";
    text[8995] = "Eu opero uma biblioteca de fonte aberta que gerencia matrizes e vetores!";
    text[8996] = "Ah, eu conheço um pouco sobre matrizes!";
    text[8997] = "Eu... hm... não conheço nada sobre programação, então...";
    text[8998] = "Vou deixar vocês duas conversando enquanto dou uma olhadinha na loja.";
    text[8999] = "Belezinha!";
    text[9000] = "Olá! Pode me chamar de MiDi!";
    text[9001] = "Melhor robô-coelha DJ desta cidade!";
    text[9002] = "Escuta só a demo do álbum que vou lançar!";
    text[9003] = "Vamos nessa! Sente a vibe!";
    text[9004] = "Óculos são um reflexo de quem os usa.";
    text[9005] = "Tipo de armação? Lente? O jeito que os empurra quando eles escorregam?";
    text[9006] = "Tudo isso são fragmentos da alma delicadamente montada para se usar no rosto,";
    text[9007] = "como uma máscara transparente.";
    text[9008] = "Você...";
    text[9009] = "O que você acha de óculos?";
    text[9010] = "Óculos são legais!";
    text[9014] = "... E também são estilosos!";
    text[9011] = "!!!";
    text[9012] = "Brilhante!";
    text[9013] = "Vejo que vocês duas também são apreciadoras de óculos!";
    text[9015] = "Olá! Meu nome é Xiu.";
    text[9016] = "Sou um projetista de armas da Divisão 7.";
    text[9017] = "O general Saros ficou tão impressionado com meus desenhos que ele me transferiu";
    text[9018] = "para este setor para que eu pudesse desenvolver novas armas para caçar Murks.";
    text[9019] = "Esta espada que estou trabalhando é um protótipo de Holoespada.";
    text[9020] = "Teoricamente, ela deve ser capaz de cortar uma Murk";
    text[9021] = "sem danificar seu Antinúcleo.";
    text[9022] = "Isso tornará a extração de Antinúcleos muito mais fácil!";
    text[9023] = "Ei, que que cês tão de bobeira por aí?";
    text[9024] = "Sejam úteis e voltem aos seus postos!";
    text[9025] = "A postura séria deste guarda é inabalável.";
    text[9026] = "Ele olha pra você com frieza, sem piscar os olhos...";
    text[9027] = "Ei, eu vi você na TV!";
    text[9028] = "Você não é a Dycee do programa de crianças Tinkerer's Lab?";
    text[9029] = "Sim, eu mesma! Prazer em conhecê-las.";
    text[9030] = "O que é esse Tinkerer's Lab?";
    text[9031] = "Bom, é um programa que ensina e incentiva crianças a";
    text[9032] = "se empolgarem com ciência e tecnologia!";
    text[9033] = "No programa, Dycee e seu Geoligno Bebê, o Cascalho,";
    text[9034] = "trabalham juntos para criar o 'Cubo da Dycee'.";
    text[9035] = "A parte engraçada é que cada iteração do Cubo da Dycee";
    text[9036] = "nunca acaba parecendo um cubo.";
    text[9037] = "Isso mesmo! Primeiro, é uma pirâmide, depois um prisma octogonal";
    text[9038] = "e, por último, um formato monstruoso 4D...";
    text[9039] = "E, por fim, no final do esquete, eu grito";
    text[9040] = "'COMO É DIFÍCIL FAZER UM CUBO!'";
    text[9041] = "Vejo que você é uma grande fã do programa.";
    text[9042] = "Eu sou! Costumava assistir com a minha mãe todos os sábados quando era criança.";
    text[9043] = "Você mencionou um geoligno bebê... Ele é um Murk de verdade?";
    text[9044] = "Não, não. Cascalho é só uma marionete!";
    text[9045] = "Sempre fui fascinada por Geolignos e sua aparência...";
    text[9046] = "Isso acabou me inspirando a criar meu escudeiro,";
    text[9047] = "Cascalho, o geoligno bebê!";
    text[9048] = "Fiquei sabendo que algumas pessoas viram Geoligno de outras cores por aí.";
    text[9049] = "Adoraria ver um algum dia...";
    text[9050] = "Já vimos um Geoligno de outras cores!";
    text[9051] = "Olha aqui, veja no nosso BANCO DE DADOS...";
    text[9052] = "Fascinante! Um Geoligno-EX...";
    text[9053] = "E não é só uma variação de cor...";
    text[9054] = "Ele também é mais rápido e mais forte do que o original!";
    text[9055] = "Ei, obrigada por me mostrar isso!";
    text[9056] = "Quer saber?";
    text[9057] = "Você é uma robô muito fofa, Tetra.";
    text[9058] = "Adoraria tê-la como convidada no programa algum dia!";
    text[9059] = "E-eu? Em um programa de TV?";
    text[9060] = "SIM, POR FAVOR! EU IRIA AMAR!";
    text[9061] = "Você conversou com aquele senhor na minha frente que parece um papai noel excêntrico?";
    text[9062] = "Aparentemente, ele também o líder do culto que acredita que zumbis estão tentando";
    text[9063] = "devorar o sol... e o melhor jeito de impedir isso de acontecer...";
    text[9064] = "... é usando um número surreal de motosserras.";
    text[9065] = "AHN?? Isso é ridículo! Não há evidência ALGUMA disso...";
    text[9066] = "Eu sei! hehehe (Esconde a insígnia de membro do culto).";
    text[9069] = "Eu posso sentir... Há forças além da minha compreensão...";
    text[9070] = "... evitando que eu use qualquer banheiro público nas proximidades.";
    text[9071] = "Como posso eu, uma mera mortal, me libertar de tamanho destino cruel?";
    text[9072] = "Que tal usar o banheiro da sua casa?";
    text[9073] = "Isso levaria 4 horas dirigindo até minha casa nesse trânsito...";
    text[9074] = "Vou esperar...";
    text[9075] = "A comida aqui...";
    text[9076] = "é deliciosa...";
    text[9077] = "... Mas não tão boa quanto a comida que vendo no meu food truck.";
    text[9078] = "Qual seu carro-chefe?";
    text[9079] = "Eu chamo de Bocada.";
    text[9080] = "Uma só Bocada e você vai se sentir capaz de derrotar";
    text[9081] = "um exército de zumbis com um só dedo!";
    text[9082] = "O que é um Bocada? É uma sobremesa? Um salgado?";
    text[9083] = "Bocada...";
    text[9084] = "... é uma simples Bocada.";
    text[9085] = "...";
    text[9219] = "Como chefe dos médicos deste setor,";
    text[9220] = "é meu trabalho cuidar dos feridos... e há tantos.";
    text[9221] = "Temos lutado contra os Murks por quase 10 anos já...";
    text[9222] = "E se nossa situação nunca mudar?";
    text[9223] = "E se, mesmo nos esforçando para sobreviver,";
    text[9224] = "os Murks continuarem surgindo até todos morrermos?";
    text[9091] = "Me diga... O que você acha dos Murks?";
    text[9092] = "Bom, eu não os vejo como monstros irracionais.";
    text[9093] = "Pessoalmente, sofro com o fato de que preciso machucar";
    text[9094] = "essas criaturas para cumprir o meu dever como protetora do povo.";
    text[9095] = "Também sei que a maioria das pessoas não veem as coisas assim.";
    text[9096] = "Do ponto de vista de um civil...";
    text[9097] = "Os Murks mataram seus amigos e suas famílias...";
    text[9098] = "Aos olhos deles... Murks são monstros que não merecem compaixão.";
    text[9107] = "... Do outro lado... eu.";
    text[9108] = "... Uma soldada que realmente quer encontrar um jeito de me comunicar";
    text[9109] = "com os Murks e encontrar uma solução pacífica...";
    text[9110] = "... Uma solução onde ninguém precise morrer...";
    text[9101] = "Você conhece alguém mais que compartilhe da sua visão?";
    text[9102] = "Sim, minha mãe pensava da mesma forma...";
    text[9103] = "Entendi...";
    text[9225] = "Você não acha que é possível, não é?";
    text[9226] = "Acho que é mais fácil conversar com o sol.";
    text[9227] = "Os Murks são feitos de Antimatéria...";
    text[9228] = "Eles são essencialmente o completo oposto dos humanos.";
    text[9114] = "Não acredito que os Murks sejam irracionais...";
    text[9115] = "... mas também questiono o que de bom poderia vir em se comunicar";
    text[9116] = "com criaturas que são tão fundamentalmente diferentes de nós...";
    text[9117] = "Não importa quão próximos ou conectados nos tornemos, acredito que";
    text[9118] = "certas coisas sempre permanecerão irreconciliáveis...";
    text[9229] = "Faz sentido, mesmo discordando disso.";
    text[9230] = "Ainda reconheço e entendo seu ponto de vista.";
    text[9231] = "Não quero que ache que não dou valor à sua opinião.";
    text[9232] = "Não se preocupe. Fico feliz que tivemos essa conversa.";
    text[9233] = "Quero paz com os Murks. Mesmo.";
    text[9234] = "É só que...";
    text[9235] = "Eles são imensuravelmente diferentes de nós...";
    text[9236] = "Não tenho certeza se seríamos capazes de chegar a um entendimento mútuo.";
    text[9119] = "UAU! Sua armadura de batalha é muito maneira!";
    text[9120] = "Obrigada!";
    text[9125] = "Tenho trabalhado em diversos desenhos novos de armadura que são integradas";
    text[9126] = "com Tecnologia de Onda EM de última geração.";
    text[9127] = "Essa tecnologia nos permitiria materializar nossas armaduras com um simples pensamento!";
    text[9128] = "Também nos daria um aumento promissor em velocidade e poder.";
    text[9130] = "Você seria capaz de fazer a festa no campo de batalha!";
    text[9129] = "Você deu um nome para a armadura de batalha que está usando?";
    text[9122] = "Eu chamo essa de Armadura de Batalha: Força Estelar!";
    text[9123] = "Eu chamo essa de Armadura de Batalha: Armavolts";
    text[9124] = "Eu chamo essa de Armadura de Batalha: Zero";
    text[9131] = "Olá! Não ligue para mim...";
    text[9132] = "Estava só esperando o doutor voltar com os resultados do meu teste...";
    text[9145] = "Perguntinha rápida...";
    text[9133] = "Você já teve visões ou sonhos que pareciam vidas passadas,";
    text[9134] = "ancestrais ou coisas que poderiam ter acontecido?";
    text[9135] = "Teve um sonho que tive, onde eu tinha uma função importante em uma grande empresa...";
    text[9136] = "... e todas as pessoas eram homens das cavernas!";
    text[9137] = "Meu tatara... tatara... tatara... tatara... tatara... tataravô";
    text[9138] = "deve ter feito algo bem ruim.";
    text[9139] = "Ele foi coberto em concreto por seus empregados como punição!";
    text[9140] = "Poder para o povo! Esse é o sonho vívido que você teve.";
    text[9141] = "Bom, pelo menos agora, você está vivendo no presente e não fazendo...";
    text[9142] = "Seja lá o que for que você fez em seus sonhos.";
    text[9143] = "Sim... De qualquer jeito, agradeço por parar e conversar comigo.";
    text[9144] = "Cuide-se!";
    text[9146] = "Olá! Bom te ver novamente.";
    text[9147] = "Como está se sentindo?";
    text[9148] = "Hmm... Um pouco melhor agora já que tenho companhia.";
    text[9149] = "Meu amigo vai chegar já, já.";
    text[9150] = "Vamos assistir o novo filme Tripulação Catástrofe juntos!";
    text[9151] = "Espero que seja bom!";
    text[9152] = "Ah, não. É horrível!";
    text[9153] = "O estúdio não sabia como produzi-lo.";
    text[9154] = "Mas vai ser divertido já que vamos rir juntos dele!";
    text[9155] = "Parece o tipo de filme que eu gosto! Hehehe!";
    text[9156] = "Ei...";
    text[9157] = "Oi, Cooper...";
    text[9158] = "Espero que tenha curtido com seus amigos!";
    text[9159] = "Sim, obrigado...";
    text[9160] = "Foi um presente maravilhoso...";
    text[9161] = "Eu vou... guardar essa lembrança com muito carinho...";
    text[9162] = "...";
    text[9163] = "Bella... O tempo é algo precioso.";
    text[9164] = "O tempo é uma bênção.";
    text[9165] = "Use seu tempo com sabedoria";
    text[9166] = "e passe ele com seus amigos e pessoas que você ama... antes que ele acabe.";
    text[9167] = "E não tenha medo de se dar um presente de vez em quando.";
    text[9168] = "Só... deixa acontecer.";
    text[9169] = "A notícia ruim é que... Morri...";
    text[9170] = "... Mas a boa notícia é que estou em outro plano existencial nos";
    text[9171] = "corações e pensamentos de todos que amei.";
    text[9172] = "Um dia, quem sabe, voltarei como a visão de alguém.";
    text[9173] = "Eu realmente gostei da sua companhia, Bella.";
    text[9174] = "Agradeço por ter passado seu tempo precioso comigo.";
    text[9175] = "Obs.: Em suas viagens, se sentir vontade de experimentar algo chamado 'Especiaria',";
    text[9176] = "... não o faça!";
    text[9241] = "Alguém novo. 0x77686";
    text[9242] = "O que é isso?";
    text[9243] = "Eu sou... ou acho que sou...";
    text[9244] = "É um computador antigo.";
    text[9245] = "Ele deve estar perdido aqui atrás há um bom tempo.";
    text[9246] = "Pode me chamar de James King. 0xF6973";
    text[9247] = "Ok... Eu não estou ficando doida...";
    text[9249] = "Estou ouvindo uma voz estranha desde que entramos nesta sala...";
    text[9250] = "Cadê você? Saia de onde estiver!";
    text[9251] = "Estou bem na sua frente. 0x66726";
    text[9178] = "Dentro do computador??";
    text[9252] = "Isso é impossível!";
    text[9253] = "Agora me lembro. 0x9656E";
    text[9254] = "O trabalho da minha vida era uma transmissão do Cibermundo...";
    text[9255] = "Funcionou e eu entrei no Cibermundo... 0x646F7";
    text[9256] = "... mas fiquei preso e fui esquecido. 0x2666F";
    text[9248] = "Isso é terrível...";
    text[9180] = "Eu preciso sair daqui.";
    text[9181] = "Eu preciso... ser livre. 0x653F";
    text[9182] = "(Algo não parece certo... mas acho que vou ajudar...)";
    text[9183] = "Tetra, você consegue entrar no Cibermundo e ajudar a libertar o James?";
    text[9184] = "Com certeza! Deixa comigo!";
    text[9186] = "Gostaria de entrar no Cibermundo?";
    text[9187] = "JAMES: TOLAS. Agora estão no meu domínio!";
    text[9188] = "JAMES: Primeiro, quebrarei seu corpo!";
    text[9189] = "BELLA: Tetra, você encontrou o James?";
    text[9202] = "JAMES: ... depois, a sua MENTE!";
    text[9190] = "TETRA: Sim... Parece que...";
    text[9191] = "JAMES: Logo você aprenderá a conviver com a LOUCURA";
    text[9192] = "como eu o fiz!";
    text[9265] = "TETRA: Esse cara...";
    text[9259] = "TETRA: ELE CONTINUA ME INTERROMPENDO!";
    text[9193] = "TETRA: Agora, onde eu estava mesmo...";
    text[9257] = "TETRA: Parece que ele foi infectado por um vírus!";
    text[9260] = "BELLA: Tem como salvá-lo?";
    text[9261] = "TETRA: Meu Canhão Tetra deve ser capaz de";
    text[9262] = "neutralizar o vírus!";
    text[9264] = "Preciso lutar contra ele!";
    text[9263] = "BELLA: Certo. Tome cuidado! Você consegue, Tetra!";
    text[9194] = "Obrigado por me salvar, Bella.";
    text[9195] = "Sinto muito por atacá-la mais cedo...";
    text[9196] = "Passei tanto tempo no Cibermundo...";
    text[9197] = "... que me perdi lá.";
    text[9198] = "Não cometa o mesmo erro que cometi.";
    text[9199] = "Cuide-se.";
    text[9201] = "Não tem resposta...";
    text[9203] = "Avistei uma guerreira!";
    text[9204] = "... O que significa que você é uma cliente em potencial!";
    text[9205] = "O que você está vendendo?";
    text[9206] = "O melhor amigo de um guerreiro... OTIMIZADORES DE HABILIDADES!";
    text[9207] = "Para atingir 100% da Maestria de Habilidades,";
    text[9208] = "você precisará atingir o nível máximo de TODAS as suas Habilidades Ativas.";
    text[9209] = "Para fazer isso, você precisará de OTIMIZADORES DE HABILIDADES!";
    text[9210] = "Permita-me ajudá-la em sua missão para se tornar a guerreira suprema!";
    text[9211] = "Mesmo não tendo Otimizadores de Habilidades aqui,";
    text[9212] = "tenho funcionários em nove outros locais!";
    text[9213] = "Alguns deles realmente gostam de armar suas lojas em lugares inesperados...";
    text[9214] = "Boa sorte para encontrar todos eles!";
    text[9215] = "Sei exatamente o que está procurando... OTIMIZADORES DE HABILIDADES!";
    text[9216] = "Boa sorte em sua jornada para atingir 100% da Maestria de Habilidades!";
    text[9217] = "Você está com os 'itens'?";
    text[9218] = "Estou com os itens.";
    text[9266] = "Há um total de 5 EVENTOS DE SORTE que você pode encontrar!";
    text[9267] = "Fique de olho em estrelas cadentes no céu!";
    text[9268] = "Pelúcia de Ashe, a Fênix, obtida!";
    text[9269] = "Você está virando uma senhora colecionadora!";
    text[9270] = "Com base no tamanho do seu quarto, diria que você conseguirá expor";
    text[9271] = "até 12 pelúcias ou itens colecionáveis no total.";
    text[9272] = "Isso inclui as pelúcias de Axsoul, Kame e Metill que você me deu, né?";
    text[9273] = "Sim!";
    text[9274] = "A nova pelúcia que pedi finalmente chegou!";
    text[9275] = "Deixe-me adivinhar...";
    text[9276] = "Você também comprou uma pra mim?";
    text[9277] = "Sabemos que isso já virou tradição. Hehe.";
    text[9278] = "Eu amo ganhar presentes dos meus amigos!";
    text[9279] = "Aqui está!";
    text[9280] = "Sei bem demais como pode ser perigoso mexer com algo tão volátil";
    text[9281] = "como Antimatéria e Buracos de minhoca...";
    text[9282] = "Meu marido... Ele era um dos cientistas que morreu quando a Celestia falhou...";
    text[9283] = "Sinto muito pela sua perda, senhorita Nyla...";
    text[9284] = "Está tudo bem, querida...";
    text[9285] = "Após anos de terapia...";
    text[9286] = "Finalmente, ganhei a coragem para seguir em frente e aceitar a tragédia que aconteceu.";
    text[9287] = "Mas quando descobri que seu pai queria retomar o projeto...";
    text[9288] = "Inicialmente, tive minhas dúvidas... Estava com medo de perder outra pessoa importante para mim...";
    text[9289] = "Mas... acho que eu deveria lidar com isso com um pensamento mais positivo.";
    text[9290] = "Com cautela... mas positivo.";
    text[9291] = "Desta vez, vou me certificar que façamos tudo com cuidado... e direito.";
    text[9292] = "Sem margem para erros!";
    text[9293] = "Desenvolver um Antissoro E completar a Celestia em menos de um ano";
    text[9294] = "será um grande feito... Mié...";
    text[9295] = "Sei que vocês conseguem!";
    text[9296] = "Não há problema na Estação Espacial Lunex que a Equipe de Cientistas não consiga resolver!";
    text[9297] = "Além disso, você tem Nyla e meu pai para ajudá-lo.";
    text[9298] = "Como está o desenvolvimento do Antissoro?";
    text[9299] = "Ainda não avançamos muito...";
    text[9300] = "Agora, nossos especialistas técnicos estão extraindo todas as informações que podem";
    text[9301] = "dos servidores secretos do Saros.";
    text[9302] = "Um bom cientista sempre mantém um registro detalhado de seus experimentos.";
    text[9303] = "Vamos torcer para que os dele tenham as informações de que precisamos...";
    text[9305] = "Quando me contrataram para este trabalho, nunca imaginei que estaria trabalhando em";
    text[9306] = "um aparato tecnológico tão aterrorizante e fascinante quando a Celestia.";
    text[9307] = "... E nunca imaginei que teria que lidar com um cometa destruidor de mundos, como o Coda...";
    text[9308] = "Ah... Nada como um cafezinho pra manter a mente estimulada.";
    text[9309] = "Pai... Sua tolerância à cafeína é muito alta porque você toma litros.";
    text[9310] = "Quem sabe seja bom começar a reduzir o café?!";
    text[9311] = "Não posso... Eu tenho dores de cabeça astronômicas se diminuo...";
    text[9312] = "... E não dá para lidar com isso enquanto trabalho no gerador de Buraco de Minhoca...";
    text[9313] = "Bom... Pelo menos faça pausas de vez em quando, pode ser?";
    text[9314] = "Na verdade, é o que estou fazendo agora!";
    text[9315] = "Minha rotina atual é: 23 horas de trabalho e 1 hora de pausa para o café. Hehe.";
    text[9316] = "E DORMIR?";
    text[9317] = "E COMER?";
    text[9318] = "Ei, eu só tô zoando vocês!";
    text[9319] = "(... Ou talvez não...)";
    text[9320] = "(Preciso fazer o que for preciso para proteger minha família e salvar a humanidade...)";
    text[9321] = "Pai, você ficou preso no Reino Fantasma por um bom tempo...";
    text[9322] = "É melhor relaxar e descansar por alguns dias.";
    text[9323] = "Após tudo o que aconteceu,";
    text[9324] = "acho que todos precisamos de um bom descanso antes de voltar a colocar a mão na massa.";
    text[9325] = "Você será uma mulher ocupada!";
    text[9326] = "Como assim?";
    text[9327] = "O Povo de Luna nos enviou milhares de e-mails";
    text[9328] = "desde que impedimos Saros e revelamos a verdade sobre os Murks ao público.";
    text[9329] = "Uma maioria esmagadora do povo declarou";
    text[9330] = "que quer tê-la como a nova General deles!";
    text[9331] = "Sua mãe e eu... Estamos muito orgulhosos.";
    text[9332] = "Sempre foi o seu destino...";
    text[9333] = "... liderar o povo de Luna para um futuro cheio de esperanças!";
    text[9335] = "Pai...";
    text[9336] = "Seu incentivo significa um mundo para mim.";
    text[9337] = "Prometo ser uma líder que o povo pode confiar!";
    text[9338] = "Mas...";
    text[9339] = "Não poderei fazer isso sozinha...";
    text[9340] = "Uma boa líder precisa de uma equipe forte!";
    text[9341] = "Nickle, aceita ser meu Comandante?";
    text[9342] = "E-eu? Um Comandante da Força Lunex??";
    text[9343] = "Não só um Comandante, mas um parceiro confiável em quem posso confiar.";
    text[9344] = "Se vamos salvar as pessoas que foram transformadas em Murks";
    text[9345] = "e impedir o Cometa Coda, precisarei do seu apoio.";
    text[9346] = "Eu...";
    text[9347] = "Seria uma honra!";
    text[9348] = "Então isso está resolvido. Hahaha!";
    text[9349] = "Agora, Nickle...";
    text[9350] = "Tenho uma pergunta importante...";
    text[9351] = "... Qual, dr. Thomas?";
    text[9352] = "Você gosta de café??";
    text[9353] = "POR FAVOR, DIGA QUE GOSTA!";
    text[9354] = "Até que gosto!";
    text[9355] = "PERFEITO!";
    text[9356] = "Por que não pega um cafezinho pra gente lá na cafeteria";
    text[9357] = "e batemos um papo?";
    text[9358] = "C-claro!";
    text[9359] = "Não precisa ficar nervoso!";
    text[9360] = "Meu pai sempre se esforça para conhecer novos membros da equipe!";
    text[9361] = "Divirtam-se, vocês dois!";
    text[9362] = "É o Fórum Lunex!";
    text[9363] = "É o Fórum de Copernicus!";
    text[9364] = "Emmet";
    text[9365] = "Clube dos Observadores de Estrelas";
    text[9366] = "Saudações, amigos observadores!";
    text[9367] = "Emmet aqui, pronto para compartilhar os melhores locais para observar estrelas!";
    text[9368] = "Peguem seus telescópios e ajustem suas coordenadas para Tycho!";
    text[9389] = "Chad";
    text[9390] = "Sou um idiota?";
    text[9391] = "Então, minha namorada e eu saímos outro dia desses...";
    text[9392] = "... Essa publicação tem, tipo, uns dezessete parágrafos.";
    text[9393] = "Você decide não ler.";
    text[9394] = "Moderador";
    text[9395] = "RE: Sou um idiota?";
    text[9396] = "Ei, Chad, esse tipo de publicação não está relacionado ao Fórum Lunex.";
    text[9397] = "Há subfóruns para esse tipo de assunto.";
    text[9398] = "Por favor, evite jogar drama de relacionamento aqui. Obrigado.";
    text[9419] = "Whitney";
    text[9420] = "Leite MuMu";
    text[9421] = "Alguém percebeu como o leite está caro hoje em dia??";
    text[9422] = "Isso é ridículo!";
    text[9423] = "Morty";
    text[9424] = "RE: Leite MuMu";
    text[9425] = "Não só o leite... O Rancho Kepler tem passado por";
    text[9426] = "problemas de produção de comida devido aos Murks...";
    text[9427] = "Assim... Já estávamos com problema para suprir a demanda de comida";
    text[9428] = "antes de os Murks aparecerem, mas, agora... está complicado!";
    text[9465] = "Cecile";
    text[9470] = "Voz misteriosa";
    text[9466] = "Eu estava indo para a Sala da Central de Comando no Piso 3 quando...";
    text[9467] = "... ouvi uma voz baixinha...";
    text[9468] = "... De repente, a voz soou estranha e distorcida...";
    text[9469] = "Tentei procurar de onde vinha a voz, mas... nada.";
    text[9527] = "Fórum Lunex";
    text[9528] = "ERRO 404";
    text[9529] = "Oxe... Tem algo errado com o Fórum?";
    text[9530] = "Geralmente vejo centenas de publicações aqui todos os dias...";
    text[9531] = "Aparentemente, os cientistas sobrecarregaram o servidor com suas ideias de pesquisa.";
    text[9532] = "Bom...";
    text[9533] = "Também há Fóruns em Copernicus, Tycho e na Colônia Sílica!";
    text[9534] = "Podemos conferi-los quando tivermos a chance. Hehe.";
    text[9369] = "Pegue seu equipamento de escalada e ajuste suas coordenadas para as Fendas de Sílica!";
    text[9378] = "Relatório de pessoas desaparecidas";
    text[9379] = "Esta publicação do fórum contém uma lista atualizada de";
    text[9380] = "pessoas que foram declaradas como 'DESAPARECIDAS'.";
    text[9381] = "Se tiver qualquer informação sobre o paradeiro de qualquer uma dessas pessoas,";
    text[9382] = "entre em contato com a Força Lunex imediatamente.";
    text[9373] = "Sebastian";
    text[9374] = "Guilda dos Caçadores de Tesouros";
    text[9375] = "Ei! Estamos procurando novos membros para entrar na Guilda dos Caçadores de Tesouros!";
    text[9376] = "Se tiver interesse, dê um pulo na Colônia Sílica e procure nosso parceiro Fortuno!";
    text[9384] = "Jason";
    text[9385] = "Grande inauguração!";
    text[9386] = "Se for fã de robôs e precisar de um técnico em robótica, conte comigo!";
    text[9388] = "Venha conferir nossa grande inauguração da BlanK Robotics em Tycho!";
    text[9444] = "Serenidade";
    text[9445] = "Fã-clube do Saros";
    text[9446] = "Ouvi dizer que Saros é a pessoa mais jovem a ser nomeada";
    text[9447] = "General da Força Lunex.";
    text[9448] = "O lendário herói de Luna... Ele tem só 28 anos!";
    text[9449] = "Joey";
    text[9450] = "RE: Fã-clube do Saros";
    text[9451] = "Saros é legal e tudo mais...";
    text[9452] = "Mas alguém sabe mais sobre comandante Vivia?";
    text[9453] = "Meio que queria começar um fã-clube dela...";
    text[9496] = "Glossário de Batalha";
    text[9497] = "Efeitos de Status";
    text[9498] = "Há 3 efeitos de Status que você pode infligir em seu oponente:";
    text[9499] = "ATORDOAR, QUEIMAR e ENCHARCAR!";
    text[9500] = "Um inimigo que recebe ATORDOAR não é capaz de atacar por 1 turno!";
    text[9501] = "Um inimigo que recebe QUEIMAR perderá PV por um número definido de turnos!";
    text[9502] = "Quanto a ENCHARCAR... Seu Luxômetro encherá mais rápido quando atacar";
    text[9503] = "um inimigo com o Efeito de Status ENCHARCAR!";
    text[9412] = "Ouro";
    text[9413] = "Fatos sobre Combos Lux";
    text[9414] = "Eis um fato interessante!";
    text[9415] = "Há um total de 30 receitas de Combos Lux que você pode experimentar!";
    text[9416] = "Cerca de um terço dessas receitas é bem fácil de ser lembrado...";
    text[9417] = "Basta usar três habilidades iguais!";
    text[9418] = "Contudo, os outros dois terços requerem... experimentação.";
    text[9371] = "Peguem seu casaco de neve e ajustem suas coordenadas para o Monte Piton!";
    text[9372] = "Essas estrelas cadentes passarão em um piscar de olhos!";
    text[9434] = "Chicletes";
    text[9435] = "Há uma Habilidade Ativa que amo usar, mas...";
    text[9436] = "... meu Custo de PE é alto demais!";
    text[9437] = "É possível reduzir de algum jeito o CUSTO DE PE de uma das minhas Habilidades Ativas?";
    text[9430] = "RESPOSTA 1: Chicletes";
    text[9431] = "Use um Chiclete. Chicletes reduzem permanentemente o CUSTO DE PE de";
    text[9432] = "uma das suas Habilidades Ativas em 5.";
    text[9438] = "RESPOSTA 2: Chicletes";
    text[9439] = "Fiz algumas pesquisas e, aparentemente, Chicletes são extremamente raros!";
    text[9440] = "Parece que você já experimentou um, ReiDaNet...";
    text[9441] = "... Você tem um Chiclete sobrando?";
    text[9442] = "RESPOSTA 3: Chicletes";
    text[9443] = "Não.";
    text[9515] = "Momo";
    text[9516] = "Echo!";
    text[9517] = "Ontem, vi a Echo, a Gata Espacial, torcendo por mim enquanto eu treinava para";
    text[9518] = "a maratona que está chegando! Sério... gatos são demais!!";
    text[9519] = "Kohaku";
    text[9520] = "RESPOSTA 1: Echo";
    text[9521] = "Se não for chato perguntar, onde você viu a Echo?";
    text[9522] = "RESPOSTA 2: Echo";
    text[9523] = "Ontem eu a vi enquanto corria perto do Café Sílica.";
    text[9524] = "Antes de ontem, vi a Echo voando sobre as rodovias de Copernicus.";
    text[9525] = "... E a primeira vez que vi a Echo, foi bem aqui em Tycho.";
    text[9526] = "Echo estava voando bem por cima de mim enquanto eu conferia o Fórum de Tycho.";
    text[9400] = "Cara-da-Area51";
    text[9401] = "Base Militar";
    text[9402] = "Outro dia, estava explorando a Zona Desolada e comecei a me perguntar...";
    text[9403] = "Por que não há Jatoplataformas perto da Base Militar?";
    text[9404] = "Riku";
    text[9405] = "RESPOSTA 1: Base Militar";
    text[9406] = "Presumo que permitir voos com Traje a Jato perto da Base Militar";
    text[9407] = "seria um risco de segurança em potencial.";
    text[9410] = "Cara, de qualquer forma, o que que você tá fazendo perto da Base Militar?";
    text[9411] = "Se a Força Lunex te avisar, você vai se meter em encrenca!";
    text[9540] = "RESPOSTA 2: Base Militar";
    text[9409] = "Cara-da-Area51... Precisamos conversar.";
    text[9370] = "Pegue suas roupas de banho e ajustem suas coordenadas para o Recife Harmonia!";
    text[9455] = "Buracos Escuros de Murks";
    text[9456] = "Se algum dia cruzar com um Buraco de Murk de cor cinza...";
    text[9457] = "Mantenha distância se dá valor à sua vida!";
    text[9458] = "Um de meus amigos encontrou um Murk de outra cor";
    text[9459] = "que surgiu de um Buraco Escuro de Murk e quase não conseguiu escapar...";
    text[9460] = "Eles começaram a aparecer recentemente,";
    text[9461] = "então a Força Lunex ainda não tem muitos dados a respeito deles, mas...";
    text[9462] = "... ouvi dizer que estão classificando esses Murks como Murks 'EX'.";
    text[9463] = "Murks EX são mais fortes e mais rápidos do que os originais...";
    text[9464] = "Protejam-se lá fora, pessoal!";
    text[9472] = "Títulos secretos";
    text[9473] = "Estou em uma missão para obter todos os TÍTULOS SECRETOS que existem!";
    text[9474] = "Se alguém tiver informações sobre como obter um TÍTULO SECRETO,";
    text[9475] = "por favor, compartilhe! Diga-me como posso ajudar!";
    text[9477] = "RESPOSTA 1: Títulos secretos";
    text[9504] = "Se contarmos como conseguimos nossos títulos,";
    text[9505] = "não faria sentido ser um título 'SECRETO'...";
    text[9506] = "Mas... Acho que não vai doer dar uma dica para aqueles mais perdidos...";
    text[9507] = "Aqui está a minha: ROCHAS!";
    text[9479] = "RESPOSTA 2: Títulos secretos";
    text[9508] = "Aqui está a minha: Lixeiras de Regolithia!";
    text[9481] = "RESPOSTA 3: Títulos secretos";
    text[9509] = "Ouvi dizer que fazer carinhos em cachorros é bem legal...";
    text[9513] = "Melody";
    text[9483] = "RESPOSTA 4: Títulos secretos";
    text[9510] = "PELÚCIAS FOFINHAS!";
    text[9485] = "RESPOSTA 5: Títulos secretos";
    text[9511] = "Chicletes.";
    text[9514] = "Emilienadora";
    text[9487] = "RESPOSTA 6: Títulos secretos";
    text[9512] = "Bonjour! Encontre-me o mais RÁPIDO que puder!";
    text[9541] = "Dr. Nexus";
    text[9489] = "RESPOSTA 7: Títulos secretos";
    text[9490] = "Tenho duas palavras... Lava e Ampulheta!";
    text[9491] = "RESPOSTA 8: Títulos secretos";
    text[9492] = "É bom ver a comunidade se unindo assim.";
    text[9493] = "Aqui está a dica para um Título Secreto que recebi outro dia:";
    text[9494] = "'É mais de 1.000!'";
    text[9495] = "Boa sorte!";
    text[9535] = "PROTOCOLO DE TREINO POR IMAGEM INICIADO...";
    text[9536] = "PREPARANDO GERADORES DE HOLOGRAMAS EM ESTADO SÓLIDO...";
    text[9537] = "SELECIONE O INIMIGO DESEJADO...";
    text[9538] = "Esquadrão Raine";
    text[9539] = "Murktador";
    text[9542] = "O que está acontecendo?";
    text[9543] = "A antiga comandante Vivia fugiu da cela...";
    text[9544] = "Ela deixou um bilhete para você:";
    text[9545] = "Não venha atrás de mim.";
    text[9546] = "Preciso de tempo para refletir sobre meus atos...";
    text[9547] = "Preciso de tempo para superar todos esses sentimentos de traição...";
    text[9548] = "... Desativei as proteções dos meus servidores de dados pessoais para que os analistas de dados de Thomas";
    text[9549] = "possam extrair qualquer informação que possa a vir a ser útil na criação do Antissoro.";
    text[9550] = "Há segredos que até Saros escondeu de mim. Você terá que descobrir um jeito";
    text[9551] = "de acessar os registros de experimentos dele sozinha.";
    text[9553] = "Espero que encontre o que procura, Bella.";
    text[9554] = "O General Saros a desafia a atingi-lo com um Combo Lux!";
    text[9555] = "Para iniciar um Combo Lux em batalha, você deve atingir o máximo do seu Luxômetro!";
    text[9556] = "O medidor aumenta toda vez que usar uma Habilidade Ativa";
    text[9557] = "e cada vez que bloquear os ataques do seu oponente!";
    text[9558] = "ENER-G: RECUPERA 20% DE PV E PE";

    text[9833] = "Melhoria da Explosão Tetra!";
    text[9834] = "Dê um Ener-G para Kazuma matar sua sede!";
    text[9835] = "Mostre a Aqua que você tem pelo menos 20 Ranques S!";
    text[9836] = "Nova Habilidade de Apoio";
    text[9837] = "Derrote o Mestre das Perguntas em seu próprio jogo!";
    text[9838] = "Derrote Raine em um duelo na frente do Café Regolithia!";
    text[9839] = "Complete o Desafio de Ranque S do James Bonder e derrote-o em um duelo!";

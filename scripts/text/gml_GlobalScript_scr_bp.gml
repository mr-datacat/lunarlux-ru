    text[10331] = "3 soldados Lunex aparecem e\natacam! Causa 60 de dano no total";
    text[10332] = "4 soldados Lunex aparecem e\natacam! Causa 80 de dano no total";
    text[10333] = "5 soldados Lunex aparecem e\natacam! Causa 100 de dano no total";
    text[10334] = "Ganhe 100 bytes a mais no final\nda batalha (máx. 400)";
    text[10335] = "Ganhe 150 bytes a mais no final\nda batalha (máx. 600)";
    text[10336] = "Ganhe 200 bytes a mais no final\nda batalha (máx. 800)";
    text[10337] = "Ganhe 250 bytes a mais no final\nda batalha (máx. 1000)";
    text[10338] = "Ganhe 2 astroteca a mais no final\nda batalha (máx. 6)";
    text[10339] = "Ganhe 4 astroteca a mais no final\nda batalha (máx. 12)";
    text[10340] = "Ganhe 6 astroteca a mais no final\nda batalha (máx. 18)";
    text[10341] = "Ganhe 10 astroteca a mais no final\nda batalha (máx. 30)";
    text[10342] = "+4 de bônus de recompensa\nde EXP e Pontos de Habilidade (máx. 12)";
    text[10343] = "+6 de bônus de recompensa\nde EXP e Pontos de Habilidade (máx. 18)";
    text[10344] = "+8 de bônus de recompensa\nde EXP e Pontos de Habilidade (máx. 24)";
    text[10345] = "+10 de bônus de recompensa\nde EXP e Pontos de Habilidade (máx. 30)";
    text[10346] = "-35 PV por +75 de bônus de dano";
    text[10347] = "-45 PV por +100 de bônus de dano";
    text[10348] = "-55 PV por +125 de bônus de dano";
    text[10349] = "-65 PV por +150 de bônus de dano";
    text[10350] = "Inimigos não mirados\nrecebem 20% de dano";
    text[10351] = "Inimigos não mirados\nrecebem 30% de dano";
    text[10352] = "Inimigos não mirados\nrecebem 40% de dano";
    text[10353] = "Inimigos não mirados\nrecebem 50% de dano";
    text[10354] = "Disparo de carga com 40 PDR após habilidade";

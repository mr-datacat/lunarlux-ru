function scr_bp()
{
    text[1] = "Oi, mãe.";
    text[2] = "Já faz alguns meses desde que me alistei à Força Lunex.";
    text[3] = "Até agora, está indo tudo bem!@P Proteger os cidadãos de Luna é um trabalho incrível.";
    text[4] = "Finalmente, entendo como você deve ter se sentido.";
    text[5] = "Você era tão incrível!@P Sempre inspirando esperança e coragem nos outros.";
    text[6] = "Todos a admiravam.@P \nVocê era a maior guerreira de Luna.";
    text[7] = "E@P.@P.@P. Mesmo que você esteja em um lugar melhor agora@P.@P.@P.";
    text[8] = "Eu vou garantir que a esperança nunca seja perdida!";
    text[9] = "Não será fácil, mas farei o meu melhor para me tornar tão forte e capaz como você um dia.";
    text[10] = "Cuide-se, mãe.@P \nEm breve, venho visitá-la de novo.";
    text[11] = "Bellaaaa!";
    text[12] = "Hehe. Nossa nave está totalmente recarregada!";
    text[13] = "Bom trabalho, Tetra!";
    text[14] = "Já quer voltar para casa?";
    text[15] = "Deixe-me ver a programação@P.@P.@P.";
    text[16] = "Sim! Acho que as reuniões do meu pai provavelmente já terão terminado quando chegarmos ao laboratório.";
    text[17] = "Beleza!";
    text[18] = "Nossa nave está ancorada no Hoverporto Sudeste.";
    text[19] = "Então, vamos que vamos!";
    text[20] = "Murk identificado! CODINOME: HIPERABELHA";
    text[21] = "Central de Comando, aqui quem fala é Bella Grey.";
    text[22] = "Encontrei um Murk hostil no Setor 16.";
    text[23] = "Solicitando permissão para enfrentá-lo!";
    text[24] = "@P.@P.@P. Entendido!";
    text[25] = "Tetra! Vamos nos preparar para a batalha!";
    text[26] = "Vamos nessa!";
    text[27] = "Desculpa.";
    text[28] = "Queria que houvesse um jeito melhor@P.@P.@P.";
    text[29] = "Um jeito de nos comunicarmos com os Murks e nos entendermos.";
    text[30] = "Espero que um dia possamos coexistir sem derramarmos sangue.";
    text[31] = "Bella, os Murks são assustadores@P.@P.@P. Eles devoram humanos!";
    text[32] = "Eles estão só tentando sobreviver.";
    text[33] = "Pelo menos, seus Antinúcleos nos ajudam a aprender mais sobre eles!";
    text[34] = "Podemos usar tecnologias de Antimatéria e Exoesqueletos graças aos Antinúcleos.";
    text[35] = "Ainda não gosto disso. Não parece certo@P.@P.@P.";
    text[36] = "Minha mãe teria buscado outra solução@P.@P.@P. Um jeito de estabelecer a paz.";
    text[37] = "De qualquer forma@P.@P.@P. Vamos dar o nosso melhor para proteger o povo de Luna!";
    text[38] = "Certo, Super Escudeira Tetra?!";
    text[39] = "SIM, CLARO! Hihi. Tetra dará o seu melhor!";
    text[40] = "Senhorita Bella!";
    text[41] = "Os reforços chegaram!";
    text[42] = "Obrigada por virem, mas o alvo já foi eliminado.";
    text[43] = "Graças à ajuda da Suprema Escudeira Tetra! Hihi.";
    text[44] = "Bom trabalho, como sempre, senhorita Bella!";
    text[45] = "Fico feliz que não havia civis nas proximidades desta vez.";
    text[46] = "Aparentemente, os Murks podem surgir em qualquer lugar por conta dos buracos de minhoca@P.@P.@P.";
    text[47] = "Já se perguntou como deve ser o mundo deles dentro dos buracos de minhoca?!";
    text[48] = "Não quero nem pensar nisso...";
    text[49] = "Somente o Esquadrão da antiga general Grey voltou de lá.";
    text[50] = "Ouvi dizer que há Murks por todas as partes!";
    text[51] = "Ai, ai. Sinto arrepios só de pensar!";
    text[52] = "Uma vez em um buraco de minhoca, não dá para voltar atrás.";
    text[53] = "Poucos estiveram no mundo deles@P.@P.@P. E, mesmo assim, poucos voltaram com vida.";
    text[54] = "Além disso, a Central de Comando proibiu missões não autorizadas por lá.";
    text[55] = "Bora, vamos transportar este Antinúcleo de volta para o QG.";
    text[56] = "(De novo@P.@P.@P. Essa sensação.)";
    text[57] = "(Não sei o que é.)";
    text[58] = "(Será que só eu sinto?)";
    text[59] = "Espere um pouco.";
    text[60] = "Deixe-me transportar o Antinúcleo.";
    text[61] = "Hm. Tem certeza, senhorita Bella?";
    text[62] = "É seu dia de folga! Pode descansar.";
    text[63] = "Não, não. Está tudo bem. Eu cuido disso.";
    text[64] = "Pois bem, senhorita Bella. Agradecemos por sua dedicação.";
    text[66] = "Patrulharemos a área para caso outros Murks decidam aparecer.";
    text[67] = "Bom, Tetra, vamos nessa!";
    text[68] = "Belezinha!";
    text[215] = "Bellinha, nossa nave está a leste!";
    text[216] = "Ah, eu sei. Não me aguentei. Eu amo explorar Luna!";
    text[217] = "Hmmmm... esse aroma@P.@P.@P.";
    text[218] = "Estou ficando com fome!";
    text[219] = "Barras de cheesecake?!";
    text[220] = "Você me conhece mesmo, Tetra. Hehe.";
    text[221] = "Hihi.";
    text[222] = "Vamos beliscar algo no café antes de voltarmos para a nave.";
    text[223] = "Belezinha!";
    text[71] = "Boas-vindas ao Café Regolithia! Em que posso ajudar?";
    text[72] = "Oi, gostaria de três barras de cheesecake e um vanilla latte gelado, por favor.";
    text[73] = "Pode deixar. É pra já!";
    text[74] = "Eita, TRÊS barras de cheesecake?";
    text[75] = "Uma para agora.";
    text[76] = "Uma para depois.";
    text[77] = "E uma para depois de depois?";
    text[78] = "Exatamente.";
    text[79] = "Seu pedido está pronto, senhorita. Aqui está!";
    text[80] = "Não se preocupe com o pagamento. É por conta da casa!";
    text[81] = "Ah, sério?! Muito obrigada!";
    text[82] = "Não, não. Nós que agradecemos!";
    text[83] = "Quando recebemos o sinal de alerta de que havia um Murk lá fora, ficamos bem preocupados.";
    text[84] = "Se não fosse pela Força Lunex, quem sabe qual o estrago que os Murks teriam causado.";
    text[85] = "Nós que agradecemos pelos seus serviços, senhorita!";
    text[86] = "Nossa... obrigada! Continuaremos dando o nosso melhor!";
    text[224] = "Espera, ainda não terminei de comer! Vamos ficar mais um pouquinho.";
    text[225] = "Ok!";
    text[226] = "Os moradores são bem simpáticos. Quem sabe possamos conversar com alguns deles...";
    text[391] = "Ei, você ficou sabendo do Murktador?";
    text[392] = "... Não. O que aconteceu?";
    text[393] = "Os moradores daqui disseram ter visto o Murktador caçando alguns Murks hoje.";
    text[394] = "O Murk nem teve chance. Ele foi morto com um único golpe!";
    text[395] = "... Pelo menos os cidadãos não saíram feridos.";
    text[396] = "Há poucos soldados na Força Lunex que realmente conseguem";
    text[397] = "se garantir em uma batalha contra um Murk sem contar com os Exoesqueletos.";
    text[398] = "Dizem os boatos que o Murktador está na casa dos 20 anos.";
    text[399] = "Vai saber... Quem sabe um dia tiramos aquela máscara dele e descobrimos quem ele realmente é.";
    text[400] = "Como será que ele ficou tão forte?";
    text[401] = "Se um dia nos encontrarmos, acho que perguntarei para ele.";
    text[402] = "... após capturá-lo, é claro.";
    text[403] = "Mais e mais tropas de patrulha estão sendo enviadas dia após dia.";
    text[404] = "A frequência com que os Murks têm aparecido também tem aumentado gradualmente...";
    text[405] = "Estamos nos saindo relativamente bem, mas... espero que as coisas não saiam do controle.";
    text[406] = "Vou tentar encaixar alguns treinos mais tarde.";
    text[407] = "A Sala do Simulador de Batalha na Estação Espacial Lunex é ótima para treinar!";
    text[408] = "Ei, valeu pela dica!";
    text[227] = "Ei, Bella.";
    text[228] = "Pois não?";
    text[229] = "Lembra-se do que o soldado azul falou?";
    text[230] = "O Murktador está na casa dos 20 anos.";
    text[231] = "E...";
    text[232] = "Ele também é bem forte. Tetra lembra de Bella dizer que gosta de homens fortes.";
    text[233] = "Bom candidato para namoro! Adicionando à lista de potenciais@P.@P.@P.";
    text[234] = "Tetra!";
    text[235] = "Você me deixa com vergonha...";
    text[236] = "Nem fazia ideia de que você tinha uma lista dessas.";
    text[237] = "Tenho uma coleção completa de listas no meu banco de dados! Hihi.";
    text[238] = "Ele pode ser forte, mas não concordo com suas ações.";
    text[239] = "Ele é um justiceiro procurado que caça Murks para tirar seus Antinúcleos.";
    text[240] = "Os Antinúcleos são um recurso valioso que ainda não compreendemos totalmente...";
    text[241] = "E, mesmo não gostando de usá-los, precisamos deles para aprender mais sobre os Murks.";
    text[242] = "Não sei quais são os motivos dele e é por isso que precisamos capturá-lo.";
    text[243] = "Ele é um sonho...";
    text[244] = "(Suspiro) Vamos, é hora de irmos.";
    text[87] = "Você está pronta para ir à Estação Espacial Lunex?";
    text[88] = "Bella, Murk detectado!";
    text[89] = "Você conseguiu identificá-lo?";
    text[90] = "Não, estava se movendo muito rápido.";
    text[91] = "O piloto daquele Hovercraft está em perigo!";
    text[92] = "O Hovercraft bateu e pousou...";
    text[93] = "Parece que a explosão veio das Instalações da Barreira.";
    text[94] = "Vamos, Tetra, precisamos ajudá-los! Rápido!";
    text[95] = "OBJETIVO: RUME A OESTE PARA INVESTIGAR AS INSTALAÇÕES DA BARREIRA.";
    text[96] = "Murk identificado! CODINOME: GEOLIGNO";
    text[97] = "Precisamos proteger os civis a qualquer custo!";
    text[98] = "Senhorita Bella! Estamos aqui para ajudá-la!";
    text[99] = "Será que damos conta de três Murks de uma só vez?";
    text[100] = "Não se preocupe, Tetra. Desta vez, temos reforços.";
    text[101] = "Bella, fique atenta com quantos Holoescudos ainda há em batalha!";
    text[102] = "Certo!";
    text[103] = "Vamos lá, esquadrão! Vamos mostrar a esses Murks o poder da Força Lunex!";
    text[104] = "Ah, eles não soltaram Antinúcleos desta vez...";
    text[105] = "(Inspira)... (Arfa)... Sim@P.@P.@P.";
    text[106] = "Bella? Você está bem?";
    text[107] = "Estou ótima.";
    text[108] = "Não temos tempo a perder. Vamos logo para as Instalações da Barreira.";
    text[109] = "Está tudo bem mesmo? ...";
    text[110] = "@P.@P.@P. Sim! Vamos logo, precisamos ajudá-los!";
    text[1471] = "Aquela batalha foi intensa! Suas habilidades são incríveis, senhorita Bella!";
    text[1472] = "Ficaremos de olho para garantir que os civis permanecerão seguros.";
    text[111] = "(Arfa)@P.@P.@P. (Arfa)@P.@P.@P.";
    text[112] = "@P.@P.@P. Céus, está ficando difícil respirar...";
    text[113] = "Ó não...";
    text[114] = "Bella, os níveis de oxigênio estão diminuindo aos poucos!";
    text[115] = "A Astrobarreira está no modo de emergência?";
    text[116] = "Talvez tenha ocorrido uma violação no sistema...";
    text[117] = "Você acha que o Murk que voou mais cedo pode ter causado essa violação?";
    text[118] = "Possivelmente...";
    text[119] = "Precisaremos lutar contra aquele Murk se nos encontrarmos novamente...";
    text[120] = "Vamos evitar matar qualquer Murk a menos que seja absolutamente necessário...";
    text[121] = "Ok!";
    text[122] = "A Astrobarreira é a única coisa que nos impede de sair voando para o espaço.";
    text[123] = "Ela precisa ser protegida.";
    text[124] = "Precisamos investigar!";
    text[306] = "Ah...";
    text[307] = "Quase morrer ao aterrissar já é estresse o suficiente para um só dia...";
    text[308] = "Ó não...";
    text[309] = "Ah. Eu... estou ferrado.";
    text[310] = "Como estrelas vou consertar isso?";
    text[311] = "Com licença. Olá!";
    text[312] = "Meu nome é Bella! Sou da Força Lunex.";
    text[313] = "Viemos ajudar! Conte-nos o que aconteceu.";
    text[314] = "Ah... gra-graças aos céus!";
    text[315] = "Meu nome é Mett. Sou um Tra-transportador de Cargas.";
    text[316] = "Mett, respire fundo e relaxe. Vai ficar tudo bem.";
    text[317] = "Desculpe-me, senhorita Bella. Costumo ga-gaguejar quando estou muito agoniado...";
    text[318] = "En-então. Um Murk vo-voador assustador apareceu do na-nada";
    text[319] = "enquanto eu saia para entregar um no-novo carregamento de Painéis Lunares...";
    text[320] = "Ele danificou meu Hovercraft, causou um surto de energia e desapareceu...";
    text[321] = "O surto de energia repentino é o que fez com que a Astrobarreira entrasse no Modo de Emergência...";
    text[322] = "Senhorita Bella!";
    text[323] = "Precisamos acessar a escotilha que fica sob o Hovercraft";
    text[324] = "para consertar os estragos e iniciar um protocolo diferente.";
    text[325] = "Do jeito que as coisas estão, se não acessarmos aquela escotilha, ficaremos presos no Setor 16.";
    text[326] = "Hmm...";
    text[327] = "(AAAAAAAH, CÉUS! O QUE EU FAÇO?? NÃO SEI COMO CONSERTAR UM HOVERCRAFT!)";
    text[328] = "Não se preocupe, Mett. A Bella aqui é a filha do grande Doutor Thomas.";
    text[329] = "Uma jovem prodígio em combate E inteligência! Hahahaha!";
    text[330] = "(É... bom que tenho uma fiel escudeira ao meu lado para me ajudar!)";
    text[331] = "Tetra, não conseguimos nos comunicar remotamente com o computador que está nas Instalações da Barreira?";

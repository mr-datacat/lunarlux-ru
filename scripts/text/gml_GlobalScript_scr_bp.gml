    text[10111] = "Afinidade da Colônia";
    text[10101] = "Mudando Trajes a Jato";
    text[10107] = "Indicadores";
    text[10106] = "Missões";
    text[10108] = "Personalização de nave";
    text[10109] = "Nível e estat. do jogador";
    text[10104] = "Tipos de ataques inimigos";
    text[10103] = "Mecânica de Combos Lux";

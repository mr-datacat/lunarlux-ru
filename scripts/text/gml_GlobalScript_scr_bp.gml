    text[9807] = "Compre um Chip de T.U. para consertar seu Tradutor Universal quebrado!";
    text[9808] = "Encontre a preciosa Sabristola de Barry no Monte Piton!";
    text[9809] = "Sabristola de Barry";
    text[9810] = "Ajude Ouro a encontrar suas Receitas de Combo Lux!";
    text[9811] = "7 receitas perdidas";
    text[9812] = "Receita de Combo Lux";
    text[9813] = "Ajude Nora em sua missão para criar o melhor fluido de cura!";
    text[9814] = "Ajude Lily a documentar a vida botânica de Luna!";
    text[9815] = "Mostre a Ouro que você realizou pelo menos 20 Combos Lux em batalha!";
    text[9816] = "Mostre a Megumin que você tem, pelo menos, 10 Ranques S!";
    text[9817] = "Desconhecido";
    text[9818] = "Encontre todas as Barras de Cheesecake abandonadas e descubra a origem delas!";
    text[9819] = "Recompensa misteriosa";
    text[9820] = "Compre as pelúcias de Melody para ajudar na poupança dela para comprar uma pelúcia rara!";
    text[9821] = "Nova Habilidade Ativa";
    text[9822] = "Ajude LO-Ogi a encontrar seus patos perdidos e levá-los para casa!";
    text[9823] = "Pato perdido";
    text[9830] = "Mostre a Zara pelo menos 20 receitas diferentes de Combos Lux do seu banco de dados!";
    text[9831] = "Encontre algumas Engrenagens de Núcleo na Área de Armazenamento de Regolithia para melhorar a Explosão Tetra!";

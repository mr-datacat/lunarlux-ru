    text[333] = "Ah, maravilha...";
    text[334] = "Como podemos mover o hovercraft?";
    text[335] = "Empurre-o!";
    text[336] = "Destrua-o!";
    text[337] = "Consertar o motor?!";
    text[386] = "Tetra, escaneie o objeto!";
    text[387] = "Belezinha! Dê-me uns... 2 milissegundos...";
    text[338] = "Pronto!";
    text[339] = "Qual o peso do hovercraft?";
    text[340] = "100 toneladas!";
    text[341] = "Aff... deixa pra lá.";
    text[342] = "Achei que poderíamos empurrá-lo para acessar a escotilha inferior.";
    text[343] = "100 toneladas é pesado demais.";
    text[344] = "Precisaremos de exatamente 20 Tetras para empurrá-lo!";

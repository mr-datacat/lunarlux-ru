    text[10031] = "Use múltiplos cortes com a Sabristola para causar um grande dano!";
    text[10032] = "3 Cortes de Ecos derrubam o inimigo!";
    text[10033] = "Bônus: O valor de Turnos Consecutivos atingiu o máximo!";
    text[10034] = "Escudos +7 e Regeneração de Escudo por 3 turnos!";
    text[10035] = "Canhão de Fótons Final. Multiplicador máx. x25";
    text[10036] = "Eletrocorte com 100% de chance de ATORDOAR 1 inimigo!";
    text[10037] = "Holoespadas cortam o inimigo!";
    text[10038] = "Qualquer habilidade com base em espadas!";
    text[10039] = "Combo Lux padrão";
    text[10040] = "Bônus: 50% de chance de acerto crítico com DAN x1,5!";
    text[10041] = "Festa de lasers de drones";
    text[10042] = "Combo de Canhão de Fótons de alta voltagem e Mergulho ao Luar";
    text[10043] = "50% de chance de atordoar!";
    text[10044] = "4 meteoros gigantes atingem todos os inimigos!";
    text[10045] = "O dano aumenta com base na contagem de escudos atual!";
    text[10046] = "PDR baseado no PE restante!";
    text[10047] = "Atinge TODOS os inimigos!";
    text[10048] = "Bônus: ATORDOA todos os inimigos por 1 turno!";
    text[10049] = "Bônus: QUEIMA todos os inimigos por 2 turnos!";
    text[10050] = "Hidroexplosão com 100% de chance de ENCHARCAR 1 inimigo!";
    text[10051] = "Lance Manoplas de Lâminas Foguetes no inimigo!";
    text[10052] = "50% de chance de acerto crítico!";
    text[10053] = "Aumento de dano se o inimigo tem mais efeitos de status!";
    text[10054] = "A Holotecnologia convoca o Esquadrão Raine para atacar 1 inimigo!";
    text[10055] = "50% de chance de ATORDOAR, QUEIMAR e ENCHARCAR 1 inimigo!";
    text[10056] = "Causa dano igual a 25% do PV restante do inimigo! (máx. 1.000 de DAN)";
    text[10057] = "75% de chance de QUEIMAR e ENCHARCAR 1 inimigo!";
    text[10058] = "Aumento de dano com base no PV restante!";
    text[10059] = "Aumento de dano com base na contagem de escudos!";
    text[10060] = "Atinge todos os inimigos!";
    text[10061] = "Conecta o poder da luz lunar!";
    text[10062] = "Explosão dupla de Canhão de Fótons com Tetra! BÔNUS: +4 escudos!";
    text[10063] = "Ataque corporal de acerto múltiplo. 60% de chance de acerto crítico!";
    text[10064] = "Corte de sabre curativo!";
    text[10065] = "Revive um aliado morto!";
    text[10066] = "Bombas de Cheesecake causam dano a todos os inimigos! Cure 200 de PV e obtenha Regeneração de PV por 3 turnos!";
    text[10067] = "Evoque Guardia para atacar! 30% de aumento de Lux após o ataque!";
    text[10068] = "Liberte sua Lux!";
    text[10069] = "Bônus: 50% de chance de acerto crítico com DAN x3!";

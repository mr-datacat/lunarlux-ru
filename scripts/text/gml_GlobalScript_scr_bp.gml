    text[151] = "Tetra, hora da Escudeira!";
    text[152] = "Hora da Ultra Escudeira!";
    text[153] = "O Murk escapou!";
    text[154] = "(Inspira)... (Arfa)... Está tudo bem@P.@P.@P.";
    text[155] = "Não vamos nos preocupar com isso agora.";
    text[156] = "Não acho que ele vá voltar tão cedo.";

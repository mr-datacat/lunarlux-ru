    text[346] = "E se destruíssemos o hovercraft?";
    text[347] = "CABUM!";
    text[348] = "E-ei! Nã-não vamos nos precipitar. A na-nave é propriedade da empresa...";
    text[349] = "As vidas das pessoas valem mais do que um hovercraft quebrado.";
    text[350] = "Hmm...";
    text[351] = "Toda esta área está altamente volátil.";
    text[352] = "Neste momento, o oxigênio dentro da Astrobarreira está instável.";
    text[353] = "Lembre-se: fogo consome oxigênio. Precisamos evitar explosões ou incêndios.";
    text[354] = "Destruir a nave não é a solução.";
    text[355] = "Gra-graças aos céus! Ufa...";
    text[356] = "Você tem razão, senhorita Bella! Esqueci...";
    text[357] = "Há um jeito de consertar o motor?";
    text[358] = "Espere, acabei de lembrar de algo!";
    text[359] = "Meu hovercraft é um Transportador de Suprimentos Modelo N...";
    text[360] = "... o que significa que o sistema de propulsão de gravidade é acionado eletricamente.";

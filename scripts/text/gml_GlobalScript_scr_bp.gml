    text[384] = "Só ficaremos no seu caminho se tentarmos lutar contra eles ao seu lado.";
    text[385] = "Se eu precisar de reforços, os avisarei prontamente!";
    text[125] = "Basta!";
    text[126] = "Espere aí@P.@P.@P. Você é...";
    text[127] = "Você é o Murktador!";
    text[128] = "Não se mexa! Você está preso!";
    text[129] = "Devolva o Antinúcleo que você pegou!";
    text[130] = "Ignorância é uma bênção, não é mesmo?";
    text[131] = "Do que você está falando?";
    text[132] = "Consegue sentir?";
    text[133] = "Ele lamenta.";
    text[134] = "Ele sofre.";

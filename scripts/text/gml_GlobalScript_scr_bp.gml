    text[379] = "De-desculpa, eu@P.@P.@P. eu@P.@P.@P.";
    text[380] = "Mo-morro de medo desses mo-monstros...";
    text[381] = "Mett, fique aqui onde é seguro. Eu darei um jeito neles. Não se preocupe.";

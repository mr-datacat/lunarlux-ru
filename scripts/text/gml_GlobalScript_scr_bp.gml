    text[169] = "Eu matei tantos Murks.";
    text[170] = "Sinto muito...";
    text[171] = "Se eu tivesse que escolher entre poupá-los e salvar a humanidade...";
    text[172] = "Seria forçada a salvar a humanidade...";
    text[173] = "... é meu dever jurado proteger o povo de Luna.";

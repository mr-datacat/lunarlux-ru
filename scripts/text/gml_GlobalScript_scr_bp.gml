    text[187] = "Hehe. É...";
    text[188] = "Aconteceu durante nossa luta contra os três Geolignos.";
    text[189] = "Por que não disse nada?";
    text[190] = "Tetra ficou preocupada...";
    text[191] = "Desculpa...";
    text[192] = "Precisávamos investigar a situação do hovercraft e...";
    text[193] = "Achei que iria aguentar.";
    text[194] = "Tetra é uma escudeira ruim? ...";
    text[195] = "Não, não! Foi culpa minha, Tetra.";
    text[196] = "Eu deveria ter, ao menos, parado para limpar minha ferida.";
    text[197] = "Você é a melhor Escudeira Enfermeira de todas!";
    text[198] = "Ok... Não me assuste assim da próxima vez.";
    text[199] = "Se o Doutor Thomas estivesse aqui, ele diria: 'Essa é a minha Bella!'";
    text[200] = "'Inconsequente como sempre.'";
    text[201] = "'Mas o poder de seu coração e de sua alma não tem igual.'";
    text[202] = "'Isso que a torna uma verdadeira heroína do povo de Luna.'";
    text[203] = "Meu pai é tão meloso... (hehehe)";
    text[204] = "Espere aí. Quanto tempo fiquei apagada?";
    text[205] = "Exatos 48 minutos e 37 segundos.";
    text[206] = "E os níveis de oxigênio?";
    text[207] = "79%!";
    text[208] = "Aff. Não vamos perder mais tempo.";
    text[209] = "Temos uma missão a cumprir!";
    text[210] = "Belezinha!";
    text[211] = "Estou bem melhor agora. Obrigada por cuidar de mim, Tetra.";
    text[212] = "Hihi.";
    text[213] = "MISSÃO: DÊ PARTIDA NO MOTOR DO HOVERCRAFT E CONSERTE A ASTROBARREIRA!";
    text[214] = "PRIMEIRO ENCONTRE ALGUÉM QUE POSSA AJUDÁ-LA A OBTER PAINÉIS LUNARES!";
    text[415] = "Ahh, Bella! Que bom revê-la.";
    text[416] = "Ah! Oi, senhorita Nyla! O que a traz aqui?";
    text[417] = "Fui chamada aqui para realizar inspeções dos Painéis Lunares e trabalho de campo.";
    text[418] = "Recentemente, seu pai e eu desenvolvemos um novo modelo de Painel Lunar e";
    text[419] = "ele precisa ser testado para averiguar sua eficiência.";
    text[420] = "Estamos esperando mais alguns painéis@P.@P.@P.";
    text[421] = "Porém, o Hovercraft de transporte parece estar atrasado@P.@P.@P.";
    text[422] = "De qualquer forma, é bom estar trabalhando fora da Estação Espacial para variar.";
    text[423] = "Vivemos em tempos onde a tecnologia realmente se destaca";
    text[424] = "e, mesmo assim, há ainda muito a se descobrir.";
    text[425] = "Se você precisar de qualquer coisa, meu bem, só me falar.";
    text[426] = "Certo. Obrigada, senhorita Nyla!";
    text[427] = "Ah, Bella! Como vai, querida?";
    text[428] = "Senhorita Nyla, precisamos da sua ajuda!";
    text[429] = "Você é especialista em Painéis Lunares, certo?!";
    text[430] = "Sim, querida.";
    text[431] = "Então, a situação é a seguinte...";
    text[432] = "Entendi. Bom, você veio até a pessoa certa!";
    text[433] = "Então é possível usar os Painéis Lunares para dar partida no hovercraft?";
    text[434] = "Hmm...";
    text[435] = "Definitivamente possível, sim.";
    text[436] = "Precisamos do seguinte: 10 Painéis Lunares e 1 Gerador Termoelétrico!";
    text[437] = "Isso... é bem específico. Onde será que conseguiremos um gerador?";
    text[438] = "Minha querida, aqui é Regolithia!";
    text[439] = "Estamos nas fronteiras de Tycho, a capital científica de Luna.";
    text[440] = "Este setor é um destino popular para Comerciantes de Astrotecas.";
    text[441] = "Frequentemente, vendem diversos itens e tecnologias que você não encontrará em outro lugar!";
    text[442] = "Tente encontrar um Comerciante de Astrotecas nas Instalações da Barreira!";
    text[443] = "Quanto aos Painéis Lunares, acredito que tenhamos de sobra na Unidade de Armazenamento.";
    text[444] = "A Unidade de Armazenamento fica ao Sul daqui.";
    text[445] = "Tome...";
    text[446] = "Você tem curiosidade sobre como os Painéis Lunares funcionam?";
    text[447] = "Quem sabe na próxima.";
    text[448] = "Esplêndido! Fico feliz que queira saber mais!";
    text[449] = "Painéis Lunares solucionam o problema que Painéis Solares têm";
    text[450] = "sofrido por séculos.";
    text[451] = "Eles podem gerar eletricidade tanto com a luz do Sol quanto na escuridão!";
    text[452] = "Uau! Então eles absorvem a escuridão?";
    text[453] = "Não exatamente, querida.";
    text[454] = "Painéis Lunares podem gerar eletricidade devido";
    text[455] = "à diferença da temperatura ambiente durante nossas noites lunares frias.";
    text[456] = "Noites lunares e dias lunares duram aproximadamente 14 dias cada.";
    text[457] = "Isso significa que, por 14 dias, ficamos diante de nosso brilhante sol azul.";
    text[458] = "Há algumas décadas, isso era um grande problema.";
    text[459] = "Nossos Painéis Solares eram inúteis durante noites lunares.";
    text[460] = "Contudo...";
    text[461] = "Graças ao esforço das mentes brilhantes dos Laboratórios Lunex,";
    text[462] = "incluindo seu pai, é claro, conseguimos inventar o Painel Lunar!";
    text[463] = "Através de um processo conhecido como resfriamento radiativo,";
    text[464] = "conectamos a diferença de temperatura entre Luna e o espaço sideral.";
    text[465] = "Resfriamento radiativo + liga de alumínio + Gerador termoelétrico...";
    text[466] = "Nossa fórmula para a criação do Painel Lunar estava completa.";
    text[467] = "Ciência é legal demais!";
    text[468] = "Sou grata pela tecnologia que auxiliou a humanidade a sobreviver em Luna.";
    text[469] = "Quantos Painéis Lunares você encontrou até agora?";
    text[470] = "8!";
    text[471] = "Falta pouco!";
    text[472] = "Todos os Painéis podem ser encontrados na Unidade de Armazenamento.";
    text[473] = "Lembro que havia alguns corredores escondidos lá...";
    text[474] = "Lembre-se de examinar toda a área!";
    text[475] = "Quantos Painéis Lunares você encontrou até agora?";
    text[476] = "9!";
    text[477] = "Bom, quase lá, né?";
    text[478] = "Mas precisamos de 10, querida.";
    text[479] = "Tem certeza de que não dá com 9?";
    text[480] = "Absoluta.";
    text[481] = "100%?";
    text[482] = "1 bilhão porcento!";
    text[483] = "Não é 10 bilhões porcento... Então significa que você não tem certeza.";
    text[484] = "Vou revisar meus cálculos de novo, só por precaução.";
    text[485] = "Ainda precisamos de 10.";
    text[486] = "Certo, certo. Vou procurar o último que falta.";
    text[487] = "Consegui todos!";
    text[488] = "Incrível! Bom trabalho!";
    text[489] = "Desenhei um esquema enquanto você estava fora.";
    text[490] = "Conectar os Painéis Lunares ao Núcleo do Motor deve ser fácil!";
    text[491] = "Após alguns cálculos...";
    text[492] = "Realmente, 9 Painéis Lunares devem ser o suficiente.";
    text[493] = "Você pode manter o que sobrou como brinde!";
    text[494] = "Nunca se sabe, talvez venha a ser útil um dia.";
    text[495] = ".@P.@P.@P.@P.";
    text[496] = "Por Luna! O ar está começando a parecer cada vez mais rarefeito!";
    text[497] = "Não há tempo para perder, querida.";
    text[498] = "Encontrarei contigo no hovercraft assim que pegar todas as minhas ferramentas!";
    text[500] = "AGORA VOCÊ PODE ACESSAR A UNIDADE DE ARMAZENAMENTO 3.";
    text[501] = "Bella, armazenei as informações da senhorita Nyla no meu banco de dados.";
    text[502] = "Fale comigo caso esqueça de algo!";
    text[503] = "Tenho 100% de certeza de que funcionará.";
    text[504] = "Não@P.@P.@P. Pode apagar.";
    text[505] = "Tenho 10 bilhões porcento de certeza!";
    text[506] = "Muito obrigada pela ajuda, senhorita Nyla!";
    text[507] = "É claro, meu bem.";
    text[508] = "Venha me ver quando tiver juntado os Painéis e o Gerador.";
    text[509] = "Se quiser, posso até ensiná-la uma coisa ou outra sobre como os Painéis funcionam!";
    text[510] = "Bom... hehe... Tecnologia não é bem meu forte, então deixarei essa parte para você.";
    text[511] = "Tudo bem, querida. Eu a esperarei aqui.";
    text[696] = "Consegui todos os Painéis Lunares!";
    text[697] = "Você também conseguiu o Gerador com o Comerciante de Astrotecas?";
    text[698] = "Ah, não... Ainda não temos o Gerador!";
    text[699] = "Tudo bem, querida. De qualquer forma, ainda não terminei meus cálculos.";
    text[700] = "Assim que tiver o Gerador, teremos tudo de que precisamos.";
    text[518] = "Hmm... Parece que esta porta tem uma trava eletrônica.";
    text[519] = "Deve haver um painel de controle por aqui em algum lugar...";
    text[520] = "Se encontrarmos o painel de controle, poderei acessar a rede! Hihi.";
    text[521] = "A porta da Unidade de Armazenamento está trancada.";
    text[522] = "Precisamos de um cartão de acesso para desbloquear a porta.";
    text[523] = "Há um interruptor aqui! Quer acioná-lo?";
    text[524] = "O interruptor já foi acionado.";
    text[525] = "Este painel de controle parece estar ligado, mas não responde...";
    text[526] = "Bella, acho que há um erro no software.";
    text[527] = "Posso navegar digitalmente na rede e reinicializar o software!";
    text[528] = "Tetra deve navegar na rede do painel de controle?";
    text[529] = "A rede já foi restaurada.";
    text[1339] = "Não fui capaz de reinicializar a rede...";
    text[1340] = "Tudo bem, Tetra. Você pode tentar outra vez.";
    text[1341] = "Acredito em você!";
    text[249] = "Bella, isso parece ser um beco sem saída...";
    text[250] = "... e as Setas não permitem que voltemos.";
    text[251] = "Estamos presas??";
    text[252] = "Hmm... Não, aposto que há um jeito de voltar.";
    text[253] = "Só precisamos encontrá-lo.";
    text[254] = "Ei, um caminho escondido!";
    text[255] = "Viu, Tetra! Disse que havia um jeito de voltar. Hehe.";
    text[256] = "Hihi.";
    text[257] = "Bella, há um OTIMIZADOR DE HABILIDADE atrás da parede de vidro!";
    text[258] = "Você tem razão! OTIMIZADORES DE HABILIDADE são bem raros!";
    text[259] = "Como vamos passar? Há algum outra entrada?";
    text[260] = "Hora de um ZOOM ÓPTICO! ...";
    text[261] = "25%... 50%...";
    text[262] = "75%...";
    text[263] = "Hmm...";
    text[264] = "AH!";
    text[265] = "Consigo ver uma etiqueta bem pequena no interruptor do elevador de cápsula.";
    text[266] = "E o que diz?";
    text[267] = "Instalações da Barreira - Compartimento de carga";
    text[268] = "Bom trabalho, Tetra!";
    text[269] = "A entrada dos fundos fica nas Instalações da Barreira!";
    text[701] = "Espere, Bella! Tive uma ideia!";
    text[702] = "Se você ativar seu Traje a Jato, poderá se deslocar bem mais rápido.";
    text[703] = "Economizaremos muito tempo! Hehe.";
    text[704] = "Ah! Você tem razão! Céus, por que não pensei nisso antes?";
    text[705] = "Há uma Jatoplataforma aqui perto! Vamos conferi-la!";
    text[706] = "JATOPLATAFORMAS PERMITEM QUE USUÁRIOS AUTORIZADOS VOEM POR LUNA COM TRAJES A JATO!";
    text[707] = "A LEI LUNAR PROIBE USUÁRIOS NÃO LICENCIADOS DE ATIVAREM SEUS TRAJES A JATO";
    text[708] = "SEM UMA JATOPLATAFORMA.";
    text[709] = "USE SEU TRAJE A JATO PARA EXPANDIR SEU MUNDO!";
    text[710] = "MAS... HM...";
    text[711] = "PARECE QUE SEU CHIP DE VOO FOI DANIFICADO.";
    text[712] = "ACESSO NEGADO.";
    text[713] = "Droga. Meu Chip de Voo provavelmente foi danificado nas batalhas contra os Murks...";
    text[714] = "Preciso consertá-lo ou encontrar um novo.";
    text[715] = "Bella, vamos procurar comerciantes nas Instalações da Barreira.";
    text[716] = "Aposto que um Comerciante de Astrotecas terá Chips de Voo!";
    text[717] = "Certo. Acho que iremos a pé por enquanto.";
    text[1361] = "Nyla parece estar ocupada com a instalação.";
    text[1362] = "Vamos ver como o Mett está primeiro.";
    text[961] = "Ah... Espero que isso funcione...";
    text[962] = "Vai funcionar, não se preocupe. O poder da ciência é incrível!";
    text[963] = "Certo, pessoal.";
    text[964] = "Tudo deve estar montado e pronto para funcionar.";
    text[965] = "Mett, querido, prepare-se para pilotar o hovercraft!";
    text[966] = "Recarregando o núcleo do motor em...";
    text[967] = "3...";
    text[968] = "2...";
    text[969] = "1!";
    text[970] = "Certo! Consigo ver a escotilha. Hora de fazer os reparos!";
    text[971] = "30 minutos depois...";
    text[972] = "Parece que, agora, tudo está sob controle. Que alívio!";
    text[973] = "Chamei alguns engenheiros para me ajudar a quantificar o estrago.";
    text[974] = "Muito obrigada, senhorita Nyla!";
    text[975] = "Seus esforços foram sensacionais, meu bem.";
    text[976] = "Afinal de contas, usar Painéis Lunares foi ideia sua.";
    text[977] = "Você também se saiu bem, Tetra!";
    text[978] = "Ultra-giga-escudeira Tetra! Hihihi.";
    text[979] = "Mu-muito obrigado! Eu provavelmente perderia meu emprego se não fosse pela sua ajuda.";
    text[980] = "Isso...";
    text[981] = "Isso não teria acontecido se não fosse pelos Murks...";
    text[982] = "É@P.@P.@P.";
    text[983] = "Hora de partir. A exaustão me pegou.";
    text[984] = "Muito obrigada por toda a ajuda, pessoal!";
    text[985] = "Vamos, Tetra.";
    text[1365] = "...";
    text[986] = "Tetra, alguma coisa não me cheira bem.";
    text[987] = "Isso não sai da minha cabeça faz um tempo já.";
    text[988] = "Nunca encontramos o Murk que atacou o Mett...";
    text[989] = "Não só isso, mas tenho a estranha sensação de que estamos sendo observadas...";
    text[990] = "Tetra? @P.@P.@P.";
    text[991] = "CADÊ A TETRA??";
    text[992] = "TETRAAAAAA!!!";
    text[993] = "... Onde estou?";
    text[994] = "Isso é um sonho?";
    text[995] = "Não. Parece real demais.";
    text[996] = "Isso deve ser... ";
    text[997] = "O mundo entre os buracos de minhoca.";
    text[998] = "... O Reino Fantasma.";
    text[999] = "Por que o Murk me traria aqui? ...";
    text[1000] = "TETRA!";
    text[1001] = "Meu localizador diz que ela está por perto! ...";
    text[1002] = "Preciso encontrá-la e dar o fora daqui!";
    text[1366] = "OBJETIVO: ENCONTRE TETRA E ESCAPE DO REINO FANTASMA.";
    text[1003] = "Tetra! Graças às estrelas que você está bem!!";
    text[1004] = "Bella! Tetra está super hiper mega feliz em vê-la!!";
    text[1005] = "Detectei o Murk que atacou o hovercraft do Mett e, de repente,";
    text[1006] = "Tetra caiu em um buraco de minhoca e foi transportada para este lugar assustador...";
    text[1007] = "Esse é... o Reino Fantasma? ...";
    text[1008] = "Não tenho certeza, mas seria meu chute.";
    text[1373] = "Se os diretores descobrirem isso, vamos ter problemas...";
    text[1378] = "Teremos ainda mais problemas se não descobrirmos como sair daqui!";
    text[1374] = "Eu sei. Não é como se tivéssemos escolhido vir para cá...";
    text[1375] = "Isso não sai da minha cabeça... Por que o Murk nos trouxe aqui?";
    text[1376] = "Quem sabe ele queira nos matar e nos dar de janta para seus amigos...";
    text[1377] = "Robôs não são muito apetitosos, então fico mais preocupada por você, Bella.";
    text[1372] = "Aqui não é seguro para nós.";
    text[1379] = "Não se preocupe, Tetra.";
    text[1009] = "Lembra que minha mãe ia de tempos em tempos nas expedições para o Reino Fantasma com seu esquadrão?";
    text[1010] = "Ela nunca contou muito a respeito daqui, mas, definitivamente, há um jeito de sair.";
    text[1011] = "Tetra, quais são nossas coordenadas?";
    text[1012] = "Coordenadas DESCONHECIDAS...";
    text[1013] = "É, definitivamente, não estamos mais em Luna...";
    text[1014] = "Droga...";
    text[1015] = "São tantas perguntas...";
    text[1016] = "Mas não temos tempo para sentar e ficar de bobeira.";
    text[1017] = "Este lugar é extremamente perigoso...";
    text[1018] = "Vamos encontrar um jeito de sair daqui.";
    text[1019] = "Conte comigo!";
    text[1020] = "Escudeira da Expedição Fantasma Tetra está pronta!";
    text[1381] = "(De novo... O que é essa sensação?)";
    text[1382] = "(Parece que alguém está me chamando de longe.)";
    text[1383] = "(Uma voz?)";
    text[1384] = "(...)";
    text[1385] = "Bella, estamos em território inimigo agora. Detecto diversos Murks na área.";
    text[1386] = "Isso está vindo daquelas fendas roxas.";
    text[1387] = "Certo, temos que ter cuidado.";
    text[1388] = "...";
    text[1389] = "Sou só eu ou esta área parece estranhamente familiar?";
    text[1390] = "Como assim?";
    text[1391] = "... Parece que estamos em Regolithia.";
    text[1392] = "Nossa! Mas isso é impossível!";
    text[1393] = "Se meu palpite estiver certo, o monólito deve estar por aqui em algum lugar.";
    text[1394] = "Vamos continuar.";
    text[1395] = "Ali! Há um monólito aqui também! ";
    text[1396] = "Mas... como?";
    text[1397] = "...";
    text[1398] = "AHHH! ISSO FOI RÁPIDO!";
    text[1402] = "Esse é o Murk que nos trouxe aqui!";
    text[1403] = "(...)";
    text[1404] = "(Aquele Murk parecia estar chorando de dor...)";
    text[1405] = "(Meu instinto me manda fugir, mas meu coração...)";
    text[1406] = "(... minha alma...)";
    text[1407] = "(... dizem algo diferente.)";
    text[1399] = "Tetra... Precisamos ficar atentas e continuar nos movendo.";
    text[1400] = "Acho que tenho um plano para voltarmos para Luna.";
    text[1401] = "Vamos rápido!";
    text[1408] = "Então finalmente nos encontramos.";
    text[1409] = "Este Murk parece bem forte.";
    text[1410] = "Bella, não tenho esse Murk no banco de dados!";
    text[1411] = "Essa é uma nova variante! CODINOME ATRIBUÍDO: CRONOS!";
    text[1420] = "Seu poder é maior do que qualquer Murk que já encontramos!";
    text[1421] = "Droga...";
    text[1422] = "Em vez de combatê-lo, por que não tentamos conversar com ele?";
    text[1423] = "Ahn?!";
    text[1424] = "Murk! Por que nos trouxe aqui?";
    text[1425] = "Você entende o que estou falando?";
    text[1426] = "Por favor, diga algo...";
    text[1427] = "Bella, não adianta.";
    text[1428] = "Não dá para se comunicar com ele...";
    text[1429] = "Eu sei, mas...";
    text[1461] = "Espere, o que aquele Murk está fazendo? Ele está olhando fixamente para nós...";
    text[1462] = "Estou ficando nervosa.";
    text[1463] = "Ele está nos observando. Quem sabe esteja esperando para ver o que faremos.";
    text[1464] = "Deve haver algum motivo para ele nos ter trazido aqui...";
    text[1465] = "Não sei qual o motivo, mas...";
    text[1466] = "Quem sabe esteja nos testando...";
    text[1467] = "Bella, não faz sentido.";
    text[1468] = "Acho que está esperando a gente fugir para poder nos atacar e NOS DEVORAR!";
    text[1469] = "Hm. Acho que não. Ele já teria feito isso.";
    text[1470] = "Este Murk é@P.@P.@P. diferente.";
    text[1438] = "Bella, o Murk parece impaciente!";
    text[1439] = "Ele pode nos atacar a qualquer momento!";
    text[1440] = "Mesmo se esse Murk for forte, ainda não é páreo para nós duas.";
    text[1441] = "Certo, Tetra. O plano é simples. Vamos cansá-lo lutando com ele.";
    text[1442] = "Em algum momento, ele pode tentar fugir pelo buraco de minhoca.";
    text[1443] = "E aí que escaparemos!";
    text[1444] = "E se o buraco de minhoca não nos levar de volta para casa?";
    text[1445] = "Então teremos que encontrar um que nos leve. Guerreiros Lunex nunca desistem. Certo, Tetra?";
    text[1446] = "Certo! Não paramos até conseguirmos! Muahahaha!";
    text[1447] = "Se esse Murk voltar para Luna, teremos mais problemas em nossas mãos.";
    text[1448] = "Pelo menos, podemos lutar contra ele aqui sem nos preocuparmos com alguém se machucar.";
    text[1449] = "Está pronta, Tetra?";
    text[1450] = "Destruidora de Murks Tetra está pronta!";
    text[1451] = "É isso...";
    text[1452] = "Vou ter que ir com tudo!";
    text[1453] = "Escute aqui, Murk!";
    text[1454] = "Não permitirei que ameace meu povo.";
    text[1455] = "Não deixarei que destrua Luna!";
    text[1456] = "Não sei por que nos trouxe aqui, mas uma coisa é certa...";
    text[1457] = "Não cairemos sem lutar!";
    text[1458] = "Nunca subestime uma Guerreira Lunex!";
    text[1459] = "Parece que ele finalmente se acalmou.";
    text[1460] = "...?";
    text[1473] = "(Está acontecendo de novo...)";
    text[1474] = "@P. @P. P@P. @P. r@P. @P.";
    text[1475] = "@P. P@P. r@P. @P. o@P. @P. t@P. e@P. @P. ja@P.";
    text[1476] = "(Proteja? ...)";
    text[1477] = "(Essa voz...)";
    text[1478] = "(É a mesma voz de antes!)";
    text[1479] = "(Você consegue... me entender?)";
    text[1480] = "Bella, veja! Mais Murks!";
    text[1481] = "Droga, estamos cercadas!";
    text[1482] = "Nossa batalha deve ter atraído a atenção deles.";
    text[1483] = "Estou detectando um acúmulo gigante de energia!";
    text[1484] = "...!";
    text[1485] = "Sobrecarga do holoescudo!";
    text[1486] = "Bella, você está bem??";
    text[1487] = "Estou... bem...";
    text[1488] = "Usei todos meus holoescudos...";
    text[1489] = "(Arfa)... (Arfa)...";
    text[1490] = "Aaaaah... Tão perto...";
    text[1491] = "Eu@P.@P.@P. não consigo mover um músculo sequer...";
    text[1492] = "Para trás! Como ousam machucar a Bella?!";
    text[1493] = "Tetra... não os provoque. ";
    text[1494] = "Fique ao meu lado.";
    text[1495] = "(Arfa)... (Arfa)...";
    text[1496] = "Não podemos desistir... não importa o motivo!";
    text[1497] = "AAAAAHHHHHHHHHHHHHHHHH!!";
    text[1498] = "Voltamos para Luna!";
    text[1499] = "Isso foi ASSUSTADOR...";
    text[1500] = "Achei que íamos MORRER...";
    text[1501] = "É, foi por um fio...";
    text[1502] = "Bella, olhe ali! Um antinúcleo vermelho!";
    text[1503] = "É o antinúcleo de Cronos...";
    text[1504] = "Cronos se sacrificou para nos salvar...";
    text[1505] = "É...";
    text[1506] = "Interpretamos mal as intenções dele.";
    text[1507] = "Acho que ele queria a nossa ajuda.";
    text[1508] = "Como sabe?";
    text[1509] = "É difícil explicar.";
    text[1510] = "Eu conseguia sentir a dor dele.";
    text[1511] = "Senti em minha alma.";
    text[1512] = "Talvez esteja ligado às sensações estranhas que tenho sentido ultimamente...";
    text[1513] = "Bellaaaa, você precisa me contar essas coisas em vez de guardar só para si mesma!";
    text[1514] = "É, eu sei... Eu sei...";
    text[1515] = "Quem sabe quais são os efeitos do Reino Fantasma no seu corpo...";
    text[1516] = "Havia antimatéria em TODOS OS LUGARES!";
    text[1517] = "Precisamos que o Doutor Thomas a examine! Tetra está começando a ficar preocupada...";
    text[1518] = "Nããããoo!";
    text[1519] = "Ahn?! Por que não?";
    text[1520] = "Mesmo não tendo sido escolha nossa, violamos o protocolo ao ir ao Reino Fantasma.";
    text[1521] = "Não quero me meter em encrenca...";
    text[1522] = "Vou me recuperar na Câmara de Cura na estação!";
    text[1523] = "Tetra, precisamos manter isso em segredo.";
    text[1524] = "Prometa, por favor!";
    text[1525] = "...";
    text[1526] = "Ok. Eu prometo.";
    text[1527] = "... mas se houver alguma atividade estranha nos seus dados vitais, contaremos para o Doutor Thomas.";
    text[1528] = "Certo.";
    text[1529] = "Sei que deveríamos transferir os Antinúcleos para o QG, mas...";
    text[1530] = "Acho que vou manter os Antinúcleos que obtivermos de agora em diante.";
    text[1531] = "Ok! Agora temos 2 Antinúcleos conosco. Hihi.";
    text[1532] = "Cronos...";
    text[1533] = "Obrigada...";
    text[1534] = "Agradeço por nos proteger, Cronos!";
    text[1535] = "@P.@P.@P.@P.@P.@P.";
    text[1536] = "'Proteja'@P.@P.@P.";
    text[1537] = "Falando nisso, você ouviu Cronos falar?";
    text[1538] = "O-o quê?? Ele falou? Eu não ouvi nada.";
    text[1539] = "Hmm... Deve ter sido comunicação telepática.";
    text[1540] = "Será que todos os Murks têm essa capacidade?";
    text[1541] = "Estranho...";
    text[1542] = "A voz de Cronos não soava como qualquer das vozes que já ouvi...";
    text[1543] = "Ainda assim, parecia estranhamente familiar.";
    text[1544] = "...";
    text[1545] = "Se algum dia eu aprender como me comunicar com os Murks...";
    text[1546] = "Quem sabe eu possa encontrar a paz que tanto buscamos.";
    text[1547] = "Parece que aprendemos informações valiosas hoje sobre os Murks! Hihi.";
    text[1548] = "Mas ainda há muita coisa que não sabemos.";
    text[1549] = "Essa jornada... está só começando.";
    text[1550] = "(Mãe, por favor, olhe por nós.)";
    text[1551] = "(Darei o meu melhor para proteger o povo de Luna.)";
    text[1552] = "Vamos, Tetra. Precisamos descansar.";
    text[1553] = "Vamos, finalmente, para casa.";
    text[1554] = "Belezinha! Nossa nave ainda deve estar atracada no Hoverporto Sudeste!";
    text[1555] = "Então, vamos que vamos!";
    text[1579] = "OBJETIVO: USE SUA NAVE NO HOVERPORTO SUDESTE E VÁ PARA";
    text[1580] = "A ESTAÇÃO ESPACIAL LUNEX!";
    text[1583] = "Aquele é o Cronos??";
    text[1584] = "Não, aquilo é um fantasma.";
    text[1585] = "Chefes Murks liberam tanta antimatéria que, mesmo após serem derrotados,";
    text[1586] = "o excesso de antimatéria pode permanecer na forma de um fantasma.";
    text[1593] = "Essencialmente, é um aglomerado violento de energia que assume a forma de um Chefe Murk.";
    text[1587] = "Antes de os fantasmas despertarem, eles acumulam toneladas de antimatéria do seus arredores,";
    text[1588] = "o que os torna ainda mais fortes do que sua contraparte original.";
    text[1589] = "Uau, Tetra, onde você aprendeu tudo isso??";
    text[1590] = "Faz parte dos arquivos restritos do Doutor Thomas.";
    text[1591] = "Eu posso, ou não, ter baixado secretamente alguns dos arquivos... Hihi.";
    text[1592] = "De qualquer forma, temos um Fantasma para lidar agora!";
    text[1594] = "Escudeira Destruidora de Fantasmas Tetra pronta para a batalha!";
    text[1706] = "Bom dia, Doutor Thomas!";
    text[1712] = "Mié Hehe. Seu relatório semanal está pronto.";
    text[1713] = "...";
    text[1714] = "Doutor Thomas?";
    text[1715] = "Linda, não é mesmo?";
    text[1716] = "Luna é sempre uma vista a ser contemplada.";
    text[1717] = "Hmmm sim, de fato! Bela vista a ser contemplada. Mié Hehe.";
    text[1718] = "A humanidade avançou tanto...";
    text[1719] = "e, mesmo assim, há ainda muito a se aprender e descobrir.";
    text[1720] = "O potencial ilimitado que temos...";
    text[1721] = "é ASTRONÔMICO!";
    text[1722] = "Hmmm sim. Realmente astronômico!";
    text[1723] = "Reeves, por favor, um resumo.";
    text[1724] = "Ocorreram 7 incidentes com Murks esta semana. Felizmente, nenhuma morte...";
    text[1725] = "Além disso, o rancho Kepler teve uma redução na produção de alimentos.";
    text[1726] = "Esses Murks imprevisíveis estão destruindo a nossa infraestrutura...";
    text[1727] = "A recuperação dos setores agrícola e alimentício afetados pode demandar um período prolongado.";
    text[1728] = "Nesse ritmo, talvez não duremos nem décadas... Mié.";
    text[1729] = "Jamais devemos nos dar por vencidos, Reeves. O povo depositou a confiança deles em nós.";
    text[1730] = "A ciência nos trouxe até aqui.";
    text[1731] = "Continuaremos pesquisando os Murks e inovando nossas tecnologias!";
    text[1732] = "É nosso dever garantir que as futuras gerações possam viver prósperas!";
    text[1733] = "ALERTA VERMELHO - CORPO ASTRAL NÃO IDENTIFICADO DETECTADO!";
    text[1735] = "Nyla, qual é a situação?";
    text[1736] = "Nossos sensores captaram um cometa gigante!";
    text[1737] = "Deixe-me confirmar as coordenadas aproximadas@P.@P.@P.@P";
    text[1738] = "O tempo estimado de colisão é de 377 dias...";
    text[1739] = "Está em um curso de colisão direto com Luna!";
    text[1740] = "Impossível! Algo perto assim deveria ter sido detectado antes!";
    text[1741] = "Nossos sensores deveriam estar funcionando corretamente...";
    text[1742] = ".@P.@P.@P.@P.@P.@P. A menos que...";
    text[1743] = "Reeves, o que a análise molecular diz?";
    text[1744] = "...!";
    text[1745] = "Doutor, estamos detectando níveis gigantescos de emissões de pósitrons...";
    text[1746] = "Pósitrons?? Não pode ser...";
    text[1747] = "Ele é feito de antimatéria!";
    text[1748] = "APOCALIPSE!";
    text[1749] = "Nossas previsões estimaram mais um milênio antes do seu retorno...";
    text[1750] = "Quão grande ele é?";
    text[1751] = "Mié hehe. Doutor, tem em torno de 2 mil km de diâmetro.";
    text[1752] = "Astronômico... Esse cometa tem metade do tamanho de Luna!";
    text[1753] = "Parece que ele completou sua órbita irregular muito antes do esperado.";
    text[1754] = "Thomas, será que...";
    text[1755] = "Sim, temo que seja.";
    text[1756] = "Esse... é o cometa que passou pela Terra mil anos atrás";
    text[1757] = "e quase conseguiu dizimar a raça humana.";
    text[1758] = "O Cometa Coda voltou.";
    text[1759] = "... e temos apenas um ano para descobrir como evitar essa catástrofe...";
    text[1760] = "Tenho um plano.";
    text[1761] = "Reeves.";
    text[1762] = "Nyla.";
    text[1763] = "Reunião de emergência no meu laboratório.";
    text[1764] = "Envie um relatório ao General Saros e envie uma solicitação de comparecimento.";
    text[1765] = "E...";
    text[1766] = "Diga a Bella para vir também.";
    text[1767] = "(Faz algumas horas desde a violação do Setor 16... espero que ela esteja bem.)";
    text[1768] = "Todos os outros, por favor, juntem todos os dados que conseguirem e monitorem o Cometa Coda!";
    text[1769] = "Sim, Doutor Thomas!";
    text[1770] = "(Preciso me manter calmo e manter o moral de todos elevado.)";
    text[1771] = "(Fim da humanidade...)";
    text[1772] = "(Não posso aceitar isso.)";
    text[1773] = "(O futuro do povo de Luna está em nossas mãos!)";
    text[1774] = "Lar, doce lar!";
    text[1775] = "Sim!";
    text[1776] = "Anh?! A senhorita Nyla está ligando!";
    text[1557] = "Bella, querida, já faz algumas horas... Está tudo bem?";
    text[1558] = "Você parecia um pouco agitada após consertarmos o hovercraft.";
    text[1559] = "Ah, sim, tudo em ordem, senhorita Nyla.";
    text[1560] = "Eu estava só@P.@P.@P.@P cansada da missão.";
    text[1561] = "Entendi. Bom, de qualquer forma, fico feliz que esteja bem.";
    text[1562] = "Surgiu uma situação urgente...";
    text[1563] = "Você precisa se reportar ao Laboratório de Pesquisas no Piso 3.";
    text[1564] = "Seu pai está em uma reunião de emergência e solicita seu comparecimento.";
    text[1565] = "Venha o mais rápido que puder, querida.";
    text[1566] = "Entendido!";
    text[1707] = "Uma emergência?? Bella, precisamos nos apressar!";
    text[1567] = "Quer apostar quanto que é uma situação com um Murk?";
    text[1568] = "2 barras de cheesecake!";
    text[1569] = "Tetra, você nem consegue comer barras de cheesecake...";
    text[1710] = "Hihi.";
    text[1711] = "OBJETIVO: VÁ PARA O LABORATÓRIO DE PESQUISAS NO PISO 3 - CORREDOR OESTE.";
    text[2223] = "Olá a todos!";
    text[2224] = "AH! Bella! Tetra!";
    text[2225] = "Bem-vindas de volta. Estou muito feliz em vê-las!";
    text[2226] = "Quando fiquei sabendo da violação da Astrobarreira do Setor 16, fiquei super preocupado...";
    text[2227] = "Vocês estão bem? Parecem exaustas...";
    text[2228] = "Estamos bem. Só um pouco doloridas das lutas contra os Murks. Haha.";
    text[2229] = "Na verdade, por falar em exaustão... Vocês parecem que não dormem há dias.";
    text[2230] = "Mesmo? Nesse caso, sei exatamente do que preciso...";
    text[2231] = "NÃÃÃÃOOOOOO!!";
    text[2232] = "VAZIO!";
    text[2233] = "Acabou nosso ELIXIR DIVINO!";
    text[2234] = "Elixir divino?";
    text[2235] = "Semana passada era 'SUCO PARA ALMA'.";
    text[2236] = "Ah... claro. Café, hmmmcerto!";
    text[2237] = "Ah Nyla, somente os grandes sommeliers da cafeína conhecem a verdadeira denominação para o café:";
    text[2238] = "ELIXIR DIVINO!";
    text[2239] = "Tudo bem. Eu trouxe minha minicafeteira comigo!";
    text[2324] = "É a versão portátil da Máquina de Café Ultimate que eu inventei. Hehe.";
    text[2240] = "Bella, o que vai querer?";
    text[2241] = "Um vanilla latte gelado, por favor!";
    text[2242] = "Tetra também!";
    text[2243] = "Tetra, você não pode tomar café.";
    text[2244] = "Ah, é...";
    text[2245] = "Beleza! Aqui, bem do jeito que você gosta.";
    text[2246] = "Reeves? Um duplo?";
    text[2247] = "Mié, preciso ultrapassar meus limites.";
    text[2248] = "Um espresso triplo, doutor.";
    text[2249] = "Uau! Ousado isso aí!";
    text[2250] = "Em breve, vocês poderão apreciar o ilustre ELIXIR DIVINO!";
    text[2251] = "Mié, hehe.";
    text[2252] = "Nyla?";
    text[2253] = "Não, obrigada... Não é muito a minha praia.";
    text[2254] = "Doutor, precisamos nos concentrar em nossa tarefa!";
    text[2255] = "Um segundinho.";
    text[2256] = "Ah, passado na hora! Um gole e sua alma será livre.";
    text[2257] = "Meu Lux vai subir para níveis astronômicos! Ha, ha, ha, ha!";
    text[2258] = "Thomas, você deveria mesmo reduzir a cafeína. Esse é seu quarto café só hoje.";
    text[2259] = "Mié hehe. Mas café ajuda a mover as engrenagens da brilhante mente do doutor.";
    text[2260] = "Alguns dizem que é o segredo de sua genialidade! Mié hehehe!";
    text[2261] = "... Certo! Hora de ficar sério.";
    text[2262] = "Bella, temos uma emergência.";
    text[2263] = "O que estou prestes a revelar... deve ser mantido em confidencialidade.";
    text[2264] = "Caso as pessoas descubram, isso causaria pânico e desconforto a todos.";
    text[2265] = "AAAAAAH!!!!";
    text[2266] = "NÃÃÃÃOOOO! O QUÊ???";
    text[2267] = "Precisamos fazer algo a respeito desse cometa AGORA!";
    text[2268] = "O QUE FAREMOS?";
    text[2269] = "O que posso fazer para ajudar?";
    text[2270] = "Tetra também quer ajudar!";
    text[2271] = "Respirem fundo. Precisamos nos acalmar primeiro.";
    text[2272] = "Precisamos lidar com um passo de cada vez.";
    text[2273] = "O Cometa Coda é composto de uma rara forma de antimatéria que não compreendemos por completo.";
    text[2274] = "É extremamente volátil e energeticamente denso.";
    text[2275] = "Há muito tempo, o povo da Terra lançou suas armas mais destrutivas contra o cometa";
    text[2276] = "por desespero...";
    text[2277] = "... e fracassaram.";
    text[2278] = "O cometa consumiu tudo o que havia em seu caminho.";
    text[2279] = "Ah... Tetra queria obliterar o Cometa com seu Canhão de Plasma...";
    text[6012] = "E se ativássemos o Sistema de Defesa da Astrobarreira?";
    text[6013] = "O S.D.A.B funciona em pequenos asteroides e em detritos especiais,";
    text[6014] = "mas para algo desse tamanho...";
    text[6015] = "... a Astrobarreira não teria qualquer chance.";
    text[2280] = "A tecnologia de nossas armas atuais não são avançadas o suficiente para lidar com um cometa desta magnitude.";
    text[2281] = "Apesar disso... ainda há esperança!";
    text[2282] = "E se... utilizássemos nossa tecnologia de teleporte?";
    text[2283] = "Mié?";
    text[2284] = "...!";
    text[2285] = "Já somos capazes de teleportar pessoas por uma distância limitada e finita com teleportes.";
    text[2286] = "Se pudéssemos usar o mesmo conceito, redimensioná-lo, fazer alguns ajustes e...";
    text[2287] = "... Isso me soa familiar. Sei onde isso vai parar, Thomas.";
    text[2288] = "Você não pode estar falando sério!";
    text[2289] = "Estou.";
    text[2290] = "O cometa não será páreo para nós assim que completarmos a Celestia!";
    text[2291] = "Não... é arriscado demais. O projeto foi desligado por Thea por um motivo!";
    text[2292] = "Nylaaa, estou falando! Essa é a nossa melhor opção!";
    text[2293] = "Mié?";
    text[2294] = "Reeves, você faz ideia do que eles estão falando?";
    text[2295] = "Nem ideia...";
    text[2296] = "Provavelmente seja um projeto no qual trabalharam antes de eu entrar para a equipe.";
    text[2297] = "Nyla... Precisamos terminar o que começamos.";
    text[2298] = "Apesar de ser um caminho perigoso, acredito que é nossa melhor chance.";
    text[2299] = "Pai, do que vocês estão falando?";
    text[2300] = "Você verá, Bella. Hehehe.";
    text[2301] = "Nyla, já debati meu plano com Saros.";
    text[2302] = "E ele aprovou?";
    text[2303] = "Sim. Inclusive, ele já está realizando os preparativos para uma missão.";
    text[2304] = "... Beleza, certo.";
    text[2305] = "Pelas estrelas, Thomas, você e seus planos malucos.";
    text[2306] = "Não somos chamados de cientistas malucos a toa. Mié hehehe!";
    text[2307] = "Reeves, você é o único que nos chama assim.";
    text[2308] = "Mié!";
    text[2309] = "Prestem atenção, se vamos retomar o projeto, melhor fazer isso direito.";
    text[2310] = "Sem erros desta vez...";
    text[2311] = "Com todos se esforçando, conseguiremos... e salvaremos a humanidade!";
    text[2312] = "Todos vocês, sigam-me, por favor.";
    text[2313] = "Ainda não consigo acreditar que isso esteja acontecendo... É tudo tão repentino...";
    text[2314] = "Não se preocupe, Bella. Faremos a nossa parte para proteger as pessoas, não importa o que aconteça!";
    text[2315] = "Grande Escudeira Tetra irá liberar a fúria no Cometa Coda e nos Murks! Muahahahaha!";
    text[2316] = "Aaaaah! Tetra, você tem razão. O povo depositou a confiança deles em nós.";
    text[2317] = "Não podemos decepcioná-los! Vamos nos atualizar com o meu pai.";
    text[2318] = "O que será que tem atrás daquela porta?";
    text[2319] = "Será nossa primeira vez entrando em uma área restrita!";
    text[2320] = "Ah, é... Acabei de lembrar de algo.";
    text[2321] = "O quê?";
    text[2322] = "Parece que você me deve 2 barras de cheesecake!";
    text[2323] = "Ah, é! Ha, ha. Pode deixar!";
    text[2325] = ".@P.@P.@P.@P.@P.@P.";
    text[2326] = "Nunca entrei nesta sala!";
    text[2327] = "Mié hehe. Nem eu.";
    text[2328] = "Poucas pessoas têm acesso autorizado para entrar aqui.";
    text[2329] = "Boas-vindas ao Laboratório Nexus. Aqui é onde guardamos nossos projetos secretos.";
    text[2330] = "Uau! O que é aquela máquina?";
    text[2331] = "Isso que eu queria mostrar a vocês. Contemplem!";
    text[2332] = "Essa é a Celestia: o primeiro Gerador de Buraco de Minhoca da humanidade!";
    text[2333] = "MIÉ HEHEHEHE!";
    text[2334] = "Espetacular! Que invenção incrível!";
    text[2335] = "Então, nosso plano é impedir o Cometa Coda com um buraco de minhoca?";
    text[2336] = "Precisamente!";
    text[2337] = "Celestia será a próxima grande maravilha científica da humanidade!";
    text[2338] = "A Celestia é capaz de produzir um buraco de minhoca grande assim?";
    text[2339] = "Teoricamente, sim, mas por ora, não.";
    text[2340] = "Celestia ainda é um protótipo.";
    text[2341] = "Precisamos de tempo para projetar e finalizar a construção dela.";
    text[2342] = "Tempo que é valioso e limitado...";
    text[2343] = "Quanto tempo acha que vai levar o desenvolvimento?";
    text[2344] = "No mínimo, 6 meses. Talvez antes se tudo correr bem.";
    text[2345] = "Também precisamos de outro recurso para este plano funcionar.";
    text[2346] = "Presumo que seja por isso que chamou Bella aqui?!";
    text[2347] = "He, he. Aguardei pacientemente pela minha missão!";
    text[2348] = "Diga-me como posso ajudar!";
    text[2349] = "Bom, Celestia é alimentada por uma fonte de energia muito específica, que é necessária para sustentar";
    text[2350] = "um buraco de minhoca gigante.";
    text[2351] = "A forma mais poderosa de energia cósmica do universo: Antimatéria!";
    text[2352] = "Precisaremos de antimatéria, em uma quantidade MASSIVA para alimentar a criação de";
    text[2353] = "um buraco de minhoca cósmico astronômico!";
    text[2354] = "Por enquanto, nossa única fonte estável de Antimatéria vem...";
    text[2355] = "... Dos Murks.";
    text[2356] = "Correto.";
    text[2357] = "O-o quê? Precisaremos massacrar milhares de Murks?";
    text[2358] = "Eu@P.@P.@P.";
    text[2359] = "Eu não@P.@P.@P.";
    text[2360] = "Bella... Entendo sua preocupação, mas";
    text[2361] = "isso é uma ação necessária que precisamos tomar para garantir a nossa sobrevivência!";
    text[2362] = "...";
    text[2363] = "Se minha mãe estivesse aqui, ela teria encontrado outra maneira!";
    text[2364] = "Deve haver outra maneira! Não concordo com isso...";
    text[2365] = "Olha, é a Comandante Vivia!";
    text[2366] = "Boa tarde, doutor Thomas!";
    text[2481] = "Se você está aqui, isso significa que...";
    text[2367] = "O General Saros chegou.";
    text[2368] = "Ele já está aqui??";
    text[2369] = "O Lendário Herói finalmente faz sua aparição! Mié hehehe!";
    text[2370] = "Com sua força e poder militar, definitivamente teremos os Antinúcleos em um piscar de olhos!";
    text[2371] = "Ei!";
    text[2372] = "Perdoem-me, mas espero não estar atrasado para a festa.";
    text[2373] = "Vivia e eu viemos o mais rápido possível.";
    text[2374] = "Bom encontrar com todos vocês!";
    text[2375] = "Thomas, presumo que todos já saibam do plano?!";
    text[2376] = "Sim, quase todos a bordo já.";
    text[2377] = "Quase todos?";
    text[2378] = "Bom...";
    text[2379] = "Ah...";
    text[2380] = "Conhecendo a Bella, já esperava alguma resistência.";
    text[2381] = "Saros, não parece certo matar tantos Murks...";
    text[2382] = "Uma pergunta, Bella.";
    text[2383] = "Você quer salvar a humanidade?";
    text[2384] = "Sim.";
    text[2385] = "Então é necessário que coletemos os Antinúcleos.";
    text[2386] = "Os Murks são monstros. Criaturas sem inteligência e nenhum traço de humanidade.";
    text[2387] = "Eles não pertencem ao nosso mundo.";
    text[2388] = "Se há algo que presta neles, são seus Antinúcleos.";
    text[2389] = "...";
    text[2390] = "O desenvolvimento da Celestia começou há 10 anos.";
    text[2391] = "Seu pai, Nyla e diversos cientistas também foram parte do projeto.";
    text[2392] = "Na época, o progresso era lento.";
    text[2393] = "Realizamos cerca de 7 testes bem sucedidos de buraco de minhoca e...";
    text[2394] = "Infelizmente, o oitavo teste foi nosso último.";
    text[2395] = "Celestia começou a funcionar incorretamente e abriu um buraco de minhoca violento e instável.";
    text[2396] = "Tudo que entrava era desintegrado a nível molecular...";
    text[2397] = "Perdemos quatro vidas brilhantes naquele dia...";
    text[2398] = "Em dado momento, o projeto foi desligado por sua mãe, a antiga general.";
    text[2399] = "Ela se importava com todas as almas e não poderia arriscar perder outro valioso membro da equipe.";
    text[2400] = "É... Definitivamente, seria algo que minha mãe faria...";
    text[2401] = "Apesar do histórico trágico deste projeto, acreditamos que ele precise ser concluído.";
    text[2402] = "Se tivermos êxito, a morte de nossos amigos não será em vão.";
    text[2403] = "Aqueles que foram mortos por Murks também serão vingados!";
    text[2404] = "Na época, quase não tínhamos conhecimento sobre a ciência da antimatéria.";
    text[2405] = "Mas, com o passar dos anos, aprendemos e estudamos profundamente.";
    text[2406] = "Com o conhecimento que temos hoje, podemos minimizar os riscos e o perigo.";
    text[2407] = "Desta vez, faremos melhor.";
    text[2408] = "Com nossos esforços unidos, podemos superar a ameaça dos Murks E do Cometa Coda!";
    text[2409] = "Brilhante! Não sou capaz de contra-argumentar. Mié hehe.";
    text[2410] = "Saros tem um bom ponto.";
    text[2411] = "Bella, como seu pai, me dói enviá-la para o perigo...";
    text[2412] = "... Mas você é forte.";
    text[2413] = "Verdade. Você está entre nossos melhores guerreiros.";
    text[2414] = ".@P.@P.@P.@P.";
    text[2415] = "Hahahaha!";
    text[2416] = "Seu olhar diz tudo.";
    text[2417] = "Pois bem.";
    text[2418] = "Resolvermos isso... com um duelo!";
    text[2419] = "Espera... O quê??";
    text[2420] = "Um duelo?";
    text[2421] = "Sim. Prove-me a força de suas convicções.";
    text[2422] = "Lance-me sua técnica mais poderosa. Um Combo Lux.";
    text[2423] = "Acerte-me com tudo o que tem!";
    text[2424] = "Se eu ganhar, você vai garantir o cumprimento dessa missão e seguirá todas as ordens.";
    text[2425] = "E se eu ganhar? ...";
    text[2426] = "Bom...";
    text[2427] = "Veremos.";
    text[2428] = "Bella, tenha cuidado! O general Saros é o guerreiro mais forte de Luna!";
    text[2429] = "Deixa comigo! Saros, aceito seu desafio!";
    text[2430] = "EN GARDE!";
    text[2431] = "Acho que isso basta.";
    text[2432] = "Bella, você está bem? Está machucada?";
    text[2433] = "Aff, ele é forte demais... Não tive a menor chance.";
    text[2434] = "Você não conseguiu me derrotar, mas conseguiu provar o seu ponto.";
    text[2435] = "Não tenho um duelo divertido assim há um bom tempo! Hahaha!";
    text[2436] = "Você realmente fez bom uso do treinamento da sua mãe.";
    text[2437] = "... Droga...";
    text[2438] = "Não quero derramamento de sangue desnecessário... Será que é egoísmo da minha parte?";
    text[2439] = "Não há mesmo outro jeito? ...";
    text[2448] = "Bella, que tal tirar um tempo para pensar no que você realmente quer fazer?";
    text[2449] = "Vo-você... não vai me forçar a cumprir a missão?";
    text[2450] = "Não. Como eu disse, você provou seu ponto.";
    text[2451] = "Se você se mantiver forte em suas convicções, terá o poder para mudar o mundo.";
    text[2452] = "A escolha é sua.";
    text[2453] = "Você pode seguir em nosso caminho ou forjar o seu próprio.";
    text[2454] = "Enquanto isso, como general, farei o que acho melhor para Luna.";
    text[2457] = "Vivia, vamos aumentar o regime de treinamentos e recrutar mais guerreiros capazes.";
    text[2458] = "Sim, general.";
    text[2459] = "Somente os melhores esquadrões serão informados a respeito do Cometa Coda.";
    text[2460] = "Enquanto os Laboratórios Lunex se concentram no Gerador de Buraco de Minhoca, a Força Lunex deve";
    text[2461] = "priorizar a coleta de Antinúcleos, aumentar os treinamentos de combate";
    text[2462] = "e produzir mais Exoesqueletos para lutar contra Murks para salvar o máximo de vidas possível!";
    text[2463] = "Sim, general Saros!";
    text[2464] = "Thomas, confio em você e em sua equipe para garantir que Celestia seja concluída. Não me desaponte.";
    text[2465] = "Deixa com a gente, Saros. Posso confiar que você e seus soldados conseguirão os Antinúcleos necessários?";
    text[2466] = "É claro! Hahaha.";
    text[2467] = "... (suspiro)";
    text[2468] = "Por que a humanidade sempre é assolada por calamidades?";
    text[2469] = "Quem sabe esse seja o jeito cruel do universo de nos testar...";
    text[2470] = "... para ver quão evoluídos somos como espécie.";
    text[2471] = "Precisamos evoluir e superar. Vamos dar o nosso melhor, pessoal!";
    text[2472] = "Que nossa Lux brilhe para sempre!";
    text[2473] = "Vivia, vamos.";
    text[2474] = "Bella, você está bem?";
    text[2475] = "...";
    text[2476] = "Tem muita coisa passando na minha cabeça agora.";
    text[2477] = "Estou indo para Oceanus.";
    text[2478] = "Quer vir comigo?";
    text[2479] = "SIM! Mas por que iremos para Oceanus?";
    text[2480] = "Você verá.";
    text[2483] = "Belezinha! Vamos nessa!";
    text[2491] = "Uhul! Estamos na praia!";
    text[2492] = "Quer ir nadar??";
    text[2493] = "Nadar pode ajudar a desanuviar a cabeça!";
    text[2494] = "Não se preocupe, sou à prova d'água. Hihi.";
    text[2495] = "Não viemos para nadar, Tetra.";
    text[2496] = "Awn...";
    text[2497] = "Sinto muito ser uma estraga-prazeres...";
    text[2510] = "Tudo bem, Bella! Tetra só quer animá-la! Hihi.";
    text[2499] = "Oceanus...";
    text[2500] = "É um dos lugares mais bonitos de Luna.";
    text[2501] = "Eu e meus pais costumávamos vir aqui para fazer piqueniques.";
    text[2502] = "Meu pai finalmente ficava longe do trabalho para descansar e minha mãe e eu fazíamos";
    text[2503] = "nossos treinos aqui nesta praia. Era uma época mais simples.";
    text[2504] = "Ahhh... Vir aqui depois de tanto tempo é restaurador!";
    text[2505] = "Bella, por que nunca me trouxe aqui?";
    text[2506] = "Acho que as coisas ficaram bem agitadas após eu me tornar uma Guerreira Lunex.";
    text[2507] = "Agora, com o cometa vindo em nossa direção,";
    text[2508] = "quem sabe quando teremos a oportunidade de voltar aqui...";
    text[2509] = "Não consigo relaxar de verdade, sabendo que o Cometa Coda está lá fora e precisamos pará-lo.";
    text[2511] = "Saros me deu a chance de forjar meu próprio caminho...";
    text[2512] = "Se pensarmos em um plano sólido, quem sabe possamos mudar a opinião do General!";
    text[2513] = "Hmm...";
    text[2514] = "Nosso problema é que precisamos de uma fonte de energia de antimatéria para alimentar Celestia...";
    text[2515] = "Certo. Que é o motivo de Saros querer coletar Antinúcleos.";
    text[2516] = "Mas...";
    text[2517] = "E se houvesse outras formas de obter antimatéria?";
    text[2518] = "Como o quê?";
    text[2519] = "Há um mundo inteiro de antimatéria lá fora que podemos usar!";
    text[2520] = "Um mundo inteiro? ...";
    text[2524] = "Você fala do Reino Fantasma??";
    text[2521] = "Exatamente!";
    text[2522] = "Você viu com seus próprios olhos, Tetra!";
    text[2523] = "Poderíamos fazer uma expedição no Reino Fantasma para obter o combustível de que precisamos!";
    text[2525] = "Será perigoso se voltarmos lá sozinhas. Precisaremos de uma equipe formada.";
    text[2526] = "Isso também significa que terei que contar ao meu pai sobre nossa viagem ao Reino Fantasma.";
    text[2527] = "Talvez ele se convença de nos deixar ir se souber que sobrevivemos à nossa visita.";
    text[2528] = "Quer mesmo fazer isso, Bella?";
    text[2529] = "Sim. Mesmo se nos colocar em apuros. Acho que vale a tentativa.";
    text[2530] = "Pelo menos não teremos que matar Murks assim.";
    text[2531] = "Ok. Vamos falar da nossa ideia ao doutor Thomas!";
    text[2532] = "Espere, preciso fazer algo antes.";
    text[2533] = "Se a Força Lunex colocar as mãos no Antinúcleo de Cronos,";
    text[2534] = "ele acabará sendo usado como fonte de energia.";
    text[2540] = "Cronos não merece um destino assim.";
    text[2535] = "Os Murks podem ser monstros, mas eles também possuem almas.";
    text[2536] = "Cronos nos protegeu, como qualquer bravo herói o faria.";
    text[2537] = "Acho que esse é meu jeito de agradecer.";
    text[2538] = "Vamos, Tetra, hora de voltar para a Estação Espacial e falar com o meu pai!";
    text[2539] = "Certo, vamos!";
    text[7565] = "O que aquelas duas estão fazendo aqui? @P.@P.@P.@P.@P.";
    text[2561] = "Bella! Como está se sentindo?";
    text[2562] = "Mudou de ideia em relação à missão?";
    text[2563] = "Estou melhor, mas não mudei de ideia.";
    text[2564] = "Decidi que forjarei meu próprio caminho.";
    text[2565] = "Tenho uma ideia e preciso que me ouça.";
    text[2566] = "Só...";
    text[2567] = "Não fique bravo. Posso explicar tudo.";
    text[2568] = "Não ficarei bravo. Só estou preocupado com você...";
    text[2608] = "Não tem por quê. Estou bem.";
    text[2569] = "Bella... sabemos que você esteve no Reino Fantasma.";
    text[2570] = "O-o quê?? Mas, como você sabia?";
    text[2571] = "Quem sabe o general Saros possa explicar.";
    text[2572] = "Ei! Perdão pela intromissão.";
    text[2573] = "Bella, fico feliz que tenha retornado.";
    text[2574] = "Decidindo seguir meu plano ou não, você está aqui agora,";
    text[2575] = "o que significa que sua determinação em fazer mudanças não diminuiu nem um pouco.";
    text[2576] = "Durante nosso duelo, percebi traços de poeira estelar brilhando em seu equipamento de batalha.";
    text[2577] = "(Como ele teve tempo para perceber isso?? Estávamos LUTANDO!)";
    text[2578] = "Nossos sensores também detectaram traços de antimatéria vindo de você.";
    text[2579] = "Bella, temos regras por um motivo. Por favor, explique o que aconteceu.";
    text[2580] = "Sei que eu não deveria ir para o Reino Fantasma, mas não foi por escolha.";
    text[2581] = "O Murk que violou o Setor 16 nos emboscou!";
    text[2582] = "Ele nos enviou por um buraco de minhoca e foi como fomos parar no Reino Fantasma!";
    text[2583] = "Interessante...";
    text[2584] = "Murks são criaturas sem inteligência que agem por puro instinto destrutivo.";
    text[2585] = "Isso nunca aconteceu antes...";
    text[2586] = "Muito interessante...";
    text[2587] = "O que aconteceu com o Murk?";
    text[2588] = "Eu o derrotei.";
    text[2589] = "... e o Antinúcleo?";
    text[2590] = "Eu...";
    text[2591] = "Eu perdi o Antinúcleo.";
    text[2592] = "Estávamos correndo para encontrar uma rota de fuga que pudesse nos levar de volta para Luna.";
    text[2593] = "Entendi.";
    text[2594] = "Parece que a sorte estava do seu lado.";
    text[2595] = "Humanos conseguem sobreviver somente 72 horas no Reino Fantasma.";
    text[2596] = "Os sintomas começam a aparecer após 48 horas.";
    text[2597] = "Assim que você passa a marca das 72 horas, o ambiente de antimatéria começa a quebrar seus átomos.";
    text[2598] = "Aprendemos isso do jeito difícil.";
    text[2599] = "O QUÊ??";
    text[2600] = "Bella, você deve realizar um escaneamento vital o mais rápido possível!";
    text[2682] = "Eu falei para ela fazer um, mas ela nunca me ouve...";
    text[2601] = "Pai, estou bem. Fiquei lá por apenas algumas horas.";
    text[2625] = "Você sobreviver dessa vez não garante que sobreviverá na próxima.";
    text[2626] = "Presumo que sua ideia era realizar uma expedição para o Reino Fantasma, certo?";
    text[2627] = "Sim... Pensei que poderíamos coletar todo o combustível de antimatéria que precisamos de lá.";
    text[2602] = "Há partes do Reino Fantasma que a antimatéria é tão densa,";
    text[2609] = "que seu corpo desintegraria instantaneamente.";
    text[2610] = "Já consideramos enviar tropas para caçar os Murks no Reino Fantasma.";
    text[2603] = "Infelizmente, o risco é alto demais.";
    text[2611] = "Ainda há muitas coisas que não sabemos sobre o Reino Fantasma.";
    text[2612] = "O que sabemos é que a antimatéria lá é instável.";
    text[2613] = "O que precisamos para Celestia é uma forma estável de antimatéria,";
    text[2614] = "por isso, os Antinúcleos são nossa melhor opção.";
    text[2615] = "O Reino Fantasma... é um mundo incompatível para seres feitos de matéria.";
    text[2616] = "Se ao menos nossos corpos pudessem evoluir e transcender nossos limites...";
    text[2617] = "Poderíamos realmente nos tornar uma espécie intergaláctica...";
    text[2618] = "Então, estou sendo rebaixada? ...";
    text[2619] = "Não! Você está entre nossos melhores guerreiros.";
    text[2620] = "Sua violação do protocolo será perdoada desta vez.";
    text[2621] = "... e você está proibida de ir ao Reino Fantasma novamente.";
    text[2622] = "... Obrigada, general...";
    text[2604] = "(Droga...)";
    text[2623] = "(Estou sem opções...)";
    text[2624] = "Bella, fizemos alguns cálculos de quanto combustível precisaríamos... Mié...";
    text[2628] = "O número de Antinúcleos que precisamos excede a taxa com que os Murks surgem em Luna...";
    text[2629] = "O que significa que, mesmo se coletarmos todos os Antinúcleos que conseguirmos,";
    text[2630] = "ainda não será o suficiente para alimentar a Celestia...";
    text[2631] = "Não...";
    text[2632] = "Então o que faremos agora?";
    text[2633] = "Há sempre esperança!";
    text[2634] = "Um bom líder vem preparado com vários planos caso um deles falhe.";
    text[2635] = "Há uma terceira opção que podemos tentar.";
    text[2636] = "Há?";
    text[2637] = "Mié!";
    text[2638] = "Podemos dar um jeito sem ter que matar cada Murk que virmos.";
    text[2639] = "É uma missão relativamente nova que Vivia e eu estivemos planejando.";
    text[2640] = "Os avanços dela em Holotecnologia será nossa chave para triunfar.";
    text[2641] = "O alvo desta missão tem sido um espinho em nosso caminho há muito tempo.";
    text[2642] = "Para conseguir os Antinúcleos de que precisamos, precisamos capturar...";
    text[2643] = "O Murktador.";
    text[2676] = "Uma hora depois...";
    text[2644] = "Agora que você sabe o plano...";
    text[2645] = "... todos a bordo?";
    text[2646] = "Sim, general!";
    text[2677] = "Isso pode funcionar. Mié hehehe!";
    text[2678] = "Precisa funcionar. É nossa melhor opção neste momento.";
    text[2679] = "Verdade, o Murktador precisa ser capturado...";
    text[2647] = "Bella, o sucesso desta operação conta com sua força e determinação.";
    text[2648] = "Darei o meu melhor, Saros!";
    text[2649] = "Agradeço por... me dar esperanças.";
    text[2650] = "Se tudo der certo, não teremos que matar mais Murks.";
    text[2651] = "Todos, dispensados. Descansem e se recuperem.";
    text[2652] = "Vivia e eu cuidaremos dos preparativos finais. Após isso...";
    text[2653] = "Esperaremos pela oportunidade certa.";
    text[2654] = "Central de Comando, qual o problema?";
    text[2655] = "COM.: General, há um surto de Murks em Copernicus!";
    text[2656] = "Quantos Murks?";
    text[2657] = "COM.: Há centenas deles...";
    text[2681] = "Nunca tivemos tantos Murks surgindo ao mesmo tempo... Isso não pode ser...";
    text[2680] = "Central de Comando, emita um Estado de Emergência para o Setor 7.";
    text[2658] = "Envie nossos principais esquadrões para evacuar os cidadãos imediatamente!";
    text[2660] = "Também preciso que os Exoesqueletos Guerreiros estejam prontos para combate!";
    text[2659] = "COM.: Sim, general!";
    text[2661] = "Saros, parece que chegou nossa oportunidade!";
    text[2662] = "Onde há Murks, encontraremos o Murktador.";
    text[2671] = "Não. Ainda não estamos prontos. Preciso de mais tempo.";
    text[2672] = "Se não fizermos isso de acordo com o plano, a missão poderá ser prejudicada.";
    text[2673] = "Se o Murktador aparecer, conseguirei o tempo de que precisa.";
    text[2663] = "Talvez consiga conversar com ele. Dê-me essa chance!";
    text[2664] = "Se ele não aparecer, realizaremos a operação na próxima vez!";
    text[2665] = "Pelo menos deixe-me ir para que eu possa proteger as pessoas do perigo!";
    text[2674] = "...";
    text[2666] = "Muito bem. Boa sorte com a missão, Bella.";
    text[2667] = "Bella, por favor, tome cuidado!";
    text[2668] = "Irei, pai. Pode deixar comigo!";
    text[2669] = "MISSÃO EMERGENCIAL: SURTO DE MURKS";
    text[2670] = "Vá para o Setor 7 - Copernicus para auxiliar no controle do surto de Murks!";
    text[2683] = "Há Murks por todas as partes!";
    text[2684] = "Não mentiram quando falaram que era um surto de Murks!";
    text[2685] = "Bella, o que faremos? Isso está caótico demais!";
    text[2686] = "Precisamos garantir que todos os civis sejam evacuados primeiro!";
    text[2687] = "Espere!";
    text[2688] = "Mié! Bella, a situação é pior do que imaginávamos!";
    text[2689] = "Reeves, acabei de chegar em Copernicus! O que está acontecendo?";
    text[2692] = "Preciso que você e Tetra se concentrem na Rede de Distribuição de Água!";
    text[2690] = "Não se preocupe com os civis, temos tropas cuidando disso!";
    text[2693] = "O que aconteceu com a Rede de Distribuição de Água?";
    text[2694] = "Mié! A água ficou ROXA!";
    text[2695] = "O QUÊ?? COMO?";
    text[2696] = "Como espera que resolvamos isso? Precisamos impedir que os Murks destruam tudo!";
    text[2697] = "Deixe os soldados cuidarem disso! Seu trabalho é garantir que os soldados não morram!";
    text[2698] = "Água roxa indica uma alta concentração de permanganato de potássio,";
    text[2699] = "que é usado como um desinfetante para ajudar a remover germes e bactérias nocivos.";
    text[2700] = "No entanto, em excesso, a água se torna mortal e os gases podem";
    text[2701] = "se tornar tóxicos ao respirar!";
    text[2702] = "A cidade de Copernicus foi construída sobre um reservatório essencial de água, mié.";
    text[2703] = "Precisamos protegê-lo a qualquer custo! A água é essencial para a nossa sobrevivência!";
    text[2704] = "Deve haver 4 Máquinas Filtrantes espalhadas pela cidade.";
    text[2705] = "Localize as 4 máquinas e peça à Tetra entrar e restaurar a rede!";
    text[2706] = "Entendido!";
    text[2710] = "SOCORRO! ALGUÉM ME AJUDE!!";
    text[2711] = "Agora é sua chance de correr! Deixe o resto comigo!";
    text[2712] = "Evacue para um lugar seguro AGORA!";
    text[2713] = "Sim, senhorita! O-obrigado! Por favor, tome cuidado!";
    text[2714] = "Ufa! Fico feliz que aquela família conseguiu ficar em segurança... Foi por pouco.";
    text[2715] = "Bella, fique de prontidão! Detectei um sinal estranho! ...";
    text[2716] = "Murktador! Aff. Qual foi desse golpe traiçoeiro??";
    text[2717] = "Isso machucou de verdade! Ai...";
    text[2718] = "É você de novo...";
    text[2719] = "Estou surpresa de que ainda está de pé após receber meu Soco Fásico.";
    text[2720] = "Você é bem mais forte do que parece, preciso admitir.";
    text[2721] = "Aaahh... (arfa)... (arfa)...";
    text[2722] = "Preciso... falar contigo...";
    text[2723] = "Ahn? Somos inimigos. Não temos nada para conversar.";
    text[2724] = "Que isso fique de aviso para vocês e para a Força Lunex.";
    text[2725] = "Não cruzem meu caminho se não quiserem se machucar.";
    text[2726] = "O último lugar que os Antinúcleos devem estar é nas mãos da Força Lunex.";
    text[2727] = "Droga... Ele escapou.";
    text[2728] = "Bella, você está bem?";
    text[2729] = "Sim, estou me recuperando aos poucos, mas preciso descansar um pouco.";
    text[2730] = "Ele pode estar fora das nossas vistas agora, mas duvido que irá embora tão cedo.";
    text[2731] = "Ele está aqui para coletar os Antinúcleos. Ainda há uma chance de conversarmos com ele.";
    text[2732] = "Tetra, fique de olho para ver se ele aparece enquanto conserto da Rede de Distribuição de Água!";
    text[2733] = "Entendido!";
    text[2734] = "E-espere aí!";
    text[2735] = "O que aconteceu?";
    text[2736] = "Ma-ma-mais Murks!";
    text[2737] = "Nossa... esses Murks não acabam.";
    text[2738] = "Nesse ritmo, não conseguiremos restaurar a Rede de Distribuição de Água a tempo...";
    text[2739] = "E, provavelmente, o Murktador também escapará...";
    text[2740] = "Parece que a guerreira prodígio precisa de reforços!";
    text[2741] = "?!";
    text[2742] = "SOCO BALA! HAIÁ!";
    text[2743] = "Raine??";
    text[2744] = "O que está fazendo aqui? Achei que tinham alocado você em outra missão!";
    text[2745] = "A Central de Comando enviou um sinal de perturbação. Este surto está saindo do controle!";
    text[2754] = "Além disso, que tal um 'de nada' por salvar seu traseiro prodígio?! Hahaha!";
    text[2746] = "Deixa para depois! Ataque chegando!!";
    text[2747] = "E, pela última vez, pare de me chamar de guerreira prodígio!!";
    text[2748] = "Claro, claro! Se você topar lutar comigo depois!";
    text[2749] = "Você ainda me deve uma revanche, sabe?!";
    text[2750] = "Eu sei, eu sei!";
    text[2751] = "Que tal cuidarmos desses Murks que estão prestes a nos atacar antes?";
    text[2752] = "Não se preocupe, trouxe companhia!";
    text[2753] = "Vamos, meninas! Hora de mostrar a esses Murks o poder do Esquadrão Raine!";
    text[2755] = "PERFURADOR DE LEVIPEDRA!";
    text[2756] = "PRISÃO DE PLASMA!";
    text[2757] = "Melody e Zara!";
    text[2758] = "Oi, Tetra! Você continua uma gracinha, como sempre!";
    text[2759] = "Hihihihihi! Você também, Melody!";
    text[2760] = "Bom revê-la, Bella!";
    text[2761] = "Como consegue continuar tão linda, mesmo depois de ser espancada?";
    text[2762] = "Hmm... obrigada?!";
    text[2763] = "Ei, Zara, isso foi um novo combo de ataque?";
    text[2764] = "Sim.";
    text[2765] = "Precisávamos de um jeito eficiente e elegante de manter os Murks à distância.";
    text[2766] = "Fomos instruídos a matar o mínimo de Murks possível.";
    text[2767] = "Parece que alguém precisa segurar seus Socos Bala um pouco.";
    text[2768] = "JAMAIS!";
    text[2769] = "Quando se luta, a gente tem que ir COM TUDO!";
    text[2770] = "... mesmo no treino! Se essa não fosse uma missão emergencial...";
    text[2771] = "Eu estaria DESCENDO A PORRADA em você agora mesmo! HAHAHA!";
    text[2772] = "Relaxa aí, Raine. Precisamos concentrar nossa energia nessa missão.";
    text[2773] = "Tsc. Claro, tem razão...";
    text[2774] = "Bella, temos um relatório da missão de Reeves.";
    text[2775] = "Você e Tetra precisam restaurar a Rede de Distribuição de Água URGENTEMENTE!";
    text[2776] = "Vamos cobrir vocês!";
    text[2777] = "Soltaremos nossa fúria sobre os Murks que machucam o Povo de Luna!";
    text[2778] = "Raine, sem matar Murks.";
    text[2779] = "Ok, soltaremos DE LEVE nossa fúria sobre os Murks que machucam o Povo de Luna...";
    text[2780] = "HESITANTEMENTE!";
    text[2781] = "Já serve. Vamos fazer dessa missão uma missão elegante.";
    text[2782] = "A propósito, Saros nos atualizou sobre a Operação Secreta.";
    text[2783] = "Se encontrarmos o Murktador, seremos as responsáveis por CAPTURÁ-LO!";
    text[2784] = "O Esquadrão Raine emergirá vitorioso! A promoção está praticamente garantida! BAHAHAHA!";
    text[2785] = "Não se eu o captura antes! Hehe.";
    text[2786] = "Dica útil: fiquem atentas com o Soco Fásico dele.";
    text[2787] = "SOCO FÁSICO?? O QUÊ?";
    text[2788] = "(Então Bella lutou contra ele antes? Hmm...)";
    text[2789] = "(Ah... Soco Fásico é um nome tão irado...)";
    text[2790] = "NÃO, NÃO, NÃO! Só pode haver uma mestre do combate aqui. Ele vai se dar mal!!";
    text[2791] = "Vejo você por aí, Bella! Se precisar de reforços, estaremos por perto!";
    text[2792] = "Boa sorte!";
    text[2793] = "Olhe, Bella. Uma Máquina Filtrante aqui!";
    text[2794] = "Maravilha, vamos nessa! Não há tempo a perder!";
    text[2707] = "Ok, Tetra. Estou contando com você para me ajudar a restaurar a Rede de Distribuição de Água!";
    text[2708] = "É a Hora da Escudeira! Hihihi. Vamos nessa!";
    text[2555] = "Bella, precisamos restaurar a Rede de Distribuição de Água!";
    text[2556] = "No total, há 4 Máquinas Filtrantes que precisamos acessar";
    text[2557] = "para invadir o firewall de segurança! Coloque-me dentro!";
    text[2558] = "Tetra acessou a Rede de Distribuição de Água?";
    text[2808] = "Vejo que audição não é seu forte.";
    text[2809] = "Ahn?! A sua audição é péssima também!";
    text[2810] = "Olha, eu lhe avisei...";
    text[2811] = "ESPERE!";
    text[2812] = "POR FAVOR, PARE!";
    text[2813] = "POR QUÊ? Para que você possa enrolar esperando reforços?";
    text[2814] = "... Para que vocês possam finalmente capturar o infame Murktador?";
    text[2815] = "Patético.";
    text[2816] = "Não...";
    text[2817] = "Não quero capturá-lo. Só quero conversar.";
    text[2818] = "Mentiras. Você e todos os seus superiores não fazem nada além de vomitar mentiras.";
    text[2819] = "Estou falando a verdade!";
    text[2820] = "E eu sei... ";
    text[2821] = "... sei mais sobre você do que imagina...";
    text[2822] = "...?";
    text[2823] = "Independentemente do que saiba, não sabe toda a verdade.";
    text[2824] = "A justiça prevalecerá.";
    text[2825] = "ESPERE!";
    text[2826] = "Aff. Você não consegue calar a boca, né?!";
    text[2827] = "Por favor, não libere seus poderes agora! Pelo menos, não aqui!";
    text[2828] = "Aquela máquina atrás de você é parte do sistema de filtragem de água da cidade.";
    text[2829] = "Se aquela máquina for danificada, estaremos condenados...";
    text[2830] = "Os gases tóxicos da água mataram todos aqui.";
    text[2831] = "Também há chance de a água espalhar para outros setores.";
    text[2832] = "...";
    text[2833] = "Por favor, não coloque o Povo de Luna em risco.";
    text[2834] = "Por favor...";
    text[2835] = "(E se ela estiver mentindo? E se isso for uma armadilha? ...)";
    text[2836] = "(Será que posso confiar no que ela diz?)";
    text[2837] = "(Mas...)";
    text[2838] = "(E se estiver falando a verdade...)";
    text[2839] = "Por favor...";
    text[2840] = "...";
    text[2841] = "Você disse que precisava conversar.";
    text[2842] = "Resolva essa bagunça de água tóxica e me encontre na cobertura do Prédio do Sistema de Água.";
    text[2843] = "Venha sozinha. Se eu detectar algum truque ou artifício, irei embora.";
    text[2844] = "Obrigada.";
    text[2845] = "Ufa. Ele é tão assustador... e tão legal ao mesmo tempo...";
    text[2846] = "Agora não é hora de provocar, Tetra!";
    text[2847] = "Opa. Estamos recebendo uma transmissão do General Saros.";
    text[2848] = "Bella, como está a situação?";
    text[2849] = "Estamos tentando reinicializar a Rede de Distribuição de Água o mais rápido possível.";
    text[2850] = "Pois bem, não quero tomar muito do seu tempo, então vou direto ao ponto.";
    text[2851] = "As preparações estão prontas.";
    text[2852] = "Você se encontrou com o Murktador?";
    text[2853] = "Hm...";
    text[2854] = "Sim... mas...";
    text[2855] = "Ele escapou.";
    text[2856] = "Você não é muito boa em mentir...";
    text[2857] = "De qualquer jeito, você é ótima em conquistar a confiança das pessoas.";
    text[2858] = "Onde ele quer se encontrar com você?";
    text[2859] = "... Na cobertura do Prédio do Sistema de Água.";
    text[2860] = "Ele me deu uma chance de conversarmos... mas quer se encontrar comigo a sós.";
    text[2861] = "Como você disse, ele não confia mesmo na Força Lunex.";
    text[2862] = "Compreensível. Nossa história com ele é complicada.";
    text[2863] = "De qualquer forma, ele é um homem perigoso com informações valiosas.";
    text[2868] = "Ele PRECISA ser capturado.";
    text[2864] = "Não proceda para a Cobertura do Sistema de Água até chegarmos.";
    text[2865] = "...";
    text[2866] = "Sim, general.";
    text[2867] = "...";
    text[2869] = "Conseguimos! Bom trabalho, Tetra!";
    text[2870] = "Hihihi. Super Escudeira Tetra ao resgate!";
    text[2976] = "Parece que os Murks também foram embora.";
    text[2977] = "Ou fugiram ou o Murktador caçou todos eles...";
    text[2871] = "Devemos poder usar as Jatoplataformas agora.";
    text[2872] = "Vamos nos encontrar com o Murktador na cobertura do prédio do Sistema de Água.";
    text[2873] = "Ok! O prédio fica a noroeste da cidade! Vamos que vamos!";
    text[2875] = "O Murktador desconfia das autoridades...";
    text[2876] = "Os motivos dele não estão claros.";
    text[2877] = "Não entendo...";
    text[2878] = "Seus dons...";
    text[2879] = "Seus poderes...";
    text[2880] = "... podem nos ajudar a salvar o Povo de Luna.";
    text[2881] = "Só sabemos o que sabemos pela nossa perspectiva.";
    text[2882] = "Se eu puder ganhar a confiança dele...";
    text[2883] = "Quem sabe podemos chegar a um entendimento.";
    text[2884] = "Precisamos ver o lado dele da história para saber a toda a verdade...";
    text[2885] = "...";
    text[2886] = "O-o quê?? O Murktador é um dos que nos ajudou a aprender sobre Antimatéria?";
    text[2887] = "Involuntariamente, sim.";
    text[2888] = "Ele é o catalizador da nossa Pesquisa sobre Antimatéria.";
    text[2889] = "Há muito anos, tivemos um paciente que veio ao nosso centro de emergências médicas.";
    text[2890] = "Era um garoto com risco de morrer por uma condição desconhecida.";
    text[2891] = "Seu corpo emitia quantidades intoleráveis de energia estranha.";
    text[2892] = "Após inúmeros testes, fomos milagrosamente capazes de extrair";
    text[2893] = "a energia transbordante do garoto e, como resultado, salvamos a vida dele.";
    text[2894] = "Após vários dias, os sinais vitais do garoto voltaram a níveis normais e ele foi curado.";
    text[2895] = "Contudo, o estresse no corpo dele o colocou em um estado de coma.";
    text[2896] = "Essa energia estranha... Presumo que fosse...";
    text[2897] = "Antimatéria.";
    text[2898] = "A energia que transbordava do garoto era antimatéria pura e estável.";
    text[2899] = "Graças a ele, aprendemos muito sobre Antimatéria e suas propriedades.";
    text[2900] = "Nossa pesquisa levou à criação da tecnologia de buraco de minhoca,";
    text[2901] = "à descoberta do Reino Fantasma";
    text[2902] = "e à invenção dos Exoesqueletos e armas que nos ajudam a lutar contra os Murks hoje em dia.";
    text[2903] = "Certo dia, após meses em coma, o garoto finalmente acordou.";
    text[2904] = "Ele sentia uma dor insuportável e emitia uma quantidade astronômica de antimatéria.";
    text[2905] = "Tentamos acalmá-lo e ajudá-lo, mas não conseguíamos nos aproximar.";
    text[2906] = "Ele fugiu de nossas instalações e, desde então, não conseguimos capturá-lo.";
    text[2907] = "Então esse garoto era o Murktador...";
    text[2908] = "Correto.";
    text[2909] = "Seus poderes... Será que já nasceu com eles?";
    text[2910] = "É tão fascinante quanto aterrorizante. Mié!";
    text[2911] = "... Um humano com o poder de manipular Antimatéria.";
    text[2912] = "Quem mais sabe sobre ele?";
    text[2913] = "Teoricamente não sabemos nada. Nunca tivemos a chance de conversar.";
    text[2914] = "Não temos registros dele... Nem identificação.";
    text[2915] = "Não sabemos seu nome nem de onde veio.";
    text[2916] = "Ele tem informações que desconhecemos... e um poder que não compreendemos totalmente.";
    text[2917] = "Também acreditamos que o Murktador tem algum tipo de conexão com os Murks.";
    text[2918] = "?? ...";
    text[2919] = "Os Murks começaram a aparecer alguns meses depois de o garoto fugir.";
    text[2920] = "É possível que suas irradiações de antimatéria tenham atraído os Murks ao nosso mundo.";
    text[2921] = "Você tem alguma prova?";
    text[2922] = "... Não. É só uma teoria.";
    text[2923] = "Os Murks são seres altamente reativos a outras fontes de Antimatéria.";
    text[2924] = "Dada a linha do tempo dos eventos, é possível que haja uma ligação.";
    text[2925] = "Vocês estão tratando o Murktador como algum tipo de monstro.";
    text[2926] = "Bom, ele definitivamente tem o poder de um monstro. E também é um criminoso.";
    text[2927] = "Ele é só uma vítima de seus próprios poderes, que não é capaz de controlar!";
    text[2928] = "Suas emissões de antimatéria destruíram propriedades militares e machucaram muitas pessoas inocentes.";
    text[2929] = "Incidente após incidente...";
    text[2930] = "Quem sabe quando ele terá sua próxima crise.";
    text[2931] = "Ele é um homem perigoso.";
    text[2932] = "... Mas não necessariamente uma pessoa ruim.";
    text[2933] = "Seja lá seu motivo para caçar Murks,";
    text[2934] = "ele também está salvando indiretamente as pessoas.";
    text[2935] = "Vocês já consideraram que ele não quer viver uma vida em cativeiro?";
    text[2936] = "E se ele só estiver assustado?";
    text[2937] = "Ele não é algum tipo de cobaia que precisa ser estudada... Ele é um humano como todos nós.";
    text[2938] = "Entendemos, mas não podemos fazer vista grossa para todo o dano que ele causou e todas";
    text[2939] = "as pessoas que machucou... intencionalmente ou não.";
    text[2940] = "Ele é um inimigo potencial para a humanidade.";
    text[2941] = "Defendendo os Murks... e agora ficando do lado do Murktador...";
    text[2942] = "Parece que você precisa descobrir de que lado está, Bella.";
    text[2943] = "S-S-Saros... Não vamos tirar conclusões precipitadas aqui.";
    text[2944] = "Bella só está sendo...";
    text[2945] = "A Bella.";
    text[2946] = "Estou do lado do que acho que é certo.";
    text[2947] = "(Suspiro)";
    text[2948] = "Peço desculpas.";
    text[2975] = "O Murktador tem sido um espinho para mim por inúmeros motivos...";
    text[2949] = "... Mas vamos retomar nosso foco e por que o mencionei em primeiro lugar.";
    text[2950] = "Lidar com o Cometa Coda é nossa prioridade agora.";
    text[2951] = "Como Reeves já mencionou...";
    text[2952] = "O número de Antinúcleos que precisamos excede a taxa com que os Murks surgem em Luna...";
    text[2953] = "O que significa que, mesmo se coletarmos todos os Antinúcleos que conseguirmos,";
    text[2954] = "ainda não será o suficiente para alimentar a Celestia...";
    text[2955] = "E, por isso... vamos atrás dos Antinúcleos que o Murktador já coletou.";
    text[2956] = "O Murktador provavelmente está escondendo milhares de Antinúcleos.";
    text[2957] = "Se pudermos usar esses Antinúcleos para nos ajudar a alimentar a Celestia...";
    text[2958] = "Não teremos que matar mais Murks e poderemos parar o Cometa Coda.";
    text[2959] = "...";
    text[2960] = "Topo embarcar nesta missão com uma condição.";
    text[2961] = "Deixe-me ser quem irá conversar com ele.";
    text[2962] = "Tentarei obter as informações de que precisamos.";
    text[2963] = "Se ele souber da ameaça do Cometa Coda, talvez trabalhe conosco.";
    text[2964] = "...";
    text[2965] = "Ele não confia em nós. Acha que pode mudar a cabeça dele?";
    text[2966] = "... Darei o meu melhor.";
    text[2967] = "... Pois bem.";
    text[2968] = "Contudo, se ele tentar fugir...";
    text[2969] = "Não teremos outra escolha se não usar a holotecnologia da Vivia para capturá-lo.";
    text[2972] = "Lembre-se, esta é a única opção que temos sem ter que matar mais Murks.";
    text[2973] = "Compreende e aceita esta missão, Bella?";
    text[2974] = "Eu aceito!";
    text[3000] = "Já houve o tempo em que confiei na Força Lunex para proteger a humanidade.";
    text[3001] = "Até sonhei em me juntar à Força Lunex um dia... me tornar um guerreiro.";
    text[3002] = "Se eu fosse mais forte naquela época...";
    text[3003] = "Se ao menos fosse capaz de controlar meus poderes...";
    text[3004] = "... não teria chegado a esse ponto.";
    text[3005] = "Não pedi por esses poderes...";
    text[3006] = "Tudo o que eles fizeram foi causar dor e sofrimento.";
    text[3007] = "Levei anos para aprender a controlar uma pequena parte dele.";
    text[3008] = "Machuquei várias pessoas...";
    text[3009] = "... e não posso me perdoar pelas coisas que fiz.";
    text[3010] = "O mínimo que posso fazer é tentar encontrar um jeito...";
    text[3011] = "Encontrar um jeito para quê?";
    text[3012] = "Para ter justiça.";
    text[3013] = "...";
    text[3014] = "De qualquer forma, não tenho o dia todo. O que você queria conversar?";
    text[3015] = "Bom, vou começar perguntando o seguinte...";
    text[3016] = "Por que está coletando os Antinúcleos?";
    text[3017] = "Aff. Isso de novo...";
    text[3018] = "A Força Lunex não tem suas próprias reservas de Antinúcleos?";
    text[3019] = "Por que se incomodar em vir até a mim?";
    text[3020] = "Não tenho interesse algum em ajudá-los.";
    text[3021] = "Cacem Murks por conta própria.";
    text[3022] = "Não é o suficiente...";
    text[3023] = "Precisamos de mais Antinúcleos como combustível...";
    text[3024] = "... mas não pelos motivos que você imagina.";
    text[3025] = "Murktador... precisamos mesmo da sua ajuda!";
    text[3026] = "O Cometa Coda voltou!";
    text[3027] = "Então está me dizendo que um cometa de Antimatéria está vindo em nossa direção e temos";
    text[3028] = "um ano para coletar Antinúcleos o suficiente para alimentar um Gerador de Buraco de Minhoca incompleto?";
    text[3029] = "Espera mesmo que eu acredite nisso?";
    text[3030] = "Estou falando a verdade! Não tenho motivos para mentir...";
    text[3031] = "... Um cometa de Antimatéria...";
    text[3032] = "Isso poderia explicar as estranhas explosões de Antimatéria que tenho sentido ultimamente...";
    text[3033] = "Se o que está dizendo é verdade, essas explosões podem ser o motivo do surto.";
    text[3034] = "Se não obtivermos combustível suficiente para alimentar Celestia, será o fim da humanidade...";
    text[3035] = "... Mesmo assim, não posso lhes dar os Antinúcleos que tenho.";
    text[3036] = "Você precisa encontrar outro jeito de parar o Cometa Coda.";
    text[3037] = "Todas as nossas opções se esgotaram! Você é literalmente minha última esperança!";
    text[3038] = "Não posso...";
    text[3039] = "Sério mesmo? Você vai arriscar a segurança de todos pelos seus próprios interesses?";
    text[3040] = "Estou pedindo ajuda porque fui uma das que não quis matar mais Murks!";
    text[3041] = "...";
    text[3042] = "Por favor... Preciso saber a verdade.";
    text[3043] = "Quero proteger a humanidade e os Murks.";
    text[3044] = "Acredito que trabalhando juntos, poderemos conseguir isso e muito mais!";
    text[3045] = ".....  .....  .....  .....";
    text[3046] = "Da última vez que nos encontramos, você me perguntou se eu era capaz de sentir a dor dos Murks...";
    text[3047] = "A verdade é que sim... E não sei como sou capaz de fazer isso.";
    text[3048] = "Eu só... sinto na minha alma.";
    text[3049] = "Recentemente, encontrei um Murk... que falou comigo.";
    text[3050] = "... O que ele falou?";
    text[3051] = "Proteja.";
    text[3052] = "Isso é... interessante.";
    text[3053] = "Nunca ouvi um Murk se comunicar com outras pessoas antes.";
    text[3054] = "(O Murk falou com ela...)";
    text[3055] = "(Será? ...)";
    text[3056] = "Conte-me...";
    text[3057] = "Qual seu nome?";
    text[3058] = "Meu nome é Bella Grey.";
    text[3059] = "Grey...";
    text[3060] = "Então você é a filha de Thea??";
    text[3061] = "(Então talvez eu possa confiar nela...)";
    text[3062] = "(...)";
    text[3063] = "Espera aí! Você conheceu minha mãe?";
    text[3064] = "... Sim.";
    text[3065] = "Ela era uma líder admirável, diferente do atual.";
    text[3066] = "Ahn?! Saros é um grande líder! O que você tem contra Saros?";
    text[3075] = "Bella, estamos com esse moleque cercado!";
    text[3067] = "Você... Você disse que viria sozinha!";
    text[3068] = "Isso foi uma emboscada desde o começo!";
    text[3069] = "Não! Não contei nada a eles!";
    text[3070] = "Raine! Melody! Zara!";
    text[3071] = "Abaixem suas armas!";
    text[3072] = "Estou tentando conversar com ele!";
    text[3073] = "Não será possível, Bella. Saros nos contou que você tentaria vir aqui.";
    text[3074] = "Sinto muito... Estamos apenas seguindo ordens.";
    text[3076] = "Bella, essa é nossa melhor chance para finalmente capturar o Murktador!";
    text[3077] = "Tsc. Preciso dar o fora daqui.";
    text[3078] = "Não posso deixá-lo ir! Precisamos da sua ajuda!";
    text[3079] = "A conversa acaba aqui. Vocês estão todos condenados!";
    text[6004] = "Aaahhhh!";
    text[7566] = "Você está bem? O que está acontecendo?";
    text[6005] = "NÃO...";
    text[6006] = "AFASTE-SE...";
    text[6007] = "NÃO DEIXAREI... QUE ME CONSUMA MAIS UMA VEZ...";
    text[6008] = "Uau...";
    text[6009] = "O que foi aquilo??";
    text[3080] = "(Arfa)... (Arfa)...";
    text[6010] = "Aquela forma...";
    text[6011] = "É o que me torno quando minha Antimatéria me consome...";
    text[3081] = "Por favor, não me... force mais...";
    text[3082] = "Se eu perder o controle novamente...";
    text[3083] = "Não quero continuar lutando contra você. Você não é meu inimigo.";
    text[3084] = "Por favor, tente cooperar conosco!";
    text[3085] = "Holocampo, ativar!";
    text[3086] = "Parece que chegamos bem a tempo.";
    text[3087] = "...";
    text[3088] = "Nos encontramos novamente, Murktador.";
    text[3089] = "Sugiro que fique parado se dá valor à sua vida.";
    text[3090] = "Este Holocampo foi projetado para absorver energia cinética.";
    text[3091] = "Se chegar em certo limite, poderemos usar a energia acumulada";
    text[3092] = "para fazer com que esse Holocampo se imploda...";
    text[3098] = "... Você seria mordo pelos seus próprios poderes.";
    text[3093] = "Você está blefando.";
    text[3094] = "Sua holotecnologia nunca me impediu no passado!";
    text[3095] = "Hahahaha! Fizemos grandes melhorias desde a última vez que lutamos.";
    text[3096] = "Vá em frente.";
    text[3097] = "Arrisque tudo pelo que tem se esforçado.";
    text[3099] = "... Tsc.";
    text[3100] = "Você se saiu bem, Bella. Sabia que poderia contar com você.";
    text[3101] = "... Obrigada...";
    text[3102] = "Leve-o para o Complexo Carcerário.";
    text[3103] = "Temos muito para colocar em dia, Murktador.";
    text[3104] = "...";
    text[3105] = "Sua inconsequência...";
    text[3106] = "... as pessoas que machucou...";
    text[3107] = "... a destruição do Setor 3...";
    text[3108] = "... e os Antinúcleos que coletou...";
    text[3109] = "A justiça será feita por todos os seus crimes.";
    text[3110] = "Você vai nos contar onde escondeu todos os Antinúcleos.";
    text[3111] = "Não quer salvar a humanidade?";
    text[3112] = "Salvar a humanidade?";
    text[3113] = "Do quê? Dos Murks?";
    text[3114] = "De VOCÊS??";
    text[3115] = "Que delírio absurdo é esse que está falando?";
    text[3116] = "Eu sou o protetor da humanidade. A Força Lunex existe para servir o povo.";
    text[3117] = "Você é quem é o perigo para todos nós.";
    text[3118] = "Salvarei a humanidade sozinho. Me recuso a ajudar vocês.";
    text[3119] = "(Arfa)... (Arfa)...";
    text[3120] = "Parece que vocês estão esgotados. Teremos que conversar mais tarde.";
    text[3121] = "Pessoal, aproveitem um descanso merecido. Logo vamos celebrar.";
    text[3124] = "Hoje é um dia memorável.";
    text[3122] = "Não só capturamos o Murktador";
    text[3123] = "Como também impedimos o maior surto de Murks da história!";
    text[3125] = "SIM, GENERAL!";
    text[3126] = "Ei, Zara!";
    text[3127] = "... Oi.";
    text[3128] = "No que está pensando?";
    text[3129] = "Estou pensando em um novo nome de combo de ataque.";
    text[3130] = "O que você acha de Soco de Chuva de Pedras?";
    text[3131] = "Elegante";
    text[3132] = "Meh";
    text[3133] = "Perfeito.";
    text[3134] = "Preciso que todos os nossos ataques tenham nomes irados.";
    text[3135] = "Raine e Melody geralmente deixam eu criar o nome dos nossos ataques.";
    text[3136] = "Hmm, de volta para os rascunhos. Obrigada.";
    text[3137] = "Melody, precisa de ajuda?";
    text[3138] = "Não, não. Não se preocupe conosco, Bella.";
    text[3139] = "Nós lidaremos com os Murks. Foque na Rede de Distribuição de Água!";
    text[3140] = "E aí, guerreira prodígio? Estou procurando o Murktador.";
    text[3141] = "Pare de me chamar assim!";
    text[3142] = "NUNCA! Quer lutar? Estou me coçando para te dar uma surra!";
    text[3143] = "Agora NÃO é uma boa hora, Raine.";
    text[3144] = "Ok, ok.";
    text[3145] = "Algumas horas depois...";
    text[3146] = "Caros cidadãos do Setor 7!";
    text[3147] = "Estamos aqui unidos para honrar e agradecer nossos bravos Guerreiros Lunex";
    text[3148] = "aqui atrás de mim, por proteger este setor e seus moradores durante esta crise.";
    text[3149] = "Eles colocaram suas vidas em risco para garantir a segurança de todos.";
    text[3150] = "Fico feliz em anunciar que não houve fatalidades durante este surto.";
    text[3151] = "Essa é uma tremenda vitória para a humanidade!";
    text[3152] = "SIIIIM! UHUUUUL!";
    text[3153] = "Continuaremos a tomar as ações necessárias para aprender mais sobre os Murks";
    text[3154] = "... e como nos defender desses monstros!";
    text[3155] = "Sempre há esperança! Um brinde a um novo dia e a um futuro brilhante para Luna!";
    text[3161] = "Que nossa Lux brilhe para sempre!";
    text[3162] = "ISSO! Reconhecimento, bebê! Todos fizeram um ótimo trabalho hoje!";
    text[3163] = "É! Definitivamente, essa foi a missão mais difícil que enfrentamos!";
    text[3164] = "Concordo. Você fez um ótimo trabalho também, Tetra.";
    text[3165] = "Agora sou a Heroína do Surto Escudeira Tetra! Hihihi.";
    text[3166] = "Bella, você está bem?";
    text[3167] = "Você acabou de comer 5 barras de cheesecake.";
    text[3168] = "No que está pensando?";
    text[3169] = "...";
    text[3170] = "É só que... Eu estava tão perto da verdade...";
    text[3171] = "Ei, desculpa por mais cedo.";
    text[3172] = "Estávamos apenas seguindo ordens...";
    text[3205] = "Bella, pense assim:";
    text[3173] = "Pelos menos, capturamos o Murktador, certo?";
    text[3174] = "Agora podemos interrogá-lo sempre que precisarmos!";
    text[3175] = "...!";
    text[3176] = "Isso é verdade...";
    text[3177] = "O prêmio por salvar o dia é comida à vontade de graça no café! BAHAHAHAHA!";
    text[3178] = "Sério, só aproveite o momento, Bella. Somos heroínas!";
    text[3179] = "Obrigada por me animar, pessoal.";
    text[3180] = "Completamos com sucesso a missão graças ao esforço combinado de todo mundo!";
    text[3181] = "Mais 5 barras de cheesecake, por favor! Precisamos celebrar. Hehe.";
    text[3182] = "Isso aí, bebê!! É disso que eu tô falando!";
    text[3183] = "Hmmm. Este lámen é delicioso.";
    text[3184] = "A combinação de ingredientes que usaram vem em um prato elegante.";
    text[3185] = "Eu vou querer outro milkshake de morando. Ele é maravilhoso!";
    text[3186] = "Eu vou querer 6 barras de cheesecake! BAHAHAHAHA!";
    text[3187] = "Eu vou comer MAIS que você! E MAIS RÁPIDO também!";
    text[3188] = "Isso não é uma corrida, Raine!";
    text[3189] = "Se eu ganhar, você me deve um combate! Vou te arrebentar!";
    text[3190] = "...";
    text[3191] = "Combate ou quem come mais... de qualquer forma, não deixarei você me vencer.";
    text[3192] = "ISSO É O QUE VEREMOS! (NHOM, NHOM, NHOM, NHOM, NHOM)";
    text[3193] = "EU GANHEI! RÁ!!!";
    text[3194] = "Ah... Estou tão cheia...";
    text[3195] = "CHUPA ESSA MANGA! AGORA VOCÊ ME DEVE OUTRO COMBATE!";
    text[3196] = "Aqui e agora!";
    text[3197] = "Raine, você fala alto demais. Os outros clientes estão olhando.";
    text[3198] = "Tsc. Beleza. Deixa para a próxima.";
    text[3199] = "Acho que é hora de irmos para casa.";
    text[3200] = "Ficaremos mais um pouco. Preciso terminar esse lámen delicioso.";
    text[3201] = "Mande um oi para o dr. Thomas por nós!";
    text[3202] = "Certo. Vocês, se cuidem!";
    text[3203] = "Vamos voltar à Estação Espacial, Tetra. Estou meio sonolenta...";
    text[3204] = "Belezinha! Partiu!";
    text[6016] = "Saros...";
    text[6017] = "Sabe...";
    text[6018] = "Você não está facilitando para nenhum dos lados, Murktador.";
    text[6019] = "Se ao menos cooperasse...";
    text[6020] = "Não teria que restringi-lo assim.";
    text[6021] = "Seu lixo...";
    text[6022] = "Bom, é assim que cumprimenta um velho amigo?";
    text[6023] = "Não somos amigos.";
    text[6024] = "Ouça bem, Murktador... O negócio vai ser assim.";
    text[6025] = "O Cometa Coda voltou... e ele destruirá todos nós.";
    text[6026] = "Para salvar a humanidade, precisamos superar nossas limitações.";
    text[6027] = "Precisamos nos adaptar.";
    text[6028] = "Para fazê-lo, precisamos do máximo de Antinúcleos possível.";
    text[6029] = "Agora, me conte...";
    text[6030] = "Onde está escondendo os Antinúcleos?";
    text[6031] = "Se eles estiverem nas mãos da Força Lunex,";
    text[6032] = "poderemos, ao menos, fazer bom uso deles.";
    text[6033] = "Você não quer ajudar a salvar a humanidade?";
    text[6034] = "Preciso morrer do que entregar a vocês mais Antinúcleos.";
    text[6035] = "Eu me recuso a ajudá-los.";
    text[6036] = "Nesse caso...";
    text[6037] = "Vivia. Inicie a Extração de Antimatéria.";
    text[6038] = "Aaaaah!! AAAAAAAHHH!";
    text[6039] = "AAAAAAAAARRGHHHHHH!";
    text[6040] = "Se não nos contar onde eles estão escondidos...";
    text[6041] = "... Terei que extrair cada molécula de Antimatéria sua.";
    text[6042] = "Agora... Conte...";
    text[6043] = "A besta aí dentro. Sua FORMA FÁSICA.";
    text[6044] = "... NÃO! AAAAAAH!";
    text[6045] = "EU... NÃO VOU...";
    text[6046] = "Você não nos deixa outra escolha.";
    text[6047] = "A Antimatéria é a chave para salvar a humanidade.";
    text[6048] = "Você vai nos ajudar, querendo ou não...";
    text[6049] = "... Murktador.";
    text[7567] = "Bella?";
    text[7568] = "Oi, Tetra.";
    text[7569] = "Este Traje a Jato roxo...";
    text[7570] = "Esse Traje está no seu quarto faz um tempo.";
    text[7571] = "Eu o analisei há algum tempo...";
    text[7572] = "Ele é muito mais durável que o atual...";
    text[7573] = "E, também, tem mais recursos!";
    text[7574] = "Fiquei me perguntando...";
    text[7575] = "Há algum motivo para não querer usá-lo?";
    text[7576] = "Imagino que seria uma boa melhoria para o seu Traje a Jato atual e,";
    text[7577] = "depois do que vivemos durante o surto recente,";
    text[7578] = "faz sentido usar equipamentos melhores para lutar contra os Murks!";
    text[7579] = "Bom...";
    text[7580] = "Este costumava ser um dos Trajes a Jato antigos da minha mãe.";
    text[7581] = "Planejava usá-lo algum dia, mas...";
    text[7582] = "... Não acho que esteja pronta para usá-lo ainda.";
    text[7583] = "Ainda tenho muita coisa para passar e aprender.";
    text[7584] = "Claro, é um traje mais avançado que o que tenho agora...";
    text[7585] = "... Ele também parece bem maneiro.";
    text[7586] = "Roxo era a cor favorita dela...";
    text[7587] = "Mas...";
    text[7588] = "Não parece certo usá-lo...";
    text[7589] = "... Até eu me tornar uma heroína que daria orgulho de verdade para a minha mãe.";
    text[7590] = "... Até eu ser alguém capaz de proteger não só a humanidade,";
    text[7591] = "como todas as formas de vida de Luna.";
    text[7592] = "Que inclui os Murks.";
    text[7593] = "@P.@P.@P.@P.@P.@P.";
    text[7594] = "Tetra, quando o dia chegar...";
    text[7595] = "... Quando eu estiver pronta...";
    text[7596] = "Você será a primeira a saber, ok?";
    text[7597] = "Entendido! Ansiosa por isso! Hihihi.";
    text[7598] = "Vamos, precisamos descansar.";
    text[7599] = "Foi um dia longo.";
    text[7600] = "Belezinha! Também preciso recarregar!";
    text[3501] = "Foi um dia longo. Vamos dormir?";
    text[3502] = "... Vozes...";
    text[3503] = "...";
    text[3504] = "Centenas? Talvez milhares?!";
    text[3505] = "Proteja...";
    text[3506] = "O que estou lutando para proteger?";
    text[3507] = "Adormecendo...";
    text[3508] = "Parece que tem alguém aqui comigo...";
    text[3509] = "Cronos? ...";
    text[3510] = "Tudo está desaparecendo...";
    text[3511] = "Preciso saber...";
    text[3512] = "... a verdade.";
    text[3837] = "Bella, você está bem?";
    text[3838] = "Você passou a noite toda se revirando na cama!";
    text[3839] = "... Estou bem.";
    text[3840] = "Tetra, talvez eu deva conversar com meu pai sobre essas sensações estranhas que tenho sentido.";
    text[3841] = "Geralmente não gosto de preocupar nem ser um fardo para as pessoas, mas...";
    text[3842] = "Eu mesma estou começando a ficar preocupada...";
    text[3843] = "Parece que se os Murks estão me chamando, posso ouvir a voz deles...";
    text[3844] = "Você ouviu a voz do Cronos?";
    text[3845] = "Sim e algumas outras vozes também.";
    text[3846] = "Minha mãe dizia que eu tinha um dom que ninguém mais tinha.";
    text[3847] = "... Mas nunca parou para explicar.";
    text[3848] = "Sempre presumi que ela falava das minhas habilidades de luta, mas...";
    text[3849] = "Quem sabe ela estava falando de outra coisa...";
    text[3850] = "Hm... Vamos conversar com o meu pai.";
    text[3851] = "Beleza!";
    text[3862] = "Ei, meu pai está no Laboratório de Pesquisas?";
    text[3863] = "Sinto muito, senhorita Bella, no momento, seu pai está em uma conferência tecnológica";
    text[3864] = "para debater assuntos relacionados à melhoria do projeto da Celestia.";
    text[3865] = "Meu trabalho é guardar a entrada. Hahahaha.";
    text[3866] = "Ah, entendi. Obrigada pela informação!";
    text[3867] = "Hmm...";
    text[3868] = "E se você ligasse para o dr. Thomas? Aposto que ele não iria ligar.";
    text[3869] = "Ele está ocupado agora. Espero ele voltar.";
    text[3870] = "Apesar de não ter dormido bem, me sinto recarregada!";
    text[3871] = "Vamos ser produtivas e ver se há novas missões para gente!";
    text[3872] = "Ah, ok! O QUADRO DE MISSÕES fica lá embaixo, no salão 1F.";
    text[3873] = "Deveríamos conversar com a Stella primeiro! ";
    text[3874] = "Ela está encarregada de atribuir novas missões. Hehe.";
    text[3875] = "Meus pés estão me matando...";
    text[3876] = "É o Quadro de Missões da Força Lunex!";
    text[3877] = "Ei, Bella! Você parece bem animada!";
    text[3878] = "E estou! Alguma missão nova para mim?";
    text[3879] = "Você está com sorte! Tem 3 missões disponíveis!";
    text[3880] = "Maravilha!";
    text[3881] = "Vá até o QUADRO DE MISSÕES atrás de você.";
    text[3882] = "Assim que você ler uma descrição de missão, ela será automaticamente aceita!";
    text[3883] = "Você pode completar missões na ordem que bem entender!";
    text[3884] = "A partir de agora, você pode ir direto ao QUADRO DE MISSÕES";
    text[3885] = "para ver se há novas missões disponíveis!";
    text[3886] = "Boa sorte!";
    text[3887] = "Obrigada, Stella!";
    text[3888] = "Ontem, pedi algumas pelúcias on-line!";
    text[3889] = "Aaaaah, quais?";
    text[3890] = "Por enquanto é segredo. Haha. Você vai ver!";
    text[3891] = "Finalmente rastreamos uma Nave Bandida que está transportando itens roubados.";
    text[3892] = "Esses bandidos são parte de uma organização criminosa ainda maior e sua missão é";
    text[3893] = "se infiltrar na nave deles, prender os bandidos e recuperar os itens roubados.";
    text[3894] = "Um de nossos Jatos Militares foi danificado pelo ataque de um Murk nas redondezas.";
    text[3895] = "A piloto não se feriu e pousou a nave em segurança na Zona Desolada 1.";
    text[3896] = "Sua missão é ajudar a piloto a localizar e recuperar nossa carga perdida.";
    text[3897] = "O Rancho Kepler está passando por uma escassez de alimentos sem precedentes.";
    text[3898] = "Recebemos vários relatos de colheitas devastadas e desaparecidas.";
    text[3899] = "Sua missão é investigar e resolver o caso das colheitas desaparecidas.";
    text[3633] = "Mãos ao alto!";
    text[3634] = "Pela autoridade da Força Lunex, você está preso";
    text[3635] = "por fuga e posse de itens roubados!";
    text[3636] = "Ah, você é a rata suja que chega sem ser convidada.";
    text[3637] = "Está atrasada. Estamos dois passos a frente de você.";
    text[3638] = "Como assim?";
    text[3639] = "A maioria dos itens já foi transportado para outro lugar.";
    text[3640] = "Também iniciei a sequência de autodestruição desta nave.";
    text[3641] = "Vamos eliminá-la e fugir daqui antes da nave explodir!";
    text[3642] = "Droga...";
    text[3643] = "Tetra, quanto tempo temos?";
    text[3644] = "Temos que derrotar esses bandidos em menos de 10 TURNOS ou viraremos churrasquinho!";
    text[3645] = "O chefe não gosta de ratos enxeridos se metendo no nosso negócio.";
    text[3646] = "Já matei diversos Soldados Lunex na minha época...";
    text[3647] = "... e você será a PRÓXIMA!";
    text[3648] = "Eeeeee... sequência de autodestruição desativada!";
    text[3649] = "Bom trabalho, Bella! Aqueles bandidos eram só problema!";
    text[3650] = "Os reforços devem estar chegando para recuperar os itens que sobraram na nave.";
    text[3651] = "Podemos ir quando quiser! Hihi.";
    text[3900] = "Olá, sou a piloto enviou a solicitação da missão da carga perdida.";
    text[3901] = "Obrigada por me ajudar!";
    text[3902] = "Sem problemas! Pode nos dar mais detalhes em como podemos ajudá-la?";
    text[3903] = "Ok... Então, o problema não é encontrar a carga em si...";
    text[3904] = "São os potenciais perigos de ataques de Murks durante a busca.";
    text[3905] = "Colocamos dispositivos de rastreamento em todos os nossos envios.";
    text[3906] = "Há um total de 3 pacotes de carga desaparecidos.";
    text[3907] = "... E eles foram detectados em 3 Áreas de Saque separadas em Luna.";
    text[3908] = "O que é uma Área de Saque?";
    text[3909] = "Áreas de Saque foram nomeadas por caçadores de tesouros há muitos anos.";
    text[3910] = "Elas são subáreas que você pode explorar enquanto voa em sua nave.";
    text[3911] = "Não dá para dizer o que se pode encontrar em uma Área de Saque, pois todas";
    text[3912] = "estão localizadas majoritariamente em territórios não registrados de Luna.";
    text[3913] = "Você pode encontrar tesouros, masmorras e, até mesmo, Murks desconhecidos!";
    text[3914] = "Não sou forte nem habilidosa o suficiente para enfrentar um Murk, então...";
    text[3915] = "Ei! É para isso que estamos aqui! Certo, Tetra?";
    text[3916] = "Sim! Não se preocupe. Vamos encontrar a carga para você!";
    text[3917] = "Muito obrigada! As Áreas de Saque podem ser encontradas no Mapa-múndi.";
    text[3918] = "Boa sorte!";
    text[3919] = "Você encontrou o primeiro pacote desaparecido! Faltam dois!";
    text[3920] = "Você encontrou o segundo pacote desaparecido! Falta só mais um!";
    text[3921] = "Você encontrou o último pacote desaparecido!";
    text[3922] = "Vamos reportar à piloto na Zona Desolada 1!";
    text[3927] = "Espere! Não podemos ir embora sem pegar a carga!";
    text[3923] = "Ótimo! Você encontrou todos os pacotes!";
    text[3924] = "Foram difíceis de encontrar?";
    text[3925] = "Alguns dos Murks locais estavam protegendo os pacotes...";
    text[3926] = "... Mas nada que não pudéssemos dar conta. Hihi.";
    text[3928] = "De qualquer forma, o que há dentro dos pacotes?";
    text[3929] = "Peças de nave para nosso mais novo jato militar!";
    text[3930] = "A Central de Comando autorizou recompensá-la com as novas Peças de Nave!";
    text[3931] = "Conjunto de Nave Falcão obtido! Este conjunto inclui as seguintes partes:";
    text[3932] = "CHASSI FALCÃO, ASA FALCÃO e PROPULSOR FALCÃO!";
    text[3933] = "Fez um ótimo trabalho! Obrigada!";
    text[3934] = "Olá! Meu nome é Carl.";
    text[3935] = "Sou o gerente de campo aqui no Rancho Kepler.";
    text[3936] = "Prazer em conhecê-lo, Carl! Conte-nos sobre o ocorrido.";
    text[3937] = "Temos um culpado misterioso responsável pela destruição";
    text[3938] = "de 2 de nossos campos de colheita.";
    text[3939] = "Muitos setores contam conosco para ter um suprimento alimentar estável...";
    text[3940] = "Não podemos deixar mais de nossas colheitas serem devastadas...";
    text[3941] = "Não se preocupe, Carl. Deixa com a gente!";
    text[3942] = "Daremos nosso melhor para resolver a situação o mais rápido possível.";
    text[3943] = "Há algum animal nesta fazenda?";
    text[3944] = "Não há animais aqui. Eles são mantidos em outra fazenda.";
    text[3945] = "Hmm... Se não é um animal, então...";
    text[3946] = "No que está pensando, Bella?";
    text[3947] = "Isso pode soar besta, mas...";
    text[3948] = "Tetra, você pode conferir o banco de dados sobre a existência";
    text[3949] = "de Murks consumindo outras coisas que não humanos?";
    text[3950] = "Belezinha! Dê-me 2 milissegundos...";
    text[3951] = "Pronto!";
    text[3952] = "Eis o que encontrei:";
    text[3953] = "Para que Murks recuperem suas reservas de Antimatéria,";
    text[3954] = "eles podem consumir antimatéria de alta-densidade ou";
    text[3955] = "formas de vida orgânicas devido à alta concentração de Lux presente.";
    text[3956] = "Hmm... Plantas e colheitas são consideradas formas de vida orgânicas.";
    text[3957] = "Então acha que um Murk está destruindo nossas colheitas?";
    text[3958] = "É possível. Houve relatos de Murks sendo vistos ultimamente?";
    text[3959] = "Não que eu saiba.";
    text[3960] = "Devido à nossa baixa densidade populacional, raramente surgem Murks aqui...";
    text[3961] = "Entendi...";
    text[3962] = "Por questão de segurança, espere por nós aqui.";
    text[3963] = "Tetra, vamos procurar pistas.";
    text[3964] = "Claro! Sherlock-Tetra está pronta!";
    text[3965] = "Não podemos arriscar perder mais das nossas colheitas...";
    text[3966] = "Por favor, investigue e conte-me o que aconteceu.";
    text[3967] = "Há arbustos de menta nascendo nesta área.";
    text[3968] = "O culpado deve gostar mesmo de menta, hein!?";
    text[3969] = "Um Murk que ama menta... Isso é novidade.";
    text[3970] = "Ei, veja! Há pegadas aqui! Parecem cascos de javali...";
    text[3971] = "Tetra, escaneie essas pegadas.";
    text[3972] = "Hm. Há diversos Murks que poderiam deixar uma pegada assim.";
    text[3973] = "Precisamos buscar mais pistas para restringir as opções.";
    text[3974] = "Se pudermos identificar a espécie exata de Murk,";
    text[3975] = "saberemos exatamente o que vamos enfrentar...";
    text[3977] = "Há muito solo fofo e buracos aqui.";
    text[3978] = "Nosso culpado pode estar usando buracos de minhoca para comer as colheitas e fugir.";
    text[3979] = "Precisamos ter cuidado, só por precaução.";
    text[3980] = "Há marcas de mordida neste barris de aço!";
    text[3981] = "O que o rótulo do barril diz?";
    text[3982] = "Ingredientes crus para Mentas de Batalha...";
    text[3983] = "Hmm...";
    text[3984] = "Simulei a mandíbula do que poderia ter causado essas marcas de mordida.";
    text[3985] = "Parece que corresponde à mandíbula de um jacaré...";
    text[3986] = "Mas não pode ser um jacaré... Eles foram extintos!";
    text[3987] = "ECA! O QUE É AQUILO?";
    text[3988] = "Parece algum tipo de pele solta pegajosa...";
    text[3989] = "Precisarei de tempo para fazer uma análise aprofundada disso.";
    text[3990] = "Parece haver traços de antimatéria na pele.";
    text[3991] = "ECA, ECA, ECA!! Você carrega isso!";
    text[3992] = "Ok, acho que essas são todas as pistas que pudermos encontrar...";
    text[3993] = "O que sabemos até agora?";
    text[3994] = "Vamos ver... Cabeça de jacaré...";
    text[3995] = "Cascos de javali...";
    text[3996] = "Ama menta por algum motivo...";
    text[3997] = "Solta pele como um réptil!";
    text[3998] = "Ah!";
    text[3999] = "Parece que temos um vencedor!";
    text[4000] = "Há um Murk no banco de dados da Força Lunex que corresponde com as nossas pistas!";
    text[4001] = "CODINOME: KAPROSSAURO!";
    text[4002] = "Maravilha! Bom trabalho, Tetra!";
    text[4003] = "Hihi.";
    text[4004] = "Tive uma ideia...";
    text[4005] = "Vamos atrair o Kaprossauro com uma Menta de Batalha. Hihi.";
    text[4006] = "Acha mesmo que isso vai funcionar?";
    text[4007] = "Precisamos tentar.";
    text[4008] = "Vamos atrás de uma Menta de Batalha e aí voltamos aqui.";
    text[4009] = "Não acho que esteja funcionando...";
    text[4010] = "Precisa funcionar! Não tenho outras pistas!";
    text[4011] = "Ahn?!";
    text[4012] = "O que aconteceu?";
    text[4013] = "Estou detectando um Murk!";
    text[4014] = "Culpado encontrado!";
    text[4015] = "Hm... Bella, o Kaprossauro parece super inquieto...";
    text[4016] = "Acho que podemos tê-lo agitado!";
    text[4017] = "Cuidado! Ele pode nos atacar a qualquer momento!";
    text[4018] = "Não se preocupe. Eu cuido disso!";
    text[4019] = "O Kaprossauro escapou!";
    text[4020] = "Tudo bem.";
    text[4021] = "Agora que confirmamos que o culpado é um Murk,";
    text[4022] = "a Central de Comando terá que enviar mais guardas de patrulha para o Rancho Kepler.";
    text[4023] = "Ah, verdade!";
    text[4024] = "Vamos falar com o Carl!";
    text[4025] = "Pelas estrelas, o culpado era um Murk esse tempo todo??";
    text[4026] = "Sim, mas não precisa mais se preocupar. Nós o afugentamos por ora.";
    text[4027] = "Enviarei uma requisição de mais soldados da Força Lunex para ajudar";
    text[4028] = "a proteger as colheitas de futuros Kaprossauros famintos.";
    text[4029] = "Muito obrigado por salvar nossa fazenda!";
    text[4030] = "Fique com isso como meu agradecimento.";
    text[4032] = "Um Murk que ama comer menta... Isso é algo raro de ver!";
    text[4103] = "Opa. O Dr. Thomas está ligando!";
    text[4104] = "Bella! Me contaram que você estava me procurando.";
    text[4105] = "Sinto por não estar disponível... Havia questões importantes que eu precisava resolver.";
    text[4106] = "Pai, preciso conversar algo sério. Você está ocupado?";
    text[4107] = "Acabei de passar um café! Estou com tempo.";
    text[4108] = "Está tudo bem?";
    text[4109] = "Sim... Explicarei tudo quando nos encontrarmos.";
    text[4110] = "Tetra, vamos nos encontrar com o meu pai no Laboratório de Pesquisas.";
    text[4111] = "Belezinha!";
    text[4112] = "Bella explica ao dr. Thomas as sensações estranhas que tem tido";
    text[4198] = "e toda a verdade sobre o encontro dela com Cronos, no Reino Fantasma...";
    text[4113] = "Você devia ter conversado comigo antes sobre isso, Bella.";
    text[4114] = "Eu sei... Não achei que era um problema até começar a ouvir vozes...";
    text[4115] = "Pai, estou preocupada... Vou ficar bem?";
    text[4116] = "Você ficará bem, sim. Não precisa se preocupar.";
    text[4199] = "'Proteja'...";
    text[4148] = "Quem sabe seja um sentimento compartilhado por muitos Murks.";
    text[4153] = "Nunca considerei que os Murks poderiam ter medo de nós...";
    text[4149] = "Estamos, aos poucos, aniquilando a espécie deles para salvar a nossa.";
    text[4150] = "Quem sabe eles queiram que Bella os proteja?!";
    text[4151] = "... Mas por que eu?";
    text[4152] = "Quem sabe seja por ser a única capaz de se comunicar com eles.";
    text[4117] = "Não acho que seja uma habilidade hereditária, mas parece que sua mãe estava certa.";
    text[4118] = "Certa sobre o quê? O que você e minha mãe esconderam de mim?";
    text[4119] = "Sinto muito não contar antes. Não! Não contei nada a eles!";
    text[4120] = "Parece que você tem uma capacidade inata de manipular sua Lux.";
    text[4121] = "... Uma capacidade que sua mãe também tinha.";
    text[4122] = "Manipulação de Lux? A pesquisa da minha mãe dizia que era só uma teoria!";
    text[4123] = "Era... até ela descobrir que era capaz de usá-la.";
    text[4124] = "Sua mãe era uma cientista antes de se tornar a general.";
    text[4125] = "Meu campo de pesquisa foi em torno da Antimatéria e o da Thea, em torno de Lux.";
    text[4126] = "É fato que almas existem.";
    text[4127] = "Nossa tecnologia atual permite que a meçamos... e a quantifiquemos até certo ponto.";
    text[4128] = "Lux é essencialmente a manifestação da força de vontade e da alma na forma de energia.";
    text[4129] = "Ela pode crescer e mudar, dependendo do estado emocional e físico do usuário.";
    text[4130] = "Sua mãe suspeitava que, se ela aprendesse a controlar a Lux dela,";
    text[4131] = "ela poderia ser capaz de se comunicar com os Murks...";
    text[4132] = "Após ela morrer, não tínhamos como confirmar suas teorias...";
    text[4133] = "Não temos tempo a perder até minha Lux se mostrar novamente!";
    text[4134] = "Como posso controlá-la? Minha mãe falou alguma coisa?";
    text[4135] = "Queria saber...";
    text[4136] = "Há segredos que sua mãe mantinha de mim também...";
    text[4137] = "O motivo de ela guardar essas coisas da gente...";
    text[4138] = "Conhecendo sua mãe... Provavelmente, era para nos proteger.";
    text[4139] = "Proteger do quê?";
    text[4140] = "Não sei... Preciso de outro café. Meu cérebro está derretendo.";
    text[4141] = "(Preciso descobrir o que minha mãe descobriu sobre os Murks...)";
    text[4142] = "(Não vou desistir.)";
    text[4143] = "Quem sabe alguém lá fora saiba o que ela sabia...";
    text[4144] = ".... .... ....!";
    text[4145] = "O Murktador!";
    text[4146] = "Quando nos falamos em Copernicus, ele disse que conhecia a minha mãe.";
    text[4147] = "Precisamos falar com ele novamente!";
    text[4155] = "Bella, você deveria ficar aqui...";
    text[4156] = "Por quê? Ficar sentada não vai me levar a lugar algum!";
    text[4157] = "Não podemos deixar que saibam sobre sua capacidade inata...";
    text[4158] = "Sua mãe a manteve em segredo por um motivo. Devemos confiar na decisão dela.";
    text[4159] = "Você se saiu bem até agora. Deixe que a Força Lunex cuide do resto.";
    text[4160] = "Vamos obter os antinúcleos do Murktador e logo a Celestia estará completa.";
    text[4161] = "O Cometa Coda não terá qualquer chance. O Povo de Luna ficará a salvo.";
    text[4162] = "... Por que está me olhando assim?";
    text[4163] = "Você está escondendo alguma coisa.";
    text[4164] = "Não estou. Vou pegar outro café...";
    text[4165] = "Sua feição mudou quando mencionei o Murktador.";
    text[4166] = "Pai, por favor, me conte o que está acontecendo.";
    text[4167] = "Pare de tentar me proteger como minha mãe sempre fez.";
    text[4168] = "Sou capaz de cuidar de mim mesma!";
    text[4169] = "... Após minha conferência, parei na Base Militar para conversar com Saros.";
    text[4170] = "Perguntei o que ele pretendia fazer com o Murktador...";
    text[4171] = "Se o Murktador não abrisse mão dos Antinúcleos que guardou...";
    text[4172] = "Saros poderia ter que extrair a Antimatéria diretamente do próprio Murktador.";
    text[4173] = "Esse processo... provavelmente o matará.";
    text[4174] = "N-não! Não podemos deixar Saros fazer isso!";
    text[4175] = "É cruel! Não concordo com isso!";
    text[4176] = "Não concordo com a decisão dele também, mas... que escolha eu tenho?";
    text[4177] = "Como pai, preciso proteger minha família...";
    text[4178] = "Fazer algo que vai contra a Força Lunex nos colocaria em risco.";
    text[4179] = "Pai, precisamos convencer Saros a não fazer isso!";
    text[4180] = "Eu já tentei...";
    text[4181] = "Saros está determinado a fazer o que achar necessário para salvar a humanidade.";
    text[4182] = "Mesmo se isso custar a vida do Murktador.";
    text[4183] = "Não... Preciso de outra chance de conversar com o Murktador...";
    text[4184] = "Quem sabe eu possa finalmente convencê-lo a nos contar onde os Antinúcleos estão!";
    text[4200] = "Pai, por favor... ... ...";
    text[4185] = ".... .... ....";
    text[4186] = "... (suspiro) Se eu disser não, você provavelmente irá mesmo assim.";
    text[4187] = "Tome isto.";
    text[4189] = "A Chave Lunex lhe concede a autoridade de entrar na Base Militar e no Complexo Carcerário.";
    text[4190] = "Por favor, tome cuidado. Estou torcendo por você!";
    text[4191] = "Obrigada, pai.";
    text[4192] = "Sabia que podia contar com você!";
    text[4193] = "Falarei com Saros depois.";
    text[4194] = "Se alguém pode ganhar a confiança do Murktador, esse alguém é você.";
    text[4195] = "Bella, por favor, não faça nada imprudente...";
    text[4196] = "Não se preocupe, pai. Não irei.";
    text[4197] = "Vamos para a Base Militar, Tetra! Ela fica na Zona Desolada!";
    text[4205] = "Sinto cheiro de missão nova! Conte comigo!";
    text[4207] = "Certo, Tetra. Essa missão não é uma missão qualquer.";
    text[4208] = "Não é?";
    text[4209] = "Não. É uma missão furtiva.";
    text[4210] = "Não quero que Saros descubra que estamos aqui...";
    text[4211] = "Meu pai disse que ele fará o que for preciso para cumprir seus objetivos.";
    text[4212] = "Ele vai me impedir se eu der motivos...";
    text[4213] = "... e também não sou forte o suficiente para enfrentá-lo.";
    text[4214] = "Precisamos passar despercebidas o máximo possível.";
    text[4215] = "Quer mesmo fazer isso, Bella?";
    text[4216] = "Se formos pegas...";
    text[4217] = "Não seremos pegas. Tenho minha fiel escudeira comigo. Hehe.";
    text[4218] = "Verdade. Hihi. Super Escudeira Furtiva Tetra está animada e pronta!";
    text[4219] = "Tetra, por acaso você tem arquivos sobre o QG Lunex no seu banco de dados?";
    text[4220] = "Se eu disser que sim, estarei encrencada?";
    text[4221] = "Não, bobinha.";
    text[4222] = "Ufa!";
    text[4223] = "Geralmente, você me dá sermão quando baixo informações secretas sem permissão.";
    text[4224] = "Não desta vez. Sua mania de acumular dados vai ser bem útil!";
    text[4225] = "Belezinha! Dê-me 2 milissegundos...";
    text[4226] = "Pronto! O que quer saber?";
    text[4227] = "Há algum outro caminho para o complexo carcerário além da entrada principal?";
    text[4228] = "De acordo com as Plantas Baixas da Base Militar, há uma antiga escotilha de acesso";
    text[4229] = "que podemos usar na Área de Esgotos, que está ligada ao Complexo Carcerário!";
    text[4230] = "Eca, eca, eca! Você disse Área de Esgoto?";
    text[4231] = "Sim!";
    text[4232] = "Por favor, diga que há OUTRO caminho...";
    text[4233] = "Não!";
    text[4234] = "Droga... Terei que lavar meu Traje a Jato mais tarde...";
    text[4235] = "Beleza! Vamos para a Área de Esgoto! (Que nojo!)";
    text[4241] = "Entramos!";
    text[4242] = "O Murktador deve estar em uma das celas aqui.";
    text[4243] = "Estranho...";
    text[4244] = "O que foi?";
    text[4245] = "Não há prisioneiros aqui.";
    text[4246] = "... e está estranhamente silencioso por aqui.";
    text[4247] = "Vamos ficar atentas e continuar avançando.";
    text[4249] = "Esta deve ser a cela do Murktador.";
    text[4250] = "Como sabe?";
    text[4251] = "Parece ser a mais difícil de se escapar.";
    text[4252] = "Tetra, acha que consegue abrir esta fechadura eletrônica?";
    text[4253] = "Hmm...";
    text[4254] = "Não consigo abrir a fechadura daqui.";
    text[4255] = "Precisamos encontrar o painel de controle que está ligado a esta porta.";
    text[4256] = "Certo. Vamos atrás do painel de controle!";
    text[4257] = "ASSINATURA DE TRAJE A JATO NÃO AUTORIZADA DETECTADA.";
    text[4258] = "INFORME SEU PROPÓSITO.";
    text[4259] = "Ah, não. É um robô de segurança! O que faremos?";
    text[4260] = "Não há para onde fugir! ";
    text[4261] = "Precisamos eliminá-lo antes que cheguem reforços! ";
    text[4262] = "AMEAÇA DETECTADA.";
    text[4263] = "MODO DE BATALHA ATIVADO.";
    text[4264] = "Por aqui! O sinal veio desta direção!";
    text[4265] = "Ah não! Dois guardas estão vindo em nossa direção!";
    text[4266] = "Se esconda!";
    text[4267] = "*bum!* *pá!*";
    text[4268] = "Desculpa...";
    text[4269] = "Tetra, confira os sinais vitais deles.";
    text[4270] = "Eles ficarão bem.";
    text[4271] = "Eles estão só tirando um cochilinho. Hihi.";
    text[4272] = "Eles viram nossos rostos...";
    text[4273] = "Agora não tem mais volta...";
    text[4274] = "Vamos continuar.";
    text[4275] = "Espere! Tive uma ideia.";
    text[4276] = "Tetra, você é genial!";
    text[4277] = "Hihi. Conte-me algo que eu não saiba.";
    text[4305] = "Trajes a Jato são à prova d'água e herméticas! No meu caso, só preciso inflá-la,";
    text[4306] = "estender alguns componentes robóticos e tã-dã! Temos o disfarce perfeito. Hehe.";
    text[4278] = "Com esses Trajes a Jato, não acionaremos mais robôs de segurança.";
    text[4279] = "Hehe. Certo! Vamos nessa. O painel de controle deve estar à frente.";
    text[4280] = "Ele não está aqui?";
    text[4281] = "Talvez essa não seja a cela dele...";
    text[4282] = "Não, definitivamente é onde o mantinham.";
    text[4283] = "A Holotecnologia da Vivia está integrada a esta cela para evitar que ele escape.";
    text[4284] = "Então ele fugiu magicamente ou...";
    text[4285] = "... Ó não!";
    text[4286] = "Precisamos nos apressar!";
    text[4287] = "Eles provavelmente o levaram para uma sala onde possam extrair a antimatéria dele.";
    text[4288] = "Vamos ter que nos infiltrar na Base Militar para encontrá-lo.";
    text[4289] = "Já temos nossos disfarces, então, finalmente, podemos olhar por aí sem levantar suspeitas.";
    text[4290] = "Há um elevador que podemos usar para chegar à Base Militar. Vamos encontrá-lo!";
    text[4301] = "A porta da cela já deve estar destrancada!";
    text[4302] = "Espere, o elevador logo acima leva à Base Militar!";
    text[4303] = "Não vamos lá agora.";
    text[4304] = "Este soldado está inconsciente...";
    text[4308] = "Ei!";
    text[4309] = "Está tudo bem?";
    text[4310] = "O que aconteceu com o robô de segurança? Por que ele nos enviou um sinal de ameaça?";
    text[4311] = "Hmm... É... Parece que um rato acionou o alarme de segurança do robô.";
    text[4312] = "Recalibramos o robô de segurança só por garantia";
    text[4313] = "para que não envie um alarme falto na próxima vez!";
    text[4314] = "Caramba. Não fazia ideia de que sabiam consertar robôs.";
    text[4315] = "Precisam me ensinar qualquer dia desses.";
    text[4316] = "De qualquer forma, não acontece muita coisa por aqui.";
    text[4317] = "Ei, posso fazer uma pergunta?";
    text[4318] = "Claro!";
    text[4319] = "Eu... hm... Acabei de voltar das minhas férias então estou um pouco desatualizado.";
    text[4320] = "O que aconteceu com todos os prisioneiros?";
    text[4321] = "Ah, aparentemente, todos foram transferidos para outra instalação.";
    text[4322] = "Sabe o motivo?";
    text[4323] = "Nem ideia. Só sei que foram ordens do General Saros.";
    text[4324] = "Entendi. Obrigado!";
    text[4325] = "Vamos... hm...";
    text[4326] = "... continuar patrulhando a área para... hm... pegar o rato.";
    text[4327] = "Claro, continuem.";
    text[4328] = "Ufa... Não acredito que isso funcionou.";
    text[4330] = "De acordo com as Plantas Baixas da Base Militar, este andar foi projetado";
    text[4331] = "com medidas de segurança para dificultar a fuga de prisioneiros!";
    text[4332] = "Não brinca?! Não esperava ter que lidar com lasers e um fosso da morte hoje...";
    text[4333] = "Bom... Nada que não consigamos dar conta. Hehe.";
    text[4372] = "Aqui deve ser onde Vivia cria sua Holotecnologia.";
    text[4373] = "Hmm...";
    text[4374] = "Tetra, consegue escanear o computador dela?";
    text[4375] = "Veja se consegue encontrar alguma informação sobre como a Holotecnologia funciona.";
    text[4376] = "Claro! Mas deve levar algum tempo...";
    text[4377] = "Enquanto isso, posso saber o motivo?";
    text[4378] = "É parte do meu plano.";
    text[4379] = "Achei que o plano era conversar com o Murktador.";
    text[4380] = "Esse ainda é o plano...";
    text[4381] = "... mas temos que ganhar a confiança dele primeiro.";
    text[4382] = "Para isso...";
    text[4383] = "... Acho que devemos ajudá-lo a fugir daqui.";
    text[4384] = "AHN?! Você tem certeza disso, Bella?";
    text[4385] = "Estaremos indo contra a Força Lunex!";
    text[4399] = "Seremos taxadas como criminosas...";
    text[4386] = "Lidarei com as consequências depois.";
    text[4387] = "Salvar a humanidade é mais importante.";
    text[4388] = "Se eu ajudá-lo a escapar, talvez ele acabe se abrindo conosco.";
    text[4389] = "Ok... Se tudo bem para você, tudo bem para mim.";
    text[4390] = "Vou apoiá-la, não importa o motivo.";
    text[4391] = "Isso é o que Super Escudeiras fazem. Hihi.";
    text[4392] = "Ah! Escaneamento concluído!";
    text[4393] = "Fui capaz de descriptografar um arquivo oculto do computador dela.";
    text[4394] = "A Holotecnologia da Comandante Vivia é controlada por um programa personalizado.";
    text[4395] = "Encontrei uma senha especial que pode contornar o programa e desativar a Holotecnologia dela.";
    text[4396] = "Maravilha! Salve essa senha. Talvez venha a ser útil!";
    text[4397] = "Obrigada por sempre me apoiar, Tetra.";
    text[4398] = "Pode me chamar de Rebelde Militar Tetra agora. Hihi.";
    text[4412] = "O que fizeram com ele? ...";
    text[4413] = "Ele está inconsciente... Os sinais vitais parecem normais.";
    text[4416] = "(Então esse é o rosto dele...)";
    text[4417] = "(Para falar a verdade, ele...)";
    text[4418] = "(... até que é bonitinho.)";
    text[4294] = "(Droga. Temos companhia. É a Vivia!)";
    text[4295] = "(O que faremos agora?)";
    text[4296] = "(Não se preocupe. Deixa comigo.)";
    text[4297] = "(Não, espera. Ela vai reconhecer sua voz. Deixa comigo!)";
    text[4298] = "(Espera... O quê??)";
    text[4414] = "O que estão fazendo aqui? Vocês não deviam estar aqui.";
    text[4299] = "Perdão, comandante Vivia. Estávamos procurando por você.";
    text[4300] = "(Aaaah. Ela está usando um modulador de voz!) ";
    text[4400] = "O general Saros solicitou falar com você pessoalmente.";
    text[4401] = "É... urgente.";
    text[4402] = "Ele também nos enviou para proteger a sala no caso de o Murktador acordar.";
    text[4403] = "Entendi.";
    text[4404] = "Obrigada por me informar.";
    text[4415] = "Com licença.";
    text[4405] = "Ufa. Essa foi por pouco.";
    text[4406] = "Pelo menos não era o Saros.";
    text[4407] = "Ele tem uma percepção bem afiada. Teria visto por trás do nosso disfarce.";
    text[4408] = "Falando em Saros, fico surpresa que não esbarramos com ele.";
    text[4409] = "Realmente é um pouco estranho... O que está que ele está tramando?";
    text[4410] = "De qualquer forma... Tetra, você consegue desativar a Holotecnologia?";
    text[4419] = "Mole que nem pudim! Só preciso ativar o protocolo de desligamento, inserir a senha e...";
    text[4420] = "Pronto!";
    text[4421] = "Ei! Você precisa acordar.";
    text[4422] = "Murktador, acorde!";
    text[4423] = "Ah...";
    text[4424] = "Essa voz...";
    text[4425] = "... Bella?!";
    text[4426] = "Sim, eu mesma. Vim tirá-lo daqui.";
    text[4427] = "Sério?! Por quê?";
    text[4428] = "... Porque você é teimoso.";
    text[4429] = "Você prefere morrer do que contar ao Saros onde os antinúcleos estão.";
    text[4430] = "...";
    text[4431] = "Não acho que você seja uma pessoa ruim. Você não merece morrer.";
    text[4432] = "Hunf. Você não me conhece e não sabe o que eu fiz.";
    text[4433] = "Mesmo assim, estou disposta a ajudá-lo...";
    text[4434] = "... porque é o certo a se fazer.";
    text[4435] = "Vamos, Murktador. Temos que sair daqui o mais rápido possível!";
    text[4436] = "Pare de me chamar de Murktador.";
    text[4437] = "Meu nome é Nickle.";
    text[4438] = "Nickle, você consegue andar?";
    text[4439] = "Vou ficar bem. Só estou um pouco zonzo, mas ainda posso lutar se precisar.";
    text[4440] = "Você sai primeiro. Estarei logo atrás de você.";
    text[4441] = "Não confia em mim?";
    text[4442] = "Eu não confio em ninguém.";
    text[4443] = "Como sei que não vai nos atacar pelas costas e fugir?";
    text[4444] = "Não vou.";
    text[4445] = "Então está dizendo que devo confiar em você?";
    text[4446] = "... Preciso perguntar algo importante depois. É importante.";
    text[4447] = "Por mais que eu odeie admitir...";
    text[4448] = "Preciso da sua ajuda...";
    text[4449] = "Beleza! Então temos um acordo.";
    text[4450] = "Precisamos trabalhar juntos se quisermos fugir.";
    text[4451] = "Bella, Tetra e Nickle! Parceiros no crime!";
    text[4452] = "Os Três Mosqueteiros Lunares! Hihi.";
    text[4453] = "Sua robô é sempre chata assim?";
    text[4454] = "Essa robô chata foi quem o libertou da Holotecnologia, tá? Muito de nada!";
    text[4455] = "Você me deve uma. Hunf.";
    text[4456] = "... Que seja. Vamos.";
    text[4511] = "NICKLE SE JUNTOU AO GRUPO!";
    text[4457] = "AVISO - ISOLAMENTO INICIADO";
    text[4458] = "O MURKTADOR ESTÁ TENTANDO ESCAPAR. IMPEÇA-O IMEDIATAMENTE!";
    text[4459] = "Credo... Há guardas por todos os lados!";
    text[4460] = "Não há para onde fugir!";
    text[4461] = "Siga minha deixa.";
    text[4462] = "Ahn?!";
    text[4463] = "PULEM!";
    text[4513] = "Ai... Você não bate bem da cabeça, sabia?";
    text[4464] = "Que piso é este?";
    text[4465] = "Primeiro piso. A saída está perto.";
    text[4466] = "ALVO DETECTADO. INICIANDO MODO DE BATALHA... AGUARDANDO RESPOSTA DO ALVO.";
    text[4467] = "Tsc. Outro robô chato.";
    text[4468] = "Ei! Tem um piloto dentro, tá?";
    text[4514] = "Não devemos feri-lo caso possamos evitar.";
    text[4515] = "Bella, preciso que vocês ganhem tempo para mim enquanto desativo as portas com lasers!";
    text[4469] = "Vou ensinar a não cruzarem meu caminho.";
    text[4516] = "...";
    text[4470] = "Você vai ficar só aí ou vai lutar comigo?";
    text[4471] = "Bella, você tomou uma decisão quando escolheu me ajudar a escapar.";
    text[4472] = "Agora, mesmo se o mundo inteiro esteja contra você... você precisará lutar.";
    text[4473] = "... Do contrário, tudo isso terá sido em vão.";
    text[4474] = "Você não pode mudar o mundo ou buscar as respostas que procura";
    text[4475] = "se estiver presa em uma cela inútil.";
    text[4476] = "... Certo. Beleza.";
    text[4477] = "Vamos nos preparar para a batalhar!";
    text[4478] = "Bem melhor! Isso aí!";
    text[4479] = "Desativei a porta com lasers! A saída é por aqui. Vamos!";
    text[4480] = "Eles pegaram nossa nave... Como vamos fugir?";
    text[4481] = "Teremos que ir a pé.";
    text[4482] = "Há um esconderijo na Colônia Sílica para onde podemos ir.";
    text[4483] = "Ele fica ao norte. Bem longe de onde estamos...";
    text[4484] = "Tem algum esconderijo próximo que a Força Lunex não conheça?";
    text[4485] = "... Não.";
    text[4486] = "Então devemos ir para a Colônia Sílica.";
    text[4487] = "Primeiro, vamos a oeste.";
    text[4488] = "A trilha adiante deve nos levar para a Cratera da Escuridão Eterna.";
    text[4489] = "Passaremos pelas erosões mais escuras da cratera para evitar sermos vistos.";
    text[4490] = "Certo. Vamos nessa!";
    text[4492] = "Vivia!";
    text[4493] = "Tsc, tsc. Você me desapontou, Bella.";
    text[4494] = "...";
    text[4498] = "Parece que Saros estava certo sobre sua traição iminente.";
    text[4520] = "A princípio, não quis acreditar.";
    text[4499] = "Sua lealdade à Força Lunex sempre pareceu incorruptível... até agora.";
    text[4521] = "Sinto muito... Eu só...";
    text[4522] = "Preciso fazer isso. Esse é o caminho que escolhi.";
    text[4523] = "Na base... Você sabia que éramos nós, né?";
    text[4495] = "Soube que vocês haviam invadido nosso QG no momento que sua robozinha";
    text[4496] = "desligou a rede de esgotos.";
    text[4497] = "Hihihi. Acho que a Vivia é mais perceptiva do que achávamos.";
    text[4500] = "Tinha a esperança de que você extrairia as informações de que precisamos do Murktador,";
    text[4501] = "mas, em vez disso, decidiu conspirar contra nós.";
    text[4524] = "Vivia...";
    text[4526] = "Vejo que o Murktador está calado como sempre.";
    text[4530] = "... Tsc.";
    text[4527] = "Quem sabe minha presença esteja relembrando a dor do passado? ...";
    text[4531] = "... Ou quem sabe seja só medo? Ohohoho!";
    text[4528] = "Afinal de contas, eu adorei vê-lo sofrer...";
    text[4529] = "... Pelo bem da ciência, é claro.";
    text[4532] = "... Você me enoja.";
    text[4502] = "Não vou tolerar sua desobediência!";
    text[4503] = "Se meus Exoesqueletos não puderem pará-lo, terei que dar um fim a você com minhas mãos.";
    text[4525] = "ATIVAR HOLOTRAJE!";
    text[4504] = "Vivia, não precisamos chegar a esse ponto. Não podemos resolver isso sem lutar?";
    text[4505] = "Quão tola e inocente...";
    text[4539] = "Você subestima quão forte a Comandante da Força Lunex realmente é.";
    text[4540] = "Aaaah! Não gosto nada disso!";
    text[4541] = "... Algo está afetando seu julgamento, Vivia.";
    text[4542] = "Em todos esses anos que a conheço... ";
    text[4543] = "Você nunca foi fria e calculista assim quando minha mãe estava viva...";
    text[4544] = "Você mudou.";
    text[4545] = "CALADA!";
    text[4546] = "Estou fazendo o que precisa ser feito para garantir que Saros consiga salvar a humanidade.";
    text[4547] = "O Murktador é a chave para conseguir isso.";
    text[4548] = "A conversa acaba aqui. Vamos para a diversão!";
    text[7601] = "Isso não acaba aqui! Não deixarei que escapem!";
    text[7602] = "Holocampo, ativar!";
    text[7613] = "Parece que eu ganhei. Agora, sejam bons prisioneiros enquanto chamo reforços.";
    text[7603] = "Droga... É a mesma barreira que ela usou em mim em Copernicus...";
    text[7604] = "Estamos presos...";
    text[7605] = "Tetra, alguma ideia?";
    text[7615] = "Hmm. Deixe-me escanear...";
    text[7606] = "... Parece que Saros e Vivia não estavam blefando.";
    text[7616] = "Se o Holocampo chegar a determinado nível de energia por dentro,";
    text[7617] = "ele implodirá... E nos matará no processo.";
    text[7607] = "... A menos que...";
    text[7608] = "Liberemos energia o suficiente para sobrepujar o Holocampo.";
    text[7609] = "Nickle, e se você se transformar em...";
    text[7610] = "NÃO!";
    text[7611] = "Minha Forma Fásica é perigosa demais.";
    text[7612] = "Você não entende...";
    text[7618] = "Quando deixo minha antimatéria me consumir...";
    text[7619] = "... minha mente corre o risco de ser consumida também.";
    text[7620] = "É uma forma que não uso a não ser que seja absolutamente necessário.";
    text[7621] = "Bom, parece que esta é uma situação 'absolutamente necessária'!";
    text[7622] = "Por favor, Nickle...";
    text[7623] = "Rápido! Vivia está voltando!";
    text[7624] = "Tsc@P.@P.@P.@P.@P.@P.@P.@P.@P.";
    text[7625] = "Ok, ok. Deixa comigo.";
    text[7626] = "... Mas se você acabar se machucando...";
    text[7627] = "Vai logo!";
    text[7628] = "RAAAAAIÁÁÁ!";
    text[7629] = "Impossível! Como vocês...";
    text[4507] = "Ela está imobilizada!";
    text[4508] = "Essa é nossa chance! Vamos dar o fora daqui!";
    text[7630] = "Nickle, sua Forma Fásica... foi incrível!";
    text[7631] = "Pensei que você não pudesse controlá-la!";
    text[7632] = "Olha, não gosto de usá-la...";
    text[7633] = "... e nem sempre é fácil de controlar...";
    text[7634] = "É... complicado.";
    text[7635] = "Isso é tudo que precisa saber. A conversa acaba aqui.";
    text[7636] = "Beleza...";
    text[7637] = "Vamos sair daqui antes que os reforços cheguem.";
    text[7638] = "MODO FÁSICO DESBLOQUEADO!";
    text[7639] = "Esta forma dura 3 turnos e concede a Nickle um aumento de 2x PDR para suas Habilidades ativas!";
    text[7640] = "Nesta forma, os ataques dos inimigos com 50 de DANO ou menos são anulados!";
    text[4509] = "Ali! Vamos pegar aquela nave!";
    text[4510] = "Não os deixem escapar!";
    text[4567] = "Nunca vi esse tipo de nave antes.";
    text[4568] = "De acordo com meu banco de dados, esta é uma Nave Cápsula!";
    text[4569] = "É um modelo antigo de aeronave da Força Lunex que foi descontinuada há anos.";
    text[4570] = "Parece que abandonaram um monte delas nesta área.";
    text[4571] = "Tetra, acha que consegue dar partida nessa nave?";
    text[4572] = "Posso tentar...";
    text[4573] = "Vamos torcer para que a bateria ainda tenha alguma carga...";
    text[4574] = "Funcionou! Hihi.";
    text[4575] = "Certo! Vamos dar o fora daqui. Precisamos seguir para o norte.";
    text[4579] = "Aí estão eles! Não os deixem fugir!";
    text[4580] = "Ah, droga! Os reforços estão vindo para cá!";
    text[4581] = "Rápido! Entrem na nave!";
    text[4585] = "Está apertado aqui...";
    text[4586] = "É, esqueça o mencionei antes...";
    text[4587] = "As Naves Cápsulas foram projetadas tipicamente para uma única pessoa... Hihihi.";
    text[4582] = "Projéteis de fótons detectados!";
    text[4553] = "Você errou! O que está esperando?? Continue atirando deles!";
    text[4554] = "... Mas, comandante... Saros nos instruiu para capturá-los com vida.";
    text[4555] = "Eles não serão derrotados tão facilmente.";
    text[4556] = "Nosso objetivo é atrasá-los... E arrancar todos os seus recursos...";
    text[4557] = "... Até que percam toda a esperança de retaliação contra nós.";
    text[4558] = "S-sim, comandante! Canhões de Fótons ajustados para força máxima!";
    text[4589] = "CONTROLE A NAVE E DESVIE DOS PROJÉTEIS EM SUA DIREÇÃO!";
    text[4590] = "Ficaram comendo poeira! Bela pilotagem, Bella! ";
    text[4591] = "Obrigada. Hihi.";
    text[4592] = "Nossos problemas ainda não chegaram ao fim.";
    text[4593] = "A bateria da nave está quase esgotada.";
    text[4594] = "Pouse a nave. Vejo Fendas de Sílica à frente.";
    text[4595] = "Que tal um 'por favor'?";
    text[4600] = "Que tal um 'não'?";
    text[4601] = "Hunf. Você é terrível.";
    text[4602] = "Ok, vou pousar a nave! Melhor se segurarem!";
    text[4598] = "Nossa nave recebeu muitos danos!";
    text[4599] = "Precisamos fazer um pouso de emergência antes que exploda!";
    text[4614] = "Enquanto isso...";
    text[4615] = "Ah! Acho que está bom de treino por hoje...";
    text[4616] = "Meus braços parecem gelatinas!";
    text[4617] = "Concordo. Também estou contente com o treino de hoje.";
    text[4618] = "Sua nova técnica está sensacional, Zara. Como a chama mesmo? ";
    text[4670] = "Bandeira Elástica de Bolas?";
    text[4619] = "Barreira Estática de Rochas. É um nomo longo, mas acho bem útil para batalha.";
    text[4633] = "Admiro sua paixão por criar novas técnicas.";
    text[4620] = "Você se tornará a Mestre de Conexões Neurais número um algum dia. Tenho certeza!";
    text[4621] = "Espero que sim... Obrigada, Melody.";
    text[4622] = "Hmm...";
    text[4623] = "Raine deve terminar a sessão de treino aaaaaaaaaa... gora.";
    text[4624] = "... Viu! Bem na hora!";
    text[4625] = "CARA! Vocês deveriam ter visto o último soco que eu dei!";
    text[4635] = "Aquele robô de batalha não teve a menor chance! Estou pegando FOGO, bebê!";
    text[4628] = "Senhorita Raine, ouvi uma explosão! Está tudo bem?";
    text[4629] = "Ops...";
    text[4630] = "Chame o engenheiro robótico. O robô de batalha está... hm... quebrado...";
    text[4631] = "... de novo.";
    text[4632] = "Sem problema, senhorita Raine. Vou chamar o engenheiro...";
    text[4636] = "Então, o que vocês querem fazer agora?";
    text[4637] = "Ah. Vamos dar oi para a Bella!";
    text[4638] = "O que será que ela anda fazendo?";
    text[4639] = "Boa! Já que o robô de batalha está fora de campo...";
    text[4640] = "VOU LUTAR CONTRA A BELLA! BAHAHAHA!";
    text[4641] = "Aquela guerreira prodígio precisa de uma coça!";
    text[4642] = "Dome a besta, Raine. Dome a besta.";
    text[4643] = "Ei! Parece que recebemos uma nova missão!";
    text[4644] = "...";
    text[4645] = "... Espera... O quê?";
    text[4646] = "Estou lendo isso certo? Não pode ser verdade...";
    text[4647] = "É um relatório de missão Código Roxo para soldados e equipes do alto escalão militar...";
    text[4648] = "O Murktador escapou!";
    text[4649] = "Diz aqui que nossa missão é localizar e capturar o Murktador";
    text[4650] = "... e sua cúmplice...";
    text[4651] = "Bella Grey.";
    text[4652] = "Sem chance!!";
    text[4653] = "A Bella estava trabalhando com ele esse tempo todo?";
    text[4654] = "Não, acho que não.";
    text[4655] = "Bella não iria contra a Força Lunex assim...";
    text[4656] = "... A menos que...";
    text[4671] = "ISSO É INACEITÁVEL!";
    text[4657] = "Aquele não era o Dr. Thomas?? Ele passou voando pela gente!";
    text[4659] = "Vocês também viram o Relatório da Missão?";
    text[4660] = "Sim...";
    text[4661] = "Assim que o doutor viu o nome da Bella, ele saiu furioso daqui.";
    text[4662] = "Ele está indo para a Base Militar para conversar diretamente com Saros.";
    text[4663] = "Nossa querida Bella...";
    text[4664] = "... agora é uma criminosa procurada. Mié. Isso definitivamente são notícias tristes...";
    text[4665] = "(Deve haver um bom motivo para ela estar fazendo isso... Tenho certeza...)";
    text[4666] = "Meninas... Precisamos encontrar a Bella o mais rápido possível!!";
    text[4667] = "Mesmo se outros soldados da Força Lunex a encontrarem, eles não conseguirão detê-la.";
    text[4668] = "Concordo. Esse é o trabalho perfeito para o Esquadrão Raine.";
    text[4669] = "VAMOS!";
    text[4603] = "Tetra, quais são nossas coordenadas?";
    text[4604] = "Estamos atualmente no Setor 2 - Fendas de Sílica!";
    text[4605] = "*Respira*... Ainda temos um bom caminho até chegar ao meu esconderijo...";
    text[4606] = "*Respira*... *Respira*...";
    text[4607] = "Nickle, você está bem?";
    text[4608] = "Estou... Vamos só...";
    text[4609] = "Ele está ferido! Precisa descansar!";
    text[4610] = "Tetra, carregue a Nave Cápsula. Se a deixarmos aqui, ela revelará nossa localização.";
    text[4611] = "Vi uma pequena caverna aqui perto. Vamos descansar por lá hoje à noite.";
    text[4672] = "...";
    text[4673] = "O que foi, Bella?";
    text[4674] = "Nada... É só...";
    text[4675] = "... Acho que estou ansiosa...";
    text[4676] = "Por anos, fui leal à Força Lunex...";
    text[4677] = "Lutando e treinando com orgulho para me tornar uma brava guerreira como minha mãe foi...";
    text[4678] = "... Tudo para proteger o Povo de Luna.";
    text[4679] = "Agora... parece que meu mundo está virando aos poucos de cabeça para baixo.";
    text[4680] = "Vamos superar isso juntas, Bella!";
    text[4681] = "Pode ser difícil agora, mas precisamos continuar determinadas!";
    text[4682] = "Você tem razão...";
    text[4683] = "... Vocês poderiam falar mais baixo? Minha cabeça vai explodir.";
    text[4684] = "Parece que o Sr. Dorminhoco finalmente acordou.";
    text[4685] = "Aah... Quanto tempo eu dormi?";
    text[4686] = "4 horas.";
    text[4687] = "4 horas roncando alto! Hunf.";
    text[4690] = "Eu ouvi isso. Seu estômago estava roncando.";
    text[4691] = "...";
    text[4692] = "Se for para nos recuperar direito, precisaremos comer algo.";
    text[4693] = "Tome, sempre carrego uma barra de cheesecake de emergência.";
    text[4694] = "Não, obrigado.";
    text[4695] = "Nenhuma pessoa em sã consciência negaria uma barra de cheesecake!";
    text[4696] = "Você já experimentou?";
    text[4697] = "Não...";
    text[4698] = "SÉRIO?? VOCÊ PRECISA EXPERIMENTAR. É SURREAL!";
    text[4699] = "... Beleza. Dê-me metade.";
    text[4700] = "(nhom, nhom, nhom)";
    text[4701] = "Entããããoo?";
    text[4702] = "O que achou?";
    text[4703] = "Gostou?";
    text[4704] = "É boa. (NUNCA COMI NADA TÃO GOSTOSO ASSIM NA VIDA. QUE DROGA É ESSA??)";
    text[4705] = "Hihi. Sua cara diz tudo.";
    text[4706] = "Que bom que gostou!";
    text[4707] = "... Obrigado...";
    text[4708] = "Já que estamos seguros por enquanto...";
    text[4709] = "Acho que podemos conversar. Conhecer um ao outro um pouco melhor, sabe?";
    text[4710] = "Conversar sobre o quê?";
    text[4711] = "Céu amado, você precisa melhorar suas habilidades sociais.";
    text[4712] = "Ei, não vou me tornar magicamente seu amigo só porque";
    text[4713] = "você me ajudou a escapar da Força Lunex.";
    text[4714] = "Talvez seja de uma amiga que você precise.";
    text[4715] = "Alguém que possa ouvir suas dificuldades.";
    text[4716] = "Alguém para compartilhar momentos sinceros.";
    text[4717] = "Você provavelmente deveria se manter distante de mim.";
    text[4718] = "Nem eu quero ser meu próprio amigo.";
    text[4719] = "... Eu tive amigos próximos no passado...";
    text[4720] = "... E todos se foram.";
    text[4721] = "Onde quer que eu vá, não trago nada além de dor.";
    text[4722] = "Todo mundo acaba se machucando por minha causa.";
    text[4723] = "É disso que você tem medo?";
    text[4724] = "Perder alguém próximo?";
    text[4725] = "Você é mesmo perceptiva e isso meio que é bem chato.";
    text[4726] = "Tem outra coisa que não sai dos meus pensamentos...";
    text[4727] = "Por que eu?";
    text[4728] = "O-o quê? Como assim??";
    text[4729] = "Se fosse qualquer outra pessoa, você já teria ido embora.";
    text[4730] = "Você não teria se aberto a ninguém, deixaria a pessoa falando sozinha.";
    text[4731] = "Então... Por que eu?";
    text[4732] = "...";
    text[4733] = "É porque conhecia minha mãe?";
    text[4734] = "Queria perguntar...";
    text[4735] = "Como conheceu minha mãe?";
    text[4736] = "Anos atrás, quando eu tinha pouco controle sobre meus poderes...";
    text[4737] = "Eu entrei em frenesi... Não conseguia controlar a quantidade de poder.";
    text[4738] = "A Força Lunex veio e... sua mãe estava liderando a missão para me acolher.";
    text[4739] = "Em minha tentativa franca e desesperada de manter minha compostura e sanidade...";
    text[4740] = "Ouvi a voz dela, mesmo com toda a dor.";
    text[4741] = "De algum jeito, eu senti... o calor da alma dela... a bondade dela chegando até mim.";
    text[4742] = "Quando vi, acordei e estava de volta em meu esconderijo.";
    text[4743] = "Não sentia mais dor. Meu ímpeto de poder havia sumido repentinamente.";
    text[4744] = "Ela poderia ter me entregado, mas não o fez.";
    text[4745] = "Em vez disso, ela decidiu vir ver como eu estava de vez em quando.";
    text[4746] = "Ela sabia que se me levasse à Base Militar, eu continuaria a sofrer.";
    text[4747] = "Naquela época, Saros era o cientista-chefe militar.";
    text[4748] = "Ele insistiu na minha captura para que eu pudesse ser estudado.";
    text[4749] = "Não é todo dia que se esbarra em um garoto com poder inimaginável e assustador assim.";
    text[4750] = "Ela desconsiderou os pedidos de Saros e decidiu me proteger.";
    text[4751] = "É intrigante... Eu senti um poder estranho emanando dela.";
    text[4752] = "Um poder que fazia minha antimatéria reagir.";
    text[4753] = "Um poder que também sinto vindo de você...";
    text[4754] = "O poder de manipular Lux.";
    text[4755] = "...!";
    text[4756] = "Minha mãe falou alguma coisa sobre esse poder?";
    text[4757] = "... Acho que devemos ir.";
    text[4758] = "Ei! Não me ignore! Por favor, preciso saber...";
    text[4759] = "... Quero perguntar uma coisa...";
    text[4760] = "Você é capaz de controlar esse seu poder?";
    text[4761] = "Na verdade, não... Ele surge e desaparece.";
    text[4762] = "Se eu descobrir como controlá-lo, talvez eu consiga me comunicar com os Murks!";
    text[4763] = "Poderemos achar um meio de ter paz!";
    text[4764] = "Entendi... Acho que você ainda não esteja pronta para a verdade.";
    text[4765] = "... E ainda não confio totalmente em você.";
    text[4766] = "Contarei o que você precisa saber se chegarmos ao meu esconderijo.";
    text[4767] = "... Beleza.";
    text[4768] = "Mas só para que fique claro...";
    text[4769] = "Estou aqui por que você disse que precisava da minha ajuda...";
    text[4770] = "... E eu também preciso da sua.";
    text[4771] = "Preciso entender mais sobre o poder da Lux...";
    text[4772] = "Sei que eu estava determinada a descobrir onde seus Antinúcleos estavam...";
    text[4773] = "Mas, agora... Tudo mudou. Posso ver como eles são preciosos para você.";
    text[4774] = "Seja lá qual for o motivo, não estou aqui para tomar seus Antinúcleos de você.";
    text[4775] = "Só quero saber a verdade...";
    text[4776] = "Permanecer ignorante me impedirá de fazer o que mais amo.";
    text[4777] = "... Proteger meu povo.";
    text[4778] = "... Proteger aqueles próximos a mim.";
    text[4779] = "Encontrarei outro jeito de impedir o Cometa Coda. Não desistirei!";
    text[4780] = "... ... ... ...";
    text[4781] = "... Também quero proteger o Povo de Luna.";
    text[4782] = "Fico feliz que temos um objetivo em comum.";
    text[4783] = "Vamos dar o fora daqui antes que a Força Lunex apareça.";
    text[5000] = "Espere, não se movam. Há uma nave por perto.";
    text[5001] = "Parece que eles enviaram drones de reconhecimento!";
    text[5002] = "Acho que não há soldados o suficiente para buscar toda a área norte de Luna a pé.";
    text[5003] = "Ficaremos bem contanto que não sejamos detectados pelos drones.";
    text[5004] = "Acho que já estamos a salvo. Vamos.";
    text[4968] = "...!";
    text[4969] = "Ouvi uma voz! Bem baixa...";
    text[4970] = "Acalme-se. Concentre-se na sua mente.";
    text[4971] = "Tente canalizar sua Lux...";
    text[4972] = "Mas eu... eu não sei como.";
    text[4973] = "Você já sentiu isso. Tente reviver quando sentiu.";
    text[4974] = "Aquela sensação de querer criar uma conexão...";
    text[4975] = "... De se comunicar com seu coração e sua alma.";
    text[4976] = "Não deixe essa sensação sumir.";
    text[4977] = "So... corro...";
    text[4978] = "... D... dói...";
    text[4979] = "Por... favor...";
    text[4980] = "Ouvi a voz de novo! Estava bem mais clara desta vez.";
    text[4981] = "É... um pedido de ajuda. Parece estar sentindo muita dor.";
    text[4982] = "Sinto um Murk nas proximidades. A voz deve estar vindo de um Murk.";
    text[4960] = "Precisamos encontrá-lo...";
    text[4983] = "... e pegar seu antinúcleo.";
    text[4961] = "Hm. Estamos em fuga, tá lembrado?";
    text[4962] = "É, os drones podem nos ver!";
    text[4963] = "Não importa. Não estou preocupado com os Drones.";
    text[4964] = "Se há um Murk, precisamos lutar.";
    text[4984] = "Ainda não me recuperei por completo...";
    text[4985] = "Você pode... me ajudar a combatê-lo?";
    text[4986] = "Mas... Eu não gosto de matar Murks...";
    text[4987] = "Ei, eu também não gosto de matá-los, mas...";
    text[4988] = "Os antinúcleos são a chave para que a justiça seja feita.";
    text[4989] = "Justiça? O que os Murks fizeram para você?";
    text[4990] = "Não é por algo que eles fizeram.";
    text[4991] = "O problema é mais o que eu posso ter feito para eles...";
    text[4992] = "Céus, você é tão teimoso. Se quiser mesmo a minha ajuda,";
    text[4993] = "você vai precisar ter o mínimo de honestidade comigo.";
    text[4994] = "(suspiro)";
    text[4995] = "Você vai entender depois que eu contar tudo.";
    text[4996] = "Às vezes, a verdade pode ser um fardo. Só lembre-se que...";
    text[4997] = "Você não precisa carregar esse fardo sozinho, sabe...";
    text[4998] = "... Eu sei.";
    text[4999] = "Agora, vamos encontrar aquele Murk.";
    text[4846] = "... Ei. Tem alguma coisa aqui!";
    text[4847] = "Mesmo? Não estou vendo nada.";
    text[4848] = "Tetra, ative seus sensores.";
    text[4849] = "Ah! Estou detectando um acúmulo de partículas de antimatéria!";
    text[4850] = "Às vezes, esqueço que as pessoas não conseguem ver o mundo do jeito que eu vejo.";
    text[4851] = "Como assim?";
    text[4852] = "Há comprimentos de ondas do espectro eletromagnético que estão além";
    text[4853] = "da capacidade visual dos olhos humanos.";
    text[4854] = "Por conta dos meus poderes... Posso ver luz e, até mesmo, antimatéria que";
    text[4855] = "não são visíveis para as pessoas.";
    text[4856] = "Uau...";
    text[4857] = "Achei sensacional!";
    text[4858] = "Hm... Nunca vi assim.";
    text[4859] = "Sempre foi um fardo para mim... Às vezes, era uma sobrecarga sensorial excessiva.";
    text[4860] = "Levou um tempo para me acostumar.";
    text[4861] = "Hm... Por isso você usa uma máscara?";
    text[4862] = "Notei que sua máscara é uma modificação do capacete espacial da Força Lunex.";
    text[4863] = "Esses capacetes foram projetados para filtrar a luz nociva,";
    text[4864] = "para não afetar a visão no espaço.";
    text[4865] = "Sim, basicamente isso.";
    text[4866] = "Então, de qual é a cara assustadora na máscara?";
    text[4867] = "... Por quê? Nenhum motivo em particular.";
    text[4868] = "Mesmo?! Hm...";
    text[4869] = "É só que...";
    text[4870] = "... achei o visual legal... talvez um pouco intimidador.";
    text[4871] = "Ok, sem mais perguntas...";
    text[4872] = "Vamos pegar o que quer que esteja nesse acúmulo de antimatéria e continuar.";
    text[5100] = "Ai!";
    text[5101] = "Bella, você está bem? Tome mais cuidado na próxima vez!";
    text[5102] = "Você perdeu 1.000 bytes na explosão...";
    text[5045] = "Ei, precisamos encontrar o Murk nas redondezas primeiro.";
    text[5046] = "Bella, você se esqueceu de coletar o antinúcleo!";
    text[3528] = "Bella, olhe ali! O que é aquilo lá longe?";
    text[3529] = "É a antiga cidade de Magnésia...";
    text[3530] = "... ou melhor, onde ela costumava ficar.";
    text[3531] = "Os registros públicos dizem que a destruição de Magnésia foi";
    text[5107] = "causada pela ação de um único Murk extremamente poderoso.";
    text[3540] = "...";
    text[3532] = "Vi uma vez nos noticiários quando era criança, mas não me lembro muito a respeito.";
    text[3533] = "É difícil saber exatamente o que aconteceu aquele dia.";
    text[3534] = "Por quê?";
    text[3535] = "Poucos sobreviveram...";
    text[3536] = "A Força Lunex não estava equipada o suficiente para impedir o Murk naquela época...";
    text[3537] = "... Está dizendo que isso era o que poderia ter acontecido com Copernicus";
    text[3538] = "se falhássemos em nossa missão?";
    text[3539] = "Sim...";
    text[3540] = "...";
    text[3541] = "... Bella?!";
    text[3542] = "Desculpa. Estava rezando pelas pessoas que morreram.";
    text[3543] = "Vamos dar o nosso melhor e salvar o máximo de vidas possível!";
    text[3544] = "... Tetra?";
    text[3545] = "Rezei também! Isso aí, Bella! Hihi.";
    text[5108] = "Ei, Nickle, tudo bem?";
    text[5109] = "Você está tremendo...";
    text[5110] = "...";
    text[5111] = "Desculpa... Eu...";
    text[5112] = "Tá tudo bem... Vamos continuar.";
    text[5113] = "A Colônia Sílica deve estar logo à frente.";
    text[5114] = "(... Que que deu nele?)";
    text[5115] = "(Ele parece ter visto uma assombração ou sei lá.)";
    text[5116] = "(Não sei... Vamos deixá-lo quieto por enquanto.)";
    text[5117] = "Aaah... É bem quente e agradável nesta Colônia.";
    text[5118] = "É a sua primeira vez na Colônia Sílica?";
    text[5119] = "Sim! Basicamente. Amei a vibe daqui!";
    text[5120] = "Ah! Um café!";
    text[5121] = "Céus, meu cabelo está uma bagunça.";
    text[5122] = "Precisamos aproveitar para tomar um banho e estocar comida enquanto estamos aqui!";
    text[5123] = "O Sr. Fedorento aqui precisa de um banho.";
    text[5124] = "Mas, como... Você tem um sensor de odores integrado?";
    text[5125] = "Não é uma função meio inútil?";
    text[5126] = "Você é que é inútil! Hunf.";
    text[5155] = "Parem de brigar, vocês dois. Acho que podemos fazer uma pequena pausa.";
    text[5156] = "30 minutos depois...";
    text[5127] = "Ah, minha barriga vai explodir! Que refeição!";
    text[5128] = "Nickle, estou surpresa que você bateu meu recorde de barras de cheesecake.";
    text[5129] = "Aquele negócio é viciante demais...";
    text[5130] = "Fiz questão de estocar mais alguns só por precaução.";
    text[5131] = "Um para agora, um para depois...";
    text[5132] = "... E um para depois de depois! Hihi.";
    text[5133] = "Conte-me, Nickle. O que costuma fazer quando não está caçando Murks?";
    text[5134] = "Pode não parecer, mas sou um caçador de tesouros.";
    text[5135] = "Encontrar e vender itens raros e tesouros é como sobrevivo.";
    text[5136] = "Sério?! Parece muito bacana!";
    text[5137] = "Acha mesmo? Quero dizer, é um trabalho difícil, mas bem recompensador.";
    text[5138] = "Tenho paixão por explorar e por aventuras desde pequeno.";
    text[5139] = "Há muito da história de Luna além da superfície.";
    text[5140] = "Seria muito legal explorar toda Luna um dia...";
    text[5141] = "... E, quem sabe, descobrir um tesouro raro.";
    text[5142] = "Mas, por ora... ";
    text[5143] = "Há outra coisa que preciso fazer antes. Meus sonhos podem esperar.";
    text[5144] = "... Se conseguirmos impedir o Cometa Coda e consertar essa bagunça...";
    text[5145] = "... Quando tudo tiver acabado...";
    text[5146] = "Quem sabe... possamos ir caçar tesouros juntos.";
    text[5147] = "Você também está convidada, Tetra.";
    text[5148] = "SÉRIO?? Eu vou amar!";
    text[5149] = "EU TAMBÉM! EU TAMBÉM! Você não vai encontrar uma Escudeira Caçadora de Tesouros melhor por aí. Hihi.";
    text[5150] = "Acho que não é tão maldosa quando achei.";
    text[5151] = "Espere mais algumas alfinetadas! É divertido. Hahahaha!";
    text[5152] = "Ah é? Aceito o desafio.";
    text[5154] = "Mas você é que levará umas alfinetadas!";
    text[5017] = "Odeio interromper esse momento de união, mas já estamos perto do seu esconderijo?";
    text[5153] = "Boa pergunta...";
    text[5005] = "Eu... Hm...";
    text[5006] = "Estive mentindo a respeito de algo...";
    text[5007] = "Ahn?! Mentindo sobre o quê?";
    text[5008] = "Na verdade, meu esconderijo não fica aqui em Sílica.";
    text[5009] = "Sério mesmo?? Por que estamos aqui então??";
    text[5010] = "Desperdiçamos um tempo valioso!";
    text[5011] = "Desculpa... Não tinha certeza se poderia confiar em você.";
    text[5012] = "Se seu esconderijo não fica aqui, onde ele fica?";
    text[5013] = "Fica em Oceanus...";
    text[5014] = "Sem chance! Aposto que está mentindo de novo.";
    text[5015] = "Não desta vez! Eu juro!";
    text[5016] = "(Por que ela parece tão assustadora quando fica brava?)";
    text[5021] = "Eu explorei Oceanus diversas vezes.";
    text[5022] = "A praia não é exatamente o melhor lugar para um esconderijo.";
    text[5023] = "A entrada para ele é... um tanto peculiar. Você verá.";
    text[5024] = "De qualquer forma, não viemos aqui para nada.";
    text[5025] = "Eu visitei a Colônia Sílica diversas vezes para obter suprimentos e artigos essenciais.";
    text[5026] = "Não há muita presença da Força Lunex aqui no Norte";
    text[5027] = "quando comparado ao resto de Luna, então é mais fácil andar por aí.";
    text[5028] = "Tenho um parceiro aqui chamado Cypher que pode nos ajudar a conseguir uma nova nave.";
    text[5029] = "Cypher, o Comerciante de Astrotecas? Lembro de encontrá-lo em Regolithia.";
    text[5030] = "Espera aí! VOCÊ tem amigos?";
    text[5031] = "Ai. Essa foi dura, Tetra.";
    text[5032] = "O quê? Alguém acabou de levar uma alfinetada de graça? Tetra - Um, Nickle - Zero!";
    text[5033] = "Continue assim e você será riscado da lista de candidatos a namorado.";
    text[5034] = "O-o quê... Você tem uma lista?";
    text[5035] = "Ei, não me olhe assim! Não pedi para ela fazer uma!";
    text[5036] = "Estou honestamente surpresa que ele não tentou ainda fugir da gente.";
    text[5037] = "Quem sabe Bella esteja na lista de namoradas em potencial dele...";
    text[5038] = "... ou pior... Ele pretende me destronar como a Grande Escudeira de Bella!";
    text[5039] = "Escudeira?? Hahaha.";
    text[5040] = "Estou de olho, colega!";
    text[5041] = "Ok... Divirtam-se discutindo vocês dois! Vou procurar o Cypher.";
    text[5042] = "Hunf!";
    text[5043] = "Hunf!";
    text[5056] = "E aí, Cypher.";
    text[5057] = "Mas... Cara, achei que você estava preso!";
    text[5058] = "Eu estava, mas essas duas me ajudaram a escapar.";
    text[5059] = "Bom vê-lo novamente, Cypher!";
    text[5060] = "Ei! Você é aquela garota que conheci em Regolithia!";
    text[5061] = "Então, como posso ajudá-los?";
    text[5062] = "Se incomoda se pegarmos uma nave emprestada?";
    text[5063] = "Jamais!";
    text[5064] = "Vamos ver se tenho alguma nave de bobeira nos fundos.";
    text[5065] = "Valeu, Cypher.";
    text[5066] = "Cypher sabe que você é o Murktador?";
    text[5067] = "Poucas pessoas sabem. Nos conhecemos há muito tempo.";
    text[5068] = "Eu o salvei de ser devorado por um Murk uma vez.";
    text[5069] = "Ok, más notícias. Vendi minha última nave boa.";
    text[5070] = "Tudo o que tenho é uma minicápsula antiga.";
    text[5071] = "Está totalmente carregada?";
    text[5072] = "Sim!";
    text[5073] = "Vamos levá-la.";
    text[5074] = "Na real, pode ficar com ela. Eu te devo uma por salvar a minha vida.";
    text[5075] = "Valeu, Cypher.";
    text[5077] = "Não deem mole lá fora, beleza?";
    text[5078] = "Vi um monte de drones de reconhecimento e naves Lunex voando sobre a colônia mais cedo.";
    text[5079] = "Agradecemos o aviso! Vamos partir o mais rápido possível.";
    text[5080] = "Para Oceanus! Vamos para o hoverporto mais próximo e decolar!";
    text[5081] = "Ah, centelhas! Temos duas naves Lunex na nossa cola!";
    text[5082] = "Bella, elas estão com os Canhões de Fótons ativados!";
    text[5083] = "Murktador! Bella Grey!";
    text[5084] = "Rendam-se agora ou iremos ABRIR FOGO!";
    text[5085] = "Tsc... Acelera aí! Não podemos deixá-los nos alcançar.";
    text[5086] = "Ah, Bella! Acho que estamos indo no sentido errado.";
    text[5087] = "Eu sei. Não podemos deixar óbvio que estamos indo para Oceanus, então...";
    text[5088] = "Teremos que fazê-los nos perseguir até nos perderem de vista!";
    text[5089] = "Apertem os cintos! Vamos com velocidade turbo desta vez. Hihi.";
    text[5090] = "Parece que os despistamos! Pilotou muito, Bella!";
    text[5091] = "Hehe. Obrigada.";
    text[5092] = "Haha. Obrigada pelo sarcasmo.";
    text[5093] = "Beleza. Próxima parada: Oceanus!";
    text[5095] = "Apesar de termos tido avarias... Parece que os despistamos.";
    text[5096] = "Bela pilotagem.";
    text[5097] = "Ok. Chegamos a Oceanus.";
    text[5098] = "Onde fica seu esconderijo?";
    text[5103] = "No Recife Harmonia.";
    text[5104] = "Precisamos ir a leste.";
    text[5105] = "Beleza. Vamos nessa!";
    text[5106] = ".@P.@P.";
    text[5157] = "(Tem alguma coisa errada...)";
    text[5158] = ".@P.@P.";
    text[5159] = ".@P.@P.";
    text[5160] = "(Hmm...)";
    text[5161] = "(Preciso ficar alerta, só por precaução.)";
    text[5162] = "(Se tudo correr bem...)";
    text[5163] = "(... haverá esperança.)";
    text[5164] = "(Talvez possa salvá-los...)";
    text[5165] = "Ei, Nickle. Você vem?";
    text[5166] = "Sim, foi mal.";
    text[5167] = "Só conferindo se ninguém nos seguiu.";
    text[5168] = "Vamos logo.";
    text[5180] = "Chegamos.";
    text[5181] = "Ahn?! Não vejo uma entrada...";
    text[5182] = "Como mencionei antes, a entrada é um pouco peculiar.";
    text[5183] = "Há uma caverna no fundo deste recife.";
    text[5184] = "Precisamos mergulhar para chegar lá.";
    text[5185] = "Sério mesmo? Vamos ficar encharcadas!";
    text[5186] = "Bella... É seguro eu mergulhar fundo?";
    text[5187] = "Sim! Não se preocupe. Você é à prova d'água, lembra?!";
    text[5188] = "Ok, só confirmando. Hihihi.";
    text[5189] = "Preciso admitir, é um esconderijo bem pensado.";
    text[5190] = "Não me admira que a Força Lunex teve problema em encontrá-lo.";
    text[5191] = "Dentro desta caverna...";
    text[5192] = "... está a verdade.";
    text[5193] = "Preciso saber...";
    text[5194] = "Posso confiar em vocês duas?";
    text[5195] = "É claro! Também confiamos em você.";
    text[5196] = "Você é nosso amigo Nickle. Estamos nisso juntos!";
    text[5197] = "É! Agora somos uma equipe. Hihi.";
    text[5198] = "Bom, então vamos nessa!";
    text[5199] = "Temo dizer que vocês não irão a lugar algum.";
    text[5200] = "CAMPO DE PLASMA, ATIVAR!";
    text[5201] = "Tinha gente nos seguindo??";
    text[5202] = "É uma emboscada!";
    text[5203] = "Raine! Melody! Zara!";
    text[5204] = "Parece que nossa guerreira prodígio esteve com o traidor o tempo todo!";
    text[5205] = "Não acredito que você nos traiu, Bella...";
    text[5206] = "O quê?! Não!";
    text[5207] = "Escutem o que tenho a dizer. Sei que as coisas parecem estranhas agora...";
    text[5208] = "... mas posso explicar!";
    text[5209] = "Sinto muito, Bella, mas agora você é uma criminosa procurada.";
    text[5210] = "Coopere ou não teremos outra escolha que não usar a força.";
    text[5211] = "Meninas...";
    text[5212] = "Quando recebemos o Relatório da Missão, procuramos por todas as partes por você.";
    text[5213] = "Sabíamos que se havia alguém que conseguiria capturá-la...";
    text[5214] = "... seríamos nós! O ESQUADRÃO RAINE, BEBÊ!!!";
    text[5215] = "AGORA, PUNHOS AO ALTO!";
    text[5216] = "Espere, Raine, seria melhor...";
    text[5217] = "NÃO!";
    text[5218] = "VAMOS LUTAR!";
    text[5219] = "Tenho um placar para acertar com a Bella. Você ainda me deve uma revanche!";
    text[5220] = "... E você também vai junto, Murktador!";
    text[5221] = "Pelo menos, não está escondido atrás daquela máscara estúpida desta vez.";
    text[5222] = "Tsc. Essas garotas são irritantes.";
    text[5223] = "Vai me ajudar, Bella?";
    text[5224] = "Mas... eu não quero lutar contra elas! Elas são minhas amigas!";
    text[5225] = "Não mais. Elas escolheram o lado deles.";
    text[5226] = "Acabou esse papinho todo! Não há escapatória.";
    text[5227] = "...";
    text[5228] = "Certo. Vai ter que ser assim.";
    text[5229] = "Se acha que pode nos derrotar, vocês se ILUDIRAM.";
    text[5230] = "Vou ter que dar outra surra em você, Raine. DE NOVO.";
    text[5231] = "OHOHOHO! Palavras confiantes para uma TRAIDORA!";
    text[5232] = "ACEITO O DESAFIO.";
    text[5233] = "Hm... pessoal. Posso ficar fora dessa?";
    text[5234] = "Não quero machucar ninguém...";
    text[5235] = "Isso mesmo! Fique fora disso! Deixem as verdadeira heroínas lutarem!";
    text[5236] = "De qualquer forma, você é uma PÉSSIMA escudeira.";
    text[5237] = ".@P.@P.";
    text[5238] = "MENTIROSA! RETIRE O QUE DISSE! GRRRR!";
    text[5239] = "BELLA, VAMOS QUEBRÁ-LAS!";
    text[5240] = "Somos o esquadrão de guerreiras mais forte de Luna.";
    text[5241] = "Vocês não têm a menor chance!";
    text[5242] = "Vamos, ESQUADRÃO RAINE!";
    text[5243] = "Droga... Como assim?! Perdemos!";
    text[5244] = "Ai...";
    text[5245] = "Hmm...";
    text[5246] = "Já acabou, Jéssica?";
    text[5247] = "Acho que está bom de atuação por hoje, não acham?";
    text[5248] = "O-o quê? Fala sério! Não foi atuação...";
    text[5249] = "Melody, você hesitou toda vez que atacou.";
    text[5250] = "Zara, seu foco estava em outro lugar...";
    text[5251] = "É como se estivessem perdidas no meio da nossa batalha.";
    text[5252] = "... e, Raine... você definitivamente estava segurando seus socos.";
    text[5253] = "Ei! Você também estava!";
    text[5254] = "Ahn? Você estava? Eu estava indo com tudo.";
    text[5255] = "Eu também! ... Porque a Raine é maldosa!";
    text[5256] = "Ok, ok.";
    text[5257] = "Droga, você tem razão. Foi tudo atuação...";
    text[5258] = "Mesmo? ...";
    text[5259] = "(Suspiro...)";
    text[5260] = "É claro que a Raine usaria essa situação como desculpa para lutar comigo...";
    text[5261] = "... Mas, você também, Melody?";
    text[5262] = "Raine nos fez seguir o plano dela e fingiu que éramos inimigas...";
    text[5263] = "... e você, Zara?";
    text[5264] = "... Eu precisava de um oponente digno para testar um novo ataque que criei...";
    text[5265] = "Graças à nossa luta, agora tenho mais ideias.";
    text[5266] = "Murktador... Você tem uns movimentos irados.";
    text[5267] = "Hm... Obrigado?!";
    text[5268] = "Espera aí um pouquinho!";
    text[5269] = "Então não estão aqui para nos capturar?";
    text[5270] = "Não. Botando a rivalidade de lado, ficamos preocupadas com você, Bella.";
    text[5271] = "Você não entraria de cabeça nisso se não fosse por um bom motivo...";
    text[5272] = "Seja lá qual for ele, estamos aqui para ajudá-la. Boas amigas apoiam umas às outras.";
    text[5273] = "Ah, meninas...";
    text[5281] = "Desculpa se disse aquelas coisas terríveis para você, Tetra...";
    text[5282] = "Só queria que você ficasse irritada para deixar nossa luta mais emocionante. BAHAHAHA!";
    text[5283] = "Hunf. Desculpas aceitas.";
    text[5274] = "Ei, Murktador...";
    text[5301] = "Qual é a sua?";
    text[5302] = "Você é um dos bonzinhos ou só está zoando com a Bella?";
    text[5303] = "Olhos de águia em você, viu, rapaz?!";
    text[5278] = "Raine, você precisa ser mais amigável!";
    text[5279] = "Sou a Melody! Qualquer amigo da Bella é nosso amigo também!";
    text[5280] = "Sou a Zara. Prazer em conhecê-lo.";
    text[5284] = "Hunf... Sou a Raine. Não se esqueça disso.";
    text[5275] = ".@P.@P. .@P.@P. .@P.@P.";
    text[5276] = "Está tudo bem. Podemos confiar nelas. Elas estão do nosso lado.";
    text[5277] = "Sei que os últimos anos foram complicados para você...";
    text[5304] = "... Mas não está mais sozinho.";
    text[5305] = "Você precisa se permitir confiar nas pessoas mais uma vez...";
    text[5285] = ".@P.@P. .@P.@P. .@P.@P.";
    text[5286] = "(Suspiro...)";
    text[5287] = "Meu nome é Nickle.";
    text[5288] = "Olha... Eu só estou aqui agora por causa da Bella e da Tetra.";
    text[5306] = "Bella arriscou a própria carreira e se colocou em perigo para me ajudar.";
    text[5307] = "... Para buscar a verdade.";
    text[5308] = "O que, honestamente, é loucura. Ela mal me conhece.";
    text[5309] = "Continue tentando afastá-la toda vez que tentava interagir comigo.";
    text[5310] = "Apesar de tudo... ela ainda quis me ajudar.";
    text[5311] = "... Ele me aceitou, não importando quem eu sou ou o que fiz.";
    text[5312] = "Tem meu respeito.";
    text[5313] = "...!";
    text[5314] = "Ainda nem contei a ela o motivo pelo qual coleciono Antinúcleos...";
    text[5315] = "... ou por que odeio tanto a Força Lunex.";
    text[5316] = "... E, mesmo assim, você tem se aventurado com ele cegamente?";
    text[5317] = "Bella, o que te fez ter certeza de que ele não fugiria ou te enganaria?";
    text[5318] = "...";
    text[5319] = "Confiança.";
    text[5320] = "Todo mundo tem um lado sombrio... Coisas das quais não se orgulham.";
    text[5321] = "... Mas gosto de ver o melhor nas pessoas.";
    text[5322] = "Todo mundo merece a chance de ser ouvido.";
    text[5323] = "Se vamos salvar o povo de Luna do Cometa Coda...";
    text[5324] = "... ou mesmo dos Murks...";
    text[5325] = "Devemos trabalhar juntos para encontrar a melhor solução possível.";
    text[5326] = "Ele demorou um bom tempo para perceber isso... Né, Sr. Cabeça-dura?";
    text[5327] = "S-sim...";
    text[5328] = "Explicarei tudo quando chegarmos ao meu esconderijo.";
    text[5329] = "Não podemos arriscar que outras pessoas nos encontrem.";
    text[5330] = "Certo, pessoal, vamos nessa!";
    text[5354] = "Devaneios?";
    text[5355] = "Só... pensando no futuro.";
    text[5356] = "Não temos muito tempo.";
    text[5357] = "Como estão os testes recentes?";
    text[5358] = "Os testes falharam...";
    text[5359] = "... mas, pelo menos, os resultados estão melhores do que dos testes anteriores.";
    text[5360] = "Taxa de ressonância?";
    text[5361] = "90% de ressonância.";
    text[5362] = "... Acha que é o suficiente? Será que eu...";
    text[5363] = "Eu não arriscaria, Saros.";
    text[5364] = "Precisamos garantir que seja 100% seguro...";
    text[5365] = "Continuaremos tentando. Não desistirei de você...";
    text[5366] = "SAROS!";
    text[5367] = "Ah, Thomas, estava lhe aguardando.";
    text[5368] = "Onde está a Bella? Conte-me onde ela está!";
    text[5369] = "Acalme-se, Thomas.";
    text[5370] = "Achei que tínhamos um acordo! Você disse que não machucaria a Bella!";
    text[5371] = "Isso é ultraje! Você tem centenas de soldados lá fora atrás dela!";
    text[5372] = "Thomas, tudo está indo de acordo com o plano.";
    text[5373] = "Bella é forte. Ela consegue lidar com qualquer soldado ou exoesqueleto que eu mandar atrás dela.";
    text[5374] = "Além de estar com o Murktador. Devo reconhecer a força deles.";
    text[5375] = "Precisava que fosse assim. Digamos que eu precisava que parecesse...";
    text[5376] = "... convincente.";
    text[5377] = "Fique tranquilo...";
    text[5378] = "Inevitavelmente, conseguiremos o que precisamos.";
    text[5379] = "Sei que você faria de tudo para proteger sua família, Thomas.";
    text[5380] = "Por favor, não machuque a Bella...";
    text[5381] = "Quando esta missão for cumprida, retiraremos todas as acusações contra a Bella.";
    text[5382] = "Prometo que ela não sofrerá nenhum mal.";
    text[5383] = "Na verdade, já que está aqui, venha comigo.";
    text[5384] = "Acho que é hora de mostrá-lo no que tenho trabalhado.";
    text[5385] = "Uau! Que lugar é esse?";
    text[5386] = "Tudo é azul!";
    text[5387] = "É lindo aqui!";
    text[5388] = "Descobri essas ruínas anos atrás quando saí em um expedição solo.";
    text[5389] = "Expedição?? Esse cara é um Caçador de Tesouros?";
    text[5390] = "Sim! Também fiquei assim quando ele nos contou!";
    text[5391] = "Achei que já havíamos escavado todas as ruinas dos Antigos por Luna...";
    text[5392] = "Não. Tenho certeza de que há mais relíquias e ruínas ainda não exploradas pela humanidade.";
    text[5393] = "Essas ruínas já foram habitadas por uma civilização antiga de pessoas,";
    text[5394] = "conhecida como os Antigos.";
    text[5395] = "Eles eram conhecidos por conseguirem manipular tanto Lux quanto Antimatéria";
    text[5396] = "e prosperaram durante um tempo antes de a humanidade se alocar em Luna.";
    text[5397] = "Milhares de anos atrás.";
    text[5398] = "Se eles eram tão avançados, onde estão agora?";
    text[5399] = "Bom, isso é o que os arqueólogos estão tentando descobrir até hoje.";
    text[5400] = "Venham, vamos continuar.";
    text[5401] = "LUMICAVALEIRO ATIVADO. DADOS DE ALMA BIOGÊNICA ANTIGA DETECTADOS.";
    text[5402] = "LEITURAS DE LUX ANORMAIS. AGUARDANDO TRANSMISSÃO DE GUARDIA.";
    text[5403] = "Nickle, que diabos é isso??";
    text[5404] = "Droga...";
    text[5405] = "Acho que ativamos um sistema de segurança ou algo do tipo.";
    text[5406] = "TRANSMISSÃO DE GUARDIA RECEBIDA. INICIANDO PROVAÇÃO DE ALMAS.";
    text[5407] = "Provação de Almas? Ele está nos testando?";
    text[5408] = "Este lugar deve ter sido um local de treinamento para antigos soldados.";
    text[5409] = "Não achei que ainda estaria operando.";
    text[5410] = "O sistema de segurança nunca acionou das vezes que vim aqui.";
    text[5411] = "De qualquer forma, vamos desativá-lo!";
    text[5413] = "Ufa, essa foi difícil...";
    text[5414] = "O que acha que disparou o sistema de segurança?";
    text[5415] = "Está mais para... QUEM disparou o sistema de segurança.";
    text[5416] = "Acho que nossa guerreira prodígio aqui deve ter alguma conexão com os Antigos.";
    text[5417] = "Ei! Pare de me chamar assim! Você também, não!";
    text[5418] = "BAHAHAHA! Ele aprende rápido!";
    text[5419] = "Espera aí... Você acha que a Bella poderia ser...";
    text[5420] = "... descendente dos Antigos?";
    text[5421] = "Talvez...";
    text[5422] = "Hmm... Isso explicaria minha habilidade de manipular Lux...";
    text[5423] = "... e a sensações estranha que tenho tido.";
    text[5489] = "Se sou descendente dos Antigos...";
    text[5490] = "Isso significa que minha mãe também tinha o gene dos Antigos.";
    text[5491] = "Por que ela manteria isso em segredo?";
    text[5424] = "Preciso descobrir mais sobre os Antigos.";
    text[5425] = "Fique à vontade para examinar as estátuas e textos antigos nas Ruínas.";
    text[5426] = "Aprendi a maioria do que sei sobre os Antigos com as relíquias que deixaram para trás.";
    text[5427] = "Ótimo... Há um portão gigante bloqueando o caminho.";
    text[5428] = "Tem algo gravado no portão!";
    text[5429] = "AS QUATRO GEMAS DEVEM ABRIR O CAMINHO PARA A PERCEPTORA DE ALMAS.";
    text[5430] = "Então nosso objetivo é encontrar as QUATRO GEMAS para abrir esta porta.";
    text[5431] = "Pelo visto, teremos que completar a PROVAÇÃO DE ALMAS, gostando ou não.";
    text[5492] = "Isso me lembra de algo... O soldado mencionou um nome quando falou...";
    text[5493] = "Acho que foi... Guardia?!";
    text[5494] = "Se os soldados têm um líder de algum tipo nessas ruínas,";
    text[5495] = "gostaria de falar com ele.";
    text[5496] = "Quem sabe assim possamos aprender mais sobre minha Manipulação de Lux.";
    text[5497] = "Justo.";
    text[5498] = "Desculpa. Acho que estou ficando um pouco impaciente.";
    text[5499] = "O quê? Por que está me olhando assim?";
    text[5500] = "Nada... Hehe. Vamos procurar as QUATRO GEMAS!";
    text[5530] = "Há um fosso neste nível que leva às profundezas das ruínas.";
    text[5531] = "Podemos procurar as GEMAS nos níveis inferiores.";
    text[5532] = "Mas é melhor estarmos prontos antes de descermos...";
    text[5533] = "... É possível que não voltemos por um tempo.";
    text[5442] = "VOCÊ SE SAIU BEM, PERCEPTORA DE ALMAS.";
    text[5443] = "UOU! Esse cara é GIGANTE!";
    text[5444] = "Quem é você?";
    text[5445] = "SOU GUARDIA.";
    text[5446] = "UMA ENTIDADE PROGRAMADA PARA PROTEGER ESTAS RUÍNAS.";
    text[5447] = "Guardia, pode nos contar mais sobre o povo Antigo que vivia aqui?";
    text[5448] = "O que aconteceu com eles?";
    text[5449] = "NÃO FOI POSSÍVEL PROCESSAR SUA SOLICITAÇÃO. NÃO CONSTA EM MEU CONHECIMENTO ESSA INFORMAÇÃO.";
    text[5601] = "VOCÊ... BELLA GREY.";
    text[5602] = "A-ahn?! Como sabe meu nome?";
    text[5603] = "MEU PROCESSADOR É CAPAZ DE EXTRAIR INFORMAÇÕES PELA SUA LUX.";
    text[5604] = "FUI CAPAZ DE AVALIAR... VOCÊ NÃO É UMA AMEAÇA.";
    text[5605] = "Ok, ufa. Achei que teríamos que lutar contra esse cara.";
    text[5606] = "CONTUDO!";
    text[5627] = "Ops!";
    text[5607] = "SEUS NÍVEIS DE LUX SÃO... ANORMAIS.";
    text[5608] = "Anormais? Como assim?";
    text[5609] = "ESTÃO ACIMA DE QUALQUER NÍVEL REGISTRADO EM MEU BANCO DE DADOS.";
    text[5610] = "MESMO ASSIM, TAMBÉM ESTÃO EM UM ESTADO PECULIAR.";
    text[5611] = "ATUALMENTE, SUA CAPACIDADE DE MANIPULAR LUX É LIMITADA.";
    text[5612] = "SUA PERCEPÇÃO DE ALMAS FOI AFETADA.";
    text[5613] = "Guardia, você sabe como eu posso usar minha habilidade?";
    text[5614] = "... Por favor, me ensine como usar a Percepção de Almas!";
    text[5628] = "HÁ SÉCULOS, NÃO SOU ATIVADO.";
    text[5629] = "MINHAS RESERVAS DE ENERGIA ESTÃO SE ESGOTANDO...";
    text[5630] = "NÃO SEREI CAPAZ DE TREINÁ-LA EFETIVAMENTE... PORÉM...";
    text[5616] = "TENHO A CAPACIDADE DE DESPERTAR SUA PERCEPÇÃO DE ALMAS.";
    text[5617] = "AÍ, CABERÁ A VOCÊ... APERFEIÇOAR SUAS HABILIDADES.";
    text[5618] = "O PODER DA LUX... A MANIFESTAÇÃO FÍSICA DA ALMA...";
    text[5619] = "QUANDO DESPERTO, NÃO É UM PODER TÃO SIMPLES DE SER CONTROLADO.";
    text[5620] = "Eu conseguirei. Sei que sim!";
    text[5621] = "Farei o que for necessário para proteger o Povo de Luna.";
    text[5622] = "Quero ser forte... e confiável...";
    text[5623] = "Alguém que inspire as pessoas... e instigue a esperança.";
    text[5624] = "VOCÊ TEM UMA CONVICÇÃO INABALÁVEL.";
    text[5625] = "CONTUDO, A MENTE E O CORPO DEVEM SER FORTES.";
    text[5626] = "PRECISO AVALIAR SUA FORÇA PRIMEIRO.";
    text[5631] = "ESTA É A FASE FINAL DA PROVAÇÃO DE ALMAS.";
    text[5632] = "MODO DE BATALHA DE GUARDIA ATIVAR!";
    text[5461] = "VOCÊ SUPEROU A PROVAÇÃO DE ALMAS.";
    text[5462] = "VOU ABRIR AS ALGEMAS QUE PRENDEM SUA PERCEPÇÃO DE ALMAS.";
    text[5463] = "MINHAS RESERVAS DE ENERGIA ESTÃO QUASE NO FIM... ADEUS, PERCEPTORA DE ALMAS...";
    text[5464] = "QUE SUA LUX... BRILHE...";
    text[5465] = "... PARA SEMPRE.";
    text[5466] = "Você está bem, Bella? Funcionou?";
    text[5467] = "Eu sinto... energia transbordando dentro de mim.";
    text[5468] = "Isso é incrível!";
    text[5480] = "As habilidades inatas de Lux da Bella foram desbloqueadas!";
    text[5481] = "Agora você pode usar o Combo Lux: ACELERAÇÃO DE LUX!";
    text[5634] = "Surreal tentar entender tudo o que acabamos de presenciar.";
    text[5652] = "Sim. Civilização dos Antigos, Perceptores de Almas, Lux... Minha cabeça dói!";
    text[5635] = "Será que a Percepção de Almas é útil em batalha?";
    text[5636] = "Vamos ter que lutar para confirmar! BAHAHAHA!";
    text[5637] = "Falando em Percepção de Almas, o que planeja fazer com isso?";
    text[5638] = "Bom, espero poder me comunicar com os Murks para termos paz.";
    text[5639] = "Pera... Sério isso??";
    text[5640] = "Você realmente não gosta de lutar contra aqueles Murks, né?!";
    text[5642] = "Vocês sempre souberam disso...";
    text[5643] = "Sim, mas...";
    text[5644] = "É difícil tirar da cabeça o fato de que esses";
    text[5645] = "monstros mataram pessoas inocentes, sabe?!";
    text[5646] = "Sei disso...";
    text[5647] = "Bella está com o pensamento certo.";
    text[5648] = "Os Murks não são apenas monstros.";
    text[5649] = "Eles são... muito mais do que isso.";
    text[5650] = "Vamos para a sala final.";
    text[5651] = "As coisas farão mais sentido quando virem por si mesmas...";
    text[5673] = "Aqui...";
    text[5674] = "... é onde guardo todos os Antinúcleos que coletei.";
    text[5675] = "São muitos!";
    text[5676] = "Quantos Antinúcleos você coletou ao longo dos anos?";
    text[5677] = "Não sei. Centenas, talvez milhares.";
    text[5678] = "Bella não te contou sobre a volta do Cometa Coda?";
    text[5679] = "Sim. Também estou ciente de que a Força Lunex planeja usar";
    text[5680] = "o Gerador de Buraco de Minhoca, Celestia, para impedir o cometa.";
    text[5681] = "... E, apesar de saber que a humanidade está em perigo, você se recusa a";
    text[5682] = "ceder esses Antinúcleos para termos uma chance de sobreviver?";
    text[5683] = "Era o que eu pensava antes, quando lutamos em Copernicus...";
    text[5747] = "Certa vez, você mencionou que seu objetivo era justiça...";
    text[5794] = "Ainda não entendo o que quis dizer com isso.";
    text[5795] = "Nickle...";
    text[5796] = "Você tem carregado um fardo pesado...";
    text[5746] = "... e sei que isso o afetou bastante.";
    text[5748] = "Quero ajudá-lo. Amigos servem pra isso.";
    text[5749] = "Também queremos ajudar! Não é mesmo, meninas?";
    text[5797] = "Sim!";
    text[5798] = "Com certeza!";
    text[5750] = "Eu também! Eu também!";
    text[5686] = "Nickle, acho chegou a hora de finalmente nos contar a verdade.";
    text[5745] = "O que realmente está acontecendo?";
    text[5687] = "Uma pergunta: O que realmente é um Antinúcleo?";
    text[5688] = "Bom, Antinúcleos são uma fonte estável de Antimatéria, certo?!";
    text[5689] = "Isso é só metade da resposta.";
    text[5690] = "Um Antinúcleo é composto tanto de Antimatéria quanto de Lux. Seu núcleo contém...";
    text[5691] = "... uma alma.";
    text[5692] = "Então... isso me deu uma ideia!";
    text[5695] = "O Antinúcleo está brilhando!";
    text[5696] = "O-o quê... Como você fez isso, Bella?";
    text[5697] = "Percepção de Almas... Acho que estou começando a entender como usá-la.";
    text[5698] = "Eu me imaginei capaz de ver a alma no interior.";
    text[5699] = "De falar com ela.";
    text[5700] = "Consegue ouvir alguma coisa?";
    text[5701] = "Não. Todos esses antinúcleos estão em silêncio.";
    text[5702] = "Mas, por mais estranho que pareça...";
    text[5703] = "Consigo sentir as emoções contidas nas almas...";
    text[5704] = "Dor... Sofrimento... Raiva... Traição... Tristeza... Luto...";
    text[5705] = "As almas dos Murks dentro dos Antinúcleos estão presas...";
    text[5799] = "Não sei se isso vai funcionar, mas... Quero tentar uma coisa...";
    text[5706] = "Não...";
    text[5708] = "Não... Não pode ser...";
    text[5710] = "A alma dentro...";
    text[5709] = "... parece...";
    text[5712] = "O que você viu... é a verdade.";
    text[5713] = "Os Murks já foram humanos.";
    text[5715] = "...!";
    text[5711] = "O QUÊ?! MAS... COMO??";
    text[5716] = "Ó não...";
    text[5717] = "Então os Murks que estivemos caçando e batalhando eram humanos esse tempo todo?";
    text[5718] = "Os Murks são o fruto da experimentação humana.";
    text[5719] = "Mas... quem? Quem conduziu esses experimentos?";
    text[5720] = "O seu aclamado e lendário herói de Luna: Saros.";
    text[5721] = "Isso... Isso é LOUCURA!";
    text[5722] = "Essas são vidas humanas inocentes!";
    text[5723] = "Por que ele faria algo tão terrível assim?";
    text[5724] = "Saros acredita que a Antimatéria é a chave para a sobrevivência da humanidade.";
    text[5725] = "Aos olhos do mundo, ele é o líder do povo. O 'herói lendário'.";
    text[5726] = "Porém, sob aquela máscara heroica...";
    text[5728] = "Saros é um cientista doentio obcecado em dominar o poder da Antimatéria.";
    text[5800] = "Desde que ele descobriu a existência dos meus poderes...";
    text[5801] = "Ele tem trabalhado em um Soro de Murk.";
    text[5802] = "Um fluido que, quando ingerido por humanos, transforma sua composição molecular.";
    text[5803] = "Seus corpos de matéria são convertidos em Antimatéria.";
    text[5805] = "A Antimatéria que foi extraída de mim anos atrás foi o suficiente para ele";
    text[5806] = "conduzir experimentos e tentar aperfeiçoar a fórmula do Soro de Murk.";
    text[5807] = "Todo teste que falhou... deu origem a um Murk.";
    text[5808] = "... Um humano que perdeu sua humanidade... Consumido pela Antimatéria.";
    text[5814] = "Nunca fui forte o suficiente para derrotar Saros... Então esperava que,";
    text[5809] = "dado momento, ele ficasse sem Antimatéria para realizar experimentos, mas...";
    text[5813] = "Ele tem um sistema perfeito em funcionamento...";
    text[5815] = "Ele mata alguns Murks, extrai seus Antinúcleos e";
    text[5816] = "reutiliza aquela Antimatéria para sua próxima leva de testes.";
    text[5817] = "Por sorte, muitos Murks conseguem escapar por meio de um buraco de minhoca quando se transformam.";
    text[5818] = "Então, para conseguir esses Antinúcleos, ele simplesmente treinou seu exército para caçá-los.";
    text[5755] = "Isso embrulha meu estômago.";
    text[5821] = "Como Saros pôde fazer isso??";
    text[5822] = "Ele não valoriza a vida humana?";
    text[5823] = "Ele nos treinou... Cuidou de nós...";
    text[5824] = "Nós o admiramos com um mentor... Como um líder...";
    text[5825] = "... Tudo isso era uma grande mentira?";
    text[5826] = "Os avisos de pessoas desaparecidas no fórum... Nos cafés...";
    text[5827] = "Eram as pessoas inocentes capturadas por Saros, não eram?";
    text[5828] = "Possivelmente.";
    text[5735] = "Por anos, Saros capturou secretamente tudo quanto é tipo de gente.";
    text[5736] = "Primeiro... ele fez experimentos com todos os prisioneiros da Base Militar.";
    text[5737] = "Quando não havia mais cobaias, ele esquematizou armações.";
    text[5739] = "O aumento de pessoas mortas ou desaparecidas e o aumento da incidência de Murks";
    text[5829] = "em Luna não foi mera coincidência.";
    text[5752] = "Os poucos soldados que forma ordenados a cumprir as missões de sequestro de Saros";
    text[5753] = "não tiveram escolhas que não obedecer... Do contrário, eles também se tornariam cobaias.";
    text[5754] = "Infelizmente, assim que completavam a missão, se tornavam cobaias mesmo assim.";
    text[5830] = "Mas que inferno... Isso é cruel demais... ";
    text[5831] = "Era o único jeito de garantir que seu segredo estaria protegido.";
    text[5841] = "Ainda não entendo o PORQUÊ de ele fazer isso tudo... Deve ter um motivo...";
    text[5842] = "Seja lá qual for... NADA poderia justificar seus atos...";
    text[5832] = "Você contou isso para mais alguém?";
    text[5834] = "Vocês foram as primeiras pessoas para quem contei...";
    text[5835] = "Tive companheiros ao longo dos anos que lutaram ao meu lado...";
    text[5836] = "Caçávamos Murks que escaparam para evitar que Saros chegasse até eles primeiro.";
    text[5837] = "Perdi todas as batalhas...";
    text[5838] = "Perdi todos os meus companheiros... Todos se tornaram Murks...";
    text[5839] = "O único motivo pelo qual Saros ainda não me matou foi seu desejo por me capturar e me estudar.";
    text[5844] = "Então decidi... lutar essa guerra sozinho.";
    text[5845] = "Se eu permitisse lutar ao lado de alguém... Eles estariam em perigo...";
    text[5846] = "Me distanciei das pessoas... ";
    text[5847] = "... para que não tivesse que viver toda a dor de perder alguém com quem me importava novamente.";
    text[5848] = "Ainda me sinto assim às vezes...";
    text[5849] = "... Mas continuarei dando o meu melhor para ser mais forte.";
    text[5850] = "Espero que possam me perdoar pela forma como tratei todas vocês...";
    text[5851] = "Desculpa.";
    text[5852] = "Nickle...";
    text[5853] = "Pare! Você vai me fazer chorar...";
    text[5854] = "Cara, você passou por tanta coisa...";
    text[5855] = "Nós que deveríamos nos desculpar...";
    text[5856] = "Te julgamos mal...";
    text[5857] = "... Agradeço o apoio de vocês.";
    text[5858] = "Não consigo mais lidar com tudo isso sozinho.";
    text[5864] = "Preciso parar de fugir...";
    text[5865] = "Preciso enfrentar Saros de uma vez por todas.";
    text[5859] = "Você tem fugido sozinho por todos esses anos. Então o que mudou?";
    text[5860] = "Esperança.";
    text[5866] = "Vocês me deram esperança.";
    text[5867] = "Isso aí!!";
    text[5869] = "Estamos juntos nessa agora!";
    text[5870] = "Então... qual o próximo passo?";
    text[5871] = "Na verdade, não tenho um plano...";
    text[5872] = "AHN? VOCÊ SOLTA ESSA REVELAÇÃO TRÁGICA NA GENTE E ESPERA QUE";
    text[5873] = "A GENTE FIQUE OLHANDO PARA O TETO??";
    text[5874] = "Ei, me dá um desconto...";
    text[5875] = "Passei anos caçando esses Antinúcleos para garantir que Saros nunca os use.";
    text[5876] = "Mas... esse não é o único motivo para mantê-los aqui.";
    text[5763] = "Essas pessoas não mereciam o destino que lhes foi forçado.";
    text[5761] = "Esperava algum dia encontrar um jeito de trazê-los de volta...";
    text[5762] = "Pera... E isso é possível?";
    text[5877] = "Hmm...";
    text[5878] = "Talvez meu pai possa ajudar!";
    text[5879] = "Se botarmos as mãos no Soro de Murk do Saros...";
    text[5880] = "Meu pai talvez possa dar um jeito de encontrar a fórmula com engenharia reversa!";
    text[5881] = "E os Antinúcleos? Um Antissoro funcionaria em um Antinúcleo?";
    text[5882] = "Não saberemos até tentar!";
    text[5883] = "E o Cometa Coda?";
    text[5884] = "Ainda temos um ano antes do impacto do Cometa Coda.";
    text[5885] = "Nossa prioridade agora deve ser impedir Saros!";
    text[5886] = "Quanto maior a espera, mais vidas se tornarão experimentos dele...";
    text[5887] = "Precisamos bolar um plano... ";
    text[5891] = "Vamos nos reagrupar na Estação Espacial Lunex.";
    text[5892] = "Hm... Tem certeza de que vai ser tranquilo voltarmos lá?";
    text[5893] = "A Força Lunex ainda está procurando a gente...";
    text[5894] = "Não se preocupe. Estaremos a salvo lá.";
    text[5895] = "Todos na Estação Espacial é como uma família para mim. Eu cresci lá!";
    text[5896] = "Se vamos derrubar Saros, precisaremos de aliados.";
    text[5888] = "Não sei se envolver mais pessoas seja uma boa ideia...";
    text[5898] = "Confie em mim, Nickle. Ficaremos bem.";
    text[5899] = "... ... ... ...";
    text[5778] = "Ok. Eu confio em você.";
    text[6075] = "Não pode ser! ...";
    text[6076] = "É minha nave!";
    text[6077] = "Surpresa! Hehe.";
    text[6078] = "Passamos pela sua nave abandonada quando estávamos te procurando.";
    text[6079] = "Achamos que seria melhor devolvê-la para você.";
    text[6080] = "Aaah, meninas... Vocês são as melhores!";
    text[6081] = "Mié! É a Bella!";
    text[6082] = "Bella! Graças aos céus você está bem! Estávamos tão preocupados!";
    text[6083] = "Verdade... E vejo que trouxe um convidado!";
    text[6084] = "Olá. Meu nome é Nickle.";
    text[6085] = "Prazer em finalmente conhecê-lo, Nickle! Mié!";
    text[6722] = "Vocês... não estão planejando nos entregar, né?";
    text[6723] = "Por que faríamos isso? Mié.";
    text[6724] = "Nunca faria isso com a nossa equipe. Somos praticamente uma 'família' aqui.";
    text[6086] = "Por falar em família... Senhorita Nyla, onde está meu pai?";
    text[6087] = "Ah, acho que o Dr. Thomas está na Base Militar.";
    text[6088] = "Droga... Esqueci completamente!";
    text[6089] = "Bella... seu pai...";
    text[6090] = "Ele ficou sabendo do Relatório da Missão para capturá-la...";
    text[6091] = "Ele saiu furioso do Laboratório para confrontar Saros.";
    text[6092] = "O quê?? Não... Meu pai pode estar em perigo!";
    text[6093] = "Vou tentar ligar para ele!";
    text[7125] = "@P.@P.@P.@P.@P.@P.";
    text[6094] = "... Ele não está atendendo...";
    text[6095] = "Espera aí... O que está acontecendo? Mié?";
    text[6096] = "Thomas está em perigo?";
    text[6097] = "Nickle...";
    text[6098] = "... Vá em frente. Você pode contar a verdade para eles.";
    text[6099] = "Não... Isso é TERRÍVEL...";
    text[6100] = "Saros tem nos enganado por anos...";
    text[6101] = "O que ele fez... é INACEITÁVEL! MIÉ!";
    text[6102] = "... E é por isso que precisamos ir salvar o meu pai!";
    text[6103] = "E se Saros...";
    text[6104] = "Calma, Bella.";
    text[6105] = "Precisamos nos manter calmos e avaliar a situação estrategicamente.";
    text[6106] = "Não temos certeza se Saros pretende machucar o seu pai.";
    text[6107] = "O Saros que você conhece... é uma fraude.";
    text[6108] = "Ele é um homem perigoso...";
    text[6109] = "Mas o Dr. Thomas é o cientista-chefe encarregado de trabalha na Celestia.";
    text[6110] = "Claro, Saros não se livraria de uma pessoa tão valiosa...";
    text[6111] = "Não disse que não precisamos nos preocupar.";
    text[6112] = "O que temos que fazer é formular um plano...";
    text[6113] = "Uma Missão para resgatar o seu pai em segurança";
    text[6114] = "e prender Saros pelos crimes que ele cometeu.";
    text[6116] = "Eu liderarei a Missão.";
    text[6117] = "Precisaremos de aliados.";
    text[6118] = "Vamos juntar todos os soldados e cientistas da Estação Espacial.";
    text[6119] = "Entendido!";
    text[6125] = "... E isso é tudo.";
    text[6126] = "A verdade sobre os Murks...";
    text[6127] = "... O que Saros tem feito por debaixo dos panos...";
    text[6128] = "... Por que ele instruiu alguns de vocês a me capturar e capturar o Murktador.";
    text[6120] = "Meus amigos... Meus companheiros soldados...";
    text[6121] = "Chamamos vocês aqui hoje...";
    text[6122] = "... Para que possamos lutar um inimigo comum.";
    text[6129] = "Agora, sabendo toda a verdade da situação...";
    text[6130] = "... Temos uma oportunidade de fazer o certo!";
    text[6131] = "Nossos companheiros que foram mortos por Murks...";
    text[6132] = "As famílias destruídas em luto pela perda de seus entes queridos...";
    text[6133] = "Os incidentes de pessoas desaparecidas por toda Luna...";
    text[6134] = "Quer dizer que Saros foi o responsável por todas essas tragédias?";
    text[6135] = "Entendo que essa seja uma situação bem complicada.";
    text[6136] = "O Povo de Luna não tem ciência da existência do Cometa Coda.";
    text[6137] = "Vocês estão dando o seu melhor por trás das cortinas para garantir";
    text[6138] = "que o Povo de Luna tenha um futuro promissor.";
    text[6139] = "Agora, além disso, temos os Murks...";
    text[6140] = "Os Murks... também são parte de nós.";
    text[6141] = "Eles já foram humanos.";
    text[6142] = "Se as pessoas descobrirem sobre os Murks e o Cometa Coda...";
    text[6143] = "A confiança na Força Lunex ficará abalada...";
    text[6144] = "Eles perderão todas as esperanças...";
    text[6145] = "Não podemos deixar isso acontecer!";
    text[6146] = "Não podemos deixar Saros continuar a realizar experimentos!";
    text[6147] = "Tenho esperanças...";
    text[6148] = "De que vocês queiram lutar ao nosso lado!";
    text[6149] = "General Grey!";
    text[6150] = "Seguiremos o seu comando!";
    text[6151] = "G-general?? E-eu??";
    text[6152] = "Após tudo o que nos contou...";
    text[6153] = "Saros não é nosso General.";
    text[6154] = "Nós nos recusamos a seguir um homem que não respeita as vidas";
    text[6155] = "do Povo de Luna.";
    text[6156] = "Tenho certeza de que as tropas de outros setores também carregarão o mesmo sentimento.";
    text[6157] = "General Grey, nossa confiança está em suas mãos.";
    text[6158] = "Dr. Thomas, a antiga General e, até mesmo você, Bella.";
    text[6159] = "Sua família sempre nos inspirou a sermos melhores...";
    text[6160] = "A vermos um futuro pelo qual ansiamos para a humanidade!";
    text[6161] = "Conte com nossa ajuda para salvar o Dr. Thomas e impedir Saros. Simples assim.";
    text[6162] = "Pessoal...";
    text[6163] = "Obrigada...";
    text[6164] = "Vamos quebrar o Saros na porrada! BAHAHAHA!";
    text[6165] = "SIIIIM!";
    text[6166] = "Aqueles que puderem lutar, preparem seus equipamentos.";
    text[6167] = "Vamos partir rumo à Base Militar amanhã!";
    text[6168] = "Quanto aos nossos Cientistas e Engenheiros,";
    text[6169] = "temos outro desafio a superar...";
    text[6170] = "Precisaremos encontrar uma forma de realizar a engenharia reversa do Soro de Murk";
    text[6171] = "que Saros tem desenvolvido...";
    text[6172] = "... Assim que o confiscarmos dele, é claro.";
    text[6173] = "'Desafios Superados' é nosso segundo nome!";
    text[6174] = "Nossa arma será a Ciência!";
    text[6175] = "Deixa com a gente, senhorita Nyla!";
    text[6176] = "Amanhã marcará o dia em que o futuro voltará às nossas mãos!";
    text[6177] = "Eu juro PROTEGER o Povo de Luna!";
    text[6178] = "... SALVAR os inocentes que Saros transformou em Murks!";
    text[6179] = "... VINGAR as inúmeras almas que foram perdidas ao longo dos anos...";
    text[6180] = "... e seguir adiante...";
    text[6181] = "NÓS encontraremos um jeito de impedir o Cometa Coda...";
    text[6182] = "... juntos! Como uma Força Lunex verdadeiramente unida!";
    text[6183] = "Que nossa Lux... BRILHE PARA SEMPRE!";
    text[6184] = "SIIIIM!";
    text[6185] = "Bella, isso foi INCRÍVEL!";
    text[6186] = "Você conseguiu unir todas aquelas pessoas para lutarem ao nosso lado!";
    text[6187] = "Isso foi...";
    text[6188] = "DIFÍCIL! PELOS CÉUS...";
    text[6189] = "Nunca fiz um discurso antes na frente de tantas pessoas.";
    text[6190] = "Minha mãe fazia parecer tão fácil!";
    text[6191] = "Você se saiu bem, Bella!";
    text[6192] = "Mié! Fiquei realmente surpreso!";
    text[6193] = "General Grey, hein?!";
    text[6194] = "Devo dizer que soa muito bem.";
    text[6195] = "Combina bem com nossa guerreira prodígio.";
    text[6196] = "Ei!";
    text[6197] = "Precisamos descansar para amanhã.";
    text[6198] = "Temos fugido por tanto tempo...";
    text[6199] = "É, você tem razão.";
    text[6200] = "Vamos, meninas! Hoje vamos passar a noite na Estação Espacial! BAHAHAHA!";
    text[6201] = "Como que a Raine tem tanta energia assim o tempo todo?";
    text[6202] = "Nem ideia...";
    text[6203] = "Acho que é o jeito dela de lidar com a ansiedade.";
    text[6204] = "No fundo, ela provavelmente está nervosa com amanhã... ";
    text[6205] = "... Sei que EU estou.";
    text[6206] = "... Também.";
    text[6207] = "(Espero que meu pai esteja bem...)";
    text[6208] = "É isso. Boa noite, pessoal! Amanhã, nos reuniremos.";
    text[6229] = "OBJETIVO: VÁ PARA O SEU QUARTO PARA DESCANSAR.";
    text[6050] = "... ESTRANHO.";
    text[6051] = "ENTÃO ESSA É A SEGUNDA PRESENÇA BIOMÉTRICA QUE DETECTEI";
    text[6052] = "QUANDO A PERCEPTORA DE ALMAS ME DESPERTOU.";
    text[6053] = "...?";
    text[6054] = "A... juda...";
    text[6055] = "... Preciso... da sua... ajuda...";
    text[6056] = "... Por favor...";
    text[6057] = "... Eles...";
    text[6058] = "... precisam... de mim.";
    text[6059] = "FASCINANTE! ...";
    text[6060] = "ESTA ALMA...";
    text[6061] = "...!";
    text[6062] = "ENTENDI...";
    text[6063] = "COMPREENDO O QUE PRECISA SER FEITO.";
    text[6064] = "NÃO ME RESTA MUITO TEMPO...";
    text[6065] = "MAS QUERO AJUDAR.";
    text[6066] = "COM A FORÇA QUE ME RESTA...";
    text[6067] = "CONCEDEREI MEU EXOESQUELETO.";
    text[6068] = "AVANCE...";
    text[6069] = "... CRONOS.";
    text[6230] = "O que está acontecendo? Vocês ouviram essa explosão?";
    text[6231] = "Bella, estão nos atacando! Os Murks se infiltraram na Estação Espacial!";
    text[6232] = "Sem chance! Será que Saros está agindo? ...";
    text[6233] = "Droga. Esses Murks estão LOUCOS!";
    text[6234] = "Eles estão BEM MAIS agressivos do que o normal!";
    text[6235] = "Precisamos proteger a tripulação da estação!";
    text[6236] = "A caminho!";
    text[6237] = "Bella, já cobrimos os primeiro e segundo pisos.";
    text[6238] = "Você cuida do terceiro piso!";
    text[6239] = "Entendido!";
    text[6240] = "OBJETIVO: ENCONTRAR E DERROTAR OS MURKS NO PISO 3!";
    text[6241] = "Vai, vai, vai! Cuidaremos desses Murks!";
    text[6242] = "O-obrigado, general Grey!";
    text[6243] = "Por favor, cuidem-se!";
    text[6246] = "Não se preocupe conosco. Daremos conta!";
    text[6265] = "A porta está trancada pelo outro lado.";
    text[6266] = "General Grey, já estamos cuidando desta área!";
    text[6267] = "Não se preocupe conosco!";
    text[7138] = "Os reforços chegaram! Levem os cientistas para algum lugar seguro!";
    text[7139] = "Pode deixar!";
    text[6268] = "Bom trabalho, equipe! Parece que derrotamos todos os Murks.";
    text[6269] = "Todos estão um pouco abalados, mas ninguém se feriu gravemente.";
    text[6270] = "Graças às estrelas...";
    text[6271] = "Alguém pronto para a segunda rodada?";
    text[6272] = "Saros??";
    text[6273] = "Ele abriu um buraco de minhoca??";
    text[6274] = "Impressionada? Demorou até eu aprender como criar um. Hahahaha.";
    text[6275] = "Dentre os incontáveis experimentos que conduzi ao longo dos anos...";
    text[6276] = "... de todas as cobaias com as quais trabalhei...";
    text[6277] = "... não sou exceção.";
    text[6278] = "Como podem ver, também realizei experimentos em mim.";
    text[6279] = "Este poder... o poder da antimatéria... é INCRÍVEL.";
    text[6280] = "Ainda preciso testar esse poder recém-descoberto... Que tal começarmos os testes?";
    text[6281] = "Aaah! Mas que droga é essa?? Não consigo me mexer!";
    text[6282] = "Saros! Pare com isso! Você está machucando eles!";
    text[6283] = "Sabia que esse dia chegaria...";
    text[6284] = "... quando você descobriria a verdade.";
    text[6285] = "Era inevitável. Tudo o que precisava era ganhar a confiança do Murktador.";
    text[6286] = "Contudo... saber a verdade é uma coisa.";
    text[6287] = "Entendê-la... bom... é outra.";
    text[6288] = "Saros, o que você ganha com tudo isso?";
    text[6289] = "A vida humana não significa nada para você?";
    text[6290] = "Tudo o que fiz... é pela evolução da humanidade.";
    text[6291] = "Os resultados do meu trabalho... ";
    text[6292] = "Farão com que os humanos sobrevivam gerações a fio.";
    text[6293] = "HIPÓCRITA!";
    text[6294] = "Você machucou pessoas inocentes!";
    text[6295] = "... As mesmas pessoas que alegava estar salvando!";
    text[6296] = "Sacrifícios precisam ser feitos em prol do avanço.";
    text[6297] = "Não espero que entenda meus motivos...";
    text[6298] = "e, sinceramente... não tenho tempo para explicar nada para você.";
    text[6299] = "Então, o que veio fazer aqui?";
    text[6300] = "Vim esmagar seu pequeno motim.";
    text[6301] = "O futuro... não tem lugar para você ou suas ideais infantis.";
    text[6302] = "Errado! Não iremos cair sem lutar!";
    text[6303] = "Você vai ficar bem quietinha onde está.";
    text[6304] = "Não quer que nada aconteça com o Doutor, não é mesmo?";
    text[6305] = "Meu pai?! Onde está meu pai??";
    text[6306] = "O que você fez com ele?";
    text[6307] = "Nada... ainda.";
    text[6308] = "Depende se você me dirá onde os Antinúcleos estão.";
    text[6309] = "Não...";
    text[6310] = "Mas...";
    text[6312] = "Tempo é progresso. Não tenho o dia todo.";
    text[6313] = "Nickle...";
    text[6314] = "Você tem a minha palavra.";
    text[6315] = "Devolverei seu pai assim que me entregar o que quero.";
    text[6317] = "Considere feito.";
    text[6318] = "Eu contarei onde eles estão.";
    text[6319] = "Ha...";
    text[6320] = "Ha... Ha...";
    text[6321] = "HAHAHAHA!";
    text[6322] = "FASCINANTE!";
    text[6323] = "Você REALMENTE tem o poder de mudar as pessoas, Bella.";
    text[6324] = "REALMENTE FASCINANTE!";
    text[6325] = "Espere, não me conte. Que tal eu tentar adivinhar?";
    text[6326] = "Eles estão escondido... hm... em Oceanus? Talvez em uma caverna oculta embaixo d'água?!";
    text[6327] = "...! QUÊ? MAS COMO???";
    text[6328] = "Devo admitir, foi um esconderijo bem pensado.";
    text[6329] = "Nossos sensores não foram capazes de detectá-lo!";
    text[6330] = "Infelizmente, vocês me subestimaram.";
    text[6331] = "Sempre estiver dois passos à frente de vocês.";
    text[6332] = "Os Antinúcleos já estão em minha posse. HAHAHAHA!";
    text[6333] = "SEU MONSTRO!";
    text[6334] = "Como ele...";
    text[6335] = "A confiança foi o que o fez baixar a guarda, Murktador.";
    text[6336] = "Um de nossos Drones de Reconhecimento conseguiu encontrá-lo em Oceanos...";
    text[6337] = "... e o seguiu até o seu esconderijo... observando cada movimentação.";
    text[6338] = "Não... não... Como pude ser tão descuidado??";
    text[6339] = "Tudo isso foi minha culpa...";
    text[6340] = "HAHAHAHA!";
    text[6341] = "Seu desespero...";
    text[6342] = "Ele me engrandece.";
    text[6343] = "Forçá-lo a escolher entre os Antinúcleos e o Dr. Thomas...";
    text[6344] = "A verdade é que... você nunca teve escolha.";
    text[6345] = "A verdade é que... já não preciso de mais NADA de você.";
    text[6346] = "Os Antinúcleos que coletei são mais que suficientes para completar meu Soro!";
    text[6347] = "SAROOOOOOOOOOS!";
    text[6348] = "AAAAAAAAAAAAHHH!";
    text[6349] = "Nickle, você está bem?";
    text[6350] = "*Respira* *Respira*... Aquele maldito...";
    text[6351] = "Você não é páreo para mim. E sabe disso.";
    text[6352] = "Nem se dê ao trabalho.";
    text[6353] = "Agora, se me dão licença.";
    text[6354] = "Tenho um experimento a concluir.";
    text[6355] = "Mas... meu pai!";
    text[6356] = "Saros, por favor, não machuque meu pai! Deixe-o ir...";
    text[6357] = "Seu pai...";
    text[6358] = "O homem que mais respeito...";
    text[6359] = "... e mais desprezo.";
    text[6360] = "Ele poderá viver mais um pouco...";
    text[6361] = "Para que possa testemunhar o início de uma nova era da humanidade!";
    text[6362] = "ADEUS.";
    text[6363] = "SAROOOOOOOOS! VOLTE AQUI, SEU COVARDE!";
    text[6364] = "O que foi isso? Parece que a Estação Espacial está se movendo!";
    text[6365] = "Ah, não... Rápido! Para a Central de Comando!";
    text[6366] = "Saros assumiu o controle completo da Estação Espacial Lunex!";
    text[6367] = "Não consigo retomar o sistema! Ele fechou todas as saídas...";
    text[6368] = "A Estação Espacial está descendo da órbita lunar...";
    text[6369] = "Estamos em rota de colisão direta com Luna!";
    text[6370] = "O QUÊ?? QUANTO TEMPO TEMOS?";
    text[6371] = "Nessa velocidade, a Estação Espacial vai colidir contra Luna em sete minutos...";
    text[6372] = "... mas essa é o menor dos nossos problemas.";
    text[6373] = "Ele também ativou o Sistema de Defesa da Astrobarreira...";
    text[6374] = "Ó não...";
    text[6375] = "O S.D.A normalmente é usado contra pequenos asteroides ou detritos espaciais que";
    text[6376] = "entram na atmosfera de Luna. Tudo que passa por ele derrete que nem manteiga...";
    text[6377] = "Não... O que podemos...";
    text[6378] = "Pense... pense...";
    text[6379] = "Saros é louco! Ele não percebe que destruir a EEL também destruirá";
    text[6380] = "Celestia?? Como ele pretende impedir o Cometa Coda sem ela?";
    text[6381] = "É isso! Celestia!";
    text[6382] = "Senhorita Nyla, você sabe como ativar o Gerador de Buraco de Minhoca?";
    text[6383] = "Hm, sei, sim. Por quê?";
    text[6384] = "Tive uma ideia...";
    text[6385] = "O propulsor da Estação Espacial está nos empurrando contra Luna...";
    text[6386] = "Só precisamos igualar o superar a força contrária.";
    text[6387] = "Mié! A criança entende de física!";
    text[6388] = "Mas como faremos isso? O que isso tem a ver com a Celestia?";
    text[6389] = "É aí que eu entro.";
    text[6390] = "Celestia é alimentada por Antimatéria. Vou dar parte dessa energia.";
    text[6391] = "Você só terá que criar um buraco de minhoca embaixo da Estação Espacial e...";
    text[6392] = "Darei i o meu melhor para empurrá-la no sentido contrário...";
    text[6434] = "Só preciso aguentar até o combustível da nave acabar.";
    text[6393] = "Espere, Nickle... Ir espaço a fora... é suicídio!";
    text[6394] = "Como tem certeza de que isso irá funcionar?";
    text[6395] = "Não tenho, mas...";
    text[6396] = "... Preciso tentar.";
    text[6397] = "Eu usarei minha Forma Fásica.";
    text[6398] = "Nessa forma, meu corpo se torna Antimatéria pura.";
    text[6399] = "A falta de oxigênio não será um problema.";
    text[6400] = "Mas, mesmo assim... é muito perigoso!";
    text[6401] = "E se você morrer?";
    text[6402] = "Estou preparado para isso...";
    text[6403] = "Minha Forma Fásica...";
    text[6404] = "... O motivo de não gostar de usá-la não é por não conseguir controlá-la.";
    text[6405] = "... Aprendi a controlá-la há anos.";
    text[6406] = "Tem mais a ver...";
    text[6407] = "... com o que a forma representa.";
    text[6408] = "Ela representa minhas falhas.";
    text[6409] = "Minhas fraquezas...";
    text[6410] = "... Minha incapacidade de proteger as pessoas.";
    text[6411] = "Meus poderes... sempre feriram pessoas inocentes...";
    text[6412] = "... especialmente quando não era capaz de controlá-los.";
    text[6413] = "Meus poderes... foram o que levou Saros a perseguir essa insanidade...";
    text[6414] = "... e fazer com que ainda mais pessoas inocentes se ferissem por conta dos Murks...";
    text[6415] = "É algo pelo qual eu ainda tento me redimir até hoje.";
    text[6416] = "Nickle...";
    text[6417] = "Meu passado... Meus erros... Minhas falhas continuam a me segurar...";
    text[6418] = "Até mesmo hoje...";
    text[6419] = "Com Saros um passo à frente e pegando todos os Antinúcleos que coletei...";
    text[6420] = "... Falhei por seguidas vezes e...";
    text[6421] = "... Ao menos desta vez, quero poder fazer algo de bom.";
    text[6422] = "Algo que... eu possa me orgulhar.";
    text[6423] = "Bella...";
    text[6424] = "... Obrigado por confiar em mim... e por sua bondade.";
    text[6425] = "Nickle... por favor...";
    text[6426] = "Eu...";
    text[6427] = "...!";
    text[6428] = "Desculpa...";
    text[6429] = "Isso foi um pouco egoísta da minha parte.";
    text[6430] = "Minha nossa!";
    text[6431] = "Ops. Hihi.";
    text[6432] = "Você está falando como se não fosse voltar com vida...";
    text[6433] = "... seu idiota.";
    text[6435] = "Bella...";
    text[6436] = "É bom ter certeza de que vai voltar!";
    text[6437] = "Precisamos de você!";
    text[6438] = "Eu... preciso de você...";
    text[6439] = "Deseje-me sorte.";
    text[6440] = "MODO FÁSICO!";
    text[7140] = "RAAAIÁÁÁ!";
    text[7141] = "Nickle, está funcionando!";
    text[7142] = "Começamos a desacelerar!";
    text[7143] = "Ainda não foi o suficiente... Nossa velocidade ainda está muito alta!";
    text[7144] = "Aguente firme! Não desista!";
    text[7145] = "Quanto tempo até chegar à Astrobarreira?";
    text[7146] = "MIé! Dois minutos!";
    text[7168] = "E o nível de combustível?";
    text[7169] = "75% restantes...";
    text[7147] = "Aaaaah! Droga! A força de propulsão nisso é SURREAL!";
    text[7148] = "Não consigo... empurrar...";
    text[7162] = "Nickle, não se preocupe conosco!";
    text[7163] = "Não se segure! Você é mais forte que isso!";
    text[7164] = "Mas... se eu forçar demais...";
    text[7165] = "E se eu perder o controle de novo?";
    text[7166] = "Poderia acabar destruindo a Estação Espacial...";
    text[7167] = "... Vocês todos acabariam...";
    text[7149] = "Nickle, você consegue! Dê tudo de si!";
    text[7150] = "Aquilo é...";
    text[7151] = "A tripulação da EEL! Soldados, cientistas, todo mundo!";
    text[7152] = "Eles vieram torcer por você!";
    text[7153] = "Nickle, acreditamos em você!";
    text[7154] = "Você consegue!!!";
    text[7155] = "(Pessoal...)";
    text[7156] = "(Obrigado...)";
    text[7157] = "(Eles têm razão... Não posso desistir! ...)";
    text[7158] = "Se eu não puder salvar a todos aqui...";
    text[7159] = "... O destino do Povo de Luna estará nas mãos de Saros.";
    text[7160] = "Eu vou dar O MEU MÁXIMO!";
    text[7161] = "RAAAAAIÁÁÁÁÁÁÁÁ!!!";
    text[6442] = "(BAM!)";
    text[6443] = "Ai! Acordei! Acordei! O que foi isso?";
    text[6444] = "Tolinho...";
    text[6445] = "Hunf. Achamos que tínhamos te perdido...";
    text[6446] = "Assim que a EEL voltou à órbita, você perdeu a consciência.";
    text[7172] = "Por sorte, você ainda estava em sua Forma Fásica.";
    text[7173] = "Bella saiu disparada atrás de você...";
    text[6449] = "Estou... feliz que você está bem.";
    text[6450] = "Ei, valeu por nos salvar.";
    text[6451] = "Ficamos te devendo essa.";
    text[6452] = "Tem minha gratidão...";
    text[6453] = "A força que mostrou foi admirável. Realmente impressionante!";
    text[6454] = "Você é um herói, garoto! Mié!";
    text[6455] = "Um ato muito nobre da sua parte.";
    text[7177] = "Ficamos todos comovidos com sua determinação.";
    text[6456] = "Obrigado, pessoal. Não seria possível sem todos vocês.";
    text[7178] = "Aff...";
    text[6458] = "Nickle, você deveria descansar nas câmaras de recuperação!";
    text[7136] = "Não, está tudo bem. Só meus braços que doem.";
    text[7137] = "Dê-me algumas barras de cheesecake e estarei pronto para a próxima. Hehe.";
    text[7171] = "Vá com calma, ok?";
    text[7176] = "Pode deixar.";
    text[7175] = "Certo, pessoal...";
    text[6465] = "Todos viram o que Saros é capaz de fazer.";
    text[6466] = "Não podemos deixá-lo vencer!";
    text[6467] = "Nosso futuro... está em nossas mãos!";
    text[6468] = "SIM, GENERAL! ESTAMOS A POSTOS!";
    text[6469] = "Espera aí... O Sistema de Defesa da Astrobarreira não permanece ativo?";
    text[6470] = "Não podemos simplesmente descer a nave até a Base Militar...";
    text[6471] = "Não precisaremos... Temos um Gerador de Buraco de Minhoca!";
    text[6472] = "... e uma fonte de antimatéria bem aqui. Hehe.";
    text[6473] = "Como é?!";
    text[6474] = "Estou brincando!";
    text[6475] = "Eu sei, eu sei. Não se preocupe, sei que estava brincando.";
    text[6476] = "Certo, tropas! Hora de descer para o Laboratório Nexus!";
    text[7181] = "Partiremos em 5 minutos!";
    text[7182] = "SIM, GENERAL!";
    text[6248] = "Tetra, acho que chegou a hora.";
    text[6249] = "ÉÉÉÉ???";
    text[6251] = "ESPEREI TANTO POR ESTE MOMENTO.";
    text[7183] = "Aonde vocês vão? Mié.";
    text[7184] = "Já voltamos.";
    text[7185] = "Deixei algo importante no meu quarto.";
    text[7186] = "Não se preocupem! Esperaremos vocês no Laboratório Nexus!";
    text[7187] = "Só avisem quando estiverem prontas para serem enviadas para a Base Militar! Mié.";
    text[7195] = "Eu sabia! Você quer levar o Traje a Jato da Senhora Thea com você!";
    text[6252] = "Precisarei de uma fiel escudeira ao meu lado já que irei vestir isso.";
    text[6253] = "Topa embarcar nessa comigo?";
    text[6254] = "Eu fui criada pronta! Hihi.";
    text[6255] = "Minha mãe chamava isso de Traje Nébula.";
    text[6256] = "Algumas nébulas são o resultado da explosão de uma estrela moribunda...";
    text[6257] = "... uma supernova.";
    text[6258] = "Mas... uma nébula também pode ser o lugar onde novas estrelas começam a se formar.";
    text[6259] = "Este Traje Nébula marca tanto o fim de uma era... quanto o começo de uma nova.";
    text[6260] = "Espero poder deixá-la orgulhosa...";
    text[6261] = "Bella... Ela já está. Tenho certeza disso!";
    text[6262] = "Se ela estivesse aqui hoje, sentiria orgulho da mulher incrível que você se tornou!";
    text[6263] = "Tetra... Você é a melhor!";
    text[6264] = "Agora pode me chamar de Supernova Tetra, muito obrigada. Hihi.";
    text[6477] = "Pronto, entramos!";
    text[6478] = "O escritório do Saros deve ficar logo à frente.";
    text[6479] = "Parados aí! Não movam um dedo!";
    text[6480] = "Então, vocês estão lutando contra o lado errado!";
    text[6481] = "Deixem-nos passar!";
    text[6482] = "Quanto mais esperamos, mais vidas humanas Saros sacrificará!";
    text[6483] = "Soco Bala!";
    text[6484] = "Valeu pela força, Raine!";
    text[6485] = "Deixa que a gente lida com esses caras!";
    text[6486] = "Vá atrás do Saros!";
    text[6487] = "Então este é o laboratório onde Saros conduz seus experimentos...Não podemos deixar Saros continuar a realizar experimentos!";
    text[6488] = "Vendo os Murks nos tubos... todas essas vítimas...";
    text[6489] = "Não entra na minha cabeça... Isso é doentio...";
    text[6490] = "...";
    text[7290] = "Murks! Eles também conseguem surgir aqui?";
    text[7291] = "Não me surpreende.";
    text[7292] = "Com toda essa Antimatéria aqui, este laboratório inteiro é praticamente um ímã de Murks.";
    text[7293] = "O que faremos?";
    text[7294] = "Vamos lutar... e dar um fim ao sofrimento deles.";
    text[7295] = "Se seus Antinúcleos ainda estiverem intactos, talvez possamos salvá-los mais para frente...";
    text[7296] = "... Mas deixá-los ir agora seria muito arriscado.";
    text[7297] = "Se os Murks nos tubos acordarem, ficaremos em desvantagem.";
    text[7298] = "Aí, nosso trabalho ficará bem mais complicado...";
    text[7299] = "...";
    text[7300] = "Certo. Então vamos nessa!";
    text[7302] = "Achei que já estaria brigando comigo por lutar contra os Murks.";
    text[7312] = "Bom... No fundo, ainda não gosto de lutar contra eles.";
    text[7313] = "Mas... agora que sabemos a verdade,";
    text[7314] = "há muito mais a ser considerado.";
    text[7304] = "... Não é mais só sobre evitar que pessoas inocentes se machuquem.";
    text[7305] = "Há almas humanas dentro deles... que estão sofrendo.";
    text[7306] = "Pelo menos, como um Antinúcleo, eles não poderão machucar ninguém...";
    text[7323] = "... e trabalharemos juntos para encontrar um jeito de trazê-los de volta algum dia.";
    text[7307] = "Essas pessoas não escolheram se tornar monstros... Não é culpa delas.";
    text[7315] = "Notei que vários Murks não possuem Antinúcleos...";
    text[7324] = "Significa que a alma deles já foi despedaçada, certo?";
    text[7316] = "Certo. Assim que um humano se torna um Murk, há uma chance";
    text[7317] = "de sua alma despedaçar por conta da reação do Soro.";
    text[7325] = "... Então, nesse caso, não há um jeito de salvá-los?";
    text[7326] = "Infelizmente... não.";
    text[7318] = "A alma humana fica no Antinúcleo.";
    text[7327] = "Sem ela, não há alguém que possamos trazer de volta.";
    text[7328] = "Nesse caso, o mínimo que podemos fazer é ajudar as vítimas a partirem em paz.";
    text[7308] = "Mesmo não podendo salvar todos eles...";
    text[7309] = "Vamos dar o nosso melhor para salvar o máximo que pudermos!";
    text[7311] = "Belas palavras, Bella. Isso aí!";
    text[6491] = "Vivia!";
    text[6492] = "Ele... me abandonou...";
    text[6493] = "Após tudo o que fiz por ele...";
    text[6494] = "Vivia, onde está Saros?";
    text[6495] = "Precisamos pará-lo!";
    text[6496] = "Saros... era tudo para mim...";
    text[6497] = "Eu... vou fazer os sonhos dele se realizarem.";
    text[6498] = "Se...";
    text[6499] = "Quem sabe se eu impedir vocês aqui e agora.";
    text[6500] = "Talvez ele reconheça meu valor novamente!";
    text[6501] = "Essa mulher está tão surtada quanto o Saros.";
    text[6502] = "Não dá para conversar com ela.";
    text[6503] = "Não posso deixá-los ir.";
    text[6504] = "Vocês viram demais.";
    text[6505] = "Sabem demais.";
    text[6506] = "Por que, Vivia? Por que concordou com tudo isso?";
    text[6507] = "O que Saros está fazendo... é errado!";
    text[6508] = "Saros... um homem moribundo.";
    text[6509] = "?? ...";
    text[6510] = "Há uma década, Saros foi diagnosticado com uma doença incurável...";
    text[6511] = "Diante da própria mortalidade, decidiu buscar um jeito de se curar.";
    text[6512] = "Antimatéria... O Soro... foi o que o salvou.";
    text[6513] = "Ele descobriu um jeito de retardar o avanço da doença...";
    text[6514] = "Inicialmente, ele estavam em uma missão para salvar a própria vida, mas se deu conta de que...";
    text[6515] = "Um Soro Aperfeiçoado de Antimatéria não salvaria só a sua vida,";
    text[6516] = "ele também poderia salvar outras.";
    text[6517] = "O trabalho dele... tem um propósito maior.";
    text[6518] = "Fiquei ao lado dele por anos...";
    text[6519] = "Não foi fácil aceitar essa responsabilidade.";
    text[6520] = "Temos muito sangue em nossas mãos...";
    text[6521] = "... e não deixaremos nossos esforços irem para o ralo!";
    text[6522] = "Você não quer salvar a humanidade, Bella?";
    text[6523] = "Você não está falando nada com nada! Esse não é o caminho!";
    text[6524] = "Vidas... almas... são sagradas.";
    text[6525] = "Estamos sacrificando milhares para salvar milhões. É um mal necessário.";
    text[6526] = "O Cometa Coda não vai parar. Se não agirmos... estaremos todos condenados.";
    text[6527] = "Parece que Saros ainda não contou para vocês...";
    text[6528] = "O quê? O que ele não nos contou?";
    text[6529] = "Infelizmente, você não terá a chance de perguntar para ele pessoalmente.";
    text[6530] = "Se quiser chegar até Saros, terá que passar por mim.";
    text[6531] = "Mas... Isso não está acontecendo.";
    text[6532] = "Enquanto estava em fuga, melhorei minha Holotecnologia mais uma vez.";
    text[6533] = "Desta vez, a vitória será MINHA.";
    text[6534] = "Acabou, Vivia...";
    text[6535] = "Conte-nos onde ele está.";
    text[6536] = "Ele levou seu pai para o Santuário.";
    text[6537] = "... O lugar que Saros pretende tornar o lar da nova humanidade...";
    text[6538] = "... O Reino Fantasma.";
    text[6539] = "... Ela ficará bem. Acabou desmaiando pela exaustão.";
    text[6540] = "O Reino Fantasma...";
    text[6541] = "Humanos não conseguem sobreviver mais de 72 horas no Reino Fantasma...";
    text[6542] = "... Acha que Saros estava mentindo quanto a isso?";
    text[6543] = "Não tenho certeza... Ainda não se passaram 72 horas.";
    text[6544] = "Nickle, você já esteve no Reino Fantasma?";
    text[6545] = "Só uma vez, há muitos anos...";
    text[6546] = "... É uma longa história.";
    text[6585] = "Sempre nos disseram para não ir ao Reino Fantasma...";
    text[6586] = "Deve ter sido uma decisão tática do Saros.";
    text[6547] = "Se ele estava movimentando as coisas pelo Reino Fantasma,";
    text[6548] = "era do interesse dele garantir que ninguém fosse lá.";
    text[6549] = "Não dá para acreditar...";
    text[6550] = "Toda vez que descobrimos algo novo...";
    text[6551] = "... Isso só me deixa com mais...";
    text[6552] = "... Raiva?";
    text[6553] = "É...";
    text[6554] = "Não dá para segurar.";
    text[6555] = "... Ver coisas assim acontecendo.";
    text[6556] = "É ainda pior não ter ideia de que coisas ruins estão acontecendo.";
    text[6557] = "Luna precisa de mudança.";
    text[6558] = "Se tem alguém que vai ajudar a colocar as coisas no rumo certo,";
    text[6559] = "esse alguém é você.";
    text[6560] = "Mas, agora, temos um general corrupto em nossas mãos.";
    text[6561] = "Vamos lidar com ele primeiro.";
    text[6562] = "Certo.";
    text[6563] = "Então, como encontraremos Saros? O Reino Fantasma é gigantesco.";
    text[6564] = "E lá também é perigoso... ";
    text[6565] = "... sendo a regra das 72 horas verdade ou não.";
    text[6566] = "Espera aí... Isso é o que acho que é?";
    text[6567] = "Não parece um gerador de Buraco de Minhoca? Vamos conferir.";
    text[6568] = "Tetra, pode fazer uma análise de equipamento?";
    text[6569] = "Veja se consegue obter informações sobre essa máquina.";
    text[6570] = "Isso... é a versão Alpha da Celestia.";
    text[6571] = "Entendi... Meu pai me contou que Saros fez parte do Projeto Antimatéria anos atrás.";
    text[6572] = "Ele deve ter feito sua própria versão com base nos esquemas abandonados.";
    text[6573] = "ESPERA! ENCONTREI ALGO!";
    text[6574] = "O que é?";
    text[6575] = "COORDENADAS!";
    text[6576] = "Maravilha! Pelo menos temos uma pista. Vamos ler essas coordenadas!";
    text[6577] = "Próxima parada... o Reino Fantasma!";
    text[7388] = "Usar o Gerador de Buraco de Minhoca para entrar no Reino Fantasma?";
    text[7402] = "Há alguns textos antigos nesta estátua.";
    text[7403] = "Eles dizem...";
    text[7398] = "'Aos nossos irmãos cósmicos, que este santuário possa prover para vocês";
    text[7399] = "refúgio de paz em sua jornada interestelar.'";
    text[7404] = "Aaah! Entendi.";
    text[7405] = "Este lugar costumava ser um ponto de descanso para os Antigos em suas";
    text[7406] = "viagens pelo Reino Fantasma.";
    text[7407] = "Este santuário é estranhamente bonito...";
    text[7408] = "É como um oásis no meio de um deserto árido.";
    text[7412] = "... Aaaah! Minha vontade de sair caçando tesouros está me matando!";
    text[7413] = "Vamos continuar antes que eu me distraia de novo.";
    text[7414] = "Sabe... quando tudo isso acabar...";
    text[7415] = "Quem sabe possamos nos aventurar nas profundezas do Reino Fantasma";
    text[7416] = "como nossa primeira expedição planejada.";
    text[7417] = "Que tal, Sr. Caçador de Tesouros?";
    text[7418] = "Acho ÓTIMO. Conte comigo. Hehe.";
    text[7419] = "Esses painéis têm algum tipo de campo de força ativado...";
    text[7420] = "Precisamos dar um jeito de contorná-lo.";
    text[7421] = "Hmm...";
    text[7422] = "Está pensando no que estou pensando, Tetra?";
    text[7423] = "Sim!";
    text[7424] = "Ei! Como vocês fizeram isso??";
    text[7425] = "Aqueles cubos são parte de um sistema de segurança daqui.";
    text[7426] = "Eu hackeei o cubo cinza para decodificá-lo e desativá-lo. Hihi.";
    text[7427] = "O cubo vermelho é um pouco mais perigoso.";
    text[7428] = "Ele é feito de antimatéria densa contida em uma carcaça frágil.";
    text[7429] = "Se um de vocês dois tocasse nele, ele explodiria.";
    text[7430] = "E como conseguiu se livrar dele?";
    text[7431] = "Simples. Eu simplesmente o absorvi. Hehe.";
    text[7432] = "Tetra, fique no círculo amarelo ali.";
    text[7433] = "Eu irei para o verde.";
    text[7434] = "Maravilha! Os painéis desapareceram!";
    text[7435] = "Agora que sabemos como desativar os painéis,";
    text[7436] = "precisamos trabalhar juntos para continuar.";
    text[7437] = "Entendido! Hora do trabalho em equipe!";
    text[6594] = "Bem-vindo ao meu santuário, Thomas.";
    text[6595] = "O Reino Fantasma é de se contemplar, não é mesmo?";
    text[6596] = "Saros, este lugar não tem nada para nós.";
    text[6597] = "Há um motivo para termos cancelado o Projeto Antimatéria anos atrás.";
    text[6598] = "Isso foi quando não entendíamos nada sobre este mundo...";
    text[6599] = "... este plano paralelo lindo de existência do nosso próprio.";
    text[6600] = "Este lugar... será o novo lar da humanidade.";
    text[6601] = "Thomas... Quanto tempo mais você acha que a humanidade consegue sobreviver em Luna?";
    text[6602] = "Bom...";
    text[6603] = "Não muito, graças a você... Os Murks enfurecidos reduziram nosso tempo para décadas...";
    text[6604] = "Mesmo sem a minha interferência...";
    text[6605] = "Em algum momento, ficaríamos sem recursos...";
    text[6606] = "A escassez de recursos sempre nos assombrará se continuarmos em Luna.";
    text[6607] = "Recursos são limitados... mas a Antimatéria...";
    text[6608] = "... Ela tem um potencial ilimitado!";
    text[6609] = "Conhecimento é poder, Thomas.";
    text[6610] = "Apesar de nossas antigas diretrizes, eu vinha visitar o Reino Fantasma com frequência.";
    text[6611] = "... E meu tempo aqui me ensinou diversas coisas.";
    text[6612] = "Neste reino, não envelhecemos. Não sentimos fome.";
    text[6613] = "Nossos corpos, de alguma forma, mantém o próprio metabolismo...";
    text[6614] = "...";
    text[6615] = "Fascinante, não é mesmo?";
    text[6616] = "Como colega da ciência, essa possibilidade não o anima?";
    text[6617] = "Claro, o Reino Fantasma causa mutações no corpo humano...";
    text[6618] = "Mas... É uma armadilha mortal aqui.";
    text[6619] = "Apesar dos benefícios iniciais, em algum momento, nossos corpos começarão a desintegrar.";
    text[6620] = "Tem razão... Esse é o limite.";
    text[6621] = "Com os corpos que temos, não podemos usufruir dos milagres que o Reino Fantasma oferece.";
    text[6622] = "Pensei comigo mesmo anos atrás...";
    text[6623] = "... Se ao menos não tivesse este corpo...";
    text[6624] = "Não teria que me preocupar com a morte... Nem com as minhas próprias limitações mortais.";
    text[6625] = "Nossas limitações são o que nos tornam humanos, Saros.";
    text[6626] = "Isso é uma utopia. Não podemos sobreviver aqui.";
    text[6627] = "Aí que você se engana.";
    text[6628] = "Desenvolvi a tecnologia...";
    text[6629] = "Meu Soro... está quase completo.";
    text[6630] = "Quando estiver, serei capaz de tornar qualquer humano em um";
    text[6631] = "ser perfeito de antimatéria.";
    text[6632] = "Um ser capaz de sobreviver no Reino Fantasma.";
    text[6656] = "Meu Soro... é a chave para nossa evolução como espécie!";
    text[6633] = "Isso... é só um gostinho do que a Antimatéria é capaz de prover.";
    text[6634] = "Se pudermos desvendar a Antimatéria, os segredos do universo,";
    text[6635] = "o poder para quebrar as próprias leis da física,";
    text[6636] = "o conhecimento que nenhum mortal jamais sonhou... serão nossos.";
    text[6637] = "Thomas, já fomos amigos...";
    text[6638] = "Você me ajudou a perceber a importância da pesquisa.";
    text[6639] = "Você me ajudou a saciar minha sede por conhecimento como um jovem cientista.";
    text[6640] = "Aprendi muito graças a você.";
    text[6641] = "Mas nossas diferenças... continuam a ser uma barreira que nos separa.";
    text[6642] = "É porque você obteve conhecimento do jeito errado!";
    text[6643] = "Do jeito errado?";
    text[6644] = "Todos na Família Grey... Todos choramingam a mesma ladainha...";
    text[6645] = "Não somos só nós.";
    text[6646] = "Acha mesmo que o Povo de Luna quer novos corpos?";
    text[6647] = "... Uma nova vida supostamente feliz em um mundo desconhecido?";
    text[6682] = "Duvido muito.";
    text[6667] = "Luna é nossa casa... Temos que protegê-la.";
    text[6668] = "Terra também foi um dia o lar da humanidade...";
    text[6669] = "... mas veja o que se tornou.";
    text[6670] = "Desolada e sem vida!";
    text[6648] = "Nossos fundadores... fugiram para Luna... para um novo mundo.";
    text[6657] = "Luna era praticamente inóspita!";
    text[6671] = "Eles não tinham outra escolha! Fizeram isso para sobreviver.";
    text[6672] = "No nosso caso, o tempo está a nosso favor, Saros.";
    text[6673] = "... Essa obsessão...";
    text[6674] = "... Essa paranoia...";
    text[6675] = "... Tudo isso me mostra que você abriu mão da esperança.";
    text[6676] = "Você não se importa nem um pouco com Luna.";
    text[6677] = "Você é um covarde!";
    text[6678] = "...";
    text[6659] = "O Cometa Coda está cada vez mais perto...";
    text[6660] = "... e você acha que EU sou o problema?";
    text[6661] = "Estou ganhando mais um dia para lutarmos!";
    text[6854] = "Thomas, não temos energia o suficiente para criar um buraco de minhoca grande o suficiente para impedir";
    text[6855] = "o Cometa Coda... Mesmo com todos os Antinúcleos que o Murktador coletou.";
    text[6856] = "... Mas temos o suficiente para o meu plano.";
    text[6857] = "Temos o suficiente para converter a Humanidade em seres de Antimatéria.";
    text[6858] = "... E imigrar para o Reino Fantasma.";
    text[6662] = "Com meu plano, SOBREVIVEREMOS. Isso não é covardice.";
    text[6688] = "Estou usando o conhecimento que obtive à nossa vantagem!";
    text[6679] = "Saros, há uma linha que nunca deve ser cruzada.";
    text[6680] = "Eu nunca trocaria os segredos do universo...";
    text[6681] = "... todo o poder do universo... por vidas humanas.";
    text[6683] = "Na visão macro do universo, uma vida humana é insignificante.";
    text[6684] = "Você...";
    text[6685] = "Como ousa...";
    text[6686] = "As vidas de meus colegas cientistas, meus amigos, as pessoas...";
    text[6687] = "A vida de Thea... não foram insignificantes.";
    text[6663] = "É uma pena...";
    text[6664] = "Você é uma dar grandes mentes da humanidade.";
    text[6665] = "Esperava que você, de todas as pessoas, entendesse o bem maior...";
    text[6689] = "(Suspiro) Você deixou claro que não se unirá a mim.";
    text[6666] = "Portanto, meu reino de conhecimento não tem espaço para você!";
    text[6692] = "ADEUS, THOMAS!";
    text[6697] = "Bella!";
    text[6694] = "AAAAHH... O QUÊ??";
    text[6695] = "O-O QUE VOCÊS ESTÃO FAZENDO AQUI?";
    text[6696] = "VOCÊS DEVERIAM ESTAR MORTOS! ... AAAAAH...";
    text[6698] = "Bella, sinto muito tê-la arrastado nisso tudo...";
    text[6699] = "Saros me forçou a aceitar um acordo...";
    text[6700] = "Ele disse que a protegeria... que nos protegeria...";
    text[6701] = "Se eu permitisse que você infiltrasse a base e seguisse o plano dele...";
    text[6702] = "Pai...";
    text[6703] = "... Só queria proteger a nossa família...";
    text[6704] = "... Por favor, me perdoe.";
    text[6705] = "Pai, não se preocupe, não estou com raiva. Estamos aqui agora.";
    text[6706] = "Não deixaremos que Saros se safe!";
    text[6707] = "Hunf. Parece que subestimei vocês três.";
    text[6708] = "Estou impressionado que tenham me encontrado.";
    text[6709] = "Como disse antes, não cairemos sem lutar, Saros.";
    text[7439] = "Também notamos que você trouxe os Antinúcleos que roubou do Nickle...";
    text[7441] = "Permita-me deixar isso claro cristalino...";
    text[7442] = "Os Antinúcleos NÃO SÃO combustíveis para seus experimentos...";
    text[7443] = "... e tomaremos cada um deles de volta das suas mãos!";
    text[7444] = "Você traiu o Povo de Luna e, isso, é inaceitável!";
    text[7440] = ".......";
    text[6710] = "Por quê? Por que a família Grey continua se metendo no meu caminho?";
    text[6711] = "Sabe... Sua mãe também era uma pedra no meu caminho.";
    text[6712] = "Escolha bem suas próximas palavras, Saros.";
    text[6713] = "Não deixarei que desrespeite a minha família.";
    text[6714] = "Bom, falando em família... Acho que chegou a hora de saberem de algo.";
    text[6715] = "Sua mãe... O motivo dela morrer...";
    text[6716] = "Foi por MINHA causa.";
    text[6717] = "... O-o quê?? ...";
    text[6718] = "SAROS, SEU MALDITO!";
    text[6719] = "O QUE VOCÊ FEZ?";
    text[6720] = "A história que você ouviu sobre a morte dela foi uma farsa.";
    text[6721] = "Quando ela descobriu sobre meus Experimentos com Antimatéria...";
    text[6725] = "... os Murks...";
    text[6726] = "Ela desativou meu projeto... e pretendia destruir meu Soro de Murk...";
    text[6727] = "... destruir todo o meu trabalho.";
    text[6728] = "Eu lutei. A desafiei para um duelo... e perdi.";
    text[6729] = "Mas... apesar de ela ser mais forte que eu...";
    text[6730] = "... eu era mais esperto que ela.";
    text[6731] = "Eu a peguei com a guarda baixa...";
    text[6732] = "... ativei meu Gerador de Buraco de Minhoca...";
    text[6733] = "... e a prendi no Reino Fantasma, sem ter como escapar.";
    text[6734] = "Ela ficou no meu caminho... Então me livrei dela... para sempre.";
    text[6735] = "SAROS, SEU DESGRAÇADO!";
    text[6736] = "HAHAHAHA. Isso! Pode odiar!";
    text[6737] = "Seu desespero me engrandece! HAHAHAHA!";
    text[6738] = "Sabendo que Thea estava apodrecendo no Reino Fantasma...";
    text[6739] = "... O próximo passo claro para mim era me tornar General.";
    text[6740] = "Convencer as pessoas foi mais fácil do que imaginava.";
    text[6741] = "Comecei alguns surtos de Murks...";
    text[6742] = "Derrotei todos eles...";
    text[6743] = "Banquei o herói.";
    text[6744] = "Ninguém suspeitou.";
    text[6745] = "O único fio solto nessa história... era o Murktador.";
    text[6746] = "Felizmente, tudo correu bem.";
    text[6747] = "Nunca esquecerei o que você fez...";
    text[6748] = "Você tirou minha mãe de mim... de nós...";
    text[6749] = "Saros, isso acaba aqui!";
    text[6750] = "Você vai pagar pelos seus crimes!";
    text[6751] = "HAHAHAHA!";
    text[6752] = "VOCÊS SÃO MEROS TOLOS!";
    text[6753] = "TODOS, INOCENTES!";
    text[6754] = "... E TODOS, FRACOS!";
    text[6755] = "A HUMANIDADE ESTARÁ CONDENADA SEM MIM! O MUNDO... PRECISA DE UM CIENTISTA LOUCO...";
    text[6756] = "... ALGUÉM QUE FAÇA O TRABALHO QUE NINGUÉM TEM CORAGEM DE FAZER.";
    text[6757] = "ALGUÉM DISPOSTO A SACRIFICAR PARA VER PROGRESSO!";
    text[6758] = "VOCÊ ESTÁ ERRADO!";
    text[6759] = "HAHAHA! VOCÊS NÃO SÃO PÁREOS PARA MIM.";
    text[6760] = "LOGO, PERCEBERÃO...";
    text[6761] = "A VIDA É UM EXPERIMENTO! ...";
    text[7445] = "... E O UNIVERSO É O MEU LABORATÓRIO!";
    text[6822] = "Parece que sua determinação era maior que a minha...";
    text[6762] = "Como?";
    text[6763] = "COMO FICOU TÃO FORTE?";
    text[6764] = "Não estamos lutando por nós, Saros.";
    text[6765] = "Estamos lutando pelo Povo de Luna.";
    text[6766] = "Estamos lutando pelo nosso futuro!";
    text[6767] = "Bella, você não entende o que está por vir...";
    text[6768] = "Arqueo-Planta 9... Sua mãe foi a primeira a descobri-la...";
    text[6769] = "Uma relíquia estranha com formato de lua crescente...";
    text[6770] = "Havia textos ocultos que só ela era capaz de decifrar.";
    text[6771] = "Esses textos... eram avisos deixados pelos Antigos.";
    text[6772] = "Eles revelavam a verdadeira natureza do que o Cometa Coda realmente é.";
    text[6773] = "...?";
    text[6774] = "Espera que acreditemos em alguma palavra da sua boca?";
    text[6775] = "Você não vai se livrar do seu destino, Saros.";
    text[6776] = "Chega de enganação.";
    text[6777] = "É a verdade. Essas informações são confidenciais.";
    text[6778] = "Os Antigos forma aniquilados por... eles.";
    text[6779] = "Eles? De quem você está falando?";
    text[6780] = "Do nosso verdadeiro inimigo...";
    text[6782] = "O Cometa Coda é um tipo de entidade cósmica.";
    text[6783] = "... criado por uma civilização conhecida como Nêmesis.";
    text[6784] = "Eles foram os responsáveis por aniquilar os Antigos...";
    text[6785] = "Eles também aniquilaram o Povo da Terra mil anos atrás...";
    text[6786] = "...";
    text[6787] = "Por quê? ...";
    text[6788] = "Por que fariam algo assim?";
    text[6789] = "Não sei.";
    text[6790] = "O que sei...";
    text[6791] = "É que os Antigos, uma civilização muito mais avançada que a nossa...";
    text[6792] = "... Não foram capazes de impedir os Nêmesis.";
    text[6793] = "Nossa melhor opção é evoluir... Nos tornar seres de Antimatéria.";
    text[6794] = "... Para que tenhamos uma chance de lutar.";
    text[6795] = "De uma coisa, você se engana.";
    text[6796] = "... O quê?";
    text[6797] = "Estamos evoluindo dia após dia.";
    text[6798] = "O que nos levará ao avanço, mais do que qualquer outra coisa...";
    text[6799] = "... mais do que o sacrifício...";
    text[6800] = "... mais do que o medo...";
    text[6801] = "... é a união.";
    text[6802] = "A humanidade é resiliente.";
    text[6803] = "Aprendemos com nossos erros.";
    text[6804] = "Quando caímos... levantamos e tentamos de novo.";
    text[6805] = "Não deixarei que a história se repita.";
    text[6806] = "Daremos um jeito nisso juntos, Saros.";
    text[6859] = "Eu prometo. Encontraremos um jeito de sobreviver.";
    text[6861] = "Não deixaremos que os Nêmesis nos derrotem.";
    text[6860] = "Sempre há esperança!";
    text[6807] = "O Soro de Murk... não é a solução.";
    text[6808] = "...";
    text[6809] = "AAAAAH...";
    text[6810] = "O-o que está acontecendo com ele?";
    text[6811] = "O corpo dele... não está acostumado com todo esse poder!";
    text[6840] = "Sua antimatéria está começando a consumi-lo!";
    text[6812] = "Bella... meus sensores detectaram um acúmulo gigantesco de energia!";
    text[6814] = "Não consigo... controlar...";
    text[6815] = "Meu Soro... ainda não está completo...";
    text[6816] = "Só fui capaz de chegar a 99% de ressonância...";
    text[6817] = "Mesmo assim, ainda o usei em mim.";
    text[6818] = "Bella...";
    text[6841] = "Você escolheu o seu caminho.";
    text[6842] = "Eu escolhi o meu.";
    text[6843] = "... E ele que me trouxe aqui.";
    text[6844] = "Não tenho arrependimentos.";
    text[6845] = "Se não posso proteger a humanidade...";
    text[6846] = "Cabe a você manter a humanidade a salvo.";
    text[6847] = "Meu sonho jamais morrerá.";
    text[6850] = "Eu sou...";
    text[6851] = "... a EVOLUÇÃO!";
    text[6828] = "Bellaaaa!";
    text[6829] = "Está tudo bem?";
    text[6830] = "... E que diabos é aquela monstruosidade horrível?";
    text[6833] = "Aquilo é o próprio cientista louco, Saros.";
    text[6834] = "SÉRIO ISSO??";
    text[6835] = "O Soro dele saiu pela culatra e, agora...";
    text[6823] = "Ele se transformou completamente em um Murk.";
    text[6821] = "Ataque a caminho!";
    text[7450] = "Mié! É perigoso demais ficarmos aqui!";
    text[7451] = "Pai... Já fazem quase 72 horas...";
    text[7452] = "Você precisa voltar para Luna imediatamente!";
    text[7453] = "Mas e vocês?";
    text[7454] = "Iremos ficar aqui e completar a missão!";
    text[6838] = "Não podemos deixá-lo escapar por um buraco de minhoca.";
    text[6839] = "Se não o derrotarmos aqui e agora, ele acabará destruindo Luna!";
    text[6852] = "Não deixaremos isso acontecer!";
    text[7456] = "Nesse caso...";
    text[7457] = "... Mostre a ele o verdadeiro poder da Força Lunex!";
    text[7458] = "Estaremos à sua espera.";
    text[7459] = "Obrigada, pai!";
    text[7461] = "Raine, se importa?!";
    text[7462] = "Não se preocupe Senhorita Guerreira Prodígio.";
    text[7463] = "Eu escoltarei o trio de volta a Luna em segurança.";
    text[7464] = "... E voltaremos correndo para cá assim que o fizermos!";
    text[7465] = "Você me deve outra revanche, então não ouse perder para essa besta!";
    text[7466] = "Com Nickle e Tetra ao meu lado, não há chances de perdermos!";
    text[7467] = "Certo, equipe?";
    text[7468] = "CERTO!";
    text[6853] = "É isso!";
    text[6862] = "Nossa missão final!";
    text[6863] = "Está pronto, Nickle?";
    text[6864] = "Quando quiser!";
    text[6865] = "Tetra?";
    text[6866] = "A grande heroína Tetra está PRONTA!";
    text[6867] = "Então, preparem-se para a batalha!";
    text[6868] = "(Arfa)... (Arfa)...";
    text[6869] = "Nós... ganhamos?";
    text[6870] = "GRRRRAAAARHHHH.";
    text[6871] = "Não pode ser...";
    text[6872] = "Ele ainda tem energia sobrando...";
    text[6873] = "Estávamos... tão perto...";
    text[6874] = "(Arfa)... (Arfa)...";
    text[6875] = "Meu corpo... está no limite...";
    text[6876] = "Tetra... Quanto de carga lhe resta?";
    text[6877] = "Você consegue voar?";
    text[6878] = "Bem pouco... Estou com pouca energia...";
    text[6879] = "Pegue o Nickle e saia daqui!";
    text[6880] = "O QUÊ?? NÃO!";
    text[6881] = "Não deixaremos você aqui.";
    text[6882] = "Estamos nisso juntos, até o fim.";
    text[6883] = "Tetra... Nickle...";
    text[6884] = "Segurem-se! ESCUDO DE ENERGIA!";
    text[6885] = "HOLOESCUDO!";
    text[6886] = "*Respira*... *Respira*...";
    text[6887] = "Droga... Nosso escudo... está quebrando!";
    text[6888] = "Barreira de Fótons!";
    text[6889] = "É o Esquadrão Raine!";
    text[6890] = "Pode contar com a gente, Bella!";
    text[6891] = "Vamos, meninas! Levantem seus escudos!";
    text[6893] = "Entendido! Escudo Mineral!";
    text[6894] = "Anel de Plasma!";
    text[6895] = "Que surreal! Como pode um Murk ser TÃO poderoso assim??";
    text[6896] = "Devemos tê-lo espancado para valer para deixá-lo com raiva ASSIM!";
    text[6897] = "Foco, Raine! Mantenha o escudo levantado o máximo que puder!";
    text[6898] = "Se ela quebrar... Será nosso fim! Precisamos sobreviver!";
    text[7471] = "AAAAAAAAHHHH!!";
    text[6902] = "... Bella!";
    text[6903] = "Acorde, Bella!";
    text[6901] = "Pessoal...";
    text[6899] = "Estamos de volta a Luna... O que aconteceu?";
    text[6900] = "Não sei... De repente, caímos em um buraco de minhoca e agora estamos aqui.";
    text[6824] = "Reeves? Nyla? Vocês usaram a Celestia?";
    text[6825] = "Mié. Não fomos nós! Caímos em um buraco de minhoca também...";
    text[6826] = "?? ...";
    text[6904] = "É O SAROS! TODO MUNDO, SE PROTEJAM!";
    text[6907] = "Parece que cheguei a tempo.";
    text[6909] = "CRONOS??";
    text[6910] = "(Este Murk... será que...)";
    text[6911] = "Como assim... Esse Murk está do nosso lado?? ... E AINDA FALA?";
    text[6912] = "Isso aí!!";
    text[6913] = "Cronos... Obrigada por nos salvar. Como você...";
    text[6914] = "Explicarei tudo depois.";
    text[6915] = "Agora, temos um trabalho para terminar.";
    text[6916] = "Bella...";
    text[7486] = "Sei que você deve estar exausta...";
    text[7487] = "Talvez esteja usando cada pingo de força que lhe sobrou só para...";
    text[7488] = "... ficar de pé.";
    text[7495] = "É...";
    text[7496] = "Todo o pessoal também está bem desgastado...";
    text[7489] = "Apesar das circunstâncias atuais... Você deve perseverar!";
    text[7490] = "Parece que Saros pode regenerar sua Antimatéria mais rápido que outros Murks...";
    text[7491] = "Por isso, só há um jeito de derrotá-lo...";
    text[7492] = "Temos que combinar nossas forças em um único ataque final!";
    text[6918] = "... Um ataque capaz de danificar seu Antinúcleo por dentro.";
    text[7494] = "Meninas, seus Trajes a Jato estão equipados com Receptores de Plasma?";
    text[7503] = "Sim!";
    text[7499] = "Os Receptores permitirão que vocês apliquem força";
    text[7504] = "nos projéteis de plasma gerados pelas armas da Força Lunex.";
    text[7500] = "Você tem bastante conhecimento sobre nossa tecnologia militar.";
    text[7501] = "Você já foi um soldado antes de Saros transformá-lo em um Murk?";
    text[7502] = "......";
    text[7505] = "Algo do tipo...";
    text[7506] = "Certo, pessoal!";
    text[7507] = "Temos que dar tudo o que temos!";
    text[7508] = "CANHÃO DE FÓTONS!";
    text[7493] = "Não consigo...";
    text[7509] = "Aguentar...";
    text[7510] = "É muito forte...";
    text[7511] = "(Arfa)... (Arfa)...";
    text[6924] = "Senhorita Bellaaaaaa!";
    text[6925] = "Você consegue, senhorita Bellaaaaaa!";
    text[7476] = "Essa voz... Eu conheço essa voz!";
    text[7477] = "Aquele é o Mett??";
    text[7483] = "Mié! Não só o Mett! Também há soldados e civis!";
    text[7484] = "O que eles estão fazendo aqui?";
    text[7472] = "Mais cedo, recebemos um relatório de que alguns de nossos soldados estavam";
    text[7473] = "correndo para buscar mais aliados por Luna!";
    text[7474] = "Os soldados que um dia foram leais a Saros decidiram se juntar à nossa aliança!";
    text[7475] = "Até mesmo civis pegos pelas notícias boca a boca decidiram marchar juntos!";
    text[7485] = "Senhorita Bella!";
    text[7479] = "Estamos todos aqui porque não temos medo de lutar pelo que é certo!";
    text[6927] = "Vocês me deu coragem para enfrentar meus medos!";
    text[7478] = "... e deu a todos nós esperança de um futuro melhor!";
    text[6926] = "Não desista, senhorita Bella!";
    text[7480] = "Aguente firme!";
    text[7481] = "Você precisa derrotar Saros de uma vez por todas!";
    text[6929] = "...!";
    text[6930] = "Que poder é esse?? ...";
    text[6931] = "Esse é o poder da sua Lux!";
    text[6932] = "O Povo de Luna... depositou a confiança deles em você.";
    text[6933] = "A esperança... a determinação... a Lux deles...";
    text[6934] = "... Eles estão emanando tudo isso para você, Bella.";
    text[6935] = "Absorva!";
    text[6936] = "Use tudo para proteger as pessoas que mais ama.";
    text[6937] = "Esse é o seu dom.";
    text[6938] = "O poder de unir as pessoas. De dá-las ESPERANÇA!";
    text[6922] = "O poder da Alma é ilimitado!";
    text[6940] = "PESSOAL! VAMOS ACABAR COM ISSO!";
    text[6941] = "Você consegue, Bella!";
    text[6942] = "RAAAAAAAAHHH!";
    text[7512] = "Está funcionando!";
    text[7513] = "Estamos empurrando aos poucos!";
    text[6943] = "(Incrível... A Lux de todos está unida em uma só força!)";
    text[6944] = "(Adeus... Saros.)";
    text[6945] = "TOME ISSO! O PODER DA NOSSA LUX!";
    text[6946] = "Finalmente acabou...";
    text[6947] = "ISSO AÍ, BEBÊ! Conseguimos! BAHAHAHA!";
    text[6948] = "O Antinúcleo do Saros...";
    text[6949] = "Não deveríamos destruí-lo?";
    text[6950] = "Não... A alma dele permanece aprisionada dentro.";
    text[6951] = "Deixe-a assim por enquanto.";
    text[6952] = "Ele não é mais uma ameaça para o Povo de Luna.";
    text[6953] = "Pessoal... Queria um momento para conversar com vocês...";
    text[6954] = "... mas não nesta forma.";
    text[6955] = "Por favor, juntem-se...";
    text[6956] = "Faz um tempo desde a última vez que usei minha Percepção de Almas...";
    text[6957] = "?? ...";
    text[6960] = "Mãe???";
    text[6961] = "General Grey!";
    text[6962] = "Theaaaa!!!";
    text[6963] = "É tão bom vê-los todos novamente.";
    text[6964] = "Mãe... eu senti tanto a sua falta...";
    text[6965] = "Também senti, Bella...";
    text[7532] = "Thea... É você de verdade?";
    text[6966] = "Thomas, querido. Estou tão feliz em vê-lo novamente.";
    text[6967] = "Mãe...";
    text[6968] = "... como você sobreviveu no Reino Fantasma?";
    text[6969] = "Pensamos que você havia morrido...";
    text[6970] = "Aquele dia fatídico... Quando descobri sobre os experimentos com Murk de Saros...";
    text[6971] = "Planejava impedir seus esquemas assim que encontrasse seu laboratório.";
    text[6972] = "Durante nosso duelo, ele me pegou com a guarda baixa...";
    text[6973] = "... e usou seu Gerador de Buraco de Minhoca para me enviar ao Reino Fantasma.";
    text[6974] = "Naquela época, os Murks não habitavam o Reino Fantasma como o fazem agora.";
    text[6975] = "... Então era impossível para mim fugir usando um buraco de minhoca...";
    text[6976] = "Não tive outra opção...";
    text[6977] = "Durante meu duelo contra Saros...";
    text[6978] = "Consegui roubar um frasco do Soro de Murk que ele estava desenvolvendo.";
    text[6979] = "Eu tinha 72 horas para tomar uma decisão antes de o meu corpo começar a desintegrar.";
    text[6980] = "No fim das contas...";
    text[6981] = "... Eu consumi o Soro.";
    text[6982] = "... E me transformei no Murk que vocês chamam de Cronos.";
    text[6983] = "Foi a única forma de sobreviver...";
    text[6984] = "E como foi isso?";
    text[6985] = "Você tinha consciência dentro do seu corpo de Murk?";
    text[6986] = "Quando me tornei um Murk... não tinha qualquer controle sobre o meu corpo.";
    text[6987] = "... Mas minha mente... minha alma... ainda mantinham a consciência.";
    text[6989] = "Mãe, você é a pessoa mais forte que conheço.";
    text[6990] = "Se alguém perseveraria e sobreviveria... definitivamente seria você.";
    text[6994] = "Quando minhas habilidades de Lux inatas começaram a surgir,";
    text[7516] = "não fazia ideia do que estava acontecendo... ou no que estava metida...";
    text[6992] = "... e toda vez que encontrava um Murk, sentia algo no fundo da minha alma.";
    text[7517] = "Minha Lux reverberava com cada um deles.";
    text[6993] = "Eu era capaz de ouvir suas vozes pedindo socorro...";
    text[6991] = "Você estava dando seu melhor para se comunicar comigo também...";
    text[6995] = "Fiquei impressionada que conseguiu despertar sua Percepção de Almas.";
    text[7017] = "Sabe... o motivo para nunca tê-la contado sobre sua ascendência dos Antigos...";
    text[7018] = "... foi porque minha pesquisa sobre os Antigos que me mostrou que esse poder,";
    text[7019] = "quando desperto, poderia ser perigoso.";
    text[7518] = "Não queria arriscar minha própria filha assim.";
    text[7020] = "General Grey, você é muito parecida com a Bella...";
    text[7021] = "Ela nunca quer ser um fardo para os outros...";
    text[7022] = "Ela tenta manter todo mundo longe do perigo.";
    text[7023] = "De onde será que ela herdou esse traço, hein?";
    text[7024] = "O Dr. Thomas também faz isso!";
    text[7025] = "Ei!";
    text[7026] = "Acho que é de família.";
    text[6996] = "Mãe, você sabe algo sobre o Cometa Coda?";
    text[6997] = "Sim.";
    text[6998] = "Enquanto você carregava meu Antinúcleo, conseguia ouvir tudo.";
    text[6999] = "Estava sempre ouvindo.";
    text[7003] = "Espera aí... Se você era um Antinúcleo...";
    text[7004] = "Como conseguiu reverter para um Murk??";
    text[7005] = "Um guardião dos Antigos, chamado Guardia, foi bondoso o suficiente para me deixar usar seu exoesqueleto.";
    text[7056] = "É um milagre que eu esteja aqui. Não sabia nem se isso funcionaria.";
    text[7007] = "Foi graças a você, Bella, que fui capaz de vê-los todos novamente.";
    text[7008] = "Sua bondade... Sua determinação em encontrar paz à sua maneira.";
    text[7009] = "Sua determinação para fazer o que é certo.";
    text[7010] = "Digamos que... sou uma mãe de MUITA SORTE! Hahaha.";
    text[7032] = "Pessoal...";
    text[7027] = "... Não podemos deixar os Nêmesis destruírem a humanidade.";
    text[7028] = "Eles não irão!";
    text[7029] = "Não enquanto estivermos de olho!";
    text[7030] = "Aqueles malditos Nêmesis irão sentir um gostinho recheado da mão da Raine!";
    text[7031] = "BAHAHAHA!";
    text[7033] = "Eles não terão a menor chance contra nós, certo, Nickle?";
    text[7034] = "Certo!";
    text[7035] = "Senhora Grey... Obrigado por ter salvo a minha vida anos atrás.";
    text[7036] = "Foi uma jornada difícil para mim...";
    text[7520] = "... me abrir para as pessoas... ";
    text[7521] = "Fazer amigos que posso confiar novamente...";
    text[7522] = "Se não tivesse cruzado seu caminho ou o da Bella...";
    text[7523] = "Talvez o plano de Saros tivesse dado certo.";
    text[7524] = "Tudo teria sido diferente...";
    text[7525] = "Sou grato a todos vocês por me aceitarem.";
    text[7526] = "... Apesar das coisas que fiz...";
    text[7527] = "Nickle... você precisa aprender a se perdoar.";
    text[7528] = "A existência dos Murks não é culpa sua.";
    text[7529] = "Você se saiu bem. Deveria sentir orgulho do que foi capaz de fazer!";
    text[7530] = "Obrigado, senhora Grey.";
    text[7037] = "... E posso confiar que você manterá a Bella longe de problemas?";
    text[7038] = "S-sim, senhora!";
    text[7039] = "Ah!";
    text[7040] = "... E quem é essa guerreira adorável?";
    text[7041] = "Meu nome é Tetra!";
    text[7042] = "Bella me contou tanto sobre você!";
    text[7043] = "Tenho sido a escudeira dela faça chuva, faça sol!";
    text[7044] = "Bella e eu construímos a Tetra juntos.";
    text[7045] = "Quando você se foi... Foi um grande baque para nós.";
    text[7046] = "Tetra foi a luz que brilhou na escuridão...";
    text[7047] = "Ela nos aproximou ainda mais, mesmo em nossos dias mais sombrios.";
    text[7048] = "Hihihi.";
    text[7049] = "Entendi. Então, acho que você merece uma promoção, Tetra.";
    text[7050] = "Uma promoção?? Eu??";
    text[7051] = "Você é mais do que uma mera escudeira.";
    text[7052] = "Você é uma verdadeira heroína.";
    text[7053] = "Uma verdadeira heroína...";
    text[7054] = "A partir de agora, serei conhecida como Super Heroína Tetra! Muahahahaha!";
    text[7055] = "Hahaha!";
    text[7011] = "O-o que está acontecendo, querida?";
    text[7012] = "Este corpo... é só um receptáculo temporário.";
    text[7013] = "Voltarei para a minha forma de Antinúcleo em breve...";
    text[7014] = "Não... Mãe, você não pode nos deixar de novo...";
    text[7015] = "Bella...";
    text[7016] = "... sempre há esperança.";
    text[7000] = "Você se tornou uma guerreira forte.";
    text[7001] = "Com o fim de Saros, o Povo de Luna precisa de um novo General.";
    text[7058] = "Ma-mas e você?";
    text[7059] = "Meu tempo já se foi. Agora é sua vez de liderar o povo.";
    text[7060] = "Sei que você tem o necessário para isso.";
    text[7061] = "Sempre estarei no seu coração.";
    text[7062] = "O poder para unir as pessoas... plantar a esperança...";
    text[7063] = "... liderar as pessoas para um futuro próspero.";
    text[7064] = "Estou orgulhosa de você, Bella.";
    text[7065] = "Mãe...";
    text[7066] = "Não a decepcionarei, mãe!";
    text[7067] = "Thea...";
    text[7068] = "Thomas... eu te amo... Cuide da Bella enquanto eu estiver fora.";
    text[7069] = "Precisarei descansar um pouco...";
    text[7070] = "Thea... eu prometo...";
    text[7071] = "Encontrarei um jeito de trazê-la de volta.";
    text[7073] = "Nos encontramos novamente!";
    text[7074] = "Adeus a todos.";
    text[7075] = "Você está bem, Bella?";
    text[7076] = "Sim...";
    text[7078] = "Fico feliz que pudemos vê-la de novo após todos esses anos.";
    text[7534] = "Minha mãe sempre será minha heroína.";
    text[7535] = "Em vez de sentir tristeza...";
    text[7536] = "Meu coração está cheio só de esperança.";
    text[7537] = "Bom trabalho, pessoal!";
    text[7538] = "Nossa vitória foi graças ao esforço de todos.";
    text[7539] = "Ei, precisamos dar os devidos créditos à nossa nova General aqui.";
    text[7540] = "Isso mesmo! Não poderíamos ter feito isso sem você, Bella!";
    text[7542] = "Isso pede uma COMEMORAÇÃO! BAHAHAHA!";
    text[7543] = "Preciso de uma barra de cheesecake... Estou morrendo de fome!";
    text[7544] = "... E eu preciso de um cochilo! Minhas pernas parecem gelatinas...";
    text[7545] = "Acho que todos merecemos um bom descanso.";
    text[7546] = "Então...";
    text[7550] = "Vamos comemorar!";
    text[7089] = "Nossa vitória hoje...";
    text[7090] = "... Marca o começo de uma nova era.";
    text[7092] = "Nossa jornada continuará...";
    text[7093] = "... Nosso trabalho ainda não acabou.";
    text[7094] = "O Cometa Coda está se aproximando...O Cometa Coda está cada vez mais perto...";
    text[7095] = "... e, desta vez... estaremos preparados.";
    text[7096] = "Mas será um caminho difícil pela frente...";
    text[7097] = "... Ainda temos que aprender muito...";
    text[7098] = "... sobre os Antigos...";
    text[7099] = "... sobre os Nêmesis...";
    text[7100] = "Mas uma coisa está bem clara...";
    text[7101] = "Luna é a nossa casa.";
    text[7102] = "Não deixaremos que ninguém a tire de nós!";
    text[7103] = "Encontraremos um jeito de sobreviver.";
    text[7104] = "... Por meio da união e da confiança!";
    text[7105] = "Que nossa Lux brilhe para sempre.";
    text[7106] = "Oito meses depois...";
    text[7107] = "General Grey, terminamos os preparativos.";
    text[7108] = "Maravilha! Obrigada pela atualização.";
    text[7109] = "Comandante Nickle, o Mecanismo de Antimatéria está pronto para você.";
    text[7110] = "Tem certeza de que ficará bem, Nickle?";
    text[7111] = "Será o maior buraco de minhoca que já criamos.";
    text[7112] = "Deixa comigo.";
    text[7113] = "Pode confiar. Hehe.";
    text[7114] = "CERTO, PESSOAL!";
    text[7115] = "Iniciar Celestia!";
    text[7116] = "Entendido!";
    text[7117] = "Acionem os equipamentos, definam as coordenadas para o Cometa Coda e apertem os cintos!";
    text[7118] = "Espero que estejam prontos, Nêmesis...";
    text[7119] = "... Porque a humanidade vai levar a luta até VOCÊS!";
    text[110000] = "Bella, vamos nessa!";
    text[110001] = "Nossa nave está ancorada no Hoverporto Sudeste!";
    text[110003] = "Nhom, nhom, nhom. Toda essa comida parece deliciosa!";
    text[110004] = "Bzz, Bzz! Aquela Hiperabelha era forte!";
    text[110007] = "Vamos pegar umas barras de cheesecake no café!";
    text[110008] = "Ainda não terminei de comer! Vamos ficar mais um pouquinho.";
    text[110009] = "Ok!";
    text[110010] = "Os moradores são bem simpáticos. Quem sabe possamos conversar com alguns deles...";
    text[110012] = "Nossa nave nos aguarda! Vamos que vamos!";
    text[110013] = "Vamos rumo ao oeste para investigar as Instalações da Barreira!";
    text[110014] = "Espero que o piloto esteja bem... Aquele Murk parecia bem assustador!";
    text[110015] = "Bella, você tem estado estranha ultimamente.";
    text[110016] = "Não se preocupe... Estou bem.";
    text[110017] = "Atualmente, o nível de oxigênio está em 97 porcento!";
    text[110018] = "Vamos ver o que causou a violação!";
    text[110019] = "Dois Murks acabaram de passar! Vamos encontrá-los!";
    text[110020] = "Sinto que o Murk estava com raiva porque seu amigo foi morto...";
    text[110021] = "O Murk ainda deve estar por aqui em algum lugar...";
    text[110022] = "Vamos encontrá-lo!";
    text[110023] = "Deve haver alguém por aqui que conheça sobre os Painéis Lunares.";
    text[110024] = "Quero dizer, em algum momento, os encontraremos se conversarmos com TODO MUNDO.";
    text[110025] = "Ei, ei. Espera aí.";
    text[110026] = "Não temos tempo para falar com cada pessoa que acharmos.";
    text[110027] = "É, verdade...";
    text[110028] = "Ah! Vou ativar meu Sistema de Missões Orientadas!";
    text[110029] = "Ahn? Não me lembro de instalar um SMO.";
    text[110030] = "Deve ter sido algo que meu pai programou sozinho.";
    text[110031] = "Basicamente, o SMO nos direcionará para áreas de interesse.";
    text[110032] = "Seremos capazes de ver um indicador sobre determinadas pessoas ou objetos.";
    text[110033] = "Os indicadores nos ajudarão demais em nossas missões!";
    text[110034] = "Alguns indicadores nos guiarão até mesmo para pessoas que precisam da nossa ajuda.";
    text[110035] = "Se a vida fosse um jogo, isso seria chamado de 'Missões Secundárias'.";
    text[110036] = "... Haha. Engraçadinha.";
    text[110037] = "Não foi o SMO que nos ajudou a encontrar o Moleculoide mais cedo?";
    text[110038] = "Verdade! Acho que estava ATIVADO esse tempo todo. Hihi.";
    text[110039] = "A pessoa que estamos procurando terá um indicador amarelo em cima dela!";
    text[110068] = "Uhul! Temos 10 Painéis Lunares!";
    text[110069] = "Agora, só precisamos de um Gerador Termoelétrico...";
    text[110070] = "Nyla disse que conseguiremos um com um Comerciante de Astrotecas!";
    text[110071] = "Vamos conferir as Instalações da Barreira!";
    text[110066] = "Finalmente temos os 10 Painéis Lunares e 1 Gerador Termoelétrico!";
    text[110067] = "Vamos nos encontrar com a Nyla!";
    text[110040] = "Painéis Lunares, Painéis Lunares, onde estão, Painéis Lunares?";
    text[110041] = "Precisamos conseguir 10 Painéis Lunares na Unidade de Armazenamento";
    text[110042] = "e 1 Gerador Termoelétrico de um Comerciante de Astrotecas!";
    text[110043] = "Astroteca é uma forma mais rara de moeda que bytes.";
    text[110044] = "Se você explorar bem Luna,";
    text[110045] = "talvez encontre algumas Astrotecas escondidas.";
    text[110046] = "Devemos sempre ficar de olho em itens úteis! Hihi.";
    text[110047] = "Vamos encontrar com o pessoal no Hovercraft!";
    text[110048] = "Bella, voltaremos para a nossa nave quando você estiver pronta!";
    text[110049] = "Tetra não está com você no momento.";
    text[1021] = "Não estou conseguindo obter dados precisos neste ambiente...";
    text[1022] = "A composição química do ar e do solo é desconhecida.";
    text[1023] = "Tetra não faz ideia como você consegue respirar aqui...";
    text[1380] = "Bella, precisamos nos apressar e encontrar uma saída!";
    text[110050] = "A Estação Espacial Lunex é gigante, então certifique-se de explorar os caminhos!";
    text[110051] = "O Laboratório de Pesquisas fica no Piso 3!";
    text[110052] = "Fica no corredor oeste. Hihi. Vamos!";
    text[2482] = "Hmm. O que será que faremos em Oceanus?";
    text[2543] = "Precisamos explicar nosso plano para o Dr. Thomas! Vamos para a Estação Espacial!!";
    text[110053] = "Há um surto de Murks em Copernicus!";
    text[110054] = "Precisamos ir ajudar! É uma Missão Emergencial!";
    text[110055] = "Vamos dar o nosso melhor e salvar o máximo de pessoas possível!";
    text[2709] = "Precisamos encontrar 4 Máquinas Filtrantes e restaurar a Rede de Distribuição de Água!";
    text[2978] = "Precisamos ir à cobertura do prédio do Sistema de Água!";
    text[2979] = "Precisamos conversar com o Murktador!";
    text[3206] = "Bella, você parece exausta... Você precisa descansar!";
    text[3207] = "Vamos voltar para o seu quarto em casa e dormir um pouco.";
    text[3854] = "Vamos ver o que o Dr. Thomas está fazendo no Laboratório de Pesquisas!";
    text[3855] = "Hora de ver se há novas missões para nós!";
    text[3856] = "Stella nos passará o debriefing! Vamos para o Salão do P1. Hihi.";
    text[3857] = "Parece que há diversas missões que podemos assumir!";
    text[3858] = "Se precisar de mais informações sobre qualquer uma das missões, o melhor será";
    text[3859] = "conferir o QUADRO DE MISSÕES e pedir os detalhes para a Stella.";
    text[3860] = "Um indicador VERMELHO ficará acima de pessoas ou pontos de interesse ligados à missão!";
    text[4201] = "O Dr. Thomas voltou de sua conferência!";
    text[4202] = "Vamos conversar com ele no Laboratório de Pesquisas!";
    text[4203] = "Temo uma CHAVE LUNEX! Agora podemos entrar na Base Militar. Hihi.";
    text[4204] = "A Base Militar fica na Zona Desolada! Vamos nessa!";
    text[4236] = "Área de Esgotos... Eca!";
    text[4237] = "Também não quero ficar na Área de Esgotos, mas não temos outra escolha...";
    text[4248] = "Vamos encontrar a cela do Murktador!";
    text[4293] = "Precisamos procurar o painel de controle que está ligado à porta verde.";
    text[4307] = "Vamos ver se o Murktador está na cela com a porta verde!";
    text[4291] = "O Murktador deve estar em uma das salas na Base Militar.";
    text[4292] = "Vamos vasculhar todos os cantos!";
    text[4512] = "Precisamos fugir da Base Militar o QUANTO ANTES! Vamos para o primeiro piso!";
    text[4518] = "Temos que ir a oeste, rumo à Cratera da Escuridão Eterna.";
    text[110056] = "Vamos dar um jeito de fugir daqui enquanto Vivia ainda está imobilizada!";
    text[110057] = "Agora que estamos nas Fendas de Sílica, precisamos rumar a leste, rumo à Colônia.";
    text[110058] = "Ei! Eu sou a escudeira aqui. Deixe os lembretes comigo. Hunf.";
    text[110059] = "Precisamos encontrar Cypher. Ele pode nos ajudar a conseguir uma espaçonave!";
    text[110060] = "Sinto falta da nossa nave...";
    text[110061] = "Ela ficou abandonada na frente da Base Militar...";
    text[110062] = "Podemos voltar e buscá-la depois.";
    text[110063] = "Pelo menos temos uma minicápsula totalmente carregada para voar por aí!";
    text[110064] = "Acho que sim...";
    text[110065] = "... De qualquer forma, o esconderijo do Nickle fica em algum lugar em Oceanus. Bora nessa!";
    text[110072] = "Parece que vamos ter que mergulhar...";
    text[110073] = "... Já que a entrada para o esconderijo do Nickle fica embaixo d'água!";
    text[5486] = "Uau! Essas ruínas têm rochas luminescentes por todos os lados!";
    text[5487] = "Isso é bom... porque esqueci de trazer uma lanterna!";
    text[5501] = "Precisamos encontrar QUATRO GEMAS em algum lugar nessas ruínas!";
    text[5502] = "E AO ENCONTRÁ-LAS, TETRA SERÁ ENTÃO CONHECIDA COMO";
    text[5503] = "A GRANDE ESCUDEIRA DA PERCEPTORA DE ALMAS.";
    text[5504] = "Bella?";
    text[5505] = "Pois não?";
    text[5506] = "O que é uma Perceptora de Almas?";
    text[5507] = "Para ser bem sincera, não faço ideia. Tenho algumas suposições, mas...";
    text[5508] = "... vamos passar na Provação de Almas primeiro!";
    text[5509] = "Belezinha. Hihihi.";
    text[6001] = "Uhul! Você passou na Provação de Almas!";
    text[6002] = "Finalmente, poderemos passar pelo portão gigante bloqueando nosso caminho!";
    text[5779] = "Certinho! Próxima parada: Estação Espacial Lunex!";
    text[6003] = "Precisamos bolar um plano para impedir Saros!";
    text[6209] = "Hm. Onde eu durmo?";
    text[6210] = "Hm... No meu quarto?!";
    text[6211] = "Hun? M-mas, isso não seria...";
    text[6212] = "... Então não quer dormir no meu quarto?";
    text[6213] = "As câmaras de recuperação têm cápsulas de sono que você pode usar.";
    text[6214] = "... Não, quero dizer...";
    text[6215] = "Não conheço por dentro da Estação Espacial...";
    text[6216] = "Provavelmente acabarei me perdendo, então... melhor se ficar perto de você...";
    text[6217] = "(Suspiro) Só me siga.";
    text[6218] = "... Tem certeza?";
    text[6219] = "Mas aí onde você vai dormir?";
    text[6220] = "No chão? Tenho um carpete bem aconchegante.";
    text[6221] = "Não se preocupe com isso, Nickle!";
    text[6222] = "Você é minha visita! Você fica com a cama.";
    text[6223] = "Ah e... Tetra também vai dormir na cama, então...";
    text[6224] = "Esquece, vou dormir no chão.";
    text[6225] = "Ahn?? Por que mudou de ideia?";
    text[6226] = "Às vezes, minhas mãos pegam fogo enquanto durmo.";
    text[6227] = "Posso acabar derretendo você sem querer...";
    text[6228] = "E... robôs dormem?";
    text[7126] = "A Estação Espacial Lunex está sendo atacada!";
    text[7127] = "Precisamos encontrar e derrotar os Murks nesta área!";
    text[7192] = "Você esqueceu algo em seu quarto, lembra?";
    text[7193] = "Certinho! Vamos para o Laboratório Nexus!";
    text[7194] = "Usaremos a Celestia para chegar à Base Militar!";
    text[7245] = "O escritório de Saros parece estranhamento silencioso. Será que ele está mesmo lá?";
    text[7246] = "Vamos ter cuidado só por precaução. Talvez seja uma armadilha.";
    text[7389] = "Aquele Gerador de Buraco de Minhoca no Laboratório Secreto parece muito com a Celestia...";
    text[7390] = "Vamos olhar mais de perto!";
    text[7391] = "Saros está mantendo o Dr. Thomas como refém em algum lugar no Reino Fantasma!";
    text[7392] = "Ele também pegou todos os Antinúcleos que coletei...";
    text[7393] = "Precisamos encontrá-lo e impedi-lo de uma vez por todas!";
    text[7438] = "...";
    text[7552] = "Hoje parece um ótimo dia para se aventurar!";
    text[7553] = "Acho que podemos conferir o QUADRO DE MISSÕES da Força Lunex e cumprir algumas missões!";
    text[7554] = "... Ou podemos procurar Murks fortes para lutar!";
    text[7555] = "Estou me coçando para treinar.";
    text[7556] = "Precisamos estar na nossa melhor forma!";
    text[7557] = "Por que não os dois? Hihi.";
    text[7558] = "Depois, dá para relaxarmos em um café enquanto comemos barras de cheesecake!";
    text[7559] = "Por minha conta!";
    text[1337] = "É um Cubo Hertz abandonado.";
    text[1338] = "Eles geralmente são usados para armazenar e proteger dinheiro ou bens valiosos.";
    text[1335] = "Este Cubo Hertz para estar trancado.";
    text[1336] = "Hmm... E se usássemos lasers para abri-lo?";
    text[562] = "Gravado no Monólito estão os nomes dos Guerreiros Lunex que faleceram.";
    text[563] = "O primeiro nome da placa diz:";
    text[564] = "General da Força Lunex,\nThea Grey.";
    text[565] = "É um barril de aço.";
    text[566] = "Há um sensor de oxigênio neste pilar.";
    text[567] = "Os Laboratórios Lunex usam dados coletados deste sensor para monitorar as condições em Luna.";
    text[568] = "Legal! Esta luminária, na verdade, é termoluminescente.";
    text[569] = "Ahn?? Terma-lumi-noquê?";
    text[570] = "Há uma pedra aqui que brilha quando aquecida!";
    text[571] = "Uuuuh! Bem bacana!";
    text[572] = "Boas-vindas ao Café Regolithia!";
    text[573] = "Nossa especialidade: Croca-Barras!\nEspecial do Dia: Lámen de Missô!\nBebida Popular: Refrigerantes!";
    text[574] = "'Café' escrito em neon.";
    text[575] = "Parece que um novo carregamento de comidas deliciosas acabou de chegar!";
    text[576] = "Hmm. Tetra está ficando com fome!";
    text[577] = "Você se esqueceu que não pode comer?";
    text[578] = "Ah, é... Bom, estou faminta de outras coisas.";
    text[579] = "Como o quê?";
    text[580] = "Hm... SEGREDO! Hahaha.";
    text[581] = "É um café recém-passado.";
    text[582] = "Acho que ainda não levamos meu pai ao Café Regolithia.";
    text[583] = "Ouvi dizer que o café deles é muito bom!";
    text[584] = "O dr. Thomas precisa maneirar no café... Ele toma demais!";
    text[585] = "Vários Painéis Lunares estão instalados na viga.";
    text[586] = "Esses painéis são essenciais para fornecer energia aos residentes locais no Setor 16.";
    text[587] = "Alguém pintou um 'X' e um 'Z' na falésia.";
    text[588] = "'Scientia Potentia Est'\nConhecimento é Poder";
    text[589] = "Este monumento foi construído para homenagear os inúmeros avanços científicos";
    text[590] = "que a humanidade conquistou ao longo do tempo.";
    text[591] = "Exoesqueletos têm permissão para pousar e partir em áreas onde esta iluminação de cristais brilha.";
    text[592] = "Há um pequeno bilhete no caixote que diz:";
    text[593] = "Espaço 1 - Esquerda";
    text[594] = "Ahn?! Bella, o que acha que isso significa?";
    text[595] = "Não tenho certeza, mas talvez seja útil para algum mecanismo...";
    text[596] = "Vamos ficar de olho se não encontramos mais desses!";
    text[597] = "Certinho! Super Detetive Tetra está pronta! Hihi.";
    text[598] = "Espaço 2 - Para Baixo";
    text[599] = "Espaço 3 - Esquerda";
    text[600] = "Espaço 4 - Direita";
    text[601] = "Espaço 5 - Para Cima";
    text[602] = "É um cartaz de dois personagens legais de videogame!";
    text[603] = "O texto embaixo diz: O legado de Cosmic Network";
    text[604] = "É um cartaz de um personagem maneiro de videogame!";
    text[605] = "O texto embaixo diz: O legado de EndWave";
    text[606] = "É o mapa de Luna!";
    text[607] = "Alguém deixou um bilhete aqui. A letra é um pouco difícil de ler:";
    text[608] = "Inst-laç-es da Bar--ira\nD-is Pil-r-s Pret-s\nTr-âng-lo Ver--lho";
    text[609] = "O ar gelado parece estar vindo da grande tubulação acima.";
    text[611] = "ALERTA - ZONA DE ALTA VOLTAGEM";
    text[612] = "NÃO ULTRAPASSE.";
    text[613] = "Acesso Restrito às Instalações da Barreira.";
    text[614] = "É um Plátano Lunar.";
    text[615] = "O líquido no domo fornece os nutrientes necessários para a árvore crescer.";
    text[616] = "É um belo exemplar de Camélias Lunares.";
    text[617] = "Uma delas está levemente murcha.";
    text[618] = "É um berço de belas Camélias Lunares.";
    text[619] = "É uma lápide feita de Obsidiana Lunar Especial.";
    text[620] = "As marcações em azul formaram devido à absorção contínua da luz intensa do Sol.";
    text[621] = "Está escrito 'Sol' na placa.";
    text[622] = "Está escrito 'Esperança' na placa.";
    text[623] = "Está escrito 'Vontade' na placa.";
    text[624] = "Está escrito 'Paz' na placa.";
    text[625] = "Está escrito 'Lendas' na placa.";
    text[626] = "Está escrito 'Luz Estelar' na placa.";
    text[627] = "Está escrito 'Lux' na placa.";
    text[628] = "Está escrito 'Umbra' na placa.";
    text[772] = "Parece que há algo brilhando nessa lata de lixo...";
    text[773] = "... Era só lixo.";
    text[774] = "Você conferiu a lata de lixo pela segunda vez...";
    text[775] = "Continuou sendo só lixo.";
    text[776] = "Você conferiu a lata de lixo pela terceira vez...";
    text[777] = "Não há nada de útil aí dentro.";
    text[778] = "Só lixo??";
    text[779] = "Você conferiu a lata de lixo pela quarta vez...";
    text[780] = "... e continuou pela quinta vez logo em seguida.";
    text[781] = "O interior da lata de lixo parece um buraco negro, pronto para sugar lixo.";
    text[782] = "Nesta lata de lixo?!";
    text[783] = "Só porcaria...";
    text[784] = "Bella?";
    text[785] = "Pois não?";
    text[786] = "Por que você fica remexendo as latas de lixo toda hora?";
    text[787] = "Hehehe.";
    text[788] = "Eu sou... curiosa, ok?!";
    text[789] = "Não foi daí que veio o nome vira-latas?";
    text[790] = "... Tetra?";
    text[791] = "Pois não?";
    text[792] = "Mantenha isso só entre eu e você, ok?!";
    text[793] = "Hahaha. Belezinha!";
    text[1041] = "Esses armários estão cheios de roupas e fantasias para cosplay.";
    text[1042] = "Há um adesivo de 'Cara Bacana' neste armário.";
    text[1043] = "É um interruptor multipropósito.";
    text[1044] = "Tem um sensor de ocupação, um interruptor de luz e um termostato integrados!";
    text[1045] = "Está ocupado.";
    text[1046] = "-Banheiro-";
    text[1047] = "Alguém pediu refeições com 3 pratos aqui.";
    text[1048] = "Enquanto outras pessoas só querem uma fatia de melancia.";
    text[1049] = "Essa é a beleza da vida.";
    text[1050] = "Cupcakes de chocolate amargo são os melhores.";
    text[1051] = "Um café pelando... com uma dose extra de espresso!";
    text[1052] = "Oniguiri!";
    text[1053] = "Hmm... Aquele lámen de missô parece delicioso!";
    text[1054] = "Tem várias comidas deliciosas na mesa.";
    text[1055] = "É um hambúrguer vegetariano e um cachorro-quente apimentado!";
    text[1056] = "Esta geladeira está cheia de bebidas geladas!";
    text[1057] = "Há diversas comidas gostosas na geladeira!";
    text[1058] = "Os doces populares estão em falta nesta máquina de vendas.";
    text[1059] = "NÃÃÃOOO! EU QUERIA MAIS BARRAS DE CHEESECAKE...";
    text[1060] = "Eles têm Croca-Barras!";
    text[1061] = "Não.";
    text[1062] = "Não é a mesma coisa.";
    text[1063] = "Este dispositivo regula os níveis de oxigênio na sala.";
    text[1064] = "A arte do calendário mostra um fundo todo preto com um coração em pixel art.";
    text[1065] = "Está legendado: 'Determinação'.";
    text[1066] = "É um cilindro de ar comprimido.";
    text[1067] = "Um belo armário cinza.";
    text[1068] = "Esta caixa de ferramentas é gigante!";
    text[1069] = "Uma ilustração mostrando um explorador espacial.";
    text[1070] = "Uma cápsula de dormir!";
    text[1071] = "Ela conta com vários recursos para fornecer o melhor conforto ao dormir.";
    text[1072] = "Há uma etiqueta de despacho aqui que diz: 'Origem: Rancho Kepler'.";
    text[1073] = "Cilindros de oxigênio reservas estão pendurados na parede em caso de emergências.";
    text[1074] = "É um jogo de RPG que parece divertido!";
    text[1075] = "Você sente uma grande vontade de 'ligar' seu controle e jogar.";
    text[1076] = "Um livro 'Desenvolvimento de Jogos do Zero'. O outro é um livro-guia de videogames.";
    text[1077] = "Alguns jogos estão organizados na prateleira...";
    text[1078] = "Space Boy, Lawmage Academy, S.F. 4, Monsters of Kanji, Berserk Boy,";
    text[1079] = "Oslo the Professional, CODE: Bunny, Endwave...";
    text[1080] = "... Tá aí uma coleção de jogos de respeito!";
    text[1081] = "Esta Unidade contém os suprimentos necessários para sobreviver em expedições espaciais.";
    text[1082] = "- Entrada Restrita -";
    text[1083] = "Este compartimento de armazenamento contém comida embalada.";
    text[1084] = "Os pacotes foram selados a vácuo individualmente.";
    text[1101] = "Esses caixotes têm diversos equipamentos reservas que são usados em missões espaciais.";
    text[1085] = "Este compartimento de armazenamento contém peças de propulsão bem antigas.";
    text[1086] = "Isso deve estar encostado aqui há décadas.";
    text[1087] = "Este compartimento de armazenamento contém folhas de material de proteção de calor.";
    text[1088] = "Este compartimento de armazenamento contém equipamento de despressurização.";
    text[1089] = "Vai! Tenta falar despressurização três vezes bem rápido.";
    text[1090] = "Este compartimento de armazenamento contém maquinário para Remoção de Dióxido de Carbono.";
    text[1091] = "Este compartimento de armazenamento contém uma unidade condensadora de água.";
    text[1092] = "Ela previne a corrosão de equipamentos frágeis.";
    text[1093] = "Este compartimento de armazenamento contém sistemas de proteção contra radiação.";
    text[1094] = "Há muitas décadas, a exposição continuada à radiação era motivo de preocupação";
    text[1095] = "quando a humanidade vivia na lua.";
    text[1096] = "Este compartimento de armazenamento contém um equipamento reserva de comunicação.";
    text[1097] = "Este compartimento de armazenamento está vazio.";
    text[1098] = "Há alguns Trajes Espaciais antigos nesta caixa de armazenamento.";
    text[1099] = "Há alguns terminais e cabos na caixa de ferramentas. Meh. Nada de interessante.";
    text[1100] = "A caixa de ferramentas contém um monte de ferramentas de solda.";
    text[1102] = "Este compartimento de armazenamento contém kits de higiene.";
    text[1114] = "Sorvetes! Está com vontade de comer algo doce?";
    text[1115] = "Uma das melhores sobremesas da vida. Flan de Leite.";
    text[1116] = "Refrigerantes!";
    text[1117] = "Uma camélia solitária no vaso. Parece bem saudável!";
    text[1118] = "Obrigado por visitar no Café Regolithia!";
    text[1119] = "Às vezes, a melhor pedida é um belo copo de água gelada.";
    text[1120] = "Eita! Eles também têm sushi? Hmmm!!";
    text[1121] = "Há uma legenda no cartaz que diz: Lute Contra o Sistema!";
    text[1122] = "Dois quimonos de artes marciais molhados estão pendurados na parede para secar.";
    text[1123] = "Um livro: O Mundo Perdido da Terra.";
    text[1124] = "Um monte de bonecos de ação de mechas estão neste armário de vidro.";
    text[1125] = "É um placa multifuncional.";
    text[1126] = "Na verdade, a caixa de ferramentas tem um monte de brinquedos dentro.";
    text[1127] = "Um anime chamado Yo-King, que está atualmente na TV.";
    text[1128] = "Os personagens duelam usando Ioiôs contendo poderosas bestas seladas!";
    text[1129] = "Parece épico.";
    text[1130] = "Há um monte de mangás e quadrinhos na prateleira.";
    text[1131] = "Há um monte de consoles de jogos portáteis dentro.";
    text[1132] = "Esse é o CosmicSans do Hyper Smash Fighters??";
    text[1133] = "Esta escotilha fornece acesso aos níveis subterrâneos das Instalações da Barreira.";
    text[1134] = "Não precisamos ir lá agora...";
    text[1035] = "Há mais Painéis Lunares instalados na viga horizontal.";
    text[1036] = "Parece que planejaram instalar mais.";
    text[1037] = "É a Astrobarreira!";
    text[1325] = "É um Transportador de Suprimentos Modelo N!";
    text[1326] = "Esse hovercraft pode viajar grandes distâncias graças ao seu sistema de propulsão por gravidade!";
    text[1038] = "A Estação Espacial Lunex pode ser vista orbitando Luna.";
    text[1039] = "A EEL é onde ficam os Laboratórios Lunex,";
    text[1040] = "um lugar onde os cientistas mais brilhantes e os engenheiros mais inovadores se encontram.";
    text[388] = "Saudações, senhorita Bella!";
    text[796] = "Estamos instalando o modelo mais recente dos Painéis Lunares!";
    text[797] = "Aparentemente, esses painéis produzem o maior deslocamento de energia da história da humanidade!";
    text[801] = "Esses Painéis Lunares são pesados...";
    text[798] = "Ah, senhorita Bella! Vejo que está voltando para a estação. Bom, tenha um bom voo!";
    text[799] = "Você viu aquele Murk que passou voando? Ele era GIGANTE!";
    text[800] = "Temos que ficar de prontidão. Quem sabe quando ele aparecerá novamente...";
    text[802] = "A vista daqui de cima é incrível.";
    text[803] = "É mesmo! Esse é um dos lugares que mais gosto de visitar.";
    text[804] = "Posso fazer uma pergunta?";
    text[805] = "Claro!";
    text[806] = "Você acha que... um dia encontraremos um jeito de nos esconder dos Murks?";
    text[807] = "Ou, pelo menos... evitar que eles nos machuquem?";
    text[808] = "Não sou de guardar rancor, mas... eles tiraram a vida do meu marido.";
    text[809] = "Ah... sinto muito pela sua perda...";
    text[810] = "Não quero que ninguém mais passe pelo sofrimento que passei.";
    text[811] = "Senhora, vamos achar um jeito.";
    text[812] = "Não quero que as pessoas vivam com medo do que está lá fora no universo.";
    text[813] = "A humanidade cresce e prospera devido à nossa curiosidade de aprender e explorar.";
    text[814] = "Em meu nome e em nome da Força Lunex, daremos o nosso melhor.";
    text[815] = "O-obrigada.";
    text[816] = "Sempre que precisar!";
    text[817] = "Darei o meu melhor para continuar forte. Obrigada por me dar esperanças.";
    text[818] = "01100100 01101001 01100111 01101001 01110100";
    text[819] = "Ele disse que o nome dele é Digit.";
    text[820] = "Bella, acho que tem alguma coisa errada com o programa do Digit.";
    text[821] = "Ah, pobrezinho. Vamos levar o Digit de volta ao Laboratório. Meu pai pode consertá-lo!";
    text[822] = "01100111 01101111 01110100 01110100 01100001 00100000 01100111 01101111";
    text[823] = "Digit disse que ele precisa ir agora.";
    text[824] = "Entendi. Talvez esse robô pertença a alguém...";
    text[825] = "Que robô estranho.";
    text[840] = "Hihi.";
    text[841] = "Hihi mesmo.";
    text[842] = "Hm. Oi!";
    text[843] = "Ah, olá!";
    text[844] = "Oi, oi!";
    text[845] = "Hm, vimos você lutando contra aquele Murk mais cedo. Você foi incrível!";
    text[846] = "Super incrível! Mas viemos nos esconder aqui!";
    text[847] = "Queríamos te dar um presente por manter nossa casa em segurança.";
    text[848] = "Sim, sim!";
    text[849] = "Ah, obrigada! Que fofos!";
    text[850] = "(Essas crianças... Elas não deveriam tomar Ener-G.)";
    text[851] = "(Por isso que estão tão pilhadas.)";
    text[852] = "Tchau!";
    text[853] = "Tchau, tchau!";
    text[854] = "Senhorita Bella, seu Traje a Jato parece personalizado. Foi o dr. Thomas que o fez para você?";
    text[855] = "Sim!";
    text[856] = "Que sorte! Este é o meu primeiro dia no trabalho.";
    text[857] = "Não imaginei que encontraria Murks logo de cara...";
    text[858] = "Mas... darei o meu melhor para aprender e ficar mais forte!";
    text[859] = "Faz poucos meses que me tornei uma guerreira oficial.";
    text[860] = "Ainda tenho muito o que aprender.";
    text[861] = "Sim, mas você treinou sua vida inteira com uma força da natureza como mãe!";
    text[862] = "Ela deve tê-la ensinado tudo quanto é tipo de técnica incrível!";
    text[863] = "Você já tem uma base sólida e subiu de ranque muito rápido!";
    text[864] = "Ai, também espero poder subir de ranque um dia desses.";
    text[865] = "Seria muito legal usar o Traje a Jato Modelo X azul um dia.";
    text[866] = "Bom, boa sorte para nós!";
    text[867] = "Fico feliz em tê-lo na equipe! Precisamos de guerreiros mais motivados como você.";
    text[868] = "O-obrigado! Hahaha!";
    text[869] = "(Pss, Bella. Você está deixando o sr. Soldado com vergonha!)";
    text[870] = "(Hm, Tetra. Ele está usando um capacete, como você...)";
    text[871] = "(Tetra!)";
    text[872] = "(Eu falei para não escanear as pessoas sem o consentimento delas!)";
    text[873] = "(Ops... Escudeira Esquecida Tetra sente muito. Hihihihi.)";
    text[874] = "(suspiro)";
    text[875] = "Darei o meu melhor para aprender e ficar mais forte!";
    text[876] = "Os Murks...";
    text[877] = "Não temos como prever quando nem onde aparecerão.";
    text[878] = "Fico feliz que fazemos bem o nosso trabalho a ponto de os cidadãos";
    text[879] = "poderem continuar suas vidas sem viver em medo constante.";
    text[880] = "Murks costumavam aparecer uma ou duas vezes por mês. Mas, agora...";
    text[881] = "Eles parecem estar aparecendo cada vez mais.";
    text[882] = "Tudo o que posso fazer é mantê-los afastados e proteger o Povo de Luna.";
    text[883] = "Temos muitos suprimentos vindo de toda Luna.";
    text[884] = "Alguns desses caixotes contêm carnes e legumes encomendados pelo Café";
    text[885] = "e enviados lá do Rancho Kepler.";
    text[886] = "Parece que temos uma cadete vermelha aqui! Pelo visto, ainda um camarão. Hahaha!";
    text[887] = "Algum dia, você será tão forte quanto eu! Hahaha!";
    text[888] = "(O ranque dele subiu a cabeça. Que banana.)";
    text[889] = "(Tetra... escaneie ele.)";
    text[890] = "(Hm... De acordo com os registros dele, o recorde dele de agachamento é 75 kg.)";
    text[891] = "Pff... (Isso não é nada! O meu é 143 kg.)";
    text[892] = "Qual a graça, cadete vermelha?";
    text[893] = "Quanto peso você consegue agachar?";
    text[894] = "Ah, eu poderia agachar uns 120 kg fácil!";
    text[895] = "Pfff!! ...";
    text[896] = "Que seja, não tenho temo para ficar de papo com cadetes vermelhos.";
    text[897] = "(Que cabeção.)";
    text[898] = "Já deu de me perturbar. Não tenho tempo para ficar de papo com cadetes vermelhos.";
    text[899] = "(Aff. Cabeção.)";
    text[1103] = "Estou aqui esperando meu camarada Mett.";
    text[1104] = "Ele está demorando mais do que o normal com a carga... Espero que ele esteja bem.";
    text[1414] = "Ei, valeu por ajudar meu camarada Mett mais cedo!";
    text[1415] = "Senhorita Bella! Espero que esteja bem.";
    text[1416] = "Ver sua coragem e determinação em consertar o hovercraft realmente me inspirou.";
    text[1417] = "Decidi que me esforçarei para superar meu medo de Murks.";
    text[1418] = "Ta-talvez leve algum tempo... Só de lembrar deles, já me arrepio.";
    text[1419] = "Mas... darei o meu melhor! Nos vemos por aí!";
    text[409] = "É um Exoesqueleto do tipo Guerreiro!";
    text[410] = "Os Exoesqueletos são duplamente alimentados por Antinúcleos e eletricidade.";
    text[411] = "Quando alimentados por Antinúcleo, eles são capazes de";
    text[412] = "suportar grandes quantidades de antimatéria em batalhas.";
    text[413] = "Isso faz com que sejam a arma ideal para lutar contra Murks.";
    text[512] = "Unidade Residencial de Regolithia - 001";
    text[513] = "SETOR 16 - REGOLITHIA\n- Pico do Guerreiro";
    text[514] = "Hoverporto Sudeste";
    text[515] = "Unidade de Armazenamento - 003";
    text[516] = "ERRO de autorização.";
    text[517] = "Oeste - Instalações da Barreira\nLeste - Zona Residencial";
    text[533] = "O ar gelado parece estar vindo da grande tubulação acima.";
    text[534] = "Quer entrar na tubulação?";
    text[535] = "A cor das alexandritas em Regolithia mudam dependendo das condições da luz.";
    text[536] = "1.000 anos atrás, esta rocha era extremamente rara por conta de suas propriedades de mudança de cor.";
    text[537] = "É uma alexandrita.";
    text[538] = "Rochas em Luna certamente são interessantes...";
    text[539] = "Você examinou bem as rochas. Talvez elas guardem um segredo maior.";
    text[540] = "Ou não.";
    text[541] = "Essa é a décima vez que você tentou conversar com a rocha.";
    text[542] = "A rocha se recusa a responder.";
    text[543] = "Parece que você tem um fascínio particular por rochas.";
    text[544] = "Você tem tanta experiência com rochas que pode até colocar isso em seu currículo.";
    text[545] = "Tentativa número 30. A rocha continua parada no chão.";
    text[546] = "Ela não se move.";
    text[547] = "Bem bonita.";
    text[548] = "Parabéns! Você definitivamente é uma sommelier de rochas.";
    text[549] = "As pessoas ainda têm pedras de estimação nos dias de hoje.";
    text[550] = "Por quê?";
    text[551] = "Porque elas são boas ouvintes.";
    text[552] = "Tem algo gravado nesta rocha...";
    text[553] = "Está escrito...";
    text[554] = "Homem.@P.@P.@PRocha?";
    text[555] = "Você sente uma aura de gratidão emanando das rochas na área.";
    text[556] = "Elas nunca se sentiram tão amadas.";
    text[557] = "Elas nunca colocarão uma pedra sobre esse sentimento.";
    text[558] = "A rocha parece contente. Ela te abraçaria se pudesse.";
    text[559] = "Não se esqueça de apreciar as pequenas coisas da vida.";
    text[560] = "Você chegou ao pináculo da interação com rochas! Rock'n'Roll!";
    text[561] = "Você perdeu as contas de com quantas rochas conversou.";
    text[1327] = "Bella, acabamos de ver uma Estrela Cadente!";
    text[1328] = "Isso foi incrível! Me sinto super SORTUDA!";
    text[1329] = "EVENTO DA SORTE: O próximo item ou moeda que coletar será multiplicado x2!";
    text[1330] = "Colete seu próximo item com sabedoria.";
    text[1331] = "Você só tem um único EVENTO DA SORTE por capítulo!";
    text[270] = "O filhote está assustado com o traje a jato.";
    text[271] = "É o Fiote, o filhote! Gostaria de fazer carinho no Fiote?";
    text[272] = "Fiote parece desapontado.";
    text[273] = "Au, au!";
    text[274] = "É um filhotinho fofo! Gostaria de fazer carinho no filhote?";
    text[275] = "O filhote parece desapontado.";
    text[276] = "Você faz carinho no filhote.";
    text[277] = "O filhote sacode o rabinho de felicidade!";
    text[278] = "Ele parece ansioso para ganhar mais tapinhas na cabeça.";
    text[279] = "Você faz carinho no filhote de novo. O filhote está no paraíso!";
    text[280] = "Ele parece AINDA MAIS ansioso para ganhar mais tapinhas na cabeça.";
    text[281] = "O filhote transcendentalmente animado está babando por todos os lados.";
    text[282] = "Ele está curtindo todos os tapinhas na cabeça!";
    text[283] = "Você confere a coleira do filhote.";
    text[284] = "O nome dele é Fiote! Você o chama pelo nome e o rabinho balança loucamente!";
    text[285] = "Fiote te olha com olhos de cachorro abandonado enquanto você dá carinho.";
    text[286] = "Seu carinho é especializado! Fiote está muito feliz.";
    text[287] = "Você e Fiote estão em sincronia. Você sente o poder aumentando dentro de você.";
    text[288] = "O poder de encontrar filhotes fofos brilha dentro de você.";
    text[289] = "Fiote está feliz em vê-la.";
    text[290] = "Ele dá um lambeijo molhado de agradecimento por todo o carinho!";
    text[291] = "Você faz carinho no Fiote devagar e gentilmente.";
    text[292] = "Ele parece estar gostando dessa intensidade de carinho também!";
    text[293] = "Você e FIote decidem praticar uma corrida de carinho.";
    text[294] = "O Fiote Sensei está impressionado!";
    text[295] = "O que foi, Tetra?";
    text[296] = "Nada.";
    text[297] = "Hunf.";
    text[298] = "Ah, parece que alguém está com ciúmes! Hahaha.";
    text[299] = "Talvez... um pouco. Hunf.";
    text[300] = "Depois darei tapinhas na sua cabeça. Prometo.";
    text[301] = "Hihihi. Ok!";
    text[302] = "Você e Fiote estão brincando a velocidades que não podem ser vistas por um olhar não treinado.";
    text[303] = "Uma bela e épica demonstração de carinho e rabinho abanando na velocidade da luz";
    text[304] = "está acontecendo, apesar de parecer que vocês não estão de movendo.";
    text[305] = "Você e Fiote se tornaram bons amigos.";
    text[389] = "Não se preocupe conosco.";
    text[390] = "Há Murks lá fora que precisamos ser contidos.";
    text[794] = "Espero que consigamos consertar a violação da Astrobarreira a tempo...";
    text[795] = "Minha filha está esperando eu voltar para casa para podermos jogar videogame.";
    text[1363] = "O Setor 16 finalmente reabriu. Fico feliz que as coisas se resolveram!!";
    text[1364] = "Agora, posso ir para casa e jogar videogame com minha filha! Uhul!!";
    text[530] = "Há uma escada atrás desse pilar!";
    text[531] = "Subir de novo?";
    text[532] = "Descer a escada?";
    text[909] = "É um refletor de laser!";
    text[910] = "Parece que esse laser ainda funciona, mas seu mecanismo de rotação está emperrado...";
    text[911] = "Não dá para girá-lo.";
    text[912] = "Girar o laser...";
    text[913] = "Deixa para lá.";
    text[914] = "Escolha para onde apontar o laser.";
    text[915] = "Parece que o mecanismo de rotação está emperrado. Ele não vai girar além disso.";
    text[916] = "Bella, esta entrada de carga está selada por uma porta de lasers!";
    text[917] = "Fritaremos se passarmos por ela!";
    text[918] = "Consegue acessar o painel de controle e desbloqueá-la?";
    text[919] = "Hm. Esse painel de controle está totalmente destruído... Não consigo acessar sua rede.";
    text[920] = "Hm. Nesse caso, podemos tentar algo diferente.";
    text[921] = "O que sugere?";
    text[922] = "Vê aqueles lasers? Eles são parte do Sistema de Defesa da Astrobarreira.";
    text[923] = "Estou pensando em mirar os lasers na porta. Hihi.";
    text[924] = "Aaaa! Vamos tentar!";
    text[925] = "Disparar o laser! (Muahahaha!)";
    text[926] = "É um laser quebrado. O mecanismo de rotação também está quebrado.";
    text[927] = "Este painel de controle está quebrado.";
    text[928] = "Hm... Há uma alavanca de controle atrás deste guindaste! Selecione a distância de soltura do guindaste!";
    text[929] = "Nível 1 - Distância curta";
    text[930] = "Nível 2 - Distância média";
    text[931] = "Nível 3 - Distância longa";
    text[932] = "Conseguimos! Entramos na área de carga!";
    text[1136] = "Este laser é parte do Sistema de Defesa da Astrobarreira!";
    text[1135] = "Ponto da Luz Estelar";
    text[936] = "Ei! Boas-vindas à minha casa. Haha!";
    text[937] = "Vou fazer streaming de alguns jogos independentes mais tarde!";
    text[938] = "Você é streamer?? Uau!";
    text[939] = "Sim!";
    text[940] = "Você tem uma bela coleção de jogos!";
    text[941] = "Obrigado! Jogar e promover jogos indie é a minha paixão. Haha!";
    text[942] = "Uau! Sua robô é irada!";
    text[943] = "Meu nome é Tetra! Sou a escudeira número um da Bella! PEW, PEW!";
    text[944] = "Você que a construiu?";
    text[945] = "Meu pai e eu a construímos juntos. A IA dela é relativamente nova.";
    text[946] = "Isso é glitch demais!";
    text[947] = "Hehehe... (Isso que as crianças falam hoje em dia?!)";
    text[948] = "É muito mais calmo por aqui comparado à cidade agitada de Tycho.";
    text[949] = "Por as casas ficarem no meio das colinas de Regolithia,";
    text[950] = "estamos melhor protegidos contra potenciais desastres.";
    text[951] = "Temos nosso próprio estoque de comida e oxigênio por precaução!";
    text[952] = "Aff! Preciso ir LOGO...";
    text[953] = "Aparentemente, o macarrão de lámen feito com o trigo da Terra";
    text[954] = "tinha um gosto totalmente diferente do que cresce em Luna.";
    text[955] = "Como deveria ser o gosto?";
    text[956] = "Pena que a Terra agora é um planeta vulcânico inabitável.";
    text[957] = "Como será que era a vida lá 1.000 anos atrás?";
    text[958] = "Tipo, antes da terraformação de Luna e tudo mais, sabe?";
    text[959] = "Trabalhar na Força Lunex requer muito trabalho duro, treinamento de combate, dedicação";
    text[960] = "e.@P.@P.@P.@P.@P.@P. MUITA COMIDA!";
    text[1105] = "Você já conferiu o Fórum de Regolithia?";
    text[1106] = "É bem divertido ver as publicações!";
    text[1107] = "Não conte a ninguém, mas meu usuário é Melia.";
    text[1108] = "Perdi meu Cubo Hertz faz um tempo e publiquei no Fórum para ver se alguém o havia encontrado.";
    text[1109] = "Mas não estou mais procurando meu Cubo Hertz.";
    text[1110] = "Então, caso o encontre, pode ficar com o que estiver dentro dele!";
    text[1111] = "Cubos Hertz geralmente ficam trancados. Você tem a chave para destrancá-lo?";
    text[1112] = "Espere, esqueci de mencionar que perdi a chave...";
    text[1113] = "Então não sei como irei abri-lo... De qualquer forma, boa sorte!";
    text[1333] = "Parece que o cofre de carga não pode ser aberto.";
    text[1334] = "Talvez haja um interruptor na Unidade de Armazenamento que possa desativar o cofre.";
    text[1032] = "Há uma escotilha de acesso aqui!";
    text[1033] = "Parece que está trancada pelo outro lado...";
    text[1034] = "O Antinúcleo que você carrega parece estar reagindo.";
    text[1332] = "Hm. Essas marcações na parede são muito estranhas... Vamos voltar aqui depois.";
    text[1581] = "Os Antinúcleos que você carrega parecem estar reagindo às marcações na parede.";
    text[1582] = "?? ...";
    text[1024] = "Um pequeno buraco de minhoca surgiu!";
    text[1025] = "Quer pular dentro?";
    text[1029] = "Há marcações estranhas no chão.";
    text[1367] = "É uma pilha de poeira estelar brilhando.";
    text[1368] = "Parece que a poeira é composta de partículas de antimatéria.";
    text[1369] = "É uma lápide.";
    text[1370] = "É um monólito.";
    text[1371] = "De alguma forma, você sente alguma familiaridade.";
    text[1701] = "Selecione o piso desejado:";
    text[1702] = "P1 - Café e Salão";
    text[1703] = "P2 - Shopping Center";
    text[1704] = "P3 - Instalações de Pesquisas";
    text[1705] = "Área Restrita - Laboratório Nexus";
    text[1777] = "Estação Espacial Lunex - Doca Leste";
    text[1778] = "Café Lunex";
    text[1779] = "A comida é um combustível essencial para o corpo! Certifique-se de comer bem no Café Lunex!";
    text[1780] = "Há vários interruptores e botões na parede.";
    text[1781] = "Melhor não mexer com as configurações.";
    text[1782] = "Artigos de jornal estão passando no visor.";
    text[1783] = "Incidentes com Murks, novas invenções, reclamações de cidadãos, escassez de comida...";
    text[1784] = "Não acaba.";
    text[1785] = "Sou o zelador aqui na EEL.";
    text[1786] = "Minhas obrigações incluem limpar, realizar reparos e fazer a manutenção geral.";
    text[1787] = "É legal e tudo mais, mas minha parte favorita desse trabalho...";
    text[1788] = "... é alimentar a Echo, a gata espacial.";
    text[1789] = "Nunca achei que haveria um gato por aí que gostasse tanto do espaço quanto a Echo.";
    text[1790] = "Ninguém sabe de onde a Echo veio ou quem era seu dono.";
    text[1791] = "Ela tem uma coleira, mas o nome do dono está borrado.";
    text[1792] = "Ela apareceu um dia em um traje espacial e o resto é história.";
    text[1793] = "Bella! Bem-vinda de volta à Estação Espacial!";
    text[1794] = "Ei, Stella! Alguma nova missão?";
    text[1795] = "Algumas, mas já temos outros esquadrões cuidando delas.";
    text[1796] = "Você deveria tirar o dia de folga!";
    text[1797] = "É tão difícil fazê-la tirar uma folga das suas obrigações como guerreira!";
    text[1798] = "Eu sei, não consigo evitar. Hehehe.";
    text[1799] = "Ei! Você conseguiu novas pelúcias? QUE FOFOO!";
    text[1800] = "Sim!";
    text[1801] = "Comprei algumas on-line e parece que me enviaram duas de cada!";
    text[1802] = "Posso te dar as extras se quiser.";
    text[1803] = "Pedirei para alguém levá-las ao seu quarto!";
    text[1804] = "SIIIM!! Não consigo dizer não para fofuras! Obrigada! Hehe.";
    text[1807] = "Não há novas missões disponíveis por enquanto.";
    text[1808] = "Assim que surgir algo, eu te aviso!";
    text[1809] = "Gostaria de voltar a Regolithia?";
    text[1810] = "O visor está mostrando o Diretório da Estação.";
    text[1811] = "A EEL é composta de 3 níveis principais:";
    text[1812] = "Pelúcias de um Metill e de um Kame!";
    text[1813] = "Essa pelúcia assustadora se chama Axsoul.";
    text[1814] = "Esta máquina de vendas vende produtos da Lunex, como bonés e canecas.";
    text[1815] = "Esta máquina de vendas fornece suplementos vitamínicos.";
    text[1816] = "Os trabalhadores aqui são obrigados a tomarem suplementos vitamínicos";
    text[1817] = "para manter os ossos, dentes e músculos saudáveis.";
    text[1818] = "Há comidas e bebidas deliciosas no balcão.";
    text[1819] = "Ah! Eles instalaram uma nova Máquina de Comida.";
    text[1820] = "Ela é chamada F.O.O.D. v3.";
    text[1821] = "Gostava mais quando se chamava RANGO 5000.";
    text[1822] = "Eu também!";
    text[1823] = "O que o acrônimo F.O.O.D. significa?";
    text[1824] = "Nem ideia...";
    text[1825] = "Pelo menos, posso preparar milhares de pratos novos!";
    text[1826] = "Hmm. Eu comeria um curry apimentado agora!";
    text[1827] = "Ai, ai. Estou segurando faz tanto tempo...";
    text[1828] = "Há outros banheiros disponíveis na Estação Espacial.";
    text[1829] = "Não. PRECISA ser esse. Não vou desistir.";
    text[1830] = "Já esperei por tanto tempo, posso esperar mais um pouquinho.";
    text[1831] = "No espaço, nossas línguas não produzem saliva o suficiente para nossas papilas";
    text[1832] = "funcionarem tanto quando em Luna.";
    text[1833] = "Portanto, comida apimentada é bem popular na Estação Espacial Lunex.";
    text[1834] = "Antes de seu pai aperfeiçoar o Gerador de Gravidade,";
    text[1835] = "este café costumava estar coberto de velcro por TODAS AS PARTES!";
    text[1836] = "O velcro era usado para evitar que as coisas voassem por aí, inclusive a comida!";
    text[1837] = "Pães foram banidos por conta das migalhas que entravam nos olhos das pessoas!";
    text[1882] = "Espera aí! Tem algo escrito dentro dessa lixeira!";
    text[1883] = "143143";
    text[1884] = "Ah... É só um monte de números...";
    text[1885] = "Quem sabe seja uma senha! Hehe. Vamos anotar caso precisemos!";
    text[1886] = "Há uma nota adesiva com alguns números escritos: 032320.";
    text[1887] = "Este monitor mostra diferentes dietas e receitas espaciais.";
    text[1888] = "Boas-vindas à Estação Espacial Lunex!";
    text[1889] = "Lunex é o apelido para Lunar Expedition, ou Expedição Lunar!";
    text[1890] = "Sempre tome cuidado ao pilotar sua nave por Luna.";
    text[1891] = "O cinturão de asteroides que rodeia Luna pode ser bem difícil de navegar";
    text[1892] = "sem um Sistema de Assistência de Pilotagem. Sua nave tem um SAP?";
    text[1893] = "Na verdade, minha escudeira Tetra é minha piloto!";
    text[1894] = "Sério?? Nossa, que robô incrível!";
    text[1895] = "Hihi. A Escudeira Incrível Tetra tem vários truques na manga.";
    text[1896] = "Vim para a EEL para reparar meu Exoesqueleto, mas, pelo que parece,";
    text[1897] = "eles só fazem manutenção de hovercrafts e espaçonaves aqui.";
    text[1898] = "Aparentemente, a manutenção de Exoesqueletos é realizada na Base Militar em Grimaldi.";
    text[1899] = "Você conhecerá tudo quanto é tipo de gente lá fora na Estação Espacial Lunex!";
    text[1900] = "Temos cientistas, chefs, engenheiros, músicos, artistas... de tudo!";
    text[1901] = "O Fórum Lunex atualmente está indisponível. Pedimos desculpas pela inconveniência.";
    text[1902] = "Aparentemente, os cientistas sobrecarregaram o servidor com suas ideias de pesquisa.";
    text[1903] = "Mesmo?? Como você sabe?";
    text[1904] = "É o que as notas de registro mostram.";
    text[1905] = "Ah, bom, voltamos mais tarde então.";
    text[1906] = "Área Restrita - Acesso Negado";
    text[1907] = "O que será que tem aí atrás?";
    text[1908] = "Vivi minha vida inteira aqui e não faço ideia do que seja.";
    text[1909] = "Minha mãe e meu pai nunca me deixaram entrar nas áreas restritas.";
    text[1910] = "Quem sabe estejam fazendo uns negócios legais científicos lá. Hihi.";
    text[1911] = "A porta está trancada.";
    text[1912] = "Esta máquina de vendas está quebrada.";
    text[1913] = "Esta máquina de vendas vende bananas enlatadas...";
    text[1914] = "Por quê? ...";
    text[1915] = "Loja Geral - Pegue seu Ener-G aqui!";
    text[1916] = "Zona Astral - Melhorias, melhorias, melhorias!";
    text[1917] = "Estilo Lunex - Trajes a Jato personalizados para o seu estilo!";
    text[1918] = "Conexões Neurais - Conhecimento é Poder!";
    text[1945] = "Estamos trabalhando na segurança agora. Para falar a verdade, é um trabalho bem fácil.";
    text[1946] = "A EEL é um dos lugares mais seguros para se trabalhar. ";
    text[1947] = "Quase não há crimes ou problemas para se preocupar enquanto patrulhamos.";
    text[1948] = "Acabei de comprar a Habilidade de Apoio Reflexos!";
    text[1949] = "10% de chance de o ataque inimigo errar é uma chance bem baixa...";
    text[1950] = "Precisarei melhorá-la com meus Habilipontos para tirar melhor proveito dela.";
    text[1951] = "Acho que o Nível 5 de Reflexos tem 50% de chance de o ataque inimigo errar.";
    text[1952] = "Aí vale a pena, considerando que é uma HABILIDADE DE APOIO AZUL.";
    text[1953] = "Ela poderá ajudar se o bicho pegar! ";
    text[1954] = "Ela também abre suas opções para tentar diferentes HABILIDADES DE APOIO VERMELHAS. ";
    text[1955] = "Há várias formas de personalizar seu Grupo de Habilidades!";
    text[1956] = "Cara, finalmente economizei o suficiente para obter a Habilidade de Barreira Laser Ativa.";
    text[1957] = "Valeu muito a pena! Lasers são demais...";
    text[1958] = "Lasers fazem pew, pew!";
    text[1989] = "Esses recipientes provavelmente contêm materiais de pesquisa usados pelos cientistas.";
    text[1990] = "Você encontrou uma porta trancada. Quando mais se aproxima, mais pode sentir esfriar.";
    text[1991] = "Ao corredor oeste - Laboratório de Pesquisas";
    text[1992] = "Ao corredor leste - Quarteirão Residencial";
    text[1993] = "Este monitor mostra um monte de prazos próximos e marcos de projetos.";
    text[1994] = "Parece que algumas equipes estão atrasadas...";
    text[1995] = "Prazos são estressantes...";
    text[1996] = "Esta árvore é de uma espécie especial capaz de sobreviver em gravidade zero!";
    text[1997] = "Ela não requer água e as flores que florescem, em algum momento,";
    text[1998] = "se tornarão frutas. Ela ganhou o nome de Árvore Espacial.";
    text[1999] = "As variações rosa e roxo dão as frutas mais doces.";
    text[2000] = "Essas bancos foram projetados para trazer o melhor conforto!";
    text[2001] = "Aparentemente, eles também contam com recursos de massagem integrados.";
    text[2002] = "Há uma etiqueta aqui que diz: a concorrência não fornece este nível de conforto.";
    text[2003] = "O poder do nosso banco é MÁXIMO!";
    text[2004] = "Os monitores estão exibindo diversos produtos que foram criados aqui.";
    text[2005] = "Ahn? 'A Máquina de Café Ultimate', projetada pelo Dr. Thomas.";
    text[2006] = "'Esta máquina preparará o café perfeito sem você precisar levantar um dedo!'";
    text[2007] = "'Tudo o que precisa fazer é dizer ‘CAFÉ, POR FAVOR' e a máquina preparará para você!'";
    text[2008] = "'Ela pode até tirar o melhor espresso!'";
    text[2009] = "Este artigo foi publicado semana passada...";
    text[2010] = "Precisamos conversar sobre café com o meu pai.";
    text[2011] = "Há um monte de copos de café espalhados na sala.";
    text[2012] = "Como será o gosto desse café?";
    text[2013] = "Amargo. Meu pai gosta dele puro.";
    text[2014] = "Hm. Como será que é o gosto amargo?";
    text[2015] = "Ah, verdade. Você não tem paladar.";
    text[2016] = "Não! Você pode me chamar de Terrível Temperadora Tetra.";
    text[2017] = "Terrível Temperatu... Temp... Você fez isso de propósito?";
    text[2018] = "O quê?!";
    text[2019] = "Esse trava-língua! A aliteração!";
    text[2020] = "Ah... Hihi. Talvez...";
    text[2021] = "Há alguns trajes espaciais reservas nos compartimentos.";
    text[2022] = "É uma cápsula de recuperação! É basicamente uma cápsula de dormir modificada com recursos de cura!";
    text[2023] = "Muitos soldados vêm aqui após longas missões exaustivas para descansar e se recuperarem.";
    text[2024] = "Você espia pela janela. ";
    text[2025] = "Há uma bela e brilhante Luna diante dos seus olhos, rodeada por um cinturão de asteroides.";
    text[2026] = "Além disso, você consegue ver a Terra vulcânica pairando à distância.";
    text[2027] = "Para Área Central P3";
    text[2028] = "Para a Central de Comando";
    text[3513] = "DOBRA EXPRESSA ATIVADA! SELECIONE SEU DESTINO:";
    text[3514] = "P3 - Laboratório de Pesquisas";
    text[3515] = "P3 - Quarto da Bella";
    text[3516] = "P1 - Doca Leste";
    text[2029] = "Oficina de Manutenção de Hovercrafts";
    text[2030] = "Laboratório de Pesquisas Lunex";
    text[2031] = "Sala Botânica";
    text[2032] = "Sala de Simulação de Batalhas";
    text[2033] = "Laboratório de Química";
    text[2034] = "É meu quarto!";
    text[2035] = "Quarto de Thomas e Thea";
    text[2036] = "Esses compartimentos contêm suprimentos de limpeza.";
    text[2037] = "Câmaras de Recuperação";
    text[2038] = "Armário de Armazenamento";
    text[2039] = "Um Cartão de Acesso é necessário para entrar.";
    text[2040] = "Quarteirão Residencial";
    text[2041] = "Muitos cientistas e soldados vivem na Estação Espacial Lunex de graça,";
    text[2042] = "já que seus trabalhos fornecem serviços essenciais militares e de pesquisa.";
    text[2043] = "Este monitor está exibindo uma lista de todos os inquilinos que vivem na Estação Espacial.";
    text[2044] = "Há uma propaganda aqui: Desça ao Shopping Center P2 e compre até cair!";
    text[2045] = "Este monitor está exibindo uma lista de todos os laboratórios especializados dentro da Estação Espacial.";
    text[2046] = "Este monitor não parece estar funcionando corretamente.";
    text[2047] = "Nosso brilhante sol azul está sempre às vistas para ser admirado.";
    text[2048] = "A melhor vista da Estação Espacial certamente é a daqui de cima. Não há dúvida.";
    text[2049] = "Um lado ruim daqui é que as pessoas que moram aqui precisam tomar medicação para radiação.";
    text[2050] = "Serve principalmente para reduzir os efeitos adversos do nosso sol azul em nossos corpos.";
    text[2051] = "Nosso universo é lindo mas, também, perigoso.";
    text[2052] = "Ei, garota! Pres'tenção onde cê pisa! Acabei de limpar o chão!";
    text[2053] = "Cê tá espalhando pó roxo pra tudo conté lado...";
    text[2054] = "Ah, desculpa! Vamos ir embora mesmo!";
    text[2055] = "(Pó roxo... Provavelmente é a poeira do Reino Fantasma...)";
    text[2056] = "(Quando der, preciso lavar minhas botas.)";
    text[2057] = "(Espero que ninguém mais note...)";
    text[2058] = "Ouvi que há uma Estação Espacial abandonada em algum lugar no espaço.";
    text[2059] = "Dizem que os cientistas lá foram atacados há 100 anos por uma forma de vida alienígena.";
    text[2060] = "Ninguém sabe o que realmente aconteceu...";
    text[2061] = "Você sabia que o Banco de Dados dos Murks é atualizado constantemente com novas entradas?";
    text[2062] = "Ao avistar um Murk desconhecido, você poderá atribuir um Codinome a ele!";
    text[2063] = "Já sabíamos disso.";
    text[2064] = "Sim, já sabíamos.";
    text[2065] = "Ah...";
    text[2066] = "O motivo pelo qual não precisamos de um capacete de oxigênio fora da doca de naves...";
    text[2067] = "... é porque há um campo de força atmosférico ao redor de toda a estação!";
    text[2068] = "Esse campo de força atmosférico é chamado de Astrobarreira!";
    text[2069] = "Ele também nos protege de detritos espaciais aleatórios, como pequenos asteroides e rochas!";
    text[2070] = "Para detritos maiores, geralmente os vaporizamos com nossas armas a laser.";
    text[2071] = "Mas se houvesse algo maior...";
    text[2072] = "... de qualquer forma, preciso voltar logo ao trabalho.";
    text[2073] = "Estudamos Murks aqui na Estação Espacial.";
    text[2074] = "Infelizmente, as amostras que temos não duram muito...";
    text[2075] = "Murks não são feitos de Matéria, como nós, então coletar dados tem sido um processo bem lento.";
    text[2076] = "Há alguns cupons de comida e sobremesa na parede.";
    text[2077] = "Ahn?! Um dos cupons tem '041422' escrito.";
    text[2079] = "Há uma lista de dicas de batalha e conselhos dos principais guerreiros aqui!";
    text[2080] = "Um item em particular chamou sua atenção: CHIPS DE MELHORIA.";
    text[2081] = "CHIPS DE MELHORIA são uma categoria especial de itens que são caros e raros de se obter.";
    text[2082] = "Você pode equipar e desequipar CHIPS DE MELHORIA do seu MENU DE ITENS.";
    text[2083] = "CHIPS DE MELHORIA, como a MELHORIA DA ARMADURA, reduz todos os danos em batalha recebidos em 25.";
    text[2084] = "A MELHORIA TÁTICA permite que você use 2 Habilidades de Apoio por turno!";
    text[2085] = "Aparentemente, há somente 1 FICHA DE MELHORIA TÁTICA criada até hoje. Então ela é super rara!";
    text[2086] = "Essas Sabristolas são usadas durante sessões de treino. O sabre azul é super raro!";
    text[2087] = "Um punhado de Granadas de Atordoamento estão empilhadas na prateleira.";
    text[2088] = "Há uniformes de batalha extras aqui caso esqueça o seu!";
    text[2089] = "Os uniformes foram projetados para vestir confortavelmente qualquer pessoa!";
    text[2090] = "É uma Espaçonave Modelo 1! Essa nave funciona à base de eletricidade e luz solar!";
    text[2091] = "As peças de deslocamento estão sendo carregadas.";
    text[2092] = "O uso principal delas é ajudar a transportar cargas e pessoas de um lugar para o outro.";
    text[2093] = "Há algumas Jatoplataformas quebradas no chão.";
    text[2094] = "Parece que essas ferramentas são usadas para a manutenção de hovercrafts e outros maquinários.";
    text[2095] = "É uma Espaçonave Modelo 2! Essa nave suporta condições climáticas extremas!";
    text[2096] = "Aaaah! Dá para ver as pessoas lá atrás fabricando novos hovercrafts!";
    text[2097] = "Este monitor exibe os dados vitais e de saúde dos pacientes.";
    text[2098] = "Há alguns livros aqui escritos pelo dr. Thomas.";
    text[2099] = "Você pegou um livro chamado 'O Poder da Lux' da estante e começou a ler:";
    text[2100] = "A ciência confirmou a existência da alma, hoje conhecido como 'Lux'.";
    text[2101] = "Em termos simples, Lux é a energia da alma.";
    text[2102] = "Apesar de a Lux ser um campo de pesquisa relativamente novo, fizemos algumas descobertas.";
    text[2103] = "A Lux está fortemente ligada aos sentimentos, às emoções, à força de vontade e ao instinto.";
    text[2104] = "Algumas pessoas podem ter uma Lux mais forte que outras.";
    text[2105] = "Minha equipe teorizou que, em raros casos, a Lux possivelmente pode ser acumulada e manipulada.";
    text[2106] = "(Será que isso tem a ver com as sensações estranhas que tenho tido?)";
    text[2107] = "(Em algum momento, preciso falar sobre isso com o meu pai...)";
    text[2108] = "É um frasco de Fluido de Antinúcleo.";
    text[2109] = "Eles são usados como fontes de energia para Exoesqueletos e outras tecnologias armamentistas de antimatéria.";
    text[2110] = "Os frascos nesta área sofreram alguns danos.";
    text[2111] = "Parece que algumas plantas estão crescendo nos frascos que simulam condições diversas.";
    text[2112] = "Parece que este computador é usado para monitorar o crescimento das plantas.";
    text[2113] = "Há um livro aqui chamado: Cultivando Comida no Espaço!";
    text[2114] = "Há um livro aqui chamado: Cento e Uma Receitas Espaciais!";
    text[2115] = "Há um relatório que detalha uma planta vermelha que foi avistada e tem dentes iguais a uma piranha.";
    text[2116] = "Hm... Aparentemente, a Equipe Botânica gosta mesmo de tomar chá verde de jasmim.";
    text[2117] = "Uma variedade de sementes de plantas e alimentos estão guardadas nos compartimentos de armazenamento.";
    text[2118] = "Essas caixas contêm grãos de café recém-torrados da mais alta qualidade!";
    text[2119] = "Este painel de controle cria monitores holográficos interativos.";
    text[2120] = "Ele é usado frequentemente em reuniões para ajudar a visualizar ideias e projetos.";
    text[2121] = "É o computador do dr. Thomas!";
    text[2122] = "Algumas pastas visíveis no computador: Antimatéria, DNA de Murks e Amantes de Café.";
    text[2123] = "Muitos anos de respingos de café mancharam a escrivaninha com uma cor marrom.";
    text[2124] = "Minha mãe tentou fazer meu pai jogar fora sua escrivaninha, mas ele se recusa a trocá-la.";
    text[2125] = "Por quê?";
    text[2126] = "Muito valor sentimental.";
    text[2127] = "Ele teve suas melhores ideias enquanto trabalhava longas noites nesta escrivaninha.";
    text[2128] = "Ele também disse que ela tinha aroma de café... Credo.";
    text[2129] = "Há um livro aqui chamado: Como Equilibrar a Vida Pessoal e Profissional.";
    text[2130] = "É um super computador avançado que monitora o Gerador de Buraco de Minhoca.";
    text[2131] = "Há arquivos super confidenciais aqui: Energia Escura, Matéria Escura, Astrotécnicas.";
    text[2132] = "O computador está monitorando a trajetória do Cometa de Antimatéria: Coda.";
    text[2133] = "Este computador está monitorando os níveis de energia de Antimatéria. Parece que estão bem baixos.";
    text[2134] = "Este é o protótipo do Gerador de Buraco de Minhoca: Celestia.";
    text[2135] = "A sobrevivência da humanidade depende da conclusão bem-sucedida deste gerador.";
    text[2136] = "Essas caixas estão cheias de brinquedos antigos e outras recordações.";
    text[2138] = "Você tem um computador bem sofisticado que pode rodar muitos programas ao mesmo tempo.";
    text[2139] = "O plano de fundo do seu computador é uma foto da Família Grey na Praia de Oceanus.";
    text[2140] = "Dr. Thomas está carregando Thea em seus braços e Thea está carregando a Bella bebê.";
    text[2141] = "Este monitor exibe as condições da Astrobarreira em cada Setor.";
    text[2142] = "Se um Setor é violado, os setores ao redor entram em confinamento";
    text[2143] = "para evitar um dano maior no Astroecossistema.";
    text[2144] = "Este monitor exibe os níveis de oxigênio, nitrogênio e dióxido de carbono em Luna.";
    text[2145] = "Este computador está ligado a um sensor de proximidade avançado integrado na Estação Espacial.";
    text[2146] = "Ele pode medir com precisão a distância entre diversos objetos.";
    text[2147] = "Este computador está ligado a um leitor molecular.";
    text[2148] = "Ele pode determinar a composição molecular de objetos que estão a uma longa distância.";
    text[2149] = "Nosso sol é um superastro azul que está próximo do fim...";
    text[2150] = "O quê?? Não pode ser!";
    text[2151] = "Ah! Não queria assustá-la. Não se preocupe.";
    text[2152] = "Ele ainda tem cerca de 7 milhões de anos de vida ainda queimando";
    text[2153] = "antes de explodir e deixar de existir.";
    text[2154] = "...";
    text[2155] = "Desculpe pelo drama existencial... Quando se estuda algo a vida toda,";
    text[2156] = "às vezes, você não quer saber de certas coisas. A ignorância é uma bênção.";
    text[2157] = "Preciso me manter calma. Preciso me manter calma. Preciso me manter calma. Preciso me manter calma.";
    text[2158] = "(Ela está bem?)";
    text[2159] = "(Ela parece super ansiosa. Vamos deixá-la quietinha.)";
    text[2160] = "Fascinante! Há alguns meses, nos deparamos com uma ";
    text[2161] = "espaçonave interestelar desconhecida que continha um Disco de Ouro.";
    text[2162] = "Levou um tempo até decodificarmos tudo, mas descobrimos que";
    text[2163] = "o Disco de Ouro veio de uma galáxia que fica a 2,5 milhões de anos-luz de nós.";
    text[2164] = "O Disco continha imagens, músicas, sons e saudações de um planeta chamado 'Terra'.";
    text[2165] = "Levou milhões de anos para este Disco chegar até nós... ";
    text[2166] = "Não sabemos se essa civilização ainda existe, mas sempre há esperança.";
    text[2167] = "Estamos nos esforçando para nos comunicar com os terráqueos agora mesmo.";
    text[2168] = "Eles certamente ficarão felizes de saber que há vida inteligente no universo.";
    text[2169] = "Vamos torcer para isso dar certo.";
    text[2170] = "Esses são usados para prática de alvo! Não seja pega no fogo cruzado!";
    text[2171] = "Estou no dia 29 de 30 do meu treinatlo... Quase lá... Estou um caco...";
    text[2172] = "Raiá! Tome isso! Vou conseguir! Vou realizar meus sonhos!";
    text[2173] = "Isso que é um soldado hiperfocado no treino.";
    text[2174] = "A Equipe Botânica é responsável pelo estudo da biologia das plantas no espaço.";
    text[2175] = "Nossa pesquisa nos ajuda a cultivar comidas mais nutritivas e melhores!";
    text[2176] = "Sinto falta de ir lá fora e sentir a natureza.";
    text[2177] = "Tenho uma grande paixão por ciência e plantas, por isso amo trabalhar aqui, mas...";
    text[2178] = "Sinto que saudade dos dias que passava com a minha família no Rancho Kepler.";
    text[2179] = "Ar fresco... Belas árvores e florestas... Era um paraíso.";
    text[2180] = "Minha especialidade são Espaçonaves e Hovercrafts.";
    text[2181] = "Sei tudo o que há para saber sobre eles!";
    text[2182] = "Por exemplo, cada Espaçonave tem 3 partes modulares que você pode personalizar:";
    text[2183] = "Há o CHASSI, as ASAS e o PROPULSOR da nave!";
    text[2184] = "Ao comprar sua primeira parte de nave, você desbloqueia a Personalização de Espaçonave!";
    text[2188] = "Ser capaz de mudar a cor da sua espaçonave lhe trará um ar de mudança!";
    text[2185] = "Assim que a Dobra do Mapa-múndi ficar disponível, tudo o que precisa fazer é";
    text[2186] = "interagir com ele e selecionar PERSONALIZAR NAVE!";
    text[2137] = "Há várias coisas jogadas no seu closet.";
    text[2189] = "Não há nada de novo no seu closet.";
    text[2190] = "Você encontrou sua antiga coleção de ioiôs.";
    text[2191] = "Você encontrou um livro: Guia Essencial do Melhor Escudeiro.";
    text[2192] = "Ah... isso é...";
    text[2193] = "É meu. Esqueci que havia deixado aí.";
    text[2194] = "Tetra besta.";
    text[2199] = "Você encontrou seu maiô favorito.";
    text[2200] = "Que vontade de ir para a praia...";
    text[2195] = "Você encontrou uma roupa de coelho clássica.";
    text[2196] = "Acho que ainda cabe!";
    text[2197] = "Tetra, onde está sua fantasia de Dia das Bruxas?";
    text[2198] = "Hunf. No lixo.";
    text[2201] = "EU ERA UMA CENOURA.";
    text[2202] = "Chegamos tarde e era tudo o que tinham na loja...";
    text[2203] = "Ok. Do que quer se fantasiar este ano?";
    text[2204] = "Hmm...";
    text[2205] = "Desta vez, eu serei o coelho e você a cenoura. MUAHAHAHAHA.";
    text[2206] = "Você encontrou uma legging e roupa de academia.";
    text[2207] = "Ah, isso me lembrou que preciso fazer minhas flexões e abdominais diários!";
    text[2208] = "Você encontrou o Diploma de Graduação da Academia Lunex!";
    text[2209] = "Você também encontrou o Certidão de 1º Lugar no Concurso de Quem Come Mais Cheesecake...";
    text[2210] = "Debaixo das roupas, há um estoque de barras de cheesecake.";
    text[2211] = "PRECISO RESISTIR À TENTAÇÃO.";
    text[2212] = "Você encontrou seu quimono de faixa-preta.";
    text[2213] = "BOAS-VINDAS À SALA DE SIMULAÇÃO DE BATALHA. EM QUE POSSO AJUDAR?";
    text[2214] = "BATALHAR";
    text[2215] = "INFORMAÇÕES";
    text[2216] = "ESQUECE";
    text[2217] = "MINHA PRINCIPAL FUNÇÃO É FORNECER A GUERREIROS A OPORTUNIDADE DE ";
    text[2218] = "TESTAR SUAS NOVAS HABILIDADES E COMBOS LUX.";
    text[2219] = "SE PUDER ME DERROTAR EM BATALHA, VOCÊ RECEBERÁ DINHEIRO E EXP!";
    text[2220] = "MODO DE BATALHA ATIVADO!";
    text[2221] = "POIS BEM. TENHA UM DIA INCRÍVEL!";
    text[2222] = "Este computador era usado para reservar uma cápsula de recuperação.";
    text[7128] = "Esses Murks de cores alternadas...";
    text[7129] = "Eles não só parecem diferentes como também são mais fortes e mais rápidos!";
    text[7130] = "GRRRRRRRRR!";
    text[7131] = "KHHHHAAAAA!";
    text[7132] = "Isso não pode ser algo aleatório...";
    text[7133] = "Aposto que isso é um ataque premeditado.";
    text[7134] = "Murks não são conhecidos por aparecer aqui fora no espaço...";
    text[7135] = "Eles geralmente surgem lá embaixo, em Luna.";
    text[7196] = "Tome cuidado, Bella.";
    text[7197] = "Pode deixar, não se preocupe.";
    text[7198] = "Vou garantir que meu pai esteja bem e volte em segurança para casa.";
    text[7199] = "Pronta para ir para a Base Militar? Mié.";
    text[7200] = "Pegou o que precisava no seu quarto?";
    text[7201] = "Ah, ainda não!";
    text[2541] = "Não precisamos ir para lá neste instante.";
    text[2542] = "SETOR 4 - OCEANUS";
    text[5094] = "RECIFE HARMONIA À FRENTE - MANTENHA NOSSAS ÁGUAS LIMPAS!";
    text[5178] = "As antigas marcações na parede estão reagindo à sua presença.";
    text[5179] = "?? ...";
    text[5484] = "Gostaria de mergulhar?";
    text[5485] = "Gostaria de voltar à superfície?";
    text[5540] = "Parece algum tipo de portal. Não parece estar ativo.";
    text[5541] = "Gostaria de descer para um nível inferior?";
    text[5432] = "AO COMPLETAR A PROVAÇÃO DE ALMAS, UMA NOVA PERCEPTORA DE ALMAS DEVERÁ DESPERTAR...";
    text[5546] = "TU DEVERÁS CARREGAR A VONTADE DOS SETE CAMPEÕES...";
    text[5547] = "... PARA RESTAURAR O EQUILÍBRIO UNIVERSAL.";
    text[5439] = "Há algumas gravações aqui que mencionam Técnicas de Batalha dos Antigos usando";
    text[5440] = "uma arma chamada Espada Relíquia.";
    text[5441] = "Essa espada era capaz de canalizar a Lux do usuário para realizar artes especiais.";
    text[5433] = "ESPADA RELÍQUIA VERMELHA: CONCEDE FORÇA AO PORTADOR.";
    text[5434] = "ESPADA RELÍQUIA AZUL: AUMENTA A LUX DO PORTADOR.";
    text[5435] = "ESPADA RELÍQUIA AMARELA: FORTALECE AS DEFESAS DO PORTADOR.";
    text[5581] = "PARA EVOLUIR ALÉM DAS ARTES PADRÕES DA ESPADA RELÍQUIA.";
    text[5582] = "O PORTADOR PODE COMBINAR GEMAS PARA OBTER UM PODER MAIOR.";
    text[5436] = "ARTE SECRETA DA ESPADA RELÍQUIA LARANJA: CONCEDE REGENERAÇÃO DE PE AO PERCEPTOR DE ALMAS.";
    text[5437] = "ARTE SECRETA DA ESPADA RELÍQUIA VERDE: CURA O PERCEPTOR DE ALMAS.";
    text[5438] = "ARTE SECRETA DA ESPADA RELÍQUIA ROXA: CHANCE DE NOCAUTEAR SEU INIMIGO INSTANTANEAMENTE.";
    text[5510] = "AOS VIAJANTES ERRANTES QUE LEEM NOSSOS TEXTOS...";
    text[5511] = "LEVE CONSIGO... A SABEDORIA E AS HISTÓRIAS DO NOSSO POVO...";
    text[5512] = "NÃO SABEMOS O QUE O FUTURO NOS RESERVA...";
    text[5513] = "MAS ESPERAMOS QUE VOCÊS POSSAM TER ÊXITO, ONDE NÓS FALHAMOS...";
    text[5514] = "Espera aí! Não lembro de ter lido isso da última vez que estive aqui.";
    text[5515] = "Os textos mudaram?? Não pode ser.";
    text[5516] = "Talvez alguns textos apareçam somente quando há alguém com";
    text[5517] = "genética dos Antigos presente? Não descartaria essa possibilidade.";
    text[5518] = "Interessante!";
    text[5519] = "Isso significa que...";
    text[5520] = "Todos os textos dos Antigos que a humanidade coletou e preservou podem estar";
    text[5521] = "guardando mais informações e segredos do que achávamos!";
    text[5522] = "Isso pode ser a descoberta do século!";
    text[5523] = "Vamos conferir o resto dos textos na parede!";
    text[5524] = "Gente... Corre 'aventura' nas veias deles ou o quê?!";
    text[5525] = "É bom vê-lo empolgado assim para variar.";
    text[5526] = "Então ele é um cara casca grossa por fora, mas um bobão por dentro?";
    text[5527] = "Ei! O que vocês estão cochichando aí?";
    text[5528] = "Nada!";
    text[5529] = "É, nada!";
    text[5534] = "SOLDADO DA LUZ: NOSSO LUMICAVALEIRO PERFEURADOR DOS CÉUS";
    text[5535] = "LUX: A MANIFESTAÇÃO DA ALMA.";
    text[5536] = "CASO UM GUERREIRO APRENDA A MANIPULÁ_LA...";
    text[5537] = "O PODER DE MUDAR O MUNDO ESTARÁ AO ALCANCE...";
    text[5538] = "ANTIMATÉRIA: O PODER CAÓTICO E ETÉREO DO UNIVERSO.";
    text[5539] = "A ETERNIDADE CÓSMICA DEVE PERMANECER AO ALCANCE";
    text[5542] = "CRUZAR O REINO NÃO É MAIS SEGURO...";
    text[5543] = "PRECISAMOS EVOLUIR...";
    text[5544] = "OU PERECER EM UM SONO ETERNO PELO PODER GALÁTICO DE...";
    text[5545] = "NOSSO NÊMESIS.";
    text[5548] = "O SELO FOI DESFEITO.";
    text[5549] = "A ESPADA DOS ANTIGOS AGORA É SUA PARA BRANDIR.";
    text[5551] = "Uau! É um Exoesqueleto dos Antigos!";
    text[5552] = "Sim, nossos exoesqueletos e armamentos atuais foram derivados da";
    text[5553] = "tecnologia deixada pelos Antigos.";
    text[5554] = "É incrível como os cientistas foram capazes de descobrir como usar essa tecnologia.";
    text[5555] = "Você precisa dar o crédito à humanidade. Ciência é o nosso forte! Hehe.";
    text[5556] = "EXOESQUELETO LUNAR... O M............ DORME.";
    text[5557] = "L...N...R...X";
    text[5558] = "EXOESQUELETO TERRESTRE... OBLÍVIO...";
    text[5559] = "O RESTO DO TEXTO NESTA ESTÁTUA ESTÁ ILEGÍVEL.";
    text[5560] = "NOSSOS SETE CAMPEÕES...";
    text[5561] = "A SABEDORIA DE TYCHO";
    text[5562] = "A BRAVURA DE SÍLICA";
    text[5563] = "A DETERMINAÇÃO DE COPERNICUS";
    text[5564] = "A BONDADE DE LUMINA";
    text[5565] = "A JUSTIÇA DE MAGNÉSIA";
    text[5566] = "A ARROGÂNCIA DE GRIMALDI";
    text[5567] = "A CONFIANÇA DE REGALIA";
    text[5568] = "Esses nomes...";
    text[5569] = "Esses são os nomes das nossas colônias!";
    text[5570] = "Os sete campeões...";
    text[5571] = "Sabemos que nossas Colônias Lunares foram nomeadas em homenagem aos seus fundadores.";
    text[5572] = "Estranho... Não há registros dos Antigos terem vivido durante";
    text[5573] = "a época que nossas colônias foram fundadas.";
    text[5574] = "Quem sabe foi uma grande coincidência?!";
    text[5575] = "Não sei...";
    text[5576] = "Se conseguimos sobreviver ao Cometa Coda, terei que investigar isso.";
    text[5577] = "Esta placa tem uma ilustração retratando Luna e Terra em um dos lados...";
    text[5578] = "O outro lado foi destruído.";
    text[5579] = "FOI A NOSSA JORNADA EM BUSCA DA ETERNIDADE QUE NOS LEVOU À DERROTA?";
    text[5580] = "SOMENTE O TEMPO DIRÁ...";
    text[5584] = "O CICLO DE CALAMIDADE CÓSMICA É INEXORÁVEL...";
    text[5585] = "QUEM SABE A UNIFICAÇÃO DA LUX COM A ANTIMATÉRIA SEJA A CHAVE...";
    text[5586] = "... DUAS FORÇAS QUE UNEM EM UM PODER ESPIRALAR...";
    text[5587] = "CARREGANDO UMA VONTADE INABALÁVEL DE SOBREVIVER E CONQUISTAR O FUTURO.";
    text[5588] = "O PILAR DA PAZ...";
    text[5589] = "... É TÃO FORTE QUANTO A BASE DA COMUNICAÇÃO.";
    text[5590] = "A CAPACIDADE DE SE CONECTAR PELA ALMA...";
    text[5591] = "... RESULTARÁ EM UMA COMPREENSÃO MÚTUA.";
    text[5592] = "É uma estátua representando um antigo aventureiro.";
    text[5593] = "Há uma GEMA incrustada naquele baú.";
    text[5594] = "Você toca a GEMA gentilmente... e ela começa a desaparecer!";
    text[5595] = "Uma voz ecoa pelas ruínas:";
    text[5596] = "RESTAM TRÊS GEMAS.";
    text[5597] = "RESTAM DUAS GEMAS.";
    text[5598] = "RESTA UMA GEMA.";
    text[5599] = "VOCÊ SE SAIU BEM, PERCEPTORA DE ALMAS.";
    text[5600] = "RETORNE AO NÍVEL SUPERIOR. ESTAREI À SUA ESPERA.";
    text[5482] = "O COMBO SAGRADO DE LUX DOS ANTIGOS...";
    text[5483] = "TRÊS ESPADAS RELÍQUIAS... E GUARDIA DEVERÁ APARECER EM BATALHA.";
    text[2795] = "Este Exoesqueleto Guerreiro foi trazido para ajudar a proteger os cidadãos do perigo.";
    text[2796] = "Senhorita Bella, não se preocupe com os Murks. Cuidaremos deles!";
    text[2797] = "Que droga! Esses Murks tomaram Ener-G antes de aparecer??";
    text[2798] = "Eles estão muito mais rápidos e mais fortes que os Murks que estamos acostumados a enfrentar.";
    text[2799] = "Todo esse estrago e esse caos... Será que um dia terá fim?";
    text[2800] = "Isso é terrível. O que poderia ter causado um surto tão grande?";
    text[2801] = "Vocês viram alguma Máquina Filtrante por aí?";
    text[2802] = "Hm. Acho que havia uma ao norte.";
    text[2803] = "Está perto da Loja Conexões Neurais!";
    text[2804] = "Senhorita Bella, evacuamos todos além daqui.";
    text[2805] = "Esta área está interditada no momento.";
    text[2806] = "KYAHAHAHAHAHGH!!";
    text[3319] = "O Café Copernicus está fechado no momento.";
    text[3320] = "Os Murks estão em maior número...";
    text[3321] = "A Equipe Médica deve chegar em breve! Aguentem firme!";
    text[3322] = "...";
    text[3323] = "Acabei de escaneá-lo. Ele está bem.";
    text[3324] = "Ei! Não fale alto! Você vai estragar meu disfarce.";
    text[3325] = "E-esses Murks são fortes demais para mim...";
    text[3326] = "Este soldado está inconsciente...";
    text[3327] = "O ar frio escapa pela saída de ar.";
    text[3328] = "A porta está trancada. Acesso Restrito a Residentes.";
    text[3329] = "A porta está trancada.";
    text[3332] = "O prédio do Sistema de Água está em manutenção no momento.";
    text[3333] = "É um berço de Flox-da-noite.";
    text[3334] = "Elas têm um aroma agradável de baunilha, amêndoa e mel.";
    text[3335] = "Essa escotilha de acesso leva à infraestrutura do reservatório de água";
    text[3336] = "sob a cidade. Infelizmente, está trancada pelo outro lado.";
    text[3337] = "AVISO: MÁQUINAS FILTRANTES SOB VIGILÂNCIA 24 HORAS";
    text[3338] = "NÃO MEXA. ACESSO RESTRITO.";
    text[3339] = "Você ouve sons estranhos do outro lado da porta.";
    text[3340] = "Hoverporto de Copernicus";
    text[3341] = "SETOR 7 - COPERNICUS\nDistrito Norte";
    text[3342] = "SETOR 7 - COPERNICUS\nDistrito Sul";
    text[3343] = "SETOR 7 - COPERNICUS\nDistrito Central";
    text[3344] = "Este monitor exibe o mapa de Copernicus!";
    text[3345] = "Há um pequeno bilhete no monitor:";
    text[3346] = "Espaço 1 - Para Cima";
    text[3347] = "Espaço 2 - Direita";
    text[3348] = "Espaço 3 - Para Baixo";
    text[3349] = "Espaço 4 - Esquerda";
    text[3350] = "Espaço 5 - Direita";
    text[3351] = "SETOR 7 - COPERNICUS\nDistrito Leste 439";
    text[3352] = "Boas-vindas ao Café Copernicus!";
    text[3353] = "Aproveite nossas deliciosas barras de cheesecake e os famosos milkshakes de morango!";
    text[3354] = "É uma caixa de ferramentas abandonada.";
    text[3355] = "Há um bilhete dentro com alguns números escritos: 439625.";
    text[3356] = "Esta máquina de vendas vende Palichocos, um biscoito de amêndoas e chocolate delicioso!";
    text[3357] = "Aff... Por que tem cocô de gato nessa lixeira?";
    text[3358] = "Senhorita Bella, todos os civis foram evacuados!";
    text[3359] = "Também derrotamos todos os Murks nas proximidades.";
    text[3360] = "Parece que as coisas se acalmaram um pouco.";
    text[3361] = "Tenho alguns soldados conferindo para garantir que não há mais Murks.";
    text[3362] = "Assim que avaliarmos totalmente a extensão dos estragos,";
    text[3363] = "os civis poderão retornar em segurança para suas casas.";
    text[3364] = "Estou morta...";
    text[3365] = "Esses Murks eram mais fortes do que esperávamos...";
    text[3366] = "Odeio aqueles Murks espectros... Eles têm tanto PV...";
    text[3367] = "Você tem alguma Habilidade ou Combo Lux que ataque mais de um inimigo por vez?";
    text[3368] = "Não... Não é à toa que eu estava tendo dificuldades.";
    text[3369] = "Este soldado está cansado demais para falar...";
    text[3370] = "Descanse. Você fez um bom trabalho!";
    text[3371] = "Alguns de nossos soldados estão tratando suas feridas com a Equipe Médica.";
    text[3372] = "Você coloca o ouvido contra a porta do banheiro.";
    text[3373] = "Só consegue ouvir um miado ou um ronronado.";
    text[3374] = "Por que isso SEMPRE ACONTECE??";
    text[3375] = "Terminei de comer e percebi que o banheiro estava livre.";
    text[3376] = "O garçom trazia minha conta quando vi algo correndo para o banheiro.";
    text[3377] = "Aconteceu tão rápido, só vi um borrão.";
    text[3378] = "Eles precisam se apressar, cara... Estou esperando faz 30 minutos!";
    text[3379] = "Hm... Por que não bate na porta? Assim fica claro que tem alguém esperando.";
    text[3380] = "Isso não é falta de educação? Prefiro esperar...";
    text[3381] = "... Hm.";
    text[3382] = "Participe da nossa competição anual de pesca em Oceanus!";
    text[3383] = "Temos sorteios, prêmios e peixe frito grátis!";
    text[3384] = "Um dos recados tem algo escrito:";
    text[3385] = "Pelas estrelas! A comida aqui é deliciosa!";
    text[3386] = "Sim! Cada Café tem sua própria especialidade!";
    text[3387] = "Eu ouvi dizer que o Café Regolithia é bastante subestimado. Deveríamos ir lá um dia!";
    text[3388] = "Até a próxima, guerreira prodígio.";
    text[3389] = "Ei!";
    text[3390] = "Os cidadãos de Copernicus estão lidando surpreendentemente bem com tudo,";
    text[3391] = "especialmente após tudo o que aconteceu hoje.";
    text[3392] = "Não é raro que constantemente as coisas deem errado em Luna.";
    text[3393] = "A maioria dos cidadãos, mesmo os mais novos, é treinada para lidar com";
    text[3394] = "situações e cenários de emergência.";
    text[3395] = "Afinal de contas, vivemos em um belo satélite prateado no espaço sideral.";
    text[3396] = "Antes dos Murks, as pessoas se preocupavam com a manutenção dos sistemas de";
    text[3397] = "Gravidade e Oxigênio. ";
    text[3398] = "Era uma batalha constante para melhorar a tecnologia e garantir que Luna fosse um lugar mais seguro para se viver.";
    text[3399] = "É um cartaz antigo divulgando a Pizza Lua Funga!";
    text[3400] = "Há um aviso embaixo: 'Em honra ao Dia Nacional do Queijo Mofado,";
    text[3401] = "queremos informar que a Lua não é feita de queijo.' - WAZA";
    text[3402] = "A data no cartaz é de 9 de outubro de 2019.";
    text[3405] = "Hoje foi estressante demais! Preciso de uma comida reconfortante...";
    text[3406] = "Agradecemos a vista ao Café Copernicus!";
    text[3407] = "Esperamos que tenha gostado da sua experiência e agradecemos pelos seus serviços!";
    text[3408] = "É um cartaz divulgando um jato de turismo para visitar Oceanus.";
    text[3409] = "'Venha ver as belas e famosas Pedras Lunares de perto!'";
    text[3410] = "Tem mais escrito na parte de baixo do cartaz:";
    text[3411] = "Esta porta leva à cozinha.";
    text[3412] = "Você espia pelo vidro embaçado e vê um cachorrinho usando um chapéu de chef.";
    text[3413] = "Regulações de Segurança Alimentar e Documentação de Direitos Trabalhistas";
    text[3414] = "estão fixadas neste quadro de avisos.";
    text[3415] = "Mãe, veja! É nossa heroína!";
    text[3416] = "Olá, querida! Desde que você nos salvou daqueles Murks,";
    text[3417] = "meu filho não para de falar como você foi incrível e heroica.";
    text[3418] = "Você realmente o inspirou a ter coragem, mesmo diante do perigo.";
    text[3419] = "S-senhorita, quero que fique com isso.";
    text[3420] = "Pelúcia do BERSERK BOY obtida!";
    text[3421] = "Uma nova pelúcia foi adicionada ao seu quarto!";
    text[3422] = "Ah! Obrigada pelo presente!";
    text[3423] = "É minha pelúcia favorita. Hehehe.";
    text[3424] = "Cuide-se, meu bem!";
    text[3425] = "Tchau, tchau! Cuide bem da minha pelúcia por mim! Hehe.";
    text[3426] = "Esse garoto vai se tornar um guerreiro eletrizante algum dia.";
    text[3427] = "Tenho certeza disso.";
    text[3428] = "O prédio do Sistema de Água sofreu os maiores estragos de hoje.";
    text[3429] = "A cobertura está uma zona! O que centelhas aconteceu lá em cima??";
    text[3430] = "Hehehe.";
    text[3403] = "A destruição frequente dos Murks nos forçou a melhorar nossa";
    text[3404] = "tecnologia de construção. Agora leva apenas algumas horas para reparar nossas cidades!";
    text[3453] = "Enquanto realizávamos uma inspeção no Distrito Leste, meu companheiro e eu encontramos um Cofre Trancado.";
    text[3454] = "Tentei diversas combinações, mas não consegui abri-lo.";
    text[3455] = "Mesmo assim... Tenho um forte pressentimento de que o Espaço 3 é Para Baixo.";
    text[3456] = "(Meu instinto diz que o Espaço 4 é Esquerda...)";
    text[3457] = "Hm... O que eu tô resmungando?";
    text[3458] = "(Se ela descobrir... talvez ela ache o código antes de mim.)";
    text[3459] = "Você resmunga bem alto. Praticamente está falando seus pensamentos em voz alta.";
    text[3460] = "Droga. Finja que não ouviu nada.";
    text[3461] = "Meu parceiro também não vai falar nada. Hunf.";
    text[3462] = "Este surto me mostrou como preciso treinar mais.";
    text[3463] = "Você viu o Esquadrão Raine em ação??";
    text[3464] = "Elas estavam lutando e derrotando Murks a torto e a direito,";
    text[3465] = "isso tudo enquanto garantiam que os cidadãos eram evacuados em segurança.";
    text[3466] = "Ficarei feliz se tiver a metade da força do Esquadrão Raine um dia.";
    text[3467] = "Você conhece os EFEITOS DE STATUS?";
    text[3468] = "Quando você ATORDOA um inimigo, a Fase de Ataque dele é pulada por 1 turno!";
    text[3469] = "Quando você QUEIMA um inimigo, geralmente leva 3 turnos.";
    text[3470] = "Inimigos queimados perdem 30 de PV no início da Fase de Ataque deles.";
    text[3471] = "Uau! Você pesquisou mesmo!";
    text[3472] = "Hehe. Minha mãe era a Comerciante de Conexões Neurais. Aprendi tudo com ela!";
    text[3473] = "A Força Lunex me enviou para garantir que a Rede de Distribuição de Água permaneça operacional.";
    text[3474] = "Impressionante que sua escudeira robô consertou a Rede tão facilmente.";
    text[3475] = "Hihi.";
    text[3476] = "Faz algumas horas desde que abrimos a reserva da cidade.";
    text[3477] = "As rodovias e estradas estão bem vazias.";
    text[3478] = "Acho que levará um tempo até a cidade estar agitada novamente.";
    text[3479] = "Saros nos aconselhou a patrulhar a cidade por mais algumas horas no caso de";
    text[3480] = "alguns Murks não terem sido vistos. Nunca se sabe o que pode desencadear outro surto.";
    text[3481] = "O quê?! Você não só foi encarregada de restaurar a Rede de Distribuição de Água,";
    text[3482] = "também faz parte da operação secreta de finalmente capturar o Murktador??";
    text[3483] = "A cidade de Copernicus foi construída sobre uma cratera de impacto lunar de 90 km.";
    text[3484] = "Apesar de ser uma das maiores crateras em Luna, certamente não é a mais funda.";
    text[3485] = "Esse título vai para Grimaldi: A Cratera da Escuridão Eterna, como a chamamos.";
    text[3486] = "Há partes de Grimaldi que são tão profundas que a luz do sol não chega lá.";
    text[3487] = "A cidade é ótima e tudo mais,";
    text[3488] = "mas acho que é hora de ir para outro setor.";
    text[3489] = "O Rancho Kepler parece um lugar agradável e pacífico para se viver.";
    text[3565] = "É um Sistema de Painéis Lunares de alta voltagem.";
    text[3566] = "Algum engraçadinho pichou piadinhas de cone neste cone.";
    text[3567] = "É um cone de sinalização abandonado.";
    text[3568] = "Este balde está cheio de água mineral rica em nutrientes.";
    text[3569] = "SETOR 8 - RANCHO KEPLER";
    text[3571] = "Ei, não é a casa da Zara?";
    text[3572] = "Sim! Ela não está em casa agora. Vamos voltar mais tarde.";
    text[3573] = "É uma caixa de ferramentas vermelha enferrujada.";
    text[3574] = "Que mistérios se escondem aí dentro? Ninguém sabe.";
    text[3575] = "É uma caixa de ferramentas azul bem prática. Parece que tem sido usada com frequência.";
    text[3576] = "Os poços d'água fornecem um suprimento confiável e amplo de água doce";
    text[3577] = "para os residentes daqui do Rancho Kepler.";
    text[3578] = "É um grande Gerador de Energia disfarçado de poço d'água.";
    text[3579] = "Olha! O Rancho Kepler também tem Painéis Lunares!";
    text[3580] = "Parece que uma lojinha vai abrir aqui em breve.";
    text[3581] = "É um Quadro Comunitário antigo. Vagas de trabalho, propagandas,";
    text[3582] = "notícias e panfletos para refeições comunitárias são fixadas aqui com frequência.";
    text[3583] = "Uma pequena nota adesiva chama sua atenção.";
    text[3584] = "Ela tem os números 323881 escritos.";
    text[3585] = "Ouvi dizer que comer esses cogumelos faz a gente crescer bastante.";
    text[3586] = "Quê?! Onde você ouviu isso?";
    text[3587] = "Tenho minhas fontes. Hihi.";
    text[3588] = "Esta placa aponta para diferentes fazendas no Rancho Kepler.";
    text[3589] = "Esses contêineres de transporte possuem controle de temperatura para que a comida";
    text[3590] = "e a produção dentro se mantenham frescas por longos períodos.";
    text[3591] = "Uma pilha de lenha recém-cortada!";
    text[3592] = "Abóbora, trigo e alface estão crescendo nesse pedaço de terra.";
    text[3593] = "Milho, trigo e batatas estão crescendo neste pedaço de terra.";
    text[3594] = "Veja, Bella! Há repolhos, milhos, abóboras e morangos aqui!";
    text[3595] = "Algumas roupas lavadas à mão estão penduradas aqui para secar.";
    text[3596] = "Esta lixeira está cheia até a borda com latas de Hetap.";
    text[3597] = "As colheitas aqui foram violentamente arrancadas do solo.";
    text[3598] = "Há traços de antimatéria no solo aqui...";
    text[3599] = "Uma menta sobrevivente. Há pequenas pegadas no solo.";
    text[3600] = "Esta máquina de vendas está vendendo cupcakes de Red Velvet. Está com o estoque cheio.";
    text[3601] = "A Raine mora neste prédio, né?";
    text[3602] = "Sim, mas ela não está aqui agora. Vamos voltar mais tarde.";
    text[3603] = "Aqui na Ener-G Ltda, sua saúde é o que importa.";
    text[3604] = "Use para melhorar sua saúde! CÓDIGO: 501996";
    text[3605] = "AVENIDA ASTRO";
    text[3606] = "SETOR 15 - TYCHO";
    text[3607] = "Boas-vindas à cidade da ciência e tecnologia!";
    text[3608] = "É o Fórum de Tycho!";
    text[3609] = "Boas-vindas ao Café Tycho!";
    text[3610] = "Aproveite deliciosos sanduíches de frango e os famosos cupcakes de Green Velvet!";
    text[3611] = "O Café Tycho está fechado no momento para reforma.";
    text[3612] = "Ah! Queria experimentar a comida deles. Vamos voltar quando reabrir!";
    text[3613] = "Esta máquina de vendas tem os cupcakes de Green Velvet, mas está sem estoque.";
    text[3614] = "É uma propaganda do sanduíche de frango crocante do Café Tycho!";
    text[3615] = "Esta porta só abre com um CARTÃO DE ACESSO.";
    text[3616] = "ENER-G LTDA";
    text[3617] = "Frase do dia: 'Rejeite o senso comum para tornar o impossível possível!'";
    text[3666] = "Sou o CEO do famoso produto capilar: NunCareca!";
    text[3667] = "Minha grande paixão é garantir que nossos clientes sempre tenham cabelos saudáveis e sedosos!";
    text[3701] = "Os negócios estão sempre bombando em Tycho.";
    text[3702] = "Há prédios corporativos, lojas, comerciantes, restaurantes... de tudo!";
    text[3703] = "Pessoalmente, gosto de conferir os outlets e aproveitar alguma bebida no Café Tycho.";
    text[3704] = "E-ei! Você é aquela Soldada Lunex do cabelo rosa! Senhorita Bella, né?!";
    text[3705] = "Sim, eu mesma. Já nos conhecemos?";
    text[3706] = "Na verdade, não... Minha mulher e meu filho que falaram de você.";
    text[3707] = "Você é quem os salvou de um grupo de Murks durante o surto recente...";
    text[3708] = "Não tenho como agradecê-la!";
    text[3709] = "Ah, não se preocupe com isso! Fico feliz que sua família esteja a salvo agora.";
    text[3710] = "Eu vivo em Copernicus e venho para Tycho a trabalho.";
    text[3711] = "Quando ouvi as notícias, fiquei muito preocupado...";
    text[3712] = "Obrigado mais uma vez, senhorita Bella! Cuide-se!";
    text[3713] = "Ei, que robô legal!";
    text[3714] = "Qual seu nome?";
    text[3715] = "Tetra!";
    text[3716] = "Prazer em conhecê-la, Tetra!";
    text[3717] = "Meu nome é Zeek!";
    text[3718] = "Na verdade, vou abrir uma Loja de Robótica bem atrás de mim.";
    text[3719] = "Ainda estamos preparando tudo, mas teremos nossa grande inauguração em breve!";
    text[3720] = "Eu poderia melhorar as armas da Tetra para que a Explosão da Tetra seja aumentada.";
    text[3721] = "Aaaah! Isso seria incrível!";
    text[3722] = "SIM, SIM! Mais poder = Melhor escudeira. Hihi.";
    text[3723] = "Aqui, leia meu Código de COM. e vocês serão notificadas assim que a loja abrir!";
    text[3724] = "Leitura finalizada!";
    text[3725] = "Maravilha! Nos vemos na grande inauguração!";
    text[3752] = "Tycho é um nos mais novos setores construídos em Luna.";
    text[3753] = "Por mais chocante que isso soe, a verdade é que Tycho é uma cidade móvel.";
    text[3754] = "Ahn?! Como assim móvel?";
    text[3755] = "A cidade inteira é modular e foi construída em uma estrutura gigantesca";
    text[3756] = "que pode deslocar a cidade inteira para um novo local!";
    text[3757] = "Ela costumava ficar no setor mais ao sul de Luna.";
    text[3758] = "Por que a cidade teve que ser deslocada?";
    text[3759] = "Condições climáticas severas acabaram se formando com o tempo no sul.";
    text[3760] = "Isso tornou Tycho uma escolha menos atraente para o Povo de Luna";
    text[3761] = "como cidade para viver, então a cidade teve que ser relocada.";
    text[3762] = "Uau... Incrível!";
    text[3763] = "Gostaria de ouvir um fato divertido sobre Tycho?";
    text[3764] = "Eis outro fato legal.";
    text[3765] = "O céu de Tycho é amarelado porque a Astrobarreira aqui";
    text[3766] = "recebeu uma personalização para poder aguentar o clima severo do sul.";
    text[3767] = "Claro!";
    text[3768] = "Nah.";
    text[3769] = "Sem problema. Desculpe-me o incômodo...";
    text[3800] = "Por quê? ...";
    text[3801] = "Vim até aqui na esperança de encontrar um banheiro disponível...";
    text[3802] = "Será que meu destino é esperar por toda a eternidade?? ...";
    text[3803] = "Hm... Será que você não pode resolver seus 'negócios' atrás da árvore?";
    text[3804] = "... E violar as belas terras sagradas da natureza verdejante?";
    text[3805] = "Valeu, mas não. Prefiro esperar...";
    text[3811] = "Nossos animais ficam em uma fazenda separada.";
    text[3812] = "Nós os damos todo o amor, atenção e liberdade de que precisam para serem felizes e saudáveis.";
    text[3813] = "Estou procurando por lagartas e formigas!";
    text[3814] = "O Rancho Kepler é um ótimo lugar para insetos. Hehe.";
    text[3815] = "Quero coletar todos eles!";
    text[3816] = "Estou tentando pensar em nomes de ataques legais.";
    text[3817] = "Minha irmã sempre pensa nos melhores nomes de ataques!";
    text[3818] = "Qual seu ataque principal?";
    text[3819] = "Soco Supernova da Meia-noite. Hehe.";
    text[3820] = "O meu é a Explosão Tetra...";
    text[3821] = "Não é tão legal quanto o seu...";
    text[3822] = "Kamehameha!";
    text[3823] = "Canhão Especial de Feijões!";
    text[3824] = "Batida de Volts!";
    text[3825] = "Shuriken de Vento!";
    text[3826] = "Soco Sério!";
    text[3827] = "O Rancho Kepler é só uma das muitas fazendas no Setor 8.";
    text[3828] = "Cada fazenda cuida de diferentes aspectos do cultivo e produção de alimentos.";
    text[3829] = "Preciso dar os créditos às gerações de botânicos que ajudaram";
    text[3830] = "a moldar o caminho para que a vida botânica crescesse em Luna. É realmente incrível.";
    text[3831] = "O Rancho Kepler é como um lar longe de casa.";
    text[3832] = "Se um dia se perguntaram como era a Terra há mil anos...";
    text[3833] = "Bom... o Rancho Kepler é o mais próximo que você vai encontrar das paisagens terrestres.";
    text[3834] = "Madeira costumava ser bem barato anos atrás.";
    text[3835] = "Hoje em dia, é bem cara!";
    text[3836] = "Dá para entender. Não há muitas árvores em Luna.";
    text[3618] = "ÁREA RESTRITA PARA A FORÇA LUNEX.";
    text[3619] = "QG LUNEX - COMPLEXO CARCERÁRIO SUBTERRÂNEO";
    text[3620] = "ÁREA DE ESGOTOS - ACESSO RESTRITO À MANUTENÇÃO";
    text[3621] = "QG DA FORÇA LUNEX - BASE MILITAR";
    text[3622] = "BASE MILITAR - ENTRADA PRINCIPAL";
    text[3623] = "SETOR 13 - GRIMALDI";
    text[3624] = "LESTE - ZONA DESOLADA 1";
    text[3625] = "OESTE - ZONA DESOLADA 2";
    text[3627] = "Como será lutar contra um Exoesqueleto do tipo Guerreiro?";
    text[3628] = "Espere, Tetra, não se aproxime!";
    text[3629] = "MODO DE BATALHA ATIVADO";
    text[3630] = "Ops...";
    text[3631] = "Deve ter alguma falha de programação. Não deveríamos ser vistas como ameaça!";
    text[3632] = "Precisamos desativar o Exoesqueleto!";
    text[3657] = "O QG Lunex tem soldados trabalhando 24 horas por dia para garantir um protocolo de segurança adequado.";
    text[3658] = "Cuidado para não se aproximar demais dos nossos Drones ou Exoesqueletos.";
    text[3659] = "Informe seu propósito, soldada.";
    text[3660] = "Ah... Hm...";
    text[3661] = "Estamos só dando uma olhadinha. Não tem problema, né?";
    text[3662] = "Negativo. Se não está sob ordens, retire-se do local o mais breve possível.";
    text[3663] = "(Vish. Esse cara segue os protocolos à risca mesmo.)";
    text[3664] = "(Ele está fazendo o trabalho dele. Vamos andando.)";
    text[3665] = "Uuuuuuh! Uuuuuuh!";
    text[3670] = "Por algum motivo estranho, a Zona Desolada tem o maior número de aparições de Murks em Luna.";
    text[3671] = "A Avirell geralmente não é agressiva,";
    text[3672] = "mas há diversos casos em que elas atacaram nossos soldados.";
    text[3673] = "Hm, suas balas não parecem surtir efeito...";
    text[3674] = "Olha... Estou só tentando afugentá-las...";
    text[3675] = "Você já lutou contra uma Avirell antes?";
    text[3676] = "Elas podem criar clones de energia e têm essa habilidade fásica,";
    text[3677] = "o que as torna difíceis de acertar com nossas armas.";
    text[3678] = "Hm... Acho que você precisa melhorar a mira.";
    text[3679] = "Como é?? Por que você não atira então?!";
    text[3680] = "Não, não. Melhor não.";
    text[3681] = "Boa sorte!";
    text[3682] = "...";
    text[3683] = "Você sabia?! Quando um Murk está sob o EFEITO DE STATUS ENCHARCAR,";
    text[3684] = "seus ataques nele aumentarão seu LUXÔMETRO além do normal!";
    text[3685] = "Recentemente, eles trouxeram o Murktador para o COMPLEXO CARCERÁRIO.";
    text[3686] = "O general Saros nos instruiu a permanecer em alerta máximo";
    text[3687] = "para caso ele tentasse fugir.";
    text[4044] = "Estamos tentando nos manter despercebidas, lembra?";
    text[4045] = "Acho melhor não passar por essa entrada agora.";
    text[4046] = "Acho que essa porta leva lá para fora.";
    text[4047] = "Não vamos por aí agora... Os guardas podem suspeitar.";
    text[4048] = "Espere! Se formos além daqui, os guardas nos verão!";
    text[4049] = "Esta área leva à entrada do Complexo Carcerário.";
    text[4050] = "Precisamos ir por outro caminho!";
    text[4051] = "Gostaria de entrar na Área de Esgotos?";
    text[4052] = "Esta máquina tem um computador que controla as portas com lasers!";
    text[4053] = "Quer que eu entre na Rede de Esgotos?";
    text[4054] = "Você pressionou o interruptor no painel de controle!";
    text[4055] = "Os lasers nas proximidades foram desativados.";
    text[4056] = "Os espaços com SETAS VERMELHAS mudaram de direção!";
    text[4206] = "CHAVE LUNEX CONFIRMADA. ACESSO CONCEDIDO.";
    text[4238] = "AVISO - RESÍDUOS TÓXICOS.";
    text[4239] = "SALA ????. Este visor digital está quebrado...";
    text[4240] = "ESCOTILHA DE ACESSO AO COMPLEXO CARCERÁRIO.";
    text[4334] = "Ninguém pode entrar nos aposentos do General sem uma autorização explícita.";
    text[4335] = "Esta Base Militar foi construída próximo da Cratera da Escuridão Eterna.";
    text[4336] = "É a cratera mais profunda de Luna.";
    text[4337] = "A luz mal chega no fundo da cratera. Sempre fico com um pé atrás de ir lá...";
    text[4338] = "Estou ficando com sede, mas também queria forrar o estômago...";
    text[4339] = "Vê alguma coisa que eu poderia gostar na Máquina de Vendas?";
    text[4340] = "Barra de cheesecake";
    text[4341] = "Ener-G Master";
    text[4342] = "Salva-almas";
    text[4343] = "Sorte estelar! Dobradinha na máquina!";
    text[4344] = "Tome! Quem não compartilha, não tem amigos!";
    text[4345] = "É... Preciso voltar logo para o trabalho.";
    text[4346] = "Uma pausa de cinco minutos é mais do que suficiente. Hahaha!";
    text[4347] = "Ultimamente, temos tido cada vez menos soldados aqui na Base";
    text[4348] = "devido ao aumento de aparições de Murks.";
    text[4349] = "A maioria dos soldados estão patrulhando um Setor ou coletando antinúcleos.";
    text[4350] = "Os Trajes a Jato da Força Lunex são feitos com os melhores materiais de qualidade militar.";
    text[4351] = "Após séculos de viagens ao espaço, finalmente temos trajes espaciais que";
    text[4352] = "são compactos, flexíveis, duráveis E estilosos. Mas essa é minha humilde opinião.";
    text[4353] = "Ei, você!";
    text[4354] = "Parece que uma Habilidade de Apoio cairia bem para você em batalha.";
    text[4355] = "Se quiser, vendo minha Habilidade de Apoio: Canhão Extra por 5.000 bytes.";
    text[4356] = "Vou ser completamente sincero.";
    text[4357] = "Preciso do dinheiro para ajudar a pagar as lições de pilotagem de hovercraft para o meu filho.";
    text[4358] = "Ele quer entrar para a Força Lunex algum dia!";
    text[4359] = "Quer comprar uma Habilidade de Apoio e ajudar um pai?";
    text[4360] = "Maravilha! Muito obrigado.";
    text[4361] = "Preciso apoiar os sonhos do meu filho como der.";
    text[4363] = "Você viu o Exoesqueleto do tipo Tanque?";
    text[4364] = "É mais lento que o do tipo Guerreiro, mas também é mais robusto.";
    text[4365] = "O Exoesqueleto do tipo Tanque é perfeito para combate defensivo.";
    text[4366] = "- DESENVOLVIMENTO DE ARMAS -";
    text[4367] = "- PRODUÇÃO DE TRAJES A JATO -";
    text[4368] = "- ARQUIVOS HISTÓRICOS -";
    text[4369] = "- SALA DO SERVIDOR -";
    text[4370] = "- LABORATÓRIO DE PESQUISAS DE HOLOTECNOLOGIA -";
    text[4371] = "Ainda não conferimos todas as salas deste piso!";
    text[4519] = "Não podemos voltar para a Base Militar agora!";
    text[7232] = "Uau... Nunca vi um modelo de Traje a Jato assim.";
    text[7233] = "Você acha que ele pertence ao Saros?";
    text[7234] = "Não parece ser algo que ele usaria. É bem reforçado e pesado.";
    text[7244] = "Meu escâner de materiais mostra que é feito de titânio!";
    text[7235] = "Acho que é um traje de batalha feito para guerra.";
    text[7236] = "Guerra...";
    text[7237] = "Quero dizer, nunca se sabe o que pode estar lá fora no universo...";
    text[7238] = "Eu voto por levarmos o traje.";
    text[7239] = "Ahn?? Por quê?";
    text[7240] = "Porque é maneiro!";
    text[7241] = "É, acho que ficaria ótimo em você.";
    text[7242] = "Hmm...";
    text[7243] = "Ok, então tá. Hehe.";
    text[7213] = "Ei! Posso desativar o S.D.A. deste computador!";
    text[7214] = "Ótimo! Agora podemos usar livremente nossas naves por Luna!";
    text[7247] = "Este Exoesqueleto estava aqui quando Thea estava com o General?";
    text[7248] = "Não... na verdade, este corredor inteiro é novo.";
    text[7249] = "Esta é a primeira vez que piso nos aposentos do general";
    text[7250] = "desde que minha mãe morreu.";
    text[7251] = "As paredes sempre foram roxas?";
    text[7252] = "Sim! A cor das paredes nunca mudou.";
    text[7253] = "Roxo era a cor favorita da minha mãe.";
    text[7254] = "Então nossos exoesqueletos atuais foram derivados dos exoesqueletos dos Antigos?";
    text[7255] = "Basicamente.";
    text[7256] = "Cerca de um ano atrás, me deparei com um exoesqueleto abandonado.";
    text[7257] = "Eu fui capaz de operá-lo sem um antinúcleo.";
    text[7258] = "Normalmente, eu fico longe de qualquer coisa ligada à Força Lunex, mas...";
    text[7259] = "Queria conferir uma coisa.";
    text[7260] = "O que você queria ver?";
    text[7261] = "Bom, há alguns textos antigos que mencionam que os Exoesqueletos tinham";
    text[7262] = "uma funcionalidade oculta que poderia ser acionada por outra fonte de alimentação...";
    text[7263] = "... Lux.";
    text[7264] = "É muito perigoso...";
    text[7265] = "... acionar uma máquina que drena lentamente sua Lux até...";
    text[7266] = "... Bom, não quero nem pensar nisso.";
    text[7267] = "Até onde eu sei...";
    text[7268] = "Nossos Exoesqueletos atuais não têm uma funcionalidade assim.";
    text[7269] = "Nunca se sabe quais outros segredos Saros está escondendo.";
    text[7270] = "Verdade... Obrigada por nos contar. ";
    text[7271] = "Se algum dia estivermos em uma situação de emergência... quem sabe...";
    text[7272] = "Talvez possamos precisar usar essa funcionalidade oculta.";
    text[7273] = "É um Exoesqueleto Guerreiro Modelo ZX.";
    text[7274] = "Este console está monitorando o nível de Antimatéria do Exoesqueleto.";
    text[7275] = "Há um texto no visor que diz: 917624.";
    text[7276] = "Este console está recarregando a bateria do Exoesqueleto.";
    text[7281] = "Alguns valores de dados, como níveis de oxigênio e gravidade";
    text[7282] = "de cada setor em Luna estão exibidos neste console.";
    text[7283] = "Este console tem uma lista de mandados de prisão e criminosos procurados";
    text[7284] = "pela Força Lunex.";
    text[7285] = "Eu estou nessa lista?";
    text[7286] = "Hm... Não, não está.";
    text[7287] = "Estranho... E eu?";
    text[7288] = "Você é o número um na lista.";
    text[7289] = "Ah, que honra.";
    text[7202] = "Já quer voltar?";
    text[7203] = "Quero ter certeza de que estamos realmente preparados para lutar contra Saros.";
    text[7204] = "E se precisarmos estocar mais Ener-Gs ou Mentas de Batalha?";
    text[7211] = "Celestia não é capaz produzir um buraco de minhoca para nos levar de volta";
    text[7212] = "sem eu estar aqui para energizá-la.";
    text[7205] = "Estamos no meio de uma zona desolada, lembra?!";
    text[7206] = "Não há comerciantes nas redondezas...";
    text[7207] = "... E o Sistema de Defesa da Astrobarreira não permite que saiamos voando por aí.";
    text[7208] = "Espera aí um pouquinho!";
    text[7209] = "Há uma boa chance de os controles primários do S.D.A. estarem aqui!";
    text[7210] = "Vamos procurar! Talvez possamos desativá-los!";
    text[7278] = "Há uma lista de pessoas desaparecidas neste console.";
    text[7279] = "Os nomes foram omitidos e substituídos por números de cobaias.";
    text[7329] = "CODINOME: Moleculoide. Taxa de ressonância: 25%.";
    text[7330] = "Cobaias 270 a 276 - Análise de poder de antimatéria: Manipulação de fogo.";
    text[7331] = "Observação: A cobaia parece apresentar uma estrutura atômica instável,";
    text[7332] = "o que explica a natureza 'explosiva'.";
    text[7336] = "CODINOME: Geoligno. Taxa de ressonância: 16%.";
    text[7333] = "Cobaias 136 a 138 - Análise de poder de antimatéria: Manipulação mineral.";
    text[7334] = "Observação: Carcaça da cobaia é feita de antimatéria e rególito fortificados.";
    text[7335] = "Esta ramificação da fórmula pode vir a ser útil para criar um corpo de antimatéria durável.";
    text[7337] = "CODINOME: Réplia. Taxa de ressonância: 76%.";
    text[7338] = "Cobaias 1462 a 1465 - Análise de poder de antimatéria: Corpo semifásico.";
    text[7339] = "Observação: A cobaia parece ser mais humanoide em comparação aos testes anteriores.";
    text[7340] = "Finalmente estamos fazendo avanços decentes para o aperfeiçoamento do Soro.";
    text[7341] = "UNIDADE DE ESPECTROSCOPIA DE ANTIMATÉRIA";
    text[7342] = "UNIDADE DE ARMAZENAMENTO DE SORO DE MURK";
    text[7343] = "CODINOME: Avirell. Taxa de ressonância: 43%.";
    text[7344] = "Cobaias 621 a 629 - Análise de poder de antimatéria: Turbilhão caótico.";
    text[7345] = "Observação: As penas da cobaia têm uma propriedade estranha que a permite";
    text[7346] = "dissipar a Lux do alvo.";
    text[7347] = "Parece que Lux e Antimatéria estão inextricavelmente entrelaçadas.";
    text[7348] = "É um frasco de teste vazio.";
    text[7349] = "CODINOME: Hiperabelha. Taxa de ressonância: 11%.";
    text[7350] = "Cobaias 42 a 44 - Análise de poder de antimatéria: Voo e velocidade.";
    text[7351] = "Observação: A ramificação da fórmula para uma conversão garantida foi confirmada.";
    text[7352] = "A próxima etapa é ajustar as outras variáveis na fórmula.";
    text[7353] = "CODINOME: Espectro. Taxa de ressonância: 38%.";
    text[7354] = "Cobaias 418 a 420 - Análise de poder de antimatéria: Imunidade contra plasma.";
    text[7355] = "Observação: A cobaia parece ter uma imunidade maior contra armamentos de plasma.";
    text[7356] = "Todas parecem ter uma natureza bastante travessa.";
    text[7365] = "Neste console... Um mapa de Luna está marcado com alfinetes de cores diferentes.";
    text[7366] = "Cada alfinete indica o local de um incidente ou surto de Murks.";
    text[7367] = "Os dados apontam para quase 10 anos atrás...";
    text[7357] = "Tudo que nos contaram sobre os Murks...";
    text[7358] = "... era só uma fração do que Saros realmente sabia.";
    text[7359] = "Ele nos manipulou...";
    text[7360] = "Só sabíamos o suficiente para conseguir nos defender...";
    text[7361] = "... e ser capaz de coletar antinúcleos...";
    text[7362] = "... Basicamente só isso.";
    text[7368] = "Observação 36: Propriedades curativas foram observadas nas amostras de soro que possuem";
    text[7369] = "uma Taxa de ressonância de 50% ou mais.";
    text[7370] = "As amostras que testei em mim parecem estar funcionando...";
    text[7371] = "... mas ainda não são boas o suficiente. Ainda não.";
    text[7372] = "Observação 42: Com nossas reservas atuais de Antinúcleos e um Soro aperfeiçoado,";
    text[7373] = "seremos capazes de salvar pelo menos 100.000 indivíduos.";
    text[7374] = "Se conseguirmos obter os Antinúcleos do Murktador,";
    text[7375] = "esse número aumentará consideravelmente.";
    text[7376] = "Observação 74: Conquistar um novo corpo não é o suficiente.";
    text[7377] = "Eles precisarão de mais.";
    text[7378] = "Eles precisarão de um santuário...";
    text[7379] = "... Um lugar para chamar de lar.";
    text[7380] = "Observação 111: Estou tão perto...";
    text[7381] = "Finalmente consegui obter 99% de ressonância.";
    text[7382] = "Queria ter mais tempo...";
    text[7383] = "O experimento me concedeu o poder imensurável de que precisava...";
    text[7384] = "... ao custo do meu próprio corpo.";
    text[7385] = "Independentemente, considero este experimento um sucesso.";
    text[7386] = "Agora que tenho os Antinúcleos do Murktador...";
    text[7387] = "... minha missão para salvar a humanidade pode finalmente começar.";
    text[3523] = "Parece que essa passagem foi fechada...";
    text[3524] = "É uma lápide feita de minério de magnésio.";
    text[3525] = "Vários nomes estão escritos nessa lápide.";
    text[3526] = "Todos os nomes têm a mesma data de falecimento.";
    text[3527] = "PASSAGEM PARA O SETOR 3 INTERDITADA ATÉ SEGUNDA ORDEM";
    text[3546] = "SETOR 2 - PENHASCO MEMORIAL";
    text[4784] = "SETOR 2 - FENDAS DE SÍLICA";
    text[4785] = "PARA O PENHASCO MEMORIAL";
    text[4786] = "PARA O PENHASCO MEMORIAL";
    text[4787] = "O fogo estala baixinho.";
    text[4788] = "A Nave Cápsula não tem mais carga em sua bateria.";
    text[4789] = "Sabe, quando encontrei esta caverna, essas pilhas de madeira já estavam aqui.";
    text[4790] = "Alguém deve ter vindo aqui antes de nós.";
    text[4791] = "Odeio estragar o mistério para vocês duas, mas...";
    text[4792] = "Este era um dos lugares onde acampei anos atrás.";
    text[4793] = "Onde quer que eu vá, vou a pé. Ajuda a manter a discrição.";
    text[4794] = "Quando se foge por tanto anos,";
    text[4795] = "você acaba tento vários esconderijos e lugares para acampar.";
    text[4796] = "Há um mecanismo de trava estranho ao redor dessa Conexão Neural.";
    text[4797] = "O monitor tem algo escrito:";
    text[4798] = "'6 CRATERAS'";
    text[4799] = "Você encontrou um pequeno interruptor na cratera! Você o aciona.";
    text[4800] = "Você aciona o último interruptor.";
    text[4822] = "É um cristal feito de hemoquartzo.";
    text[4823] = "Esses cristais naturalmente luminescentes ajudam mineiros";
    text[4824] = "a percorrer as profundezas escuras das Minas de Sílica.";
    text[4825] = "OESTE - PENHASCO MEMORIAL";
    text[4826] = "LESTE - COLÔNIA SÍLICA";
    text[4827] = "SETOR 1- COLÔNIA SÍLICA";
    text[4828] = "Essas crateras estão cheias de ferramentas e suprimentos para extração mineral.";
    text[4829] = "Minas de Sílica";
    text[4830] = "Você olha para a entrada da mina e vê algumas luzes piscando.";
    text[4831] = "Eita! Esse cristal é GIGANTE.";
    text[4832] = "Os moradores o chamam de Cristal da Eternidade.";
    text[4833] = "Ele está aqui desde que a colônia foi fundada.";
    text[4834] = "Aparentemente, é uma das Sete Maravilhas de Luna.";
    text[4835] = "Esta máquina de vendas está quebrada.";
    text[4836] = "Esta máquina de vendas vende minimáquinas de vendas.";
    text[4837] = "Esta máquina de vendas vende charque.";
    text[4838] = "Boas-vindas ao Café Sílica!";
    text[4839] = "Saboreie nossos famosos X-Dog Chilli e Curry Apimentado!";
    text[4840] = "É o Fórum de Sílica!";
    text[4841] = "Não temos uma espaçonave, então não podemos voar agora...";
    text[3653] = "Parece ter algo aqui...";
    text[3654] = "... mas você não consegue interagir com isso agora.";
    text[3655] = "O antinúcleo que você carrega parece estar reagindo ao estranho fenômeno.";
    text[4873] = "Você toca dentro do acúmulo de antimatéria...";
    text[4901] = "As minas aqui em Sílica têm sido escavadas há séculos.";
    text[4902] = "Cada mina fechada foi escavada por cerca de 200 anos.";
    text[4903] = "Uau! Leva TUDO ISSO para escavar tão profundo assim?";
    text[4904] = "Bom, sim. A tecnologia evoluiu bastante, mas não importa quanto melhoremos";
    text[4905] = "nosso maquinário, aqueles malditos cristais de hemoquartzo são terríveis de se minerar.";
    text[4906] = "Por isso que são tão caros.";
    text[4907] = "O mineral mais forte de Luna também é o mais duro de se escavar e processar.";
    text[4908] = "Mais cedo, vi um monte de drones da Força Lunex voando acima da colônia.";
    text[4909] = "Sabe dizer o que estavam procurando?";
    text[4910] = "Provavelmente Murks... Hehehe.";
    text[4911] = "Hmm. Acho que nunca nos vimos. Primeira vez em Sílica?";
    text[4912] = "Sim!";
    text[4913] = "Temos muitos mineiros, comerciantes, refugiados e caçadores de tesouro por estas bandas.";
    text[4914] = "Todos estão fazendo o possível para sobreviver.";
    text[4915] = "A Colônia Sílica fica sobre um gigantesco depósito de hemoquartzo.";
    text[4916] = "A maioria dos recursos que mineramos acaba indo para a Força Lunex";
    text[4917] = "e os Setores mais ricos na Luna Central e Sul.";
    text[4918] = "Essas armas aí que vocês estão carregando parecem bem valiosas. Quer quanto por elas?";
    text[4919] = "Hm. Elas não estão à venda. Desculpa.";
    text[4920] = "Tsc. Bom, fique de olho nos seus itens de valor por estas bandas.";
    text[4921] = "Nunca se sabe quando marginais ou bandidos estão de olho.";
    text[4922] = "Espera aí. Tem bandidos por aqui?";
    text[4923] = "Vaza daqui, pivete. Se não tem nada pra vender, não quero saber.";
    text[4924] = "Ei! Prazer! Sou o Professor de História daqui de Sílica! Você sabia...";
    text[4925] = "Sílica foi uma das primeira colônias a serem estabelecidas aqui em Luna?";
    text[4926] = "Os primeiros desbravadores escolheram esta região por estarmos ao alcance de um";
    text[4927] = "gigantesco canal lunar de lava.";
    text[4928] = "Você disse lava?? Há lava em Luna?";
    text[4929] = "Claro que há! Se cavar fundo o suficiente, também encontrará magma!";
    text[4930] = "Naquela época, a Astrobarreira ainda não tinha sido inventada...";
    text[4931] = "... então as temperaturas de Luna variavam drasticamente durante os dias e as noites.";
    text[4932] = "Felizmente, os desbravadores descobriram os canais lunares de lava aqui em Luna Norte,";
    text[4933] = "onde era mais quente e tinha temperaturas mais estáveis,";
    text[4934] = "o que tornou esta região um lugar adequado para se estabelecer.";
    text[4935] = "Não são muitas crianças que gostam da História Lunar, mas acho que é importante que eles";
    text[4936] = "saibam como a humanidade foi parar em Luna e sobreviveu aqui por todos esses séculos.";
    text[4937] = "Meu pai está me fazendo estudar História Lunar...";
    text[4938] = "Ele sempre está contando sobre fatos históricos. Ele simplesmente não para de falar...";
    text[4939] = "Há uma pequena comunidade de Cicloides que vive aqui em Sílica.";
    text[4940] = "Meu marido e eu morávamos originalmente em Magnésia, nossa colônia-irmã.";
    text[4941] = "Desde o incidente há alguns anos, fomos forçados a nos mudar para Sílica.";
    text[4942] = "... Sinto muito por isso.";
    text[4943] = "Apesar de termos perdido nossa primeira casa no incidente... Hoje temos um lar aqui.";
    text[4944] = "Contudo, alguns Cicloides não tiveram a mesma sorte...";
    text[4945] = "Isso me faz comemorar cada segundo que tenho com a minha família ainda mais.";
    text[4946] = "Agradeço de coração por me ouvir.";
    text[4947] = "A Força Lunex e todos vocês têm a nossa gratidão por tudo o que fizeram por nós.";
    text[4948] = "Claro! Sempre que precisar, estaremos prontos para ajudar!";
    text[4949] = "A Força Lunex se esforça para sempre proteger e servir o Povo de Luna. Hehe!";
    text[4950] = "...";
    text[4951] = "Estou pronto para sair em uma expedição!";
    text[4952] = "Aaaah! Para onde vai?";
    text[4953] = "Provavelmente explorar algumas Áreas de Saque!";
    text[4954] = "Quais tesouro irei encontrar? Ai, ai. Só de pensar já me tremo todo!";
    text[4955] = "Estou conferindo os relatórios de energia renovável de Sílica.";
    text[4956] = "Sílica tem o diferencial de ser a única que extrai a maior parte da energia de fontes geotérmicas!";
    text[4957] = "Tivemos que frear nossa extração mineral devido ao aumento de Murks.";
    text[4958] = "Eles parecem gostar do calor lá embaixo nas minas.";
    text[4959] = "Quanto mais profundo for, mais Murks você encontrará.";
    text[3517] = "As armas e os equipamentos militares roubados ficam armazenados perto da muralha.";
    text[3518] = "Parece que aqueles bandidos se comunicam com diversas frotas.";
    text[3519] = "Se derrotarmos boa parte deles,";
    text[3520] = "certamente chamaremos a atenção do líder.";
    text[3521] = "Há um texto no visor que diz: 258227.";
    text[5653] = "SETOR 12 - MONTE PITON";
    text[5654] = "PICO DA LUZ ETERNA";
    text[5655] = "Esta máquina de vendas vende aquecedores de mão e outros acessórios para acampamento.";
    text[5657] = "Hm... Esta Jatoplataforma não está recebendo energia suficiente...";
    text[5658] = "Será que tem como consertá-la?";
    text[5659] = "Deve haver um Quadro Elétrico em algum lugar por aqui.";
    text[5660] = "Eu poderia sobrecarregá-lo e aquecer o circuito para consertar a Jatoplataforma.";
    text[5661] = "Brrrr... Vamos logo.";
    text[5662] = "*Funga*... Estou congelando!";
    text[5663] = "SUPER ESCUDEIRA SUPERCARREGAR!";
    text[5664] = "A Jatoplataforma deve estar funcionando corretamente agora! Hihi.";
    text[5665] = "Ohohohoho!";
    text[5666] = "É bom ver companheiros aventureiros aqui no Monte Piton!";
    text[5667] = "Vocês vêm sempre aqui?";
    text[5668] = "Eu venho aqui todo dia! Ohohoho!";
    text[5669] = "É uma longa caminhada de Sílica, mas vale a pena!";
    text[5670] = "Sabia que o Monte Piton é a montanha mais alta de Luna?";
    text[5671] = "Apesar das temperaturas congelantes, o sol brilha em seu ápice aqui.";
    text[5672] = "Por isso que o chamam de 'Pico da Luz Eterna'! Ohohoho!";
    text[7394] = "Vamos deixá-la assim por enquanto.";
    text[7395] = "Mas e se ela acordar e tentar escapar?";
    text[7396] = "Eu não me preocuparia com isso. Ela não é mais uma ameaça para nós.";
    text[7397] = "Você olha dentro da cabana e só consegue ver o breu.";
    text[7400] = "Sua batalha final a aguarda. Que sua Lux brilhe para sempre.";
    text[900] = "Miau!";
    text[901] = "Ah é a Echo! Oi, fofinha!";
    text[902] = "Gatinha!";
    text[903] = "Miau, miau!";
    text[904] = "Echo lhe deu 10.000 bytes!";
    text[905] = "ENCONTRO RARO: Esta é a Echo, a gata espacial.";
    text[906] = "Ela é a gatinha de estimação na Estação Espacial Lunex.";
    text[907] = "Echo AMA se aventurar no espaço.";
    text[908] = "Ela também pode ser encontrada como um encontro raro em certas áreas de Luna!";
    text[1806] = "Echo contempla ao olhar para o espaço com seus olhos brilhando.";
    text[751] = "Pessoas podem baixar tudo quanto é tipo de conhecimento para seus cérebros, mas...";
    text[752] = "O que importa mesmo é como você aplicar esse conhecimento. Lembre-se sempre disso.";
    text[753] = "Ei! Já vi você na Estação Espacial Lunex.";
    text[754] = "Você deve ser a filha do Dr. Thomas. Prazer em conhecê-la!";
    text[755] = "Eu me especializei em Conexões Neurais!";
    text[756] = "O que são Conexões Neurais?";
    text[757] = "Você tem uma?";
    text[758] = "Não, valeu.";
    text[759] = "Conexões Neurais são a última tecnologia de Emulação Mental!";
    text[760] = "Essencialmente, elas permitem que você baixe informações para o seu cérebro.";
    text[761] = "Educadores em algumas escolas distribuem Conexões Neurais";
    text[762] = "e guerreiros podem usá-las para aprender novas habilidades e técnicas!";
    text[763] = "A tecnologia é bem impressionante!";
    text[764] = "Sim! Elas são caras, mas posso vender esta para você com desconto.";
    text[765] = "Só 1.500 bytes!";
    text[766] = "Vou comprar!";
    text[767] = "Não, obrigada.";
    text[768] = "Maravilha!";
    text[769] = "Lembre-se de gerenciar e equipar suas Habilidades de Apoio no Menu de Habilidades de Apoio!";
    text[770] = "Ah... Infelizmente, você não tem bytes o suficiente!";
    text[771] = "Beleza! Até mais!";
    text[3547] = "Tenho um CHIP DE MELHORIA DE ARMADURA que quero vender.";
    text[3548] = "O CHIP DE MELHORIA DE ARMADURA é um chip de melhoria que você pode equipar por meio do MENU DE ITENS.";
    text[3549] = "Se equipá-lo, seu PV MÁX. aumentará em 200!";
    text[3550] = "Uma moeda rara por um item raro. Como 80 Habilipontos soam para você?";
    text[3551] = "Lembre-se de equipar o CHIP DE MELHORIA DE ARMADURA por meio do MENU DE ITENS.";
    text[3553] = "Ei, não tô aqui para brincadeira, garota. Volte quanto tiver 80 HABILIPONTOS.";
    text[3554] = "Tenho um CHIP DE MELHORIA DE PE que quero vender.";
    text[3555] = "O CHIP DE MELHORIA DE PE aumenta seu PE Máx. em 100.";
    text[3556] = "É o único Chip de Melhoria capaz de aumentar seu PE MÁX.";
    text[3557] = "O CHIP DE MELHORIA DE PE custa 160 Habilipontos. Quer comprá-lo?";
    text[3558] = "Lembre-se de equipar o CHIP DE MELHORIA DE PE por meio do MENU DE ITENS.";
    text[3560] = "Pare de tomar meu tempo! Você não tem 160 HABILIPONTOS!";
    text[3252] = "Valeu a parceria, garota.";
    text[3253] = "Ei, garota. Você parece uma guerreira forte que se beneficiaria com um CHIP DE MELHORIA raro.";
    text[3254] = "Tenho um CHIP DE MELHORIA DE BARREIRA que quero vender.";
    text[3255] = "Interessada?";
    text[3256] = "O que ele faz?";
    text[3257] = "Qual a pegadinha?";
    text[3258] = "O CHIP DE MELHORIA DE BARREIRA é um chip de melhoria que você pode equipar por meio do MENU DE ITENS.";
    text[3259] = "Quando equipado, você sempre começará a batalha com uma Barreira de uso único.";
    text[3260] = "Se for atingida por um ataque inimigo, a Barreira absorverá o ataque";
    text[3261] = "e seu RANQUE DE BATALHA permanecerá inalterado.";
    text[3262] = "Assim que a Barreira for utilizada, ela não regenerará até sua próxima batalha.";
    text[3263] = "Sabe, eu não tô buscando bytes nem astrotecas. Quero HABILIPONTOS.";
    text[3264] = "Uma moeda rara por um item raro. Como 40 Habilipontos soam para você?";
    text[3265] = "Excelente negócio, garota.";
    text[3266] = "Lembre-se de equipar o CHIP DE MELHORIA DE BARREIRA por meio do MENU DE ITENS.";
    text[3267] = "Nos vemos por aí, garota.";
    text[3269] = "Ei, não tô aqui para brincadeira, garota. Volte quanto tiver 40 HABILIPONTOS.";
    text[629] = "E ae! Sou um Comerciante de Astrotecas. Pode me chamar de Cypher.";
    text[630] = "Se tiver Astrotecas sobrando, podemos negociar, firmeza?";
    text[631] = "Negociar";
    text[632] = "Conversar";
    text[633] = "Sair";
    text[634] = "Sabe, eu venho lá do norte. Minha loja fica na Colônia Sílica.";
    text[635] = "Geralmente venho aqui caçar Astrotecas.";
    text[636] = "Sílica é o distrito minerador de Luna!";
    text[637] = "Há muitos Caçadores de Tesouro por lá.";
    text[638] = "Isso aí!";
    text[639] = "Temos os minerais e materiais mais raros por lá.";
    text[640] = "Por outro lado, Regolithia está cheia até a borda de itens tecnológicos, tá ligado?";
    text[641] = "Ligadíssima!";
    text[642] = "Então, o que você faz com as Astrotecas?";
    text[643] = "Eu posso usar Astrotecas para criar uns bagulhos daora.";
    text[644] = "Maquinários e acessórios são meu forte!";
    text[645] = "Se algum dia tiver de bobeira, dá um pulo lá na minha loja em Sílica.";
    text[646] = "Tenho umas Partes de Nave iradíssimas para vender!";
    text[647] = "Valeu a parceria, mana.";
    text[648] = "A conta não fecha assim. Faltam Astrotecas!";
    text[649] = "Foi mal, já vendi tudo.";
    text[650] = "Daora! Tenho isso aqui no estoque.";
    text[651] = "ESGOTADO";
    text[4842] = "E ae! Só de boa? Se estiver caçando umas partes de nave daora,";
    text[4843] = "veio pro lugar certo! Qual vai ser, mana?";
    text[4844] = "Ei, onde está seu cachorrinho?";
    text[4845] = "Ele tá batendo um ronco. Cansou de tanto abanar o rabo!";
    text[652] = "Olá. Meu nome é Nym. Sou uma comerciante itinerante.";
    text[653] = "Tenho algumas coisas para vender se quiser.";
    text[654] = "O que deseja?";
    text[655] = "Se estiver procurando pelo Comerciante de Astrotecas,";
    text[656] = "eu o vi em algum lugar desta área.";
    text[657] = "Valeu. Vá em paz.";
    text[658] = "Comprar";
    text[3806] = "Ei. Bom revê-la.";
    text[3807] = "Quando vim neste Rancho, eu me apaixonei instantaneamente.";
    text[3808] = "Talvez eu abra uma loja permanente aqui algum dia.";
    text[3809] = "Tenho algumas coisas novas para vender se estiver interessada.";
    text[1919] = "Olá! Meu nome é Alex. Sou a comerciante aqui na EEL.";
    text[3213] = "Olá! Sejam bem-vindas à Loja Geral!";
    text[1920] = "Temos uma promoção acontecendo agora mesmo!";
    text[1921] = "Maravilha! O que vai querer?";
    text[1922] = "Cuide-se! Aguardamos sua próxima visita!";
    text[1923] = "As outras donas de lojas aqui são, na verdade, minhas irmãs!";
    text[1924] = "Costumávamos sair em missões de espionagem juntas, agora buscamos novas paixões!";
    text[1929] = "Oi, eu sou a Britney! Obrigada pela visita!";
    text[1930] = "Tenho alguns itens úteis que você pode trocar por Astrotecas!";
    text[1931] = "Também temos partes de naves disponíveis!";
    text[1932] = "As partes são um pouco caras, mas valem cada centavo!";
    text[1933] = "Você pode personalizar sua nave ao interagir com a Dobra do Mapa-múndi!";
    text[1934] = "Temos os seguintes itens disponíveis.";
    text[3208] = "Acabamos de reabastecer nossas Partes de Nave!";
    text[3209] = "Cada uma das minhas vitrines tem seleções diferentes para escolher!";
    text[3214] = "NOVO TRAJE A JATO DISPONÍVEL!";
    text[3215] = "Fale com Clover na Estilo Lunex em Copernicus!";
    text[3216] = "PARA MUDAR SEU TRAJE A JATO, PRESSIONE [C] NO MENU DE PAUSA!";
    text[3217] = "PARA MUDAR SEU TRAJE A JATO, PRESSIONE [Quadrado] NO MENU DE PAUSA!";
    text[3218] = "PARA MUDAR SEU TRAJE A JATO, PRESSIONE [Y] NO MENU DE PAUSA!";
    text[1938] = "Ei, Bella! Agradeço por fazer parte do meu Programa de Marketing de Trajes a Jato!";
    text[3219] = "Tome, consegui um novo Traje a Jato para você voar por aí!";
    text[3221] = "Estou em uma missão interminável de criar os melhores estilos de Trajes a Jato de Luna!";
    text[1940] = "Olá! Me chamo Sam! Prazer em conhecê-la! Eu vendo Conexões Neurais!";
    text[1941] = "Você pode comprar novas Habilidades de Apoio, Habilidades Ativas e Otimizadores de Habilidades!";
    text[1942] = "Minhas irmãs e eu temos lojas por toda Luna!";
    text[1943] = "A maioria das lojas terá algo exclusivo para oferecer. Venha nos conhecer!";
    text[1944] = "Uhul! O que vai querer?";
    text[659] = "Cara... Estou morrendo de fome...";
    text[660] = "Mas não posso deixar meu posto. Tenho uma função a cumprir!";
    text[661] = "Nesse ritmo, vou morrer de fome antes de morrer pela falta de oxigênio...";
    text[662] = "Senhorita Bella, tenho um favor para lhe pedir...";
    text[663] = "Pode pegar uma Croca-Barra para mim?";
    text[664] = "Eles vendem Croca-Barras nas máquinas de vendas do café...";
    text[665] = "Por favor... Pago o dobro do que custar! Estou morrendo de fome...";
    text[666] = "... Espera aí! Você tá dizendo que essas eram as últimas duas Croca-Barras??";
    text[667] = "Eu estava... a duas Croca-Barras da morte...";
    text[668] = "Muito obrigado, senhorita Bella! Eu só precisava de uma, então pode ficar com a outra!";
    text[669] = "Esqueci quanto elas custam. Como prometido, pagarei o dobro.";
    text[670] = "Quanto foi a Croca-Barra?";
    text[671] = "200 bytes (Falar a verdade)";
    text[672] = "1.000 bytes (Enganá-lo?)";
    text[673] = "25 astrotecas (Mudar recompensa)";
    text[674] = "Só 200?? Que barganha!";
    text[675] = "Quer saber... Vou lhe dar 1.000 bytes. Obrigado mais uma vez, senhorita Bella!";
    text[676] = "1.000?? Hm...";
    text[677] = "Talvez faça sentido. Com a alta demanda, as pessoas pagam preços premium.";
    text[678] = "Isso é um trava-línguas cheio de aliteração.";
    text[679] = "Como será que deve ser... travar a língua?";
    text[680] = "Desculpa interrompê-las, mas... Tenho só 400 bytes... Posso ficar devendo?";
    text[681] = "Tudo bem, não se preocupe! Hehehe...";
    text[682] = "Certo. Tome, senhorita Bella! Obrigado mais uma vez!";
    text[683] = "Você recebeu 400 bytes!";
    text[684] = "Ah... Você prefere 25 astrotecas? Claro, sem problema!";
    text[685] = "Você recebeu 25 astrotecas!";
    text[686] = "Hmmm... Estou no paraíso. Esta Croca-Barra é deliciosa!";
    text[687] = "Você recebeu 1.000 bytes!";
    text[688] = "Esta máquina de vendas vende Croca-Barras, uma barra de granola crocante e nutritiva";
    text[689] = "coberta por uma deliciosa calda de chocolate amargo.";
    text[690] = "Vai muito bem com um copo de café quente!";
    text[691] = "Só tem mais duas na máquina.";
    text[692] = "Gostaria de comprar uma Croca-Barra? Custa 200 bytes.";
    text[693] = "Eita! Duas Croca-Barras caíram ao mesmo tempo! É seu dia de sorte!";
    text[694] = "Infelizmente, as Croca-Barras acabaram.";
    text[695] = "Faltam bytes!";
    text[718] = "Tjskdlf klskdjfl uhwpefj pylkjq.";
    text[719] = "Olá! Hm...";
    text[720] = "(Por que a Tradução Universal não está funcionando?)";
    text[721] = "Bella, seu Chip de T.U. foi danificado durante sua batalha contra os Murks.";
    text[722] = "Tuowieh jlwknbl ieuohfo qpoufwef.";
    text[723] = "Hm, desculpa, senhora. Não sou fluente em cicloidês.";
    text[724] = "Tetra, seu Tradutor Universal está funcionando, né?";
    text[725] = "Sim!";
    text[726] = "Rgjktg kjspfoy khklfsn rf jajaja";
    text[727] = "Huyhsajy ara ara lk jajaja";
    text[728] = "O que ela disse? Por que vocês estão rindo?";
    text[729] = "Hihihi. Nada. Ela é bem engraçada.";
    text[730] = "Bom... Podemos conversar depois, preciso consertar meu Chip de T.U. primeiro!";
    text[731] = "Cuide-se!";
    text[732] = "Olá! Vejo que agora consegue me entender. Hahaha.";
    text[733] = "Olá! Desculpa por antes. Meu tradutor não estava funcionando.";
    text[734] = "Você precisa de ajuda com alguma coisa?";
    text[735] = "Ah, não, não mesmo. Eu só estava dando um oi!";
    text[736] = "Sua pequena escudeira aqui é uma fofa!";
    text[737] = "Eu estava falando para ela como seu cabelo é lindo e me lembra algodão-doce.";
    text[738] = "Ah, obrigada!";
    text[739] = "Falei também que seu rabo de cavalo me lembra sorvete de casquinha! Hahaha.";
    text[740] = "Vou levar isso como um elogio. Hehehe.";
    text[741] = "Você parou o que estava fazendo só para falar comigo...";
    text[742] = "Não se preocupe! Comunicação é muito importante.";
    text[743] = "Ela nos ajuda a criar uma conexão e formar laços que não se desfazem!";
    text[744] = "Você é tão bondosa. Tome, fique com isso pela gentileza.";
    text[746] = "Como se diz 'Obrigada' em cicloidês?";
    text[747] = "Qwerty!";
    text[748] = "Qwerty, qwerty!";
    text[749] = "Ah! Como estou devagar hoje. Comprei um novo Chip de T.U. mais cedo do Cypher!";
    text[750] = "Vamos ver... É só trocar pelo antigo e... pronto!";
    text[1962] = "Ai, ai... Por que isso tinha que acontecer?";
    text[1963] = "Ei, Ouro, o que aconteceu?";
    text[1964] = "Ah, oi, Bella! Estava só fazendo minha caminhada diária pela Estação Espacial";
    text[1965] = "após tomar um delicioso café no Café Lunex e, bem....";
    text[1966] = "Eu estava carregando esta pasta aberta cheia das minhas amadas RECEITAS DE COMBOS LUX...";
    text[1967] = "E PERDI TODAS ELAS! ... ISSO É TERRÍVEL! EU NEM CHEGUEI A MEMORIZÁ-LAS.";
    text[1968] = "Ah, não se preocupe, Ouro, ajudaremos a procurar suas RECEITAS DE COMBOS LUX!";
    text[1969] = "Mesmo?? Cara... Você não existe, Bella!";
    text[1970] = "Quantas receitas precisamos encontrar?";
    text[1971] = "São 7 RECEITAS DE COMBOS LUX que perdi pela Estação Espacial.";
    text[1972] = "Por onde exatamente fez sua caminhada hoje?";
    text[1973] = "Eu, literalmente, andei por todos os lados... Podem ter caído em qualquer lugar...";
    text[1974] = "Tudo bem. Pelo menos, sabemos que está dentro da Estação Espacial.";
    text[1975] = "Seu café vai esfriar, então espere aqui por enquanto.";
    text[1976] = "Não sei nem como agradecer, Bella!";
    text[1977] = "Eu deixei meu CÓDICE em casa, então não consegui registrar nenhuma das receitas...";
    text[1978] = "Perdi 7 RECEITAS DE COMBOS LUX pela Estação Espacial no total...";
    text[1979] = "Minha especialidade é juntar e pesquisar RECEITAS DE COMBOS LUX!";
    text[1980] = "Amo compartilhar o conhecimento que obtenho na esperança de que";
    text[1981] = "ajudará outras pessoas a tentar novos COMBOS LUX e ficarem mais fortes!";
    text[826] = "Você é uma grande guerreira, Bella! Você deveria testar COMBOS LUX.";
    text[827] = "Assim que seu Luxômetro encher em Batalha,";
    text[828] = "você poderá juntar 3 habilidades e soltar um COMBO LUX!";
    text[1982] = "Seu Luxômetro enche sempre que atinge um inimigo ou bloqueia um ataque!";
    text[829] = "COMBOS LUX são mais poderosos do que usar 3 habilidades individualmente.";
    text[830] = "Juntar 3 ou mais das mesmas habilidades geralmente resulta em um COMBO LUX único.";
    text[831] = "Você deveria testar combinações diferentes!";
    text[832] = "Pegue aqui algumas receitas para você testar!";
    text[1984] = "Você encontrou minhas RECEITAS DE COMBOS LUX! Não sei nem como agradecer!!";
    text[1985] = "Você fez meu dia, Bella!";
    text[1986] = "E, como agradecimento, gostaria que ficasse com uma das minhas receitas pessoais favoritas!";
    text[1988] = "Agradeço de coração por me ajudar!";
    text[3309] = "Ei, Bella!";
    text[3310] = "Você tem praticado seus Combos Lux?";
    text[3311] = "Uau! Você já realizou pelo menos 20 Combos Lux!";
    text[3312] = "Impressionante! Tome uma nova Receita de Combo Lux!";
    text[3313] = "O POD do Holodreno aumentará se você tiver mais ESCUDOS!";
    text[3314] = "Seu NV também tem um papel importante no aumento do dano!";
    text[3315] = "Se você realizar pelo menos 20 Combos Lux,";
    text[3316] = "lhe darei uma nova receita que estou criando!";
    text[3317] = "Se você acessar o MENU REGISTROS no seu CÓDICE,";
    text[3318] = "poderá ver quantos Combos Lux já realizou!";
    text[3431] = "Hehehe. Eu derrotei tantos Murks hoje que bati um novo recorde de Ranque S!";
    text[3432] = "Mesmo? Qual seu recorde?";
    text[3433] = "9 Ranques S até agora.";
    text[3434] = "Impressionante!";
    text[3435] = "Hm... Dá para ver uma chama competitiva nos seus olhos, Bella.";
    text[3436] = "Duvido que bata meu Recorde, mas, se conseguir pelo menos 10 Ranques S...";
    text[3437] = "Eu lhe darei um OTIMIZADOR DE HABILIDADE como recompensa.";
    text[3438] = "Desafio aceito! Hehe.";
    text[3439] = "Você precisará me provar que conseguiu pelo menos 10 Ranques S.";
    text[3440] = "Dá pra ver quantos já obteve no menu REGISTROS no seu CÓDICE!";
    text[3441] = "Ah, cara! Você bateu meu recorde...";
    text[3443] = "Você é tão competitiva quanto a Raine.";
    text[3444] = "Acredito que competir nos faz ir além!";
    text[3445] = "Eu também treino com a Raine.";
    text[3446] = "Ela sempre fica esbravejando como quer derrotá-la em batalha.";
    text[3447] = "Algum dia, vou me tornar uma guerreira prodígio que nem vocês duas!";
    text[3448] = "Hehehe.";
    text[3442] = "Espere e verá. Um dia vou bater seu recorde de Ranque S!";
    text[3451] = "Como prometido, aqui está o OTIMIZADOR DE HABILIDADE.";
    text[3232] = "Parece que alguém abandonou uma barra de cheesecake perfeitamente boa!";
    text[3233] = "COMO ALGUÉM PÔDE FAZER ALGO TÃO DESUMANO??";
    text[3234] = "Não se preocupe, vou garantir que essa barra de cheesecake";
    text[3235] = "receba a atenção e o amor que merece! Hehe.";
    text[3236] = "Ahn?!";
    text[3237] = "Outra barra de cheesecake!";
    text[3238] = "Quem comprou todas as barras de cheesecake da máquina de vendas";
    text[3239] = "deve ter deixado cair uma.";
    text[3240] = "Hmm...";
    text[3241] = "Vamos conferir os outros Cafés.";
    text[3242] = "Tem alguém fazendo isso de propósito??";
    text[3243] = "Quem sabe o culpado esteja tentando atraí-la com barras de cheesecake.";
    text[3244] = "Bom...";
    text[3245] = "... está funcionando!";
    text[3246] = "Preciso de MAIS! MAIS! MAIS!";
    text[3247] = "Ei, tem um bilhete embaixo dessa barra de cheesecake!";
    text[3248] = "Diz apenas 'Tycho'.";
    text[3249] = "Vamos conferir o Café em Tycho quando tivermos a chance!";
    text[3250] = "Belezinha! A Detetive Tetra está pronta para 'segurar essa barra que é gostar de cheesecake'!";
    text[3726] = "Pelas estrelas... que sede...";
    text[3727] = "Ei, senhorita! Poderia pedir um favor?";
    text[3728] = "Minha garganta está seca feito o deserto e não posso deixar meu posto...";
    text[3729] = "Poderia pegar um Ener-G Master para mim?";
    text[3730] = "Quanto melhor o Ener-G, mais descansado me sinto!";
    text[3731] = "Se não tiver o Ener-G Mestre, pode ser um Super ou o Hiper.";
    text[3732] = "Por favor... Que sede... Ainda tenho 6 horas até acabar meu turno...";
    text[3733] = "Ah... trincando, com gás, refrescante e hidratante!";
    text[3734] = "Este Ener-G tá no grau!";
    text[3735] = "Qual Ener-G você gostaria de me dar?";
    text[3736] = "Ener-G Super";
    text[3737] = "Ener-G Hiper";
    text[3738] = "Ener-G Master";
    text[3739] = "Ei, parece que você não tem mais desse tipo de Ener-G...";
    text[3740] = "Volte quando tiver o Ener-G que pretende me dar.";
    text[3741] = "Maravilha! Valeu demais!!";
    text[3742] = "Aqui, quero que aceite isso como agradecimento.";
    text[3743] = "Escolha uma recompensa!";
    text[3744] = "1.000 bytes e 50 astrotecas";
    text[3745] = "50 habilipontos";
    text[3746] = "2.500 bytes e 100 astrotecas";
    text[3747] = "100 habilipontos";
    text[3748] = "5.000 bytes e 150 astrotecas";
    text[3749] = "150 habilipontos e 1 Salva-almas";
    text[3750] = "Você recebeu a recompensa escolhida!";
    text[3751] = "Uau! Dá para ver Regolithia de longe!";
    text[3688] = "Ei, soldada! Sou um dos treinadores de batalha da Força Lunex.";
    text[3689] = "Amamos incentivar nossos soldados a treinarem mais e ficarem mais fortes!";
    text[3690] = "Se conseguir pelo menos 20 Ranques S,";
    text[3691] = "lhe darei uma Conexão Neural de Granada Aqua!";
    text[3692] = "Dá pra ver o número de Ranques S que você tem no menu REGISTROS no seu CÓDICE!";
    text[3694] = "Céus! Parece que você tem mais de 20 Ranques S!";
    text[3695] = "Continue se esforçando, soldada! Tome a Conexão Neural que prometi.";
    text[3696] = "Nosso treinador de batalha mais graduado ficou sabendo das suas façanhas.";
    text[3697] = "Ele está ansioso para conhecê-la algum dia!";
    text[3698] = "Qual Recorde de Ranque S devo tentar na próxima?";
    text[3699] = "O treinador provavelmente espera um Recorde de Ranques S de, pelo menos, 50.";
    text[3700] = "Não é hora de relaxar! Mantenha o ritmo e você será a melhor guerreira de Luna!";
    text[3770] = "Saudações!";
    text[3771] = "Sou o Mestre das Perguntas, o sr. Infame!";
    text[3772] = "Estou viajando por Luna em busca de alguém que possa superar minha sagacidade!";
    text[3773] = "Responda corretamente todas as minhas perguntas e eu lhe darei um prêmio incrível!";
    text[3774] = "Gostaria de desafiar o Mestre das Perguntas?";
    text[3775] = "Fui derrotado... Sua capacidade mental é realmente impressionante.";
    text[3776] = "Qual o nome do mundo misterioso do outro lado dos buracos de minhoca?";
    text[3777] = "Mundo Ondular";
    text[3778] = "Reino Fantasma";
    text[3779] = "Dimensão Distorcida";
    text[3780] = "Errado! Melhor sorte na próxima!";
    text[3781] = "Qual o número do Setor de Regolithia?";
    text[3782] = "Setor 8";
    text[3783] = "Setor 14";
    text[3784] = "Setor 16";
    text[3785] = "Aumentar o nível de uma Habilidade de Apoio NV. 4 requer quantos Habilipontos?";
    text[3786] = "150 habilipontos";
    text[3787] = "125 habilipontos";
    text[3788] = "75 habilipontos";
    text[3789] = "Quanto de PV um Murk MARÉ tem?";
    text[3790] = "300 PV";
    text[3791] = "225 PV";
    text[3792] = "250 PV";
    text[3793] = "Última pergunta: Quem sou eu?";
    text[3794] = "Um cara feio";
    text[3795] = "O Grande Mestre das Perguntas!";
    text[3796] = "O Lorde das Enquetes, sr. Fama!";
    text[3797] = "Aqui está seu prêmio!";
    text[3799] = "Impressionante! Você respondeu minhas perguntas!";
    text[4067] = "Você...";
    text[4068] = "Você ficou famosa na Força Lunex.";
    text[4069] = "Só de olhar para você, dá para saber que é uma guerreira habilidosa.";
    text[4070] = "... Mas é boa o suficiente para me impressionar?";
    text[4071] = "Perdão, ainda não me apresentei.";
    text[4072] = "Meu nome é Bonder...";
    text[4073] = "James Bonder.";
    text[4074] = "Sou o treinador mais graduado aqui na Força Lunex.";
    text[4075] = "Torno sementes fracas e covardes em lutadores fortes e capazes.";
    text[4076] = "Volte quando tiver pelo menos 50 Ranques S em seu CÓDICE.";
    text[4077] = "Se completar meu desafio, lhe darei algo valioso.";
    text[4078] = "Poucos são os soldados que são capazes de me impressionar...";
    text[4079] = "Você acha que tem o necessário para se tornar a melhor guerreira de Luna?";
    text[4080] = "Parece que você tem mais de 50 Ranques S!";
    text[4081] = "Contudo... Ainda não estou impressionado.";
    text[4082] = "Demorou uma eternidade para conseguir todos esses Ranques S! Do que mais você precisa??";
    text[4083] = "Você só completou metade do meu desafio, soldada!";
    text[4084] = "Conseguir 50 Ranques S prova sua disciplina e proeza em batalha.";
    text[4085] = "Para completar o desafio, você precisa me derrotar em um duelo!";
    text[4086] = "Encontre-me na Área dos Esgotos. Deixarei meu Exoesqueleto pronto para o combate.";
    text[4087] = "Por que não luta contra nós sem o seu Exoesqueleto?";
    text[4088] = "Derrotar um velho não vai impressionar ninguém.";
    text[4089] = "Tenho experiência de combate e inteligência, mas já não tenho mais a força física.";
    text[4090] = "Meu Exoesqueleto compensa 10x a minha fraqueza.";
    text[4091] = "Exoesqueleto ou não, a vitória será nossa! Hehe.";
    text[4092] = "Assim que eu gosto de ver! Até a Área dos Esgotos, soldada!";
    text[4093] = "Finalmente! Prepare-se, soldada. Não pegarei leve com você!";
    text[4094] = "Impressionante!";
    text[4095] = "Não tenho um combate assim há um bom tempo! Bahahaha!";
    text[4096] = "Parabéns, soldada! Você completou meu desafio.";
    text[4098] = "Se você equipar o CHIP DE MELHORIA DE CUSTO,";
    text[4099] = "ele reduzirá o custo de PE de todas as suas Habilidades Ativas em 5.";
    text[4100] = "Continue com o bom trabalho, soldada!";
    text[4803] = "Tetra, esse não é o mesmo robô que vimos em Regolithia?";
    text[4804] = "Digit! O nome dele é Digit!";
    text[4805] = "Bom ver que o Digit conseguiu voltar para casa.";
    text[4806] = "Mas o que ele estava fazendo em Regolithia?";
    text[4807] = "01101000 01100101 01101100 01110000";
    text[4808] = "01110110 01101001 01110010 01110101 01110011";
    text[4809] = "Hm... Hm... Entendi.";
    text[4810] = "O que o Digit disse?";
    text[4811] = "A rede de IA do Digit foi infectada por um vírus.";
    text[4812] = "Ele quer a nossa ajuda!";
    text[4813] = "Ah, pobrezinho... Não se preocupe, Digit! Vamos ajudá-lo!";
    text[4814] = "Tetra, precisamos eliminar o vírus que infectou a rede do Digit.";
    text[4815] = "Devo acessar a rede de IA do Digit?";
    text[4816] = "Nosso objetivo é encontrar e eliminar";
    text[4817] = "o vírus que infectou o Digit!";
    text[4818] = "Assim que o derrotarmos, poderemos reinicializar a rede do Digit!";
    text[4819] = "Fique de olho em riscos do estágio! Vamos nessa!";
    text[4876] = "BIP BOP.";
    text[4877] = "OBRIGADO POR ME SALVAR!";
    text[4878] = "POR FAVOR, ACEITE ISSO. BIP BOP.";
    text[4880] = "DIGIT AGRADECE DO FUNDO DO CHIP. BIP BOP.";
    text[4881] = "AGORA DIGIT PODE VOLTAR A MINERAR DADOS.";
    text[4882] = "Olá! Meu nome é Fortuno.";
    text[4883] = "Sou o líder da Guilda dos Caçadores de Tesouros aqui em Sílica.";
    text[4884] = "Acha que tem o necessário para ser uma boa Caçadora de Tesouros?";
    text[4885] = "Claro! Caçar tesouros parece divertido! O que temos que fazer?";
    text[4886] = "Bom, vamos um passo de cada vez.";
    text[4887] = "Um bom Caçador de Tesouros tem boas habilidades de observação de campo.";
    text[4888] = "Saia e descubra quantas fogueiras estão acesas aqui na Colônia Sílica.";
    text[4889] = "Volte assim que descobrir quantas.";
    text[4890] = "Então, quantas fogueiras estão acesas aqui na Colônia Sílica?";
    text[4891] = "Parece que você precisa melhorar suas habilidades de observação. Você errou.";
    text[4892] = "Correto! Você passou no primeiro teste!";
    text[4893] = "Você é oficialmente uma caçadora de tesouros novata!";
    text[4894] = "O próximo teste é um pouco mais difícil... mas vamos deixar isso para outra hora.";
    text[4895] = "Bem-vinda à Guilda dos Caçadores de Tesouros aqui em Sílica. Quero que aceite este presente.";
    text[4896] = "Claro, Caçadores de Tesouros amam coletar itens raros e valiosos...";
    text[4897] = "mas eles também amam a emoção da exploração!";
    text[4898] = "Ao explorar atentamente uma área, você pode obter informações valiosas";
    text[4899] = "que podem levá-la a encontrar itens raros ou, até mesmo, relíquias perdidas!";
    text[1342] = "Conexão de rede estabelecida!";
    text[1343] = "Chegue ao final do estágio para reiniciar a rede!";
    text[1344] = "Fique atenta a vírus e riscos do estágio!";
    text[1345] = "Se Tetra perder todas as vidas,";
    text[1346] = "não será possível reiniciar.";
    text[1347] = "Use seu Canhão Tetra para eliminar vírus inimigos!";
    text[1348] = "Rede reiniciada!";
    text[1349] = "Recuperando conexão de saída...";
    text[1350] = "Conexão de saída de Tetra.EXE estabelecida!";
    text[1351] = "Falha ao reinicializar...";
    text[4033] = "Bella, este estágio está cheio de firewalls!";
    text[4034] = "Atirar nas firewalls consumirá munição de firewall.";
    text[4035] = "Tenha em mente que temos uma quantidade limitada de munição!";
    text[4036] = "Mais uma coisa!";
    text[4037] = "Atirar em vírus não consome munição de firewall.";
    text[4038] = "É possível reiniciar o estágio se não souber o que fazer!";
    text[4039] = "O Protocolo de Desligamento fica no final do estágio!";
    text[4040] = "Se desligarmos a rede de esgotos, as portas com lasers";
    text[4041] = "serão desativadas! Vamos que vamos!";
    text[4042] = "Protocolo de desligamento da rede executado!";
    text[4043] = "Protocolo de desligamento da rede não executado...";
    text[5342] = "Bella, este estágio é uma rede com";
    text[5343] = "múltiplos pontos de acesso de Copernicus!";
    text[5344] = "Precisamos pressionar quatro interruptores no total";
    text[5345] = "para conseguir reinicializar a Rede de Distribuição de Água!";
    text[5346] = "Se não souber o que fazer, procure uma dobra de saída!";
    text[5347] = "Sempre podemos encontrar outro ponto de acesso a partir";
    text[5348] = "de uma Máquina Filtrante diferente em Copernicus!";
    text[5350] = "Os vírus infectaram esta rede!";
    text[5351] = "Precisamos eliminar todos os vírus para";
    text[5352] = "remover o firewall e reiniciar a rede!";
    text[5353] = "Fique atenta aos riscos do estágio!";
    text[610] = "É o Fórum de Regolithia";
    text[1138] = "Rei";
    text[1177] = "Fórum de Regolithia!";
    text[1216] = "Olá, pessoal! Meu nome é Rei e sou a moderadora do Fórum de Regolithia!";
    text[1217] = "Fique à vontade para publicar recados, conversar sobre estratégias de combate ou compartilhar ideias!";
    text[1139] = "Força Lunex";
    text[1178] = "Aviso Público";
    text[1218] = "Se um Murk aparecer no seu setor,";
    text[1219] = "busque abrigo e entre em contato com a Força Lunex para obter ajudar imediata.";
    text[1220] = "NÃO TENTE enfrentar os Murks em hipótese alguma. Obrigado.";
    text[1140] = "Michelle";
    text[1179] = "Café Regolithia";
    text[1221] = "Precisa de um lugar para descansar e recarregar?";
    text[1321] = "Visite o Café Regolithia! Cuidaremos de você!";
    text[1222] = "Experimente nosso delicioso Lámen de Missô ou a especialidade do nosso café: Croca-Barras!";
    text[1141] = "HomemZeta";
    text[1180] = "Manchas escuras?";
    text[1223] = "Então, ultimamente, tenho visto manchas estranhas de energia distorcida no chão...";
    text[1224] = "Eu pisco e elas desaparecem. Dizem que é um Murk espreitando.";
    text[1142] = "Roto";
    text[1181] = "Limites do escudo";
    text[1225] = "Ei, pessoal! Meu nome é Roto! Vocês já conhecem os limites do Escudo?";
    text[1226] = "Normalmente, você começa as batalhas com um escudo. Se encontrar OTIMIZADORES DE ESCUDO,";
    text[1227] = "poderá aumentar o número de escudos ao começar uma batalha!";
    text[1143] = "Boltz";
    text[1182] = "Murk de Rocha";
    text[1228] = "Gente, vi um Murk que parecia um pedregulho ambulante...";
    text[1229] = "Olhei pela janela e estava na parte mais profunda das cavernas.";
    text[1230] = "Juro que não estou inventando!";
    text[1144] = "Raseru";
    text[1183] = "Estratégias de batalha";
    text[1231] = "Aaaah!! Finalmente consegui a Habilidade de Apoio MULTIPLICAR (NV 1)!";
    text[1232] = "Agora, poderei fazer um estrago de verdade nas Hiperabelhas com meu Canhão de Fótons! Muahahaha!";
    text[1145] = "GarotoEspacial";
    text[1184] = "RESPOSTA 1: Estratégias de batalha";
    text[1233] = "Cara, sua habilidade de MULTIPLICAR ainda está no nível 1...";
    text[1234] = "Para ter um multiplicador maior,";
    text[1235] = "primeiro você precisa subir o nível da Habilidade de Apoio MULTIPLICAR (NV 1) com HABILIPONTOS.";
    text[1236] = "Sugiro usar a Aura da Alma. Ela custa 2 escudos, mas você ganha +40 de Poder.";
    text[1237] = "Com essa estratégia, você poderia obliterar aquelas Hiperabelhas usando seu Canhão de Fótons!";
    text[1146] = "Raseru";
    text[1185] = "RESPOSTA 2: Estratégias de batalha";
    text[1238] = "Mandou demais! Ensine-me tudo, senpai!!";
    text[1147] = "Melia";
    text[1186] = "Cubo Hertz perdido";
    text[1239] = "Alguém viu meu Cubo Hertz?";
    text[1240] = "Acho que o perdi perto das Instalações da Barreira...";
    text[1148] = "Jato";
    text[1187] = "Ranques S";
    text[1241] = "Jato na área. Como eu consigo um Ranque S nas batalhas?";
    text[1242] = "Há um cronômetro?";
    text[1243] = "Depende do número de turnos?";
    text[1244] = "Depende do meu PV?";
    text[1245] = "Eu não faço ideia!";
    text[1149] = "ReiDaNet";
    text[1188] = "RESPOSTA 1: Ranques S";
    text[1246] = "Simples, não seja atingido.";
    text[1150] = "Jato";
    text[1189] = "RESPOSTA 2: Ranques S";
    text[1247] = "Vejo que o ReiDaNet é um cara de muitas palavras.";
    text[1151] = "Oslo";
    text[1190] = "RESPOSTA 3: Ranques S";
    text[1248] = "Não zoe o ReiDaNet! Ele é bem sério quando se trata de batalhas.";
    text[1249] = "Ouvi dizer que ele é ridiculamente poderoso.";
    text[1152] = "Jato";
    text[1191] = "RESPOSTA 4: Ranques S";
    text[1250] = "Ele provavelmente não conseguiria derrotar o Murktador.";
    text[1153] = "Éter";
    text[1192] = "Habilidades de Apoio";
    text[1251] = "Ahn, esqueci de reequipar minhas habilidades de apoio de cura antes de uma grande batalha.";
    text[1252] = "Não se esqueçam de conferir no Menu de Habilidades de Apoio se você as equipou! lol";
    text[1154] = "RoboLuna 101";
    text[1193] = "Astrobarreira";
    text[1253] = "A Astrobarreira é um gerador atmosférico artificial e um sistema de defesa.";
    text[1254] = "Ela também se comunica com os geradores de gravidade e oxigênio usando Ondas EM.";
    text[1255] = "Sua criação permitiu que as pessoas vivessem confortavelmente na lua.";
    text[1155] = "RoboLuna 101";
    text[1194] = "Frase do dia";
    text[1256] = "O ano é 30XX! Fique com esta frase do dia:";
    text[1257] = "Que sua Lux brilhe para sempre!";
    text[1156] = "Tyrian";
    text[1195] = "Pensamentos profundos";
    text[1258] = "Cara, imagine se houvesse, tipo, ruas invisíveis ao nosso redor.";
    text[1259] = "Mano, e se fossem feitas de tipo ondas eletromagnéticas, tá ligado?";
    text[1260] = "Imagina que onda?!";
    text[1157] = "Tobi";
    text[1196] = "RE: Pensamentos profundos";
    text[1261] = "Tyrian, acho que você tomou Ener-Gs demais.";
    text[1158] = "RoboLuna 101";
    text[1197] = "20XX";
    text[1262] = "Em 20XX, a humanidade costumava viver no planeta Terra, hoje vulcânico e sem vida.";
    text[1263] = "Devido à catástrofe planetária ASTRA, os humanos foram forçados a encontrar um novo lar.";
    text[1264] = "Infelizmente, não havia planetas habitáveis a uma distância razoável,";
    text[1265] = "então os sobreviventes deram um jeito de ir para Luna, a lua que orbita a Terra.";
    text[1266] = "Cheios de esperança, sonhos e determinação...";
    text[1267] = "A humanidade continuou a sobreviver e prosperar em uma nova casa.";
    text[1159] = "Holo";
    text[1198] = "RUÍNAS";
    text[1268] = "Detetive Holo aqui.";
    text[1269] = "Estou buscando informações sobre as recém-descobertas ruínas e qualquer um";
    text[1270] = "que conheça o idioma gravado nas paredes de Luna.";
    text[1160] = "Volta";
    text[1199] = "Aumentar o nível das habilidades?";
    text[1271] = "Volta na área! Tem como deixar minhas HABILIDADES ATIVAS mais fortes?";
    text[1161] = "Chip";
    text[1200] = "RE: Aumentar o nível das habilidades?";
    text[1272] = "Sim! Só usar OTIMIZADORES DE HABILIDADE para aumentar o nível das suas habilidades ativas.";
    text[1322] = "Mas não são fáceis de se conseguir...";
    text[1162] = "ERRO";
    text[1201] = "SEM ASSUNTO";
    text[1273] = "A vida é um experimento.";
    text[1274] = "É uma reação do caos... e do fascínio.";
    text[1275] = "Estranho. Essa publicação do Fórum é de 10 anos atrás.";
    text[1276] = "Ela não desaparece, não importa quantas vezes eu recarregue o feed.";
    text[1277] = "Deve ser algum bug ou algo do tipo.";
    text[1163] = "Alumae";
    text[1202] = "SEM ASSUNTO";
    text[1278] = "Hihi.";
    text[1279] = "(As 69 respostas seguintes são só Hehes.)";
    text[1164] = "Stark";
    text[1203] = "Alguém se identifica?";
    text[1280] = "Aquele momento que suas Habilidades de Apoio são geradas";
    text[1281] = "e você recebe 3 IGUAIS. AFF!";
    text[1323] = "(Aparentemente, esta publicação viralizou.)";
    text[1165] = "ReiDaNet";
    text[1204] = "RE: Alguém se identifica?";
    text[1282] = "F.";
    text[1166] = "Hazel";
    text[1205] = "Punhado de bytes";
    text[1283] = "Sempre encontro bytes dando mole nas cavernas de Regolithia.";
    text[1284] = "Não é muito, mas é dinheiro fácil se você desviar seu caminho para procurá-las.";
    text[1285] = "Mas, pensando bem... Acho que não deveria ter publicado isso...";
    text[1167] = "Tanaka";
    text[1206] = "Melhorias de naves";
    text[1286] = "Galera, vocês já viram a loja em Copernicus? Dei aquele grau na minha nave ontem.";
    text[1287] = "Eu tô pirando! Gastei 1.000 Gigabytes!";
    text[1288] = "Valeu cada byte!";
    text[1168] = "Kohaku";
    text[1207] = "Gata perdida";
    text[1289] = "Alguém aí perdeu uma gatinha?";
    text[1290] = "Trabalho nas Instalações da Barreira. No caminho para casa,";
    text[1291] = "vi uma gatinha gordinha voando em um Traje Espacial!";
    text[1324] = "Esfreguei os olhos para ter certeza de que não estava alucinando.";
    text[1169] = "Força Lunex";
    text[1208] = "Estamos recrutando!";
    text[1292] = "Quer se juntar à Força Lunex? Abrimos o processo de recrutamento!";
    text[1170] = "Rex";
    text[1209] = "RE: Estamos recrutando!";
    text[1293] = "AEEE! Vamos receber Sabristolas se entrarmos?";
    text[1171] = "Nebuloide";
    text[1210] = "Sabristolas";
    text[1294] = "A lâmina e as balas de uma Sabristola contêm plasma.";
    text[1295] = "Ela foi projetada para ferir os Murks.";
    text[1296] = "Ouvi dizer que os Laboratórios Lunex estão projetando uma nova arma de ataque contra Murks";
    text[1297] = "que incorpora a tecnologia dos Exoesqueletos e usa a energia dos Antinúcleos!";
    text[1172] = "Força Lunex";
    text[1211] = "PROCURADO";
    text[1298] = "PROCURADO: Murktador\nNOME: Desconhecido\nIDADE: 20 a 25";
    text[1299] = "Se alguém avistar o Murktador, entre em contato com a Força Lunex imediatamente.";
    text[1173] = "HomemZeta";
    text[1212] = "RE: PROCURADO";
    text[1300] = "De verdade, precisamos encontrar esse cara e fazê-lo entrar para a Força Lunex ou algo do tipo.";
    text[1301] = "Quem liga se ele roubou equipamentos militares?";
    text[1302] = "Ele é uma máquina exterminadora de Murks! Ele pode nos proteger!";
    text[1303] = "Só não entendo por que ele trabalha nas sombras. O que ele está escondo?";
    text[1174] = "OGJony";
    text[1213] = "Estrelas cadentes";
    text[1304] = "Se sentindo com sorte? Se vir uma Estrela Cadente no céu, pressione [Z].";
    text[2548] = "Se sentindo com sorte? Se vir uma Estrela Cadente no céu, pressione [X].";
    text[2549] = "Se sentindo com sorte? Se vir uma Estrela Cadente no céu, pressione [A].";
    text[1175] = "Tetra";
    text[1214] = "Receita de Combos Lux";
    text[1307] = "Oi, oi! Tetra aqui. Alguém tem Receitas de Combos Lux para compartilhar?";
    text[1305] = "Hihi. Uma escudeira especializada vai além de assistir heróis em batalhas, ela também";
    text[1306] = "garante que os heróis também recebam os melhores conselhos e dicas fora das batalhas.";
    text[1176] = "Ouro";
    text[1215] = "RE: Receita de Combos Lux";
    text[1308] = "Ei. Tenho uma para você. Se chama Holofuracão.";
    text[1309] = "Tente combinar 2 Holoescudos com qualquer Habilidade Ativa baseada em espadas!";
    text[100001] = "SIM";
    text[100002] = "NÃO";
    text[69] = "PRESSIONE [X] PARA ACESSAR O MENU.";
    text[2544] = "PRESSIONE [Círculo] PARA ACESSAR O MENU.";
    text[2545] = "PRESSIONE [B] PARA ACESSAR O MENU.";
    text[70] = "CAMINHE ATÉ TETRA E PRESSIONE [C] PARA FALAR COM ELA.";
    text[2546] = "CAMINHE ATÉ TETRA E PRESSIONE [Quadrado] PARA FALAR COM ELA.";
    text[2547] = "CAMINHE ATÉ TETRA E PRESSIONE [Y] PARA FALAR COM ELA.";
    text[120001] = "Pressione      para desativar seu Traje a Jato!";
    text[120002] = "Pressione      para ativar seu Traje a Jato!";
    text[120003] = "ERRO DE AUTORIZAÇÃO da Jatoplataforma.";
    text[2560] = "A Jatoplataforma não está funcionando. Não podemos usá-la agora...";
    text[4820] = "É uma Jatoplataforma quebrada.";
    text[4821] = "Parece que faz um bom tempo desde que foi usada.";
    text[7560] = "SUPRAFASE DESBLOQUEADA!";
    text[7561] = "Agora, em batalhas, Nickle pode ultrapassar seus limites e entrar em SUPRAFASE!";
    text[7562] = "Essa forma poderosa dura 2 turnos e concede a Nickle um aumento de 4x o PDR";
    text[7563] = "de todas suas Habilidades Ativas ao custo de perder 50% de seu PV por turno.";
    text[7564] = "Durante essa forma, o Custo de PE é ignorado, então você pode se concentrar em maximizar os danos!";
    text[5331] = "Interagir com o Povo de Luna aumentará Pontos de Afinidade";
    text[5332] = "que melhorará sua reputação e o Nível de Afinidade da Colônia!";
    text[5333] = "Aumentar seu Nível de Afinidade também desbloqueará novas Missões Secundárias e";
    text[5334] = "você também receberá descontos em Comércios e de Comerciantes de Astroteca!";
    text[5335] = "Seus Níveis de Afinidade podem ser vistos no seu CÓDICE, no menu REGISTROS!";
    text[7120] = "O que faremos com a Minicápsula?";
    text[7121] = "Levaremos conosco.";
    text[7122] = "Sabe, eu meio que gosto de voar com ela por aí.";
    text[7123] = "Não me importaria de usá-la de vez em quando.";
    text[7124] = "AGORA É POSSÍVEL SELECIONAR A MINICÁPSULA NO MENU DE PERSONALIZAÇÃO DE NAVE!";
    text[1595] = "Parabéns!";
    text[1596] = "Você concluiu o Capítulo 1!";
    text[1599] = "Siga @LunarLuxGame no Twitter/X para acompanhar as últimas novidades e datas de atualizações!";
    text[1601] = "Agradecemos de coração pelo apoio!";
    text[1602] = "Obrigado por jogar LunarLux!";
    text[2484] = "Vamos voar!";
    text[2485] = "Personalizar Nave";
    text[2486] = "Deixa pra lá";
    text[2487] = "Ainda não temos Partes de Nave!";
    text[1838] = "É um Robô Musical! Selecione qual música gostaria de tocar:";
    text[1839] = "Capítulo_1";
    text[1840] = "Capítulo_2";
    text[1841] = "Capítulo_3";
    text[1842] = "Capítulo_4";
    text[1843] = "Capítulo_5";
    text[1844] = "BLOQUEADO";
    text[1845] = "A Jornada Começa";
    text[1846] = "Regolithia";
    text[1847] = "Zona de Perigo";
    text[1848] = "Duelo Astral";
    text[1849] = "Triunfo da Heroína";
    text[1850] = "Le Luna";
    text[1851] = "Além do Além";
    text[1852] = "À Deriva";
    text[1853] = "Área de Armazenamento";
    text[1854] = "Murktador";
    text[1855] = "Mundo Fásico";
    text[1856] = "Reino Fantasma";
    text[1857] = "Hiperzona";
    text[1858] = "Choque Cósmico";
    text[1859] = "Estação Espacial Lunex";
    text[1860] = "General Saros";
    text[1861] = "Batalha Contra o General Saros";
    text[3283] = "Mapa-múndi";
    text[3284] = "Oceanus";
    text[3285] = "Surto";
    text[3286] = "Copernicus";
    text[3287] = "Esquadrão Raine";
    text[3288] = "Batalha Contra o Murktador";
    text[1862] = "Ei, Bella!";
    text[1863] = "Oi, Richie! Como a música está ficando?";
    text[1864] = "Está indo bem!";
    text[1865] = "Estive pensando em sair para explorar Luna.";
    text[1866] = "Espero que isso me ajude a criar alguns sons novos.";
    text[1867] = "Isso 'soa' maravilhoso! Sua música é incrível!";
    text[1868] = "Obrigado! Tenho uma música para te mandar!";
    text[1869] = "Vou transferir o arquivo para sua conta do Robô Musical.";
    text[1870] = "Aaah! Obrigada, Richie!";
    text[1871] = "Se me vir ou vir minha trupe viajando por Luna, venha dar um oi!";
    text[1872] = "Você vai poder baixar novas músicas para o seu Robô Musical de graça!";
    text[1873] = "Assim, poderá ouvir as músicas em qualquer Robô Musical por aí!";
    text[1874] = "Ei, Bella! Tenho novas músicas para você!";
    text[3270] = "Aaah! Obrigada, Richie! Sua música é incrível!";
    text[3271] = "Estou tentando recrutar mais músicos e artistas para a minha banda.";
    text[3272] = "E teve sorte?";
    text[3273] = "Ainda não...";
    text[3274] = "Você toca algum instrumento, Bella?";
    text[3275] = "Não... infelizmente.";
    text[3276] = "Sabe cantar?";
    text[3277] = "Ela sabe cantar.";
    text[3278] = "Tetra! Ok, um pouquinho... Mas sou muito tímida.";
    text[3279] = "Hahaha. Não se preocupe, era só curiosidade.";
    text[3280] = "Acho que vou nessa.";
    text[3281] = "Há inspiração musical por todos os lados!";
    text[3282] = "MÚSICAS DO ROBÔ MUSICAL DO CAPÍTULO 2 DESBLOQUEADAS!";
    text[1875] = "Olá! Sou o Senhador!";
    text[1876] = "Troco senhas por itens incríveis!";
    text[1878] = "Não se esqueça de ficar de olho se não vê senhas por aí!";
    text[1879] = "Senha inválida.";
    text[1880] = "Senha correta! Parabéns! Aceite este prêmio.";
    text[1881] = "Você já resgatou este prêmio!";
    text[1959] = "SEM DADOS";
    text[1960] = "REDE DE ARMAZENAMENTO";
    text[5336] = "REDE DA REDE DE DISTRIBUIÇÃO DE ÁGUA";
    text[5337] = "REDE DOS ESGOTOS";
    text[5338] = "REDE DA IA DO DIGIT";
    text[5339] = "REDE NEXUS";
    text[5340] = "REDE CÓSMICA";
    text[5341] = "REDE LENDÁRIA";
    text[1961] = "Posso usar esse fliperama para acessar as Áreas de Rede!";
    text[1137] = "O brilho calmante do Kyroportal acalma sua alma.";
    text[120004] = "O brilho azul sereno do Kyroportal cura sua alma.";
    text[1030] = "Este Kyroportal exala uma aura estranha.";
    text[1031] = "Você sente um senso de curiosidade e desconforto...";
    text[120005] = "Gostaria de salvar sua jornada?";
    text[120006] = "Sua jornada foi salva!";
    text[120007] = "A jornada não foi salva.";
    text[7551] = "Quer mesmo sair sem salvar sua jornada?";
    text[1603] = "SIM (Não esqueça de SALVAR primeiro!)";

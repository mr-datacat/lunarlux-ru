    text[10503] = "E aí, Raine?";
    text[10504] = "Planos para hoje, guerreira prodígio?";
    text[10505] = "Hmm... ";
    text[10506] = "Só ia conferir o Quadro de Missões para ver se tem alguma novidade.";
    text[10507] = "Por quê?";
    text[10508] = "Bom, esqueça seus planos!";
    text[10509] = "O Esquadrão Raine vai dar uma Festa na Praia e todos vocês estão convidados! BAHAHAHA!";
    text[10510] = "Ah, parece divertido!";
    text[10511] = "Nickle, Tetra, o que acham? Querem ir?!";
    text[10512] = "Festa na Praia?? Com certeza!";
    text[10513] = "Finalmente, tenho uma boa desculpa para usar esse incrível óculos de sol. Hehehe.";
    text[10514] = "Tenho o pressentimento de que isso foi um plano elaborado";
    text[10515] = "pela Raine para lutarmos contra ela de novo...";
    text[10516] = "BAHAHAHA! NÃO PROMETO NADA!";
    text[10517] = "Independentemente, um dia relaxante na praia cairia bem.";
    text[10518] = "PERFEITO!";
    text[10519] = "Encontre-nos na Enseada do Verão! É uma pequena praia ao norte de Oceanus!";
    text[10520] = "... e levem bastante protetor solar!";
    text[10522] = "Então, cadê a festa?";
    text[10523] = "Olha a cabeça!";
    text[10524] = "*BOING*";
    text[10525] = "Ótimo, todos vieram!";
    text[10526] = "Já preparamos tudo ali!";
    text[10527] = "Oi, Melody! Oi, Zara!";
    text[10528] = "Por favor, digam que trouxeram as Barras de cheesecake!";
    text[10529] = "Trouxemos! E um monte de outros lanches. Hehehe.";
    text[10530] = "... e eu trouxe boias para todos.";
    text[10531] = "Sensacional! Vocês são as melhores!";
    text[10532] = "Agora... É hora de nos divertirmos no sol! Uhuul!";
    text[12140] = "Ah, nunca pensei que uma praia bonita assim existisse em Luna.";
    text[12141] = "Eu também. Ver as palmeiras foi uma grande surpresa.";
    text[12153] = "Achei que palmeiras não cresciam organicamente em Luna.";
    text[12142] = "Ah, as palmeiras aqui... Bom, elas são falsas.";
    text[12143] = "Espera... é sério?!";
    text[12149] = "Sim!";
    text[12150] = "Agora, antes que me pergunte como sei disso...";
    text[12144] = "A Enseada do Verão... era o refúgio durante o verão do meu falecido avô.";
    text[12145] = "O sonho dele era recriar as belas praias terrestres sobre as quais leu";
    text[12146] = "em livros de história para que nossa família pudesse passar as férias aqui.";
    text[12147] = "E, apesar de ter falecido, eu gostaria de continuar com o sonho dele";
    text[12148] = "e criar lembranças incríveis aqui nesta praia com meus amigos.";
    text[12151] = "Raine, seu avô fez um trabalho incrível criando este lugar.";
    text[12152] = "Tenho certeza de que não foi fácil... mas certamente valeu a pena.";
    text[12154] = "Vamos garantir que esta praia continue limpa!";
    text[12155] = "Isso. Seria ótimo poder voltar aqui de vez em quando para relaxar.";
    text[12156] = "Gente... Obrigada por isso.";
    text[12157] = "Hehehe.";
    text[12158] = "EI! Do que estão dando risadinhas aí?";
    text[12159] = "É bom te ver um pouco sentimental para variar, Raine.";
    text[12160] = "SENTIMENTAL?? EU?? Ah, tá bom!";
    text[12161] = "BAHAHAHAHA!";
    text[12162] = "Bom, durou o quanto achei que ia durar.";
    text[12163] = "Hehehehe. Basicamente.";
    text[10533] = "Certo, pessoal. Chegou a hora do EVENTO PRINCIPAL!";
    text[10534] = "Evento principal?! O que você aprontou agora, Raine?";
    text[10535] = "Pegue uma boia e me siga!";
    text[10536] = "Tadã!";
    text[10537] = "Tem vibe!";
    text[10538] = "É animal!";
    text[10539] = "É o surfe extravagante do Esquadrão Raine: BAITA ONDA!";
    text[10540] = "Uau! Parece um percurso de obstáculos bem maneiro!";
    text[10541] = "Minha nossa! Onde vocês arrumaram tempo para montar tudo isso??";
    text[10542] = "Na verdade, foi bem rápido.";
    text[10543] = "Colocamos um monte de drones para nos ajudar.";
    text[10544] = "O BAITA ONDA foi projetado para ser um percurso de obstáculos infinito.";
    text[10545] = "O objetivo é sobreviver o máximo possível enquanto coleta as Barras de cheesecake!";
    text[10546] = "... E a equipe que coletar mais barras ganhará um PRÊMIO de dar água na boca!";
    text[10547] = "Lembrem-se, suas boias podem ser atingidas até 5 vezes antes de estourarem.";
    text[10548] = "Espera aí... Essas Barras de cheesecake são de verdade?";
    text[10549] = "Não... São hologramas.";
    text[10550] = "Os drones estão fazendo o trabalho pesado em termos de apresentação.";
    text[10551] = "Contudo, as rochas são de verdade... e machucam mesmo!";
    text[10552] = "Ai, ai, viu...";
    text[10553] = "... E o que acontece se perdermos?";
    text[10554] = "VOCÊS PRECISARÃO LUTAR CONTRA NÓS! BAHAHAHA!";
    text[10555] = "Claro... Por que não estou surpreso?";
    text[10556] = "Sabia que tinha alguma pegadinha.";
    text[10557] = "Isso definitivamente foi um esquema bem elaborado...";
    text[10558] = "EI, EU GOSTO DE PREPARAR JOGOS DE FESTA E LUTAR COM MEUS AMIGOS, TÁ BOM?!";
    text[10559] = "A Raine sempre foi assim?";
    text[10560] = "Olha... Sim!";
    text[10561] = "... E vocês sempre topam esses esquemas loucos dela?";
    text[10562] = "Olha, sinceramente, não há dias chatos perto da Raine. Ela sabe como se divertir!";
    text[10563] = "Concordo.";
    text[10564] = "Agora, vamos começar a festa! Preparem-se para o BAITA ONDA!";
    text[10565] = "MINIJOGO BAITA ONDA";
    text[10566] = "PULAR";
    text[10567] = "MOVER";
    text[10569] = "SEM CHANCE! COMO ASSIM??";
    text[10570] = "PERDEMOS POR UMA BARRA DE CHEESECAKE!";
    text[10571] = "Hehe. Realmente foi muito divertido!";
    text[10572] = "Sim, sim! Quero brincar no percurso de novo!";
    text[10573] = "Você pode jogar o BAITA ONDA quantas vezes quiser, Tetra.";
    text[10574] = "Então... Qual nosso prêmio? Você mencionou que havia um.";
    text[10575] = "Hehehe... ";
    text[10576] = "Hehehehehehe...";
    text[10577] = "BAHAHAHA!";
    text[10578] = "Lá vem...";
    text[10579] = "Seu prêmio é...";
    text[10580] = "... a oportunidade de ter uma revanche contra o Esquadrão Raine!";
    text[10581] = "... ... ... Quer saber?!";
    text[10582] = "PODEM VIR!";
    text[10583] = "Estava me coçando para treinar de qualquer jeito.";
    text[10584] = "Eu também! Eu também!";
    text[10585] = "Uma super-heroína deve estar sempre pronta para o que vier!";
    text[10586] = "Vocês três podem ter ganhado a última, mas desta vez...";
    text[10587] = "... Viemos preparadas! Não vamos nos segurar!";
    text[10588] = "Droga! Essa competitividade toda da Raine te contaminou, Melody!";
    text[10589] = "Bella, como a nova general da Força Lunex, você precisará de boas parceiras de treino";
    text[10590] = "para superar seus limites e alcançar novas alturas.";
    text[10591] = "Iremos lutar contra você quantas vezes quiser de sorriso no rosto.";
    text[10592] = "Meninas... Eu não poderia pedir parceiras de treino melhores...";
    text[10593] = "Nickle... Tetra...";
    text[10594] = "É HORA DE NOS PREPARARMOS PARA A BATALHA!";
    text[10595] = "Ahhh... Isso foi... SENSACIONAL!";
    text[10596] = "MAS... QUE DROGA QUE PERDEMOS...";
    text[10597] = "GUARDEM MINHAS PALAVRAS! QUALQUER DIA DESSES, O ESQUADRÃO RAINE SAIRÁ VITORIOSO!";
    text[10598] = "Incrível... A sinergia que vocês três têm como equipe é simplesmente incrível!";
    text[10599] = "Acho que preciso de uma bolsa de gelo... Ai...";
    text[12116] = "Tome, Bella, quero que fique com isso.";
    text[12118] = "Hm? O que é isso?";
    text[12119] = "Considere como um presente de parabéns nosso...";
    text[12122] = "... para a nossa amada guerreira prodígio! BAHAHAHA!";
    text[12117] = "Aaaaw... Obrigada! Vocês são as melhores!";
    text[12123] = "Algumas horas depois...";
    text[10600] = "Acho que deu por hoje.";
    text[10601] = "Obrigada por preparar essa festa. Me diverti demais!";
    text[10602] = "Eu também!";
    text[10603] = "Tudo na vida é equilíbrio.";
    text[10604] = "Após tudo o que passamos nesses últimos tempos,";
    text[10605] = "acho que todos merecemos um descanso assim.";
    text[10606] = "Com certeza!";
    text[10607] = "Bom, equipe, vamos nessa!";
    text[10608] = "EPISÓDIO DA PRAIA CONCLUÍDO!";
    text[10615] = "E aí, Bella? Quer uma revanche contra o Esquadrão Raine?";
    text[10616] = "VAMOS BATALHAR!";
    text[10617] = "Quem sabe na próxima...";
    text[10618] = "PODE CRER! VOCÊ VAI PERDER!";
    text[10619] = "M-07: Monstros de Magnésia";
    text[10620] = "Recebemos sinais agitados de três de nossos soldados que estavam";
    text[10621] = "patrulhando os arredores do setor abandonado: Magnésia.";
    text[10622] = "Eles reportaram ter encontrado o que descreveram como";
    text[10623] = "'monstros' estranhos que não pareciam ser Murks.";
    text[10624] = "Antes de questionar a respeito, perdemos a comunicação com eles.";
    text[10625] = "Sua missão é investigar os 'Monstros de Magnésia',";
    text[10626] = "e resgatar nossos companheiros Soldados da Força Lunex.";
    text[10768] = "Magnésia...";
    text[10769] = "Esse é o setor abandonado que vimos ao longe";
    text[10770] = "antes de chegarmos à Colônia Sílica.";
    text[10771] = "Os registros públicos dizem que a destruição de Magnésia foi";
    text[10772] = "causada pela ação de um único Murk extremamente poderoso...";
    text[10773] = "Hmm...";
    text[10774] = "... No que está pensando, Bella?";
    text[10775] = "Será que há alguma conexão entre os 'monstros' que nossos";
    text[10776] = "soldados reportaram e o 'Murk' que destruiu Magnésia?";
    text[10777] = "Alguém viu como ele é e se ainda está por lá?";
    text[10778] = "Bella, a destruição de Magnésia aconteceu há anos...";
    text[10779] = "Duvido muito que haja alguma informação a respeito...";
    text[10780] = "Hmm...";
    text[10781] = "Só consigo imaginar um lugar...";
    text[10782] = "Os servidores secretos do Saros.";
    text[10783] = "Está dizendo que há uma chance de Saros ter um registro do";
    text[10784] = "dia que Magnésia foi destruída?";
    text[10785] = "Já que os registros públicos dizem que havia um Murk envolvido no incidente...";
    text[10786] = "Sim... Acho que há uma boa chance.";
    text[10787] = "E se os Monstros de Magnésia foram só mais um dos experimentos dele?";
    text[10788] = "Saros acobertou um monte de coisa suspeita ao longo dos anos...";
    text[10789] = "Não faz mal dar uma conferida.";
    text[10790] = "... É.";
    text[10791] = "... E como acessaremos os servidores secretos?";
    text[10792] = "Nyla pode nos ajudar. Ela tem trabalhado com a equipe de análise de dados dela";
    text[10793] = "para extrair e decriptar os arquivos nos servidores secretos.";
    text[10794] = "Vamos dar um alô rapidinho na Nyla antes de irmos para Magnésia.";
    text[10795] = "Ela deve estar no Laboratório Nexus. Vamos!";
    text[10796] = "Ei, senhorita Nyla.";
    text[10797] = "Olá, querida. O que os traz aqui?";
    text[10798] = "Temos a missão de investigar alguns monstros estranhos que";
    text[10799] = "foram avistados no setor abandonado, Magnésia.";
    text[10800] = "Precisamos ir em breve encontrar nossos soldados desaparecidos...";
    text[10801] = "... mas antes de partirmos...";
    text[10802] = "Poderia me enviar quaisquer arquivos que Saros possa ter mantido";
    text[10803] = "em seus servidores secretos sobre Magnésia, sua destruição";
    text[10804] = "e os avistamentos do Murk que foram reportados neles?";
    text[10805] = "Quero ter certeza de que estamos realmente preparados para esta missão.";
    text[10806] = "Sem problema algum, querida. Fique à vontade.";
    text[10807] = "Prossigam para Magnésia para resgatar nossos soldados.";
    text[10808] = "Se eu encontrar algum arquivo relevante, enviarei para Tetra no ato.";
    text[10809] = "Muito obrigada, senhorita Nyla!";
    text[10810] = "Vamos, pessoal, rumo à Magnésia!";
    text[10701] = "Para chegar à Magnésia,";
    text[10702] = "precisamos passar pela Trilha Abandonada.";
    text[10703] = "Estão prontos?";
    text[10704] = "Assim que entrarmos, estaremos comprometidos a completar esta missão.";
    text[10705] = "Nossos camaradas da Força Lunex estão contando conosco!";
    text[10706] = "Por aqui, tudo pronto!";
    text[10707] = "Eu ainda não estou...";
    text[10708] = "Vamos que vamos!";
    text[10709] = "... ... ...";
    text[10710] = "Nickle, você está bem?";
    text[10711] = "S-sim. Por quê?";
    text[10712] = "Você parece um pouco abalado...";
    text[10713] = "... Estou bem... Vamos nessa.";
    text[12211] = "Eita... Essa estrada parece bem ferrada...";
    text[12212] = "Ela já foi uma incrível rodovia que as pessoas usavam";
    text[12213] = "para viajar entre a Colônia Magnésia e a Colônia Sílica.";
    text[12214] = "Agora... está abandonada e esquecida. ... Por isso que";
    text[12215] = "o Banco de Dados Lunex refere-se a esta estrada como a 'Trilha Abandonada'.";
    text[12216] = "Hm... Bella?";
    text[12217] = "O que foi, Tetra?";
    text[12218] = "AVISTEI ALGO!";
    text[12219] = "Uou! Esses devem ser os 'monstros estranhos' que nossos soldados reportaram.";
    text[12220] = "Acha que podem ser Murks?";
    text[12221] = "Não tenho certeza... Não se parecem nada com Murks.";
    text[12222] = "Seja lá o que for... não são humanos, definitivamente.";
    text[12223] = "Precisamos nos aproximar para conferir.";
    text[12224] = "Vamos atrás deles!";
    text[12225] = "Entendido!";
    text[12226] = "... ... ...";
    text[10627] = "Chegamos tarde demais...";
    text[10628] = "Os Soldados Lunex... Eles estão mortos...";
    text[10629] = "Bella, inimigos hostis se aproximando!";
    text[10630] = "CORRUPTO... CORRUPTO... CORRUPTOIDE!";
    text[10631] = "Espera aí... São as entidades dos Antigos!";
    text[10632] = "Tem certeza?";
    text[10633] = "Acho que sim.";
    text[10634] = "A lux deles parece muito com Guardia e Lumicavaleiro...";
    text[10635] = "... mas tem algo estranho...";
    text[10636] = "... É como se estivessem corrompidos...";
    text[10637] = "Achava que os Antigos estavam do nosso lado...";
    text[10638] = "... Por que atacariam vidas inocentes?";
    text[10639] = "Não sei... mas não podemos deixá-los escapar impunes!";
    text[10640] = "Precisamos vingar nossos falecidos camaradas!";
    text[10641] = "Vamos nos preparar para a batalha!";
    text[10642] = "Guardia?!";
    text[10643] = "SAUDAÇÕES, PERCEPTORA DE ALMAS...";
    text[10648] = "Guardia, o que está acontecendo aqui?";
    text[10649] = "As entidades dos Antigos atacaram nossos soldados...";
    text[10650] = "Tem alguma coisa lá fora...";
    text[10651] = "... e parece ser maldade pura...";
    text[10861] = "MEUS SENSORES DETECTARAM QUE UMA DAS ENTIDADES GUARDIÃS";
    text[10862] = "DESPERTOU...";
    text[10863] = "... E SEU NOME É 'NECROMIA'.";
    text[10873] = "Necromia...";
    text[10874] = "Lembro de um Texto dos Antigos que mencionava esse nome...";
    text[10875] = "Era uma entidade guardiã que tinha a habilidade de manipular mentes.";
    text[10876] = "C-controle mental?! É sério isso??";
    text[10877] = "EXATAMENTE.";
    text[10864] = "... E POR MOTIVOS QUE DESCONHEÇO,";
    text[10865] = "A PROGRAMAÇÃO DE NECROMIA FOI CORROMPIDA.";
    text[10866] = "E, CONSEQUENTEMENTE, TODOS OS SOLDADOS DE NECROMIA TAMBÉM FORAM CORROMPIDOS.";
    text[10868] = "Uma entidade dos Antigos corrompida... Como isso pôde acontecer?";
    text[10869] = "INFELIZMENTE, DESCONHEÇO O MOTIVO...";
    text[10867] = "MAS O QUE SEI É QUE...";
    text[10870] = "NECROMIA É UMA ENTIDADE MUITO MAIS PODEROSA DO QUE EU...";
    text[10878] = "... E AGORA...";
    text[10871] = "EM VEZ DE SERVIR PARA PROTEGER LUNA,";
    text[10879] = "NECROMIA BUSCA DESTRUÍ-LA.";
    text[10872] = "SEM MEU EXOESQUELETO, SOU INCAPAZ DE IMPEDIR NECROMIA...";
    text[10880] = "... POR ISSO, NECESSITO DA AJUDA DE VOCÊS.";
    text[10665] = "Não se preocupe, Guardia!";
    text[10666] = "Daremos nosso melhor para evitar que Necromia machuque mais pessoas!";
    text[10667] = "VOCÊS PRECISAM AGIR RÁPIDO...";
    text[10812] = "Guardia?";
    text[10813] = "O que foi?";
    text[10821] = "MINHA HORA CHEGOU...";
    text[10814] = "LOGO... DESAPARECEREI...";
    text[10815] = "O RESTO... ESTÁ EM SUAS MÃOS...";
    text[10816] = "BELLA GREY.";
    text[10817] = "SUA LUX É INFINITA...";
    text[10818] = "PEÇO QUE A USE...";
    text[10819] = "PARA PROTEGER... NOSSO LAR...";
    text[10645] = "Guardia...";
    text[10646] = "Obrigada por tudo...";
    text[10647] = "Foi graças a você que fui capaz de encontrar novamente a minha mãe";
    text[10822] = "e despertar minha Percepção de Almas.";
    text[10820] = "Honrarei seu grande sacrifício e suas últimas palavras...";
    text[10823] = "Vamos continuar.";
    text[10860] = "Temos que encontrar Necromia antes que seja tarde demais!";
    text[10827] = "Espere aí...";
    text[10828] = "Não acho que seja uma boa ideia vocês duas continuarem.";
    text[10829] = "Ahn?? Por quê?";
    text[10830] = "Somos uma equipe, lembra?!";
    text[10831] = "Somos mais fortes juntos do que separados...";
    text[10832] = "Eu sei, mas... Deixem-me cuidar disso...";
    text[10833] = "Você ouviu Guardia. Necromia pode controlar mentes...";
    text[10834] = "... E não quero arriscar perder nenhuma das duas.";
    text[10835] = "Preciso fazer isso com minhas próprias mãos...";
    text[10845] = "Principalmente, por estarmos aqui em Magnésia...";
    text[10837] = "Nickle...";
    text[10836] = "Você tem estado distante desde que começamos esta missão.";
    text[10838] = "... O que você não nos contou?";
    text[10725] = "Se eu contar... Vocês nunca me perdoarão...";
    text[10839] = "Nickle, confie em nós.";
    text[10840] = "Você não precisa passar por isso sozinho.";
    text[10841] = "Não, você não está entendendo.";
    text[10842] = "Se eu contar... não poderemos mais ser amigos...";
    text[10843] = "...";
    text[10844] = "Prefiro saber a verdade viver sob a sombra de mentiras.";
    text[10726] = "Não pode ser tão ruim assim...";
    text[10727] = "É pior do que vocês possam imaginar.";
    text[10728] = "É o motivo pelo qual eu sou tão...";
    text[10729] = "... complicado.";
    text[10730] = "...";
    text[10731] = "No dia em que Magnésia foi destruída,";
    text[10732] = "fui emboscado por Saros e pela Força Lunex.";
    text[10733] = "Era a terceira tentativa dele de me capturar...";
    text[10734] = "Eu estava exausto....";
    text[10735] = "Com medo...";
    text[10736] = "Com raiva...";
    text[10737] = "Eu odiava Saros...";
    text[10738] = "... e me odiava por ter esses poderes...";
    text[10739] = "Não era justo...";
    text[10740] = "... ser tratado como um monstro... como uma cobaia de laboratório...";
    text[10741] = "Eu não aguentava mais...";
    text[10742] = "Naquele dia, em vez de fugir, decidi lutar.";
    text[10743] = "Soltei toda a minha fúria... Meu corpo se transformou...";
    text[10744] = "... e minha antimatéria começou a consumir meus pensamentos...";
    text[10745] = "Dei a Saros exatamente o que ele queria...";
    text[10748] = "... um monstro.";
    text[10749] = "... e esse momento de fúria...";
    text[10746] = "... foi o maior erro da minha vida.";
    text[10747] = "Na época, ainda não conseguia controlar todo o meu poder...";
    text[10750] = "Depois que entrei no Modo Fásico,";
    text[10751] = "tudo virou um grande borrão. Não lembro do que aconteceu...";
    text[10752] = "Quando voltei a mim, já era tarde demais...";
    text[10753] = "A Colônia Magnésia estava destruída...";
    text[10754] = "... e só havia sobrado eu ali...";
    text[10755] = "As pessoas de Magnésia morreram por MINHA CULPA...";
    text[10756] = "... e não há como trazê-las de volta...";
    text[10757] = "Desde aquele dia, passo cada mísero dia da minha vida";
    text[10758] = "sentindo culpa, vergonha e medo.";
    text[10759] = "Temendo machucar outras pessoas...";
    text[10760] = "Temendo o que posso acabar fazendo se usar todo o meu poder novamente...";
    text[10761] = "... Eu fui fraco...";
    text[10762] = "Sou eu quem merece...";
    text[10763] = "Nickle...";
    text[10764] = "Bella, não acho que consigo encará-la novamente...";
    text[10765] = "... Tenho que me redimir pelo que eu fiz.";
    text[10766] = "Desculpa...";
    text[10846] = "...!";
    text[10847] = "... Não posso acreditar nisso...";
    text[10848] = "Não pode ser verdade...";
    text[10849] = "Bella...";
    text[10850] = "Não podemos deixá-lo ir sozinho.";
    text[10851] = "Ele vai acabar sendo morto.";
    text[10852] = "Bella!";
    text[10853] = "Nyla encontrou algo nos servidores secretos de Saros!";
    text[10854] = "Vamos ler o relatório...";
    text[10855] = "... ... ...";
    text[10856] = "BELLA!";
    text[10857] = "CERTO. PRECISAMOS ENCONTRAR NICKLE!";
    text[10858] = "ELE PRECISA SABER DISSO. VAMOS LOGO!";
    text[10714] = "Ei! Um terremoto?!";
    text[10715] = "Posso senti-lo...";
    text[10716] = "... um grande poder nos aguarda.";
    text[10720] = "Vamos continuar...";
    text[10721] = "Tenho um mau pressentimento...";
    text[10881] = "Nickle!";
    text[10882] = "Procuramos você por todos os lados!";
    text[10883] = "Recebemos um relatório de Nyla sobre o incidente em Magnésia.";
    text[10884] = "Há algo que você PRECISA saber!";
    text[10885] = "... ... ... ...";
    text[10886] = "Nickle?";
    text[10887] = "TEMO QUE SEU AMIGO NÃO ESTEJA MAIS ENTRE NÓS...";
    text[10888] = "Você deve ser Necromia.";
    text[10889] = "CERTAMENTE SOU... CERTAMENTE SOU...";
    text[10915] = "QUANDO EMBOSQUEI SEU AMIGO...";
    text[10890] = "ELE NÃO PARECIA SE RECORDAR DE MIM...";
    text[10891] = "FOI ESTRANHO... FOI ESTRANHO...";
    text[10892] = "... POIS LEMBRO-ME DELE CLARAMENTE...";
    text[10916] = "TODOS ESSES ANOS... TODOS ESSES ANOS...";
    text[10917] = "ACUMULANDO ENERGIA O SUFICIENTE PARA DESPERTAR NOVAMENTE...";
    text[10893] = "Nickle, por favor, volte ao normal!";
    text[10894] = "Necromia está controlando sua mente!";
    text[10895] = "ELE NÃO PODE OUVI-LA... ELE NÃO PODE OUVI-LA...";
    text[10896] = "SEU AMIGO... AGORA É MEU PEÃO SEM CABEÇA!";
    text[10909] = "TRAGA-O DE VOLTA, SEU CASCO ESTÚPIDO!";
    text[10910] = "SABE... EU NÃO TENHO UM CORPO FÍSICO.";
    text[10911] = "MEU EXOESQUELETO FOI DESTRUÍDO HÁ TEMPOS...";
    text[10912] = "... DESTRUÍDO POR ELE. ... DESTRUÍDO POR ELE.";
    text[10913] = "... E, AGORA, USAREI SEU CORPO COMO MEU NOVO CORPO.";
    text[10918] = "QUE INFELICIDADE...";
    text[10914] = "ELE NÃO SE LEMBRA... ELE NÃO SE LEMBRA...";
    text[10897] = "POSSO SENTIR...";
    text[10898] = "A MENTE DELE TOMADA POR ÓDIO PRÓPRIO...";
    text[10899] = "MESMO AGORA... ELE LUTA CONTRA...";
    text[10900] = "ELE TEME... ELE TEME...";
    text[10901] = "ELE TEM MEDO DE MACHUCÁ-LAS...";
    text[10902] = "FAREI DE SEUS PESADELOS REALIDADE!";
    text[10903] = "Nickle, não deixe que o controlem!";
    text[10904] = "Você é mais forte que isso!";
    text[10905] = "LUTE!";
    text[10906] = "LUTAR, VOCÊ DIZ? LUTAR, VOCÊ DIZ?";
    text[10907] = "SE É UMA LUTA QUE DESEJA...";
    text[10908] = "... UMA LUTA TERÁ!";
    text[10922] = "Nickle, você conseguiu!";
    text[10923] = "Você se livrou do controle mental de Necromia!";
    text[10919] = "IMPOSSÍVEL... IMPOSSÍVEL...";
    text[10924] = "NÃO PODE SER...";
    text[10925] = "VOCÊ PRECISA SER ELIMINADO... NÃO PODE SER...";
    text[10920] = "Lembro-me agora...";
    text[10921] = "Lembro de TUDO.";
    text[10926] = "Mas... não foram minhas lembranças que apareceram.";
    text[10927] = "... foram as suas, Necromia.";
    text[10928] = "FOI DE PROPÓSITO... PROPÓSITO...";
    text[10929] = "COMPARTILHEI MINHAS LEMBRANÇAS PARA QUE...";
    text[10930] = "... VOCÊ VISSE O QUANTO EU O DESPREZO...";
    text[10931] = "Você e eu... já lutamos no passado.";
    text[10932] = "No dia em que Magnésia foi destruída.";
    text[10933] = "Bella, o que o relatório de Nyla dizia?";
    text[10960] = "Os registros públicos que documentam a destruição de Magnésia eram";
    text[10980] = "só um disfarce de Saros para proteger sua reputação...";
    text[10981] = "... tudo porque o plano dele de capturá-lo naquele dia falhou.";
    text[10934] = "Para tentar testar o poder de seu Soro de Murk...";
    text[10935] = "Saros decidiu experimentar em uma entidade dos Antigos que a equipe";
    text[10936] = "arqueológica encontrou anos atrás.";
    text[10937] = "Essa entidade dos Antigos... era Necromia.";
    text[10938] = "... e Saros foi o responsável por corrompê-la.";
    text[10942] = "CORRUPÇÃO... CORRUPÇÃO...";
    text[10939] = "Ele reprogramou Necromia na tentativa de usar seu poder";
    text[10940] = "para tentar me controlar...";
    text[10941] = "... mas não conseguiu.";
    text[10943] = "... porque, naquele dia, eu não tive controle.";
    text[10944] = "Minha mente já estava prejudicada...";
    text[10945] = "... e meu corpo estava funcionando por puro instinto de sobrevivência.";
    text[10946] = "Assim que Saros entendeu que Necromia não seria capaz de me controlar,";
    text[10947] = "ele mudou seus planos e instruiu Necromia a atacar a cidade.";
    text[10948] = "... E ASSIM O FIZ... E ASSIM O FIZ...";
    text[10949] = "PURA DESTRUIÇÃO...";
    text[10950] = "FOI... FOI...";
    text[10951] = "FASCINANTE...";
    text[10952] = "APESAR DE SUA MENTE ESTAR PERDIDA...";
    text[10982] = "SEU CORPO SE MOVEU SOZINHO...";
    text[10953] = "SEU INSTINTO... FOI PROTEGER OS INOCENTES...";
    text[10954] = "VOCÊ TENTOU ME IMPEDIR... E, ISSO, VOCÊ CONSEGUIU...";
    text[10956] = "VOCÊ DESFERIU UM ATAQUE TÃO PODEROSO...";
    text[10957] = "QUE MEU EXOESQUELETO VIROU POEIRA ESTELAR...";
    text[10955] = "... MAS NÃO ANTES DE EU TER JÁ DESTRUÍDO A CIDADE!";
    text[10969] = "... E você nunca mais destruirá nada.";
    text[10970] = "Acabou, Necromia.";
    text[10979] = "INFELIZMENTE PARA VOCÊ... NESTA FORMA...";
    text[10975] = "VOCÊ NÃO É CAPAZ DE ME FERIR... VOCÊ NÃO É CAPAZ DE ME FERIR...";
    text[10983] = "Aí que você se engana.";
    text[10976] = "Com o poder da Antimatéria...";
    text[10977] = "... combinado com o poder da Lux...";
    text[10978] = "... não há nada que não sejamos capazes de fazer.";
    text[10971] = "Bella!";
    text[10972] = "Estou logo atrás de você! Hora da Percepção de Almas!";
    text[10973] = "ISSO É PELO... POVO DE MAGNÉSIA!";
    text[10974] = "HAAAAAIÁ!";
    text[10986] = "Dizem que a ignorância é uma bênção...";
    text[10987] = "Ter conhecido a verdadeira escuridão e os segredos dos Murks,";
    text[10988] = "invejo aqueles que desconheciam a verdade.";
    text[10989] = "... mas, neste caso,";
    text[10990] = "minha ignorância foi uma maldição.";
    text[10991] = "Por anos,";
    text[10963] = "fui levado a acreditar que fui eu quem havia destruído Magnésia...";
    text[10964] = "e, mesmo que eu não tenha matado essas pessoas...";
    text[10965] = "Ainda me sinto responsável pelo que aconteceu...";
    text[10966] = "Os habitantes de Magnésia morreram porque...";
    text[10984] = "Não fui forte o suficiente para protegê-los...";
    text[10967] = "Nickle...";
    text[10968] = "Você precisa aprender a se perdoar...";
    text[10992] = "Como você nasceu...";
    text[10995] = "O que pessoas ruins como Saros decidiram fazer";
    text[10996] = "por como você nasceu...";
    text[10997] = "... pelos conhecimentos, poderes e objetivos distorcidos...";
    text[10998] = "... tudo isso não é culpa sua...";
    text[10999] = "Agora, você tem a oportunidade de fazer justiça.";
    text[11000] = "Justiça...";
    text[10993] = "... Isso.";
    text[10994] = "Por isso, tenho me esforçado tanto para achar os Antinúcleos...";
    text[11001] = "Exatamente.";
    text[11002] = "Você e eu...";
    text[11021] = "Queremos devolver as pessoas que sofreram nas mãos de Saros";
    text[11003] = "para suas famílias e entes amados.";
    text[11004] = "... mas as pessoas de Magnésia...";
    text[11005] = "... não temos como trazê-las de volta.";
    text[11006] = "Isso não é totalmente verdade...";
    text[11007] = "Ahn?! Como assim?";
    text[11008] = "Há mais uma coisa no relatório que Nyla nos enviou...";
    text[11009] = "Necromia pode ter destruído a cidade...";
    text[11010] = "... mas não matou a todos.";
    text[11011] = "Todos os sobreviventes foram aprisionados pelos soldados de Saros e...";
    text[11012] = "... foram usados como cobaias em seus experimentos com Murks.";
    text[11013] = "Esses sobreviventes...";
    text[11014] = "Eles estão por aí em algum lugar... como Murks...";
    text[11016] = "... e é nosso trabalho encontrá-los e levá-los para casa.";
    text[11057] = "... ... ...";
    text[11051] = "*choro*";
    text[11052] = "Ei, ei! Tá tudo bem, Nickle.";
    text[11053] = "Eu... *choro* ... desculpa...";
    text[11054] = "É que...";
    text[11055] = "... estou aliviado em saber que ainda há chance de corrigir isso tudo...";
    text[11056] = "*choro*";
    text[11017] = "Bella...";
    text[11022] = "Tetra...";
    text[11018] = "... Eu não teria chegado tão longe sem vocês...";
    text[11019] = "Obrigado por me apoiarem...";
    text[11020] = "É para isso que servem os amigos!";
    text[11023] = "Somos os Três Mosqueteiros Lunares, lembra?!";
    text[11024] = "Com certeza.";
    text[11025] = "Antes de partirmos...";
    text[11026] = "Gostaria de mostrar meu respeito ao povo de Magnésia...";
    text[11027] = "... e aos Soldados Lunex que morreram aqui hoje.";
    text[11028] = "Claro, leve o tempo que precisar.";
    text[11029] = "MONSTROS DE MAGNÉSIA\n-MISSÃO CONCLUÍDA-";
    text[11030] = "Bella...";
    text[11031] = "Que manda?";
    text[11032] = "Estava pensando se poderia desafiá-la para um duelo.";
    text[11033] = "Um duelo?? Aqui?";
    text[11034] = "Sim.";
    text[11035] = "Pode soar besta, mas...";
    text[11036] = "Quero mostrar ao povo de Magnésia";
    text[11037] = "que estou dando o meu melhor para ficar mais forte.";
    text[11038] = "... e você é a lutadora mais forte que eu conheço.";
    text[11039] = "Então, você quer lutar?";
    text[11040] = "O vencedor leva o perdedor para jantar.";
    text[11041] = "Hm. Isso é o seu jeito de me chamar para sair?";
    text[11042] = "O-o quê?? Hm...";
    text[11047] = "Talvez...";
    text[11043] = "Você não disse não, então presumo que seja um sim.";
    text[11044] = "Desafio aceito! Hehe.";
    text[11045] = "... Mas esteja avisado, não vou pegar leve com você.";
    text[11046] = "Nem quero que pegue.";
    text[11048] = "Por você, irei de Modo Fásico.";
    text[11049] = "Maravilha! Vamos nessa!";
    text[11050] = "Gostaria de batalhar contra Nickle?";
    text[11072] = "Então essa é a Ener-G Ltda...";
    text[11073] = "Hehehe...";
    text[11075] = "Em breve...";
    text[11076] = "Muito em breve...";
    text[11074] = "(Esse cara parece suspeito...)";
    text[11069] = "Senhor, podemos ajudá-lo de alguma forma?";
    text[11070] = "Não... Não é da sua conta.";
    text[11071] = "Vaza, criança.";
    text[11077] = "M-06: Tomada da Ener-G Ltda";
    text[11078] = "O prédio da Ener-G Ltda que fica em Tycho foi tomado";
    text[11079] = "pelos Saqueadores, um grupo de ladrões que são conhecidos por roubar";
    text[11080] = "itens valiosos e vendê-los para lucrar no mercado clandestino.";
    text[11081] = "Eles são muito perigosos e desconhecemos suas motivações...";
    text[11082] = "Sua missão é se infiltra na Ener-G Ltda,";
    text[11083] = "prender os nefastos Saqueadores";
    text[11084] = "e descobrir o que estão querendo roubar!";
    text[11085] = "Ei, qual a situação atual?";
    text[11086] = "Senhorita Bella, evacuamos o máximo de pessoas que conseguimos,";
    text[11087] = "mas os Saqueadores pegaram o CEO e seus funcionários";
    text[11088] = "como reféns nos andares superiores.";
    text[11089] = "Para avaliar melhor a situação, acionamos nossos drones";
    text[11090] = "para escanear o prédio e eles descobriram bombas-relógio!";
    text[11091] = "Seja lá o que os Saqueadores estão atrás, eles querem que acabe RÁPIDO";
    text[11092] = "e estão dispostos a explodir o prédio para obtê-lo.";
    text[11093] = "Sério... Por que estão se dando todo esse trabalho";
    text[11094] = "para roubar uma empresa que produz energéticos?";
    text[11095] = "Hm... com licença,";
    text[11096] = "acho que sei o que os Saqueadores estão buscando...";
    text[11097] = "Estamos desenvolvendo uma nova fórmula de Ener-G faz alguns anos...";
    text[11098] = "Essa nova bebida tem a habilidade de manter o corpo e a mente";
    text[11099] = "alertas e energizados por dias sem a necessidade de dormir.";
    text[12000] = "É a bebida SUPREMA...";
    text[12001] = "... para quem quer maximizar a própria produtividade.";
    text[12002] = "Nós a chamamos de: Ener-G Infinito";
    text[12003] = "Essa fórmula tem muitas aplicações potenciais científicas";
    text[12004] = "e biológicas... a tornando extremamente valiosa.";
    text[12005] = "Por isso...";
    text[12006] = "Acho que os Saqueadores estão aqui para roubar nossa fórmula do Ener-G Infinito.";
    text[12007] = "Obrigada pelas informações! Não se preocupe...";
    text[12008] = "Não deixaremos que os Saqueadores se safem!";
    text[12009] = "Vamos, pessoal! Vamos entrar!";
    text[12010] = "Tsc. Então a Força Lunex finalmente apareceu...";
    text[12011] = "Não se mexam! Vocês estão todos presos!";
    text[12012] = "Acha mesmo que abandonaremos a nossa operação";
    text[12013] = "e nos entregaremos sem lutar?";
    text[12014] = "Inocente...";
    text[12015] = "Temos Saqueadores em todos os andares, criança...";
    text[12016] = "... e este prédio explodirá em 10 turnos,";
    text[12017] = "goste você ou não.";
    text[12018] = "10 turnos?";
    text[12019] = "Fácil.";
    text[12020] = "Posso derrotar todos vocês em um único turno.";
    text[12021] = "Tsc. Moleque arrogante.";
    text[12022] = "Não se meta com os Saqueadores!";
    text[12076] = "Achei que esse era um prédio corporativo...";
    text[12077] = "Qual é desse monte de setas?";
    text[12170] = "Isso aqui parece um labirinto...";
    text[12078] = "Quem sabe os Saqueadores colocaram as setas para nos atrasar?!";
    text[12079] = "... Isso ou o CEO da Ener-G Ltda ama pisos com setas...";
    text[12171] = "Ó não! Mais Saqueadores!";
    text[12172] = "Não se preocupe, a gente dá conta!";
    text[12023] = "Ora, ora...";
    text[12024] = "Parece que subestimei o poder da Força Lunex.";
    text[12025] = "Você deve ser o líder dos Saqueadores...";
    text[12026] = "De fato, sou eu.";
    text[12027] = "Agora, se me dá licença, tenho coisas a resolver em outro lugar.";
    text[12028] = "Esta fórmula secreta não vai se vender sozinha.";
    text[12029] = "Vou dizer isso só uma vez...";
    text[12030] = "... Liberte os reféns e desative os explosivos. AGORA!";
    text[12031] = "... Senão? O que, exatamente?";
    text[12032] = "Vocês podem ter derrotado meus lacaios...";
    text[12033] = "Mas não são páreos para mim.";
    text[12034] = "O tempo está correndo, sabe...";
    text[12035] = "Já se esqueceram dos explosivos?";
    text[12036] = "Muito em breve, vocês não passarão de pilhas de cinzas!";
    text[12037] = "Veremos.";
    text[12038] = "Gente, desativei as bombas-relógio!";
    text[12039] = "O perigo foi evitado! Hihi.";
    text[12040] = "Obrigado por nos salvar...";
    text[12041] = "... e por impedir os Saqueadores...";
    text[12042] = "Aqui, aceite isso como demonstração da nossa gratidão...";
    text[12043] = "Ener-G Infinito obtido!";
    text[12044] = "Pera... Tudo bem nos dar isso?";
    text[12045] = "Não se preocupe. Nosso Ener-G Infinito logo será vendido ao público.";
    text[12046] = "Considere como uma amostra especial pré-lançamento!";
    text[12049] = "Cara... A motivação dos Saqueadores me deixa assustado...";
    text[12050] = "Se queriam tanto a fórmula...";
    text[12051] = "Não poderiam ter só esperado o lançamento?";
    text[12052] = "O mundo dos negócios é cruel e competitivo, meu caro.";
    text[12053] = "Quando se trata de produtos que são inovadores e revolucionários,";
    text[12054] = "aqueles que puderem lançá-lo primeiro terão uma grande vantagem.";
    text[12055] = "Fiz muitos inimigos ao longo dos anos, então agora tenho alguns";
    text[12061] = "competidores que podem ter contratado os Saqueadores para roubar a nossa fórmula...";
    text[12062] = "... mas, acho que essa é uma investigação para outra hora.";
    text[12057] = "Por ora...";
    text[12058] = "Precisamos melhorar nossa segurança e fortalecer nossa";
    text[12059] = "infraestrutura cibernética para garantir que isso nunca mais aconteça.";
    text[12060] = "Obrigado mais uma vez por nos salvar.";
    text[12047] = "Vocês três são bem-vindos para explorar a Ener-G Ltda sempre que quiserem.";
    text[12048] = "Maravilha! Obrigada!";
    text[12067] = "Ei, você está bem?";
    text[12073] = "Você não deveria estar aqui neste momento.";
    text[12072] = "Se estou bem?";
    text[12068] = "Estou mais que bem...";
    text[12074] = "Tudo o que sinto agora é...";
    text[12063] = "Um baita alívio...";
    text[12075] = "Que nojo...";
    text[12064] = "Cara, há uma chance deste prédio explodir.";
    text[12065] = "Pela sua segurança, você precisa sair AGORA!";
    text[12066] = "Eu vou, eu vou.";
    text[12069] = "Só me deixe... curtir esse momento.";
    text[12070] = "(Suspiro) Tetra, chame reforços para escoltá-lo para fora daqui.";
    text[12071] = "Entendido!";
    text[12305] = "DIFICULDADE:";
    text[12306] = "MODO NORMAL";
    text[12308] = "MODO DIFÍCIL";
    text[12307] = "INIMIGOS NORMAIS VIRAM INIMIGOS EX E OS EX VIRAM INIMIGOS ZX!";
    text[12309] = "MODO LENDÁRIO";
    text[12310] = "TODOS OS INIMIGOS VIRAM INIMIGOS ZX";
    text[11058] = "ENSEADA DO VERÃO";
    text[11062] = "TRILHA ABANDONADA";
    text[11063] = "SETOR 3: MAGNÉSIA";
    text[11064] = "CÂMARA SELADA";
    text[12080] = "SAQUEADOR";
    text[11061] = "CORRUPTOIDE";
    text[11060] = "NECROMIA";
    text[12124] = "Explosão Sonar";
    text[12125] = "Evocar Sentinela";
    text[12126] = "Necroexplosão";
    text[12127] = "Força Espiritual";
    text[12128] = "Aura Assombrada";
    text[12129] = "Corte Sentinela";
    text[12130] = "Rajada Corrompida";
    text[12131] = "Esmagamente";
    text[12132] = "Lâmina de Fótons";
    text[12133] = "Grupo de Ataque";
    text[12134] = "Código do Saqueador";
    text[12135] = "Microbomba";
    text[12083] = "Troféu de Estrela obtido!";
    text[12086] = "Atordoa Fácil obtido!";
    text[12087] = "Queima Fácil obtido!";
    text[12088] = "Medidor Fácil obtido!";
    text[12084] = "Super Elixir obtido!";
    text[12085] = "Necrofluido obtido!";
    text[12089] = "Chave da Ener-G obtida!";
    text[12090] = "Boia obtida!";
    text[12091] = "Rompedor de Limites obtido!";
    text[12098] = "Atordoa Fácil";
    text[12099] = "Atordoa 1 inimigo por 1 turno";
    text[12100] = "Queima Fácil";
    text[12101] = "Queima 1 inimigo por 3 turnos";
    text[12102] = "Medidor Fácil";
    text[12103] = "Enche os medidores de lux e o antimateriômetro em 50%";
    text[12092] = "Ener-G Infinito";
    text[12093] = "Cura Total + regeneração de PV e PE por 3 turnos";
    text[12094] = "Super Elixir";
    text[12095] = "+70 PE para todos os membros do grupo";
    text[12096] = "Necrofluido";
    text[12097] = "Revive um Aliado desmaiado com 100% de PV";
    text[12104] = "Chave da Ener-G";
    text[12105] = "Concede a entrada na Ener-G Ltda.";
    text[12106] = "Boia";
    text[12107] = "Hora de se divertir ao Sol!";
    text[12108] = "Rompedor de Limites";
    text[12109] = "Limite de NV. de todas as Habilidades Ativas +1!";
    text[12110] = "Troféu de Estrela";
    text[12111] = "Certifica a conclusão do BANCO DE DADOS!";
    text[12112] = "Alvo: Saqueadores";
    text[12113] = "Infiltre-se na Ener-G Ltda e prenda os Saqueadores!";
    text[12114] = "Alvo: Desconhecido";
    text[12115] = "Investigue os 'Monstros de Magnésia' e resgate os Soldados Lunex desaparecidos!";
    text[12139] = "Gostaria de se divertir no BAITA ONDA?";
    text[11059] = "BAITA ONDA";
    text[11067] = "PULAR";
    text[12138] = "TCHIBUM!";
    text[10610] = "SELECIONAR PERSONAGEM";
    text[10611] = "NOVO RECORDE!";
    text[10612] = "RECORDE:";
    text[10613] = "BÔNUS!";
    text[10614] = "INCRÍVEL!";
    text[12081] = "BANCO DE DADOS DE INIMIGOS EX E ZX CONCLUÍDO!";
    text[12082] = "PARABÉNS!";
    text[12136] = "Há alguns números gravados em uma das pranchas: 202310";
    text[12137] = "ENER-G LTDA: Viva a vida com Ener-Gia!";
    text[12173] = "Use nosso código promocional 692533 para ganhar grandes PRÊMIOS!";
    text[12166] = "O cesto de piquenique está cheio de petiscos e Barras de cheesecake!";
    text[12167] = "É uma bola de praia!";
    text[12168] = "As palmeiras aqui são tão lindas!";
    text[12169] = "Amo os rosas e os roxos!";
    text[12174] = "É uma garrafa gigante de Ener-G!";
    text[12175] = "Sala de Pesquisa e Desenvolvimento da Ener-G";
    text[12176] = "Sala de Armazenamento da Ener-G";
    text[12177] = "Departamento de Fabricação da Ener-G";
    text[12178] = "Parece que teve um encontro aqui nesta sala de reuniões.";
    text[12179] = "Este quadro inteligente está mostrando as vendas trimestrais da Ener-G Ltda.";
    text[12180] = "Este quadro inteligente está mostrando coisas como: Funcionário do Mês";
    text[12181] = "e outros reconhecimentos da empresa.";
    text[12182] = "Nickle, quer adivinhar o que está nesses armários?";
    text[12183] = "Vamos ver...";
    text[12184] = "Estamos dentro da Ener-G Ltda, cercados de garrafas gigantes de Ener-G por todos os lados...";
    text[12185] = "Aposto 1.000 Bytes que esses armários estão cheios de uma variedade de Ener-Gs.";
    text[12186] = "ERROU! Parece que você me deve 1.000 Bytes. Hihi.";
    text[12187] = "Sem chance! O que que tinha dentro desses armários então?";
    text[12188] = "Você só pode estar zoando...";
    text[12189] = "Bananas enlatadas?!";
    text[12190] = "POR QUÊ??";
    text[12191] = "Há um documento aberto no computador: Fórmula do Ener-G Infinito.";
    text[12192] = "Nunca vi esse tipo de Ener-G antes...";
    text[12193] = "... Esse deve ser o novo Ener-G Infinito que eles estão desenvolvendo.";
    text[12194] = "É uma Máquina Automática de Otimizadores de Habilidade!";
    text[12195] = "Compre 1 Otimizador de Habilidade por 5.000 Bytes.";
    text[12196] = "Compre 1 Otimizador de Habilidade por 250 Astrotecas.";
    text[12197] = "Compre 1 Otimizador de Habilidade por 50 Habilipontos.";
    text[12198] = "Faltam Astrotecas!";
    text[12199] = "Faltam Bytes!";
    text[12200] = "É uma Máquina de Câmbio de Habilipontos!";
    text[12201] = "Gostaria de trocar 50 Habilipontos por 5.000 Bytes?";
    text[12202] = "Faltam Habilipontos!";
    text[12203] = "É uma Máquina Automática de Ener-G Hiper!";
    text[12204] = "Gostaria de comprar um Ener-G Hiper com desconto por 1.000 Bytes?";
    text[11065] = "É um robô abandonado...";
    text[11066] = "... não parece estar funcionando.";
    text[12205] = "Saros e Vivia";
    text[12208] = "Deixa para lá.";
    text[12206] = "?????";
    text[12207] = "ERRO... ERRO... DADOS NÃO ENCONTRADOS...";
    text[12209] = "ALERTA... ALERTA...";
    text[12210] = "GERADORES DE HOLOGRAMAS... SOBRECARGA CRÍTICA...";
    text[12231] = "AVISO, NÃO ENTRE. ESTE É UM SETOR INSTÁVEL.";
    text[12232] = "É ESTRITAMENTE PROIBIDO ADENTRAR NO SETOR 3 E NA TRILHA ABANDONADA.";
    text[12234] = "PONTE PARA O SETOR 3";
    text[12235] = "ARREDORES DO SETOR 3";
    text[12236] = "É um painel elétrico.";
    text[12237] = "Esta máquina automática está fora de serviço...";
    text[12238] = "É um aviso de evacuação de emergência...";
    text[12239] = "É um cartaz divulgando um grupo de terapia de Cicloides.";
    text[12240] = "PRESTE SUAS HOMENAGENS ÀS ALMAS INQUIETAS DOS DOZE TÚMULOS...";
    text[12241] = "... E O NECROFLUIDO SERÁ SEU.";
    text[12255] = "AS ALMAS INQUIETAS DOS DOZE TÚMULOS FORAM LIBERTADAS...";
    text[12256] = "... O NECROFLUIDO AGORA É SEU.";
    text[12242] = "Você prestou suas homenagens às almas dos que se foram.";
    text[12243] = "O túmulo estranho começou a brilhar!";
    text[12244] = "RESTAM ONZE TÚMULOS...";
    text[12245] = "RESTAM DEZ TÚMULOS...";
    text[12246] = "RESTAM NOVE TÚMULOS...";
    text[12247] = "RESTAM OITO TÚMULOS...";
    text[12248] = "RESTAM SETE TÚMULOS...";
    text[12249] = "RESTAM SEIS TÚMULOS...";
    text[12250] = "RESTAM CINCO TÚMULOS...";
    text[12251] = "RESTAM QUATRO TÚMULOS...";
    text[12252] = "RESTAM TRÊS TÚMULOS...";
    text[12253] = "RESTAM DOIS TÚMULOS...";
    text[12254] = "RESTA UM TÚMULO...";
    text[12257] = "Vermil";
    text[12264] = "Kit parece estar conversando com Vermil,";
    text[12265] = "mas tudo o que ouço são barulhos de raposa...";
    text[12258] = "Oi! Eu sou a Bella.";
    text[12259] = "Acho que nunca te vi por aqui... Você é uma nova recruta?";
    text[12260] = "Nada. Já tô aqui faz um tempo...";
    text[12261] = "... até mais tempo do que consigo lembrar.";
    text[12277] = "Dado meu trabalho... Eu diria que sou uma recruta 'antiga'. Hahaha.";
    text[12278] = "É? Qual o seu trabalho?";
    text[12262] = "Acabei de voltar de uma expedição de um ano, em que me incumbiram";
    text[12274] = "de encontrar ruínas e artefatos não descobertos dos Antigos.";
    text[12275] = "Ah, entendi.";
    text[12263] = "Nesse caso, bem-vinda de volta...";
    text[12267] = "Desculpa. Esqueci de me apresentar.";
    text[12268] = "Meu nome é Vermil e essa é minha fiel companheira raposa, a Kit.";
    text[12269] = "A Kit é tããããão foooofa!";
    text[12270] = "Bela espada que você tem aí...";
    text[12276] = "Meu instinto de caçador de tesouros diz que essa é uma espada 'antiga'.";
    text[12271] = "Bom olho.";
    text[12272] = "Lembrete: preciso levá-lo em uma de minhas expedições algum dia...";
    text[12279] = "Hm...";
    text[12281] = "Nickle! Meu nome é Nickle.";
    text[12282] = "Nickle, como o metal Níquel... Ou soa como...";
    text[12283] = "Micou?";
    text[12286] = "Sim.";
    text[12287] = "Isso, Nickle, soa como Micou...";
    text[12284] = "Hm... nome interessante.";
    text[12285] = "(ESSE TEMPO TODO EU ACHAVA QUE ERA ESCRITO COMO O METAL.)";
    text[12273] = "De qualquer forma... Esta é uma espada antiga chamada 'Nébula Celestial'.";
    text[12280] = "Eu a encontrei em uma de minhas expedições há muitos anos.";
    text[12288] = "Nickle... Bella...";
    text[12289] = "Há muitos artefatos dos Antigos lá fora para encontrarmos.";
    text[12290] = "Se algum dia algum dos dois esbarrar com artefatos dos Antigos...";
    text[12291] = "Por favor, traga-os até mim!";
    text[12292] = "Terei um SUPER ELIXIR com seu nome escrito se o fizer.";
    text[12288] = "Nickle... Bella...";
    text[12293] = "Suas espadas... são INCRIVELMENTE ANTIGAS! ELAS PARECEM INCRÍVEIS!";
    text[12294] = "Minha espada se chama 'Excalibur'.";
    text[12295] = "... E a minha é a 'Espada Relíquia'.";
    text[12296] = "(Queria ter uma espada antiga incrível também...)";
    text[12297] = "Obrigada por me mostrar suas espadas.";
    text[12298] = "Como prometido... Aqui está o SUPER ELIXIR com seus nomes nele.";
    text[12299] = "Vermil, você não colocou mesmo nosso nome nele, né?";
    text[12300] = "Aff... Está escrito Bella e Micou. Haha.";
    text[12301] = "Ei, não olhe pra mim.";
    text[12302] = "Foi ideia da Kit.";
    text[12303] = "Meu sonho...";
    text[12304] = "É meu futuro ser totalmente 'antigo'.";
    text[12337] = "Raine falou para encontrar com ela na Enseada do Verão!";
    text[12338] = "É uma pequena praia ao norte de Oceanus no MAPA-MÚNDI!";
    text[12319] = "É hora de nos divertirmos ao Sol!";
    text[12311] = "A entrada para Magnésia...";
    text[12312] = "... deve estar entre as Fendas de Sílica e a Colônia Sílica.";
    text[12344] = "Precisamos ir atrás daqueles 'monstros' estranhos que vimos na ponte!";
    text[12365] = "Necromia é uma Entidade Guardiã que pode controlar mentes...";
    text[12366] = "Isso é bem assustador...";
    text[12367] = "Ficarei de olho se há algo suspeito durante o trajeto!";
    text[12314] = "Nickle...";
    text[12315] = "Ele passou por tanta coisa...";
    text[12316] = "Não podemos deixá-lo nos afastar! Precisamos encontrá-lo!";
    text[12317] = "Estou admirada que as árvores roxas aqui conseguiram sobreviver a esse clima.";
    text[12318] = "A mãe natureza é bem resiliente. Hihi.";
    text[12320] = "Você encontrou um pacote de transporte abandonado!";
    text[12326] = "Uuuuh! O que tem dentro?";
    text[12327] = "Hm... Nada.";
    text[12321] = "Está vazio.";
    text[12322] = "Esta área foi destruída há muitos anos...";
    text[12323] = "Quem quer que tenha perdido ele certamente não está mais procurando.";
    text[12324] = "Eu voto por guardar como um souvenir!";
    text[12325] = "Ahn?? Por quê?";
    text[12328] = "Gosto de pensar nele como uma parte da história de Luna.";
    text[12329] = "É... talvez...";
    text[12330] = "Certo, vamos guardá-lo por enquanto.";
    text[12331] = "Ebaaa!";
    text[12332] = "CEO da Ener-G";
    text[12333] = "Funcionário";
    text[12334] = "O filme chamado 'Jogos da Fome' está passando atualmente na TV.";
    text[12335] = "Comprar Otimizador (5.000 Bytes)";
    text[12336] = "Comprar Otimizador (250 Astrotecas)";
    text[12339] = "Acredito que ainda haja alguns Saqueadores espreitando em nosso prédio...";
    text[12340] = "Se encontrá-los, dê um jeito neles, por favor.";
    text[12342] = "Gostaria de recomeçar a missão?";
    text[12343] = "(Isso zerará o andamento da história e o contador de 'Turnos Restantes'.)";
    text[12345] = "Aumenta o POD de todas as Habilidades Ativas em 15!";
    text[12346] = "Admito...";
    text[12347] = "Também estou usando esta oportunidade para testar novas técnicas.";
    text[12348] = "Conto com você vindo com tudo.";
    text[12349] = "Essa brisa agradável...";
    text[12350] = "Nossos belos oceanos...";
    text[12351] = "Luna deve ser protegida a todo custo.";
    text[12352] = "Não deixarei que tirem isso de nós.";
    text[12353] = "Nem eu.";
    text[12354] = "Eu também não.";
    text[12355] = "Com nossos esforços unidos, daremos um jeito!";
    text[12356] = "Tenho esperanças.";
    text[12357] = "Agora você pode melhorar suas Habilidades Ativas até o Nível 4!";
    text[12359] = "Um inimigo que sofreu QUEIMAR perderá 10% de seu PV MÁX (Máx. 100 de DAN)";
    text[12360] = "por um determinado número de turnos!";
    text[12361] = "Bella, você precisa derrotar os Saqueadores antes que este prédio exploda!";
    text[12362] = "... mas, se em algum momento não souber o que fazer...";
    text[12363] = "Sempre podemos reiniciar a missão na entrada deste prédio!";
    text[12368] = "CHEFE";
    text[12390] = "Opções";
    text[12369] = "Gostaria de sair do prédio?";
    text[12370] = "PONTOS:";
    text[12371] = "Não nos subestime, Necromia.";
    text[12372] = "Isso aí! Não seremos derrotadas tão fácil assim!";
    text[12373] = "Acabou...";
    text[12374] = "... ... ...";
    text[12375] = "O povo de Magnésia...";
    text[12376] = "... finalmente pode descansar...";
    text[12379] = "Mestre\ndas Ondas";
    text[12380] = "Mestre das Ondas";
    text[12381] = "AURA FÁSICA";
    text[12382] = "AURA FÁSICA: Imune a ataques comuns que causam menos de 100 de dano!";
    text[12383] = "FORÇA ESPIRITUAL: Imune a ataques comuns. Fraqueza: Combos Lux + Modo Fásico!";
    text[12384] = "AURA ASSOMBRADA: O inimigo ganha PV lentamente em tempo real!";
    text[12385] = "CÓDIGO DO SAQUEADOR: 50% de chance de o inimigo causar DANO x2!";
    text[12386] = "INIMIGOS NORMAIS";
    text[12387] = "INIMIGOS EX";
    text[12388] = "INIMIGOS ZX";
    text[12389] = "TODOS OS INIMIGOS";
    text[12391] = "SAIR";
    text[12392] = "GERENCIAR ASSINATURA";
    text[12393] = "DELETE MINHA CONTA";
    text[13000] = "Russian";
}

    text[200056] = "Você obteve 200 Habilipontos!";
    text[200057] = "Você desbloqueou a cápsula e obteve 200 Habilipontos!";
    text[200038] = "É uma cápsula trancada. Forneça o CÓDIGO:";
    text[200040] = "Apesar de não encontrar todas as dicas, você adivinhou corretamente!";

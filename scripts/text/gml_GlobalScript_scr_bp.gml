    text[369] = "Ah, claro. Painéis Lunares geram eletricidade!";
    text[370] = "I-isso pode fu-funcionar!";
    text[371] = "PRECISA funcionar. Não consigo pensar em outra alternativa.";
    text[372] = "O problema é que não faço ideia de como conectar ou instalar Painéis Lunares...";
    text[373] = "Hora de ir nessa. Vamos encontrar alguém que possa nos ajudar.";
    text[374] = "De-desculpa pelo trabalho...";
    text[375] = "Não se preocupe, Mett. Não foi sua culpa.";

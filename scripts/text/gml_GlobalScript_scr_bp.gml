    text[10105] = "Mecânica do Modo Fásico";
    text[10114] = "Lunarpédia.EXE";
    text[10128] = "Olá, sou a Lunarpédia.EXE, sua principal fonte de dicas úteis de jogabilidade e de batalha!";
    text[10116] = "Você poderá mudar seu Traje a Jato assim que obtiver";
    text[10117] = "pelo menos 2 estilos diferentes!";
    text[10118] = "Há um total de cinco indicadores coloridos que verá em sua aventura.";
    text[10120] = "Indicadores azuis marcam um objeto ou uma área de interesse com interação.";
    text[10121] = "Indicadores amarelos são usados para o Andamento da história.";
    text[10122] = "Indicadores verdes são usados para Missões secundárias.";
    text[10123] = "Indicadores vermelhos são usados para Missões da Força Lunex.";
    text[10124] = "Por último, os indicadores roxos são usados para marcar pontos de batalha sem ser contra Murks.";
    text[10126] = "Use o menu MISSÕES para conferir os requisitos ou as informações necessárias";
    text[10127] = "para completar Missões que surgirem em sua aventura!";
    text[10125] = "É possível acessar o menu MISSÕES em seu Códice!";
    text[10131] = "Uma espaçonave é composta de três partes intercambiáveis: Estrutura, Asas e Propulsor!";
    text[10130] = "Há um total de 33 partes de nave que você pode coletar em sua aventura!";
    text[10129] = "Observação: A Dobra do Mapa-múndi é desbloqueada durante o Capítulo 2.";
    text[10132] = "Derrotar inimigos em batalha concederá EXP, que lhe ajudará a subir de nível!";
    text[10134] = "Seu PV MÁX. aumentará em 10 cada vez que subir um nível (NV)!";
    text[10135] = "Subir de nível aumentará o DAN (Dano) ou o PDR (Poder) de determinadas Habilidades Ativas";
    text[10136] = "e também aumentará seu Dano de Combo Lux!";
    text[10144] = "PE é fundamental para usar suas Habilidades Ativas em Batalha!";
    text[10145] = "É possível usar CHICLETES para reduzir o Custo de PE de uma de suas Habilidades Ativas em 5!";
    text[10137] = "Seu PE MÁX. sempre será 100, a menos que use um CHIP DE MELHORIA DE PE.";
    text[10138] = "Usar OTIMIZADORES DE ESCUDO não só aumentará o MÁXIMO DE ESCUDOS";
    text[10139] = "como, também, aumentará em 1 o número de escudos iniciais das batalhas!";
    text[10140] = "Selecione um tópico.";
    text[10141] = "NV E PV MÁX.";
    text[10142] = "PE MÁX.";
    text[10143] = "MÁX. ESCUDOS";
    text[10146] = "Há um total de cinco diferentes Tipos de Ataques Inimigos!";
    text[10147] = "Durante Ataques em 1 Painel, o movimento do jogador é restringido e escudos são necessários!";
    text[10148] = "Durante Ataques de 3 Painéis, é possível se esquivar ao se mover para cima e para baixo!";
    text[10150] = "Durante Ataques de 9 Painéis, é possível se mover em todos os quatro sentidos para desviar de ataques!";
    text[10151] = "Um Ataque de Alma é um tipo de ataque especial onde sua 'Alma' é representada por um coração.";
    text[10152] = "É possível mover seu coração para desviar de balas e projéteis inimigos!";
    text[10153] = "Durante um Ataque de Alma, também é possível usar Escudos se necessário!";
    text[10154] = "O último tipo de ataque é um Ataque em Ondas.";
    text[10155] = "Durante Ataque em Ondas, use os direcionais direita e esquerda para bloquear com escudo contra";
    text[10156] = "diversas ondas de projéteis!";
    text[10157] = "Observação: Ataques em Ondas não consomem seus escudos.";
    text[10158] = "Há uma Conexão Neural que realmente quero comprar, mas meu NÍVEL ainda não é alto o suficiente...";
    text[10159] = "Dá para aprender tantas técnicas novas de batalha usando Conexões Neurais, mas...";
    text[10160] = "Sem um corpo devidamente treinado, você pode acabar se machucando.";
    text[10161] = "Por isso é importante subir de nível para treinar seu corpo!";
    text[10173] = "Iniciar um Combo Lux";
    text[10174] = "Dominar Combos Lux";
    text[10175] = "Aumentar o dano dos Combos Lux";
    text[10167] = "Se receber dano de um ataque inimigo, seu Luxômetro diminuirá!";
    text[10164] = "Assim que seu Luxômetro chegar ao máximo, você poderá iniciar um Combo Lux a partir do menu Habilidades!";
    text[10165] = "Selecione três Habilidades Ativas quaisquer para combinar em um Combo Lux.";
    text[10163] = "Há um total de 30 Combos Lux que você pode descobrir e dominar!";
    text[10168] = "Para que um Combo Lux seja considerado 'Dominado', você deve usar o Combo pelo menos duas vezes.";
    text[10166] = "Tente diversas combinações ou colete Receitas de Combos Lux para dominar todos eles!";
    text[10162] = "Quanto maior for seu nível, mais dano seu Combo Lux causará!";
    text[10170] = "Painéis de Veneno";
    text[10171] = "Painéis de Lava";
    text[10172] = "Painéis de Encharcamento";
    text[10169] = "Alguns inimigos evocam Painéis de Veneno durante seus ataques.";
    text[10176] = "Se pisar em um Painel de Veneno, você perderá lentamente PV!";
    text[10179] = "Painéis de Lava são quentes e explosivos!";
    text[10180] = "Você perderá 50 de PV se pisar em um Painel de Lava.";
    text[10181] = "O Painel de Lava desaparecerá em seguida.";
    text[10182] = "Seu Luxômetro reduzirá lentamente se ficar sobre um Painel de Encharcamento!";
    text[10183] = "Aumentar sua Afinidade também lhe fornecerá melhores descontos nas Lojas!";
    text[10186] = "Se causar um ACERTO CRÍTICO em um inimigo, seu PDR será multiplicado em 1,5x!";
    text[10187] = "SUPER ACERTOS CRÍTICOS, por outro lado, multiplicam seu PDR x3!";
    text[10188] = "Rimuru";
    text[10189] = "NV necessário";
    text[10190] = "Você não atingiu o nível necessário!";
    text[10191] = "Você sabia que é possível personalizar a cor da sua Espaçonave?";
    text[10192] = "Regenera escudo e PV por 4 turnos";
    text[10193] = "Regenera escudo e PV por 5 turnos";
    text[12377] = "Regenera escudo e PV por 6 turnos";
    text[10194] = "Derrota um inimigo com 250 PV ou menos!";
    text[10195] = "Derrota um inimigo com 300 PV ou menos!";
    text[12378] = "Derrota um inimigo com 400 PV ou menos!";
    text[10311] = "Recupera 40% do PV máx e +40 PE";
    text[10312] = "Recupera 60% do PV máx e +60 PE";
    text[10313] = "Recupera 80% do PV máx e +80 PE";
    text[10319] = "Sacrifica escudos por\n+10 de PDR cada (máx. 3)";
    text[10320] = "Sacrifica escudos por\n+10 de PDR cada (máx. 4)";
    text[10321] = "Sacrifica escudos por\n+10 de PDR cada (máx. 5)";
    text[10322] = "Multiplicador x1.75 para PDR de habilidade";
